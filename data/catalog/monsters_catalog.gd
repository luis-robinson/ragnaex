static func _mk(d: Dictionary) -> MonsterDef:
	var m := MonsterDef.new()
	CatalogUtil.fill(m, d)
	return m

static func _lt(id: String, entries: Array) -> LootTable:
	var l := LootTable.new()
	l.id = id
