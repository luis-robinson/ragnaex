		{"id": "hx_banners", "title": "Punhos Vermelhos", "giver_npc": "coast_scout", "turnin_npc": "port_governor", "type": COLLECT, "target_id": "horde_badge", "count": 8, "level_req": 32, "prereq_quest": "hx_mangrove",
