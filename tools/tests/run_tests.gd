extends Node
## Testes headless da simulação:
##   godot --headless --path . tools/tests/tests.tscn
## Cobre catálogo, fórmulas, bloqueio, XP, loot, quests, crafting, mira de skills e 3000 ticks de mundo com bots.
## Só uma parte (iterar rápido):  ... tools/tests/tests.tscn -- --only=party,shield
##   roda cada `_check_*` cujo nome contém um dos pedaços (com o que ele chama dentro); o run completo continua obrigatório.

var fails := 0
var passes := 0
var gd_ref
var save_ref

func check(cond: bool, msg: String) -> void:
	if cond:
		passes += 1
	else:
		fails += 1
		push_error("FAIL: " + msg)
		print("FAIL: " + msg)

func _ready() -> void:
	Sim.running = false
	ClassTalentSystem.bot_picks = false        # bots de teste sem talentos de classe sorteados (_check_class_talents escolhe os seus)
	var only := DevArgs.value("--only")
	if only != "":
		run_only(Array(only.split(",")), GameData, Sim, SaveSystem)
	else:
		run_all(GameData, Sim, Balance, SaveSystem)
	print("\n=== %d passed, %d failed ===" % [passes, fails])
	get_tree().quit(1 if fails > 0 else 0)

class FakeMain:
	var views := {}
	var current_map_id := ""

## Texto flutuante (FloatText) e nomes de matilha (NameplateCrowd), arte 2026-11-13 itens 4 e 5:
## repetição vira "Esquiva! ×N", teto por alvo, faixas distintas, Label3D reaproveitados; comum em matilha esconde o nome.
func _check_float_text_crowd(gd) -> void:
	var ft := FloatText.new()
	add_child(ft)
	for i in 5:
		ft.pop(Vector3.ZERO, "Esquiva!", Color.WHITE, 1.0, 7, true)
	check(ft.live_count() == 1 and (ft._live[0]["label"] as Label3D).text == "Esquiva! ×5", "texto flutuante: 5 esquivas no mesmo alvo = 1 pop ×5")
	ft._process(FloatText.MERGE_WINDOW + 0.05)
	ft.pop(Vector3.ZERO, "Esquiva!", Color.WHITE, 1.0, 7, true)
	check(ft.live_count() == 2, "texto flutuante: fora da janela de fusão abre pop novo")
	for i in 6:
		ft.pop(Vector3.ZERO, str(100 + i), Color.WHITE, 1.0, 8)
	var whole := ft._live.filter(func(r: Dictionary) -> bool: return int(r["key"]) == 8 and float(r["life"]) >= FloatText.LIFE)
	check(whole.size() == FloatText.MAX_PER_TARGET, "texto flutuante: no máximo %d pops inteiros por alvo" % FloatText.MAX_PER_TARGET)
	var lanes := {}
	for r: Dictionary in whole:
		lanes[int(r["lane"])] = true
	check(lanes.size() == whole.size(), "texto flutuante: pops vivos do alvo em faixas diferentes")
	ft._process(FloatText.EVICT_LEFT + 0.02)
	check(ft._live.filter(func(r: Dictionary) -> bool: return int(r["key"]) == 8).size() == FloatText.MAX_PER_TARGET, "texto flutuante: o mais velho sai rápido")
	ft._process(FloatText.LIFE + 0.1)
	var kids := ft.get_child_count()
	check(ft.live_count() == 0 and ft.pooled_count() == kids, "texto flutuante: tudo volta para o pool")
	for i in 3:
		ft.pop(Vector3.ZERO, "x", Color.WHITE, 1.0, 9)
	check(ft.get_child_count() == kids, "texto flutuante: reaproveita Label3D (sem nó novo)")
	for i in FloatText.MAX_TOTAL + 10:
		ft.pop(Vector3.ZERO, str(i), Color.WHITE, 1.0, 1000 + i)
	check(ft.live_count() <= FloatText.MAX_TOTAL and ft.get_child_count() <= FloatText.MAX_TOTAL + 1, "texto flutuante: teto geral de Label3D")
	check(FloatText.merged_text("Esquiva!", 1) == "Esquiva!", "texto flutuante: sem contador quando é 1")
	remove_child(ft)
	ft.free()
	# matilha: 5 comuns colados + 1 longe; o 0 é o alvo do jogador
	var pts: Array[Vector3] = [Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 0, 1), Vector3(1, 0, 1), Vector3(0.5, 0, 0.5), Vector3(30, 0, 0)]
	var keep: Array[bool] = [true, false, false, false, false, false]
	var hid := NameplateCrowd.hidden_names(pts, keep)
	check(not hid[0] and hid[1] and hid[4] and not hid[5], "nomes da matilha: alvo mostra, comum na matilha esconde, sozinho mostra")
	var few: Array[Vector3] = [Vector3.ZERO, Vector3(1, 0, 0)]
	var nk: Array[bool] = [false, false]
	check(not NameplateCrowd.hidden_names(few, nk).has(true), "nomes da matilha: par pequeno mostra os dois")
	var near := NameplateCrowd.nearest(pts, [5, 1, 3] as Array[int], Vector3.ZERO, 2)
	check(near.size() == 2 and near.has(1) and not near.has(5), "nomes da matilha: agressores mais perto do jogador mantêm o nome")
	var boss_ok := false
	var trash_ok := false
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		var e := SimEntity.new()
		e.kind = SimEntity.Kind.MONSTER
		e.monster_def = md
		if md.is_boss:
			boss_ok = not NameplateCrowd.is_trash(e)
		elif md.stat_role == "comum":
			trash_ok = NameplateCrowd.is_trash(e)
	check(boss_ok and trash_ok, "nomes da matilha: chefe nunca esconde, comum esconde")

## View criada tarde (fila de views, chegada no mapa): nasce na forma atual sem metamorfose e com o anel da aura ligada
## que o _on_buff teria posto (EntityView.snap_visual_state + FxManager.sync_entity_visuals, chamados no main._create_view).
func _check_late_view_state(gd, sim) -> void:
	var dru: SimEntity = sim.spawn_bot(gd.classes["druid"], "Tarde", "city_aldara", Vector3(0, 0, 8), 30)
	dru.brain = null
	dru.form = "wolf"
	dru.buffs.append({"id": "test_late_aura", "toggle": true, "aura": {"radius": 6.0}, "left": 60.0})
	var view := EntityView.new()
	add_child(view)
	view.setup(dru, false)
	view.snap_visual_state()
	check(view.form_view != null and view._shown_form == "wolf" and view._morph_t >= 1.0, "view tardia: já nasce na forma, sem metamorfose")
	var fx := FxManager.new()
	var fm := FakeMain.new()
	fm.current_map_id = dru.map_id
	fm.views[dru.id] = view
	fx.main = fm
	add_child(fx)
	var kids := view.get_child_count()
	fx.sync_entity_visuals(dru)
	fx.sync_entity_visuals(dru)
	check(fx._auras.has("%d:test_late_aura" % dru.id) and view.get_child_count() == kids + 1, "view tardia: anel da aura ligada, uma vez só")
	check(str(fx._last_form.get(dru.id, "")) == "wolf", "view tardia: forma lembrada para o tema da saída")
	for n: Node in [fx, view]:          # na hora: o run_all segue síncrono e os dois escutam o Events
		remove_child(n)
		n.free()
	sim.despawn(dru)

## Fila de criação de bonecos (main._drain_views): só o mapa atual, longe espera, grupo/alvo e invocações deles primeiro,
## depois a mais perto; quem sai da fila (despawn, view criada) não volta; limpar zera.
func _check_view_queue() -> void:
	var q := ViewQueue.new()
	var mk := func(id: int, map_id: String, x: float, owner: int = -1) -> SimEntity:
		var e := SimEntity.new()
		e.id = id; e.map_id = map_id; e.position = Vector3(x, 0, 0); e.owner_id = owner
		return e
	q.push(mk.call(1, "a", 30.0))
	q.push(mk.call(2, "a", 5.0))
	q.push(mk.call(3, "a", 100.0))            # longe: espera
	q.push(mk.call(4, "b", 1.0))              # outro mapa
	q.push(mk.call(5, "a", 50.0))
	q.push(mk.call(6, "a", 200.0, 9))         # invocação de alguém do grupo: vem mesmo longe
	q.push(mk.call(9, "a", 120.0))            # membro do grupo, longe
	var ids := func(l: Array) -> Array: return l.map(func(e): return e.id)
	check(ids.call(q.ready_list("a", Vector3.ZERO, 66.0, {})) == [2, 1, 5], "fila de views: perto primeiro, longe e outro mapa esperam")
	var l2: Array = ids.call(q.ready_list("a", Vector3.ZERO, 66.0, {9: true}))
	check(l2.size() == 5 and l2.slice(0, 2).has(9) and l2.slice(0, 2).has(6) and l2.slice(2) == [2, 1, 5], "fila de views: grupo e suas invocações primeiro (%s)" % str(l2))
	check(ids.call(q.ready_list("a", Vector3(100, 0, 0), 66.0, {})) == [3, 9, 5], "fila de views: ordem segue o jogador")
	check(q.ready_list("a", Vector3.ZERO, INF, {}).size() == 6, "fila de views: sem limite de distância cria todos do mapa")
	q.erase(2)
	check(not q.has(2) and q.size() == 6 and not ids.call(q.ready_list("a", Vector3.ZERO, 66.0, {})).has(2), "fila de views: despawn sai da fila")
	q.push(mk.call(1, "a", 30.0))
	check(q.size() == 6, "fila de views: entrar de novo não duplica")
	q.clear()
	check(q.size() == 0 and q.ready_list("a", Vector3.ZERO, INF, {}).is_empty(), "fila de views: troca de mapa zera a fila")

## Formas de bicho: todo gesto que EntityView.FORM_CLIP manda para o animal existe no modelo (senão toda skill vira a mesma mordida);
## a forma demoníaca tem os clipes do kit (sombra, buffs, giro...).
func _check_form_clips() -> void:
	for form in ["wolf", "bear"]:
		var fm := FormModel.create(form)
		check(fm != null and fm.anim != null, "forma %s carrega" % form)
		if fm == null:
			continue
		for want in EntityView.FORM_CLIP.values():
			check(fm.anim.has_animation(want), "forma %s tem o clipe '%s'" % [form, want])
		for want in EntityView.IMPACT_FRAME.keys().filter(func(k): return k in EntityView.FORM_CLIP.values()):
			check(EntityView.IMPACT_FRAME[want] * 1.0 / 24.0 < fm.anim.get_animation(want).length, "forma %s: impacto de '%s' dentro do clipe" % [form, want])
		# golpe andando: as patas correm por cima do clipe (LegOverlay), senão o bicho desliza
		check(fm.legs != null and fm.legs._tracks.size() >= 4, "forma %s: patas correm por cima do golpe" % form)
		# rabo com osso próprio: balança no idle e ondula na corrida (mob_kit.quad_motion)
		check(fm.skeleton.find_bone("tail") >= 0, "forma %s tem osso de rabo" % form)
		for clip in ["idle", "run"]:
			var an := fm.anim.get_animation(clip)
			var tt := -1
			for t in range(an.get_track_count()):
				if an.track_get_type(t) == Animation.TYPE_ROTATION_3D and String(an.track_get_path(t).get_subname(0)) == "tail":
					tt = t
			var swing := 0.0
			if tt >= 0:
				var q0 := an.rotation_track_interpolate(tt, 0.0)
				for i in range(12):
					swing = maxf(swing, rad_to_deg(q0.angle_to(an.rotation_track_interpolate(tt, an.length * i / 12.0))))
			check(swing > 5.0, "forma %s: rabo mexe no '%s' (%.0f°)" % [form, clip, swing])
		fm.free()
	var dm := FormModel.create("demon")
	if dm:
		for want in ["cast_shadow", "atk_spin", "buff_power", "atk_sweep", "cast"]:
			check(dm.anim.has_animation(want), "forma demoníaca tem '%s'" % want)
		dm.free()

## Revisão de animação (docs/animations_review.md, tools/tests/anim_probe.tscn): costura dos loops sem quadro parado,
## cabeça fora do chão na morte, golpe dos monstros com pose de impacto no quadro 5 e morte que tomba.
func _check_anim_review() -> void:
	var loops := ["idle", "idle_bow", "idle_staff", "run", "block", "block_shield", "fall"]
	for model in ["kit_paladin_male", "kit_bishop_female", "mob_wolf", "mob_bandit", "mob_elf_bowman", "mob_golem", "mob_ghost", "form_bear"]:
		var ps: PackedScene = load("res://assets/models/%s.glb" % model)
		if ps == null:
			check(false, "anim: modelo %s carrega" % model)
			continue
		var inst: Node3D = ps.instantiate()
		add_child(inst)
		var ap: AnimationPlayer = inst.find_children("*", "AnimationPlayer", true, false)[0]
		var sk: Skeleton3D = inst.find_children("*", "Skeleton3D", true, false)[0]
		for clip in ap.get_animation_list():
			var an := ap.get_animation(clip)
			if clip in loops:
				# o glTF começava no quadro 0 (cópia parada do 1): a corrida dava um tranco a cada passada (export_anim_slide_to_zero)
				var seam := 0.0
				var d0 := 0.0
				var d1 := 0.0
				var dt := 1.0 / 24.0
				for t in range(an.get_track_count()):
					if an.track_get_type(t) != Animation.TYPE_ROTATION_3D:
						continue
					seam = maxf(seam, rad_to_deg(an.rotation_track_interpolate(t, 0.0).angle_to(an.rotation_track_interpolate(t, an.length))))
					d0 += rad_to_deg(an.rotation_track_interpolate(t, 0.0).angle_to(an.rotation_track_interpolate(t, dt)))
					d1 += rad_to_deg(an.rotation_track_interpolate(t, an.length - dt).angle_to(an.rotation_track_interpolate(t, an.length)))
				check(seam < 1.5, "anim %s/%s: o loop fecha (%.1f°)" % [model, clip, seam])
				check(d1 < 2.0 or d0 > d1 * 0.3, "anim %s/%s: sem quadro parado na costura (%.1f° no 1º quadro, %.1f° no último)" % [model, clip, d0, d1])
		var head := sk.find_bone("head")
		if model.begins_with("kit_") or model == "mob_bandit":
			ap.play("die")
			ap.seek(ap.current_animation_length, true)
			# centro da cabeça (meio do osso, ~0,3 m acima do pescoço) acima do raio dela: deitado, apoia sem afundar
			var hp := sk.get_bone_global_pose(head)
			var hy := (hp.origin + hp.basis.y.normalized() * 0.3).y
			check(hy > 0.24, "anim %s: cabeça não afunda no chão na morte (centro a %.2f m)" % [model, hy])
		if model.begins_with("mob_"):
			# golpe do monstro: o desenho já está longe do repouso no quadro 5 (EntityView.IMPACT_FRAME["attack"])
			var an := ap.get_animation("attack")
			var far := 0.0
			for t in range(an.get_track_count()):
				if an.track_get_type(t) == Animation.TYPE_ROTATION_3D:
					far = maxf(far, rad_to_deg(an.rotation_track_interpolate(t, 0.0).angle_to(an.rotation_track_interpolate(t, 4.0 / 24.0))))
			check(far > 20.0, "anim %s: golpe com pose de impacto no quadro 5 (%.0f°)" % [model, far])
			check(ap.has_animation("hit") and ap.has_animation("die") and ap.get_animation("die").length >= 0.8, "anim %s: tranco e morte com tempo" % model)
		inst.free()
	# monstro humanoide comum: só os 7 clipes com nome de bicho (o resto do kit não vai no GLB; chefes guardam os gestos, abaixo)
	var hm: Node = (load("res://assets/models/mob_bandit.glb") as PackedScene).instantiate()
	var hap: AnimationPlayer = hm.find_children("*", "AnimationPlayer", true, false)[0]
	var names := Array(hap.get_animation_list())
	names.sort()
	check(names == ["attack", "block", "cast", "die", "hit", "idle", "run"], "anim: monstro humanoide tem idle/run/attack/cast/hit/die/block (%s)" % [names])
	hm.free()
	# chefes: cada skill do kit toca um gesto próprio (não o golpe básico); tools/tests/boss_anim_probe.gd
	var bap = load("res://tools/tests/boss_anim_probe.gd")
	for bid in load("res://tools/tests/boss_probe.gd").BOSSES:
		var r: Dictionary = bap.check_boss(bid, self)
		check(int(r["flags"]) == 0, "anim %s: toda skill do chefe tem gesto próprio (%s)" % [bid, ", ".join((r["lines"] as Array).filter(func(l): return l.ends_with("FLAG")))])

## Preparo curto: o clipe começa no meio da preparação (não corre mais que WINDUP_MAX_SPEED) e o impacto cai no fim do preparo.
func _check_windup_timing() -> void:
	for pair in [[0.375, 0.12], [0.29, 0.12], [0.33, 0.5], [0.2, 0.06]]:
		var wt := EntityView.windup_timing(pair[0], pair[1])
		check(wt.x >= 0.0 and wt.y <= EntityView.WINDUP_MAX_SPEED + 0.001, "preparo %.2f/%.2f: velocidade %.2f limitada" % [pair[0], pair[1], wt.y])
		if wt.y > EntityView.ANIM_MIN_SPEED + 0.001:
			check(absf((pair[0] - wt.x) / wt.y - pair[1]) < 0.01, "preparo %.2f/%.2f: impacto no fim do preparo" % pair)

## Troca de clipe: kit e bicho têm PoseFade; o deslize parte da pose congelada e chega no clipe novo pelo caminho curto
## (a mistura do AnimationPlayer passava pelo repouso e virava a mão do avesso num quadro).
func _check_pose_fade() -> void:
	var k := KitModel.create("male", Color.WHITE, 0.025, "paladin")
	add_child(k)                       # o modificador só acha o esqueleto na árvore
	check(k.fade != null and k.legs != null and k.fade.get_index() < k.legs.get_index(), "kit: PoseFade antes das pernas")
	var sk := k.skeleton
	var hand := sk.find_bone("hand.R")
	var q0 := Quaternion(Vector3.UP, deg_to_rad(10.0))
	var q1 := Quaternion(Vector3.UP, deg_to_rad(170.0))
	sk.set_bone_pose_rotation(hand, q0)
	k.fade.start(0.1)
	sk.set_bone_pose_rotation(hand, q1)
	check(k.fade.shown_rotation(sk, hand).angle_to(q0) < 0.01, "deslize começa na pose congelada")
	var prev := q0
	var worst := 0.0
	for i in range(8):
		k.fade.tick(1.0 / 60.0)
		var q := k.fade.shown_rotation(sk, hand)
		worst = maxf(worst, rad_to_deg(prev.angle_to(q)))
		prev = q
	check(prev.angle_to(q1) < 0.01 and not k.fade.active, "deslize chega no clipe novo e desliga")
	check(worst < 60.0, "deslize de 160° em 6 quadros sem salto (%.0f°/quadro)" % worst)
	k.free()
	var fm := FormModel.create("wolf")
	if fm:
		check(fm.fade != null, "forma de bicho tem PoseFade")
		fm.free()

## Mão sem voltas: chaves em quaternião com giro limitado (chibi_kit.QUAT_BONES/HAND_MAX_TURN). Em Euler a mão girava
## 600-1900° por clipe e virava a arma 155-176° em 1 quadro. Medido a 60 Hz, velocidade 1.
func _check_hand_twist() -> void:
	var inst: Node = (load("res://assets/models/kit_paladin_male.glb") as PackedScene).instantiate()
	var ap: AnimationPlayer = inst.find_children("*", "AnimationPlayer", true, false)[0]
	var worst := 0.0
	var where := ""
	var flurry := 0.0
	for clip in ap.get_animation_list():
		var an := ap.get_animation(clip)
		for t in range(an.get_track_count()):
			if an.track_get_type(t) != Animation.TYPE_ROTATION_3D or not String(an.track_get_path(t).get_subname(0)).begins_with("hand"):
				continue
			var prev := an.rotation_track_interpolate(t, 0.0)
			var tt := 1.0 / 60.0
			var total := 0.0
			while tt <= an.length + 0.0001:
				var q := an.rotation_track_interpolate(t, tt)
				var d := rad_to_deg(prev.angle_to(q))
				total += d
				if d > worst:
					worst = d
					where = "%s %s" % [clip, an.track_get_path(t).get_subname(0)]
				prev = q
				tt += 1.0 / 60.0
			if clip == "atk_flurry":
				flurry = maxf(flurry, total)
	check(worst < 45.0, "mão: no máximo 45°/quadro a 60 Hz (pior %.0f° em %s)" % [worst, where])
	check(flurry > 0.0 and flurry < 1000.0, "mão: atk_flurry não dá voltas (%.0f° no clipe)" % flurry)
	inst.free()

## Maestria: a descrição diz o que cada nível melhora naquela skill (tirada dos dados), não um "+1 nível" genérico.
func _check_mastery_desc() -> void:
	var bad: Array = []
	var extras := 0
	for sid in GameData.skills:
		var sk: SkillDef = GameData.skills[sid]
		var d := TreeCatalog.mastery_desc(sk)
		if not ("MP" in d and "recarga" in d) or (("poder" in d) != (sk.power > 0.0)):
			bad.append(sid)
		if sk.effects.has("form") and not ("bônus da forma" in d):
			bad.append(sid + "(forma)")
		if "Nível " in d:
			extras += 1
	check(bad.is_empty(), "maestria: descrição certa em todas as skills (%s)" % [bad.slice(0, 5)])
	check(extras >= 4, "maestria: efeitos extras por nível aparecem na descrição (%d)" % extras)
	if DevArgs.has("--verbose"):
		for sid in ["nec_phantom", "nec_reap", "dru_bear_form"]:
			if GameData.skills.has(sid):
				print("  MAESTRIA %s: %s" % [sid, TreeCatalog.mastery_desc(GameData.skills[sid])])

## Menu Esc → Gráficos: o 1º preset é o padrão de sempre (bilinear, escala automática); os FSR 2 renderizam abaixo de 100%.
func _check_graphics_settings() -> void:
	var ps: Array = GraphicsSettings.PRESETS
	check(ps.size() >= 2 and ps[0][1] == Viewport.SCALING_3D_MODE_BILINEAR and float(ps[0][2]) < 0.0, "gráficos: padrão = Nítido automático")
	for p in ps.slice(1):
		check(p[1] == Viewport.SCALING_3D_MODE_FSR2 and float(p[2]) > 0.3 and float(p[2]) < 1.0, "gráficos: %s renderiza abaixo da tela" % p[0])
	check(GraphicsSettings.preset == 0 or FileAccess.file_exists(GraphicsSettings.PATH), "gráficos: sem arquivo salvo começa no padrão")

## `--only`: chama direto os `_check_*` que batem com algum pedaço, montando os argumentos pelo nome (gd, sim, save).
func run_only(tokens: Array, gd, sim, save) -> void:
	gd_ref = gd
	save_ref = save
	save.slot = TEST_SLOT
	for mid in gd.maps:            # o mesmo mundo do run_all: todos os mapas e um jogador na cidade
		sim.load_map(gd.maps[mid])
	sim.spawn_player(gd.classes["berserker"], "Tester", "city_aldara")
	var by_name := {"gd": gd, "sim": sim, "save": save, "_gd": gd, "_sim": sim, "_save": save}     # "_x" = parâmetro não usado
	var ran := 0
	for m in get_method_list():
		var mname: String = m["name"]
		if not mname.begins_with("_check_") or not tokens.any(func(t): return t != "" and mname.contains(t)):
			continue
		var args: Array = []
		var ok := true
		for a in m["args"]:
			if not by_name.has(a["name"]):
				ok = false          # pede algo que só o chamador sabe (ex.: um monstro): roda junto do pai
				break
			args.append(by_name[a["name"]])
		if not ok:
			continue
		print("--- %s" % mname)
		callv(mname, args)
		ran += 1
	save.delete_slot(TEST_SLOT)
	print("--only: %d grupos" % ran)

const HOSTILE_HUBS := ["elf_city"]      # zonas cujo hub é a cidade inimiga (sem serviços; spawners dentro do muro)
const TEST_SLOT := 90       # espaço só dos testes (fora dos SLOTS da tela inicial): nunca toca nos personagens do jogador
# performance da simulação: 3000 ticks levam ~25,6 s com a máquina quieta; o limite pega uma regressão de 2x (~51 s)
const PERF_SIM_LIMIT_MS := 32000.0
const PERF_CAL_QUIET_MS := 36.0      # mediana do laço de calibração com a máquina quieta (medida nesta máquina, 2026-11-12)
const PERF_MAX_SLOWDOWN := 3.0       # teto: máquina mais de 3x mais lenta já não é um teste justo

## Laço fixo de CPU (~2M operações de float em GDScript): mediana de 5 amostras, em ms.
func _perf_calibration() -> float:
	var samples: Array[float] = []
	for s in range(5):
		var t0 := Time.get_ticks_usec()
		var x := 0.0
		var y := 1.0
		for i in range(500000):
			x += y * 1.000001
			y = y * 0.999999 + 0.5
			x -= y * 0.25
			y += x * 0.0000001
		samples.append((Time.get_ticks_usec() - t0) / 1000.0 + (0.0 if x != 12345.678 else 1.0))
	samples.sort()
	return samples[2]

func run_all(gd, sim, balance, save) -> void:
	gd_ref = gd
	save_ref = save
	save.slot = TEST_SLOT
	# ---- catálogo ----
	check(gd.classes.size() == 8, "8 classes")
	check(gd.skills.size() >= 48, "48+ skills (tem %d)" % gd.skills.size())
	for cid in gd.classes:
		var c = gd.classes[cid]
		check(c.skill_ids.size() >= 20, "classe %s tem 20+ skills (%d)" % [cid, c.skill_ids.size()])
		for sid in c.skill_ids:
			check(gd.skills.has(sid), "skill %s existe" % sid)
		for eid in c.starting_equipment:
			check(gd.items.has(eid), "item inicial %s existe" % eid)
	_check_builds(gd)
	for mid in gd.monsters:
		var m = gd.monsters[mid]
		check(m.loot_table == "" or gd.loot_tables.has(m.loot_table), "loot table de %s" % mid)
		for sid in m.skill_ids:
			check(gd.skills.has(sid), "skill de monstro %s" % sid)
	for lid in gd.loot_tables:
		for e in gd.loot_tables[lid].entries:
			check(gd.items.has(e["item"]), "loot %s item %s" % [lid, e["item"]])
	for qid in gd.quests:
		var q = gd.quests[qid]
		if q.type == QuestDef.Type.KILL: check(gd.monsters.has(q.target_id), "quest %s alvo" % qid)
		if q.type == QuestDef.Type.COLLECT or q.type == QuestDef.Type.CRAFT: check(gd.items.has(q.target_id), "quest %s item" % qid)
		for iid in q.reward_items: check(gd.items.has(iid), "quest %s recompensa %s" % [qid, iid])
		if q.prereq_quest != "": check(gd.quests.has(q.prereq_quest), "quest %s prereq" % qid)
	for rid in gd.recipes:
		var r = gd.recipes[rid]
		check(gd.items.has(r.result_item), "receita %s resultado" % rid)
		for iid in r.ingredients: check(gd.items.has(iid), "receita %s ingrediente %s" % [rid, iid])
	for mid in gd.maps:
		var md = gd.maps[mid]
		for p in md.portals: check(gd.maps.has(p["target_map"]), "portal %s/%s" % [mid, p["id"]])
		for sp in md.spawners: check(gd.monsters.has(sp["monster_id"]), "spawner %s/%s" % [mid, sp["monster_id"]])
		for n in md.npcs:
			for iid in n.get("shop", []): check(gd.items.has(iid), "loja %s item %s" % [n["id"], iid])
	# NPCs referenciados por quests existem em algum mapa
	var npc_ids := {}
	for mid in gd.maps:
		for n in gd.maps[mid].npcs:
			npc_ids[n["id"]] = true
	for qid in gd.quests:
		var q = gd.quests[qid]
		check(npc_ids.has(q.giver_npc), "quest %s giver %s existe" % [qid, q.giver_npc])
		check(npc_ids.has(q.turnin()), "quest %s turnin existe" % qid)
		if q.type == QuestDef.Type.TALK: check(npc_ids.has(q.target_id), "quest %s talk npc" % qid)

	# ---- fórmulas ----
	var pal = gd.classes["paladin"]
	var eq := {}
	for iid in pal.starting_equipment:
		var it = gd.items[iid]
		eq[it.slot] = it
	var st = Stats.compute(pal, 1, eq, [])
	check(st.attrs["FOR"] == 5 * Balance.ATTR_SCALE and st.attrs["VIT"] == 5 * Balance.ATTR_SCALE and st.attrs["AGI"] == 0, "atributos do paladino vêm do equipamento (FOR=%d VIT=%d)" % [st.attrs["FOR"], st.attrs["VIT"]])
