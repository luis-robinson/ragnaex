## Talento de classe que põe efeito numa skill (relato 2026-11-17: "Salto Atordoante" ber_c_leap "parece não funcionar"):
## pelo caminho do jogo (resolve_skill -> _start_skill -> tick, IA dos monstros ligada) o salto atordoa 1 s no lobo e no rei
## (elite leva controle cheio, decisão 2026-11-17: MonsterDef.resists_cc); só o chefe leva 40%. Depois TODO talento com
## skill_mods.effects/add, com e sem a escolha: o efeito chega e nunca sai mais fraco que sem o talento (dano no tempo/controle:
## duração; cura por dano: cura/dano); "add" soma por cima do que a skill já tem (base + maestria + evolução). Bote Brutal (ran_sic) passava pelo _pet_command, que ignorava o atordoamento do talento.
func _check_talent_fx_cast(gd, sim) -> void:
	var st: int = sim.rng.state
	var r: Dictionary = _ct_fx_cast(gd, sim, "berserker", "ber_c_leap", "ber_leap", ["wolf", "wolf_rei", "boar_brute"], true)
	var want := [1.0, 1.0, 0.4]
	for i in range(3):
		check(absf(float(r["stun"][i]) - float(want[i])) < 0.05, "Salto Atordoante: %s atordoado %.2f s onde o salto cai (quer %.2f)" % [["lobo", "rei (elite)", "chefe"][i], float(r["stun"][i]), float(want[i])])
	var r0: Dictionary = _ct_fx_cast(gd, sim, "berserker", "", "ber_leap", ["wolf"])
	check(float(r0["stun"][0]) == 0.0, "Salto sem o talento não atordoa")
	var cat: Dictionary = ClassTalentsCatalog.build()
	for cid in cat:
		for row in cat[cid]:
			for o in row[1]:
				var mods: Dictionary = o.get("skill_mods", {})
				for sid in mods:
					var fx: Dictionary = mods[sid].get("effects", {})
					var add: Dictionary = mods[sid].get("add", {})
					if (fx.is_empty() and add.is_empty()) or not gd.skills.has(sid):
						continue
					var w: Dictionary = _ct_fx_cast(gd, sim, cid, str(o["id"]), sid, ["wolf"])
					var wo: Dictionary = _ct_fx_cast(gd, sim, cid, "", sid, ["wolf"])
					for k in fx.keys() + add.keys():
						var plus: bool = add.has(k)          # "add": tem de passar o sem-talento por pelo menos o que soma
						var v: Variant = add[k] if plus else fx[k]
						var dur := float((v as Dictionary).get("duration", 0.0)) if v is Dictionary else 0.0
						var ok := false
						var got := ""
						match k:
							"stun":
								ok = float(w["stun"][0]) >= (float(wo["stun"][0]) + dur if plus else dur) - 0.05 and float(w["stun"][0]) >= float(wo["stun"][0])
								got = "%.2f s (sem: %.2f)" % [float(w["stun"][0]), float(wo["stun"][0])]
							"slow", "root", "dot", "curse":
								ok = w["fx"].has(k) and float(w["fx"][k]) >= (float(wo["fx"].get(k, 0.0)) + dur if plus else dur * 0.9) - 0.05 and float(w["fx"][k]) >= float(wo["fx"].get(k, 0.0)) - 0.05
								got = "%.2f s (sem: %.2f)" % [float(w["fx"].get(k, -1.0)), float(wo["fx"].get(k, -1.0))]
							"heal_pct_of_dmg", "mend_pct_of_dmg":       # o crítico muda o dano entre as duas rodadas: compara cura/dano
								ok = float(w["heal"]) / maxf(1.0, float(w["dmg"])) > float(wo["heal"]) / maxf(1.0, float(wo["dmg"])) + (float(v) * 0.8 if plus else 0.0)
								got = "cura/dano %.2f (sem: %.2f)" % [float(w["heal"]) / maxf(1.0, float(w["dmg"])), float(wo["heal"]) / maxf(1.0, float(wo["dmg"]))]
							"heal_pct":
								ok = float(w["heal"]) > float(wo["heal"])
								got = "cura %.0f (sem: %.0f)" % [float(w["heal"]), float(wo["heal"])]
							_:
								continue
						check(ok, "%s (%s): %s.%s chega no jogo — %s" % [o["id"], cid, sid, k, got])
						if DevArgs.has("--talent_fx_log"):
							print("TALENT_FX %s %s.%s %s %s" % [o["id"], sid, k, "ok" if ok else "QUEBRADO", got + " dano %.0f/%.0f" % [float(w["dmg"]), float(wo["dmg"])]])
	sim.rng.state = st

## Um lançamento de `sid` por um bot de `cid` (nível 45, só a escolha `pick`, HP preso em 5%) em monstros `mids` (id;
## "<id>_rei" = elite), num mapa vazio só dele, no ponto mirado (salto: 4 m; resto: 1,8 m; `brains` = IA dos monstros ligada). Devolve o maior atordoamento por monstro (`stun`),
## o maior tempo de cada debuff nos monstros (`fx`) e quanto o bot se curou (`heal`). Mesmo sorteio em toda chamada.
func _ct_fx_cast(gd, sim, cid: String, pick: String, sid: String, mids: Array, brains := false) -> Dictionary:
	# mundo só deste lançamento: o sim roda SÓ um mapa vazio (sem bots/curas/atordoamentos dos outros testes), sorteio fixo
	var saved_maps: Dictionary = sim.maps
	var saved_away: int = sim.away_every
	var ps: float = sim.power_scale
	var lab := MapDef.new()
	lab.id = "talent_fx_lab"
	lab.size = Vector2(60, 60)
	sim.maps = {}
	sim.away_every = 1
	sim.load_map(lab)
	var at := Vector3(0, 0, 6)
	sim.rng.seed = 20261117
	var e: SimEntity = sim.spawn_bot(gd.classes[cid], "CTfx", lab.id, at, 45)
	e.brain = null
	for nid in e.tree.keys():
		if gd.trees[cid]["nodes"][nid]["kind"] == "pick":
			e.tree.erase(nid)
	if pick != "":
		e.tree["%s_c_%s" % [cid, pick]] = true
	sim.recompute_tree_bonus(e)
	e.heal_full()
	var base: SkillDef = gd.skills[sid]
	var leap: bool = base.target == SkillDef.Target.GROUND and float(base.effects.get("dash", 0.0)) > 0.0
	var aim := at + Vector3(4.0 if leap else 1.8, 0, 0)
	var foes: Array = []
	for i in range(mids.size()):
		var mid: String = mids[i]
		var md: MonsterDef = gd.monsters[mid] if gd.monsters.has(mid) else sim.elite_def(gd.monsters[mid.trim_suffix("_rei")])
		var f: SimEntity = sim.spawn_monster(md, lab.id, aim + Vector3(0, 0, (float(i) - float(mids.size() - 1) * 0.5) * 0.7))
		if not brains:
			f.brain = null
		f.stats.max_hp = 1000000.0
		f.hp = f.stats.max_hp
		foes.append(f)
	var out := {"stun": [], "fx": {}, "heal": 0.0}
	for f in foes:
		out["stun"].append(0.0)
	var pet: SimEntity = null
	if base.effects.has("pet_command"):      # Ataque da Fera: precisa do lince
		pet = sim.spawn_summon(e, gd.monsters[gd.skills["ran_companion"].effects["summon"]["monster_id"]], at + Vector3(-1, 0, 0), 0.0, true)
	e.face_towards(aim)
	sim._start_skill(e, sim.resolve_skill(e, base), 0, aim)
	var low: float = e.stats.max_hp * 0.05      # volta a 5% a cada passo: a cura soma sem bater no teto do HP
	sim.power_scale = 0.2                     # golpe mais fraco: a cura por dano não bate no teto do HP
	for t in range(150):
		e.hp = low
		sim.tick(1.0 / 60.0)
		out["heal"] = float(out["heal"]) + e.hp - low
		for i in range(foes.size()):
			var f: SimEntity = foes[i]
			if f.state == SimEntity.State.STUNNED:
				out["stun"][i] = float(out["stun"][i]) + 1.0 / 60.0      # tempo de verdade parado (IA ligada pode sair antes)
			for d in f.debuffs:
				var kd: String = str(d.get("kind", ""))
				out["fx"][kd] = maxf(float(out["fx"].get(kd, 0.0)), float(d.get("remaining", 0.0)) + 1.0 / 60.0)
	sim.power_scale = ps
	out["dmg"] = foes.reduce(func(a, f): return a + f.stats.max_hp - f.hp, 0.0)
	for f in foes:
		sim.despawn(f)
	if pet:
		sim.despawn(pet)
	sim.despawn(e)
	sim.maps = saved_maps
	sim.away_every = saved_away
	return out

## Regra dos talentos vivos (auditoria 2026-11-16): toda opção da linha N cita ao menos uma skill que abre no nível <= N;
## gancho genérico que depende de um tipo de skill (invocação com tempo, dano no tempo, forma, força do pet) precisa de
## uma skill da classe desse tipo aberta até N. Opção só de números (stats/execução/sobrevivência) vale desde a linha.
func _check_talent_unlock_levels(gd) -> void:
	var dead: Array = []
	for cid in gd.classes:
		var skill_ids: Array = gd.classes[cid].skill_ids
		for row in ClassTalentsCatalog.rows_of(cid):
			var lv := int(row[0])
			for o: Dictionary in row[1]:
				var refs: Array = o.get("permanent", []) + o.get("aura", []) + o.get("summon_permanent", []) + (o.get("summon_extra", {}) as Dictionary).keys() + (o.get("skill_mods", {}) as Dictionary).keys()
				if o.has("on_kill") and (o["on_kill"] as Dictionary).has("buff"):
					refs.append(o["on_kill"]["buff"])
				if refs.is_empty():
					if not ClassTalentSystem._typed_hook(o):
						continue                 # só números: vale desde a linha
					refs = skill_ids.filter(func(r): return ClassTalentSystem._hook_fits(o, str(r)))
					if refs.is_empty():
						dead.append("%s nv %d %s (gancho sem skill do tipo)" % [cid, lv, o["id"]])
						continue
				var lvls: Array = refs.map(func(r): return gd.skills[r].unlock_level if gd.skills.has(r) else 99)
				if lvls.min() > lv:
					dead.append("%s nv %d %s (%s)" % [cid, lv, o["id"], ", ".join(refs.map(func(r): return "%s:%d" % [r, gd.skills[r].unlock_level if gd.skills.has(r) else 99]))])
	check(dead.is_empty(), "talentos vivos: toda opção cita skill aberta até o nível da linha (%d mortas) %s" % [dead.size(), str(dead)])

## Ato II (ato2-horda.md R6/R7, AC-04): linhas 35/40/45, 3 por classe, uma para cada build; bot escolhe a da build;
## os refinos que dependem da ascensão ficam em ASC_REFINES_PENDING (dados válidos, fora da janela).
func _check_act2_talent_rows(gd, sim, cat: Dictionary, mk: Callable) -> void:
	check(ClassTalentsCatalog.ROW_LEVELS.slice(-3) == [35, 40, 45], "talentos: linhas 35, 40 e 45 em ROW_LEVELS")
	var seen := {}
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var build_ids: Array = cls.builds.map(func(b): return b["id"])
		for lv in [35, 40, 45]:
			var rows: Array = (cat.get(cid, []) as Array).filter(func(r): return int(r[0]) == lv)
			check(rows.size() == 1 and (rows[0][1] as Array).size() == 3, "%s: linha %d com 3 talentos" % [cid, lv])
			if rows.size() != 1:
				continue
			var opts: Array = rows[0][1]
			check(opts.map(func(o): return o.get("build", "")) == build_ids, "%s nv %d: um talento para cada build, na ordem %s" % [cid, lv, str(build_ids)])
			for o in opts:
				check(not seen.has(o["id"]), "%s: id de talento repetido" % o["id"])
				seen[o["id"]] = true
				var b: Dictionary = cls.build_by_id(o.get("build", ""))
				for sid in (o.get("skill_mods", {}) as Dictionary).keys() + o.get("aura", []) + o.get("permanent", []) + (o.get("summon_extra", {}) as Dictionary).keys():
					check(sid in b.get("skills", []), "%s: %s mexe em skill da build %s (%s)" % [cid, o["id"], o.get("build", ""), sid])
				for sid in o.get("skill_mods", {}):
					var md: Dictionary = o["skill_mods"][sid]
					var sk: SkillDef = gd.skills[sid]
					for k in md.get("mult", {}):
						var f := float(md["mult"][k])
						check(k == "duration" or (k in sk and float(sk.get(k)) > 0.0), "%s: %s multiplica %s que a skill tem" % [o["id"], sid, k])
						check(f >= 0.6 and f <= 1.5, "%s: %s x%.2f dentro do orçamento da linha (0,6-1,5)" % [o["id"], k, f])
					for k in md.get("effects", {}).keys() + md.get("add", {}).keys():
						check(k in SkillDef.EFFECT_KEYS and sk.effects.has(k), "%s: %s reforça efeito que a skill já tem (%s)" % [o["id"], sid, k])
		for pr in ClassTalentsCatalog.ASC_REFINES_PENDING.get(cid, []):
			check(int(pr["level"]) in [40, 45] and pr["build"] in build_ids and str(pr["text"]).length() > 10 and str(pr["needs"]) != "",
				"%s: refino pendente %s com nível, build e mecânica" % [cid, pr["name"]])
			check(not gd.trees[cid]["nodes"].values().any(func(n): return n["name"] == pr["name"]), "%s: refino pendente %s não é nó (só dado)" % [cid, pr["name"]])
	check(ClassTalentsCatalog.ASC_REFINES_PENDING.keys().size() == gd.classes.size(), "refinos pendentes: as 8 classes")
	# efeito de verdade: Quebra-Fileiras (+25%) e Linha de Escudos (raio/recarga do Provocar)
	var at: Vector3 = sim.maps["city_aldara"]["def"].town_center
	var pal: SimEntity = mk.call("paladin", 35, "pal_c_breaker", at)
	var base: SkillDef = gd.skills["pal_crusader_strike"]
	check(is_equal_approx(ClassTalentSystem.apply_mods(pal, base).power, base.power * 1.25), "Quebra-Fileiras: Golpe do Cruzado +25%")
	sim.despawn(pal)
	pal = mk.call("paladin", 35, "pal_c_shield_line", at)
	var tn: SkillDef = gd.skills["pal_taunt"]
	var tn2: SkillDef = ClassTalentSystem.apply_mods(pal, tn)
	check(is_equal_approx(tn2.radius, tn.radius * 1.3) and is_equal_approx(tn2.cooldown, tn.cooldown * 0.75), "Linha de Escudos: Provocar mais longe e mais rápido")
	check(sim.tree_block_reason(pal, "paladin_c_pal_c_rebound") == "requer nível 40", "linha 40 fechada no 35 (%s)" % sim.tree_block_reason(pal, "paladin_c_pal_c_rebound"))
	pal.level = 40
	check(Balance.MAX_LEVEL >= 40 and not sim.tree_block_reason(pal, "paladin_c_pal_c_rebound").begins_with("requer nível"), "linha 40 abre no nível 40 (%s)" % sim.tree_block_reason(pal, "paladin_c_pal_c_rebound"))
	sim.despawn(pal)
	var nec: SimEntity = mk.call("necromancer", 35, "nec_c_kennel", at)
	check(ClassTalentSystem.summon_extra(nec, "nec_bone_hound") == 1, "Canil dos Mortos: +1 cão")
	sim.despawn(nec)
	# bot de cada build fica com o talento da build na linha 35
	var rng_state: int = sim.rng.state          # o sorteio das linhas antigas não muda os checks seguintes
	ClassTalentSystem.bot_picks = true
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			var e: SimEntity = sim.spawn_bot(gd.classes[cid], "CT", "city_aldara", at, 35)
			e.brain = null
			e.build_id = b["id"]
			for nid in e.tree.keys():
				if gd.trees[cid]["nodes"][nid]["kind"] == "pick":
					e.tree.erase(nid)
			ClassTalentSystem.bot_pick(sim, e)
			var got: Array = ClassTalentSystem.picked(e).filter(func(o): return o.has("build"))
			check(got.size() == 1 and got[0]["build"] == b["id"], "bot %s/%s: talento 35 da build (%s)" % [cid, b["id"], str(got.map(func(o): return o["id"]))])
			sim.despawn(e)
	ClassTalentSystem.bot_picks = false
	sim.rng.state = rng_state

func _check_tree(gd, sim, save) -> void:
	var total_points := 0
	for lv in range(2, Balance.MAX_LEVEL + 1):
		total_points += Balance.points_at(lv)
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var tr: Dictionary = gd.trees.get(cid, {})
		check(not tr.is_empty(), "%s: tem árvore" % cid)
		var nodes: Dictionary = {}
		var picks: Array = []
		for nid in tr["nodes"]:                  # talentos de escolha (aba própria, sem ligações) contam à parte
			if tr["nodes"][nid]["kind"] == "pick":
				picks.append(tr["nodes"][nid])
			else:
				nodes[nid] = tr["nodes"][nid]
		# --- forma (teia estilo Path of Exile) ---
		check(nodes.size() >= 200 and nodes.size() <= 650, "%s: teia com 200-650 nós (%d; a Fronteira do Ato II soma ~190)" % [cid, nodes.size()])
		var kinds := {}
		for nid in nodes:
			kinds[nodes[nid]["kind"]] = int(kinds.get(nodes[nid]["kind"], 0)) + 1
		print("TEIA %s: %d nós %s" % [cid, nodes.size(), kinds])
		check(int(kinds.get("notable", 0)) >= 6, "%s: notáveis na teia (%d)" % [cid, int(kinds.get("notable", 0))])
		var attr_nodes := 0
		for nid in nodes:
			for k in nodes[nid]["stats"]:
				if str(k).begins_with("attr_"):
					attr_nodes += 1
					break
		check(attr_nodes >= 40, "%s: nós de atributo (FOR/AGI/VIT/WILL/INT) na teia (%d)" % [cid, attr_nodes])
		# escala nova: estrada/junção +1; entrada de círculo +5..+10 (mais longe do início = mais)
		var road_bad: Array = []
		var near_in := 99
		var far_in := 0
		for nid in nodes:
			var nd: Dictionary = nodes[nid]
			if nd["kind"] == "stat" and nd["branch"] == "ring":
				var tot := 0
				for k in nd["stats"]:
					tot += int(nd["stats"][k])
				if tot != TreeCatalog.ROAD_ATTR:
					road_bad.append(nid)
			elif nd["kind"] == "stat" and str(nid).ends_with("_in"):
				var v: int = nd["stats"].values()[0]
				check(v >= TreeCatalog.CLUSTER_ATTR.x and v <= TreeCatalog.CLUSTER_ATTR.y, "%s: entrada de círculo %s dá +5..+10 (%d)" % [cid, nid, v])
				near_in = mini(near_in, v)
			if nd["kind"] == "stat" and nd["branch"] != "ring":
				for k in nd["stats"]:
					if str(k).begins_with("attr_"):
						far_in = maxi(far_in, int(nd["stats"][k]))
		check(road_bad.is_empty(), "%s: estradas e junções dão +%d de atributo %s" % [cid, TreeCatalog.ROAD_ATTR, road_bad.slice(0, 3)])
		check(near_in == TreeCatalog.CLUSTER_ATTR.x and far_in == TreeCatalog.CLUSTER_ATTR.y, "%s: círculo perto dá +%d e no fundo +%d (%d..%d)" % [cid, TreeCatalog.CLUSTER_ATTR.x, TreeCatalog.CLUSTER_ATTR.y, near_in, far_in])
		var seen := {tr["start"]: true}
		var queue: Array = [tr["start"]]
		while queue.size() > 0:
			var cur: String = queue.pop_front()
			for l in nodes[cur]["links"]:
				check(cur in nodes[l]["links"], "%s: ligação %s-%s nos dois sentidos" % [cid, cur, l])
				if not seen.has(l):
					seen[l] = true
					queue.append(l)
		check(seen.size() == nodes.size(), "%s: todos os nós alcançáveis do início (%d/%d)" % [cid, seen.size(), nodes.size()])
		var skill_nodes := 0
		var cost_all := 0
		for nid in nodes:
			cost_all += int(nodes[nid]["cost"])
			if nodes[nid]["kind"] == "skill_up":
				skill_nodes += 1
		var web_ids: Array = Array(cls.skill_ids).filter(func(x): return not gd.skills[x].ascension)     # ascensão: teia própria
		check(skill_nodes == web_ids.size(), "%s: cada skill da classe tem um nó Aprimorada (%d/%d)" % [cid, skill_nodes, web_ids.size()])
		for sid in web_ids:
			check(nodes.has("%s_s_%s" % [cid, sid]) and nodes.has("%s_m_%s" % [cid, sid]) and nodes["%s_s_%s" % [cid, sid]]["kind"] == "skill_up"
				and nodes["%s_m_%s" % [cid, sid]]["kind"] == "skill_quick", "%s: nós Aprimorada e Ágil de %s" % [cid, sid])
		for t in gd.talents_for_class(cid):
			check(nodes.has("%s_t_%s" % [cid, t.id]), "%s: evolução %s na árvore" % [cid, t.id])
		var overlap: Array = []
		var ids := nodes.keys()
		for i in range(ids.size()):
			for k in range(i + 1, ids.size()):
				if (nodes[ids[i]]["pos"] as Vector2).distance_to(nodes[ids[k]]["pos"]) < 0.35:
					overlap.append("%s~%s" % [ids[i], ids[k]])
		check(overlap.is_empty(), "%s: nós não se sobrepõem no desenho %s" % [cid, overlap])
		check(cost_all > total_points, "%s: não dá pra comprar tudo — escolher é a build (%d > %d)" % [cid, cost_all, total_points])
		# --- regras ---
		var t0 = sim.spawn_character(SimEntity.Kind.BOT, cls, "Arv", "city_aldara", Vector3(-6, 0, 10), 1)
		for sid in cls.starting_skills:
			check(t0.knows(sid) and not t0.tree.has("%s_s_%s" % [cid, sid]), "%s: skill inicial %s vem sem o nó Aprimorada (compra-se)" % [cid, sid])
		t0.mastery_points = 1
		var lv1_buy := 0
		for nid in nodes:
			if sim.tree_block_reason(t0, nid) == "":
				lv1_buy += 1
		check(lv1_buy >= 1, "%s: no nível 1 com 1 ponto há nó vizinho do início para comprar (%d)" % [cid, lv1_buy])
		var near_up := 99
		for sid in cls.starting_skills:
			near_up = mini(near_up, _path_cost(gd, t0, "%s_s_%s" % [cid, sid]))
		check(near_up <= 14, "%s: Aprimorada de uma skill inicial a até 14 pontos do início (~2 níveis; %d)" % [cid, near_up])
		var far := ""
		var lvl_gate := ""
		for nid in nodes:
			if t0.tree.has(nid):
				continue
			var adj := false
			for l in nodes[nid]["links"]:
				adj = adj or t0.tree.has(l)
			if not adj and far == "":
				far = nid
			if adj and int(nodes[nid]["level"]) > 1 and lvl_gate == "":
				lvl_gate = nid
		t0.mastery_points = 50
		check(far != "" and not sim.tree_allocate(t0, far), "%s: nó sem vizinho comprado é recusado" % cid)
		if lvl_gate != "":
			check(not sim.tree_allocate(t0, lvl_gate), "%s: nó acima do nível é recusado" % cid)
		t0.mastery_points = 0
		var cheap := ""
		for nid in nodes:
			if sim.tree_block_reason(t0, nid) == "pontos insuficientes (1)":
				cheap = nid
		check(cheap != "", "%s: sem pontos, nada é comprado" % cid)
		sim.despawn(t0)
		# --- um jogador por build, do nível 1 ao 30, sempre indo atrás das skills da build ---
		for b in cls.builds:
			var e = sim.spawn_character(SimEntity.Kind.BOT, cls, "Build", "city_aldara", Vector3(-6, 0, 10), 1)
			var want: Array = b["skills"]
			var refused := 0
			for lv in range(2, Balance.MAX_LEVEL + 1):
				e.level = lv
				e.mastery_points += Balance.points_at(lv)
				ProgressionSystem.grant_level_skills(sim, e, false)      # skills chegam pelo nível
				var guard := 0
				while e.mastery_points > 0 and guard < 30:
					guard += 1
					var target := ""
					for sid in want:
						if not e.tree.has("%s_s_%s" % [cid, sid]) and gd.skills[sid].unlock_level <= lv:
							target = "%s_s_%s" % [cid, sid]
							break
					if target != "":
						var before: int = e.mastery_points
						if _path_cost(gd, e, target) <= e.mastery_points:
							if _buy_path(sim, e, target) < 0:
								refused += 1
								break
							continue
						if before == e.mastery_points:
							break
					# sobra: Ágil das skills da build, depois passivos
					var bought := false
					for kind in ["skill_quick", "notable", "stat", "talent"]:
						for nid in nodes:
							var n: Dictionary = nodes[nid]
							if n["kind"] == kind and (kind != "skill_quick" or n["ref"] in want) and sim.tree_block_reason(e, nid) == "":
								bought = sim.tree_allocate(e, nid)
								break
						if bought:
							break
					if not bought:
						break
			var missing: Array = []
			for sid in want:
				if not e.tree.has("%s_s_%s" % [cid, sid]):
					missing.append(sid)
			check(refused == 0 and missing.is_empty(), "%s/%s: do 1 ao 45 pela teia pega a Aprimorada de todas as skills da build (faltam %s)" % [cid, b["id"], missing])
			check(not e.tree_bonus.is_empty(), "%s/%s: passivos da árvore ativos (%s)" % [cid, b["id"], e.tree_bonus])
			if cid == "paladin" and b["id"] == "guardiao":
				e.recompute_stats()
				var hp_with: float = e.stats.max_hp
				var bonus: Dictionary = e.tree_bonus.duplicate()
				e.tree_bonus = {}
				e.recompute_stats()
				check(bonus.has("hp_pct") == (hp_with > e.stats.max_hp + 0.5) or not bonus.has("hp_pct"), "passivo de HP muda o HP máximo")
				sim.recompute_tree_bonus(e)
			sim.despawn(e)
	# --- save/load guarda a árvore ---
	var pl = sim.player
	var had: Array = pl.tree.keys()
	var bonus_before: Dictionary = pl.tree_bonus.duplicate()
	save.save_player(pl)
	var data: Dictionary = save.load_data()
	check(data.get("tree", []).size() == had.size(), "save guarda os nós da árvore (%d)" % had.size())
	save.delete_slot(TEST_SLOT)

func _path_cost(gd, e, target: String) -> int:
	var nodes: Dictionary = gd.trees[e.class_def.id]["nodes"]
	var dist := {}
	var queue: Array = []
	for nid in e.tree:
		dist[nid] = 0
		queue.append(nid)
	while queue.size() > 0:
		var cur: String = queue.pop_front()
		for l in nodes[cur]["links"]:
			if not dist.has(l):
				dist[l] = int(dist[cur]) + int(nodes[l]["cost"])
				queue.append(l)
	return int(dist.get(target, 999))


# ---------------------------------------------------------------------------
# skills: tema visual válido, clipe certo nos dois kits, impacto dentro do clipe (bancada: game/dev/showcase.gd)
# ---------------------------------------------------------------------------
func _check_skill_visuals(gd) -> void:
	var view_script: GDScript = load("res://game/entities/entity_view.gd")
	var impacts: Dictionary = view_script.IMPACT_FRAME
	var kits := [KitModel.create("male", Color.WHITE), KitModel.create("female", Color.WHITE)]
	var bad_theme: Array = []
	var themes_used := {}
	for sid in gd.skills:
		var s: SkillDef = gd.skills[sid]
		if not (s.vfx in SkillsCatalog.VFX_THEMES):
			bad_theme.append(sid)
		themes_used[s.vfx] = true
		check(SkillFx.PALETTE.has(s.vfx) and SkillFx.PARTS.has(s.vfx), "tema %s (%s) tem cor e partículas" % [s.vfx, sid])
	check(bad_theme.is_empty(), "toda skill tem tema visual válido %s" % [bad_theme])
	check(themes_used.size() >= 10, "skills usam temas variados (%d)" % themes_used.size())
	# cada clipe que a EntityView pode escolher existe nos dois kits e o impacto cabe nele
	for clip in impacts:
		if clip in EntityView.FORM_CLIP.values() or EntityView.MOB_ONLY_CLIPS.has(clip) or EntityView.CLASS_ONLY_CLIPS.has(clip):
			continue                     # gesto de bicho: só nas formas (_check_form_clips); de monstro ou só do kit de uma classe: _check_skill_clips
		for k in kits:
			var name: String = k.resolve(clip)
			check(name != "", "clipe %s existe no kit" % clip)
			if name != "":
				var frames: float = k.anim.get_animation(name).length * 24.0
				check(float(impacts[clip]) <= frames + 1.0, "impacto de %s (quadro %d) dentro do clipe (%d quadros)" % [clip, impacts[clip], int(frames)])
	for k in kits:
		k.free()


