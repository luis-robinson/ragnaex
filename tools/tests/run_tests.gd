## Ato II (design/gdd/ato2-horda.md F1, R7): XP achatada depois do 30, faixa nova, pontos e nível de ascensão.
func _check_act2_xp_curve(gd) -> void:
	check(Balance.MAX_LEVEL >= 40 and Balance.ASC_LEVEL == 35, "nível máximo do Ato II (%d) e ascensão no 35" % Balance.MAX_LEVEL)
	check(Balance.xp_for_level(Balance.MAX_LEVEL) == 0, "sem XP no nível máximo")
	check(Balance.xp_for_level(34) == 52250, "F1: 34 -> 35 = 52 250 (%d)" % Balance.xp_for_level(34))
	check(absf(Balance.xp_for_level(30) - 44030.0) <= 440.3, "F1: 30 -> 31 ≈ 44 030 ±1%% (%d)" % Balance.xp_for_level(30))
	check(is_equal_approx(Balance.level_minutes(30), 57.25), "F1: minutos no 30 = 57,25 (%.2f)" % Balance.level_minutes(30))
	for lv in range(30, 44):
		check(is_equal_approx(Balance.level_minutes(lv + 1) - Balance.level_minutes(lv), Balance.XP_MIN_PER_LEVEL_ACT2), "F1: minutos crescem 0,75 de %d para %d" % [lv, lv + 1])
	for lv in range(1, 29):
		check(is_equal_approx(Balance.level_minutes(lv + 1) - Balance.level_minutes(lv), Balance.XP_MIN_PER_LEVEL), "Ato I: minutos crescem 1,75 de %d para %d" % [lv, lv + 1])
	check(Balance.XP_BANDS.has([30, 35]) and is_equal_approx(Balance.quest_share(30), 0.55), "faixa 30-35 com 55%% de XP de missão")
	# fase 2 (35-40): mesma fórmula achatada; valores do F1 nível a nível e ~5,2 h de faixa
	check(Balance.XP_BANDS.has([35, 40]) and is_equal_approx(Balance.quest_share(35), 0.55), "faixa 35-40 com 55%% de XP de missão")
	var f1_35_40 := {35: 54400, 36: 56580, 37: 58800, 38: 61060, 39: 63360}
	for l in f1_35_40:
		check(Balance.xp_for_level(l) == f1_35_40[l], "F1: %d -> %d = %d (%d)" % [l, l + 1, f1_35_40[l], Balance.xp_for_level(l)])
	check(Balance.band_xp(35, 40) == 294200, "F1: faixa 35-40 = 294 200 de XP (%d)" % Balance.band_xp(35, 40))
	var h_35_40 := 0.0
	for l in range(35, 40):
		h_35_40 += Balance.level_minutes(l) / 60.0
	check(absf(h_35_40 - 5.2) < 0.1, "F1: faixa 35-40 ≈ 5,2 h (%.2f)" % h_35_40)
	for i in range(Balance.XP_BANDS.size() - 1):
		check(Balance.XP_BANDS[i][1] == Balance.XP_BANDS[i + 1][0], "faixas de XP emendam (%s -> %s)" % [Balance.XP_BANDS[i], Balance.XP_BANDS[i + 1]])
	check(Balance.XP_BANDS[-1][1] == Balance.MAX_LEVEL, "a última faixa de XP termina no nível máximo (%d)" % Balance.MAX_LEVEL)
	var web_points := 0
	for l in range(2, 41):
		web_points += Balance.points_at(l)
	check(web_points == 277, "teia: 277 pontos no 40 (%d; 7 por nível desde 2026-11-18)" % web_points)
	# pontos de ascensão no 40: 3 por nível do 35 ao 40 + 3 da missão = 21 (calculados, R6)
	var asc := SimEntity.new()
	asc.class_def = gd.classes["paladin"]
	asc.level = 40
	asc.quests_completed.append("hx_asc_paladin")
	check(ProgressionSystem.asc_points_total(asc) == 21, "ascensão: 21 pontos no 40 (%d)" % ProgressionSystem.asc_points_total(asc))
	check(Balance.points_at(40) == 8 and Balance.points_at(30) == 8 and Balance.points_at(35) == 7, "pontos: +1 no 40 como no 10/20/30, 7 no 35")
	for lv in range(31, 46):
		if lv != 40:
			check(Balance.points_at(lv) == 7, "pontos no %d = 7" % lv)
	# um personagem sobe do 30 ao máximo e para lá com XP 0
	var e := SimEntity.new()
	e.level = 30
	e.xp = 0
	var need := Balance.band_xp(30, Balance.MAX_LEVEL)
	var lv := 30
	var left := need
	while lv < Balance.MAX_LEVEL:
		left -= Balance.xp_for_level(lv)
		lv += 1
	check(left == 0 and need > 500000, "30 -> %d: %d de XP (níveis de 44-63 mil)" % [Balance.MAX_LEVEL, need])

## Ato II (GDD F10): tier comum do 32, lendário do 35 (preço 7 moedas), bônus percentuais achatados acima do tier 5.
func _check_act2_gear(gd, sim) -> void:
	check(Balance.COMMON_TIER_LEVELS.has(32) and Balance.LEGENDARY_LEVELS.find(35) == 6, "tier comum do 32 e lendário 35 no índice 6")
	var t4 := Balance.COMMON_TIER_LEVELS.find(32)
	# raridade do comum nunca vira lendário
	check(GearCatalog.common_rarity(t4) == ItemDef.RARITY_LEGENDARY - 1, "comum do 32 é épico, não lendário")
	for wtype in GearCatalog.WEAPONS:
		var it: ItemDef = gd.items.get("%s_t%d" % [wtype, t4])
		check(it != null and it.level_req == 32 and not it.is_legendary() and it.set_id == "", "arma comum do 32: %s" % wtype)
	for armor in GearCatalog.ARMOR:
		for piece in GearCatalog.FULL_PIECES:
			var it: ItemDef = gd.items.get("%s_%s_t%d" % [piece, armor, t4])
			check(it != null and it.level_req == 32 and not it.is_legendary() and it.armor_style == armor, "armadura comum do 32: %s %s" % [piece, armor])
	var pool: Array = sim.gear_pool(t4)
	check(pool.size() >= 30 and pool.all(func(x): return x.level_req >= 32 and not x.is_legendary()), "drop comum do tier 32 (%d itens)" % pool.size())
	check(not sim.gear_pool(t4 - 1).any(func(x): return x.level_req >= 32), "tier 24 não mistura peças do 32")
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	for cid in gd.classes:
		var b: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato2", "city_aldara", Vector3(0, 0, 6), 33)
		var w: ItemDef = b.equipment.get(ItemDef.Slot.WEAPON)
		var body: ItemDef = b.equipment.get(ItemDef.Slot.BODY)
		check(w != null and w.level_req == 32 and body != null and body.level_req == 32, "bot %s nível 33 veste o tier do 32" % cid)
		sim.despawn(b)
		var b30: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato1", "city_aldara", Vector3(0, 0, 6), 30)
		check(b30.equipment.values().all(func(x): return x == null or x.level_req <= 30), "bot %s nível 30 não veste peça do 32" % cid)
		sim.despawn(b30)
	# lendário 35: preço 7 moedas, fator 1,393 × 1,2, visual do 30 reaproveitado, bônus i_ef
	check(is_equal_approx(Balance.set_pct_tier(6), 5.5) and is_equal_approx(Balance.set_pct_tier(8), 6.5) and is_equal_approx(Balance.set_pct_tier(5), 5.0), "F10: i_ef 5 / 5,5 / 6,5")
	var n35 := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.level != 35 or sd.is_hybrid() or sd.is_apex():
			continue
		n35 += 1
		var v4: float = sd.bonuses[4]["skill_dmg"].values()[0]
		var cdr: float = sd.bonuses[5]["skill_cdr"].values()[0]
		check(is_equal_approx(v4, 42.0) and is_equal_approx(cdr, 21.0), "%s: 4 peças 42%% e recarga 21%% (%.1f, %.1f)" % [sid, v4, cdr])
		var stat_pct := 0.0
		for k in sd.bonuses[5]:
			if k != "skill_cdr" and str(k).ends_with("_pct") and not sd.bonuses[5][k] is Dictionary:
				stat_pct = maxf(stat_pct, float(sd.bonuses[5][k]))
		check(stat_pct >= 17.0, "%s: 5 peças +17%% no stat da build (%.1f)" % [sid, stat_pct])
		var vis: Dictionary = GearCatalog.visual_of(sid)
		var base30: String = sid.trim_suffix("_35") + "_30"
		check(vis.get("reuse", "") == base30 and (vis.has("act2") or vis.get("style", "") == GearCatalog.SET_VISUALS[base30]["style"]), "%s: visual do conjunto 30 (ou o do Ato II da build)" % sid)
		var head: ItemDef = gd.items[sd.armor[0]]
		check(head.armor_style == vis["style"] and head.name.ends_with("da Ascensão"), "%s: peça com estilo do 30 e nome próprio (%s)" % [sid, head.name])
		var w: ItemDef = gd.items[sid.replace("set_", "leg_") + "_weapon"]
		check(sim.relic_cost(w) == 7, "%s: custa 7 moedas" % sid)
		var w30: ItemDef = gd.items[base30.replace("set_", "leg_") + "_weapon"]
		check(w.atk >= w30.atk, "%s: arma não fica abaixo da do 30" % sid)
	check(n35 == 24, "24 conjuntos lendários do 35, um por build (%d)" % n35)
	var fire30: SetDef = gd.sets["set_elementalist_fogo_30"]
	check(is_equal_approx(fire30.bonuses[4]["skill_dmg"].values()[0], 40.0), "Ato I sem mudança: 4 peças do 30 = 40%")
	_check_act2_gear_40(gd, sim)
	_check_kharzun_cap(gd, sim)
	var sword35: ItemDef = gd.items["sword_t%d" % t4]
	var f35 := GearCatalog.level_factor(35)
	check(absf(f35 - 39.0 / 28.0) < 0.001, "F10: fator do nível 35 = 1,393 (%.3f)" % f35)
	check(absf(GearCatalog.level_factor(40) * Balance.LEGENDARY_MULT - 1.886) < 0.01, "F10: lendário 40 = 1,89 do item base 24")
	check(sword35.atk > gd.items["sword_dragon"].atk, "espada do 32 bate a Dracônica (%d)" % int(sword35.atk))

## Conjuntos híbridos e Fusões (GDD Ato II R7.1, AC-32b/c; design/gdd/ato2-proposals-2026-11-11.md §1.7).
func _check_hybrid_sets(gd, sim) -> void:
	var hyb: Array = gd.sets.values().filter(func(x): return x.is_hybrid())
	check(hyb.size() == 24, "24 conjuntos híbridos (P3, Bi3, 3 Ele, 3 Necro × 3 tiers): %d" % hyb.size())
	var n_apex: int = gd.sets.values().filter(func(x): return x.is_apex()).size()
	var n_build: int = gd.sets.size() - hyb.size() - n_apex
	check(n_build == 24 * Balance.LEGENDARY_LEVELS.size(), "conjuntos da build seguem 24 × níveis lendários (%d)" % n_build)
	check(Balance.HYBRID_LEVELS == [35, 40, 45] and Balance.legend_tier(35) == 6 and Balance.legend_tier(40) == 7 and Balance.legend_tier(45) == 8, "híbridos 35/40/45 nos tiers 6/7/8")
	# Fusões: as 8 que ficaram (apice-sets.md §5), números e textos coerentes
	var fk: Array = GearCatalog.FUSIONS.keys()
	var nk: Array = Balance.FUSION_NUMBERS.keys()
	fk.sort()
	nk.sort()
	check(fk.size() == 8 and fk == nk, "8 Fusões (P3, Bi3, Elementalista, Necromante) com números: %s" % str(fk))
	check(FusionEffects.NEW_HOOKS.size() <= 6, "no máximo 6 ganchos novos na sim (%d)" % FusionEffects.NEW_HOOKS.size())
	check(not ("on_overheal" in FusionEffects.NEW_HOOKS) and not (load("res://core/sim/systems/fusion_effects.gd") as Script).get_script_method_list().any(func(m): return m["name"] == "on_overheal"), "gancho da sobrecura (Bi1) saiu junto com a Fusão")
	var want_pairs := {"paladin": 1, "bishop": 1, "elementalist": 3, "necromancer": 3, "berserker": 0, "ranger": 0, "druid": 0, "assassin": 0}
	var names := {}
	var dup: Array = []
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var pairs: Array = GearCatalog.hybrid_pairs(cls)
		check(pairs.size() == int(want_pairs.get(cid, -1)), "%s: %d pares de híbrido (%d)" % [cid, int(want_pairs.get(cid, -1)), pairs.size()])
		for pair in pairs:
			var fid := "%s+%s" % pair
			check(GearCatalog.FUSIONS.has(fid) and Balance.FUSION_NUMBERS.has(fid), "%s: Fusão %s existe" % [cid, fid])
			var fu: Dictionary = GearCatalog.FUSIONS.get(fid, {})
			var ba: Dictionary = cls.build_by_id(pair[0])
			var bb: Dictionary = cls.build_by_id(pair[1])
			var same_weapon: bool = ba["main"] == bb["main"] and ba["off"] == bb["off"]
			var faces: Array = (fu.get("text", {}) as Dictionary).keys()
			check(faces.all(func(k): return k == "all" or k in pair), "%s: faces da Fusão são de A, B ou 'all'" % fid)
			check(not same_weapon or faces == ["all"], "%s: mesma arma = uma face" % fid)
			for lv in Balance.HYBRID_LEVELS:
				var sd: SetDef = gd.sets.get(GearCatalog.hybrid_set_id(cid, pair[0], pair[1], lv))
				check(sd != null, "%s: híbrido %s nível %d existe" % [cid, fid, lv])
				if sd == null:
					continue
				var tier := Balance.legend_tier(lv)
				check(sd.armor.size() == 5 and sd.pieces == sd.armor and sd.fusion == fid and sd.pair == pair and sd.class_id == cid and not sd.is_apex(), "%s: 5 peças de armadura, par e Fusão" % sd.id)
				for pid in sd.armor:
					var it: ItemDef = gd.items[pid]
					var piece: String = pid.get_slice("_", pid.get_slice_count("_") - 1)
					check(it.set_id == sd.id and it.is_legendary() and it.level_req == lv and it.class_restriction == [cid], "%s: peça coerente" % pid)
					check(it.armor_style == ba["armor"] or (piece != "legs" and it.armor_style != ""), "%s: armadura do lado A (%s)" % [pid, it.armor_style])
					check(it.attr(ba["attr"]) > 0 and (ba["attr"] == bb["attr"] or it.attr(bb["attr"]) > 0), "%s: atributo de A e de B" % pid)
					check(it.icon != "" and ResourceLoader.exists("res://assets/icons/%s.png" % it.icon) if piece != "legs" else ResourceLoader.exists("res://assets/icons/art_%s.png" % pid), "%s: ícone/arte" % pid)
				for bd in [ba, bb]:
					var wid := "leg_%s_mix_%s_%s_%d_%s_weapon" % [cid, pair[0], pair[1], lv, bd["id"]]
					var w: ItemDef = gd.items.get(wid)
					check(w != null and wid in sd.alt_pieces and w.weapon_type == bd["main"][0] and str(w.legend_effect.get("kind", "")) == str(bd["legend"]["kind"]), "%s: arma da build %s (efeito %s)" % [sd.id, bd["id"], bd["legend"]["kind"]])
					if bd["off"].size() > 0:
						check(gd.items.has(wid.replace("_weapon", "_offhand")) and wid.replace("_weapon", "_offhand") in sd.alt_pieces, "%s: mão secundária da build %s" % [sd.id, bd["id"]])
				for iid in sd.pieces + sd.alt_pieces:
					var nm: String = gd.items[iid].name
					if names.has(nm):
						dup.append(nm)
					names[nm] = true
					if iid in sd.alt_pieces:
						var w2: ItemDef = gd.items[iid]
						check(w2.icon == "" or ResourceLoader.exists("res://assets/icons/%s.png" % w2.icon) or ResourceLoader.exists("res://assets/icons/art_%s.png" % iid), "%s: ícone da arma" % iid)
				check(sim.relic_cost(gd.items[sd.armor[0]]) == tier + 1, "%s: custa %d moedas" % [sd.id, tier + 1])
				# bônus R7.1: 2 = de A, 3 = de B, 4 = metade do 4 de A e de B, 5 = Fusão (substitui o 5 normal)
				var pa := GearCatalog.set_skills(ba, gd.skills, lv, tier)
				var pb := GearCatalog.set_skills(bb, gd.skills, lv, tier)
				var na := GearCatalog.set_bonuses(ba, pa[0], pa[1], tier)
				var nb := GearCatalog.set_bonuses(bb, pb[0], pb[1], tier)
				var ks := sd.bonuses.keys()
				ks.sort()
				check(ks == [2, 3, 4, 5], "%s: bônus de 2/3/4/5" % sd.id)
				check(str(sd.bonuses[2].keys()) == str(na[2].keys()) and str(sd.bonuses[3].keys()) == str(nb[3].keys()), "%s: 2 peças de A, 3 peças de B" % sd.id)
				var want4 := 0.0
				for src in [na[4], nb[4]]:
					for v in src["skill_dmg"].values():
						want4 += float(v) * Balance.HYBRID_4PC_SHARE
				var got4 := 0.0
				for v in sd.bonuses[4]["skill_dmg"].values():
					got4 += float(v)
				check(absf(got4 - want4) < 0.2 and sd.bonuses[4]["skill_dmg"].has(pa[0]) and sd.bonuses[4]["skill_dmg"].has(pb[0]), "%s: 4 peças = metade de A + metade de B (%.1f)" % [sd.id, got4])
				var f5: Dictionary = sd.bonuses[5]
				check(f5.size() == 1 and f5.get("fusion") is Dictionary and str(f5["fusion"]["id"]) == fid, "%s: 5 peças = só a Fusão (sem stat%% e recarga)" % sd.id)
				var nums: Dictionary = Balance.FUSION_NUMBERS[fid]
				for k in nums:
					var want: float = float(nums[k][0]) + float(nums[k][1]) * (tier - 6) if nums[k] is Array else float(nums[k])
					check(absf(float(f5["fusion"].get(k, -999.0)) - want) < 0.011, "%s: F-FUS1 %s = %.2f" % [sd.id, k, want])
					if nums[k] is Array:
						check(float(f5["fusion"][k]) >= 0.79 * float(nums[k][0]), "%s: %s nunca abaixo de 80%% do v35" % [sd.id, k])
	check(dup.is_empty(), "nomes das peças híbridas únicos %s" % str(dup.slice(0, 4)))
	var gone: Array = gd.items.keys().filter(func(k): return str(k).contains("_mix_") and (str(k).begins_with("leg_berserker_") or str(k).begins_with("leg_ranger_") or str(k).begins_with("leg_druid_") or str(k).begins_with("leg_assassin_")))
	check(gone.is_empty(), "nenhum híbrido de Berserker/Ranger/Druida/Assassino (%s)" % str(gone.slice(0, 3)))
	# Relicária: o híbrido que ficou aparece para as duas builds do par; o 45 espera o MAX_LEVEL
	check(ItemSystem.relic_levels().has(35) and ItemSystem.relic_levels().has(40) and (Balance.MAX_LEVEL >= 45) == ItemSystem.relic_levels().has(45), "Relicária: híbridos até o MAX_LEVEL")
	var pal: ClassDef = gd.classes["paladin"]
	var p3 := GearCatalog.hybrid_set_id("paladin", "templario", "guardiao", 40)
	for bid in ["guardiao", "templario"]:
		var hs: Array = gd.hybrid_sets_for(pal, bid, 40).map(func(x): return x.id)
		check(hs == [p3], "aba %s da Relicária mostra o híbrido P3 (%s)" % [bid, hs])
	check(gd.hybrid_sets_for(pal, "cruzado", 40).is_empty(), "aba do Cruzado: sem híbrido (tem o Ápice)")
	check(gd.legendary_pool(pal, 35, "guardiao").has("leg_paladin_mix_templario_guardiao_35_head"), "híbrido cai/troca para as duas builds do par")
	# face pela arma; 4 peças sem Fusão; arma de fora apaga
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	var p: SimEntity = sim.spawn_bot(pal, "Hib", "city_aldara", Vector3(0, 0, 6), 40)
	var sd1: SetDef = gd.sets[p3]
	for i in range(4):
		p.equipment[gd.items[sd1.armor[i]].slot] = gd.items[sd1.armor[i]]
	p.equipment[ItemDef.Slot.WEAPON] = gd.items["sword_t5"]
	p.equipment[ItemDef.Slot.OFFHAND] = gd.items["shield_t5"] if gd.items.has("shield_t5") else gd.items["shield_wood"]
	p.recompute_stats()
	check(p.stats.fusion.is_empty(), "4 peças: sem Fusão")
	p.equipment[gd.items[sd1.armor[4]].slot] = gd.items[sd1.armor[4]]
	p.recompute_stats()
	check(str(p.stats.fusion.get("id", "")) == "templario+guardiao" and p.stats.fusion["face"] != "", "5 peças + espada e escudo: Égide Ardente ligada")
	p.equipment[ItemDef.Slot.WEAPON] = gd.items["sword2h_t5"]
	p.equipment.erase(ItemDef.Slot.OFFHAND)
	p.recompute_stats()
	check(p.stats.fusion["face"] == "", "5 peças + espada de 2 mãos: Égide Ardente apagada")
	sim.despawn(p)
	# AC-32c / R-AP6: Guardião e Templário pegam P3; abaixo do 35, o conjunto da build
	var b: SimEntity = sim.spawn_bot(pal, "Esc", "city_aldara", Vector3(0, 0, 6), 40)
	b.build_id = "guardiao"
	check(sim.bot_legendary_set(b, 40) == p3, "R-AP6: Guardião pega P3 (%s)" % sim.bot_legendary_set(b, 40))
	check(sim.bot_legendary_set(b, 30) == "set_paladin_guardiao_30", "abaixo do 35 o bot fica com o conjunto da build")
	sim.despawn(b)
	# E1 Vapor: gelo em alvo queimando consome a queimadura e causa o dano na hora
	var ele: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Vap", "city_aldara", Vector3(0, 0, 6), 40)
	var sde: SetDef = gd.sets[GearCatalog.hybrid_set_id("elementalist", "fogo", "gelo", 40)]
	for pid in sde.armor:
		ele.equipment[gd.items[pid].slot] = gd.items[pid]
	ele.recompute_stats()
	var t2: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(1, 0, 6))
	t2.stats.max_hp = 1.0e6
	t2.hp = 1.0e6
	t2.debuffs.append({"kind": "dot", "id": "dot_%d" % ele.id, "remaining": 4.0, "dps": 100.0, "src": ele.id, "fire": true})
	FusionEffects.on_hit(sim, ele, t2, gd.skills["ele_ice_lance"], 10, false)
	check(t2.hp <= 1.0e6 - 400.0 * 1.4 and not t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor: gelo apaga a queimadura e causa %d%% dela na hora" % int(FusionEffects.num(ele, "quench")))
	# E1 (2026-11-12): fogo em alvo retardado também faz Vapor; com recarga (o vapor retarda: não se encadeia) e nada sem o alvo retardado
	var fb: SkillDef = gd.skills["ele_fireball"]
	var burn := {"kind": "dot", "id": "dot_%d" % ele.id, "remaining": 4.0, "dps": 100.0, "src": ele.id, "fire": true}
	t2.debuffs.clear()
	t2.hp = 1.0e6
	t2.debuffs.append(burn.duplicate())
	FusionEffects.on_hit(sim, ele, t2, fb, 10, false)
	check(is_equal_approx(t2.hp, 1.0e6) and t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor: fogo em alvo SEM lentidão não apaga a queimadura")
	t2.debuffs.append({"kind": "slow", "remaining": 3.0, "pct": 30.0})
	ele.fus.erase("vapor_at")
	FusionEffects.on_hit(sim, ele, t2, fb, 10, false)
	check(t2.hp <= 1.0e6 - 400.0 * 1.4 and not t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor: fogo em alvo retardado apaga a queimadura e causa %d%% dela na hora" % int(FusionEffects.num(ele, "quench")))
	var hp1 := t2.hp
	t2.debuffs.append(burn.duplicate())
	FusionEffects.on_hit(sim, ele, t2, fb, 10, false)
	check(is_equal_approx(t2.hp, hp1) and t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor por fogo tem recarga de %.1f s (não se encadeia no próprio retardo)" % Balance.FUSION_VAPOR_ICD)
	FusionEffects.on_hit(sim, ele, t2, gd.skills["ele_ice_lance"], 10, false)
	check(t2.hp < hp1 and not t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor por gelo segue sem recarga")
	check(GearCatalog.FUSIONS["fogo+gelo"]["text"]["all"].contains("fogo em alvo retardado"), "texto do Vapor cita o gatilho do fogo")
	sim.despawn(t2)
	sim.despawn(ele)
	_check_fusion_redesign(gd, sim)

## Veste `n` peças do híbrido A+B nível 40 e a arma (e mão secundária) dada; devolve o personagem com os stats refeitos.
func _wear_hybrid(gd, e: SimEntity, a: String, b: String, n: int, weapon: String, off: String = "") -> SimEntity:
	return _wear_set(gd, e, gd.sets[GearCatalog.hybrid_set_id(e.class_def.id, a, b, 40)], n, weapon, off)

## Veste `n` peças do Ápice da build no nível `lv` e a arma (e mão secundária) dada.
func _wear_apex(gd, e: SimEntity, bid: String, n: int, weapon: String, off: String = "", lv: int = 40) -> SimEntity:
	return _wear_set(gd, e, gd.sets[GearCatalog.apex_set_id(e.class_def.id, bid, lv)], n, weapon, off)

func _wear_set(gd, e: SimEntity, sd: SetDef, n: int, weapon: String, off: String) -> SimEntity:
	for i in range(5):
		var it: ItemDef = gd.items[sd.armor[i]]
		if i < n:
			e.equipment[it.slot] = it
		else:
			e.equipment.erase(it.slot)
	e.equipment[ItemDef.Slot.WEAPON] = gd.items[weapon]
	if off != "":
		e.equipment[ItemDef.Slot.OFFHAND] = gd.items[off]
	else:
		e.equipment.erase(ItemDef.Slot.OFFHAND)
	e.recompute_stats()
	return e

func _big_mob(gd, sim, at: Vector3) -> SimEntity:
	var m: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", at)
	m.stats.max_hp = 1.0e7
	m.hp = 1.0e7
	return m

## Fusões que ficaram (redesenho 2026-11-12, GDD ato2-proposals 1.9): N2 quase sempre ligada; E1 com regra de bot. Cada uma
## dispara com 5 peças e fica apagada com 4. (P2, Bi2 e D2 viraram Ápices: _check_apex_rules.)
func _check_fusion_redesign(gd, sim) -> void:
	var at := Vector3(0, 0, 6)
	# N2 Colheita da Praga: golpe de foice põe Praga Menor (maldição, até 3); cada maldição dá dano e roubo de vida
	var nec: SimEntity = _wear_hybrid(gd, sim.spawn_bot(gd.classes["necromancer"], "Pra", "city_aldara", at, 40), "ceifador", "pestilento", 5, "scythe_t5")
	var mob: SimEntity = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	var nb: SkillDef = gd.basic_skill_for_class(nec.class_def, "scythe")
	for i in range(4):
		FusionEffects.on_hit(sim, nec, mob, nb, 10, false)
	var cd := FusionEffects.num(nec, "curse_dmg")
	check(FusionEffects._curses(nec, mob) == Balance.FUSION_PLAGUE_MAX and mob.debuffs.any(func(d): return d.get("kind") == "curse" and int(d.get("stacks", 0)) == Balance.FUSION_PLAGUE_MAX),
		"Colheita da Praga: golpes de foice põem Praga Menor até %d (maldição)" % Balance.FUSION_PLAGUE_MAX)
	check(absf(FusionEffects.hit_mult(sim, nec, mob, nb) - (1.0 + 3.0 * cd / 100.0)) < 0.001, "Colheita da Praga: +%.1f%% por maldição na foice" % cd)
	nec.hp = nec.stats.max_hp * 0.5
	var nhp: float = nec.hp
	FusionEffects.on_hit(sim, nec, mob, nb, 1000, false)
	check(nec.hp > nhp, "Colheita da Praga: roubo de vida por maldição")
	var m3: SimEntity = _big_mob(gd, sim, at + Vector3(-1, 0, 0))
	_wear_hybrid(gd, nec, "ceifador", "pestilento", 4, "scythe_t5")
	FusionEffects.on_hit(sim, nec, m3, nb, 10, false)
	check(FusionEffects._curses(nec, m3) == 0, "Colheita da Praga: 4 peças = sem Praga Menor")
	sim.despawn(nec)
	sim.despawn(mob)
	sim.despawn(m3)
	# E1 Vapor (bots): com a Fusão, gelo em alvo que queima com o seu fogo pesa mais na escolha
	var ele: SimEntity = _wear_hybrid(gd, sim.spawn_bot(gd.classes["elementalist"], "Vp2", "city_aldara", at, 40), "fogo", "gelo", 5, "staff_t5")
	mob = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	check(is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_ice_lance"]), 1.0), "Vapor (bot): alvo sem queimar, gelo sem peso extra")
	mob.debuffs.append({"kind": "dot", "id": "dot_%d" % ele.id, "remaining": 4.0, "dps": 10.0, "src": ele.id, "fire": true})
	check(is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_ice_lance"]), Balance.BOT_FUSION_SCORE) and is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_fireball"]), 1.0),
		"Vapor (bot): alvo queimando, gelo pesa x%.1f (fogo não)" % Balance.BOT_FUSION_SCORE)
	ele.build_id = "fogo"
	sim._slot_bot(ele)
	var fs: SkillDef = FusionEffects.bot_slot_skill(ele)
	check(fs != null and ele.slot_of(fs.id) >= 0 and ele.slot_of(fs.id) < Balance.SKILL_SLOTS, "Vapor (bot): bot do Fogo com a Fusão leva uma skill de gelo na barra (%s)" % (fs.id if fs else "nenhuma"))
	_wear_hybrid(gd, ele, "fogo", "gelo", 4, "staff_t5")
	check(is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_ice_lance"]), 1.0) and FusionEffects.bot_slot_skill(ele) == null, "Vapor (bot): 4 peças = sem peso nem skill de gelo forçada")
	sim.despawn(ele)
	sim.despawn(mob)

## Conjuntos Ápice (design/gdd/apice-sets.md §7 checks 1, 3, 4, 6, 7): ids, nomes, peças, armas, bônus, números F-AP1,
## visual R-AP5, face pela arma, drop/Relicária/bot.
## Visual do Ato II (GearCatalog.ACT2_VISUALS): uma malha nova por build para 35/40/45 e o Ápice dela; o nível muda a cor do
## item e a das peças acesas (material tint_glow* do kit, pintado pelo KitModel).
func _check_act2_visuals(gd, _sim) -> void:
	var styles := {}
	for key: String in GearCatalog.ACT2_VISUALS:
		var a2: Dictionary = GearCatalog.ACT2_VISUALS[key]
		var cid: String = key.get_slice("_", 0)
		var bid: String = key.trim_prefix(cid + "_")
		var cls: ClassDef = gd.classes.get(cid)
		check(cls != null and not cls.build_by_id(bid).is_empty(), "%s: build existe" % key)
		if cls == null:
			continue
		var style: String = a2["style"]
		var s30: String = GearCatalog.SET_VISUALS["set_%s_30" % key]["style"]
		check(style != s30 and not styles.has(style), "%s: estilo próprio do Ato II (%s), diferente do 30 e das outras builds" % [key, style])
		styles[style] = true
		var cols: Array = a2["colors"]
		var glows: Array = a2["glows"]
		check(cols.size() == Balance.HYBRID_LEVELS.size() and glows.size() == cols.size(), "%s: uma cor e um brilho por nível" % key)
		check(GearCatalog.set_glow("set_%s_30" % key).a == 0.0, "%s: o conjunto 30 não tem brilho de nível" % key)
		var seen := {}
		for li in range(Balance.HYBRID_LEVELS.size()):
			var lv: int = Balance.HYBRID_LEVELS[li]
			var sid := "set_%s_%d" % [key, lv]
			seen[(cols[li] as Color).to_html()] = true
			var ids: Array = [sid]
			if GearCatalog.APEX.has(bid):
				ids.append(GearCatalog.apex_set_id(cid, bid, lv))
			for id: String in ids:
				var sd: SetDef = gd.sets.get(id)
				check(sd != null, "%s existe" % id)
				if sd == null:
					continue
				var want: Color = GearCatalog.apex_color(cols[li]) if sd.is_apex() else cols[li]
				for pid in sd.armor:
					var it: ItemDef = gd.items[pid]
					check(it.slot == ItemDef.Slot.LEGS or it.armor_style == style, "%s: malha do Ato II (%s)" % [pid, it.armor_style])
					check(it.icon_color.is_equal_approx(want), "%s: cor do nível" % pid)
				for wid in sd.pieces + sd.alt_pieces:
					var w: ItemDef = gd.items[wid]
					if w.slot == ItemDef.Slot.WEAPON and w.weapon_type != "shield":
						check(w.weapon_style == str(a2.get("wpn", style)), "%s: arma do Ato II (%s)" % [wid, w.weapon_style])
				check(GearCatalog.set_glow(id).is_equal_approx(glows[li]), "%s: brilho do nível" % id)
		check(seen.size() == cols.size(), "%s: 35, 40 e 45 com cores diferentes" % key)
		_check_act2_extras(gd, key, a2)
		for body in ["male", "female"]:
			var k := KitModel.create(body, Color.WHITE, 0.025, cid)
			if k == null:
				check(false, "kit_%s_%s abre" % [cid, body])
				continue
			if KitModel.addon_exists(body, cid):          # classe com kit extra (Paladino): as peças do Ato II moram lá (_check_kit_addon)
				k.load_addon()
			for slot in ["head", "body", "gloves", "boots"]:
				check(k.pieces("arm_%s_%s_*" % [style, slot]).size() == 1, "kit_%s_%s: %s do %s numa malha só" % [cid, body, slot, style])
			var eq := {}
			var sd45: SetDef = gd.sets["set_%s_%d" % [key, Balance.HYBRID_LEVELS[-1]]]
			for pid in sd45.pieces:
				var it: ItemDef = gd.items[pid]
				eq[ItemDef.Slot.OFFHAND if pid.ends_with("_offhand") else it.slot] = it
			var main: ItemDef = eq[ItemDef.Slot.WEAPON]
			check(k.main_node(main) == "wpn_main_%s_%s" % [main.weapon_type, main.weapon_style], "kit_%s_%s: arma do Ato II no kit (%s)" % [cid, body, k.main_node(main)])
			k.apply_equipment(eq)
			var lit := 0
			var right := 0
			for n in k._glows:
				if k._vis.get(n, false):
					for m: ShaderMaterial in k._glows[n]:
						lit += 1
						var c: Color = m.get_shader_parameter("albedo")
						right += 1 if c.is_equal_approx(glows[-1]) else 0
			check(lit >= 3 and right == lit, "kit_%s_%s: peças acesas do %s na cor do nível 45 (%d de %d)" % [cid, body, style, right, lit])
			k.free()
	_check_kit_addon(gd)

## Kit extra (kit_<classe>_<sexo>_a2.glb; KitModel.load_addon): as armaduras do Ato II do Paladino ficam fora do kit principal
## (teto de 200 malhas por boneco) e só são lidas quando uma peça delas é vestida; sem o arquivo, visual do nível 30.
func _check_kit_addon(gd) -> void:
	var cid := "paladin"
	var styles: Array = []
	for key: String in GearCatalog.ACT2_VISUALS:
		if key.begins_with(cid + "_"):
			styles.append(GearCatalog.ACT2_VISUALS[key]["style"])
			check(GearCatalog.act2_fallback_style(styles[-1]) == str(GearCatalog.SET_VISUALS["set_%s_30" % key]["style"]), "kit extra: %s cai no estilo do 30 da build" % styles[-1])
	check(styles.size() == 3, "kit extra: as 3 builds do Paladino têm armadura do Ato II (%d)" % styles.size())
	check(GearCatalog.act2_fallback_style("pal_g30") == "" and GearCatalog.act2_fallback_style("plate") == "", "kit extra: estilo que não é do Ato II não tem troca")
	for other in gd.classes:
		if other != cid:
			check(not KitModel.addon_exists("male", other) and not KitModel.addon_exists("female", other), "kit extra: só o Paladino tem (%s)" % other)
	check(not KitModel.addon_exists("male", ""), "kit extra: o kit genérico não tem")
	var slots: Array = ["head", "body", "gloves", "boots"]
	for body in ["male", "female"]:
		check(KitModel.addon_exists(body, cid) and KitModel.addon_path_for(body, cid).ends_with("kit_paladin_%s_a2.glb" % body), "kit extra: kit_paladin_%s_a2.glb existe" % body)
		var k := KitModel.create(body, Color.WHITE, 0.025, cid)
		if k == null or not KitModel.addon_exists(body, cid):
			continue
		var main_count: int = k.pieces("*").size()
		check(main_count < 200, "kit extra: kit_paladin_%s principal abaixo de 200 malhas (%d)" % [body, main_count])
		check(k.pieces("arm_pal_?35_*").is_empty(), "kit extra: nenhuma peça do Ato II no kit principal do Paladino (%s)" % body)
		# equipamento do nível 30: nada do kit extra é lido nem anexado
		var loads0: int = KitModel.addon_loads
		var eq30 := {}
		for pid in (gd.sets["set_paladin_guardiao_30"] as SetDef).pieces:
			var it: ItemDef = gd.items[pid]
			eq30[ItemDef.Slot.OFFHAND if pid.ends_with("_offhand") else it.slot] = it
		k.apply_equipment(eq30)
		check(not k.addon_loaded and k.pieces("*").size() == main_count, "kit extra: conjunto do nível 30 não carrega o kit extra (%s)" % body)
		# conjunto do Ato II: carrega, e as 4 peças de cada estilo estão lá, uma malha por slot, no esqueleto do kit
		var eq := {}
		var sd: SetDef = gd.sets["set_paladin_guardiao_%d" % Balance.HYBRID_LEVELS[0]]
		for pid in sd.pieces:
			var it: ItemDef = gd.items[pid]
			eq[ItemDef.Slot.OFFHAND if pid.ends_with("_offhand") else it.slot] = it
		k.apply_equipment(eq)
		check(k.addon_loaded and KitModel.addon_loads <= loads0 + 1, "kit extra: conjunto do Ato II carrega o kit extra uma vez (%s)" % body)
		for style: String in styles:
			for slot: String in slots:
				check(k.pieces("arm_%s_%s_*" % [style, slot]).size() == 1, "kit extra: %s do %s numa malha só (%s)" % [slot, style, body])
		check(k.pieces("*").size() == main_count + styles.size() * slots.size(), "kit extra: só as 12 peças do Ato II entram (%d -> %d)" % [main_count, k.pieces("*").size()])
		var style35: String = GearCatalog.ACT2_VISUALS["paladin_guardiao"]["style"]
		var shown := 0
		var same_skin := true
		var ref_skin: Skin = (k.pieces("base_body*")[0] as MeshInstance3D).skin if not k.pieces("base_body*").is_empty() else null
		for mi: MeshInstance3D in k.pieces("arm_pal_?35_*"):
			same_skin = same_skin and ref_skin != null and mi.skin == ref_skin
			if k._vis.get(mi.name, false):
				shown += 1
				check(String(mi.name).begins_with("arm_%s_" % style35) and mi.get_parent() == k.skeleton, "kit extra: %s visível e preso ao esqueleto do kit" % mi.name)
		check(shown == slots.size() and same_skin, "kit extra: 4 peças do %s à mostra, com o skin do kit principal (%d)" % [style35, shown])
		check(k.pieces("arm_pal_g30_*").all(func(m): return not k._vis.get(m.name, false)), "kit extra: armadura do 30 some ao vestir a do Ato II")
		var off: ItemDef = eq.get(ItemDef.Slot.OFFHAND)
		check(off != null and off.shield_style == "pal_g30" and k._vis.get(k.off_node_of(off), false), "kit extra: escudo do nível 30 mantido no Ato II")
		var mainw: ItemDef = eq[ItemDef.Slot.WEAPON]
		check(mainw.weapon_style == "pal_g30" and k._vis.get(k.main_node(mainw), false) and k.main_node(mainw) == "wpn_main_sword_pal_g30", "kit extra: espada do nível 30 mantida no Ato II")
		k.set_flash(1.0)          # o flash de dano alcança as peças do kit extra (materiais em k.mats)
		var flashed := true
		for mi: MeshInstance3D in k.pieces("arm_%s_*" % style35):
			for si in range(mi.get_surface_override_material_count()):
				var sm := mi.get_surface_override_material(si) as ShaderMaterial
				flashed = flashed and sm != null and k.mats.has(sm) and is_equal_approx(float(sm.get_shader_parameter("flash")), 1.0)
		check(flashed, "kit extra: flash de dano nas peças do Ato II (%s)" % body)
		# outro boneco do mesmo kit: o arquivo não é lido de novo
		var loads1: int = KitModel.addon_loads
		var k2 := KitModel.create(body, Color.WHITE, 0.025, cid)
		k2.apply_equipment(eq)
		check(k2.addon_loaded and KitModel.addon_loads == loads1, "kit extra: 2º boneco reaproveita o arquivo já lido (%s)" % body)
		# sem o arquivo: visual do nível 30 da build, sem erro
		k2.free()
		var k3 := KitModel.create(body, Color.WHITE, 0.025, cid)
		k3._addon_path = "res://assets/models/kit_nao_existe_a2.glb"
		k3.apply_equipment(eq)
		var fb := 0
		for mi: MeshInstance3D in k3.pieces("arm_pal_g30_*"):
			fb += 1 if k3._vis.get(mi.name, false) else 0
		check(not k3.addon_loaded and fb == slots.size(), "kit extra: sem o arquivo o boneco veste o visual do 30 (%d peças, %s)" % [fb, body])
		k3.free()
		k.free()
	# toda peça de armadura do Ato II do Paladino (build, Ápice e híbrido) aponta para um estilo do kit extra
	for sid in gd.sets:
		var psd: SetDef = gd.sets[sid]
		if psd.class_id != cid or Balance.HYBRID_LEVELS.find(int(String(sid).get_slice("_", String(sid).get_slice_count("_") - 1))) < 0:
			continue
		for pid in psd.armor:
			var it: ItemDef = gd.items[pid]
			if it.slot != ItemDef.Slot.LEGS:
				check(it.armor_style in styles, "kit extra: %s veste armadura do Ato II (%s)" % [pid, it.armor_style])

## Ato II, opcionais por build (ACT2_VISUALS): destaque escolhido por nível, nome próprio e ícone próprio (uma foto por build).
func _check_act2_extras(gd, key: String, a2: Dictionary) -> void:
	var cid: String = key.get_slice("_", 0)
	var bid: String = key.trim_prefix(cid + "_")
	var levels: Array = Balance.HYBRID_LEVELS
	check(GearCatalog.set_accent("set_%s_30" % key).a == 0.0, "%s: o conjunto 30 fica com o destaque derivado da cor" % key)
	if a2.has("accents"):
		var accs: Array = a2["accents"]
		check(accs.size() == levels.size(), "%s: um destaque por nível" % key)
		for li in range(mini(accs.size(), levels.size())):
			var ids: Array = ["set_%s_%d" % [key, levels[li]]]
			if GearCatalog.APEX.has(bid):
				ids.append(GearCatalog.apex_set_id(cid, bid, levels[li]))
			for id: String in ids:
				check(GearCatalog.set_accent(id).is_equal_approx(accs[li]), "%s: destaque do nível" % id)
			var a: Color = accs[li]
			var c: Color = a2["colors"][li]
			check(absf(a.r - c.r) + absf(a.g - c.g) + absf(a.b - c.b) > 0.3, "%s %d: destaque contrasta com a cor do item" % [key, levels[li]])
		var k := KitModel.create("male", Color.WHITE, 0.025, cid)
		if k != null:
			var eq := {}
			for pid in (gd.sets["set_%s_%d" % [key, levels[0]]] as SetDef).pieces:
				var it: ItemDef = gd.items[pid]
				eq[ItemDef.Slot.OFFHAND if pid.ends_with("_offhand") else it.slot] = it
			k.apply_equipment(eq)
			var painted := 0
			var right := 0
			for n in k._accents:
				if k._vis.get(n, false) and (n as String).begins_with("arm_%s_" % a2["style"]):
					for m: ShaderMaterial in k._accents[n]:
						painted += 1
						right += 1 if (m.get_shader_parameter("albedo") as Color).is_equal_approx(accs[0]) else 0
			check(painted >= 1 and right == painted, "kit_%s: tint2 do %s no destaque do nível 35 (%d de %d)" % [cid, a2["style"], right, painted])
			k.free()
	if a2.has("suffix"):
		var names := {}
		for lv: int in levels:
			var sd: SetDef = gd.sets["set_%s_%d" % [key, lv]]
			var ep: String = GearCatalog.TIER_EPITHETS[Balance.LEGENDARY_LEVELS.find(lv)]
			check(sd.name == "Conjunto %s %s" % [a2["name"], ep], "%s: nome próprio do conjunto (%s)" % [sd.id, sd.name])
			for pid in sd.pieces + sd.alt_pieces:
				var it: ItemDef = gd.items[pid]
				check(it.name.ends_with("%s %s" % [a2["suffix"], ep]), "%s: nome próprio da peça (%s)" % [pid, it.name])
				check(not names.has(it.name), "%s: nome sem repetir (%s)" % [pid, it.name])
				names[it.name] = true
	if a2.has("icon"):
		var sd40: SetDef = gd.sets["set_%s_%d" % [key, levels[1]]]
		for pid in sd40.pieces + sd40.alt_pieces:
			var it: ItemDef = gd.items[pid]
			if it.slot == ItemDef.Slot.LEGS:
				continue
			check(it.icon.begins_with(str(a2["icon"]) + "_"), "%s: ícone do Ato II (%s)" % [pid, it.icon])
			check(ResourceLoader.exists("res://assets/icons/%s.png" % it.icon), "%s: ícone %s.png existe (set_icons.tscn)" % [pid, it.icon])

func _check_apex_sets(gd, sim) -> void:
	var apx: Array = gd.sets.values().filter(func(x): return x.is_apex())
	check(apx.size() == 42, "42 Ápices (14 builds × 35/40/45): %d" % apx.size())
	var ak: Array = GearCatalog.APEX.keys()
	var nk: Array = Balance.APEX_NUMBERS.keys()
	ak.sort()
	nk.sort()
	check(ak.size() == 14 and ak == nk, "APEX e APEX_NUMBERS: as 14 builds (%s)" % str(ak))
	check(is_equal_approx(Balance.APEX_TOL, Balance.FUSION_TOL) and is_equal_approx(Balance.APEX_GAIN_MAX, Balance.FUSION_GAIN_MAX), "orçamento do Ápice = o das Fusões (F-AP2)")
	check("trap_max" in Stats.STAT_KEYS, "stat trap_max em Stats.STAT_KEYS")
	for k in ["apex_judged", "apex_cadence", "apex_tempest"]:
		check(BuffLooks.LOOKS.has(k), "%s tem visual (BuffLooks)" % k)
	var names := {}
	var dup: Array = []
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		for build in cls.builds:
			var bid: String = build["id"]
			var want: bool = cid in ["berserker", "ranger", "druid", "assassin"] or bid in ["cruzado", "inquisidor"]
			check(GearCatalog.APEX.has(bid) == want, "%s/%s: %s Ápice (spec §1)" % [cid, bid, "tem" if want else "sem"])
			if not want:
				check(gd.apex_set_for(cls, bid, 40) == null, "%s/%s: nenhum Ápice gerado" % [cid, bid])
				continue
			var vis30: Dictionary = GearCatalog.visual_of("set_%s_%s_%d" % [cid, bid, GearCatalog.OWN_VISUALS_UNTIL])
			check(not vis30.is_empty() and vis30.has("style"), "%s/%s: conjunto 30 tem visual (estilo do Ápice)" % [cid, bid])
			for hi in range(Balance.HYBRID_LEVELS.size()):
				var lv: int = Balance.HYBRID_LEVELS[hi]
				var tier := Balance.legend_tier(lv)
				var vis_lv: Dictionary = GearCatalog.visual_of("set_%s_%s_%d" % [cid, bid, lv])     # o do nível: 30 reaproveitado ou o do Ato II da build
				var col: Color = GearCatalog.apex_color(vis_lv.get("color", Color.WHITE))
				var sd: SetDef = gd.sets.get(GearCatalog.apex_set_id(cid, bid, lv))
				check(sd != null, "%s/%s: Ápice do %d existe" % [cid, bid, lv])
				if sd == null:
					continue
				var num: String = GearCatalog.HYBRID_NUMERALS[hi]
				check(sd.id == "set_%s_apex_%s_%d" % [cid, bid, lv] and sd.name == "Conjunto %s Ápice %s" % [GearCatalog.APEX[bid]["name"], num], "%s: id e nome R-AP1 (%s)" % [sd.id, sd.name])
				check(sd.is_apex() and not sd.is_hybrid() and sd.build_of() == bid and sd.class_id == cid and sd.level == lv and sd.fusion == "apice_" + bid, "%s: Ápice da build %s" % [sd.id, bid])
				if names.has(sd.name):
					dup.append(sd.name)
				names[sd.name] = true
				check(sd.armor.size() == 5 and sd.pieces == sd.armor, "%s: 5 peças de armadura" % sd.id)
				for pid in sd.armor:
					var it: ItemDef = gd.items[pid]
					var piece: String = pid.get_slice("_", pid.get_slice_count("_") - 1)
					check(pid == "leg_%s_apex_%s_%d_%s" % [cid, bid, lv, piece] and it.name.ends_with("Ápice %s" % num), "%s: id e nome da peça (%s)" % [pid, it.name])
					check(it.set_id == sd.id and it.is_legendary() and it.level_req == lv and it.class_restriction == [cid], "%s: peça lendária da classe" % pid)
					check(it.attr(build["attr"]) > 0 and (build["attr2"] == build["attr"] or it.attr(build["attr2"]) > 0), "%s: atributos da build (%s, %s)" % [pid, build["attr"], build["attr2"]])
					check(it.armor_style == (build["armor"] if piece == "legs" else vis_lv.get("style", "")), "%s: estilo do conjunto da build no nível (%s)" % [pid, it.armor_style])
					check(it.icon_color.is_equal_approx(col), "%s: cor R-AP5 (30 escurecido e dourado)" % pid)
					check(it.icon != "" and ResourceLoader.exists("res://assets/icons/%s.png" % it.icon) if piece != "legs" else true, "%s: ícone do conjunto 30" % pid)
					if names.has(it.name):
						dup.append(it.name)
					names[it.name] = true
				var base := "leg_%s_apex_%s_%d" % [cid, bid, lv]
				var want_w: Array = [base + "_weapon"]
				if build["main"].size() > 1:
					want_w.append("%s_%s" % [base, build["main"][1]])
				if build["off"].size() > 0:
					want_w.append(base + "_offhand")
				check(sd.alt_pieces == want_w, "%s: armas da build como peças alternativas %s" % [sd.id, str(sd.alt_pieces)])
				for wid in sd.alt_pieces:
					var w: ItemDef = gd.items.get(wid)
					check(w != null and w.set_id == sd.id and w.class_restriction == [cid] and w.level_req == lv, "%s: arma do Ápice coerente" % wid)
					if w == null:
						continue
					if wid.ends_with("_offhand"):
						check(w.weapon_type == build["off"][0], "%s: mão secundária da build" % wid)
					else:
						var want_le: Dictionary = GearCatalog.role_legend("bulwark", tier) if GearCatalog.weapon_role(bid, w.weapon_type) == "defense" else GearCatalog.legend_effect(build, tier)
						check(w.weapon_type in build["main"] and str(w.legend_effect) == str(want_le), "%s: efeito lendário da build (ou Baluarte no martelo) no tier" % wid)
					if names.has(w.name):
						dup.append(w.name)
					names[w.name] = true
				check(sim.relic_cost(gd.items[sd.armor[0]]) == tier + 1, "%s: custa %d moedas" % [sd.id, tier + 1])
				var nb: Dictionary = gd.sets[gd.set_id_for(cid, bid, lv)].bonuses        # o conjunto da build no mesmo tier (atributos já em escala)
				var ks := sd.bonuses.keys()
				ks.sort()
				check(ks == [2, 3, 4, 5] and str(sd.bonuses[2]) == str(nb[2]) and str(sd.bonuses[3]) == str(nb[3]) and str(sd.bonuses[4]) == str(nb[4]), "%s: 2-4 peças = as do conjunto da build" % sd.id)
				var f5: Dictionary = sd.bonuses[5]
				check(f5.size() == 1 and f5.get("fusion") is Dictionary and str(f5["fusion"]["id"]) == "apice_" + bid, "%s: 5 peças = só o efeito Ápice" % sd.id)
				var nums: Dictionary = Balance.APEX_NUMBERS[bid]
				for k in nums:
					var wv: float = float(nums[k][0]) + float(nums[k][1]) * (tier - 6) if nums[k] is Array else float(nums[k])
					check(absf(float(f5["fusion"].get(k, -999.0)) - wv) < 0.011, "%s: F-AP1 %s = %.2f" % [sd.id, k, wv])
					if nums[k] is Array:
						check(float(f5["fusion"][k]) >= 0.79 * float(nums[k][0]) and float(f5["fusion"][k]) > 0.0, "%s: %s nunca abaixo de 80%% do v35" % [sd.id, k])
	check(dup.is_empty(), "nomes dos Ápices únicos %s" % str(dup.slice(0, 4)))
	# drop / Relicária: o Ápice cai e troca só na aba da própria build; nenhum híbrido removido no pool
	for cid in ["berserker", "ranger", "druid", "assassin", "paladin", "bishop"]:
		var cls: ClassDef = gd.classes[cid]
		for b in cls.builds:
			var bid: String = b["id"]
			var pool: Array = gd.legendary_pool(cls, 40, bid)
			var sd: SetDef = gd.apex_set_for(cls, bid, 40)
			check(not pool.any(func(x): return str(x).contains("_mix_") and not gd.items.has(str(x))), "%s/%s: pool sem híbrido removido" % [cid, bid])
			if sd:
				check(pool.has(sd.armor[0]) and pool.has(sd.alt_pieces[0]), "%s/%s: Ápice cai/troca para a build" % [cid, bid])
				check(gd.apex_sets_for(cls, bid, 40) == [sd], "%s/%s: Relicária mostra o Ápice na aba da build" % [cid, bid])
				for ob in cls.builds:
					if ob["id"] != bid:
						check(not gd.apex_sets_for(cls, ob["id"], 40).has(sd) and not gd.legendary_pool(cls, 40, ob["id"]).has(sd.armor[0]), "%s/%s: Ápice não aparece na aba de %s" % [cid, bid, ob["id"]])
	# bots aos 35/40/45 (R-AP6)
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	var want_set := {"guardiao": "set_paladin_mix_templario_guardiao_%d", "templario": "set_paladin_mix_templario_guardiao_%d",
		"sacerdote": "set_bishop_mix_batalha_sacerdote_%d", "batalha": "set_bishop_mix_batalha_sacerdote_%d"}
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var bot: SimEntity = sim.spawn_bot(cls, "Apx", "city_aldara", Vector3(0, 0, 6), 40)
		for b in cls.builds:
			bot.build_id = b["id"]
			for lv in Balance.HYBRID_LEVELS:
				var got: String = sim.bot_legendary_set(bot, lv)
				var expect: String = GearCatalog.apex_set_id(cid, b["id"], lv) if GearCatalog.APEX.has(b["id"]) else (want_set[b["id"]] % lv if want_set.has(b["id"]) else got)
				check(got == expect and gd.sets.has(got), "R-AP6: bot %s/%s no %d pega %s (%s)" % [cid, b["id"], lv, expect, got])
				if cid in ["elementalist", "necromancer"]:
					check(gd.sets.has(got) and gd.sets[got].is_hybrid(), "bot %s/%s no %d segue no híbrido" % [cid, b["id"], lv])
		sim.despawn(bot)
	# face (R-AP3): Executor com garras = apagado; machado de 2 mãos (e Titã) = ligado; 4 peças = nada
	var ex: SimEntity = _wear_apex(gd, sim.spawn_bot(gd.classes["berserker"], "Exe", "city_aldara", Vector3(0, 0, 6), 40), "executor", 5, "axe2h_t5")
	check(FusionEffects.fid(ex) == "apice_executor" and FusionEffects.face(ex) == "executor", "Ápice do Executor + machado de 2 mãos: ligado")
	_wear_apex(gd, ex, "executor", 5, "axe2h_t5", "axe2h_t5")
	check(FusionEffects.face(ex) == "executor", "Ápice do Executor + Empunhadura de Titã: ligado")
	_wear_apex(gd, ex, "executor", 5, "claw_t5", "claw_t5")
	check(FusionEffects.fid(ex) == "apice_executor" and FusionEffects.face(ex) == "", "Ápice do Executor + garras: apagado")
	_wear_apex(gd, ex, "executor", 4, "axe2h_t5")
	check(ex.stats.fusion.is_empty(), "Ápice com 4 peças: sem efeito")
	sim.despawn(ex)
	var du: SimEntity = _wear_apex(gd, sim.spawn_bot(gd.classes["assassin"], "Due", "city_aldara", Vector3(0, 0, 6), 40), "duelista", 5, "sword_t5", "pistol_t5")
	check(FusionEffects.face(du) == "", "Ápice do Duelista com sabre e pistola: apagado (é a arma do Corsário)")
	_wear_apex(gd, du, "duelista", 5, "sword_t5", "sword_t5")
	check(FusionEffects.face(du) == "duelista", "Ápice do Duelista com duas espadas: ligado")
	sim.despawn(du)

## Uma regra por ficha do Ápice (apice-sets.md §7 check 5), sim determinística. Cada uma com 5 peças e a arma da build, nível 40.
func _check_apex_rules(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	var at := Vector3(0, 0, 6)
	var ber: ClassDef = gd.classes["berserker"]
	# B-A1 Carniceiro: golpe dá Frenesi da Tormenta até 5; o Arremesso Brutal gasta e bate mais por carga
	var e: SimEntity = _wear_apex(gd, sim.spawn_bot(ber, "Car", "city_aldara", at, 40), "carniceiro", 5, "axe_t5", "axe_t5")
	var mob: SimEntity = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	var basic: SkillDef = gd.basic_skill_for_class(ber, "axe")
	for i in range(7):
		FusionEffects.on_hit(sim, e, mob, basic, 10, false)
	check(e.buff_stacks(FusionEffects.TEMPEST_BUFF) == Balance.FUSION_FRENZY_MAX, "Tormenta Gêmea: Frenesi da Tormenta para em %d (%d)" % [Balance.FUSION_FRENZY_MAX, e.buff_stacks(FusionEffects.TEMPEST_BUFF)])
	var thr := FusionEffects.num(e, "throw")
	var sm := FusionEffects.skill_mult(sim, e, gd.skills[FusionEffects.THROW_SKILL])
	check(absf(sm - (1.0 + thr * Balance.FUSION_FRENZY_MAX / 100.0)) < 0.001 and e.buff_stacks(FusionEffects.TEMPEST_BUFF) == 0, "Tormenta Gêmea: Arremesso gasta as cargas, +%.1f%% por carga (x%.3f)" % [thr, sm])
	sim.despawn(e)
	# B-A2 Executor: limiar 35/36/37; abaixo dele +exec_dmg; o Carrasco da arma sobe junto; skill de 1 alvo +heavy
	e = sim.spawn_bot(ber, "Exe", "city_aldara", at, 45)
	for i in range(3):
		var lv: int = Balance.HYBRID_LEVELS[i]
		_wear_apex(gd, e, "executor", 5, "axe2h_t5", "", lv)
		check(absf(FusionEffects.exec_line(e) - (0.35 + 0.01 * i)) < 0.0001, "Cadafalso: limiar de execução %d%% no %d (%.3f)" % [35 + i, lv, FusionEffects.exec_line(e)])
	_wear_apex(gd, e, "executor", 5, "axe2h_t5", "", 35)
	mob.hp = mob.stats.max_hp * 0.345
	var ed := FusionEffects.num(e, "exec_dmg")
	check(absf(FusionEffects.hit_mult(sim, e, mob, basic) - (1.0 + ed / 100.0)) < 0.001, "Cadafalso: abaixo do limiar +%.0f%%" % ed)
	mob.hp = mob.stats.max_hp * 0.355
	check(is_equal_approx(FusionEffects.hit_mult(sim, e, mob, basic), 1.0), "Cadafalso: acima do limiar, normal")
	var axe: String = "leg_berserker_apex_executor_40_weapon"
	_wear_apex(gd, e, "executor", 5, axe)
	mob.hp = mob.stats.max_hp * 0.33
	check(LegendEffects.legend_power(sim, e, mob) > 1.0, "Cadafalso: o Carrasco da arma vale até o limiar novo (33%% da vida)")
	_wear_apex(gd, e, "executor", 4, axe)
	check(is_equal_approx(LegendEffects.legend_power(sim, e, mob), 1.0), "Carrasco sem o Ápice: 33%% da vida fica acima dos 30%%")
	_wear_apex(gd, e, "executor", 5, axe)
	check(absf(FusionEffects.skill_mult(sim, e, gd.skills["ber_execute"]) - (1.0 + FusionEffects.num(e, "heavy") / 100.0)) < 0.001, "Cadafalso: skill de golpe em 1 alvo +heavy%%")
	check(is_equal_approx(FusionEffects.bot_skill_mult(e, mob, gd.skills["ber_execute"]), Balance.BOT_FUSION_SCORE), "Cadafalso (bot): Executar abaixo do limiar atual pesa mais (33%% < 36%%)")
	mob.hp = mob.stats.max_hp * 0.5
	check(is_equal_approx(FusionEffects.bot_skill_mult(e, mob, gd.skills["ber_execute"]), 1.0), "Cadafalso (bot): acima do limiar, sem peso extra")
	sim.despawn(e)
	# B-A3 Punhos: crítico com garras contra-ataca (ICD); +esquiva
	e = _wear_apex(gd, sim.spawn_bot(ber, "Pun", "city_aldara", at, 40), "punhos", 4, "claw_t5", "claw_t5")
	var eva4: float = e.stats.evasion
	_wear_apex(gd, e, "punhos", 5, "claw_t5", "claw_t5")
	check(e.stats.evasion > eva4 or e.stats.evasion >= Balance.EVASION_CAP, "Punho Implacável: +esquiva (%.1f -> %.1f)" % [eva4, e.stats.evasion])
	var cb: SkillDef = gd.basic_skill_for_class(ber, "claw")
	var hp0: float = mob.hp
	FusionEffects.on_hit(sim, e, mob, cb, 10, false)
	check(is_equal_approx(mob.hp, hp0), "Punho Implacável: golpe sem crítico não contra-ataca")
	FusionEffects.on_hit(sim, e, mob, cb, 10, true)
	var hp1: float = mob.hp
	FusionEffects.on_hit(sim, e, mob, cb, 10, true)
	check(hp1 < hp0 and is_equal_approx(mob.hp, hp1) and int(e.fus.get("n_counter", 0)) == 1, "Punho Implacável: crítico contra-ataca, com recarga de %.0f s" % Balance.FUSION_COUNTER_ICD)
	sim.despawn(e)
	# P-A1 Cruzado: skill que atordoa julga o alvo mesmo se o chefe resistir; Julgado = +judged% de todo o dano
	var pal: ClassDef = gd.classes["paladin"]
	e = _wear_apex(gd, sim.spawn_bot(pal, "Cru", "city_aldara", at, 40), "cruzado", 5, "sword2h_t5")
	var boss_def: MonsterDef = null
	for mid in gd.monsters:
		if gd.monsters[mid].is_boss:
			boss_def = gd.monsters[mid]
			break
	var boss: SimEntity = sim.spawn_monster(boss_def, "city_aldara", at + Vector3(0, 0, 1))
	var stun_s: SkillDef = null
	for sid in gd.skills:
		var s: SkillDef = gd.skills[sid]
		if s.class_id == "paladin" and s.effects.has("stun") and s.power > 0.0:
			stun_s = s
			break
	check(is_equal_approx(FusionEffects.damage_mult(e, boss), 1.0), "Veredito: alvo sem Julgado, dano normal")
	FusionEffects.on_hit(sim, e, boss, stun_s, 10, false)
	var jd := FusionEffects.num(e, "judged")
	check(boss.state != SimEntity.State.STUNNED and absf(FusionEffects.damage_mult(e, boss) - (1.0 + jd / 100.0)) < 0.001, "Veredito: %s julga o chefe mesmo sem atordoar (+%.1f%%)" % [stun_s.id if stun_s else "?", jd])
	check(is_equal_approx(FusionEffects.stun_bonus(e), FusionEffects.num(e, "stun_ch")) and FusionEffects.stun_bonus(e) > 0.0, "Veredito: +%.0f p.p. no Julgamento da arma" % FusionEffects.stun_bonus(e))
	_wear_apex(gd, e, "cruzado", 4, "sword2h_t5")
	check(is_equal_approx(FusionEffects.damage_mult(e, boss), 1.0) and is_equal_approx(FusionEffects.stun_bonus(e), 0.0), "Veredito: 4 peças = apagado")
	sim.despawn(boss)
	sim.despawn(e)
	# Bi-A1 Iluminado: magia sagrada dá Aurora; renova, não acumula
	var bis: ClassDef = gd.classes["bishop"]
	e = _wear_apex(gd, sim.spawn_bot(bis, "Aur", "city_aldara", at, 40), "inquisidor", 5, "scepter_t5")
	var matk0: float = e.stats.matk
	FusionEffects.on_cast(sim, e, gd.skills["bis_smite"], at)
	FusionEffects.on_cast(sim, e, gd.skills["bis_smite"], at)
	var au := FusionEffects.num(e, "aurora")
	var auras: Array = e.buffs.filter(func(x): return x.get("id") == FusionEffects.AURORA_BUFF)
	check(auras.size() == 1 and is_equal_approx(float(auras[0].get("matk_pct", 0.0)), au) and e.stats.matk > matk0, "Aurora Ardente: magia sagrada dá Aurora +%.1f%% (renova sem acumular; MATK %.0f -> %.0f)" % [au, matk0, e.stats.matk])
	sim.despawn(e)
	# D-A1 Urso: ao apanhar, a Casca cobre você e o aliado mais ferido; recarga; o Urro zera a recarga
	var dru: ClassDef = gd.classes["druid"]
	e = _wear_apex(gd, sim.spawn_bot(dru, "Urs", "city_aldara", at, 40), "guardiao_verde", 5, "mace2h_t5")
	var ally: SimEntity = sim.spawn_bot(ber, "Ali", "city_aldara", at + Vector3(0.5, 0, 0), 40)
	sim.party_leave(e)
	sim.party_leave(ally)
	sim.party_invite(e, ally)
	sim.party_accept(ally)
	check(sim.same_party(e, ally), "Casca Ancestral: urso e aliado no mesmo grupo (preparo)")
	ally.hp = ally.stats.max_hp * 0.05
	ally.buffs.clear()
	e.buffs.clear()
	FusionEffects.on_hit_taken(sim, mob, e)
	FusionEffects.on_hit_taken(sim, mob, e)
	check(not ally.buffs.is_empty() and not e.buffs.is_empty() and int(e.fus.get("n_bark", 0)) == 1, "Casca Ancestral: cobre você e o aliado mais ferido, com recarga (%d)" % int(e.fus.get("n_bark", 0)))
	FusionEffects.on_cast(sim, e, gd.skills[FusionEffects.BELLOW_SKILL], at)
	FusionEffects.on_hit_taken(sim, mob, e)
	check(int(e.fus.get("n_bark", 0)) == 2, "Casca Ancestral: o Urro da Mata zera a recarga")
	sim.despawn(ally)
	sim.despawn(e)
	# D-A2 Lobo: +hunt só em alvo sangrando
	e = _wear_apex(gd, sim.spawn_bot(dru, "Lob", "city_aldara", at, 40), "fera", 5, "mace_t5", "mace_t5")
	mob.debuffs.clear()
	check(is_equal_approx(FusionEffects.damage_mult(e, mob), 1.0), "Matilha Rubra: alvo sem sangrar, dano normal")
	mob.debuffs.append({"kind": "dot", "id": "bleed_x", "remaining": 4.0, "dps": 1.0, "src": -7, "bleed": true})
	check(absf(FusionEffects.damage_mult(e, mob) - (1.0 + FusionEffects.num(e, "hunt") / 100.0)) < 0.001, "Matilha Rubra: alvo sangrando (de qualquer fonte) +%.0f%%" % FusionEffects.num(e, "hunt"))
	mob.debuffs.clear()
	sim.despawn(e)
	# D-A3 Xamã: magia em alvo com Fogo Lunar +moon; Fogo Lunar em alvo marcado salta uma vez (o salto não encadeia)
	e = _wear_apex(gd, sim.spawn_bot(dru, "Xam", "city_aldara", at, 40), "xama", 5, "staff_t5")
	var m2: SimEntity = _big_mob(gd, sim, mob.position + Vector3(2.5, 0, 0))
	var moon: SkillDef = gd.skills[FusionEffects.MOON_SKILL]
	FusionEffects.on_hit(sim, e, mob, moon, 10, false)
	var m2hp: float = m2.hp
	check(int(e.fus.get("n_moon_jump", 0)) == 0 and absf(FusionEffects.hit_mult(sim, e, mob, moon) - (1.0 + FusionEffects.num(e, "moon") / 100.0)) < 0.001, "Maré Lunar: 1º Fogo Lunar marca, magia no marcado +%.0f%%" % FusionEffects.num(e, "moon"))
	check(is_equal_approx(FusionEffects.bot_skill_mult(e, mob, moon), Balance.BOT_FUSION_SCORE), "Maré Lunar (bot): Fogo Lunar no alvo marcado pesa mais")
	FusionEffects.on_hit(sim, e, mob, moon, 10, false)
	check(int(e.fus.get("n_moon_jump", 0)) == 1 and m2.hp < m2hp and FusionEffects._moonlit(e, m2), "Maré Lunar: Fogo Lunar no marcado salta e marca o vizinho")
	check(int(e.fus.get("n_moon_jump", 0)) == 1, "Maré Lunar: o salto não encadeia")
	sim.despawn(m2)
	sim.despawn(e)
	# R-A1 Caçador: golpe do lince aplica a Marca (teto MARK_TAKEN_CAP); lince +pet% em alvo retardado
	var ran: ClassDef = gd.classes["ranger"]
	e = _wear_apex(gd, sim.spawn_bot(ran, "Cac", "city_aldara", at, 40), "cacador", 5, "bow_t5")
	var pet: SimEntity = sim.spawn_summon(e, gd.monsters[FusionEffects.PET_ID], at + Vector3(0.5, 0, 0.5), 0.0, true)
	mob.debuffs.clear()
	mob.debuffs.append({"kind": "curse", "id": "curse_predator_999", "remaining": 9.0, "taken_pct": 22.0, "weaken_pct": 0.0, "mark": true})
	FusionEffects.summon_on_hit(sim, e, pet, mob)
	check(mob.debuffs.any(func(d): return str(d.get("id", "")) == "curse_legend_mark_%d" % e.id and d.get("mark", false)) and Combat.taken_pct(mob) <= Balance.MARK_TAKEN_CAP + 0.001,
		"Faro do Lince: o lince marca o alvo e a soma das marcas fica no teto (%.1f)" % Combat.taken_pct(mob))
	check(is_equal_approx(FusionEffects.hit_mult(sim, pet, mob, null), 1.0), "Faro do Lince: alvo livre, lince normal")
	mob.debuffs.append({"kind": "slow", "remaining": 3.0, "pct": 30.0})
	check(absf(FusionEffects.hit_mult(sim, pet, mob, null) - (1.0 + FusionEffects.num(e, "pet") / 100.0)) < 0.001, "Faro do Lince: lince +%.1f%% em alvo retardado" % FusionEffects.num(e, "pet"))
	check(is_equal_approx(FusionEffects.bot_skill_mult(e, mob, gd.skills[FusionEffects.FROST_ARROW]), 1.0), "Faro do Lince (bot): alvo já retardado, Flecha Gélida sem peso extra")
	mob.debuffs.clear()
	check(is_equal_approx(FusionEffects.bot_skill_mult(e, mob, gd.skills[FusionEffects.FROST_ARROW]), Balance.BOT_FUSION_SCORE), "Faro do Lince (bot): abre com Flecha Gélida")
	sim.despawn(pet)
	sim.despawn(e)
	# R-A2 Atirador: +1 torreta (a 2ª a t2_pwr%), +1 armadilha, mira em preso/retardado/marcado; regenera perto da torreta
	e = sim.spawn_bot(ran, "Ati", "city_aldara", at, 40)
	_wear_apex(gd, e, "atirador", 4, "rifle_t5")
	var tm4 := RangerAscension.turret_max(e)
	var tr4 := ClassTalentSystem.trap_max(e)
	_wear_apex(gd, e, "atirador", 5, "rifle_t5")
	check(RangerAscension.turret_max(e) == tm4 + 1 and ClassTalentSystem.trap_max(e) == tr4 + 1, "Posto Avançado: +1 torreta (%d) e +1 armadilha (%d)" % [RangerAscension.turret_max(e), ClassTalentSystem.trap_max(e)])
	check(is_equal_approx(FusionEffects.turret_power(e, 0), 1.0) and absf(FusionEffects.turret_power(e, Balance.TURRET_MAX) - FusionEffects.num(e, "t2_pwr") / 100.0) < 0.001, "Posto Avançado: a torreta a mais sai a %.0f%%" % FusionEffects.num(e, "t2_pwr"))
	var tur: SimEntity = sim.spawn_summon(e, gd.monsters[Balance.TURRET_MONSTER], at + Vector3(0, 0, -1), 20.0, false)
	var near_m: SimEntity = _big_mob(gd, sim, tur.position + Vector3(1, 0, 0))
	var far_m: SimEntity = _big_mob(gd, sim, tur.position + Vector3(-3, 0, 0))
	far_m.debuffs.append({"kind": "root", "remaining": 3.0})
	check(FusionEffects.turret_pick(sim, tur, sim.maps["city_aldara"], Balance.TURRET_RANGE) == far_m, "Posto Avançado: a torreta mira primeiro o preso, não o mais perto")
	var al2: SimEntity = sim.spawn_bot(ber, "Reg", "city_aldara", tur.position + Vector3(0.5, 0, 0.5), 40)
	sim.party_leave(e)
	sim.party_leave(al2)
	sim.party_invite(e, al2)
	sim.party_accept(al2)
	al2.hp = al2.stats.max_hp * 0.5
	var ahp: float = al2.hp
	sim.maps["city_aldara"].erase("fus_tick")
	FusionEffects.tick(sim, sim.maps["city_aldara"])
	check(al2.hp > ahp, "Posto Avançado: aliado perto da torreta regenera (%.0f -> %.0f)" % [ahp, al2.hp])
	_wear_apex(gd, e, "atirador", 5, "bow_t5")
	check(FusionEffects.turret_pick(sim, tur, sim.maps["city_aldara"], Balance.TURRET_RANGE) == null, "Posto Avançado: com o arco, apagado")
	for x in [al2, near_m, far_m, tur, e]:
		sim.despawn(x)
	# R-A3 Lanceiro: golpe abre 1 Ferida, 2 em alvo retardado ou preso
	e = _wear_apex(gd, sim.spawn_bot(ran, "Lan", "city_aldara", at, 40), "lanceiro", 5, "spear_t5")
	var sb: SkillDef = gd.basic_skill_for_class(ran, "spear")
	var m4: SimEntity = _big_mob(gd, sim, at + Vector3(-1, 0, 0))
	FusionEffects.on_hit(sim, e, m4, sb, 10, false)
	check(LegendEffects.wounds(e, m4) == 1, "Presa Aberta: golpe abre 1 Ferida")
	var m5: SimEntity = _big_mob(gd, sim, at + Vector3(-1, 0, 1))
	m5.debuffs.append({"kind": "slow", "remaining": 3.0, "pct": 30.0})
	FusionEffects.on_hit(sim, e, m5, sb, 10, false)
	check(LegendEffects.wounds(e, m5) == 2, "Presa Aberta: 2 Feridas em alvo retardado (%d)" % LegendEffects.wounds(e, m5))
	sim.despawn(m4)
	sim.despawn(m5)
	sim.despawn(e)
	# A-A1 Lâminas: avançar/esquivar deixa a facada furtiva; ela envenena
	var ass: ClassDef = gd.classes["assassin"]
	e = _wear_apex(gd, sim.spawn_bot(ass, "Lam", "city_aldara", at, 40), "laminas", 5, "dagger_t5", "dagger_t5")
	var db: SkillDef = gd.basic_skill_for_class(ass, "dagger")
	mob.debuffs.clear()
	FusionEffects.on_hit(sim, e, mob, db, 10, false)
	check(not mob.debuffs.any(func(d): return str(d.get("id", "")) == "apex_poison_%d" % e.id), "Sombra Peçonhenta: facada comum não envenena")
	FusionEffects.on_dodge(sim, e, mob)
	var gm := FusionEffects.skill_mult(sim, e, db)
	FusionEffects.on_hit(sim, e, mob, db, 10, false)
	check(gm >= 1.0 and int(e.fus.get("n_ghost", 0)) == 1 and mob.debuffs.any(func(d): return str(d.get("id", "")) == "apex_poison_%d" % e.id), "Sombra Peçonhenta: esquivar deixa a facada furtiva (x%.2f) e ela envenena" % gm)
	sim.despawn(e)
	# A-A2 Duelista: crítico dá Cadência (não é Bravata), esquivar dá 2; com 5 vira Foco
	e = _wear_apex(gd, sim.spawn_bot(ass, "Due", "city_aldara", at, 40), "duelista", 5, "sword_t5", "sword_t5")
	var swb: SkillDef = gd.basic_skill_for_class(ass, "sword")
	FusionEffects.on_hit(sim, e, mob, swb, 10, true)
	FusionEffects.on_hit(sim, e, mob, swb, 10, true)
	check(e.buff_stacks(FusionEffects.CADENCE_BUFF) == 1 and e.buff_stacks(Balance.BRAVADO_BUFF) == 0, "Cadência Perfeita: crítico dá 1 Cadência (recarga de %.0f s), não Bravata" % Balance.APEX_CADENCE_ICD)
	FusionEffects.on_dodge(sim, e, mob)
	check(e.buff_stacks(FusionEffects.CADENCE_BUFF) == 3, "Cadência Perfeita: esquivar dá 2")
	FusionEffects.on_dodge(sim, e, mob)
	var fid_buff: String = str((gd.skills[FusionEffects.FOCUS_SKILL].effects["buff"] as Dictionary).get("id", ""))
	check(e.buff_stacks(FusionEffects.CADENCE_BUFF) == 0 and e.buffs.any(func(x): return x.get("id") == fid_buff), "Cadência Perfeita: com %d vira Foco do Duelista" % Balance.APEX_CADENCE_MAX)
	sim.despawn(e)
	# A-A3 Corsário: Bravata cheia -> o próximo golpe de espada dispara a pistola de graça e gasta tudo; bot segura o Tiro
	e = _wear_apex(gd, sim.spawn_bot(ass, "Cor", "city_aldara", at, 40), "corsario", 5, "sword_t5", "pistol_t5")
	e.drop_buff(Balance.BRAVADO_BUFF)
	FusionEffects.on_hit(sim, e, mob, swb, 10, true)
	check(e.buff_stacks(Balance.BRAVADO_BUFF) == 1, "Salva Final: crítico com espada dá Bravata")
	e.put_buff({"id": Balance.BRAVADO_BUFF, "remaining": 10.0, "stacks": Balance.APEX_BOT_HOLD_BRAVADO})
	check(is_equal_approx(FusionEffects.bot_skill_mult(e, mob, gd.skills[FusionEffects.EYES_SHOT]), 0.0), "Salva Final (bot): com %d de Bravata segura o Tiro Entre os Olhos" % Balance.APEX_BOT_HOLD_BRAVADO)
	e.put_buff({"id": Balance.BRAVADO_BUFF, "remaining": 10.0, "stacks": Balance.BRAVADO_MAX})
	var mhp: float = mob.hp
	FusionEffects.on_hit(sim, e, mob, swb, 10, false)
	check(mob.hp < mhp and e.buff_stacks(Balance.BRAVADO_BUFF) == 0 and int(e.fus.get("n_salvo", 0)) == 1, "Salva Final: Bravata cheia dispara a pistola de graça e gasta tudo")
	sim.despawn(e)
	sim.despawn(mob)

## Save 5 -> 6 (apice-sets.md §6, check 8): peças dos híbridos que saíram viram as do Ápice; P3/Bi3/Ele/Necro intactos.
func _check_apex_save(gd, sim) -> void:
	check(SaveSystem.VERSION >= 6, "save versão 6+ (Ápices; 7 = ranks de skill)")
	var cases := {
		"leg_berserker_mix_carniceiro_executor_40_head": "leg_berserker_apex_carniceiro_40_head",
		"leg_berserker_mix_executor_punhos_45_legs": "leg_berserker_apex_executor_45_legs",
		"leg_berserker_mix_carniceiro_executor_40_executor_weapon+3": "leg_berserker_apex_executor_40_weapon+3",
		"leg_berserker_mix_punhos_carniceiro_35_carniceiro_offhand": "leg_berserker_apex_carniceiro_35_offhand",
		"leg_ranger_mix_lanceiro_cacador_40_cacador_weapon": "leg_ranger_apex_cacador_40_weapon",
		"leg_druid_mix_xama_guardiao_verde_40_guardiao_verde_weapon": "leg_druid_apex_guardiao_verde_40_weapon",
		"leg_druid_mix_guardiao_verde_fera_40_gloves": "leg_druid_apex_guardiao_verde_40_gloves",
		"leg_assassin_mix_duelista_corsario_40_corsario_offhand": "leg_assassin_apex_corsario_40_offhand",
		"leg_paladin_mix_guardiao_cruzado_40_body": "leg_paladin_apex_cruzado_40_body",
		"leg_paladin_mix_guardiao_cruzado_40_cruzado_weapon": "leg_paladin_apex_cruzado_40_weapon",
		"leg_paladin_mix_guardiao_cruzado_40_guardiao_offhand": "leg_paladin_mix_templario_guardiao_40_guardiao_offhand",
		"leg_paladin_mix_cruzado_templario_45_templario_weapon+2": "leg_paladin_mix_templario_guardiao_45_templario_weapon+2",
		"leg_paladin_mix_cruzado_templario_45_boots": "leg_paladin_apex_cruzado_45_boots",
		"leg_bishop_mix_sacerdote_inquisidor_40_head": "leg_bishop_apex_inquisidor_40_head",
		"leg_bishop_mix_sacerdote_inquisidor_40_sacerdote_weapon": "leg_bishop_mix_batalha_sacerdote_40_sacerdote_weapon",
		"leg_bishop_mix_inquisidor_batalha_40_batalha_offhand": "leg_bishop_mix_batalha_sacerdote_40_batalha_offhand",
		"leg_bishop_mix_inquisidor_batalha_40_legs": "leg_bishop_apex_inquisidor_40_legs",
		# os que ficaram: iguais
		"leg_paladin_mix_templario_guardiao_40_head": "leg_paladin_mix_templario_guardiao_40_head",
		"leg_bishop_mix_batalha_sacerdote_40_batalha_weapon+5": "leg_bishop_mix_batalha_sacerdote_40_batalha_weapon+5",
		"leg_elementalist_mix_fogo_gelo_40_head": "leg_elementalist_mix_fogo_gelo_40_head",
		"leg_necromancer_mix_ceifador_pestilento_45_ceifador_weapon": "leg_necromancer_mix_ceifador_pestilento_45_ceifador_weapon",
	}
	for old in cases:
		var got := SaveSystem.migrate_item_id(old)
		check(got == cases[old] and gd.resolve_item(got), "save v5: %s -> %s (%s)" % [old, cases[old], got])
		check(SaveSystem.migrate_item_id(got) == got, "save v6: %s ida e volta igual" % got)
	# fixture v5: bolsa, depósito, equipado (+3) e duas peças que viram a mesma
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	var sv: SimEntity = sim.spawn_bot(gd.classes["berserker"], "SaveApx", "city_aldara", Vector3(0, 0, 8), 40)
	sv.brain = null
	SaveSystem.apply_to(sv, {"level": 40, "save_version": 5,
		"inventory": {"leg_berserker_mix_carniceiro_executor_40_carniceiro_offhand": 1, "leg_berserker_mix_punhos_carniceiro_40_carniceiro_offhand": 1,
			"leg_berserker_mix_executor_punhos_40_body": 1},
		"storage": {"leg_berserker_mix_punhos_carniceiro_40_boots": 2},
		"equipment": {str(ItemDef.Slot.WEAPON): "leg_berserker_mix_carniceiro_executor_40_executor_weapon+3",
			str(ItemDef.Slot.HEAD): "leg_berserker_mix_carniceiro_executor_40_head"}})
	check(int(sv.inventory.get("leg_berserker_apex_carniceiro_40_offhand", 0)) == 2, "save v5: duas peças velhas que viram a mesma somam (%s)" % str(sv.inventory.get("leg_berserker_apex_carniceiro_40_offhand", 0)))
	check(int(sv.inventory.get("leg_berserker_apex_executor_40_body", 0)) == 1 and int(sv.storage.get("leg_berserker_apex_punhos_40_boots", 0)) == 2, "save v5: bolsa e depósito migram")
	var w: ItemDef = sv.equipment.get(ItemDef.Slot.WEAPON)
	var hd: ItemDef = sv.equipment.get(ItemDef.Slot.HEAD)
	check(w != null and w.id == "leg_berserker_apex_executor_40_weapon+3" and w.plus == 3 and hd != null and hd.id == "leg_berserker_apex_carniceiro_40_head", "save v5: equipado troca no mesmo slot e mantém o +3 (%s)" % (w.id if w else "-"))
	check(not sv.inventory.keys().any(func(k): return str(k).contains("_mix_")), "save v5: nenhum id velho fica na bolsa")
	sim.despawn(sv)

## Ato II fase 2 (GDD F10, AC-32): tier comum do 40 ("de Oricalco", épico), lendário do 40 no índice 7 (8 moedas,
## i_ef = 6 -> 4 peças 44%, 5 peças 18%, recarga 22%), visual do 30 reaproveitado, bots vestem pelo nível.
func _check_act2_gear_40(gd, sim) -> void:
	check(Balance.COMMON_TIER_LEVELS == [1, 8, 16, 24, 32, 40] and Balance.LEGENDARY_LEVELS.find(40) == 7, "tiers comuns 32/40 e lendário 40 no índice 7")
	check(GearCatalog.COMMON_TIER_NAMES.size() == Balance.COMMON_TIER_LEVELS.size() and GearCatalog.TIER_EPITHETS.size() == Balance.LEGENDARY_LEVELS.size(),
		"um nome por tier comum e um epíteto por nível lendário")
	var t5 := Balance.COMMON_TIER_LEVELS.find(40)
	check(GearCatalog.common_rarity(t5) == ItemDef.RARITY_LEGENDARY - 1, "comum do 40 é épico, não lendário")
	var ids: Array = []
	for wtype in GearCatalog.WEAPONS:
		var it: ItemDef = gd.items.get("%s_t%d" % [wtype, t5])
		check(it != null and it.level_req == 40 and not it.is_legendary() and it.set_id == "" and it.name.ends_with(GearCatalog.COMMON_TIER_NAMES[t5]), "arma comum do 40: %s" % wtype)
		var prev: ItemDef = gd.items.get("%s_t%d" % [wtype, t5 - 1])
		check(it != null and prev != null and it.atk + it.matk + it.def > prev.atk + prev.matk + prev.def and it.price > prev.price, "%s do 40 passa a do 32" % wtype)
		ids.append("%s_t%d" % [wtype, t5])
	for armor in GearCatalog.ARMOR:
		for piece in GearCatalog.FULL_PIECES:
			var it: ItemDef = gd.items.get("%s_%s_t%d" % [piece, armor, t5])
			check(it != null and it.level_req == 40 and not it.is_legendary() and it.armor_style == armor, "armadura comum do 40: %s %s" % [piece, armor])
			ids.append("%s_%s_t%d" % [piece, armor, t5])
	for it in GearCatalog.wearables(t5):
		check(gd.items.has(it.id) and it.level_req == 40 and it.rarity == ItemDef.RARITY_LEGENDARY - 1, "calça/capa/joia do 40: %s" % it.id)
		ids.append(it.id)
	for iid in ids:
		check(ResourceLoader.exists("res://assets/icons/art_%s.png" % iid), "ícone pintado de %s (item_icons.tscn)" % iid)
	var pool: Array = sim.gear_pool(t5)
	check(pool.size() >= 30 and pool.all(func(x): return x.level_req >= 40 and not x.is_legendary()), "drop comum do tier 40 (%d itens)" % pool.size())
	check(not sim.gear_pool(t5 - 1).any(func(x): return x.level_req >= 40), "tier 32 não mistura peças do 40")
	for cid in gd.classes:
		var b: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato2b", "city_aldara", Vector3(0, 0, 6), 40)
		var w: ItemDef = b.equipment.get(ItemDef.Slot.WEAPON)
		var body: ItemDef = b.equipment.get(ItemDef.Slot.BODY)
		check(w != null and w.level_req == 40 and body != null and body.level_req == 40, "bot %s nível 40 veste o tier do 40" % cid)
		check(b.equipment.values().all(func(x): return x == null or x.level_req == 40), "bot %s nível 40: todas as peças do tier do 40" % cid)
		sim.despawn(b)
		var b39: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato2a", "city_aldara", Vector3(0, 0, 6), 39)
		check(b39.equipment.values().all(func(x): return x == null or x.level_req == 32), "bot %s nível 39 fica no tier do 32" % cid)
		sim.despawn(b39)
	check(is_equal_approx(Balance.set_pct_tier(7), 6.0), "F10: i_ef do lendário 40 = 6")
	var n40 := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.level != 40 or sd.is_hybrid() or sd.is_apex():
			continue
		n40 += 1
		var v4: float = sd.bonuses[4]["skill_dmg"].values()[0]
		var cdr: float = sd.bonuses[5]["skill_cdr"].values()[0]
		check(is_equal_approx(v4, 44.0) and is_equal_approx(cdr, 22.0), "%s: 4 peças 44%% e recarga 22%% (%.1f, %.1f)" % [sid, v4, cdr])
		var stat_pct := 0.0
		for k in sd.bonuses[5]:
			if k != "skill_cdr" and str(k).ends_with("_pct") and not sd.bonuses[5][k] is Dictionary:
				stat_pct = maxf(stat_pct, float(sd.bonuses[5][k]))
		check(stat_pct >= 18.0, "%s: 5 peças +18%% no stat da build (%.1f)" % [sid, stat_pct])
		var vis: Dictionary = GearCatalog.visual_of(sid)
		var base30: String = sid.trim_suffix("_40") + "_30"
		check(vis.get("reuse", "") == base30 and (vis.has("act2") or vis.get("style", "") == GearCatalog.SET_VISUALS[base30]["style"]), "%s: visual do conjunto 30 (ou o do Ato II da build)" % sid)
		var head: ItemDef = gd.items[sd.armor[0]]
		check(head.armor_style == vis["style"] and head.name.ends_with(GearCatalog.TIER_EPITHETS[7]) and head.level_req == 40, "%s: peça com estilo do 30 e nome próprio (%s)" % [sid, head.name])
		var w: ItemDef = gd.items[sid.replace("set_", "leg_") + "_weapon"]
		check(sim.relic_cost(w) == 8, "%s: custa 8 moedas" % sid)
		var w35: ItemDef = gd.items[(sid.trim_suffix("_40") + "_35").replace("set_", "leg_") + "_weapon"]
		check(w.atk > w35.atk or w.matk > w35.matk, "%s: arma acima da do 35" % sid)
		var t5w: ItemDef = gd.items.get("%s_t%d" % [w.weapon_type, t5])
		var role40 := GearCatalog.weapon_role(str(gd.sets[sid].id.get_slice("_", 2)), w.weapon_type)
		var traded: bool = role40 == "battle" or role40 == "offense"     # Clérigo de Batalha / martelo do Templário: MATK virou ATK (e DEF)
		check(t5w != null and w.atk >= t5w.atk and (w.matk >= t5w.matk or (traded and (w.def > 0.0 or w.atk > t5w.atk))), "%s: arma lendária do 40 não fica abaixo da comum do 40" % sid)
	check(n40 == 24, "24 conjuntos lendários do 40, um por build (%d)" % n40)
	check(absf(GearCatalog.level_factor(40) - 44.0 / 28.0) < 0.001, "F10: fator do nível 40 = 1,571 (%.3f)" % GearCatalog.level_factor(40))

## Teto 45 (Monte Kharzun, design/gdd/kharzun-fase3-plan.md WP1/KAC-03/KAC-13): faixa de XP 40-45, lendários e híbridos
## do 45 na Relicária (9 moedas, i_ef 6,5), linha de talento 45, pontos de teia e de ascensão no 45, bots no 45.
func _check_kharzun_cap(gd, sim) -> void:
	check(Balance.MAX_LEVEL == 45 and Balance.ASC_MAX_LEVEL == Balance.MAX_LEVEL, "teto do Ato II: nível 45 (%d), ascensão até o teto" % Balance.MAX_LEVEL)
	check(Balance.XP_BANDS[-1] == [40, 45] and is_equal_approx(Balance.quest_share(40), 0.5), "faixa 40-45 com 50%% de XP de missão (F1)")
	check(absf(Balance.xp_for_level(44) - 75390.0) <= 753.9, "F1: 44 -> 45 ≈ 75 390 ±1%% (%d)" % Balance.xp_for_level(44))
	var h := 0.0
	for l in range(40, 45):
		h += Balance.level_minutes(l) / 60.0
	check(absf(h - 5.5) < 0.1, "F1: faixa 40-45 ≈ 5,5 h (%.2f)" % h)
	var web_points := 0
	for l in range(2, 46):
		web_points += Balance.points_at(l)
	check(web_points == 312 and Balance.points_at(45) == 7, "teia: 312 pontos no 45 (%d), sem bônus no 45" % web_points)
	var asc := SimEntity.new()
	asc.class_def = gd.classes["paladin"]
	asc.level = 45
	asc.quests_completed.append("hx_asc_paladin")
	check(ProgressionSystem.asc_points_total(asc) == 36, "ascensão: 36 pontos no 45 (%d)" % ProgressionSystem.asc_points_total(asc))
	# lendários do 45: índice 8, 9 moedas, epíteto próprio, bônus % pelo i_ef 6,5 (F10: 46% / 19% / 23%)
	check(Balance.LEGENDARY_LEVELS[-1] == 45 and Balance.legend_tier(45) == 8 and is_equal_approx(Balance.set_pct_tier(8), 6.5), "lendário 45 no índice 8 (i_ef 6,5)")
	check(GearCatalog.TIER_EPITHETS.size() == Balance.LEGENDARY_LEVELS.size() and not GearCatalog.TIER_EPITHETS.slice(0, 8).has(GearCatalog.TIER_EPITHETS[8]), "epíteto próprio do 45 (%s)" % GearCatalog.TIER_EPITHETS[-1])
	check(ItemSystem.relic_levels().has(45), "Relicária troca o 45")
	var n45 := 0
	var n45h := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.level != 45:
			continue
		if sd.is_hybrid() or sd.is_apex():
			n45h += 1
			continue
		n45 += 1
		var v4: float = sd.bonuses[4]["skill_dmg"].values()[0]
		var cdr: float = sd.bonuses[5]["skill_cdr"].values()[0]
		check(is_equal_approx(v4, 46.0) and is_equal_approx(cdr, 23.0), "%s: 4 peças 46%% e recarga 23%% (%.1f, %.1f)" % [sid, v4, cdr])
		var w: ItemDef = gd.items[sid.replace("set_", "leg_") + "_weapon"]
		check(sim.relic_cost(w) == 9 and w.level_req == 45, "%s: arma do 45 custa 9 moedas" % sid)
		var w40: ItemDef = gd.items[(sid.trim_suffix("_45") + "_40").replace("set_", "leg_") + "_weapon"]
		check(w.atk > w40.atk or w.matk > w40.matk, "%s: arma acima da do 40" % sid)
		var head: ItemDef = gd.items[sd.armor[0]]
		check(head.name.ends_with(GearCatalog.TIER_EPITHETS[8]) and head.level_req == 45 and not GearCatalog.visual_of(sid).is_empty(), "%s: peça com nome do 45 e visual reaproveitado (%s)" % [sid, head.name])
	check(n45 == 24 and n45h == 22, "24 conjuntos de build e 22 extras do 45 (8 híbridos + 14 Ápices) (%d, %d)" % [n45, n45h])
	for cid in gd.classes:
		var p := SimEntity.new()
		p.class_def = gd.classes[cid]
		p.level = 45
		var offer: Array = sim.relic_offer(p)
		check(offer.any(func(iid): return gd.items[iid].level_req == 45 and gd.items[iid].set_id != "" and not gd.sets[gd.items[iid].set_id].is_hybrid() and not gd.sets[gd.items[iid].set_id].is_apex()), "%s: Relicária oferece conjunto da build do 45" % cid)
		check(offer.any(func(iid): return gd.items[iid].level_req == 45 and gd.items[iid].set_id != "" and (gd.sets[gd.items[iid].set_id].is_hybrid() or gd.sets[gd.items[iid].set_id].is_apex())), "%s: Relicária oferece híbrido ou Ápice do 45" % cid)
	# linha de talento 45: fechada no 44, abre no 45 (uma opção por classe)
	var cat: Dictionary = ClassTalentsCatalog.build()
	var at: Vector3 = sim.maps["city_aldara"]["def"].town_center
	# save do teto antigo (40, XP zerada no teto): carrega igual e volta a subir
	var old: SimEntity = sim.spawn_bot(gd.classes["paladin"], "K40", "city_aldara", at, 40)
	old.xp = 0
	ProgressionSystem.gain_xp(sim, old, Balance.xp_for_level(40))
	check(Balance.xp_for_level(40) > 0 and old.level == 41 and old.xp == 0, "save no 40 (teto antigo) sobe para o 41 (nv %d)" % old.level)
	sim.despawn(old)
	for cid in gd.classes:
		var row45: Array = (cat[cid] as Array).filter(func(r): return int(r[0]) == 45)
		check(row45.size() == 1, "%s: linha de talento 45" % cid)
		if row45.is_empty():
			continue
		var nid: String = "%s_c_%s" % [cid, row45[0][1][0]["id"]]
		var b: SimEntity = sim.spawn_bot(gd.classes[cid], "K45", "city_aldara", at, 44)
		check(sim.tree_block_reason(b, nid) == "requer nível 45", "%s: talento 45 fechado no 44 (%s)" % [cid, sim.tree_block_reason(b, nid)])
		# sobe do 44 ao 45 pela XP: para no 45 com XP 0, ganha os 8 pontos e o talento abre; bot veste o tier comum do 40
		ProgressionSystem.gain_xp(sim, b, Balance.xp_for_level(44) + 500)
		check(b.level == 45 and b.xp == 0, "%s: 44 -> 45 pela XP e para (nv %d, xp %d)" % [cid, b.level, b.xp])
		ProgressionSystem.gain_xp(sim, b, 100000)
		check(b.level == 45 and b.xp == 0, "%s: no 45 a XP não acumula" % cid)
		check(not sim.tree_block_reason(b, nid).begins_with("requer nível"), "%s: talento 45 abre no 45 (%s)" % [cid, sim.tree_block_reason(b, nid)])
		sim.despawn(b)
		var b45: SimEntity = sim.spawn_bot(gd.classes[cid], "K45b", "city_aldara", at, 45)
		var w: ItemDef = b45.equipment.get(ItemDef.Slot.WEAPON)
		check(w != null and w.level_req == 40, "bot %s nível 45 veste o tier comum do 40" % cid)
		check(b45.mastery_points <= Balance.MASTERY_POINTS_PER_LEVEL, "bot %s nível 45 gasta a teia (sobra %d)" % [cid, b45.mastery_points])
		sim.despawn(b45)

## Níveis lendários com visual próprio (até GearCatalog.OWN_VISUALS_UNTIL); acima o conjunto reaproveita (visual_of).
func _own_visual_levels() -> Array:
	return Balance.LEGENDARY_LEVELS.filter(func(l): return l <= GearCatalog.OWN_VISUALS_UNTIL)

## Faixas de XP abertas antes das missões delas chegarem (outra árvore de trabalho). Tire a entrada depois do merge.
const QUEST_PENDING_BANDS := [40]

## Ritmo: ~15 h até o 30 e as quests dando ~45% de cada faixa.
func _check_xp_budget(gd) -> void:
	var hours := 0.0
	for lv in range(1, 30):
		hours += Balance.level_minutes(lv) / 60.0
	check(hours > 13.0 and hours < 17.0, "ritmo planejado até o 30: %.1f h" % hours)
	for band in Balance.XP_BANDS:
		var need := Balance.band_xp(band[0], band[1])
		var qx := 0
		var n := 0
		for qid in gd.quests:
			var q: QuestDef = gd.quests[qid]
			if not q.repeatable and q.level_req >= band[0] and q.level_req < band[1]:
				qx += q.reward_xp
				n += 1
		# faixa cujas missões ainda não entraram nesta árvore (QUEST_PENDING_BANDS): pula só enquanto nenhuma missão da faixa
		# dá XP (as de ascensão do 35 dão 0); com a primeira missão de XP a faixa passa a ser cobrada sozinha
		if qx == 0 and band[0] in QUEST_PENDING_BANDS:
			print("  PENDENTE: faixa %d-%d sem missões de XP nesta árvore (entram com o Monte Kharzun, WP9); parte de quest não conferida" % [band[0], band[1]])
			continue
		var share := float(qx) / maxf(1.0, need)
		var want := Balance.quest_share(band[0])
		check(absf(share - want) < 0.05, "faixa %d-%d: quests dão %.0f%% da XP (alvo %.0f%%, %d quests)" % [band[0], band[1], share * 100.0, want * 100.0, n])
		check(n >= 10, "faixa %d-%d: pelo menos 10 quests (%d)" % [band[0], band[1], n])
	# nível a nível (faixas 1-10 e 10-20): nenhum nível fica só no grind (o 6-7 e o 11-13 já ficaram quase sem quest)
	for lv in range(2, 20):
		var qx_lv := 0
		for qid in gd.quests:
			var q: QuestDef = gd.quests[qid]
			if not q.repeatable and q.level_req == lv:
				qx_lv += q.reward_xp
		check(qx_lv >= Balance.xp_for_level(lv) * 0.35, "nível %d: quests dão %d de %d XP (>= 35%%)" % [lv, qx_lv, Balance.xp_for_level(lv)])
	var kills_l25: float = Balance.xp_for_level(25) * (1.0 - Balance.XP_QUEST_SHARE) / gd.monsters["skeleton"].xp
	check(kills_l25 > 100 and kills_l25 < 400, "nível 25: ~%d abates de esqueleto (não milhares)" % int(kills_l25))

## Teia no 30 (design/gdd/progression.md): a média das builds dá ~x1,4 de ATK e ~x1,2 de HP (Balance.WEB_GAIN_*);
## cada build fica com ATK×HP em WEB_GAIN_BUILD (tanque troca ATK por HP, curandeiro tem pouco ATK).
## Fronteira da teia (Ato II, 31-45): só nós de nível > 30 (a teia do 30 não muda), cada setor de build com uma pedra-angular
## (duas opções que se excluem: ofensiva e segura) e um Ápice no 45, o Geral com a sua pedra-angular; stats só de STAT_KEYS;
## comprar uma pedra-angular tranca a outra; o bot pega a do papel dele e nunca passa do nível.
func _check_web_frontier(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var nodes: Dictionary = gd.trees[cid]["nodes"]
		var late: Array = []
		var keys := {}                     # ramo -> pedras-angulares
		var apex := {}
		var elos := 0
		var bad_keys: Array = []
		for nid in nodes:
			var n: Dictionary = nodes[nid]
			if n["kind"] == "pick" or int(n["level"]) <= 30:
				continue
			late.append(nid)
			for k in n["stats"]:
				if not (str(k).begins_with("attr_") or k in Stats.STAT_KEYS):
					bad_keys.append("%s:%s" % [nid, k])
			if n.has("keystone"):
				if not keys.has(n["branch"]):
					keys[n["branch"]] = []
				keys[n["branch"]].append(n)
			if n.get("apex", false):
				apex[n["branch"]] = n
			if str(n["name"]).begins_with("Elo:"):
				elos += 1
		check(late.size() >= 120, "%s: Fronteira com 120+ nós acima do 30 (%d)" % [cid, late.size()])
		check(bad_keys.is_empty(), "%s: Fronteira só com stats de Stats.STAT_KEYS %s" % [cid, bad_keys.slice(0, 4)])
		check(elos >= 2, "%s: notáveis de elo entre builds vizinhas (%d)" % [cid, elos])
		for b in [{"id": ""}] + cls.builds:
			var ks: Array = keys.get(b["id"], [])
			var ok: bool = ks.size() == 2 and ks[0]["excludes"] == [ks[1]["id"]] and ks[1]["excludes"] == [ks[0]["id"]] 				and ks.all(func(k): return int(k["level"]) == Balance.WEB_KEYSTONE_LEVEL) and ks.map(func(k): return k["keystone"]).has("atk") and ks.map(func(k): return k["keystone"]).has("def")
			check(ok, "%s/%s: uma pedra-angular com 2 opções que se excluem (ofensiva e segura) no %d" % [cid, b["id"] if b["id"] != "" else "geral", Balance.WEB_KEYSTONE_LEVEL])
			if b["id"] != "":
				check(apex.has(b["id"]) and int(apex[b["id"]]["level"]) == Balance.WEB_APEX_LEVEL, "%s/%s: Ápice da build no %d" % [cid, b["id"], Balance.WEB_APEX_LEVEL])
	# bot: no 30 nada da Fronteira; no 45 pega a pedra-angular do papel e a outra fica trancada
	var cls2: ClassDef = gd.classes["paladin"]
	for b in cls2.builds:
		for lv in [30, Balance.WEB_APEX_LEVEL]:
			var e: SimEntity = sim.spawn_bot(cls2, "Fr", "city_aldara", Vector3(0, 0, 8), lv)
			e.brain = null
			e.build_id = b["id"]
			sim._skill_bot(e)
			var nodes: Dictionary = gd.trees["paladin"]["nodes"]
			var over := e.tree.keys().filter(func(x): return nodes.has(x) and nodes[x]["kind"] != "pick" and int(nodes[x]["level"]) > lv)
			check(over.is_empty(), "bot paladin/%s no %d: nada acima do nível %s" % [b["id"], lv, over.slice(0, 3)])
			var mine: Array = e.tree.keys().filter(func(x): return nodes.has(x) and nodes[x].has("keystone"))
			if lv <= 30:
				check(mine.is_empty() and not e.tree.keys().any(func(x): return nodes.has(x) and nodes[x]["kind"] != "pick" and int(nodes[x]["level"]) > 30),
					"bot paladin/%s no 30: nada da Fronteira" % b["id"])
			else:
				var lean := "def" if b["role"] in ["tank", "healer"] else "atk"
				check(not mine.is_empty() and mine.all(func(x): return nodes[x]["keystone"] == lean), "bot paladin/%s no %d: pedra-angular do papel (%s: %s)" % [b["id"], lv, lean, mine])
				for x in mine:
					e.mastery_points = 5
					var other: String = nodes[x]["excludes"][0]
					check(sim.tree_block_reason(e, other).begins_with("exclui") and not sim.tree_allocate(e, other), "paladin: %s tranca %s" % [nodes[x]["name"], nodes[other]["name"]])
			sim.despawn(e)

## Lanceiro (decisão 2026-11-16, opção B): +LANCEIRO_EVASION_PCT de esquiva num notável próprio do setor dele na teia
## (Balance.BUILD_WEB_NOTABLES), que o bot da build compra; nenhuma outra build tem esse notável e a curva da AGI não muda.
## Notáveis de papel (Balance.ROLE_NOTABLES, playtest 2026-11-18): não tanques têm 3+ de sobrevivência, tanques 3+ de dano,
## o HP base por nível das classes que não são tanque subiu 10-15%, bots compram e cada efeito novo funciona na sim.
const ROLE_HP_PER_LEVEL_BEFORE := {"paladin": 16.0, "berserker": 14.0, "bishop": 9.0, "druid": 12.5, "ranger": 11.5,
	"assassin": 11.0, "elementalist": 8.0, "necromancer": 9.0}

## Notáveis de base (2026-11-21, Balance.CORE_NOTABLES): anel de 5 em volta do Início, nível 1, 1 ponto, ligado só a ele;
## as 8 chaves novas fazem o que dizem; bots compram os 5.
func _check_core_notables(gd, sim) -> void:
	ProgressionSystem.bot_core = true
	_core_notables_body(gd, sim)
	ProgressionSystem.bot_core = false

func _core_notables_body(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	for cid in gd.classes:
		var tr: Dictionary = gd.trees[cid]
		var list: Array = Balance.CORE_NOTABLES.get(cid, [])
		check(list.size() == 5, "%s: 5 notáveis de base (%d)" % [cid, list.size()])
		for i in range(list.size()):
			var n: Dictionary = tr["nodes"].get("%s_core_%d" % [cid, i], {})
			check(not n.is_empty() and n["kind"] == "notable" and int(n["level"]) == 1 and int(n["cost"]) == 1 and n["links"] == [tr["start"]] 				and (tr["nodes"][tr["start"]]["links"] as Array).has(n["id"]), "%s: notável de base %d no anel do Início, nível 1, 1 ponto" % [cid, i])
			for k in list[i][1]:
				check(Stats.STAT_KEYS.has(k) and TreeCatalog.STAT_NAMES.has(k) and TreeCatalog.STAT_SHORT.has(k) and TreeCatalog.STAT_FAMILY.has(k),
					"notável de base %s/%s: stat %s conhecido e com texto" % [cid, list[i][0], k])
		var bot: SimEntity = sim.spawn_bot(gd.classes[cid], "CoreBot", "city_aldara", Vector3(2, 0, 8), 5)
		bot.brain = null
		var got := 0
		for i in range(list.size()):
			if bot.tree.has("%s_core_%d" % [cid, i]):
				got += 1
		check(got == list.size(), "bot %s no 5 compra os notáveis de base (%d)" % [cid, got])
		sim.despawn(bot)
	var at := Vector3(6, 0, 8)
	var made: Array = []
	var mk := func(cid: String, pos: Vector3, buff: Dictionary) -> SimEntity:
		var e: SimEntity = sim.spawn_bot(gd.classes[cid], "Core", "city_aldara", pos, 20)
		e.brain = null
		e.tree_bonus.clear()
		e.ct.clear()                          # sem talentos de classe: só o nó testado
		e.buffs.clear()
		if not buff.is_empty():
			var b := buff.duplicate()
			b["id"] = "core_test"
			b["remaining"] = 999.0
			e.put_buff(b)
		e.recompute_stats()
		e.heal_full()
		made.append(e)
		return e
	# Mana em Carne: +HP máximo = % do MP máximo
	var fat: SimEntity = mk.call("elementalist", at, {})
	var hp0 := fat.stats.max_hp
	var mp0 := fat.stats.max_mp
	fat.put_buff({"id": "core_test", "remaining": 999.0, "mp_to_hp": 8})
	fat.recompute_stats()
	check(is_equal_approx(fat.stats.max_hp, hp0 + mp0 * 0.08) and is_equal_approx(fat.stats.max_mp, mp0), "Mana em Carne: +8%% do MP vira HP, o MP fica (%.0f -> %.0f)" % [hp0, fat.stats.max_hp])
	# Firme na Queda: -15% abaixo de 50% da vida
	var pal: SimEntity = mk.call("paladin", at + Vector3(2, 0, 0), {"low_dr": 15})
	check(Combat.core_low_dr(pal, 1000) == 1000, "Firme na Queda: vida cheia, dano igual")
	pal.hp = pal.stats.max_hp * 0.4
	check(Combat.core_low_dr(pal, 1000) == 850, "Firme na Queda: abaixo de 50%%, -15%% (%d)" % Combat.core_low_dr(pal, 1000))
	# Fúria da Beira: 0 com a vida cheia, cheio na beira
	var ber: SimEntity = mk.call("berserker", at + Vector3(3, 0, 0), {"low_hp_atk": 30})
	check(is_equal_approx(Combat.core_damage_mult(sim, ber), 1.0), "Fúria da Beira: vida cheia sem bônus")
	ber.hp = ber.stats.max_hp * Balance.LOW_HP_ATK_FLOOR
	check(is_equal_approx(Combat.core_damage_mult(sim, ber), 1.3), "Fúria da Beira: +30%% na beira (%.2f)" % Combat.core_damage_mult(sim, ber))
	ber.hp = ber.stats.max_hp * 0.55
	var mid := Combat.core_damage_mult(sim, ber)
	check(mid > 1.1 and mid < 1.2, "Fúria da Beira: metade do caminho, metade do bônus (%.2f)" % mid)
	# Sangue que Sobra: roubo que passa do máximo vira barreira (teto)
	ber.heal_full()
	ber.shield_hp = 0.0
	Combat.core_leech(ber, ber.stats.max_hp * 0.05)
	var sb := ber.buffs.any(func(x): return x.get("id") == "shield")
	check(ber.shield_hp <= 0.0, "sem o nó o roubo que sobra não vira barreira")
	var bers: SimEntity = mk.call("berserker", at + Vector3(4, 0, 0), {"leech_shield": 15})
	Combat.core_leech(bers, bers.stats.max_hp * 0.05)
	sb = bers.buffs.any(func(x): return x.get("id") == "shield")
	check(sb and is_equal_approx(bers.shield_hp, bers.stats.max_hp * 0.05), "Sangue que Sobra: o que sobra vira barreira (%.0f)" % bers.shield_hp)
	Combat.core_leech(bers, bers.stats.max_hp)
	check(is_equal_approx(bers.shield_hp, bers.stats.max_hp * 0.15), "Sangue que Sobra: barreira até 15%% da vida (%.0f)" % bers.shield_hp)
	# Fúria dos Mortos e Escudo de Carne (invocação)
	var nec: SimEntity = mk.call("necromancer", at + Vector3(0, 0, 3), {"summon_frenzy": 25, "summon_guard": 15})
	var minion: SimEntity = sim.spawn_summon(nec, gd.monsters["skeleton_minion"], nec.position + Vector3(1.5, 0, 0), 0.0)
	minion.brain = null
	made.append(minion)
	check(is_equal_approx(Combat.core_damage_mult(sim, minion), 1.0), "Fúria dos Mortos: invocação inteira sem bônus")
	minion.hp = minion.stats.max_hp * 0.3
	check(is_equal_approx(Combat.core_damage_mult(sim, minion), 1.25), "Fúria dos Mortos: invocação ferida +25%%")
	minion.heal_full()
	minion.stats.max_hp = 999999.0
	minion.hp = 999999.0
	var mob: SimEntity = sim.spawn_monster(gd.monsters["skeleton_minion"], "city_aldara", nec.position + Vector3(0, 0, 9))
	mob.brain = null
	made.append(mob)
	var nhp := nec.hp
	var mhp := minion.hp
	sim._deal_damage(mob, nec, 1000, false, false, "physical", null, false)
	check(nhp - nec.hp <= 850.0 and is_equal_approx(mhp - minion.hp, 150.0), "Escudo de Carne: 15%% do dano vai para a invocação (%.0f / %.0f)" % [nhp - nec.hp, mhp - minion.hp])
	# Escudo dos Irmãos: aliado do grupo a até 8 m leva parte do seu dano
	var tank: SimEntity = mk.call("paladin", at + Vector3(0, 0, 6), {"ally_guard": 15})
	var ally: SimEntity = mk.call("ranger", at + Vector3(2, 0, 6), {})
	tank.stats.max_hp = 999999.0
	tank.hp = 999999.0
	ally.stats.max_hp = 999999.0
	ally.hp = 999999.0
	PartySystem.party_invite(sim, tank, ally)
	PartySystem.party_accept(sim, ally)
	tank.stats.evasion = 0.0                   # a parte desviada pode ser esquivada pelo protetor: aqui tem de pegar
	tank.stats.block_chance = 0.0
	var thp := tank.hp
	var ahp := ally.hp
	sim._deal_damage(mob, ally, 1000, false, false, "physical", null, false)
	check(is_equal_approx(ahp - ally.hp, 850.0) and is_equal_approx(thp - tank.hp, 150.0), "Escudo dos Irmãos: 15%% do dano do aliado vai para o protetor (%.0f / %.0f)" % [ahp - ally.hp, thp - tank.hp])
	ally.position = tank.position + Vector3(Balance.ALLY_GUARD_RANGE + 3.0, 0, 0)
	ahp = ally.hp
	sim._deal_damage(mob, ally, 1000, false, false, "physical", null, false)
	check(is_equal_approx(ahp - ally.hp, 1000.0), "Escudo dos Irmãos: longe, não protege")
	PartySystem.party_leave(sim, ally)
	# Graça Transbordante: a cura que passa do máximo vai para o aliado mais ferido
	var bis: SimEntity = mk.call("bishop", at + Vector3(0, 0, 40), {"overheal_share": 50})
	var full: SimEntity = mk.call("ranger", at + Vector3(1, 0, 40), {})
	var hurt: SimEntity = mk.call("ranger", at + Vector3(2, 0, 40), {})
	for o in [full, hurt]:                     # a cura que sobra vai para o grupo (aliado = mesmo grupo)
		PartySystem.party_invite(sim, bis, o)
		PartySystem.party_accept(sim, o)
	hurt.hp = hurt.stats.max_hp * 0.3
	var hb := hurt.hp
	sim._heal(bis, full, 400)
	var got_h := hurt.hp - hb
	check(got_h > 150.0 and got_h <= 201.0, "Graça Transbordante: metade da cura que sobra vai ao mais ferido (%.0f)" % got_h)
	hb = hurt.hp
	PartySystem.party_leave(sim, bis)
	var plain_b: SimEntity = mk.call("bishop", at + Vector3(3, 0, 40), {})
	for o in [full, hurt]:
		PartySystem.party_invite(sim, plain_b, o)
		PartySystem.party_accept(sim, o)
	sim._heal(plain_b, full, 400)
	check(is_equal_approx(hurt.hp, hb), "sem o nó a cura que sobra se perde")
	for e in made:
		sim.despawn(e)

func _check_role_notables(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	for cid in ROLE_HP_PER_LEVEL_BEFORE:
		var cls: ClassDef = gd.classes[cid]
		var r: float = cls.hp_per_level / float(ROLE_HP_PER_LEVEL_BEFORE[cid])
		if cid == "paladin":
			check(is_equal_approx(r, 1.0), "Paladino (tanque): HP por nível igual (%.2f)" % cls.hp_per_level)
		else:
			check(r >= 1.10 and r <= 1.15, "%s: HP por nível +10-15%% (%.2f -> %.2f, x%.3f)" % [cid, ROLE_HP_PER_LEVEL_BEFORE[cid], cls.hp_per_level, r])
	for cid in Balance.ROLE_NOTABLES:
		for grp in Balance.ROLE_NOTABLES[cid]:
			for pick in grp["list"]:
				for k in pick[1]:
					check(Stats.STAT_KEYS.has(k) and TreeCatalog.STAT_NAMES.has(k) and TreeCatalog.STAT_SHORT.has(k),
						"notável %s/%s: stat %s em Stats.STAT_KEYS e com texto na teia" % [cid, pick[0], k])
	for cid in gd.classes:
		var tanks: Array = []
		var others: Array = []
		for b in gd.classes[cid].builds:
			(tanks if b["role"] == "tank" else others).append(b["id"])
		var nd: Dictionary = gd.trees[cid]["nodes"]
		var surv := {}
		var dmg := {}
		for nid in nd:
			var n: Dictionary = nd[nid]
			if not n.has("role_note"):
				continue
			check(n["kind"] == "notable" and int(n["level"]) <= Balance.WEB_GAIN_LEVEL, "%s: notável de papel %s é notável da teia do 30" % [cid, n["name"]])
			(surv if n["role_note"] == "survival" else dmg)[n["name"]] = n
		if cid != "paladin":
			check(surv.size() >= 3, "%s: %d notáveis de sobrevivência na teia (>= 3)" % [cid, surv.size()])
		if not tanks.is_empty():
			check(dmg.size() >= 3, "%s: %d notáveis de dano para o tanque (>= 3)" % [cid, dmg.size()])
			for nm in dmg:
				check(str(dmg[nm]["branch"]) in tanks, "%s: notável de dano %s no ramo do tanque" % [cid, nm])
		# bot de cada build compra os do papel dele no 30
		for b in gd.classes[cid].builds:
			var want: Dictionary = dmg if b["role"] == "tank" else surv
			if want.is_empty():
				continue
			var e: SimEntity = sim.spawn_bot(gd.classes[cid], "RoleTest", "city_aldara", Vector3(0, 0, 8), 30)
			e.brain = null
			e.build_id = b["id"]
			sim._gear_bot(e)
			sim._skill_bot(e)
			var got := 0
			for nid in e.tree:
				if nd.has(nid) and nd[nid].get("role_note", "") == ("damage" if b["role"] == "tank" else "survival"):
					got += 1
			check(got >= 3, "bot %s/%s no 30 compra %d notáveis de papel (>= 3)" % [cid, b["id"], got])
			sim.despawn(e)
	# rota completa de sobrevivência: +12-30% de HP efetivo só dos notáveis (o resto vem do HP base)
	for cid in ["assassin", "ranger", "elementalist", "necromancer", "berserker", "bishop"]:
		var add := {}
		for pick in Balance.ROLE_NOTABLES[cid][0]["list"]:
			for k in pick[1]:
				add[k] = float(add.get(k, 0.0)) + float(pick[1][k])
		var hp_m := 1.0 + float(add.get("hp_pct", 0.0)) / 100.0
		var ehp := hp_m / ((1.0 - float(add.get("dr_pct", 0.0)) / 100.0) * (1.0 - float(add.get("evasion", 0.0)) / 100.0))
		check(ehp >= 1.12 and ehp <= 1.3, "%s: notáveis de sobrevivência dão x%.2f de HP efetivo (alvo 1,12-1,30)" % [cid, ehp])
	# efeitos na sim
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(1, 0, 8))
	mob.brain = null
	var ass: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["assassin"], "Leech", "city_aldara", Vector3(0, 0, 8), 30)
	ass.tree_bonus = {"crit_leech": 8}
	ass.recompute_stats()
	ass.hp = 100.0
	mob.hp = mob.stats.max_hp
	sim._deal_damage(ass, mob, 200, true, false, "physical")
	check(ass.hp > 100.0, "Sangue no Fio: crítico cura (%.0f -> %.0f)" % [100.0, ass.hp])
	var hp_c := ass.hp
	sim._deal_damage(ass, mob, 200, false, false, "physical")
	check(is_equal_approx(ass.hp, hp_c), "Sangue no Fio: golpe sem crítico não cura")
	ass.tree_bonus = {"low_leech": 6}
	ass.recompute_stats()
	ass.hp = ass.stats.max_hp * 0.2
	var low := ass.hp
	sim._deal_damage(ass, mob, 200, false, false, "physical")
	check(ass.hp > low, "Sede na Beira: rouba vida abaixo de %d%% da vida" % int(Balance.LOW_LEECH_HP * 100))
	ass.hp = ass.stats.max_hp
	sim._deal_damage(ass, mob, 200, false, false, "physical")
	check(is_equal_approx(ass.hp, ass.stats.max_hp), "Sede na Beira: com vida cheia não muda nada")
	ass.tree_bonus = {"hit_slow": 20}
	ass.recompute_stats()
	mob.debuffs.clear()
	sim._deal_damage(ass, mob, 50, false, false, "physical")
	check(mob.debuffs.any(func(d): return d.get("kind") == "slow" and is_equal_approx(float(d["pct"]), 20.0)), "Flecha Pesada: golpe físico deixa o monstro lento")
	ass.tree_bonus = {"heal_taken_pct": 15}
	ass.recompute_stats()
	check(is_equal_approx(ass.heal_factor(), 1.15), "Cura de Si/Seiva: +15%% de cura recebida (x%.2f)" % ass.heal_factor())
	sim.despawn(ass)
	var ele: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["elementalist"], "Mana", "city_aldara", Vector3(0, 0, 8), 30)
	ele.tree_bonus = {"mana_guard": 15}
	ele.recompute_stats()
	ele.heal_full()
	var mp0 := ele.mp
	var hp0 := ele.hp
	sim._deal_damage(mob, ele, 100, false, false, "physical", null, false)
	check(ele.mp < mp0 and hp0 - ele.hp < 100.0 and hp0 - ele.hp >= 80.0, "Barreira de Mana: parte do dano sai da mana (HP -%.0f, MP -%.0f)" % [hp0 - ele.hp, mp0 - ele.mp])
	sim.despawn(ele)
	var pal: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["paladin"], "Tank", "city_aldara", Vector3(0, 0, 8), 30)
	pal.tree_bonus = {}
	pal.recompute_stats()
	var patk0 := pal.stats.patk
	pal.tree_bonus = {"def_atk_pct": 10}
	pal.recompute_stats()
	check(absf(pal.stats.patk - patk0 - pal.stats.pdef * 0.1) < 0.5, "Peso da Fé: 10%% da DEF vira ATK (%.0f -> %.0f, DEF %.0f)" % [patk0, pal.stats.patk, pal.stats.pdef])
	pal.tree_bonus = {"block_reflect": 40, "guard_crit": 15}
	pal.recompute_stats()
	var crit0 := pal.stats.crit_phys
	pal.heal_full()
	mob.hp = mob.stats.max_hp
	sim._deal_damage(mob, pal, 100, false, true, "physical", null, false)
	check(mob.hp < mob.stats.max_hp, "Escudo Vingador: bloqueio devolve dano (%.0f)" % (mob.stats.max_hp - mob.hp))
	check(pal.buffs.any(func(b): return b.get("id") == Balance.GUARD_CRIT_BUFF) and absf(pal.stats.crit_phys - crit0 - 15.0) < 0.01,
		"Contra-Ataque: bloquear dá +15%% de crítico por %.0f s (%.1f -> %.1f)" % [Balance.GUARD_CRIT_TIME, crit0, pal.stats.crit_phys])
	pal.tree_bonus = {"taunt_dmg_pct": 12}
	pal.recompute_stats()
	mob.hp = mob.stats.max_hp
	mob.aggro_target = -1
	sim._deal_damage(pal, mob, 300, false, false, "physical")
	var d_free: float = mob.stats.max_hp - mob.hp
	mob.hp = mob.stats.max_hp
	mob.aggro_target = pal.id
	sim._deal_damage(pal, mob, 300, false, false, "physical")
	var d_taunt: float = mob.stats.max_hp - mob.hp
	check(absf(d_taunt / maxf(1.0, d_free) - 1.12) < 0.01, "Julgamento: +12%% de dano em quem tem o tanque como alvo (%.0f -> %.0f)" % [d_free, d_taunt])
	sim.despawn(pal)
	sim.despawn(mob)

func _check_lanceiro_evasion(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	check(Stats.STAT_KEYS.has("evasion"), "esquiva é stat de passivo (Stats.STAT_KEYS)")
	var sig: Array = Balance.BUILD_WEB_NOTABLES.get("lanceiro", [])
	check(sig.size() == 2 and is_equal_approx(float(sig[1].get("evasion", 0.0)), Balance.LANCEIRO_EVASION_PCT),
		"Lanceiro: notável-assinatura dá +%.1f%% de esquiva" % Balance.LANCEIRO_EVASION_PCT)
	check(is_equal_approx(Balance.LANCEIRO_EVASION_PCT, 5.0), "Lanceiro: esquiva própria de 5%% (decisão do autor; era %.1f)" % Balance.LANCEIRO_EVASION_PCT)
	var sig_nid := ""
	var others: Array = []
	for cid in gd.classes:
		var nd: Dictionary = gd.trees[cid]["nodes"]
		for nid in nd:
			var n: Dictionary = nd[nid]
			if n["kind"] != "notable" or sig.is_empty() or str(n["name"]) != str(sig[0]):
				continue
			if cid == "ranger" and n["branch"] == "lanceiro" and sig_nid == "":
				sig_nid = nid
			else:
				others.append("%s/%s" % [cid, nid])
	check(sig_nid != "", "teia do Ranger: notável %s no setor do Lanceiro" % (str(sig[0]) if sig.size() > 0 else "?"))
	check(others.is_empty(), "notável do Lanceiro só no setor dele, um só (%s)" % [others])
	if sig_nid == "":
		return
	var node: Dictionary = gd.trees["ranger"]["nodes"][sig_nid]
	check(int(node["level"]) <= 20 and is_equal_approx(float(node["stats"].get("evasion", 0.0)), Balance.LANCEIRO_EVASION_PCT),
		"%s: +%.1f%% de esquiva, aberto até o nível 20 (nível %d)" % [sig_nid, Balance.LANCEIRO_EVASION_PCT, int(node["level"])])
	var cls: ClassDef = gd.classes["ranger"]
	for lv in [20, 30, 45]:
		for bid in ["lanceiro", "cacador", "atirador"]:
			var e: SimEntity = sim.spawn_bot(cls, "EvaTest", "city_aldara", Vector3(0, 0, 8), lv)
			e.brain = null
			e.build_id = bid
			sim._gear_bot(e)
			sim._skill_bot(e)
			var has: bool = e.tree.has(sig_nid)
			if bid == "lanceiro":
				check(has, "bot Lanceiro no %d compra %s" % [lv, node["name"]])
				var with_node: float = e.stats.evasion
				e.tree_bonus["evasion"] = float(e.tree_bonus.get("evasion", 0.0)) - Balance.LANCEIRO_EVASION_PCT
				e.recompute_stats()
				var no_node: float = e.stats.evasion
				check(absf(with_node - no_node - Balance.LANCEIRO_EVASION_PCT) < 0.01 or with_node >= Balance.EVASION_CAP,
					"Lanceiro no %d: notável dá +%.1f%% de esquiva (%.1f -> %.1f, teto %.0f)" % [lv, Balance.LANCEIRO_EVASION_PCT, no_node, with_node, Balance.EVASION_CAP])
			else:
				check(not has, "bot %s no %d não compra o notável do Lanceiro" % [bid, lv])
			sim.despawn(e)

func _check_web_strength(gd, sim) -> void:
	ProgressionSystem.bot_core = true            # a força da teia conta o anel de base (o que bots e jogador têm)
	_web_strength_body(gd, sim)
	ProgressionSystem.bot_core = false

func _web_strength_body(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	var sum_atk := 0.0
	var sum_hp := 0.0
	var n := 0
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		for b in cls.builds:
			var r := WebGain.measure(sim, cls, b["id"], Balance.WEB_GAIN_LEVEL)
			var both: float = r["atk"] * r["hp"]
			sum_atk += r["atk"]
			sum_hp += r["hp"]
			n += 1
			var bb: Array = (Balance.WEB_GAIN_BUILD_CLASS.get(cid, {}) as Dictionary).get(Balance.WEB_GAIN_LEVEL, Balance.WEB_GAIN_BUILD)
			check(both >= bb[0] and both <= bb[1],
				"teia %s/%s no 30: ATK x%.2f × HP x%.2f = x%.2f (faixa %s)" % [cid, b["id"], r["atk"], r["hp"], both, bb])
	var atk := sum_atk / maxf(1, n)
	var hp := sum_hp / maxf(1, n)
	check(atk >= Balance.WEB_GAIN_ATK[0] and atk <= Balance.WEB_GAIN_ATK[1], "teia no 30, média de %d builds: ATK x%.2f (alvo %s)" % [n, atk, Balance.WEB_GAIN_ATK])
	check(hp >= Balance.WEB_GAIN_HP[0] and hp <= Balance.WEB_GAIN_HP[1], "teia no 30, média de %d builds: HP x%.2f (alvo %s)" % [n, hp, Balance.WEB_GAIN_HP])
	# Ato II: a Fronteira (níveis 31-45) nas faixas próprias do 40 e do 45 (Balance.WEB_GAIN_LATE), sem ponto sobrando
	for lv in Balance.WEB_GAIN_LATE:
		var band: Dictionary = Balance.WEB_GAIN_LATE[lv]
		var sa := 0.0
		var sh := 0.0
		var m := 0
		var left: Array = []
		for cid in gd.classes:
			var cls: ClassDef = gd.classes[cid]
			for b in cls.builds:
				var r := WebGain.measure(sim, cls, b["id"], lv)
				var both: float = r["atk"] * r["hp"]
				sa += r["atk"]
				sh += r["hp"]
				m += 1
				if int(r["left"]) > 0:
					left.append("%s/%s=%d" % [cid, b["id"], int(r["left"])])
				var lb: Array = (Balance.WEB_GAIN_BUILD_CLASS.get(cid, {}) as Dictionary).get(lv, band["build"])
				check(both >= lb[0] and both <= lb[1],
					"teia %s/%s no %d: ATK x%.2f × HP x%.2f = x%.2f (faixa %s)" % [cid, b["id"], lv, r["atk"], r["hp"], both, lb])
		check(left.is_empty(), "teia no %d: bots gastam todos os pontos (sobra: %s)" % [lv, left])
		check(sa / m >= band["atk"][0] and sa / m <= band["atk"][1], "teia no %d, média: ATK x%.2f (alvo %s)" % [lv, sa / m, band["atk"]])
		check(sh / m >= band["hp"][0] and sh / m <= band["hp"][1], "teia no %d, média: HP x%.2f (alvo %s)" % [lv, sh / m, band["hp"]])

## Colheita: pontos em chão livre, F colhe em ~1 s, andar cancela, volta depois; COLLECT conta.
func _check_gather(gd, sim) -> void:
	for mid in ["city_aldara", "field_forest", "field_ruins", "elf_city"]:
		var list: Array = sim.maps[mid].get("gather", [])
		check(list.size() >= 15, "%s: pontos de colheita (%d)" % [mid, list.size()])
		var bad := list.filter(func(g): return not sim.is_walkable(g["pos"], gd.maps[mid], 0.5))
		check(bad.is_empty(), "%s: pontos em chão livre (%d fora)" % [mid, bad.size()])
		for g in list:
			check(gd.items.has(g["item"]) and UiKit.item_texture(gd.items[g["item"]]) != null, "%s: item %s com ícone" % [mid, g["item"]])
	var m: Dictionary = sim.maps["city_aldara"]
	var node: Dictionary = m["gather"][0]
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Colhe", "city_aldara", node["pos"] + Vector3(0.8, 0, 0), 5)
	e.brain = null
	var before := int(e.inventory.get(node["item"], 0))
	sim._interact(e, m)
	check(e.gather_left > 0.0, "F perto do ponto começa a colher")
	var idle := InputCommand.new()
	for i in range(int(Balance.GATHER_TIME * 60) + 5):
		sim._update_gather(e, idle, idle, 1.0 / 60.0)
	check(int(e.inventory.get(node["item"], 0)) > before, "colheu %s" % node["item"])
	check(float(node["ready_at"]) > sim.time and sim.nearest_gather(e).get("pos", Vector3.INF) != node["pos"], "ponto colhido some até voltar")
	# andar cancela
	var node2: Dictionary = m["gather"][1]
	e.position = node2["pos"] + Vector3(0.6, 0, 0)
	sim._interact(e, m)
	var walk := InputCommand.new()
	walk.move = Vector2(1, 0)
	sim._update_gather(e, walk, walk, 0.1)
	check(e.gather_left == 0.0 and float(node2["ready_at"]) <= sim.time, "andar cancela a colheita")
	node["ready_at"] = 0.0
	sim.despawn(e)
	# animação: o kit gera os clipes de colher; minério usa a picareta
	var kit := KitModel.create("male", Color.WHITE, 0.02, "paladin")
	if kit:
		check(kit.anim.has_animation("gather_herb") and kit.anim.has_animation("gather_mine"), "kit tem os clipes de colher (erva e picareta)")
		check(GatherPose.clip_for("ore") == "gather_mine" and GatherPose.clip_for("star") == "gather_mine" and GatherPose.clip_for("herb") == "gather_herb"
			and GatherPose.clip_for("shell") == "gather_herb", "minério usa picareta; erva, concha e cogumelo, agachar e puxar")
		kit.free()

## Entregas, cadeias, colheita nas quests; sem chefe repetido; caçada paga por quem está na zona do monstro.
func _check_quest_variety(gd, sim) -> void:
	var kinds := {}
	var boss_quests := {}
	var dup: Array = []
	var kh_ids := {}
	for kd in QuestsCatalog.act2_kharzun():
		kh_ids[kd["id"]] = true
	for qid in gd.quests:
		var q: QuestDef = gd.quests[qid]
		if not q.give_items.is_empty():
			kinds["entrega"] = int(kinds.get("entrega", 0)) + 1
			check(q.type == QuestDef.Type.COLLECT and q.give_items.has(q.target_id) and q.turnin() != q.giver_npc, "%s: entrega leva o item a outro NPC" % qid)
		if q.type == QuestDef.Type.COLLECT and q.give_items.is_empty():
			for mid in MapsCatalog.GATHER:
				for g in MapsCatalog.GATHER[mid]:
					if g[0] == q.target_id:
						kinds["colheita"] = int(kinds.get("colheita", 0)) + 1
		if qid in MapsCatalog.Q_STEPPE_FORTS and MapsCatalog.FORT_DEFS[str(qid).replace("hx_", "")]["boss"] != q.target_id:
			continue          # chefe dos acampamentos ainda é substituto (MapsCatalog.STAND_INS): os três caem no mesmo id
		if MapsCatalog.STAND_INS.values().has(q.target_id) and kh_ids.has(qid):
			continue          # chefes de Kharzun ainda são substitutos de chefes da Horda (STAND_INS): o id cai no mesmo
		if q.type == QuestDef.Type.KILL and gd.monsters.has(q.target_id) and gd.monsters[q.target_id].is_boss and not q.repeatable and not str(qid).begins_with("hx_asc45_"):
			if boss_quests.has(q.target_id):
				dup.append(q.target_id)
			boss_quests[q.target_id] = true
	check(int(kinds.get("entrega", 0)) >= 5, "quests de entrega (%d)" % int(kinds.get("entrega", 0)))
	check(int(kinds.get("colheita", 0)) >= 6, "quests de colheita (%d)" % int(kinds.get("colheita", 0)))
	check(dup.is_empty(), "nenhum chefe com duas quests de história (%s)" % str(dup))
	check(boss_quests.has("crab_king") and boss_quests.has("boar_brute"), "Caranguejo-Rei e Presa-Rachada têm quest")
	# cadeias longas: o Lago (6), os bandidos (6), a erudita (4+)
	for pair in [["l6_rei", 6], ["b6_limpeza", 6], ["r4_chave", 4]]:
		var depth := 0
		var cur: String = pair[0]
		while cur != "" and gd.quests.has(cur):
			depth += 1
			cur = gd.quests[cur].prereq_quest
		check(depth >= int(pair[1]), "cadeia até %s tem %d passos" % [pair[0], depth])
	# todo NPC de quest existe em algum mapa
	var npcs := {}
	for mid in gd.maps:
		for n in gd.maps[mid].npcs:
			npcs[n["id"]] = true
	var missing: Array = []
	for qid in gd.quests:
		var q: QuestDef = gd.quests[qid]
		for who in [q.giver_npc, q.turnin()]:
			if not npcs.has(who):
				missing.append("%s:%s" % [qid, who])
	check(missing.is_empty(), "NPCs das quests existem (%s)" % str(missing.slice(0, 4)))
	# entrega: aceitar dá o pacote, desistir tira
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Entrega", "city_aldara", Vector3(0, 0, 6), 5)
	e.brain = null
	var dq: QuestDef = gd.quests["d1_carta"]
	QuestSystem.accept(e, dq)
	check(e.has_item("sealed_letter") and QuestSystem.is_complete(e, dq), "aceitar a entrega põe a carta na bolsa")
	QuestSystem.abandon(e, dq)
	check(not e.has_item("sealed_letter"), "desistir tira a carta")
	sim.despawn(e)
	# caçada: quem paga é da zona do monstro
	var zone_giver := {"slime": "board", "crab": "board", "spider": "stone_druid", "skeleton": "dawn_board", "zombie": "board"}
	for mon in zone_giver:
		if gd.quests.has("h_" + mon):
			check(gd.quests["h_" + mon].giver_npc == zone_giver[mon], "caçada de %s paga por %s" % [mon, zone_giver[mon]])

## Polimento dos monstros: chefes com loot próprio, bando vem junto, nome pela diferença de nível.
func _check_monster_polish(gd, sim) -> void:
	var tables := {}
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		if md.is_boss and md.loot_table != "" and md.xp > 0:
			check(not tables.has(md.loot_table), "%s: tabela de loot própria (%s já usada por %s)" % [mid, md.loot_table, tables.get(md.loot_table, "")])
			tables[md.loot_table] = mid
			check(gd.loot_tables.has(md.loot_table), "%s: tabela %s existe" % [mid, md.loot_table])
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-60, 0, -40)
	var a: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at)
	var b: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at + Vector3(3, 0, 0))
	var c: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at + Vector3(14, 0, 0))
	var other: SimEntity = sim.spawn_monster(gd.monsters["boar"], "city_aldara", at + Vector3(0, 0, 2))
	for x in [a, b, c, other]:
		x.brain = null
		x.aggro_target = -1
	var hunter: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Puxa", "city_aldara", at + Vector3(0, 0, -8), 10)
	hunter.brain = null
	sim._retarget(a, hunter)
	check(a.aggro_target == hunter.id and b.aggro_target == hunter.id, "bando: o lobo do lado vem junto")
	check(c.aggro_target < 0 and other.aggro_target < 0, "longe ou de outra espécie: fica")
	for x in [a, b, c, other, hunter]:
		sim.despawn(x)
	check(EntityView.level_color(20, 10).r > 0.9 and EntityView.level_color(20, 10).g < 0.4, "monstro 10 níveis acima: nome vermelho")
	check(EntityView.level_color(3, 12).is_equal_approx(Color(0.62, 0.62, 0.62)), "monstro muito abaixo: nome cinza")

## Dungeons do Vale (maiores): bandos também nos corredores, mas a chegada fica livre.
func _check_dungeon_density(gd, sim) -> void:
	for pair in [["dg_gruta", 6, 40], ["dg_catacumbas", 12, 60], ["dg_ninho", 6, 40], ["dg_cripta", 6, 36], ["dg_pedreira", 12, 60]]:
		var def: MapDef = gd.maps[pair[0]]
		var mobs := 0
		for sp in def.spawners:
			mobs += int(sp["count"])
			check((sp["pos"] as Vector3).distance_to(def.spawn_point) > 14.0, "%s: %s longe da chegada" % [pair[0], sp["monster_id"]])
			check(sim.is_walkable(sp["pos"], def, 0.4) or float(sp["radius"]) >= 3.0, "%s: %s em chão livre" % [pair[0], sp["monster_id"]])
		check(def.spawners.size() >= int(pair[1]) and mobs >= int(pair[2]), "%s: %d pontos de caça, %d monstros" % [pair[0], def.spawners.size(), mobs])

## Loja: não vende o que não tem preço (moeda lendária, pacote de entrega); "vender materiais" poupa o que a quest pede.
func _check_shop_rules(gd, sim) -> void:
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Loja", "city_aldara", Vector3(0, 0, 6), 5)
	e.brain = null
	e.add_item("legend_coin", 1)
	e.add_item("fish_basket", 1)
	e.add_item("slime_gel", 4)
	e.add_item("boar_tusk", 3)
	check(not CraftSystem.sell(e, "legend_coin", 1) and not CraftSystem.sell(e, "fish_basket", 1), "moeda lendária e pacote de entrega não se vendem")
	e.quests_active["q05_boars"] = 0          # quest ativa que pede presas de javali
	var junk: Array = load("res://game/ui/npc_ui.gd").junk_of(e)
	check(junk.has("slime_gel") and not junk.has("boar_tusk") and not junk.has("legend_coin"), "vender materiais poupa o que a quest ativa pede (%s)" % str(junk))
	var g0 := e.gold
	check(CraftSystem.sell(e, "slime_gel", 4) and e.gold == g0 + int(gd.items["slime_gel"].price * 0.5) * 4, "vende a pilha pela metade do preço")
	sim.despawn(e)

## Tratadora de montarias (npc_ui, Kharzun WP10): um botão por tipo; travado sem a missão; em uso desligado; clique troca na sim.
func _check_mount_keeper_ui(gd, sim) -> void:
	var ui: GDScript = load("res://game/ui/npc_ui.gd")
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Montaria", "city_aldara", Vector3(0, 0, 6), 45)
	e.brain = null
	var opts: Array = ui.mount_options(sim, e)
	check(opts.size() == Balance.MOUNT_KINDS.size() and opts.all(func(o): return o["text"] != "" and o["tip"] != ""), "tratador: um botão com texto e dica por montaria (%d)" % opts.size())
	var h0: Dictionary = _mount_opt(opts, "horse")
	var w0: Dictionary = _mount_opt(opts, "dire_wolf")
	check(h0.get("disabled", false) and str(h0.get("text", "")).contains("Em uso"), "tratador: cavalo em uso fica desligado (%s)" % h0.get("text", ""))
	check(w0.get("disabled", false) and str(w0.get("text", "")).contains("travado") and str(w0.get("tip", "")).contains(gd.quests["hx_ov_hatch"].title), "tratador: lobo travado sem hx_ov_hatch, dica diz a missão (%s)" % w0.get("tip", ""))
	check(not ui.pick_mount(sim, e, "dire_wolf") and e.mount_kind == "horse", "tratador: clicar no lobo travado não troca")
	e.quests_completed.append("hx_ov_hatch")
	var w1: Dictionary = _mount_opt(ui.mount_options(sim, e), "dire_wolf")
	check(not w1.get("disabled", true) and str(w1.get("text", "")).contains("Trocar para"), "tratador: com hx_ov_hatch o lobo libera (%s)" % w1.get("text", ""))
	e.mounted = true
	check(ui.pick_mount(sim, e, "dire_wolf") and e.mount_kind == "dire_wolf" and not e.mounted, "tratador: clicar troca para o lobo e desce do cavalo")
	var opts2: Array = ui.mount_options(sim, e)
	check(_mount_opt(opts2, "dire_wolf").get("disabled", false) and not _mount_opt(opts2, "horse").get("disabled", true), "tratador: depois da troca o lobo fica em uso e o cavalo volta a ser clicável")
	check(ui.pick_mount(sim, e, "horse") and e.mount_kind == "horse", "tratador: troca de volta para o cavalo")
	sim.despawn(e)

func _mount_opt(opts: Array, kind: String) -> Dictionary:
	for o in opts:
		if o["kind"] == kind:
			return o
	return {}

## Material que dá para conseguir: cai de alguma tabela de saque ou se colhe em algum mapa.
func _dropped_somewhere(gd, iid: String) -> bool:
	for lid in gd.loot_tables:
		for en in gd.loot_tables[lid].entries:
			if str(en.get("item", "")) == iid:
				return true
	for mid in MapsCatalog.GATHER:
		for g in MapsCatalog.GATHER[mid]:
			if str(g[0]) == iid:
				return true
	return false

## Forja nova: joias e capas por tier e tema, bolsas ampliadas; aprimoramento +1..+9; bolsa com limite; colher para em combate.
func _check_forge(gd, sim) -> void:
	var n_jewel := 0
	var n_tiers: int = Balance.COMMON_TIER_LEVELS.size()
	check(RecipesCatalog.JEWEL_MATS.size() == n_tiers and RecipesCatalog.CAPE_MATS.size() == n_tiers
		and RecipesCatalog.THEME_MAT.values().all(func(a): return a.size() == n_tiers), "materiais de joia/capa para os %d tiers" % n_tiers)
	for tier in range(n_tiers):
		for piece in GearCatalog.THEME_PIECES:
			for theme in GearCatalog.THEMES:
				var rid := "rec_%s_%s_t%d" % [piece, theme, tier]
				check(gd.recipes.has(rid), "receita %s" % rid)
				if gd.recipes.has(rid):
					n_jewel += 1
					var rec: RecipeDef = gd.recipes[rid]
					check(rec.station == ("alchemy" if piece == "cape" else "smith"), "%s: estação certa" % rid)
					check(rec.level_req == int(Balance.COMMON_TIER_LEVELS[tier]) and gd.items.has(rec.result_item)
						and gd.items[rec.result_item].level_req == rec.level_req, "%s: nível do tier e item existe" % rid)
					for mat in rec.ingredients:
						check(gd.items.has(mat) and _dropped_somewhere(gd, mat), "%s: material %s existe e cai/colhe-se" % [rid, mat])
	check(n_jewel == 9 * n_tiers, "%d receitas de anel/amuleto/capa (%d)" % [9 * n_tiers, n_jewel])
	for i in range(Balance.BAG_SIZES.size()):
		check(gd.recipes.has("rec_bag_t%d" % i) and UiKit.item_texture(gd.items["bag_t%d" % i]) != null, "Bolsa Ampliada %d: receita e ícone" % (i + 1))
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Forja", "city_aldara", Vector3(0, 0, 6), 25)
	e.brain = null
	# drop: equipamento comum do tier que a classe usa (sem joia/capa)
	for tier in range(4):
		var pool: Array = sim.gear_pool(tier)
		check(pool.size() > 0 and not pool.any(func(it): return it.slot in [ItemDef.Slot.AMULET, ItemDef.Slot.RING, ItemDef.Slot.CAPE]), "tier %d: drop de arma/armadura (%d itens)" % [tier, pool.size()])
		check(pool.filter(func(it): return sim.fits_class(e, it)).size() > 0, "tier %d: tem drop para paladino" % tier)
	# aprimoramento
	var sw: ItemDef = e.equipment[ItemDef.Slot.WEAPON]
	var body: ItemDef = null
	for sl in e.equipment:
		if e.equipment[sl] and e.equipment[sl].def > 0.0 and sl != ItemDef.Slot.OFFHAND:
			body = e.equipment[sl]
	var atk0: float = e.stats.patk
	var def0: float = e.stats.pdef
	e.gold = 1_000_000
	e.add_item("iron_ore", 400)
	e.add_item("star_ore", 400)
	for i in range(Balance.PLUS_MAX):
		check(sim.enhance(e, e.equipment[ItemDef.Slot.WEAPON].id, ItemDef.Slot.WEAPON) != null, "arma vestida sobe para +%d" % (i + 1))
	var w9: ItemDef = e.equipment[ItemDef.Slot.WEAPON]
	check(w9.plus == Balance.PLUS_MAX and w9.base_id == sw.id and w9.id == "%s+%d" % [sw.id, Balance.PLUS_MAX], "a arma vestida é a versão +%d" % Balance.PLUS_MAX)
	check(sim.enhance(e, w9.id, ItemDef.Slot.WEAPON) == null, "não passa de +%d" % Balance.PLUS_MAX)
	# por cópia: duas espadas iguais na bolsa, aprimora uma — a outra continua +0
	e.add_item(sw.id, 2)
	var v1: ItemDef = sim.enhance(e, sw.id)
	check(v1 != null and e.has_item(sw.id, 1) and not e.has_item(sw.id, 2) and e.has_item(v1.id, 1), "aprimorar uma cópia não muda as outras (%s x1 + %s x1)" % [sw.id, v1.id if v1 else "?"])
	check(GameData.resolve_item(sw.id + "+4") and GameData.items[sw.id + "+4"].plus == 4 and not GameData.resolve_item(sw.id + "+12"), "id +N do save volta a existir (até +%d)" % Balance.PLUS_MAX)
	check(UiKit.item_texture(v1) != null, "versão aprimorada usa a arte da base")
	# save: versão +N na bolsa e vestida volta igual; save antigo (por tipo) vira uma cópia +N
	var sv: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Save", "city_aldara", Vector3(0, 0, 8), 10)
	sv.brain = null
	SaveSystem.apply_to(sv, {"level": 10, "inventory": {sw.id + "+3": 1, sw.id: 2}, "equipment": {str(ItemDef.Slot.WEAPON): sw.id + "+7"}})
	check(sv.has_item(sw.id + "+3") and sv.equipment[ItemDef.Slot.WEAPON].plus == 7, "save guarda cada cópia com o seu +N")
	SaveSystem.apply_to(sv, {"level": 10, "inventory": {sw.id: 2}, "equipment": {}, "plus": {sw.id: 4}})
	check(sv.has_item(sw.id, 1) and sv.has_item(sw.id + "+4", 1), "save antigo: uma cópia vira +4, a outra continua +0")
	sim.despawn(sv)
	check(e.stats.patk > atk0 * 1.15, "arma +9 bate mais (%.0f -> %.0f)" % [atk0, e.stats.patk])
	if body:
		var bslot := -1
		for sl in e.equipment:
			if e.equipment[sl] == body:
				bslot = sl
		for i in range(5):
			sim.enhance(e, e.equipment[bslot].id, bslot)
		check(e.stats.pdef > def0 and e.equipment[bslot].plus == 5, "armadura +5 protege mais (%.0f -> %.0f)" % [def0, e.stats.pdef])
	check(int(sim.enhance_cost(sw, 0)["count"]) < int(sim.enhance_cost(sw, 8)["count"]) + 1 and sim.enhance_cost(sw, 8)["item"] == "star_ore"
		and sim.enhance_cost(sw, 0)["item"] == "iron_ore", "custo: ferro até +5, estelar do +6 em diante")
	check(int(sim.enhance_cost(sw, 8)["gold"]) > int(sim.enhance_cost(sw, 0)["gold"]) * 10, "ouro cresce a cada nível")
	check(Stats.plus_attr(4, 9) >= 2 and Stats.plus_attr(0, 9) == 0, "atributo da peça cresce com o aprimoramento")
	# bolsa com limite + bolsas vestidas em vagas (estilo WoW, 2026-11-21)
	e.inventory.clear()
	var cap0 := e.bag_capacity()
	check(cap0 == Balance.BAG_BASE and e.bags.size() == Balance.BAG_SLOTS and e.bags.all(func(x): return x == ""), "bolsa começa com %d espaços e %d vagas vazias" % [Balance.BAG_BASE, Balance.BAG_SLOTS])
	check(Balance.BAG_SIZES == [6, 8, 10, 12] and ItemSystem.bag_size("bag_t3") == 12 and ItemSystem.bag_size("iron_ore") == 0, "tamanhos das bolsas I-IV: 6/8/10/12")
	e.add_item("bag_t1", 1)
	check(sim.equip_bag(e, "bag_t1") and e.bags[0] == "bag_t1" and not e.has_item("bag_t1") and e.bag_capacity() == cap0 + 8, "Bolsa II sem a I: vaga 1, +8 espaços")
	e.add_item("bag_t0", 3)
	for i in range(3):
		sim.equip_bag(e, "bag_t0")
	check(e.bags == ["bag_t1", "bag_t0", "bag_t0", "bag_t0"] and e.bag_capacity() == cap0 + 8 + 18, "repetidas valem: 3 Bolsas I nas outras vagas (%d)" % e.bag_capacity())
	e.add_item("bag_t3", 1)
	check(not sim.equip_bag(e, "bag_t3") and e.has_item("bag_t3"), "4 vagas cheias: não veste sem escolher a vaga")
	check(sim.equip_bag(e, "bag_t3", 1) and e.bags[1] == "bag_t3" and e.has_item("bag_t0") and e.bag_capacity() == cap0 + 8 + 12 + 12, "troca na vaga 2: a Bolsa I volta para a bolsa")
	check(sim.unequip_bag(e, 0) and e.bags[0] == "" and e.has_item("bag_t1") and e.bag_capacity() == cap0 + 24, "tirar a bolsa: volta para a bolsa")
	check(not sim.unequip_bag(e, 0), "vaga vazia: nada a tirar")
	sim.equip_bag(e, "bag_t1", 0)
	# cheia: tirar uma bolsa que deixaria itens de fora é recusado
	var big := e.bag_capacity()
	for iid in gd.items:
		if e.inventory.size() >= e.bag_capacity():
			break
		if not e.inventory.has(iid) and ItemSystem.bag_size(iid) == 0:
			e.add_item(iid, 1)
	check(e.inventory.size() == big and not sim.unequip_bag(e, 1) and e.bags[1] == "bag_t3", "bolsa cheia: não tira a bolsa que deixaria itens de fora")
	e.add_item("bag_t0", 1)
	check(not sim.equip_bag(e, "bag_t0", 1) and e.bags[1] == "bag_t3", "bolsa cheia: não troca por uma menor")
	e.inventory.clear()
	# save: bags gravadas e o bag_bonus antigo vira Bolsas II (mesma capacidade de antes: +8 cada)
	check(SaveSystem.load_bags({"bags": ["bag_t3", "x", "", "bag_t0"]}) == ["bag_t3", "", "", "bag_t0"], "save: bolsas vestidas voltam (id ruim vira vaga vazia)")
	check(SaveSystem.load_bags({"bag_bonus": 3}) == ["bag_t1", "bag_t1", "bag_t1", ""] and SaveSystem.load_bags({}) == ["", "", "", ""], "save antigo: bag_bonus 3 = 3 Bolsas II (+24, como antes)")
	e.bags = ["", "", "", ""]
	e.add_item("bag_t0", 1)
	sim.equip_bag(e, "bag_t0")
	e.add_item("bag_t1", 1)
	sim.equip_bag(e, "bag_t1")
	var fill := 0
	for iid in gd.items:
		if e.inventory.size() >= e.bag_capacity():
			break
		if not e.inventory.has(iid):
			e.add_item(iid, 1)
			fill += 1
	var outside := ""
	for iid in gd.items:
		if not e.inventory.has(iid):
			outside = iid
			break
	check(e.bag_full_for(outside) and not e.bag_full_for("iron_ore"), "bolsa cheia não aceita item novo (o que já tem empilha)")
	# colher: não começa e para em combate
	var m: Dictionary = sim.maps["city_aldara"]
	var node: Dictionary = m["gather"][2]
	node["ready_at"] = 0.0
	e.inventory.clear()
	e.position = node["pos"] + Vector3(0.6, 0, 0)
	e.combat_timer = 3.0
	sim._interact(e, m)
	check(e.gather_left == 0.0, "em combate não começa a colher")
	e.combat_timer = 0.0
	sim._interact(e, m)
	check(e.gather_left > 0.0, "fora de combate começa a colher")
	var idle := InputCommand.new()
	e.combat_timer = 3.0                     # levou um golpe (até absorvido pelo escudo marca combate)
	sim._update_gather(e, idle, idle, 0.1)
	check(e.gather_left == 0.0, "levar dano para a colheita")
	sim.despawn(e)

func _check_interiors(gd, sim) -> void:
	var in_aldara: Array = MapsCatalog.INTERIORS.keys().filter(func(i): return MapsCatalog.interior_map(i) == "city_aldara")
	check(in_aldara.size() >= 4 and in_aldara.size() <= 6, "Aldara: 4-6 casas que abrem (%d)" % in_aldara.size())
	check(MapsCatalog.interior_map("in_tavern") == "city_aldara" and MapsCatalog.interior_map("in_port_tavern") == "city_port",
		"casas que abrem: sem `map` é Aldara; a taverna do porto fica em city_port")
	var saved = sim.player
	for iid in MapsCatalog.INTERIORS:
		var host := MapsCatalog.interior_map(iid)
		var town: MapDef = gd.maps[host]
		if not sim.maps.has(host):
			sim.load_map(town)
		var m: Dictionary = sim.maps[host]
		var idef: MapDef = gd.maps.get(iid)
		check(idef != null and idef.interior and idef.is_town and idef.parent_map == host, "%s: mapa de interior de %s" % [iid, host])
		if idef == null:
			continue
		check(gd.town_map_id() == "city_aldara", "a cidade de respawn continua sendo Aldara")
		var door: Dictionary = {}
		for pt in town.portals:
			if pt["id"] == "door_" + iid:
				door = pt
		check(not door.is_empty() and door.get("player_only", false), "%s: porta em %s (só jogador)" % [iid, host])
		if door.is_empty():
			continue
		var dpos: Vector3 = door["pos"]
		check(sim.is_walkable(dpos, town, 0.45), "%s: porta em chão livre" % iid)
		check(sim.is_walkable(door["target_pos"], idef, 0.45), "%s: chegada dentro da casa é andável" % iid)
		var exit: Dictionary = idef.portals[0] if idef.portals.size() > 0 else {}
		check(not exit.is_empty() and exit["target_map"] == host and (exit["target_pos"] as Vector3).distance_to(dpos) < 2.6
			and (exit["target_pos"] as Vector3).distance_to(dpos) > float(door["radius"]) + 0.3, "%s: saída volta para a frente da porta (sem cair nela de novo)" % iid)
		check(not exit.is_empty() and (door["target_pos"] as Vector3).distance_to(exit["pos"]) > float(exit["radius"]) + 0.5, "%s: entrar não cai na saída" % iid)
		check(idef.npcs.size() >= 2, "%s: tem gente dentro (%d)" % [iid, idef.npcs.size()])
		for n in idef.npcs:
			check(sim.is_walkable(n["pos"], idef, 0.4), "%s: %s em chão livre" % [iid, n["id"]])
		# entrar: o jogador pisa na porta e vai para dentro; um bot no mesmo lugar não entra
		var bot: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Porta", host, dpos, 5)
		bot.brain = null
		sim.player = null
		sim._check_portals(bot, m)
		check(sim._pending_map_changes.is_empty(), "%s: bot passa pela porta sem entrar" % iid)
		sim.player = bot
		sim._check_portals(bot, m)
		sim._process_map_changes()
		check(bot.map_id == iid, "%s: jogador entra pela porta" % iid)
		if bot.map_id == iid:
			bot.position = exit["pos"]
			sim._check_portals(bot, sim.maps[iid])
			sim._process_map_changes()
			check(bot.map_id == host and bot.position.distance_to(dpos) < 2.6, "%s: sai de volta na frente da casa" % iid)
		sim.player = saved
		sim.despawn(bot)
	sim.player = saved

func _check_layout_conflicts(gd, sim) -> void:
	for mid in ["city_aldara", "field_forest", "field_ruins", "elf_city", "field_coast", "city_port", "field_steppe", "field_kharzun"]:
		var z: Dictionary = MapsCatalog.load_zone(mid)
		var roads: Array = z["roads"].filter(func(r): return r["kind"] in ["road", "trail"])
		var bad: Array = []
		for o in z["obstacles"]:
			if not o.get("solid", true) or o.get("kind", "") in ["wall", "cliff", "water"]:
				continue
			var p := Vector2(o["pos"].x, o["pos"].z)
			var half: float = maxf(o["size"].x, o["size"].z) * 0.5 * (1.0 if o.get("kind", "") == "fence" else 0.85)
			for r in roads:
				if _poly_dist2(p, r["pts"]) < float(r["w"]) * 0.5 + half - 0.25:
					bad.append("%s@%.0f,%.0f" % [o.get("kind", "?"), p.x, p.y])
					break
		check(bad.is_empty() or mid != "city_aldara", "%s: nada sólido nas estradas (%d: %s)" % [mid, bad.size(), str(bad.slice(0, 4))])
		var wet: Array = []
		for r in roads:
			for w in z["water"]:
				if w["kind"] == "lake":
					for q in r["pts"]:
						if q.distance_to(w["pos"]) < float(w["r"]):
							wet.append(r["kind"])
							break
		check(wet.is_empty(), "%s: estrada/trilha não entra no lago (%s)" % [mid, str(wet)])
		if mid != "city_aldara":
			continue
		var crossed: Array = []
		for sp in z["spawners"]:
			if float(sp["radius"]) <= 2.0:
				continue
			for r in roads:
				if r["kind"] == "road" and _poly_dist2(Vector2(sp["pos"].x, sp["pos"].z), r["pts"]) < float(sp["radius"]) * 0.6:
					crossed.append(sp["monster_id"])
					break
		check(crossed.is_empty(), "city_aldara: spawner fora da estrada (%s)" % str(crossed))
	# a praia dos caranguejos e o rei que sai do lago
	var md: MapDef = gd.maps["city_aldara"]
	var crabs: Array = md.spawners.filter(func(s): return s["monster_id"] in ["crab", "crab_king"])
	check(crabs.size() >= 3, "Vale: praia dos caranguejos com o Rei (%d spawners)" % crabs.size())
	var m: Dictionary = sim.maps["city_aldara"]
	for s in crabs:
		check(not sim._point_in_solid(s["pos"], m), "%s nasce em chão livre" % s["monster_id"])
	var king: Array = crabs.filter(func(s): return s["monster_id"] == "crab_king")
	check(king.size() == 1 and king[0].has("emerge"), "Caranguejo-Rei sai do lago (emerge)")
	check(gd.monsters["crab_king"].phases.size() >= 2 and gd.monsters["crab_small"].xp == 0, "Caranguejo-Rei: fases e filhotes sem XP")

func _poly_dist2(p: Vector2, pts: Array) -> float:
	var best := INF
	for i in range(pts.size() - 1):
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[i + 1]
		var ab := b - a
		var t := clampf((p - a).dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
		best = minf(best, p.distance_to(a + ab * t))
	return best

## Regras de layout de toda zona do Blender: vale fechado, POIs a 40-120 m do hub, tudo alcançável.
func _check_zone_layout(gd, sim, md: MapDef) -> void:
	var mid := md.id
	check(md.model == "map_" + mid and FileAccess.file_exists("res://assets/models/map_%s.glb" % mid), "%s: GLB da zona existe" % mid)
	check(md.roads.size() >= 5 and md.water.size() >= 1, "%s: estradas e água" % mid)
	check(md.has_hunting() and md.spawners.size() >= 7, "%s: spawners" % mid)
	var cliffs := 0
	for ob in md.obstacles:
		if ob.get("kind", "") == "cliff":
			cliffs += 1
	check(cliffs >= 60, "%s: borda de penhascos fecha o vale (%d)" % [mid, cliffs])
	# raios do hub pra fora: todos batem na borda antes do fim do mapa (menos onde há portal)
	var open_rays := 0
	for i in range(24):
		var dir := Vector3(cos(TAU * i / 24.0), 0, sin(TAU * i / 24.0))
		var near_portal := false
		for pt in md.portals:
			if Vector3(pt["pos"].x, 0, pt["pos"].z).normalized().dot(dir) > 0.985:
				near_portal = true
		var hit := false
		var r := 60.0
		while r < md.size.x * 0.5 - 1.0:
			if not sim.is_walkable(dir * r, md, 0.45) and r > 95.0:
				hit = true
				break
			r += 0.5
		if not hit and not near_portal:
			open_rays += 1
	check(open_rays == 0, "%s: borda fecha o vale (%d raios escapam)" % [mid, open_rays])
	check(sim.is_walkable(md.spawn_point, md, 0.45), "%s: ponto de chegada andável" % mid)
	for sp in md.spawners:
		var d: float = Vector2(sp["pos"].x, sp["pos"].z).length()
		var hostile_hub: bool = mid in HOSTILE_HUBS and d < gd.maps[mid].town_radius         # cidade inimiga: a guarnição mora no hub
		var dummy: bool = sp["monster_id"] == "training_dummy"       # boneco de treino: fica colado na vila de propósito
		check((d > 40.0 or hostile_hub or dummy) and d < 120.0 * (1.2 if mid == "city_aldara" else 1.0), "%s: spawner %s a %.0f m do hub" % [mid, sp["monster_id"], d])
		check(sim.is_walkable(sim.random_walkable(md, sp["pos"], float(sp["radius"])), md), "%s: spawner %s andável" % [mid, sp["monster_id"]])
	for n in md.npcs:
		if n.get("role", "") == "crystal":          # o cristal é a própria coluna sólida: confere a frente dele
			check(sim.is_walkable(n["pos"] + (md.town_center - n["pos"]).normalized() * Balance.CRYSTAL_ARRIVE, md, 0.5), "%s: frente do cristal livre" % mid)
			continue
		check(float(n.get("perch", 0.0)) > 0.0 or sim.is_walkable(n["pos"], md, 0.3), "%s: NPC %s em chão livre" % [mid, n["id"]])
	for pt in md.portals:
		check(sim.is_walkable(pt["pos"], md, 0.45), "%s: portal %s alcançável" % [mid, pt["id"]])
	for other in gd.maps:
		for pt in gd.maps[other].portals:
			if pt["target_map"] == mid:
				var arrive: Vector3 = pt["target_pos"]
				check(sim.is_walkable(arrive, md, 0.45), "%s: chegada de %s andável" % [mid, other])
				for own in md.portals:
					check(arrive.distance_to(own["pos"]) > float(own["radius"]) + 1.0, "%s: chegada de %s fora do portal de volta" % [mid, other])


# ---------------------------------------------------------------------------
# personagens: kit modular (kit_male/kit_female) tem os clipes que a EntityView pede
# ---------------------------------------------------------------------------
func _check_character_models(gd, sim) -> void:
	# kits genéricos (NPCs, sem conjuntos) e um por classe (com os conjuntos/armas/escudos só dela)
	var kits: Array = [["male", ""], ["female", ""]]
	for cid in gd.classes:                 # cada classe nos dois sexos (criação de personagem)
		kits.append(["male", cid])
		kits.append(["female", cid])
	for pair in kits:
		var body: String = pair[0]
		var own: String = pair[1]
		var kid: String = ("%s_%s" % [own, body]) if own != "" else body
		check(KitModel.exists(body, own) and KitModel.path_for(body, own).ends_with("kit_%s.glb" % kid), "kit_%s.glb existe" % kid)
		var k := KitModel.create(body, Color.WHITE, 0.025, own)
		var mine := func(set_id: String) -> bool: return gd.sets[set_id].class_id == own
		for clip in ["idle", "run", "atk_1h_a", "atk_2h", "atk_bow", "atk_staff", "cast", "cast_buff", "hit", "die", "block", "jump", "fall", "land", "dash", "idle_bow", "idle_staff"]:
			check(k.resolve(clip) != "", "kit_%s: clipe %s" % [kid, clip])
		for piece in ["arm_cape_cape_", "arm_plate_legs_", "arm_leather_legs_", "arm_cloth_legs_", "arm_plate_head_", "arm_leather_body_", "arm_cloth_body_"]:     # armadura comum: 1 malha por slot (chibi_kit.join_style_slots)
			check(k.pieces(piece + "*").size() > 0, "kit_%s: detalhe %s" % [kid, piece])
		check(k.has_material("tint2"), "kit_%s: tem peças de cor de destaque" % kid)
		# cada boneco instancia o kit inteiro: malha demais estoura o limite de recursos da GPU com a cidade cheia
		var meshes := k.pieces("*").size()
		check(meshes < 200, "kit_%s: poucas malhas por boneco (%d; kit por classe, peças de conjunto juntas por slot)" % [kid, meshes])
		if own == "":
			check(k.pieces("arm_pal*").is_empty() and k.pieces("arm_ber*").is_empty(), "kit_%s: genérico não leva conjuntos" % kid)
		# espada própria de cada conjunto com visual (ItemDef.weapon_style -> wpn_main_<tipo>_<estilo>)
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			for iid in gd.sets[set_id].pieces:
				var wit: ItemDef = gd.items[iid]
				if wit.slot == ItemDef.Slot.WEAPON and not iid.ends_with("_offhand"):
					check(wit.weapon_style != "" and k._nodes.has("wpn_main_%s_%s" % [wit.weapon_type, wit.weapon_style]), "kit_%s: espada própria de %s" % [kid, set_id])
					check(k.main_node(wit) == "wpn_main_%s_%s" % [wit.weapon_type, wit.weapon_style], "kit_%s: %s usa a espada própria" % [kid, iid])
		# maça do conjunto (variante da espada): modelo próprio no kit
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			for aid in gd.sets[set_id].alt_pieces:
				var ait: ItemDef = gd.items[aid]
				check(k.main_node(ait) == "wpn_main_%s_%s" % [ait.weapon_type, ait.weapon_style], "kit_%s: %s usa a maça própria" % [kid, aid])
		# segundo machado dos Gêmeos: arma própria na mão esquerda
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			for iid in gd.sets[set_id].pieces:
				var oit: ItemDef = gd.items[iid]
				if iid.ends_with("_offhand") and oit.weapon_type == "axe":
					check(k.off_node_of(oit) == "wpn_off_axe_%s" % oit.weapon_style and k._nodes.has(k.off_node_of(oit)), "kit_%s: %s com machado próprio na mão esquerda" % [kid, iid])
				elif iid.ends_with("_offhand") and oit.weapon_type in ["dagger", "sword"]:      # Assassino: par próprio (Trapaceiro: adaga de aparar)
					check(k.off_node_of(oit) == "wpn_off_%s_%s" % [oit.weapon_type, oit.weapon_style] and k._nodes.has(k.off_node_of(oit)), "kit_%s: %s com arma própria na mão esquerda" % [kid, iid])
		var plain: ItemDef = gd.items["sword_iron"]
		check(k.main_node(plain) == "wpn_main_sword", "arma comum continua com o modelo do tipo")
		# todo conjunto com visual próprio (GearCatalog.SET_VISUALS) tem as 4 peças no kit
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			var style: String = GearCatalog.SET_VISUALS[set_id]["style"]
			for slot in ["head", "body", "gloves", "boots"]:
				check(k.pieces("arm_%s_%s_*" % [style, slot]).size() > 0, "kit_%s: peças do conjunto %s (%s)" % [kid, style, slot])
		k.free()
	# todo conjunto lendário do paladino tem visual próprio, cada um diferente
	var pal_styles := {}
	for set_id in gd.sets:
		var psd: SetDef = gd.sets[set_id]
		if psd.class_id != "paladin" or psd.is_hybrid() or psd.is_apex():
			continue
		check(not GearCatalog.visual_of(set_id).is_empty(), "%s tem visual próprio" % set_id)
		for iid in psd.pieces:
			var pit: ItemDef = gd.items[iid]
			if pit.armor_style != "" and pit.slot != ItemDef.Slot.LEGS:      # calça: estilo da build (o kit tem), na cor do conjunto
				pal_styles[pit.armor_style] = true
				check(pit.armor_style == GearCatalog.visual_of(set_id).get("style", ""), "%s usa o visual do conjunto" % iid)
	# 18 visuais dos níveis 5..30 + 3 do Ato II (um por build, o mesmo no 35/40/45; malhas no kit extra, _check_kit_addon)
	check(pal_styles.size() == 18 + 3, "18 conjuntos do paladino até o 30 + 3 visuais do Ato II (%d)" % pal_styles.size())
	var ber := 0
	for set_id in gd.sets:
		if gd.sets[set_id].class_id == "berserker" and not gd.sets[set_id].is_hybrid() and not gd.sets[set_id].is_apex():
			ber += 1
			check(not GearCatalog.visual_of(set_id).is_empty(), "%s tem visual próprio" % set_id)
	check(ber == 3 * Balance.LEGENDARY_LEVELS.size(), "3 conjuntos do berserker por nível lendário (%d)" % ber)
	var bis := 0
	for set_id in gd.sets:
		if gd.sets[set_id].class_id == "bishop" and not gd.sets[set_id].is_hybrid() and not gd.sets[set_id].is_apex():
			bis += 1
			check(not GearCatalog.visual_of(set_id).is_empty(), "%s tem visual próprio" % set_id)
			for pid in gd.sets[set_id].pieces:
				var bit: ItemDef = gd.items[pid]
				if bit.weapon_type == "shield":
					var bvis: Dictionary = GearCatalog.visual_of(set_id)          # Ato II: o escudo continua o do nível 30 (chave "shield" do visual)
					check(bit.shield_style == str(bvis.get("shield", bvis["style"])) and ResourceLoader.exists("res://assets/icons/%s.png" % bit.icon), "%s: escudo próprio com ícone" % pid)
	check(bis == 3 * Balance.LEGENDARY_LEVELS.size(), "3 conjuntos do bispo por nível lendário (%d)" % bis)
	# cada conjunto do paladino tem uma 2ª arma (a maça; no Templário, a espada de defesa): cai junto, não muda o total
	var mace_sets := 0
	for set_id in gd.sets:
		var msd: SetDef = gd.sets[set_id]
		if msd.class_id != "paladin" or msd.is_hybrid() or msd.is_apex():
			continue
		check(msd.alt_pieces.size() == 1, "%s: tem maça alternativa" % set_id)
		if msd.alt_pieces.is_empty():
			continue
		mace_sets += 1
		var mace: ItemDef = gd.items[msd.alt_pieces[0]]
		var mbid: String = set_id.get_slice("_", 2)
		check(mace.weapon_type in gd.classes["paladin"].build_by_id(mbid)["main"] and GearCatalog.weapon_role(mbid, mace.weapon_type) == "defense" and mace.set_id == set_id and mace.weapon_style != "",
			"%s: 2ª arma do conjunto (a de defesa) com visual" % mace.id)
		check(not (mace.id in msd.pieces) and not (mace.id in msd.armor), "%s: maça não soma no total de peças" % set_id)
		check(ResourceLoader.exists("res://assets/icons/%s.png" % mace.icon), "%s: ícone da 2ª arma (%s)" % [mace.id, mace.icon])
		var pool: Array = gd.legendary_pool(gd.classes["paladin"], msd.level)
		check(mace.id in pool, "%s: maça cai como lendário" % mace.id)
		var sword: ItemDef = null
		for pid in msd.pieces:
			if gd.items[pid].slot == ItemDef.Slot.WEAPON and not pid.ends_with("_offhand"):
				sword = gd.items[pid]
		check(sword != null and mace.attributes.has("VIT") and mace.is_two_handed() == sword.is_two_handed() and mace.attributes != sword.attributes,
			"%s: maça com as mãos da espada, mas atributos de defesa (VIT) e não cópia da espada" % mace.id)
	check(mace_sets == 3 * Balance.LEGENDARY_LEVELS.size(), "maça de conjunto em todo nível lendário (Guardião, Cruzado e Templário) (%d)" % mace_sets)
	# bônus: maça + armadura conta igual a espada + armadura
	var ms: SetDef = gd.sets["set_paladin_guardiao_20"]
	var pa: SimEntity = sim.spawn_bot(gd.classes["paladin"], "SetMace", "city_aldara", Vector3(0, 0, 6), 30)
	pa.brain = null
	pa.equipment.clear()
	for pid in ms.pieces:
		var pit: ItemDef = gd.items[pid]
		if pit.slot != ItemDef.Slot.WEAPON or pid.ends_with("_offhand"):
			pa.equipment[pit.slot] = pit
	pa.equipment[ItemDef.Slot.WEAPON] = gd.items[ms.alt_pieces[0]]
	pa.recompute_stats()
	check(int(pa.stats.active_sets.get(ms.id, 0)) == ms.armor.size(), "armadura completa: %d/%d (arma não conta)" % [int(pa.stats.active_sets.get(ms.id, 0)), ms.armor.size()])
	check(str(pa.stats.legend.get("kind", "")) == "bulwark" and pa.stats.thorns_pct == 0.0, "maça lendária do Guardião (tanque): Baluarte, sem Retaliação")
	sim.despawn(pa)
	for set_id in GearCatalog.SET_VISUALS:
		var vis: Dictionary = GearCatalog.SET_VISUALS[set_id]
		if vis.has("icon"):
			for iid in gd.sets[set_id].pieces:          # só as peças que o conjunto tem (Cruzado não tem mão secundária)
				var piece: String = iid.get_slice("_", iid.get_slice_count("_") - 1)
				if piece == "legs":
					check(UiKit.item_texture(gd.items[iid]) != null, "%s: calça com arte pintada" % set_id)
					continue
				check(ResourceLoader.exists("res://assets/icons/%s_%s.png" % [vis["icon"], piece]), "%s: ícone %s" % [set_id, piece])
	# primeiro lendário do paladino (Guardião lv5): visual próprio + ícones
	var sd: SetDef = gd.sets.get("set_paladin_guardiao_5")
	check(sd != null and sd.name == "Conjunto Cavaleiro da Fortaleza", "set do paladino lv5 com nome da referência")
	for iid in sd.pieces:
		var it: ItemDef = gd.items[iid]
		check(UiKit.item_texture(it) != null, "%s tem ícone" % iid)
		if it.armor_style != "" and it.slot != ItemDef.Slot.LEGS:
			check(it.armor_style == "pal1", "%s usa o visual pal1" % iid)


## Pulo (Espaço): sobe, volta ao chão; golpe apertado no ar espera o pouso (buffer).
func _check_jump(gd, sim) -> void:
	var j = sim.spawn_bot(gd.classes["berserker"], "Pulo", "city_aldara", Vector3(0, 0, 5), 5)
	j.brain = null
	var c := InputCommand.new()
	c.jump = true
	c.aim = j.position + Vector3(0, 0, 2)
	sim._apply_command(j, c, sim.maps["city_aldara"], 1.0 / 60.0)
	check(j.airborne() and j.jump_v > 0.0, "Espaço: pula")
	var peak := 0.0
	var a := InputCommand.new()
	a.attack = true
	a.aim = j.position + Vector3(0, 0, 2)
	sim._apply_command(j, a, sim.maps["city_aldara"], 1.0 / 60.0)
	check(j.state != SimEntity.State.CASTING, "no ar o golpe não sai")
	for i in range(90):
		sim._update_entity(j, sim.maps["city_aldara"], 1.0 / 60.0)
		peak = maxf(peak, j.jump_h)
	check(not j.airborne() and j.jump_h == 0.0, "volta ao chão")
	check(peak > 0.7 and peak < 1.3, "altura do pulo ~1 m (%.2f)" % peak)
	sim.despawn(j)


## Compra o caminho mais curto (BFS) dos nós já comprados até `target`, nó a nó pelas regras da sim.
## Devolve o custo total, ou -1 se algum nó do caminho for recusado.
func _buy_path(sim, e, target: String) -> int:
	var nodes: Dictionary = gd_ref.trees[e.class_def.id]["nodes"]
	var prev := {}
	var queue: Array = []
	for nid in e.tree:
		queue.append(nid)
		prev[nid] = ""
	while queue.size() > 0:
		var cur: String = queue.pop_front()
		if cur == target:
			break
		for l in nodes[cur]["links"]:
			if not prev.has(l):
				prev[l] = cur
				queue.append(l)
	if not prev.has(target):
		return -1
	var path: Array = []
	var cur := target
	while cur != "" and not e.tree.has(cur):
		path.push_front(cur)
		cur = prev[cur]
	var total := 0
	for nid in path:
		var c: int = int(nodes[nid]["cost"])
		if not sim.tree_allocate(e, nid):
			return -1
		total += c
	return total


# ---------------------------------------------------------------------------
# árvore de pontos de skill (TreeCatalog): forma, regras e um "jogador" por build do 1 ao 30 (loops)
# ---------------------------------------------------------------------------
## Talentos de classe (aba Talentos): 6 linhas × 3 por classe, ganchos válidos e o comportamento dos principais.
## Spawn de bot com cache (passo 4 ordenado, atributos no fim, equipamento por chave) = caminho antigo, nó a nó.
func _check_bot_spawn_cache(gd, sim) -> void:
	var at: Vector3 = sim.maps["city_aldara"]["def"].town_center
	var rng_state: int = sim.rng.state
	ClassTalentSystem.bot_picks = true
	var cases: Array = []          # [classe, build, nível, ascendido]
	var ci := 0
	for cid in gd.classes:
		var bl: Array = gd.classes[cid].builds
		if bl.is_empty():
			continue
		cases.append([cid, bl[ci % bl.size()]["id"], 8, false])
		cases.append([cid, bl[(ci + 1) % bl.size()]["id"], 27, false])
		cases.append([cid, bl[(ci + 2) % bl.size()]["id"], 45, true])
		cases.append([cid, bl[ci % bl.size()]["id"], 38, true])
		ci += 1
	for b in Balance.TITAN_BUILDS:                 # Empunhadura de Titã: chave do equipamento com titã
		for cid in gd.classes:
			if not gd.classes[cid].build_by_id(b).is_empty():
				cases.append([cid, b, 45, true])
	var bad := 0
	for c in cases:
		var outs: Array = []
		for r in 3:                                # antigo, cache vazio, cache cheio
			var fast: bool = r > 0
			if r == 1:                             # cache vazio de verdade (o antigo e casos anteriores já encheram)
				sim._bot_gear_cache.clear()
				ProgressionSystem._web_cache.clear()
				check(sim._bot_gear_cache.is_empty() and ProgressionSystem._web_cache.is_empty(), "spawn de bot: 2ª rodada começa com o cache vazio")
			sim.rng.state = 4242 + int(c[2])
			ProgressionSystem.bot_spawn_cache = fast
			var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[c[0]], "BS", "city_aldara", at, int(c[2]))
			e.build_id = c[1]
			if c[3]:
				e.quests_completed.append("hx_asc_" + str(c[0]))
			sim._gear_bot(e)
			sim._skill_bot(e, fast)
			e.heal_full()
			var d := _bot_state(e)
			ProgressionSystem.gain_xp(sim, e, Balance.xp_for_level(e.level))     # subir de nível: bot_spend sem lote
			d += "|lvup=" + _bot_state(e)
			outs.append(d)
			sim.despawn(e)
		ProgressionSystem.bot_spawn_cache = true
		if outs[0] != outs[1] or outs[0] != outs[2]:
			bad += 1
			print("BOT_SPAWN_CACHE diff %s
 old=%s
 new=%s
 hit=%s" % [str(c), outs[0], outs[1], outs[2]])
		check(outs[0] == outs[1] and outs[0] == outs[2], "spawn de bot com cache igual ao antigo: %s" % str(c))
	check(cases.size() >= 30 and bad == 0, "spawn de bot com cache: %d casos, %d diferentes" % [cases.size(), bad])
	# ClassTalentsCatalog: build() entrega cópia (mexer nela não suja o cache) e bate com as linhas em cache
	var cat: Dictionary = ClassTalentsCatalog.build()
	check(not ClassTalentsCatalog._cache.is_empty() and FileAccess.get_file_as_string("res://data/game_data.gd").contains("ClassTalentsCatalog.warm()"),
		"ClassTalentsCatalog: cache montado no GameData._ready (warm), antes da sim ir para a thread")
	check(str(cat["paladin"]) == str(ClassTalentsCatalog.rows_of("paladin")), "ClassTalentsCatalog: build() = cache")
	(cat["paladin"][0][1] as Array).clear()
	check((ClassTalentsCatalog.rows_of("paladin")[0][1] as Array).size() == 3, "ClassTalentsCatalog: build() é cópia (cache intacto)")
	ClassTalentSystem.bot_picks = false
	sim.rng.state = rng_state

## Estado do bot que o spawn decide (ordem da teia incluída: a soma dos passivos segue essa ordem).
func _bot_state(e: SimEntity) -> String:
	var eq: Array = []
	for sl in e.equipment:
		eq.append("%d:%s" % [sl, (e.equipment[sl] as ItemDef).id if e.equipment[sl] else "-"])
	var sk: Array = []
	for s in e.skills:
		sk.append(s.id if s else "-")
	var st: Array = []
	for pr in e.stats.get_property_list():
		if pr["usage"] & PROPERTY_USAGE_SCRIPT_VARIABLE:
			st.append("%s=%s" % [pr["name"], str(e.stats.get(pr["name"]))])
	return "lv%d eq=%s tree=%s asc=%s learned=%s m=%s tal=%s pts=%d asc_pts=%d sk=%s tb=%s ct=%s basic=%s hp=%.4f mp=%.4f st=%s" % [
		e.level, ",".join(eq), ",".join(e.tree.keys()), ",".join(e.asc_tree.keys()), ",".join(e.learned.keys()), str(e.mastery), str(e.talents),
		e.mastery_points, ProgressionSystem.asc_points(e), ",".join(sk), str(e.tree_bonus), str(e.ct), e.basic_skill.id if e.basic_skill else "-",
		e.hp, e.mp, ",".join(st)]

func _check_class_talents(gd, sim) -> void:
	var known_hooks := ["id", "name", "text", "kind", "permanent", "aura", "strength", "radius", "summon_permanent", "summon_extra",
		"skill_mods", "stats", "form_mult", "form_time", "cheat_death", "ally_save", "ambush_mult", "on_kill", "low_hp", "execute",
		"regen", "mana_shield", "trap_max", "oath_max", "build", "summon_time", "dot_boost", "form_stats"]
	var cat: Dictionary = ClassTalentsCatalog.build()
	_check_talent_unlock_levels(gd)
	for cid in gd.classes:
		var rows: Array = cat.get(cid, [])
		check(rows.map(func(r): return int(r[0])) == ClassTalentsCatalog.ROW_LEVELS, "%s: talentos nos níveis 5..45 (%s)" % [cid, str(rows.map(func(r): return r[0]))])
		var skill_ids: Array = gd.classes[cid].skill_ids
		for row in rows:
			check((row[1] as Array).size() == 3, "%s nv %d: 3 escolhas" % [cid, int(row[0])])
			for o in row[1]:
				var bad: Array = (o as Dictionary).keys().filter(func(k): return not (k in known_hooks))
				check(bad.is_empty(), "%s: %s só com ganchos conhecidos %s" % [cid, o["id"], bad])
				check(str(o["text"]).length() > 10 and o["kind"] in ClassTalentsCatalog.KINDS, "%s: %s com texto e tipo" % [cid, o["id"]])
				check(o.keys().size() > 4, "%s: %s tem efeito" % [cid, o["id"]])
				var refs: Array = o.get("permanent", []) + o.get("aura", []) + o.get("summon_permanent", []) + o.get("summon_extra", {}).keys() + o.get("skill_mods", {}).keys()
				if o.has("on_kill") and (o["on_kill"] as Dictionary).has("buff"):
					refs.append(o["on_kill"]["buff"])
				for r in refs:
					check(r in skill_ids, "%s: %s cita skill da classe (%s)" % [cid, o["id"], r])
				for r in o.get("permanent", []) + o.get("aura", []):
					check(ClassTalentSystem.passive_buff(r, 1.0).size() > 2, "%s: %s — %s tem bônus para ficar permanente" % [cid, o["id"], r])
				for r in o.get("summon_permanent", []) + o.get("summon_extra", {}).keys():
					check(gd.skills.has(r) and gd.skills[r].effects.has("summon"), "%s: %s — %s invoca" % [cid, o["id"], r])
				check(gd.trees[cid]["nodes"].has("%s_c_%s" % [cid, o["id"]]), "%s: %s é nó de escolha" % [cid, o["id"]])
	var m: Dictionary = sim.maps["city_aldara"]
	var at: Vector3 = m["def"].town_center
	var mk := func(cid: String, lv: int, pick: String, pos: Vector3) -> SimEntity:
		var e: SimEntity = sim.spawn_bot(gd.classes[cid], "CT", "city_aldara", pos, lv)
		e.brain = null
		for nid in e.tree.keys():
			if gd.trees[cid]["nodes"][nid]["kind"] == "pick":
				e.tree.erase(nid)
		if pick != "":
			e.tree["%s_c_%s" % [cid, pick]] = true
		sim.recompute_tree_bonus(e)
		e.heal_full()
		return e
	var run := func(secs: float) -> void:
		for i in range(int(secs / 0.5)):
			sim.time += 0.5
			ClassTalentSystem.tick(sim, m, 0.5)
	# Baluarte: Armadura Abençoada + Muralha sempre ativas (60%, sem a lentidão), por muito tempo
	var pal: SimEntity = mk.call("paladin", 10, "", at)
	var def0: float = pal.stats.pdef
	var spd0: float = pal.stats.move_speed
	pal.tree["paladin_c_pal_c_bulwark"] = true
	sim.recompute_tree_bonus(pal)
	run.call(36.0)
	var ids: Array = pal.buffs.map(func(b): return b.get("id"))
	check(pal.stats.pdef > def0 * 1.3 and pal.stats.move_speed >= spd0 - 0.01, "Baluarte: DEF sobe sem lançar e sem lentidão (%.0f -> %.0f)" % [def0, pal.stats.pdef])
	check(ids.size() >= 2 and ids.size() == ids.filter(func(x): return ids.count(x) == 1).size(), "Baluarte: um buff de cada (não acumula) %s" % str(ids))
	sim._apply_skill(pal, gd.skills["pal_blessed_armor"], m)
	var ba: Array = pal.buffs.filter(func(b): return b.get("id") == gd.skills["pal_blessed_armor"].effects["buff"]["id"])
	check(ba.size() == 1 and not ba[0].get("ct", false), "lançar com o permanente ativo: o lançado (mais forte) vale, um só")
	sim.despawn(pal)
	# Grito de Guerra (Sede de Sangue em aura): grupo a 10 m sim, a 25 m não, de fora do grupo não
	var ap: SimEntity = mk.call("berserker", 10, "ber_c_warcry", at)
	var near: SimEntity = mk.call("ranger", 10, "", at + Vector3(10, 0, 0))
	var far: SimEntity = mk.call("ranger", 10, "", at + Vector3(0, 0, 25))
	var stranger: SimEntity = mk.call("ranger", 10, "", at + Vector3(-8, 0, 0))
	for x in [near, far]:
		sim.party_invite(ap, x)
		sim.party_accept(x)
		check(x.party_id >= 0 and x.party_id == ap.party_id, "aura: entra no grupo")
	run.call(1.0)
	var has_aura := func(x: SimEntity) -> bool: return x.buffs.any(func(b): return b.get("ct", false))
	check(has_aura.call(ap) and has_aura.call(near), "aura de talento (Grito de Guerra): você e o aliado a 10 m")
	check(not has_aura.call(far) and not has_aura.call(stranger), "aura de talento (Grito de Guerra): nem a 25 m nem quem está fora do grupo")
	for x in [ap, near, far, stranger]:
		sim.despawn(x)
	# Elemental Vinculado: fica para sempre e invocar outro troca o elemento
	var ele: SimEntity = mk.call("elementalist", 10, "ele_c_bound", at + Vector3(4, 0, 4))
	sim._apply_skill(ele, gd.skills["ele_summon_fire"], m)
	var mine := func(owner: SimEntity) -> Array: return m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == owner.id and o.is_alive())
	check(mine.call(ele).size() == 1 and mine.call(ele)[0].summon_expires == INF, "Elemental Vinculado: elemental sem prazo")
	check(sim._summons_full(ele, gd.skills["ele_summon_fire"]) and not sim._summons_full(ele, gd.skills["ele_summon_ice"]), "Elemental Vinculado: o mesmo não repete, outro elemento pode")
	sim._apply_skill(ele, gd.skills["ele_summon_ice"], m)
	var now: Array = mine.call(ele)
	check(now.size() == 1 and now[0].monster_def.id == gd.skills["ele_summon_ice"].effects["summon"]["monster_id"] and now[0].summon_expires == INF, "Elemental Vinculado: troca de elemento")
	sim.despawn(ele)
	# Exército Eterno: esqueletos sem prazo, sem passar do máximo
	var nec: SimEntity = mk.call("necromancer", 10, "nec_c_army", at + Vector3(-4, 0, 4))
	for i in range(4):
		sim._apply_skill(nec, gd.skills["nec_raise"], m)
	var sk: Array = mine.call(nec)
	check(sk.size() == int(gd.skills["nec_raise"].effects["summon"]["max"]) and sk.all(func(o): return o.summon_expires == INF), "Exército Eterno: %d esqueletos para sempre" % sk.size())
	for o in sk:
		sim.despawn(o)
	sim.despawn(nec)
	_check_nec_row5(gd, sim, m, at, mk)
	_check_talents_applied(gd, sim, m, at, mk)
	_check_bot_talent_prefs(gd, sim)
	# Recusa a Morrer: golpe fatal deixa com 1 HP e imortal 6 s; depois disso, morre (recarga 60 s)
	var ber: SimEntity = mk.call("berserker", 5, "ber_c_undying", at + Vector3(6, 0, -4))
	var wolf: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at + Vector3(7, 0, -4))
	wolf.brain = null
	ber.stats.evasion = 0.0          # build sorteada (Punhos tem esquiva): o golpe fatal tem de pegar
	sim._deal_damage(wolf, ber, 999999, false, false, "physical")
	check(ber.is_alive() and int(ber.hp) == 1 and ber.immortal_left > 5.0, "Recusa a Morrer: fica com 1 HP e imortal")
	sim._deal_damage(wolf, ber, 999999, false, false, "physical")
	check(ber.is_alive(), "Recusa a Morrer: imortal segura o golpe seguinte")
	run.call(7.0)
	sim._deal_damage(wolf, ber, 999999, false, false, "physical")
	check(not ber.is_alive(), "Recusa a Morrer: só uma vez por minuto")
	sim.despawn(ber)
	sim.despawn(wolf)
	# Emboscada e troca só na cidade
	var ass: SimEntity = mk.call("assassin", 5, "ass_c_ambush", at)
	check(is_equal_approx(ClassTalentSystem.ambush_mult(ass), 2.0), "Emboscada: 2,0x saindo da furtividade")
	check(sim.tree_allocate(ass, "assassin_c_ass_c_venom") and not ass.tree.has("assassin_c_ass_c_ambush"), "trocar a escolha na cidade tira a outra")
	ass.position = Vector3(90, 0, 60)
	check(sim.tree_block_reason(ass, "assassin_c_ass_c_pistol_open") == "troque a escolha desta linha na cidade", "fora da cidade não troca")
	check(sim.tree_block_reason(ass, "assassin_c_ass_c_vanish").begins_with("requer nível"), "linha de nível alto bloqueada")
	sim.despawn(ass)
	_check_act2_talent_rows(gd, sim, cat, mk)

## Necromante nv 5 (pedido do jogador 2026-11-16): um talento de invocação, um de tempo das invocações, um de dano no tempo.
func _check_nec_row5(gd, sim, m: Dictionary, at: Vector3, mk: Callable) -> void:
	var row: Array = ClassTalentsCatalog.rows_of("necromancer")[0][1]
	var ids: Array = row.map(func(o): return o["id"])
	check(ids == ["nec_c_army", "nec_c_slow_dead", "nec_c_slow_rot"], "Necromante nv 5: Exército Eterno, Mortos sem Pressa, Podridão Lenta %s" % str(ids))
	check(row.filter(func(o): return o.has("summon_permanent") or o.has("summon_extra")).size() == 1, "Necromante nv 5: só um talento de invocação permanente/extra")
	check(Balance.NEC_TALENT_SUMMON_TIME == 2.0 and Balance.NEC_TALENT_DOT_TIME > 1.0 and Balance.NEC_TALENT_DOT_DPS > 1.0, "Necromante nv 5: números no Balance")
	# Mortos sem Pressa: cão de ossos dura o dobro; sem o talento, o normal
	var hs: SkillDef = gd.skills["nec_bone_hound"]
	var base_dur := float(hs.effects["summon"]["duration"])
	var mine := func(owner: SimEntity) -> Array: return m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == owner.id and o.is_alive())
	for pick in ["", "nec_c_slow_dead"]:
		var nec: SimEntity = mk.call("necromancer", 10, pick, at + Vector3(-4, 0, 6))
		sim._apply_skill(nec, hs, m)
		var dogs: Array = mine.call(nec)
		var want := base_dur * (Balance.NEC_TALENT_SUMMON_TIME if pick != "" else 1.0)
		check(dogs.size() > 0 and dogs.all(func(o): return absf(o.summon_expires - sim.time - want) < 0.01), "Mortos sem Pressa (%s): cães duram %.0f s" % [pick if pick != "" else "sem", want])
		for o in dogs:
			sim.despawn(o)
		sim.despawn(nec)
	# Podridão Lenta: Podridão dura e bate mais; sangramento e skill de outra classe não mudam
	var rot: SkillDef = gd.skills["nec_rot"]
	var got := {}
	for pick in ["", "nec_c_slow_rot"]:
		var nec: SimEntity = mk.call("necromancer", 10, pick, at + Vector3(-6, 0, 6))
		var dummy: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at + Vector3(-7, 0, 6))
		dummy.brain = null
		sim._apply_effects(nec, dummy, rot.effects, 0.0)
		var d: Array = dummy.debuffs.filter(func(x): return x.get("kind") == "dot" and int(x.get("src", -1)) == nec.id)
		got[pick] = [float(d[0]["remaining"]), float(d[0]["dps"]) / maxf(1.0, nec.stats.matk)] if d.size() == 1 else [0.0, 0.0]     # dps por MATK (bots com MATK diferente)
		sim._apply_effects(nec, dummy, {"dot": {"atk_pct": 50, "duration": 3.0}}, 0.0)
		var bl: Array = dummy.debuffs.filter(func(x): return x.get("bleed", false))
		check(bl.size() == 1 and is_equal_approx(float(bl[0]["remaining"]), 3.0), "Podridão Lenta (%s): sangramento não muda" % (pick if pick != "" else "sem"))
		sim.despawn(dummy)
		sim.despawn(nec)
	check(is_equal_approx(got[""][0], float(rot.effects["dot"]["duration"])), "Podridão sem o talento: %.1f s" % got[""][0])
	check(is_equal_approx(got["nec_c_slow_rot"][0], got[""][0] * Balance.NEC_TALENT_DOT_TIME) and is_equal_approx(got["nec_c_slow_rot"][1], got[""][1] * Balance.NEC_TALENT_DOT_DPS),
		"Podridão Lenta: %.1f s x%.2f e dps/MATK %.3f -> %.3f" % [got[""][0], Balance.NEC_TALENT_DOT_TIME, got[""][1], got["nec_c_slow_rot"][1]])
	# bots: o gancho sem skill citada vale para a build que tem skill do tipo (invocação com tempo / dano no tempo)
	var dead: Dictionary = row[1]
	var rot_o: Dictionary = row[2]
	var fits := func(o: Dictionary, bid: String) -> bool: return (gd.classes["necromancer"].build_by_id(bid)["skills"] as Array).any(func(r): return ClassTalentSystem._hook_fits(o, str(r)))
	check(fits.call(dead, "invocador") and not fits.call(dead, "pestilento") and not fits.call(dead, "ceifador"), "Mortos sem Pressa: serve ao Invocador (bot)")
	check(fits.call(rot_o, "pestilento") and not fits.call(rot_o, "invocador") and not fits.call(rot_o, "ceifador"), "Podridão Lenta: serve às Sombras (bot)")
	var rng_state: int = sim.rng.state
	ClassTalentSystem.bot_picks = true
	for bid in ["invocador", "pestilento"]:
		for i in 6:
			var b: SimEntity = mk.call("necromancer", 5, "", at + Vector3(-8, 0, 6))
			b.build_id = bid
			ClassTalentSystem.bot_pick(sim, b)
			var ids5: Array = ClassTalentSystem.picked(b).map(func(o): return o["id"])
			check(ids5.size() == 1 and (ids5[0] != "nec_c_slow_rot" if bid == "invocador" else ids5[0] == "nec_c_slow_rot"), "bot %s nv 5 escolhe %s" % [bid, str(ids5)])
			sim.despawn(b)
	ClassTalentSystem.bot_picks = false
	sim.rng.state = rng_state
	# save com um talento que saiu (Cão Fiel / Pacto Eterno): a escolha some e a teia fica
	var tr: Dictionary = gd.trees["necromancer"]
	var src: String = FileAccess.get_file_as_string("res://core/save_system.gd")
	check(src.contains('begins_with("%s_c_" % p.class_def.id) and not tr["nodes"].has(nid)'), "save: talento de classe que saiu só some (não zera a teia)")
	check(not tr["nodes"].has("necromancer_c_nec_c_hounds") and not tr["nodes"].has("necromancer_c_nec_c_pact"), "Cão Fiel e Pacto Eterno saíram da teia")

## Auditoria dos talentos aplicada (2026-11-16, opção A): trocas das linhas 5-30, gancho form_stats, raio de aura, bots e save.
## Bot escolhe talento de classe sem sorteio (decisão 2026-11-16): a opção que cita skill da build (mais cedo na lista
## de prioridade, melhor) > gancho genérico que serve > só números > de outra build. Mesma escolha com qualquer rng,
## e o rng da sim não anda. Cruzado: Aura de Cruzada no 20 e Solo Sagrado no 25 (antes sorteava Aura ou Juiz).
func _check_bot_talent_prefs(gd, sim) -> void:
	var at: Vector3 = sim.maps["city_aldara"]["def"].town_center
	var want := [["paladin", "cruzado", 20, "pal_c_aura_crusade"], ["paladin", "cruzado", 25, "pal_c_consecrate"],
		["paladin", "cruzado", 5, "pal_c_resolve"], ["paladin", "guardiao", 20, "pal_c_living_bastion"],
		["paladin", "templario", 10, "pal_c_flame_strike"], ["elementalist", "fogo", 5, "ele_c_blazing_ball"],
		["elementalist", "gelo", 5, "ele_c_cold_lance"], ["druid", "fera", 5, "dru_c_sharp_claws"],
		["necromancer", "ceifador", 10, "nec_c_death_blade"], ["ranger", "lanceiro", 10, "ran_c_light_spear"],
		["elementalist", "gelo", 10, "ele_c_frost"], ["elementalist", "raio", 10, "ele_c_storm"],
		["assassin", "laminas", 25, "ass_c_leech"], ["elementalist", "gelo", 25, "ele_c_shield"], ["elementalist", "fogo", 25, "ele_c_mana"]]
	# toda build x linha: a escolha serve à build (nota >= 1000 = não é de outra build nem gancho sem uso) quando alguma serve
	var weak: Array = []
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			for row in ClassTalentsCatalog.rows_of(cid):
				var o: Dictionary = ClassTalentSystem.bot_choice(row[1], b, b["skills"])
				var top: int = (row[1] as Array).map(func(x): return ClassTalentSystem.bot_score(x, b, b["skills"])).max()
				if ClassTalentSystem.bot_score(o, b, b["skills"]) != top or (top < 1000 and int(row[0]) < 35):
					weak.append("%s/%s %d" % [cid, b["id"], int(row[0])])
	check(weak.size() <= 1, "bot: toda build x linha tem escolha que serve (sem: %s)" % str(weak))
	# exceções por build x linha (ClassTalentsCatalog.BOT_PREFER): build de uma classe só, id que existe na linha, e é a escolha
	for bid in ClassTalentsCatalog.BOT_PREFER:
		var owners: Array = gd.classes.keys().filter(func(c): return not gd.classes[c].build_by_id(bid).is_empty())
		check(owners.size() == 1, "bot: BOT_PREFER %s é build de uma classe só (%s)" % [bid, str(owners)])
		if owners.size() != 1:
			continue
		var bd: Dictionary = gd.classes[owners[0]].build_by_id(bid)
		for lv in ClassTalentsCatalog.BOT_PREFER[bid]:
			var oid: String = ClassTalentsCatalog.BOT_PREFER[bid][lv]
			check(_row_of(owners[0], oid) == int(lv), "bot: BOT_PREFER %s nv %d = %s existe nessa linha (linha %d)" % [bid, int(lv), oid, _row_of(owners[0], oid)])
			for row in ClassTalentsCatalog.rows_of(owners[0]):
				if int(row[0]) == int(lv):
					check(ClassTalentSystem.bot_choice(row[1], bd, bd["skills"], int(lv))["id"] == oid, "bot: BOT_PREFER %s nv %d vence a nota" % [bid, int(lv)])
	check(ClassTalentsCatalog.BOT_PREFER.get("cruzado", {}).get(5, "") == "pal_c_resolve", "bot: Cruzado pega Determinação no nv 5 (solo x death_knight 3/40 -> 34/40)")
	var cruz: Dictionary = gd.classes["paladin"].build_by_id("cruzado")
	check(ClassTalentSystem.bot_score(ClassTalentsCatalog.rows_of("paladin")[0][1][0], cruz, cruz["skills"]) < 1000, "bot: Voto do Escudo não serve ao Cruzado (sem escudo)")
	var rng_state: int = sim.rng.state
	ClassTalentSystem.bot_picks = true
	for w in want:
		var got := {}
		var moved := 0
		for seed in [11, 222, 3333, 44444, 5, 66, 777, 8888]:       # sementes diferentes: o sorteio antigo variava aqui
			var e: SimEntity = sim.spawn_bot(gd.classes[w[0]], "BT", "city_aldara", at + Vector3(-5, 0, 5), int(w[2]))
			e.brain = null
			e.build_id = w[1]
			for nid in e.tree.keys():
				if gd.trees[w[0]]["nodes"][nid]["kind"] == "pick":
					e.tree.erase(nid)
			sim.rng.state = seed
			ClassTalentSystem.bot_pick(sim, e)
			if sim.rng.state != seed:
				moved += 1
			for o in ClassTalentSystem.picked(e):
				if _row_of(w[0], o["id"]) == int(w[2]):
					got[o["id"]] = true
			sim.despawn(e)
		check(got.keys() == [w[3]], "bot %s/%s nv %d escolhe sempre %s (%s)" % [w[0], w[1], w[2], w[3], str(got.keys())])
		check(moved == 0, "bot %s/%s: escolher talento não sorteia (rng andou %d vezes)" % [w[0], w[1], moved])
	ClassTalentSystem.bot_picks = false
	sim.rng.state = rng_state

## Linha (nível) de uma opção de talento de classe, ou -1.
func _row_of(cid: String, oid: String) -> int:
	for r in ClassTalentsCatalog.rows_of(cid):
		for o in r[1]:
			if o["id"] == oid:
				return int(r[0])
	return -1

func _check_talents_applied(gd, sim, m: Dictionary, at: Vector3, mk: Callable) -> void:
	var row_ids := func(cid: String, lv: int) -> Array:
		for r in ClassTalentsCatalog.rows_of(cid):
			if int(r[0]) == lv:
				return (r[1] as Array).map(func(o): return o["id"])
		return []
	var want := {
		["elementalist", 5]: ["ele_c_blazing_ball", "ele_c_live_spark", "ele_c_cold_lance"],
		["druid", 5]: ["dru_c_crescent", "dru_c_sharp_claws", "dru_c_bark"],
		["druid", 20]: ["dru_c_moon_howl", "dru_c_roots", "dru_c_wolves"],
		["necromancer", 15]: ["nec_c_thirsty_scythe", "nec_c_lich", "nec_c_drain"],
		["necromancer", 20]: ["nec_c_spreading_curse", "nec_c_phantom", "nec_c_reap"],
