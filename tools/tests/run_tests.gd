	for i in range(40):
		var id: String = sim.pick_legendary(e, b.level)
		if id != "" and gd.items.has(id):
			tiers[gd.items[id].level_req] = true
	check(tiers.keys() == [Balance.LEGENDARY_LEVELS[0]], "Presa-Rachada dá o 1º conjunto (níveis %s)" % str(tiers.keys()))
	var boss: SimEntity = sim.spawn_monster(b, "city_aldara", Vector3(80, 0, 14))
	var boar: SimEntity = sim.spawn_monster(gd.monsters["boar"], "city_aldara", Vector3(72, 0, 6))
	var king: SimEntity = sim.spawn_monster(gd.monsters["boar_king"], "city_aldara", Vector3(-84, 0, 24))
	check(is_equal_approx(sim.legendary_chance(boss), Balance.LEGENDARY_DROP_CHANCE_BOSS), "chefe: chance de chefe")
	check(is_equal_approx(sim.legendary_chance(boar), Balance.LEGENDARY_START_MAP_CHANCE), "Javali no Vale: chance maior do 1º conjunto")
	check(is_equal_approx(sim.legendary_chance(king), Balance.LEGENDARY_DROP_CHANCE_BOSS), "Rei Javali segue chance de chefe")
	var wolf_far: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "field_forest", Vector3(0, 0, 0)) if sim.maps.has("field_forest") else null
	if wolf_far:
		check(is_equal_approx(sim.legendary_chance(wolf_far), Balance.LEGENDARY_DROP_CHANCE), "fora do Vale: chance normal")
		sim.despawn(wolf_far)
	for x in [boss, boar, king, e]:
		sim.despawn(x)

## /party (bots do mapa convidam um por vez), depósito (guardar/tirar, perto do NPC, salva) e a cor do monstro de modelo emprestado.
func _check_party_seek_storage(gd, sim, save) -> void:
	var town: Vector3 = sim.maps["city_aldara"]["def"].town_center
	var me: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Procura", "city_aldara", town + Vector3(2, 0, 2), 10)
	me.brain = null
	var helpers: Array = []
	for i in range(3):
		var b: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Ajuda%d" % i, "city_aldara", town + Vector3(3 + i, 0, 3), 10)
		helpers.append(b)
	var n: int = sim.party_seek_start(me)
	check(n >= 2 and n <= Balance.PARTY_SEEK_MAX, "/party: bots do mapa se oferecem (%d)" % n)
	check(sim.party_seek_start(me) == -2, "/party tem tempo de espera")
	for i in range(30):
		sim._update_invites()
		sim.time += 0.1
		if sim.invites.has(me.id):
			sim.invites[me.id]["decide_at"] = sim.time + 100.0     # quem decide é o teste (aqui ele é um bot)
	check(sim.invites.has(me.id), "/party: chega um convite")
	var first: int = sim.invites[me.id]["from"]
	sim.party_decline(me)
	for i in range(15):
		sim._update_invites()
		sim.time += 0.1
		if sim.invites.has(me.id):
			sim.invites[me.id]["decide_at"] = sim.time + 100.0
	check(sim.invites.has(me.id) and sim.invites[me.id]["from"] != first, "/party: recusou → o próximo convida")
	sim.party_accept(me)
	check(me.party_id >= 0, "/party: aceitar entra no grupo")
	sim.party_leave(me)
	for b in helpers:
		if b.party_id >= 0:
			sim.party_leave(b)
		sim.despawn(b)
	# depósito
	var st: Dictionary = {}
	for npc in gd.maps["city_aldara"].npcs:
		if npc["role"] == "storage":
			st = npc
	check(not st.is_empty(), "Aldara tem o Guarda-volumes")
	if not st.is_empty():
		check(not sim._point_in_solid(st["pos"], sim.maps["city_aldara"]), "Guarda-volumes em chão livre")
		me.position = st["pos"] + Vector3(0, 0, 1.5)
	me.inventory = {"iron_ore": 5}
	me.storage = {}
	check(sim.storage_deposit(me, "iron_ore", 3) and int(me.inventory.get("iron_ore", 0)) == 2 and int(me.storage.get("iron_ore", 0)) == 3, "depósito guarda")
	check(not sim.storage_deposit(me, "iron_ore", 5), "não guarda mais do que tem")
	check(sim.storage_withdraw(me, "iron_ore", 3) and not me.storage.has("iron_ore") and int(me.inventory["iron_ore"]) == 5, "depósito devolve")
	me.position = town + Vector3(20, 0, 20)
	check(not sim.storage_deposit(me, "iron_ore", 1), "longe do NPC não guarda")
	me.storage = {"wolf_pelt": 4}
	save.save_player(me)
	var d: Dictionary = save.load_data()
	check(int(d.get("storage", {}).get("wolf_pelt", 0)) == 4, "save guarda o depósito")
	save.delete_slot(TEST_SLOT)
	sim.despawn(me)
	# cor: Slime Azul fica azul; o Slime (dono do modelo) não muda; olho não muda
	var green := Color("adf1b8")
	var blue := EntityView.monster_tint(gd.monsters["slime_blue"], green, "m_slime_mob_slime")
	check(blue.b > blue.g and blue.b > blue.r, "Slime Azul é azul (%s)" % blue.to_html(false))
	check(EntityView.monster_tint(gd.monsters["slime"], green, "m_slime_mob_slime").is_equal_approx(green), "Slime comum mantém a cor do modelo")
	check(EntityView.monster_tint(gd.monsters["slime_blue"], Color("504559"), "m_eye").is_equal_approx(Color("504559")), "olho não muda de cor")

## Grupo segue o líder pelo portal e reaparece ao lado dele se ficar preso; Rei surge após muitos abates com lendário garantido.
func _check_party_follow_elite(gd, sim) -> void:
	var lead: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Lider", "city_aldara", Vector3(60, 0, 10), 8)
	lead.brain = null
	var mate: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Ajudante", "city_aldara", Vector3(63, 0, 10), 8)
	var far: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Longe", "field_forest" if sim.maps.has("field_forest") else "city_aldara", Vector3(0, 0, 0), 8)
	sim.party_invite(lead, mate)
	sim.party_accept(mate)
	sim.party_invite(lead, far)
	sim.party_accept(far)
	var dg := ""
	for mid in gd.maps:
		if gd.maps[mid].parent_map == "city_aldara" and not gd.maps[mid].interior:     # casa: o grupo espera na porta (_check_bot_unstuck)
			dg = mid
	check(dg != "", "há dungeon saindo do Vale")
	if dg != "":
		sim._pending_map_changes.append({"e": lead, "map": dg, "pos": Vector3.ZERO})
		sim._process_map_changes()
		check(lead.map_id == dg and mate.map_id == dg, "bot do grupo passa pelo portal com o líder")
		check(mate.position.distance_to(lead.position) < 4.0, "e chega ao lado dele")
		if far.map_id != dg:
			for i in range(int(Balance.PARTY_CATCHUP_TIME / 0.5) + 2):
				sim._party_catchup(0.5)
			sim._process_map_changes()
			check(far.map_id == dg, "bot preso em outro mapa reaparece ao lado do líder")
	for x in [mate, far]:
		sim.party_leave(x)
	for x in [lead, mate, far]:
		sim.despawn(x)
	# jogador que aceita convite de bot passa a liderar (os bots seguem o jogador)
	var pl: SimEntity = sim.player
	if pl and pl.party_id >= 0:
		sim.party_leave(pl)
	if pl:
		var host: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Anfitriao", pl.map_id, pl.position + Vector3(2, 0, 0), pl.level)
		var other: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Outro", pl.map_id, pl.position + Vector3(3, 0, 0), pl.level)
		sim.party_invite(host, other)
		sim.party_accept(other)
		sim.invites.erase(pl.id)
		sim.party_invite(host, pl)
		sim.party_accept(pl)
		check(sim.party_leader(other) == pl, "convite de bot aceito: o jogador lidera e os bots o seguem")
		for x in [other, host, pl]:
			if x.party_id >= 0:
				sim.party_leave(x)
		sim.despawn(host)
		sim.despawn(other)
	# Rei: 40 abates de slime no mesmo mapa
	var m: Dictionary = sim.maps["city_aldara"]
	var hunter: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Cacador", "city_aldara", Vector3(10, 0, 60), 6)
	hunter.brain = null
	m["kills"].erase("slime")
	m["elites"].erase("slime")
	var king: SimEntity = null
	for i in range(Balance.ELITE_KILLS):
		var s: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(10, 0, 62))
		s.brain = null
		s.damage_by = {hunter.id: 999.0}
		sim._on_monster_killed(s, hunter)
		sim.despawn(s)
	var kid: int = int(m["elites"].get("slime", -1))
	king = sim.entities.get(kid)
	check(king != null and king.monster_def.elite_of == "slime", "%d abates de slime fazem surgir o Rei Slime" % Balance.ELITE_KILLS)
	if king:
		var base: MonsterDef = gd.monsters["slime"]
		check(is_equal_approx(king.monster_def.hp, base.hp * Balance.ELITE_HP_MULT) and king.monster_def.scale > base.scale, "Rei: 5x vida e maior")
		check(is_equal_approx(sim.legendary_chance(king), 1.0), "Rei: lendário garantido")
		var got := ""
		for t in range(5):
			got = sim.roll_legendary(hunter, king)
			if got != "":
				break
		check(got == "legend_coin", "Rei Slime solta Moeda Lendária (%s)" % got)
		sim.despawn(king)
	sim.despawn(hunter)

## Volta à cidade (G) é conjuração: em combate começa e chega; levar dano ou ser atordoado interrompe (com aviso),
## barreira que segura o golpe inteiro não interrompe; começar andando não vale; bot (comando da sim) também volta.
func _check_recall_cast(gd, sim) -> void:
	var town: String = gd.town_map_id()
	var m: Dictionary = sim.maps["city_aldara"]
	var e: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Lareira", "city_aldara", Vector3(70, 0, 10), 10)     # nível da faixa de Aldara: a casa do bot é a cidade
	e.brain = null
	var mob: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(73, 0, 10))
	mob.brain = null
	var go := InputCommand.new()
	go.recall = true
	var idle := InputCommand.new()
	var phases: Array = []
	var on_phase := func(id: int, ph: String): phases.append(ph if id == e.id else "")
	Events.recall_cast.connect(on_phase)
	check(Balance.RECALL_TIME >= 3.0 and Balance.RECALL_TIME <= 4.0, "volta: conjuração de 3-4 s (%.1f)" % Balance.RECALL_TIME)
	# em combate: começa; levar dano interrompe
	e.combat_timer = 5.0
	sim._apply_command(e, go, m, 0.05)
	check(e.recall_left > 0.0 and phases.has("start"), "volta: começa em combate")
	check(sim.recall_progress(e) >= 0.0 and sim.recall_progress(e) < 0.1, "volta: progresso começa perto de 0")
	sim._apply_command(e, idle, m, 1.0)
	check(sim.recall_progress(e) > 0.2, "volta: progresso sobe (%.2f)" % sim.recall_progress(e))
	sim._deal_damage(mob, e, 30, false, false, "physical")
	check(is_equal_approx(e.recall_left, 0.0) and phases.has("interrupted"), "volta: levar dano interrompe")
	# barreira que segura tudo: não interrompe
	sim._apply_command(e, go, m, 0.05)
	e.shield_hp = 500.0
	sim._deal_damage(mob, e, 30, false, false, "physical")
	check(e.recall_left > 0.0, "volta: dano todo na barreira não interrompe")
	e.shield_hp = 0.0
	# atordoado: interrompe
	e.set_state(SimEntity.State.STUNNED, 1.0)
	sim._apply_command(e, idle, m, 0.05)
	check(is_equal_approx(e.recall_left, 0.0), "volta: atordoado interrompe")
	e.set_state(SimEntity.State.IDLE)
	# começar correndo não vale; G de novo cancela
	var run_go := InputCommand.new()
	run_go.recall = true
	run_go.move = Vector2(1, 0)
	sim._apply_command(e, run_go, m, 0.05)
	check(is_equal_approx(e.recall_left, 0.0), "volta: não começa correndo")
	sim._apply_command(e, go, m, 0.05)
	sim._apply_command(e, go, m, 0.05)
	check(is_equal_approx(e.recall_left, 0.0) and phases.has("cancel"), "volta: G de novo cancela")
	# montado: desce e conjura
	e.mounted = true
	sim._apply_command(e, go, m, 0.05)
	check(e.recall_left > 0.0 and not e.mounted, "volta: montado desce e conjura")
	# completa em combate (bot pelo comando da sim) e chega na cidade
	e.combat_timer = 5.0
	for i in range(int(Balance.RECALL_TIME / 0.1) + 2):
		sim._apply_command(e, idle, m, 0.1)
	sim._process_map_changes()
	check(phases.has("done") and e.map_id == town and e.position.distance_to(gd.maps[town].spawn_point) < 0.5, "volta: bot conjura em combate e chega na cidade")
	Events.recall_cast.disconnect(on_phase)
	sim.despawn(mob)
	sim.despawn(e)

## F1-F3 têm recarga própria: poção de vida no F1 não trava a de mana no F2.
func _check_potion_slot_cooldowns(gd, sim) -> void:
	var e: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Frascos", "city_aldara", Vector3(66, 0, 12), 10)
	e.brain = null
	e.add_item("potion_hp_s", 3)
	e.add_item("potion_mp_s", 3)
	sim.set_potion_slot(e, 0, "potion_hp_s"); sim.set_potion_slot(e, 1, "potion_mp_s"); sim.set_potion_slot(e, 2, "")
	e.potion_cd = 0.0
	e.hp = e.stats.max_hp * 0.5
	e.mp = e.stats.max_mp * 0.2
	check(sim.use_potion(e, 0), "F1: bebe a de vida")
	check(e.potion_cds[0] > 0.0 and is_equal_approx(e.potion_cds[1], 0.0), "F1 entra em recarga, F2 não")
	check(sim.use_potion(e, 1), "F2: de mana mesmo com F1 em recarga")
	check(not sim.use_potion(e, 0), "F1 em recarga não bebe de novo")
	check(e.potion_cd == e.potion_cds[0], "potion_cd (bots) = recarga do F1")
	for i in range(int(maxf(gd.items["potion_hp_s"].consume_cooldown, gd.items["potion_mp_s"].consume_cooldown) * 20) + 4):
		sim._update_entity(e, sim.maps["city_aldara"], 0.05)
	check(e.potion_cds[0] <= 0.0 and e.potion_cds[1] <= 0.0, "recargas dos F acabam sozinhas")
	e.potion_cd = 99.0
	check(e.potion_cds.all(func(c): return c == 99.0), "escrever potion_cd trava os três")
	e.potion_cd = 0.0
	sim.despawn(e)

## Barreira (vida temporária) nas barras: texto "(+N)" e faixa depois da vida, ou no fim da barra se passar do máximo.
func _check_shield_bar(gd, sim) -> void:
	check(ShieldOverlay.hp_text(540, 800, 120) == "540 / 800 (+120)", "barra: texto com barreira")
	check(ShieldOverlay.hp_text(540, 800, 0) == "540 / 800", "barra: texto sem barreira")
	var a := ShieldOverlay.span_of(400, 200, 800)
	check(is_equal_approx(a.x, 0.5) and is_equal_approx(a.y, 0.75) and a.z == 0.0, "barra: barreira logo depois da vida")
	var b := ShieldOverlay.span_of(700, 200, 800)
	check(is_equal_approx(b.x, 0.75) and is_equal_approx(b.y, 1.0) and b.z == 1.0, "barra: passou do máximo encosta no fim")
	check(ShieldOverlay.span_of(700, 0, 800) == Vector3.ZERO, "barra: sem barreira, sem faixa")
	# a Armadura de Gelo dá barreira, e é ela que a barra lê
	var e: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Gelo", "city_aldara", Vector3(64, 0, 8), 20)
	e.brain = null
	if gd.skills.has("ele_frost_armor"):
		sim._apply_effects(e, e, gd.skills["ele_frost_armor"].effects, 1.0)
		check(e.shield_hp > 0.0, "Armadura de Gelo põe barreira (%d)" % int(e.shield_hp))
		check(ShieldOverlay.hp_text(e.hp, e.stats.max_hp, e.shield_hp).ends_with("(+%d)" % int(e.shield_hp)), "barra do jogador mostra a barreira da Armadura de Gelo")
	sim.despawn(e)

## G volta à cidade: conjuração de RECALL_TIME s (vale em combate); andar cancela. Lendário é pessoal (cada membro do grupo rola o seu).
func _check_recall_and_personal_loot(gd, sim) -> void:
	var town: String = gd.town_map_id()
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Volta", "city_aldara", Vector3(70, 0, 10), 8)
	e.brain = null
	var go := InputCommand.new()
	go.recall = true
	var idle := InputCommand.new()
	sim._update_recall(e, go, go, 0.1)
	check(e.recall_left > 0.0, "G começa a volta à cidade")
	var walk := InputCommand.new()
	walk.move = Vector2(1, 0)
	sim._update_recall(e, walk, walk, 0.1)
	check(is_equal_approx(e.recall_left, 0.0), "andar cancela a volta")
	sim._update_recall(e, go, go, 0.1)
	for i in range(int(Balance.RECALL_TIME / 0.1) + 2):
		sim._update_recall(e, idle, idle, 0.1)
	sim._process_map_changes()
	check(e.map_id == town and e.position.distance_to(gd.maps[town].spawn_point) < 0.5, "parado 3 s: chega na cidade")
	e.position = Vector3(70, 0, 10)
	e.combat_timer = 3.0
	sim._update_recall(e, go, go, 0.1)
	check(e.recall_left > 0.0, "em combate também começa a volta (o dano é que interrompe)")
	e.recall_left = 0.0
	e.combat_timer = 0.0
	sim.despawn(e)
	# lendário pessoal: chefe com dois do grupo → cada um rola o seu
	var a: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Um", "city_aldara", Vector3(80, 0, 14), 6)
	var b: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Dois", "city_aldara", Vector3(81, 0, 14), 6)
	sim.party_invite(a, b)
	sim.party_accept(b)
	var king: SimEntity = sim.spawn_monster(sim.elite_def(gd.monsters["boar"]), "city_aldara", Vector3(82, 0, 14))
	king.brain = null
	king.damage_by = {a.id: 500.0, b.id: 400.0}
	var m: Dictionary = sim.maps["city_aldara"]
	var before: int = m["loot"].size()
	sim._on_monster_killed(king, a)
	var owners := {}
	for l in m["loot"].slice(before):
		if l["item"] == "legend_coin":
			owners[l["owner"]] = int(l["count"])
	check(owners.has(a.id) and owners.has(b.id), "Rei: cada membro do grupo ganha as suas moedas lendárias (%d donos)" % owners.size())
	check(int(owners.get(a.id, 0)) == Balance.LEGENDARY_COINS_BOSS, "chefe/Rei: %d moedas" % Balance.LEGENDARY_COINS_BOSS)
	# Relicária: troca moedas por peça da classe, preço pelo tier
	var npc: Dictionary = {}
	for n in gd.maps["city_aldara"].npcs:
		if n["role"] == "relic":
			npc = n
	check(not npc.is_empty() and not sim._point_in_solid(npc["pos"], m), "Aldara tem a Relicária em chão livre")
	var buyer: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Compra", "city_aldara", npc.get("pos", Vector3.ZERO) + Vector3(0, 0, 1.5), 12)
	buyer.brain = null
	var offer: Array = sim.relic_offer(buyer)
	var t5: Array = offer.filter(func(i): return gd.items[i].level_req == 5)
	var t10: Array = offer.filter(func(i): return gd.items[i].level_req == 10)
	check(t5.size() >= 6 and t10.size() >= 6, "Relicária oferece peças da classe por nível (%d no 5, %d no 10)" % [t5.size(), t10.size()])
	check(offer.any(func(i): return gd.items[i].weapon_type == "shield"), "paladino também troca escudos nomeados")
	check(sim.relic_cost(gd.items[t5[0]]) == 1 and sim.relic_cost(gd.items[t10[0]]) == 2, "nível 5 = 1 moeda, nível 10 = 2")
	buyer.inventory = {"legend_coin": 2}
	check(sim.relic_exchange(buyer, t10[0]) and buyer.has_item(t10[0]) and not buyer.inventory.has("legend_coin"), "troca 2 moedas por peça nível 10")
	buyer.add_item("legend_coin", 5)
	var t15: Array = offer.filter(func(i): return gd.items[i].level_req == 15)
	check(sim.relic_block_reason(buyer, t15[0]).begins_with("requer nível"), "peça acima do nível: não troca")
	buyer.position += Vector3(30, 0, 0)
	check(sim.relic_block_reason(buyer, t5[0]) == "fale com a Relicária", "longe da Relicária: não troca")
	# conjunto de uma vez: só as peças de armadura que faltam (vestida, bolsa ou depósito, +N conta), moedas × peças
	buyer.position -= Vector3(30, 0, 0)
	var sid10: String = gd.set_id_for("paladin", gd.classes["paladin"].builds[0]["id"], 10)
	var sd10: SetDef = gd.sets[sid10]
	buyer.inventory = {sd10.armor[0]: 1, "legend_coin": 20}
	buyer.storage = {GameData.plus_item(gd.items[sd10.armor[1]], 3).id: 1}
	var miss: Array = sim.relic_set_missing(buyer, sid10)
	check(miss.size() == sd10.armor.size() - 2 and not (sd10.armor[0] in miss) and not (sd10.armor[1] in miss), "conjunto: faltam %d peças (bolsa e depósito +3 contam)" % miss.size())
	var got: int = sim.relic_exchange_set(buyer, sid10)
	check(got == miss.size() and int(buyer.inventory.get("legend_coin", 0)) == 20 - 2 * got and sd10.armor.all(func(pid): return sim.owns_item(buyer, pid)), "troca o que falta por 2 moedas cada (%d peças)" % got)
	check(sim.relic_set_block_reason(buyer, sid10) == "você já tem as peças do conjunto" and sim.relic_exchange_set(buyer, sid10) == 0, "conjunto completo: não troca de novo")
	check(not sd10.pieces.any(func(pid): return not (pid in sd10.armor) and buyer.has_item(pid)), "a arma do conjunto não entra na troca do conjunto")
	var sid15: String = gd.set_id_for("paladin", gd.classes["paladin"].builds[0]["id"], 15)
	check(sim.relic_set_block_reason(buyer, sid15).begins_with("requer nível"), "conjunto acima do nível: não troca")
	buyer.inventory = {"legend_coin": 3}
	check(sim.relic_exchange_set(buyer, gd.set_id_for("paladin", gd.classes["paladin"].builds[1]["id"], 10)) == 0, "conjunto sem moedas para todas: não troca nada")
	check(int(buyer.inventory.get("legend_coin", 0)) == 3, "falha na troca do conjunto não gasta moeda")
	var wear_build: String = gd.classes["paladin"].builds[2]["id"]
	buyer.build_id = ""
	buyer.tree = {}
	buyer.equipment[ItemDef.Slot.HEAD] = gd.items[gd.sets[gd.set_id_for("paladin", wear_build, 5)].armor[0]]
	check(sim.relic_default_build(buyer) == wear_build, "Relicária abre na build do conjunto que você veste")
	buyer.equipment.erase(ItemDef.Slot.HEAD)
	buyer.storage = {}
	buyer.inventory = {"legend_coin": 3, "slime_gel": 2}
	BotBrain.new()._sell_materials(buyer)
	check(int(buyer.inventory.get("legend_coin", 0)) == 3 and not buyer.inventory.has("slime_gel"), "bot vende material mas guarda a moeda")
	sim.despawn(buyer)
	sim.party_leave(b)
	for x in [king, a, b]:
		sim.despawn(x)

## Grupo: o jogador recebe saque pessoal a cada abate dividido, mesmo sem bater; item dos outros só aparece quando fica livre.
func _check_party_personal_loot(gd, sim) -> void:
	var pl: SimEntity = sim.player
	if pl == null:
		return
	if pl.party_id >= 0:
		sim.party_leave(pl)
	var keep_pos := pl.position
	var bot: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Batedor", pl.map_id, pl.position + Vector3(2, 0, 0), pl.level)
	bot.brain = null
	sim.party_invite(bot, pl)
	sim.party_accept(pl)
	var m: Dictionary = sim.maps[pl.map_id]
	var got := 0
	for i in range(20):
		var mob: SimEntity = sim.spawn_monster(gd.monsters["boar"], pl.map_id, pl.position + Vector3(3, 0, 0))
		mob.brain = null
		mob.damage_by = {bot.id: 999.0}            # só o bot bateu (o jogador é o suporte)
		var before: int = m["loot"].size()
		sim._on_monster_killed(mob, bot)
		for l in m["loot"].slice(before):
			if int(l["owner"]) == pl.id:
				got += 1
		sim.despawn(mob)
	check(got >= 10, "grupo: suporte (sem bater) recebe saque pessoal (%d itens em 20 abates)" % got)
	var other := {"owner": bot.id, "free_at": sim.time + 10.0}
	check(not sim.loot_visible_to(pl, other) and sim.loot_visible_to(pl, {"owner": pl.id, "free_at": sim.time + 10.0}), "item do bot fica escondido; o seu aparece")
	other["free_at"] = sim.time - 1.0
	check(sim.loot_visible_to(pl, other), "item do bot que ficou livre aparece")
	for l in m["loot"].duplicate():
		if int(l["owner"]) in [pl.id, bot.id]:
			m["loot"].erase(l)
	sim.party_leave(pl)
	sim.despawn(bot)
	pl.position = keep_pos

## Todo equipamento tem descrição na dica (a escrita ou a montada dos dados: peça, quem usa, o que favorece).
func _check_item_descriptions(gd) -> void:
	var empty: Array = []
	for iid in gd.items:
		var it: ItemDef = gd.items[iid]
		if it.is_equipment() and UiKit.item_summary(it).length() < 8:
			empty.append(iid)
	check(empty.is_empty(), "todo equipamento tem descrição (%d sem: %s)" % [empty.size(), str(empty.slice(0, 4))])
	check(UiKit.item_tooltip(gd.items["sword_rusty"]).contains("Favorece"), "dica do equipamento diz o que os atributos favorecem")

## Arma lendária: efeito próprio pelo papel (eco / retaliação / égide); atributos de toda build servem a ela.
func _check_legend_weapons_and_attrs(gd, sim) -> void:
	var useful := {}
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var mine := {"VIT": true}          # VIT (vida) serve a qualquer um
		for b in cls.builds:
			mine[b["attr"]] = true
			mine[b["attr2"]] = true
			var caster: bool = b["role"] in ["caster", "healer"] or b["stat"] in ["matk_pct", "heal_pct"]
			check(not (caster and (b["attr"] == "AGI" or b["attr2"] == "AGI")), "%s/%s: build mágica sem AGI" % [cid, b["id"]])
			check(not (caster and (b["attr"] == "FOR" or b["attr2"] == "FOR")) or b["role"] == "tank", "%s/%s: build mágica sem FOR" % [cid, b["id"]])
		useful[cid] = mine
		for iid in ItemsCatalog.starter_ids(cid):
			if gd.items.has(iid):
				for a in gd.items[iid].attributes:
					check(mine.has(a), "%s: conjunto inicial só dá atributo que a classe usa (%s)" % [iid, a])
	var bad: Array = []
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		for iid in sd.pieces + sd.alt_pieces:
			for a in gd.items[iid].attributes:
				if not useful[sd.class_id].has(a):
					bad.append("%s:%s" % [iid, a])
		for k in sd.bonuses:
			for a in sd.bonuses[k].get("attrs", {}):
				if not useful[sd.class_id].has(a):
					bad.append("%s bônus %s:%s" % [sid, k, a])
	check(bad.is_empty(), "conjuntos lendários só dão atributos que a classe usa (%s)" % str(bad.slice(0, 4)))
	for d in GearCatalog.SHIELDS:            # escudos nomeados: atributos de quem pode usar (pela afinidade)
		var sh: ItemDef = gd.items["shield_" + d[0]]
		for cid in ["paladin", "bishop"]:
			if GearCatalog.shield_fits(sh.id, cid):
				for a in sh.attributes:
					check(useful[cid].has(a), "%s serve ao %s: atributo %s" % [sh.id, cid, a])
	# efeitos por papel
	var role_of := {}
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			role_of["%s_%s" % [cid, b["id"]]] = b["role"]
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.is_hybrid() or sd.is_apex():
			continue          # híbrido/Ápice: as armas são peças alternativas (_check_hybrid_sets/_check_apex_sets)
		var w: ItemDef = gd.items.get(sd.pieces.filter(func(x): return x.ends_with("_weapon"))[0]) if sd.pieces.any(func(x): return x.ends_with("_weapon")) else null
		check(w != null and not w.legend_effect.is_empty(), "%s: arma lendária tem efeito próprio" % sid)
		if w:
			var bid: String = sd.id.trim_prefix("set_%s_" % sd.class_id).rsplit("_", true, 1)[0]
			var own: Dictionary = gd.classes[sd.class_id].build_by_id(bid).get("legend", {})
			check(not own.is_empty() and w.legend_effect["kind"] == own["kind"], "%s: efeito próprio da build %s" % [sid, bid])
			check(UiKit.legend_effect_text(w.legend_effect).length() > 12, "%s: texto do efeito" % sid)
	var names := {}
	var n_builds := 0
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			n_builds += 1
			var leg: Dictionary = b.get("legend", {})
			names[leg.get("name", "")] = true
			var sk: String = leg.get("skill", "")
			check(sk == "" or gd.skills.has(sk), "%s: skill do efeito existe (%s)" % [b["id"], sk])
	check(names.size() == n_builds and not names.has(""), "cada build tem um efeito lendário com nome próprio (%d)" % names.size())
	# eco: golpe direto bate de novo (forçando a chance)
	var a: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Eco", "city_aldara", Vector3(-46, 0, -46), 20)
	a.brain = null
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(-46, 0, -44.5))
	mob.brain = null
	a.stats.legend = {"kind": "echo"}
	a.stats.echo_chance = 100.0
	a.stats.echo_pct = 50.0
	_dmg_kinds.clear()
	Events.damage_dealt.connect(_note_damage)
	sim._deal_damage(a, mob, 100, false, false, "physical")
	check(_dmg_kinds.has("echo") and _dmg_kinds.count("echo") == 1, "Eco: o golpe bate de novo uma vez (%s)" % str(_dmg_kinds))
	# retaliação: tanque devolve parte do corpo a corpo
	a.stats.echo_chance = 0.0
	a.stats.thorns_pct = 20.0
	# o golpe precisa pegar: o equipamento sorteado do bot pode dar esquiva (> 0) e a rolagem usa o sim.rng
	# compartilhado (estado depende dos checks anteriores); sem esquiva, invulnerável, aparo nem barreira
	a.stats.evasion = 0.0
	a.iframe_left = 0.0
	a.parry_left = 0.0
	a.is_blocking = false
	a.shield_hp = 0.0
	a.hp = a.stats.max_hp
	a.position = Vector3(-46, 0, -46)
	mob.position = Vector3(-46, 0, -44.5)
	_dmg_kinds.clear()
	var mhp: float = mob.hp
	sim._deal_damage(mob, a, 100, false, false, "physical")
	check(_dmg_kinds.has("thorns") and mob.hp < mhp, "Retaliação: quem bate corpo a corpo leva parte de volta (%s, %d/%d)" % [str(_dmg_kinds), int(mob.hp), int(mhp)])
	Events.damage_dealt.disconnect(_note_damage)
	# Elementalista: fogo lança Bola de Fogo no básico; gelo lança Nova ao levar golpe (uma vez a cada 20 s); raio salta
	var el: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Ele2", "city_aldara", Vector3(-46, 0, -46), 20)
	el.brain = null
	el.build_id = "gelo"                   # Brasa Viva numa build que não é a de fogo: lança à parte (na de fogo soma na assinatura)
	var mob2: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(-44.5, 0, -44.5))
	mob2.brain = null
	var basic: SkillDef = el.basic_skill
	var m: Dictionary = sim.maps["city_aldara"]
	el.stats.legend = {"kind": "cast_on_basic", "skill": "ele_fireball", "chance": 100.0}
	var before: int = m["projectiles"].size()
	sim._legend_on_hit(el, mob, basic, 50)
	check(m["projectiles"].size() > before, "Brasa Viva (fogo): o básico lança uma Bola de Fogo")
	el.leg_cast_at = 0.0
	var before_sk: int = m["projectiles"].size()
	sim._legend_on_hit(el, mob, gd.skills["ele_ice_lance"], 50)
	check(m["projectiles"].size() > before_sk, "Brasa Viva também dispara ao acertar com habilidade")
	var after_sk: int = m["projectiles"].size()
	sim._legend_on_hit(el, mob, gd.skills["ele_ice_lance"], 50)
	check(m["projectiles"].size() == after_sk, "Brasa Viva: no máximo uma por segundo")
	sim._legend_on_hit(el, mob, gd.skills["ele_fireball"], 50)
	check(m["projectiles"].size() == after_sk, "a Bola de Fogo da arma não lança outra")
	el.leg_cast_at = 0.0
	el.stats.legend = {"kind": "cast_when_hit", "skill": "ele_frost_nova", "icd": 20.0}
	el.legend_ready_at = 0.0
	var nhp: float = mob.hp
	sim._legend_weapon(mob, el, 30, "physical")
	check(mob.hp < nhp and mob.debuffs.any(func(d): return d.get("kind") in ["slow", "root"]), "Coração de Gelo: apanhou, solta a Nova de Gelo em volta")
	nhp = mob.hp
	sim._legend_weapon(mob, el, 30, "physical")
	check(is_equal_approx(mob.hp, nhp), "Coração de Gelo: não repete antes de 20 s")
	el.stats.legend = {"kind": "chain", "targets": 1, "pct": 60.0}
	var hp2: float = mob2.hp
	sim._legend_on_hit(el, mob, basic, 100)
	check(mob2.hp < hp2, "Arco Voltaico (raio): o básico salta para outro alvo")
	sim.despawn(mob2)
	sim.despawn(el)
	# égide: a cura vira barreira
	a.stats.thorns_pct = 0.0
	a.stats.ward_pct = 20.0
	a.hp = a.stats.max_hp * 0.5
	a.shield_hp = 0.0
	sim._heal(a, a, 100)
	check(a.shield_hp > 0.0 and a.buffs.any(func(x): return x.get("id") == "shield"), "Égide: cura dá barreira")
	sim.despawn(mob)
	sim.despawn(a)

func _check_elemental_debuffs(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-36, 0, -36)
	var el: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Ele", "city_aldara", at, 30)
	el.brain = null
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 1.6))
	mob.brain = null
	# Trovão atordoa
	sim._apply_effects(el, mob, gd.skills["ele_thunder"].effects, 1.0)
	check(mob.state == SimEntity.State.STUNNED, "Trovão atordoa o alvo")
	mob.set_state(SimEntity.State.IDLE)
	# fogo queima: todo dano no tempo de skill de fogo é queimadura
	for sid in gd.skills:
		var sk: SkillDef = gd.skills[sid]
		if sk.effects.has("dot") and (sk.vfx == "fire" or sk.elements.has("fire")):
			check(bool(sk.effects["dot"].get("fire", false)), "%s: dano no tempo de fogo é queimadura" % sid)
	check(gd.skills["ele_phoenix"].effects.has("dot"), "Fênix queima")
	_dmg_kinds.clear()
	Events.damage_dealt.connect(_note_damage)
	var hp0: float = mob.hp
	sim._apply_effects(el, mob, gd.skills["ele_fireball"].effects, 1.0)
	for i in range(25):
		sim._update_entity(mob, m, 0.1)
	check(mob.hp < hp0 and _dmg_kinds.has("dot_fire"), "Bola de Fogo queima com o tempo (%.0f de dano, %s)" % [hp0 - mob.hp, str(_dmg_kinds.slice(0, 3))])
	# gelo estilhaça: mais dano em alvo retardado, preso ou atordoado; fogo não ganha o bônus
	mob.debuffs.clear()
	mob.set_state(SimEntity.State.IDLE)
	var lance: SkillDef = gd.skills["ele_ice_lance"]
	check(is_equal_approx(Combat.frost_mult(lance, mob), 1.0), "gelo em alvo normal: sem bônus")
	mob.debuffs.append({"kind": "slow", "remaining": 2.0, "pct": 30.0})
	check(is_equal_approx(Combat.frost_mult(lance, mob), Balance.FROST_SHATTER_MULT), "gelo em alvo retardado: estilhaço")
	check(is_equal_approx(Combat.frost_mult(gd.skills["ele_fireball"], mob), 1.0), "fogo não estilhaça")
	check(is_equal_approx(Combat.frost_mult(gd.skills["ran_frost_arrow"], mob), Balance.FROST_SHATTER_MULT), "flecha de gelo do Ranger também estilhaça")
	# no lance de verdade: Nova de Gelo no alvo normal = mágico; de novo no alvo já retardado = estilhaço
	mob.debuffs.clear()
	mob.hp = mob.stats.max_hp * 100.0          # a 1ª Nova não pode matar o alvo (o equipamento sorteado do bot varia com o catálogo)
	_dmg_kinds.clear()
	sim._apply_skill(el, gd.skills["ele_frost_nova"], m)
	var first := _dmg_kinds.duplicate()
	_dmg_kinds.clear()
	sim._apply_skill(el, gd.skills["ele_frost_nova"], m)
	check(first.has("magical") and not first.has("shatter") and _dmg_kinds.has("shatter"), "Nova de Gelo estilhaça quem já está retardado (%s → %s, vivo=%s)" % [str(first), str(_dmg_kinds), str(mob.is_alive())])
	Events.damage_dealt.disconnect(_note_damage)
	# raio: chance de atordoar no golpe; Trovão (que já atordoa) e skills sem dano não rolam
	check(Combat.storm_can_stun(gd.skills["ele_lightning"]) and Combat.storm_can_stun(gd.skills["ele_chain"]), "Relâmpago e Corrente rolam atordoar")
	check(not Combat.storm_can_stun(gd.skills["ele_thunder"]) and not Combat.storm_can_stun(gd.skills["ele_overload"]) and not Combat.storm_can_stun(gd.skills["ele_fireball"]),
		"Trovão, Sobrecarga e Bola de Fogo não rolam o atordoar do raio")
	var stuns := 0
	for i in range(400):
		mob.set_state(SimEntity.State.IDLE)
		sim._storm_proc(el, gd.skills["ele_lightning"], mob)
		if mob.state == SimEntity.State.STUNNED:
			stuns += 1
	var rate := stuns / 4.0
	check(absf(rate - Balance.STORM_STUN_CHANCE) < 6.0, "raio atordoa em ~%.0f%% dos golpes (%.1f%%)" % [Balance.STORM_STUN_CHANCE, rate])
	sim.despawn(mob)
	sim.despawn(el)

func _check_necromancer_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["necromancer"]
	_check_lord_of_dead(gd, sim)
	_check_lord_of_dead_bots(gd, sim)
	check(Array(cls.weapon_types) == ["scythe"] and cls.builds.size() == 3 and not cls.builds.any(func(b): return b["main"] != ["scythe"]),
		"Necromancer: só foice, três focos que se misturam")
	for sid in cls.skill_ids:
		check(gd.skills[sid].requires.is_empty() or Array(gd.skills[sid].requires) == ["scythe"], "%s usável com foice" % sid)
	for mid in ["bone_hound", "lich_servant", "skeleton_king", "skeleton_minion"]:
		check(gd.monsters.has(mid) and gd.monsters[mid].xp == 0, "invocação %s existe e não dá XP" % mid)
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-30, 0, -30)
	var n: SimEntity = sim.spawn_bot(cls, "Nec", "city_aldara", at, 30)
	n.brain = null
	n.equipment[ItemDef.Slot.WEAPON] = gd.items["scythe_bone"]
	n.recompute_stats()
	# invocações: limite por tipo (cães 2, lich 1, rei 1) e juntas
	for i in range(2):
		for sid in ["nec_bone_hound", "nec_lich", "nec_skeleton_king"]:
			sim._apply_skill(n, gd.skills[sid], m)
	var count := {}
	for o in m["entities"]:
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id and o.is_alive():
			count[o.monster_def.id] = int(count.get(o.monster_def.id, 0)) + 1
	check(count.get("bone_hound", 0) == 2 and count.get("lich_servant", 0) == 1 and count.get("skeleton_king", 0) == 1, "limite de invocação por tipo (%s)" % str(count))
	var king: SimEntity = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id and o.monster_def.id == "skeleton_king")[0]
	var dog: SimEntity = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id and o.monster_def.id == "bone_hound")[0]
	check(king.stats.patk > dog.stats.patk * 1.5, "Rei Esqueleto bate bem mais que o cão")
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id:
			sim.despawn(o)
	# maldições: Condenação faz o alvo receber mais; Fraqueza faz causar menos
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 3))
	mob.brain = null
	var hp0: float = mob.hp
	sim._deal_damage(n, mob, 100, false, false, "magical")
	var plain := hp0 - mob.hp
	sim._apply_effects(n, mob, gd.skills["nec_curse_doom"].effects, 1.0)
	sim._apply_effects(n, mob, gd.skills["nec_curse_doom"].effects, 1.0)
	check(mob.debuffs.filter(func(d): return d.get("kind") == "curse").size() == 1, "a mesma maldição renova, não acumula")
	hp0 = mob.hp
	sim._deal_damage(n, mob, 100, false, false, "magical")
	check(hp0 - mob.hp > plain * 1.15, "amaldiçoado recebe mais dano (%.0f x %.0f)" % [hp0 - mob.hp, plain])
	sim._apply_effects(n, mob, gd.skills["nec_curse_weakness"].effects, 1.0)
	var nhp: float = n.hp
	sim._deal_damage(mob, n, 100, false, false, "physical")
	var weak_hit := nhp - n.hp
	check(weak_hit > 0.0 and weak_hit <= 80.0, "enfraquecido causa menos dano (%.0f de 100)" % weak_hit)
	n.hp = n.stats.max_hp
	# canalização: Açoite Mental aplica 4 pulsos durante a fase ativa
	var flay: SkillDef = gd.skills["nec_mind_flay"]
	n.position = at
	mob.position = at + Vector3(0, 0, 3)
	mob.hp = mob.stats.max_hp
	sim._start_skill(n, flay, -1, mob.position)
	var steps := 0
	while n.current_skill != null and steps < 400:
		sim._update_skill(n, m, 0.02)
		n.state_time += 0.02
		steps += 1
	check(n.channel_done == 4, "canalização aplica %d pulsos (%d)" % [4, n.channel_done])
	# formas: fantasma e demônio exigem foice e se trocam
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	check(n.form == "phantom" and n.stats.evasion > 0.0, "Forma Fantasma: esquiva e velocidade")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	check(n.form == "demon" and n.stats.lifesteal > 0.0, "Forma Demoníaca troca a fantasma")
	check(sim.resolve_skill(n, gd.skills["nec_reap"]).name == "Garra Infernal", "golpe de foice muda na forma demoníaca")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	check(n.form == "", "Forma Demoníaca desliga")
	# fantasma acaba sozinha (Balance.FORM_DURATION); demônio fica até desligar; usar de novo desfaz e zera o tempo
	var fdur: float = Balance.FORM_DURATION.get("phantom", 0.0)
	check(fdur > 0.0 and not Balance.FORM_DURATION.has("demon") and not Balance.FORM_DURATION.has("wolf"), "só a fantasma tem tempo")
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	check(n.form == "phantom" and is_equal_approx(n.form_left, fdur), "fantasma começa com %.0f s" % fdur)
	var nm: Dictionary = sim.maps[n.map_id]
	for i in range(int((fdur - 0.5) / 0.1)):
		sim._update_entity(n, nm, 0.1)
	check(n.form == "phantom", "fantasma ainda ativa antes do fim")
	for i in range(10):
		sim._update_entity(n, nm, 0.1)
	check(n.form == "" and n.form_left == 0.0 and is_equal_approx(n.stats.evasion, Stats.agi_evasion(float(n.stats.attrs["AGI"]) / Balance.ATTR_SCALE)), "fantasma acaba sozinha e devolve os atributos (sobra só a esquiva da AGI)")
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	check(n.form == "" and n.form_left == 0.0, "usar de novo desfaz a fantasma")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	for i in range(int((fdur + 2.0) / 0.1)):
		sim._update_entity(n, nm, 0.1)
	check(n.form == "demon", "forma demoníaca não acaba sozinha")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	# maestria fortalece os bônus: forma (x form_mult) e buff (valores positivos), sem mexer em penalidade
	var ph: SkillDef = gd.skills["nec_phantom"]
	n.mastery.erase(ph.id)
	sim._apply_skill(n, ph, nm)
	var ev0: float = n.stats.evasion
	sim.end_form(n)
	n.mastery[ph.id] = 3
	sim._apply_skill(n, ph, nm)
	check(n.form == "phantom" and is_equal_approx(n.form_mult, 1.0 + 3 * Balance.MASTERY_BONUS_PCT), "maestria 3 na fantasma: form_mult %.2f" % n.form_mult)
	check(n.stats.evasion > ev0 + 1.0, "maestria aumenta a esquiva da fantasma (%.1f -> %.1f)" % [ev0, n.stats.evasion])
	sim.end_form(n)
	check(n.form_mult == 1.0 or n.form == "", "forma desligada")
	var ba: SkillDef = gd.skills["nec_bone_armor"]
	n.mastery[ba.id] = 5
	sim._apply_skill(n, ba, nm)
	var got := 0.0
	for b in n.buffs:
		if b.get("id") == "bone_armor":
			got = float(b.get("def_pct", 0))
	var want: float = float(ba.effects["buff"]["def_pct"]) * (1.0 + 5 * Balance.MASTERY_BONUS_PCT)
	check(is_equal_approx(got, want), "maestria 5 na Armadura de Ossos: DEF +%.1f%% (esperado %.1f)" % [got, want])
	var pen := SimEntity.scaled_bonus({"speed_pct": -10, "def_pct": 40, "duration": 6}, 1.5)
	check(pen["speed_pct"] == -10 and is_equal_approx(float(pen["def_pct"]), 60.0) and pen["duration"] == 6, "maestria não piora penalidade nem tempo")
	sim.despawn(mob)
	sim.despawn(n)

func _check_elementalist_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["elementalist"]
	check(Array(cls.weapon_types) == ["staff"] and cls.offhand_types.is_empty(), "Elementalista só usa cajado")
	check(cls.builds.size() == 3 and not cls.builds.any(func(b): return b["main"] != ["staff"]), "Elementalista: três focos, todos de cajado (dá para misturar ramos)")
	for sid in cls.skill_ids:
		var s: SkillDef = gd.skills[sid]
		check(s.requires.is_empty() or Array(s.requires) == ["staff"], "%s usável com cajado" % sid)
		if s.kind == SkillDef.Kind.MAGICAL:
			check(not s.elements.is_empty(), "%s tem elemento" % sid)
	check(Array(gd.skills["ele_firestorm"].elements) == ["fire", "storm"] and gd.skills["ele_prism"].elements.size() == 3, "combinações têm dois ou três elementos")
	check(Array(gd.skills["ele_meteor"].elements) == ["fire"] and Array(gd.skills["ele_blizzard"].elements) == ["frost"], "ramo dá o elemento")
	for el in ["fire", "frost", "storm"]:
		var mid: String = {"fire": "fire_elemental", "frost": "frost_elemental", "storm": "storm_elemental"}[el]
		check(gd.monsters.has(mid) and gd.monsters[mid].xp == 0, "elemental %s existe e não dá XP" % el)
	# bônus por elemento: combinação usa a média
	var st := Stats.new()
	st.fire_pct = 40.0
	st.storm_pct = 0.0
	check(is_equal_approx(st.element_mult(["fire"] as Array[String]), 1.4) and is_equal_approx(st.element_mult(["fire", "storm"] as Array[String]), 1.2)
		and st.element_mult([] as Array[String]) == 1.0, "bônus de elemento: puro inteiro, combinação pela média")
	var e: SimEntity = sim.spawn_bot(cls, "Ele", "city_aldara", Vector3(-30, 0, 30), 30)
	e.brain = null
	e.buffs.append({"id": "t_el", "duration": 99, "remaining": 99, "fire_pct": 500})
	e.recompute_stats()
	check(e.stats.fire_pct == Balance.ELEMENT_CAP, "bônus de elemento tem teto")
	# save antigo com varinha + orbe: voltam para a bolsa e o cajado inicial entra
	e.equipment[ItemDef.Slot.WEAPON] = gd.items["wand_apprentice"]
	e.equipment[ItemDef.Slot.OFFHAND] = gd.items[gd.items.keys().filter(func(k): return gd.items[k].weapon_type == "orb")[0]]
	SaveSystem._fix_class_weapons(e)
	check(e.equipment[ItemDef.Slot.WEAPON].weapon_type == "staff" and e.equipment.get(ItemDef.Slot.OFFHAND) == null and e.inventory.has("wand_apprentice"),
		"save antigo do Elementalista: varinha/orbe vão para a bolsa e o cajado entra")
	# invocar: um elemental por vez; o novo substitui o anterior
	var m: Dictionary = sim.maps["city_aldara"]
	for sid in ["ele_summon_fire", "ele_summon_ice", "ele_summon_storm"]:
		sim._apply_skill(e, gd.skills[sid], m)
	var mine: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id and o.is_alive())
	check(mine.size() == 1 and mine[0].monster_def.id == "storm_elemental", "um elemental por vez, o último substitui (%d)" % mine.size())
	for o in mine:
		sim.despawn(o)
	sim.despawn(e)
	# conjuntos: alguns favorecem uma combinação (2º elemento com 4 peças)
	var combos := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.class_id != "elementalist":
			continue
		for el in ["fire_pct", "frost_pct", "storm_pct"]:
			if sd.bonuses.get(4, {}).has(el):
				combos += 1
	check(combos >= 8, "conjuntos do Elementalista que favorecem uma combinação (%d)" % combos)


## Teia e barra de ascensão (GDD ato2-horda R6, decisão 2026-11-11): teia própria por classe (AscensionCatalog), pontos
## próprios do 35 ao 45 + missão, barra de 10 (7-0 só ascensão), save (asc_tree + loadout) e bots.
## Pergunta aberta 13 (teias pequenas): Paladino e Elementalista com 36+ pontos de conteúdo por build aos 45, e os refinos
## que saíram de ASC_REFINES_PENDING para portões da teia (Lança Pesada, Torreta Firme/Veterana, Salamandra/Golem/Silfo).
## Gêmeos 45 (decisão do autor 2026-11-13): nó Fúria Gêmea no ramo da build e o Ciclone de Titã na barra do bot.
## F5 aos 35 (usuário 2026-11-13): ASC_POWER_35_MULT vale inteiro no 35, vira 1,0 no 45 em linha reta; todo peso de ascensão passa por Balance.asc_power.
func _check_asc_power_35(gd, sim) -> void:
	var span := Balance.ASC_MAX_LEVEL - Balance.ASC_LEVEL
	for b in Balance.ASC_POWER_35_MULT:
		var m35 := float(Balance.ASC_POWER_35_MULT[b])
		check(m35 > 0.0 and is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_LEVEL), m35), "F5 35: %s vale x%.2f no 35" % [b, m35])
		check(is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_MAX_LEVEL), 1.0) and is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_MAX_LEVEL + 5), 1.0), "F5 35: %s = x1,0 no 45 (o peso do 45 não muda)" % b)
		var mono := true
		for lv in range(Balance.ASC_LEVEL, Balance.ASC_MAX_LEVEL):
			var a := Balance.asc_level_mult(b, lv)
			var c := Balance.asc_level_mult(b, lv + 1)
			mono = mono and (c >= a - 0.0001 if m35 <= 1.0 else c <= a + 0.0001)
		check(mono, "F5 35: %s anda sem voltar do 35 ao 45" % b)
		check(is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_LEVEL + span / 2), lerpf(m35, 1.0, float(span / 2) / span)), "F5 35: %s em linha reta" % b)
		check(is_equal_approx(Balance.asc_power(b, Balance.ASC_LEVEL), float(Balance.ASC_BUILD_POWER.get(b, 1.0)) * m35), "F5 35: asc_power(%s) = peso do 45 x fator" % b)
	check(is_equal_approx(Balance.asc_level_mult("build_sem_entrada", Balance.ASC_LEVEL), 1.0), "F5 35: build sem entrada = x1,0")
	# os caminhos de cada ascensão usam o fator do nível do dono
	for lv in [Balance.ASC_LEVEL, 40, Balance.ASC_MAX_LEVEL]:
		check(is_equal_approx(RangerAscension.asc_power("lanceiro", lv), Balance.asc_power("lanceiro", lv)) and is_equal_approx(DruidAscension.asc_power("xama", lv), Balance.asc_power("xama", lv)), "F5 35: Ranger/Druida pelo Balance.asc_power (nv %d)" % lv)
		var a: SimEntity = sim.spawn_bot(gd.classes["assassin"], "F5_sombra", "city_aldara", Vector3(60, 0, -64), lv)
		a.brain = null
		a.build_id = "corsario"
		check(is_equal_approx(ShadowSystem.asc_power(sim, a), Balance.asc_power("corsario", lv)), "F5 35: clone/Execução pelo nível do dono (nv %d)" % lv)
		var f: SimEntity = sim.spawn_bot(gd.classes["berserker"], "F5_garra", "city_aldara", Vector3(62, 0, -64), lv)
		f.brain = null
		f.equipment[ItemDef.Slot.WEAPON] = gd.items["claw_t3"]
		f.equipment[ItemDef.Slot.OFFHAND] = gd.items["claw_t3"]
		_ascend(f)
		check(f.stats.titan_claws and is_equal_approx(f.stats.titan_hit, Balance.TITAN_CLAW_POWER * Balance.asc_level_mult(TitanSystem.CLAW_BUILD, lv)), "F5 35: Garras de Titã no nível %d = x%.2f" % [lv, f.stats.titan_hit])
		sim.despawn(a)
		sim.despawn(f)
	# ninguém em core/ lê o peso cru: tudo passa por Balance.asc_power / asc_level_mult
	for path in ["ranger_ascension", "druid_ascension", "shadow_system", "falcon_system", "titan_system"]:
		var src := FileAccess.get_file_as_string("res://core/sim/systems/%s.gd" % path)
		check(not src.contains("ASC_BUILD_POWER") and (src.contains("Balance.asc_power(") or src.contains("RangerAscension.asc_power(BUILD, e.level)") or src.contains("asc_level_mult(")), "F5 35: %s usa o fator do nível" % path)
		for line in src.split("
"):
			if line.contains("TITAN_CLAW_POWER") and not line.strip_edges().begins_with("#"):
				check(line.contains("asc_level_mult("), "F5 35: TITAN_CLAW_POWER só com o fator do nível")

func _check_twin_fury(gd, sim) -> void:
	var nd: Dictionary = gd.asc_trees["berserker"]["nodes"].get("berserker_a_x_twin_fury", {})
	check(not nd.is_empty() and int(nd["level"]) == 45 and str(nd["branch"]) == "carniceiro" and int(nd["cost"]) == 3
		and is_equal_approx(float((nd.get("stats", {}) as Dictionary).get("atk_pct", 0.0)), float(Balance.TWIN_FURY_ATK)), "Gêmeos: Fúria Gêmea (45, +%d%% de dano) no ramo da build" % Balance.TWIN_FURY_ATK)
	# F5 no 45 (usuário 2026-11-14: build abaixo de 1,30 sobe): nós do 45 que carregam a subida, com portão para o bot comprar
	var asc45 := [["berserker", "berserker_a_x_arena_finale", "executor", "atk_pct", float(Balance.ARENA_FINALE_ATK)],
		["paladin", "paladin_a_x_tem_dawn", "templario", "atk_pct", float(Balance.ASC_TEM_DAWN_ATK)],
		["elementalist", "elementalist_a_x_frost_lord", "gelo", "matk_pct", float(Balance.ASC_FROST_LORD_MATK)]]
	for row in asc45:
		var n45: Dictionary = gd.asc_trees[row[0]]["nodes"].get(row[1], {})
		check(not n45.is_empty() and int(n45["level"]) == 45 and str(n45["branch"]) == row[2] and str(n45.get("flag", "")) != ""
			and is_equal_approx(float((n45.get("stats", {}) as Dictionary).get(row[3], 0.0)), row[4]), "F5 45: %s (45, %s %+.0f, com portão) no ramo %s" % [row[1], row[3], row[4], row[2]])
	var order: Array = AscensionCatalog.bot_order(gd.classes["berserker"], "carniceiro", gd.skills)
	check(order.has("ber_titan_cyclone") and not AscensionCatalog.BOT_NO_SLOT.has("ber_titan_cyclone") and order.find("ber_titan_cyclone") < Balance.ASC_SLOTS, "Gêmeos: Ciclone de Titã na ordem de ascensão do bot (barra 7-0)")
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["berserker"], "Web_twin", "city_aldara", Vector3(60, 0, -60), Balance.ASC_MAX_LEVEL)
	e.build_id = "carniceiro"
	e.quests_completed.append("hx_asc_berserker")
	sim._gear_bot(e)
	sim._skill_bot(e)
	e.brain = null
	e.recompute_stats()
	check(e.asc_tree.has("berserker_a_x_twin_fury"), "bot Gêmeos no 45 compra a Fúria Gêmea (%s)" % ",".join(PackedStringArray(e.asc_tree.keys())))
	check(e.skills.any(func(s): return s != null and s.id == "ber_titan_cyclone"), "bot Gêmeos no 45 põe o Ciclone de Titã na barra (%s; arma %s+%s)" % [",".join(PackedStringArray(e.skills.map(func(s): return s.id if s != null else "-"))), e.stats.weapon_type, e.stats.offhand_type])
	sim.despawn(e)

func _check_asc_web_fill(gd, sim) -> void:
	var budget: int = Balance.ASC_POINTS_PER_LEVEL * (Balance.ASC_MAX_LEVEL - Balance.ASC_LEVEL + 1) + Balance.ASC_QUEST_POINTS
	for cid in ["paladin", "elementalist"]:
		var nodes: Dictionary = gd.asc_trees[cid]["nodes"]
		for b in gd.classes[cid].builds:
			var cost := 0
			for nid in nodes:
				var n: Dictionary = nodes[nid]
				if n["kind"] == "start" or not (n["branch"] in ["", b["id"]]):
					continue
				cost += int(n["cost"]) * (Balance.MASTERY_MAX if n["kind"] == "mastery" else 1)
			check(cost >= budget and cost <= budget + 6, "teia de ascensão %s/%s: %d pontos de conteúdo para %d ganhos aos 45" % [cid, b["id"], cost, budget])
	var moved := {"paladin": ["Lança Pesada"], "ranger": ["Torreta Firme", "Torreta Veterana"], "elementalist": ["Salamandra", "Golem de Gelo", "Silfo"]}
	for cid in moved:
		var pend: Array = ClassTalentsCatalog.ASC_REFINES_PENDING[cid].map(func(x): return x["name"])
		for nm in moved[cid]:
			var nd: Array = gd.asc_trees[cid]["nodes"].values().filter(func(n): return n["name"] == nm)
			check(not pend.has(nm) and nd.size() == 1 and str(nd[0].get("flag", "")) != "" and int(nd[0]["level"]) in [40, 45], "refino %s saiu do PENDING e é portão da teia de ascensão" % nm)
	check(not ClassTalentsCatalog.ASC_REFINES_PENDING["paladin"].any(func(x): return x["name"] == "Corrente que Provoca"), "Paladino: refino da Corrente de Luz (skill que não existe mais) fora da lista")
	var at := Vector3(60, 0, -60)
	var mk := func(cid: String, bid: String, lv: int) -> SimEntity:
		var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], "Web_" + bid, "city_aldara", at, lv)
		e.build_id = bid
		e.quests_completed.append("hx_asc_" + cid)
		sim._gear_bot(e)
		sim._skill_bot(e)
		e.brain = null
		e.recompute_stats()
		e.heal_full()
		return e
	# bots no 45 gastam a teia inteira e compram os portões da build
	for row in [["paladin", "cruzado", [Balance.MOUNT_LANCE_FLAG]], ["paladin", "guardiao", [Balance.ARCANE_GUARD_FLAG, Balance.MOUNT_WALL_FLAG]],
			["paladin", "templario", [Balance.ARCANE_WARD_FLAG, Balance.MOUNT_BANNER_FLAG, Balance.TEM_DAWN_FLAG]],
			["berserker", "carniceiro", [Balance.CYCLONE_LONG_FLAG, Balance.TWIN_FURY_FLAG]], ["berserker", "executor", [Balance.SECOND_AXE_FLAG, Balance.ARENA_FINALE_FLAG]],
			["berserker", "punhos", [Balance.FURY_LIT_FLAG, Balance.GLORY_KEEP_FLAG]], ["ranger", "lanceiro", [Balance.DOUBLE_JUMP_FLAG, Balance.SHOUT_COMBO_FLAG]],
			["ranger", "atirador", Balance.TURRET_REFINE_FLAGS], ["elementalist", "fogo", [Balance.ELEM_FORM_REFINE_FLAG + "fire"]],
			["elementalist", "gelo", [Balance.ELEM_FORM_REFINE_FLAG + "frost", Balance.FROST_LORD_FLAG]], ["elementalist", "raio", [Balance.ELEM_FORM_REFINE_FLAG + "storm"]]]:
		var e: SimEntity = mk.call(row[0], row[1], Balance.ASC_MAX_LEVEL)
		for flag in row[2]:
			check(ProgressionSystem.asc_flag(e, flag), "bot %s no 45 compra o portão %s" % [row[1], flag])
		if row[0] in ["paladin", "elementalist"]:
			check(ProgressionSystem.asc_points(e) == 0, "bot %s no 45 gasta a teia de ascensão inteira (sobram %d)" % [row[1], ProgressionSystem.asc_points(e)])
		sim.despawn(e)
	# Lança Pesada: Carga Montada 30% mais longe (alcance e avanço); sem o portão, igual ao catálogo
	var charge: SkillDef = gd.skills[Balance.MOUNT_CHARGE_SKILL]
	var cru: SimEntity = mk.call("paladin", "cruzado", Balance.ASC_MAX_LEVEL)
	var far: SkillDef = sim.resolve_skill(cru, charge)
	check(is_equal_approx(far.range, charge.range * Balance.MOUNT_LANCE_MULT) and is_equal_approx(float(far.talent_effects["dash"]), float(charge.effects["dash"]) * Balance.MOUNT_LANCE_MULT),
		"Lança Pesada: Carga Montada vai %.1f m (era %.1f)" % [far.range, charge.range])
	var cru35: SimEntity = mk.call("paladin", "cruzado", Balance.ASC_LEVEL)
	check(not ProgressionSystem.asc_flag(cru35, Balance.MOUNT_LANCE_FLAG) and is_equal_approx(sim.resolve_skill(cru35, charge).range, charge.range), "sem Lança Pesada (nível 35): Carga Montada do catálogo")
	# Torreta Firme + Veterana: +4 s cada e -20% de recarga cada
	var tur: SkillDef = gd.skills["ran_turret"]
	var gun: SimEntity = mk.call("ranger", "atirador", Balance.ASC_MAX_LEVEL)
	check(RangerAscension.turret_refines(gun) == 2 and is_equal_approx(sim.resolve_skill(gun, tur).cooldown, tur.cooldown * (1.0 - 2.0 * Balance.TURRET_REFINE_CD_PCT / 100.0)),
		"Torreta Firme + Veterana: recarga %.1f s (era %.1f)" % [sim.resolve_skill(gun, tur).cooldown, tur.cooldown])
	var t0: float = sim.time
	var tt: SimEntity = RangerAscension.place_turret(sim, gun, tur, gun.position + Vector3(2, 0, 0), tur.effects)
	check(tt != null and is_equal_approx(tt.summon_expires - t0, Balance.TURRET_TIME + 2.0 * Balance.TURRET_REFINE_TIME), "Torreta Firme + Veterana: a torreta dura %.0f s" % (Balance.TURRET_TIME + 2.0 * Balance.TURRET_REFINE_TIME))
	var gun35: SimEntity = mk.call("ranger", "atirador", Balance.ASC_LEVEL)
	check(RangerAscension.turret_refines(gun35) == 0 and is_equal_approx(sim.resolve_skill(gun35, tur).cooldown, tur.cooldown), "sem refino (nível 35): torreta do catálogo")
	# Salamandra: o elemental de fogo com o portão bate e aguenta mais que o do mesmo mago sem ele; outra forma não muda
	var mage: SimEntity = mk.call("elementalist", "fogo", Balance.ASC_MAX_LEVEL)
	check(ElementalSystem.form_refined(mage, "fire"), "Salamandra: bot de fogo no 45 tem a forma de fogo refinada")
	var stats_of := func(form: String) -> Array:
		var el: SimEntity = ElementalSystem.summon(sim, mage, form)
		return [el.stats.patk, el.stats.max_hp] if el else [0.0, 0.0]
	var with: Array = stats_of.call("fire")
	var kept: Dictionary = mage.asc_tree.duplicate()
	mage.asc_tree.erase("elementalist_a_x_fire_refine")
	var without: Array = stats_of.call("fire")
	mage.asc_tree = kept
	check(float(without[0]) > 0.0 and is_equal_approx(float(with[0]), float(without[0]) * (1.0 + float(Balance.ELEM_FORM_REFINE["atk"]))), "Salamandra: +15%% de ataque no elemental de fogo (%.0f -> %.0f)" % [without[0], with[0]])
	check(is_equal_approx(float(with[1]), float(without[1]) * (1.0 + float(Balance.ELEM_FORM_REFINE["hp"]))), "Salamandra: +15%% de vida no elemental de fogo (%.0f -> %.0f)" % [without[1], with[1]])
	for o in sim.maps["city_aldara"]["entities"].duplicate():
		if o.owner_id in [mage.id, gun.id]:
			sim.despawn(o)
	for e in [cru, cru35, gun, gun35, mage]:
		sim.despawn(e)

## Refinos de ascensão que esperavam mecânica (GDD ato2-horda R6.1; eram ClassTalentsCatalog.ASC_REFINES_PENDING): agora
## são portões da teia (AscensionCatalog.NODES, `flag`) e cada um faz o que o texto diz; sem o portão, nada muda.
func _check_asc_refines(gd, sim) -> void:
	for cid in ClassTalentsCatalog.ASC_REFINES_PENDING:
		check((ClassTalentsCatalog.ASC_REFINES_PENDING[cid] as Array).is_empty(), "%s: nenhum refino de ascensão pendente" % cid)
	var gates := {"paladin": [["Asas com Bloqueio", "guardiao", 40, Balance.ARCANE_GUARD_FLAG], ["Muralha a Cavalo", "guardiao", 45, Balance.MOUNT_WALL_FLAG],
			["Asas Protetoras", "templario", 40, Balance.ARCANE_WARD_FLAG], ["Estandarte", "templario", 45, Balance.MOUNT_BANNER_FLAG]],
		"berserker": [["Giro dos Dois Machados", "carniceiro", 40, Balance.CYCLONE_LONG_FLAG], ["Segundo Machado", "executor", 40, Balance.SECOND_AXE_FLAG],
			["Fúria Acesa", "punhos", 40, Balance.FURY_LIT_FLAG], ["Golpe Final da Arena", "executor", 45, Balance.ARENA_FINALE_FLAG],
			["Glória que Não Esfria", "punhos", 45, Balance.GLORY_KEEP_FLAG]],
		"ranger": [["Salto Duplo", "lanceiro", 40, Balance.DOUBLE_JUMP_FLAG], ["Brado Combinado", "lanceiro", 45, Balance.SHOUT_COMBO_FLAG]]}
	var gate_id := {}
	for cid in gates:
		for g in gates[cid]:
			var nd: Array = gd.asc_trees[cid]["nodes"].values().filter(func(n): return n["name"] == g[0])
			var ok: bool = nd.size() == 1 and str(nd[0].get("flag", "")) == g[3] and nd[0]["branch"] == g[1] and int(nd[0]["level"]) == g[2]
			check(ok, "refino %s: portão %s da teia de ascensão (%s, nível %d)" % [g[0], g[3], g[1], g[2]])
			if ok:
				gate_id[g[3]] = nd[0]["id"]
	var at := Vector3(64, 0, -56)
	var m: Dictionary = sim.maps["city_aldara"]
	# --- Paladino: Asas com Bloqueio (Guardião 40) ---
	var gua: SimEntity = _refine_bot(gd, sim, "paladin", "guardiao", at)
	var wings: Dictionary = gd.skills[Balance.ARCANE_SKILL].effects["buff"]
	_set_gate(gua, gate_id, Balance.ARCANE_GUARD_FLAG, false)
	check(not (MountedCombat.wings_buff(gua, wings) as Dictionary).has("block"), "sem Asas com Bloqueio: as asas não dão bloqueio")
	_set_gate(gua, gate_id, Balance.ARCANE_GUARD_FLAG, true)
	var b0: float = gua.stats.block_chance
	var wb: Dictionary = (MountedCombat.wings_buff(gua, wings) as Dictionary).duplicate()
	gua.put_buff(wb)
	gua.recompute_stats()
	check(gua.stats.has_shield and is_equal_approx(gua.stats.block_chance - b0, Balance.ARCANE_GUARD_BLOCK),
		"Asas com Bloqueio: com escudo, as asas dão +%.0f%% de bloqueio (%.0f -> %.0f)" % [Balance.ARCANE_GUARD_BLOCK, b0, gua.stats.block_chance])
	check(not wings.has("block"), "Asas com Bloqueio não muda o buff do catálogo")
	gua.drop_buff(Balance.ARCANE_BUFF)
	gua.recompute_stats()
	# --- Muralha a Cavalo (Guardião 45): provoca e bloqueia montado ---
	var taunt: SkillDef = gd.skills["pal_taunt"]
	gua.mounted = true
	_set_gate(gua, gate_id, Balance.MOUNT_WALL_FLAG, false)
	check(MountedCombat.block_reason(gua, taunt) != "", "sem Muralha a Cavalo: Provocar não sai montado")
	_set_gate(gua, gate_id, Balance.MOUNT_WALL_FLAG, true)
	check(MountedCombat.block_reason(gua, taunt) == "", "Muralha a Cavalo: Provocar sai montado")
