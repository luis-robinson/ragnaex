## Monte Kharzun (WP11): gente do acampamento por estágio, sons do lugar, bichos/brasas e conversa dos bots.
func _check_living_kharzun(gd, sim) -> void:
	var def: MapDef = gd.maps["field_kharzun"]
	var by_id := {}
	for n in def.npcs:
		by_id[str(n["id"])] = n
	# vida: carroças da garganta sul com escolta, recrutas no treino, feridos na enfermaria; libertos com K1, orc carregador com K4
	var carts: Array = def.npcs.filter(func(n): return str(n.get("carry", "")) == "cart" and n.has("route"))
	check(carts.size() >= 2, "Kharzun: carroças de suprimento subindo das Estepes (%d)" % carts.size())
	check(by_id.has("kh_carter_escort") and by_id["kh_carter_escort"].has("fighter") and by_id["kh_carter_escort"].has("route"), "Kharzun: escolta armada acompanha as carroças")
	for nid in ["kh_drill_a", "kh_drill_b", "kh_drill_sergeant", "kh_wounded_a", "kh_wounded_b", "kh_smith_apprentice", "kh_cook"]:
		check(by_id.has(nid) and not by_id[nid].has("if") and not by_id[nid].has("unless"), "Kharzun: %s no acampamento desde K0" % nid)
	for nid in ["kh_freed_carrier_a", "kh_freed_carrier_b", "kh_freed_anvil"]:
		check(by_id.has(nid) and str(by_id[nid].get("if", "")) == MapsCatalog.Q_KH_MINES, "Kharzun: liberto %s só depois das Minas (K1)" % nid)
	check(by_id.has("kh_orc_porter") and str(by_id["kh_orc_porter"].get("if", "")) == MapsCatalog.Q_KH_WARLORD, "Kharzun: orc rendido carregando só depois de Durgash (K4)")
	for n in def.npcs:
		for k in ["if", "unless"]:
			if n.has(k) and not (n["id"] in Balance.MOUNT_KEEPER_NPCS):   # a tratadora (WP10) abre com hx_ov_hatch, a quest do lobo
				check(str(n[k]) in MapsCatalog.KHARZUN_STAGE_QUESTS, "Kharzun: %s usa só gatilhos de estágio (%s)" % [n["id"], n[k]])
	# falas de rua: todo serviço/morador do acampamento tem bark
	for nid in MapsCatalog.KHARZUN_NPCS:
		if nid != "kharzun_board":
			check(by_id.has(nid) and not (by_id[nid].get("barks", []) as Array).is_empty(), "Kharzun: %s tem falas de rua (BARKS)" % nid)
	# bichos e brasas: brasa é tipo conhecido e fica sobre a lava (perto de lava de verdade)
	check(AmbientLife.KINDS.has("ember") and bool(AmbientLife.KINDS["ember"]["fly"]), "ambiente: brasa no ar existe")
	var embers := 0
	for g in MapsCatalog.AMBIENT_LIFE["field_kharzun"]:
		if str(g[0]) == "ember":
			embers += int(g[3])
			var c := Vector3(float(g[1][0]), 0, float(g[1][1]))
			var q := Sfx.nearest_lava(def, c)
			check(q != Vector3.INF and q.distance_to(c) <= float(g[2]), "Kharzun: brasas em (%.0f, %.0f) sobre a lava" % [c.x, c.z])
	check(embers >= 40, "Kharzun: brasas no ar sobre a lava (%d)" % embers)
	# sons do lugar: lava perto da ponte norte, nada em Aldara; martelo nos ferreiros; corrente das Minas
	var bridge := Vector3(2.23, 0, -49.9)
	var lq := Sfx.nearest_lava(def, bridge + Vector3(0, 0, 8))
	check(lq != Vector3.INF and lq.distance_to(bridge + Vector3(0, 0, 8)) < Sfx.LAVA_RANGE, "Kharzun: lava borbulha perto da ponte norte")
	check(Sfx.nearest_lava(gd.maps["city_aldara"], Vector3.ZERO) == Vector3.INF, "som de lava só onde há lava (Aldara não)")
	check(Sfx.HAMMER_NPCS.keys().all(func(k): return by_id.has(k)), "martelo da forja: todos os ferreiros/fundidores existem no Kharzun")
	check(Sfx.QUEST_SOUND.get(MapsCatalog.Q_KH_MINES, "") == "chain_break" and Sfx.VOL.has("chain_break"), "corrente parte quando as Minas são libertadas")
	var sfx := Sfx.new()
	sfx._load_bank()
	for mid in ["dire_wolf", "lava_salamander", "basalt_golem"]:
		var v := Sfx.voice_of(gd.monsters[mid])
		check(v.size() == 3 and str(v[0]) in ["dire_howl", "salamander_hiss", "golem_rumble"] and sfx.bank.has(str(v[0])), "Kharzun: %s tem voz própria (%s)" % [mid, v])
	check(Sfx.voice_of(gd.monsters["dire_wolf_rider"])[2] == "goblin_shriek", "Ginete do Lobo Atroz: o goblin guincha ao cair")
	for sid in ["mob_shadow_step", "mob_slayer_vanish", "mob_slayer_execute"]:
		check(Sfx.CAST_SOUND.get(sid, "") == "smoke_vanish", "Assassino/Matador: %s avisa com fumaça" % sid)
	for n in ["lava_bubble", "forge_hammer", "chain_break", "smoke_vanish", "dire_howl", "salamander_hiss", "salamander_die", "golem_rumble", "golem_crumble", "boulder", "banner_plant"]:
		check(sfx.bank.has(n) and Sfx.VOL.has(n), "som do Kharzun '%s' no banco com volume" % n)
	sfx.free()
	# conversa dos bots: tipos de lugar do Kharzun, acampamento murado, vitória depois de Durgash
	for k in ["place:kharzun", "place:kharzun_town", "place:slayers", "place:kharzun_citadel", "place:kharzun_victory"]:
		check(not (GameData.bot_chat.get(k, []) as Array).is_empty(), "falas de bot '%s'" % k)
	check(BotChat.place_kind(def, Vector3(2, 0, 3)) == "kharzun_town" and BotChat.place_kind(def, Vector3(0, 0, 80)) == "kharzun",
		"bots: dentro da paliçada é o acampamento, fora é a montanha")

## Carroça de tiro (CarryPose.DRAFT, tools/blender/life_props.cart_draft): a caravana das Estepes anda ao lado do cavalo que
## puxa a carroça. O cavalo fica entre os varais (rodas atrás dos cascos, varal até o ombro), é 1 malha fundida como a
## montaria e anda no clipe "walk" no ritmo do boneco; parado, "idle".
func _check_draft_cart(gd, sim) -> void:
	var drivers: Array = (gd.maps["field_steppe"] as MapDef).npcs.filter(func(n): return not CarryPose.draft_of(str(n.get("carry", ""))).is_empty())
	check(drivers.size() >= 2 and drivers.all(func(n): return n.has("route")), "Estepes: os carroceiros da caravana levam carroça de tiro (%d)" % drivers.size())
	for what in CarryPose.DRAFT:
		var d: Dictionary = CarryPose.DRAFT[what]
		var at: Vector3 = d["at"]
		var sc: float = d["scale"]
		check(CarryPose.pose_of(what) == "lead" and absf(at.x) > 0.8, "%s: o boneco anda ao lado do animal (%.2f m) com o cabresto na mão" % [what, absf(at.x)])
		if not ResourceLoader.exists(CarryPose.model_path(what)):
			check(false, "%s: prop existe" % what)
			continue
		var cart: Node = (load(CarryPose.model_path(what)) as PackedScene).instantiate()
		var meshes := cart.find_children("*", "MeshInstance3D", true, false)
		# arreio (preso ao bicho) + nó `cart` (a carroça, que atrasa na curva) + nó `wheels` (rodas e eixo, que giram)
		var cart_n := cart.get_node_or_null("cart") as Node3D
		var wheels_n := cart_n.get_node_or_null("wheels") as Node3D if cart_n else null
		check(meshes.size() == 3 and meshes.all(func(mi): return (mi as MeshInstance3D).mesh.get_surface_count() <= 10), "%s: carroça são 3 malhas: arreio, caixa e rodas (%d)" % [what, meshes.size()])
		check(cart_n != null and cart_n.position.is_equal_approx(at), "%s: nó `cart` com a origem onde o animal pisa (pivô da curva)" % what)
		check(wheels_n != null and is_equal_approx(wheels_n.position.y, float(d["wheel_r"])) and absf(wheels_n.position.x) < 0.01, "%s: nó `wheels` com a origem no eixo, a um raio do chão" % what)
		var wheel_front := -INF          # ponto mais à frente (+Z) do que encosta no chão: as rodas
		var shaft_front := -INF          # ponto mais à frente na altura do flanco, na linha dos varais
		for mi: MeshInstance3D in meshes:
			for si in mi.mesh.get_surface_count():
				for v: Vector3 in mi.mesh.surface_get_arrays(si)[Mesh.ARRAY_VERTEX]:
					var w: Vector3 = v
					var up: Node = mi
					while up != cart:
						w = (up as Node3D).transform * w
						up = up.get_parent()
					if w.y < 0.25:
						wheel_front = maxf(wheel_front, w.z)
					var side := absf(w.x - at.x)
					if side > 0.34 and side < 0.56 and w.y > 0.6 and w.y < 1.1:
						shaft_front = maxf(shaft_front, w.z)
		cart.free()
		check(wheel_front < at.z - float(d["hoof_back"]), "%s: rodas atrás dos cascos de trás (%.2f < %.2f)" % [what, wheel_front, at.z - float(d["hoof_back"])])
		check(shaft_front > at.z + 0.3 * sc and shaft_front - wheel_front > 2.2, "%s: varais chegam ao ombro do animal (%.1f m à frente das rodas)" % [what, shaft_front - wheel_front])
		var n := {"id": "draft_check", "name": "Carroceiro", "pos": Vector3(0, 0, 6), "role": "villager", "color": Color(0.6, 0.5, 0.4), "dialog": [], "carry": what}
		var e: SimEntity = sim._spawn_npc(n, "city_aldara")
		var view := EntityView.new()
		add_child(view)
		view.setup(e, false)
		check(view.draft != null and view.carry_node != null, "%s: o boneco nasce com a carroça e o animal" % what)
		if view.draft != null:
			check(view.draft.position.is_equal_approx(at) and is_equal_approx(view.draft.scale.x, sc), "%s: animal entre os varais (posição e escala do CarryPose.DRAFT)" % what)
			check(view.draft.drawn_surfaces() <= 6, "%s: animal fundido como a montaria (%d superfícies)" % [what, view.draft.drawn_surfaces()])
			check(view.draft.anim != null and view.draft.anim.has_animation("walk") and view.draft.anim.has_animation("idle"), "%s: animal tem passo e descanso" % what)
			e.velocity = Vector3(0, 0, Balance.NPC_WALK_SPEED)
			view._animate_draft()
			var walking := str(view.draft.anim.current_animation) == "walk"
			var pace: float = view.draft.anim.speed_scale
			e.velocity = Vector3.ZERO
			view._animate_draft()
			check(walking and pace > 1.2 and pace <= 2.4 and str(view.draft.anim.current_animation) == "idle", "%s: anda no passo do boneco (x%.1f) e para com ele" % [what, pace])
			# arreio, não sela: as peças da sela de montaria saem antes da fusão (a montaria continua com a dela)
			var mount := FormModel.create_from("res://assets/models/%s.glb" % d["model"])
			var saddle := 0
			for pat: String in d["strip"]:
				saddle += mount.find_children(pat, "MeshInstance3D", true, false).size()
			RigidMerge.merge(mount, str(d["model"]))
			var vm := _merged_verts(mount)
			var vd := _merged_verts(view.draft)
			mount.free()
			check(saddle >= 6 and vd > 0 and vd < vm - 200, "%s: animal de tiro sem a sela da montaria (%d peças fora, %d < %d vértices)" % [what, saddle, vd, vm])
			# rodas giram pela distância andada; paradas, não giram
			var wn: Node3D = view._wheels
			check(wn != null and view._cart != null, "%s: a vista achou os nós `cart` e `wheels`" % what)
			if wn != null and view._cart != null:
				var r0 := wn.rotation.x
				view._animate_wheels(0.1)
				var still := is_equal_approx(wn.rotation.x, r0)
				e.velocity = Vector3(0, 0, Balance.NPC_WALK_SPEED)
				view._animate_wheels(0.1)
				var turn := wrapf(wn.rotation.x - r0, -PI, PI)
				check(still and is_equal_approx(turn, Balance.NPC_WALK_SPEED * 0.1 / float(d["wheel_r"])), "%s: rodas rolam para a frente pela distância andada (%.3f rad em 0,1 s)" % [what, turn])
				# curva: a carroça fica para trás do rumo (até o teto) e alcança depois
				view.model_root.rotation.y += 1.0
				view._animate_draft(0.1)
				var off: float = view._cart.rotation.y
				for i in 80:
					view._animate_draft(0.1)
				check(off < -0.01 and off >= -deg_to_rad(float(d["lag_max"])) - 0.001 and absf(view._cart.rotation.y) < 0.01, "%s: a carroça atrasa na curva (%.0f graus, teto %.0f) e alcança o rumo" % [what, rad_to_deg(off), float(d["lag_max"])])
				e.velocity = Vector3.ZERO
		view.queue_free()
		sim.despawn(e)
	# carroça de mão: caixa numa malha + nó `wheels` (rodas e eixo) com a origem no eixo; gira pela distância andada
	for what in CarryPose.WHEELS:
		var r: float = CarryPose.WHEELS[what]
		var prop: Node = (load(CarryPose.model_path(what)) as PackedScene).instantiate()
		var wheels_n := prop.get_node_or_null("wheels") as Node3D
		var n_mesh := prop.find_children("*", "MeshInstance3D", true, false).size()
		check(wheels_n != null and n_mesh == 2, "%s: carroça de mão são 2 malhas: caixa e rodas (%d)" % [what, n_mesh])
		if wheels_n != null:
			var ab: AABB = (wheels_n as MeshInstance3D).get_aabb()
			check(is_equal_approx(wheels_n.position.y, r) and absf(wheels_n.position.x) < 0.01 and absf(ab.position.y + r) < 0.02 and absf(ab.end.y - r) < 0.02,
				"%s: nó `wheels` com a origem no eixo, a um raio (%.2f m) do chão" % [what, r])
		prop.free()
		var n := {"id": "cart_check", "name": "Carroceiro", "pos": Vector3(0, 0, 6), "role": "villager", "color": Color(0.6, 0.5, 0.4), "dialog": [], "carry": what}
		var e: SimEntity = sim._spawn_npc(n, "city_aldara")
		var view := EntityView.new()
		add_child(view)
		view.setup(e, false)
		var wn: Node3D = view._wheels
		check(wn != null and view.draft == null, "%s: a vista achou o nó `wheels` (sem animal de tiro)" % what)
		if wn != null:
			var r0 := wn.rotation.x
			view._animate_wheels(0.1)
			var still := is_equal_approx(wn.rotation.x, r0)
			e.velocity = Vector3(0, 0, Balance.NPC_WALK_SPEED)
			view._animate_wheels(0.1)
			var turn := wrapf(wn.rotation.x - r0, -PI, PI)
			check(still and is_equal_approx(turn, Balance.NPC_WALK_SPEED * 0.1 / r), "%s: rodas rolam para a frente pela distância andada (%.3f rad em 0,1 s)" % [what, turn])
			e.velocity = Vector3.ZERO
		view.queue_free()
		sim.despawn(e)

func _merged_verts(root: Node) -> int:
	var n := 0
	for mi: MeshInstance3D in root.find_children("*", "MeshInstance3D", true, false):
		if mi.skin != null and mi.mesh != null:
			for si in mi.mesh.get_surface_count():
				n += (mi.mesh.surface_get_arrays(si)[Mesh.ARRAY_VERTEX] as PackedVector3Array).size()
	return n

## Criaturas e vida do Ato II: Forma de Lich com modelo próprio, besta de verdade nos besteiros, guarda montada,
## carga/carroça dos NPCs que trabalham (prop existe para cada `carry`) e o rebanho das Estepes.
func _check_creatures_act2(gd, _sim) -> void:
	check(FormModel.FORM_PATHS.is_empty() and ResourceLoader.exists("res://assets/models/form_lich.glb"), "Forma de Lich tem form_lich.glb (sem emprestar o Lich-Rei)")
	var lich := FormModel.create("lich")
	check(lich != null and lich.anim != null and lich.anim.has_animation("idle") and lich.anim.has_animation("run") and lich.anim.has_animation("atk_sweep"), "form_lich traz os clipes do kit (idle, corrida, golpe de foice)")
	if lich:
		# draw calls da forma: as peças rígidas (dezenas de malhas) viram 1 malha com poucas superfícies
		var before := lich.drawn_surfaces()
		var merged := lich.merge_parts("form_lich")
		var after := lich.drawn_surfaces()
		print("FORM_LICH_SURFACES before=%d after=%d" % [before, after])
		check(merged != null and after <= 12 and after * 4 <= before, "Forma de Lich funde as peças (%d -> %d superfícies)" % [before, after])
		check(lich.anim != null and lich.anim.has_animation("idle"), "Forma de Lich fundida mantém os clipes")
		lich.free()
	var demon := FormModel.create("demon")
	check(demon != null, "forma demoníaca tem form_demon.glb")
	if demon:
		var d0 := demon.drawn_surfaces()
		var dm := demon.merge_parts("form_demon")
		var d1 := demon.drawn_surfaces()
		print("FORM_DEMON_SURFACES before=%d after=%d" % [d0, d1])
		check(dm != null and d1 < d0 and d1 <= 12, "forma demoníaca funde as peças (%d -> %d superfícies)" % [d0, d1])
		check(demon.anim != null and demon.anim.has_animation("idle") and demon.anim.has_animation("run"), "forma demoníaca fundida mantém idle e corrida")
		demon.free()
	for frm in ["wolf", "bear"]:
		var fv := FormModel.create(frm)
		if fv:
			check(fv.merge_parts("form_" + frm) == null, "forma %s não funde (peças de armadura ligam/desligam)" % frm)
			fv.free()
	for mid in ["mob_orc_crossbow", "mob_crossbow_master", "mob_loyal_crossbow"]:
		var inst: Node = (load("res://assets/models/%s.glb" % mid) as PackedScene).instantiate()
		check(inst.find_child("wpn_main_crossbow*", true, false) != null and inst.find_child("wpn_main_bow*", true, false) == null, "%s empunha besta, não arco" % mid)
		inst.free()
	var guard := KitModel.create("male", Color.WHITE)
	check(RidePose.ensure_guard_clip(guard.anim, guard.skeleton) and guard.resolve(RidePose.GUARD_CLIP) != "", "guarda montada: clipe block_ride criado a partir do block_shield")
	var ga: Animation = guard.anim.get_animation(RidePose.GUARD_CLIP)
	var gb: Animation = guard.anim.get_animation("block_shield")
	var moved := false
	for t in range(ga.get_track_count()):
		if String(ga.track_get_path(t)).ends_with(":upper_arm.L") and ga.track_get_type(t) == Animation.TYPE_ROTATION_3D:
			moved = not (ga.track_get_key_value(t, 0) as Quaternion).is_equal_approx(gb.track_get_key_value(t, 0) as Quaternion)
	check(moved and ga.loop_mode == Animation.LOOP_LINEAR, "guarda montada ergue o braço do escudo e fica em loop")
	guard.free()
	var carriers := 0
	var flock := 0
	for mid in ["city_port", "field_steppe", "dg_goblin", "fort_trolls", "fort_fire", "fort_war"]:
		for n in (gd.maps[mid] as MapDef).npcs:
			var what := str(n.get("carry", ""))
			if what != "":
				carriers += 1
				check(ResourceLoader.exists(CarryPose.model_path(what)), "%s: prop da carga '%s' existe" % [n.get("id", "?"), what])
				check(not n.has("model") and not n.has("fighter"), "%s: quem carrega é morador de kit humano" % n.get("id", "?"))
			if str(n.get("model", "")) in ["mob_sheep", "mob_goat"]:
				flock += 1
				check(ResourceLoader.exists("res://assets/models/%s.glb" % n["model"]), "%s: modelo do rebanho existe" % n.get("id", "?"))
	check(carriers >= 6, "Ato II: 6+ moradores carregam carga ou puxam carroça (%d)" % carriers)
	_check_draft_cart(gd, _sim)
	check(flock >= 4, "Estepes: rebanho do pastor com 4+ ovelhas/cabras (%d)" % flock)

func _check_living_act2(gd, sim) -> void:
	for mid in LIVING_MIN:
		var def: MapDef = gd.maps[mid]
		var mn: Array = LIVING_MIN[mid]
		var c: Dictionary = LivingAudit.census(def)
		var moving := _living_moving(def)
		check(moving >= int(mn[0]), "%s: moradores que andam >= %d (%d)" % [mid, mn[0], moving])
		check(int(c["route"]) >= int(mn[1]), "%s: moradores com ronda >= %d (%d)" % [mid, mn[1], c["route"]])
		check(int(c["guard_route"]) >= int(mn[2]), "%s: sentinelas que rondam >= %d (%d)" % [mid, mn[2], c["guard_route"]])
		check(int(c["barks"]) >= int(mn[3]), "%s: NPCs com barks >= %d (%d)" % [mid, mn[3], c["barks"]])
		check(AmbientLife.count_for(mid) >= int(mn[4]), "%s: bichos de ambiente >= %d (%d)" % [mid, mn[4], AmbientLife.count_for(mid)])
		check(int(c["mob_route"]) >= int(mn[5]), "%s: rondas de monstro >= %d (%d)" % [mid, mn[5], c["mob_route"]])
		var ref: MapDef = gd.maps[LIVING_REF[mid]]
		check(moving >= _living_moving(ref), "%s: pelo menos tão vivo quanto %s (%d x %d andando)" % [mid, ref.id, moving, _living_moving(ref)])
	check(int(LivingAudit.census(gd.maps["city_port"])["interiors"]) >= 2, "Porto: 2+ casas que abrem (taverna + armazém)")
	# bichos: tipos conhecidos
	for mid in MapsCatalog.AMBIENT_LIFE:
		check(gd.maps.has(mid), "bichos de ambiente em mapa que existe (%s)" % mid)
		for g in MapsCatalog.AMBIENT_LIFE[mid]:
			check(AmbientLife.KINDS.has(str(g[0])) and int(g[3]) > 0 and float(g[2]) > 0.0, "%s: bicho %s válido" % [mid, g[0]])
	# bicho que voa: asa recortada com cor no vértice; ave grande tem corpo; gaivota de dorso claro e ponta escura (não um quadrado branco)
	for kid in AmbientLife.KINDS:
		var ak: Dictionary = AmbientLife.KINDS[kid]
		if not bool(ak["fly"]):
			check(not bool(ak.get("shadow", false)), "ambiente: %s no chão não tem mancha de voo" % kid)
			continue
		var wm := AmbientLife.wing_mesh(ak)
		var arr: Array = wm.surface_get_arrays(0)
		var nv := (arr[Mesh.ARRAY_VERTEX] as PackedVector3Array).size()
		check(arr[Mesh.ARRAY_COLOR] != null and nv >= 15, "ambiente: asa de %s recortada com cor no vértice (%d vértices)" % [kid, nv])
		if float(ak["span"]) >= AmbientLife.BODY_MIN_SPAN:
			check(nv >= 27, "ambiente: %s tem corpo (%d vértices)" % [kid, nv])
		if kid == "gull":
			var lo := 9.0
			var hi := 0.0
			for col: Color in (arr[Mesh.ARRAY_COLOR] as PackedColorArray):
				lo = minf(lo, col.get_luminance())
				hi = maxf(hi, col.get_luminance())
			check(lo < 0.4 and hi > 0.9 and bool(ak.get("shadow", false)), "ambiente: gaivota com ponta escura, corpo claro e mancha no chão (%.2f..%.2f)" % [lo, hi])
	# barks curtos e não vazios; modelo de NPC existe; rotas e casas em chão seco e livre, pernas da rota andáveis
	var bad: Array = []
	var legs := 0
	for mid in gd.maps:
		var def: MapDef = gd.maps[mid]
		if not sim.maps.has(mid):
			sim.load_map(def)
		for n in def.npcs:
			for b in n.get("barks", []):
				if str(b).strip_edges() == "" or str(b).length() > 60:
					bad.append("%s bark '%s'" % [n["id"], b])
			if n.has("model") and not ResourceLoader.exists("res://assets/models/%s.glb" % n["model"]):
				bad.append("%s modelo %s" % [n["id"], n["model"]])
			if LIVING_MIN.has(mid) and n.has("wander") and not sim.is_walkable(n["pos"], def, 0.3):
				bad.append("%s/%s casa (%.0f, %.0f) em sólido" % [mid, n["id"], n["pos"].x, n["pos"].z])
			if not n.has("route"):
				continue
			var pts: Array = n["route"]
			for i in pts.size():
				var a := Vector3(float(pts[i][0]), 0, float(pts[i][1]))
				var b2 := Vector3(float(pts[(i + 1) % pts.size()][0]), 0, float(pts[(i + 1) % pts.size()][1]))
				var why := _wet_or_solid(sim, def, a)
				if why != "":
					bad.append("%s/%s ponto %d (%.0f, %.0f): %s" % [mid, n["id"], i, a.x, a.z, why])
				var steps := int(a.distance_to(b2) / 0.75) if LIVING_MIN.has(mid) else 0     # pernas retas: só nos mapas do Ato II
				for k in range(1, steps):
					var q := a.lerp(b2, float(k) / steps)
					if not sim.is_walkable(q, def, 0.3) or _wet_or_solid(sim, def, q) == "lago":
						bad.append("%s/%s perna %d em (%.1f, %.1f)" % [mid, n["id"], i, q.x, q.z])
						break
				legs += 1
		for sp in (def.spawners if LIVING_MIN.has(mid) else []):
			for q in sp.get("route", []):
				if _wet_or_solid(sim, def, q) != "":
					bad.append("%s ronda %s em (%.0f, %.0f)" % [mid, sp["monster_id"], q.x, q.z])
	if not bad.is_empty():
		print("LIVING_BAD ", "
LIVING_BAD ".join(bad))
	check(bad.is_empty(), "rotas/barks/modelos dos NPCs e rondas em ordem (%d: %s)" % [bad.size(), "; ".join(bad.slice(0, 8))])
	check(legs > 150, "pernas de rota conferidas (%d)" % legs)
	# pescadores no posto das varas (act2_dress fishing_pole): parados, olhando a água; no cais, sobre o tabuleiro.
	# [mapa, id, virado°, fala da margem]: a Iara dá quest, então fica na vara do cais mais perto da margem
	for fid in [["city_port", "port_vil_fisher", 90.0, true], ["city_port", "port_vil_fisher_b", 90.0, true], ["city_port", "port_vil_fisher_c", 7.0, false],
			["field_coast", "coast_fisher_shore", 352.0, true], ["field_coast", "coast_fisher_b", 349.0, true], ["field_coast", "coast_fisher_c", 356.4, true]]:
		var fn: Dictionary = {}
		for n in (gd.maps[fid[0]] as MapDef).npcs:
			if n.get("id", "") == fid[1]:
				fn = n
		var on_pier: bool = fid[0] == "city_port" and fid[3]          # cais do Porto = tabuleiro; Anselmo (fisher_c) e a costa pescam da areia: sem `perch` nem `reach`
		check(not fn.is_empty() and not fn.has("wander") and not fn.has("route") and is_equal_approx(float(fn.get("facing", -1.0)), float(fid[2])),
			"%s: pescador fica na vara olhando a água" % fid[1])
		check(is_equal_approx(float(fn.get("perch", 0.0)), MapsCatalog.PIER_DECK if on_pier else 0.0), "%s: altura do posto (cais = tabuleiro)" % fid[1])
		# conversa: o ponto andável mais perto (margem) fica ao alcance do F (2,6 m + reach)
		var home: Vector3 = fn.get("pos", Vector3.ZERO)
		var near := INF
		for dz in range(0, 80):
			var q := home + Vector3(0, 0, -dz * 0.1)
			if sim.is_walkable(q, gd.maps[fid[0]], 0.45):
				near = q.distance_to(home)
				break
		check(near - float(fn.get("reach", 0.0)) < 2.6, "%s: dá para falar com ele da margem (%.1f m, alcance extra %.1f)" % [fid[1], near, float(fn.get("reach", 0.0))])
		if not on_pier:         # na areia: chão livre e seco, a menos de 1,5 m da vara (fica atrás do cabo)
			check(sim.is_walkable(home, gd.maps[fid[0]], 0.3), "%s: posto na areia em chão livre" % fid[1])
	# cada pescador numa vara diferente; a Iara (quests do Porto) parada na vara
	var posts := {}
	for mid in ["city_port", "field_coast"]:
		for n in (gd.maps[mid] as MapDef).npcs:
			if str(n.get("id", "")).contains("fisher") and not n.has("wander") and not n.has("route"):
				var key := "%s:%d,%d" % [mid, roundi(n["pos"].x), roundi(n["pos"].z)]
				check(not posts.has(key), "%s: vara só dele (%s divide com %s)" % [n["id"], key, posts.get(key, "")])
				posts[key] = n["id"]
	check(posts.values().has("port_vil_fisher") and posts.size() >= 6, "pescadores nas varas: Iara + 5 (%s)" % [posts.values()])
	# NPC parado com `facing` olha o jogador na conversa e depois volta para o posto
	var fe: SimEntity = null
	for o in sim.maps["city_port"]["entities"]:
		if o.kind == SimEntity.Kind.NPC and o.npc_data.get("id", "") == "port_vil_fisher_c":
			fe = o
	if fe != null:
		fe.face_towards(fe.position + Vector3(0, 0, -3))
		fe.npc_hold = Balance.NPC_TALK_HOLD
		var turned := absf(angle_difference(fe.facing, deg_to_rad(7.0))) > 0.5
		for i in range(int((Balance.NPC_TALK_HOLD + 0.5) * 60)):
			sim._update_npc(fe, sim.maps["city_port"], 1.0 / 60.0)
		check(turned and absf(angle_difference(fe.facing, deg_to_rad(7.0))) < 0.01 and fe.npc_hold <= 0.0, "pescador volta a olhar a água depois da conversa")
		check(sim.is_walkable(fe.position, gd.maps["city_port"], 0.3) and float(fe.npc_data.get("reach", 0.0)) == 0.0, "Anselmo pesca da praia, em chão seco: fala-se com ele de perto, sem alcance extra")
	check(fe != null, "pescador da praia do Porto existe na sim")
	# carroça de mão em uso: um carroceiro do Porto a puxa do cais ao mercado
	check((gd.maps["city_port"] as MapDef).npcs.any(func(n): return str(n.get("carry", "")) == "cart" and n.has("route")), "Porto: um carroceiro com rota puxa a carroça de mão")
	# ronda de verdade: no porto, quem tem rota anda 2+ pernas em 60 s (sem parar num canto)
	var m: Dictionary = sim.maps["city_port"]
	var walkers: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.NPC and not o.guard and o.npc_data.has("route"))
	for i in range(60 * 60):
		for v in walkers:
			sim._update_npc(v, m, 1.0 / 60.0)
	var stuck: Array = walkers.filter(func(v): return v.npc_leg < 3).map(func(v): return v.npc_data["id"])
	check(walkers.size() >= 4 and stuck.is_empty(), "Porto: %d moradores de ronda andam a rota (travados: %s)" % [walkers.size(), str(stuck)])

## Playtest do Ato II (2026-11-12): retorno no porto depois de Terra à Vista, item de chefe garantido em coleta ativa,
## grito de moeda lendária com intervalo por mapa.
func _check_act2_playtest(gd, sim, save) -> void:
	var cls: ClassDef = gd.classes["ranger"]
	var at: Vector3 = gd.maps["city_port"].spawn_point
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Turista", "city_port", at, 30)
	e.bind_map = ""
	check(PortalSystem.home_of(e)["map"] == BotBandSystem.home_map(30), "bot sem cristal: renasce no povoado da faixa")
	check(PortalSystem.quest_bind(sim, e, "hx_crossing", false) and e.bind_map == "city_port"
		and sim.is_walkable(e.bind_pos, gd.maps["city_port"], 0.5), "Terra à Vista: retorno no cristal do porto, em chão livre")
	var c: Array = MapsCatalog.CRYSTALS["city_port"]
	check(e.bind_pos.distance_to(Vector3(float(c[0]), 0, float(c[1]))) < Balance.CRYSTAL_ARRIVE + 0.5, "retorno do porto: na frente do cristal")
	check(not PortalSystem.quest_bind(sim, e, "hx_first_wave", false), "só as quests de MapsCatalog.QUEST_BIND mudam o retorno")
	for qid in MapsCatalog.QUEST_BIND:
		check(gd.quests.has(qid) and MapsCatalog.CRYSTALS.has(MapsCatalog.QUEST_BIND[qid]), "QUEST_BIND %s: quest e cristal existem" % qid)
	# bot que conclui Terra à Vista não muda de retorno (só o jogador)
	var b: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Marujo", "city_port", at, 30)
	b.bind_map = ""
	b.quests_active["hx_crossing"] = 1
	QuestSystem.complete(b, gd.quests["hx_crossing"], sim)
	check(b.bind_map == "" and "hx_crossing" in b.quests_completed, "bot conclui Terra à Vista sem trocar o retorno")
	# save antigo: já passou de Terra à Vista e não tem cristal -> renasce no porto; com cristal, fica o dele
	var old: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Antigo", "city_aldara", gd.maps["city_aldara"].spawn_point, 30)
	save.apply_to(old, {"level": 31, "class": "ranger", "save_version": SaveSystem.VERSION, "quests_completed": ["dw_epilogue", "hx_crossing"]})
	check(old.bind_map == "city_port", "save antigo depois de Terra à Vista sem cristal: retorno no porto")
	var kept: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Fiel", "city_aldara", gd.maps["city_aldara"].spawn_point, 30)
	save.apply_to(kept, {"level": 31, "class": "ranger", "save_version": SaveSystem.VERSION, "quests_completed": ["hx_crossing"], "bind": ["field_steppe", -6.0, 7.0]})
	check(kept.bind_map == "field_steppe", "save com cristal vinculado mantém o dele")
	var fresh: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Novo", "city_aldara", gd.maps["city_aldara"].spawn_point, 5)
	save.apply_to(fresh, {"level": 5, "class": "ranger", "save_version": SaveSystem.VERSION, "quests_completed": []})
	check(fresh.bind_map == "", "save antes do porto: retorno continua na cidade inicial")
	# coleta ativa de item de chefe: o abate garante 1 para quem precisa; completa, não garante mais
	var lt: LootTable = gd.loot_tables.get(gd.monsters["boss_tide_mother"].loot_table)
	var q: QuestDef = gd.quests["hx_asc2_elementalist"]
	check(lt != null and q.type == QuestDef.Type.COLLECT and q.target_id == "tide_essence", "ascensão do Elementalista coleta Essência da Maré da Mãe das Marés")
	e.quests_active[q.id] = 0
	e.inventory.erase(q.target_id)
	check(LootSystem.quest_needs(e, lt) == ["tide_essence"], "coleta ativa: a Mãe das Marés garante a Essência da Maré")
	e.inventory[q.target_id] = q.count
	check(LootSystem.quest_needs(e, lt).is_empty(), "coleta já completa: nada garantido")
	e.quests_active.erase(q.id)
	e.inventory.erase(q.target_id)
	check(LootSystem.quest_needs(e, lt).is_empty(), "sem a quest: nada garantido")
	# abate de verdade: o chefe solta a Essência presa ao dono da quest
	e.quests_active[q.id] = 0
	var m: Dictionary = sim.maps["city_port"]
	var before: int = m["loot"].size()
	var boss: SimEntity = sim.spawn_monster(gd.monsters["boss_tide_mother"], "city_port", at + Vector3(3, 0, 0))
	LootSystem.on_monster_killed(sim, boss, e)
	var got := false
	for i in range(before, m["loot"].size()):
		var l: Dictionary = m["loot"][i]
		if l["item"] == "tide_essence" and int(l["owner"]) == e.id:
			got = true
	check(got, "abate da Mãe das Marés com a coleta ativa: Essência da Maré no chão para o dono da quest")
	e.quests_active.erase(q.id)
	sim.despawn(boss)
	# grito de moeda lendária: 1 por mapa a cada BOT_LOOT_SHOUT_GAP
	m.erase("loot_shout_at")
	check(LootSystem.loot_shout_ok(sim, "city_port") and not LootSystem.loot_shout_ok(sim, "city_port"), "grito de moeda lendária: o 2º no mesmo instante cala")
	m["loot_shout_at"] = sim.time - Balance.BOT_LOOT_SHOUT_GAP - 0.1
	check(LootSystem.loot_shout_ok(sim, "city_port"), "grito de moeda lendária: depois do intervalo, volta")
	m.erase("loot_shout_at")
	for x in [e, b, old, kept, fresh]:
		sim.despawn(x)

## Monte Kharzun (Ato II, 40-45; WP5): mapa na sim. Serviços do acampamento, cristal, portal real das Estepes (portão E5)
## com volta livre, estágios K0-K4 só por quests da lista, Contra-ataque de duas frentes, Ofensiva do aríete, guarnição.
## Missões de Kharzun (WP9): linha K0-K4 completável na ordem do plano, givers nos mapas, ids de estágio cobertos,
## cadeias das cabanas, Prova 45 (0 XP), epílogo e a festa do fim do Ato II.
func _check_kharzun_quests(gd, sim) -> void:
	var npc_map := {}
	for mid in gd.maps:
		for n in gd.maps[mid].npcs:
			npc_map[n["id"]] = mid
	var all_ids: Array = []
	for d in QuestsCatalog.act2_kharzun() + QuestsCatalog.trials45():
		all_ids.append(d["id"])
	for qid in QuestsCatalog.KHARZUN_MAIN + [QuestsCatalog.ACT2_EPILOGUE]:
		check(gd.quests.has(qid), "Kharzun: missão %s existe" % qid)
	check(QuestsCatalog.KHARZUN_MAIN.size() == 11, "Kharzun: 11 missões principais (%d)" % QuestsCatalog.KHARZUN_MAIN.size())
	for qid in MapsCatalog.KHARZUN_STAGE_QUESTS:
		check(gd.quests.has(qid) and qid in QuestsCatalog.KHARZUN_MAIN, "Kharzun: estágio %s é missão principal" % qid)
	# fontes
	var spawns := {}
	var drops := {}
	for mid in gd.maps:
		for sp in gd.maps[mid].spawners:
			spawns[sp["monster_id"]] = true
	for mon in spawns:
		var md: MonsterDef = gd.monsters.get(mon)
		if md and gd.loot_tables.has(md.loot_table):
			for en in gd.loot_tables[md.loot_table].entries:
				drops[en["item"]] = true
	var gather := {}
	for mid in MapsCatalog.GATHER:
		for g in MapsCatalog.GATHER[mid]:
			gather[g[0]] = true
	var kh: MapDef = gd.maps["field_kharzun"]
	for qid in all_ids:
		var q: QuestDef = gd.quests.get(qid)
		if q == null:
			check(false, "Kharzun: %s carregou" % qid)
			continue
		check(npc_map.has(q.giver_npc) and npc_map.has(q.turnin()), "Kharzun: %s com giver/entrega em algum mapa (%s/%s)" % [qid, q.giver_npc, q.turnin()])
		check(q.dialog_offer != "" and q.dialog_progress != "" and q.dialog_complete != "" and q.map_hint != "", "Kharzun: %s tem falas e dica" % qid)
		match q.type:
			QuestDef.Type.KILL:
				check(gd.monsters.has(q.target_id) and spawns.has(q.target_id) and Array(q.also_counts).all(func(m): return gd.monsters.has(m)), "Kharzun: %s caça %s, que nasce" % [qid, q.target_id])
			QuestDef.Type.COLLECT:
				check(gd.items.has(q.target_id) and (gather.has(q.target_id) or drops.has(q.target_id) or q.give_items.has(q.target_id)), "Kharzun: %s junta %s, que tem fonte" % [qid, q.target_id])
			QuestDef.Type.CRAFT:
				check(gd.recipes.values().any(func(r): return r.result_item == q.target_id), "Kharzun: %s forja %s, que tem receita" % [qid, q.target_id])
			QuestDef.Type.TALK:
				check(q.turnin() == q.target_id and npc_map.has(q.target_id), "Kharzun: %s conversa com quem recebe (%s)" % [qid, q.target_id])
			QuestDef.Type.REACH:
				check(gd.maps.has(q.target_id) or q.target_id in QuestsCatalog.KHARZUN_PENDING_MAPS or kh.places.any(func(pl): return pl["id"] == q.target_id),
					"Kharzun: %s chega a um lugar/mapa (%s)" % [qid, q.target_id])
	# fluxo K0 -> K4: com nível 45 e o passado das Estepes, tudo libera numa ordem só (Prova 45 pede a ascensão)
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var pl: SimEntity = ws.spawn_player(gd.classes["paladin"], "Kharzun", GameData.town_map_id())
	pl.level = 45
	pl.quests_completed.append_array(["hx_steppe_pass", "hx_deserters_help", "hx_asc_paladin"])
	var order: Array = []
	var moved := true
	while moved:
		moved = false
		for qid in all_ids:
			if gd.quests.has(qid) and not (qid in pl.quests_completed) and QuestSystem.can_accept(pl, gd.quests[qid]):
				pl.quests_completed.append(qid)
				order.append(qid)
				moved = true
	var missing: Array = all_ids.filter(func(id): return not (id in order) and not (str(id).begins_with("hx_asc45_") and id != "hx_asc45_paladin"))
	check(missing.is_empty(), "Kharzun: toda missão é alcançável (faltam %s)" % [missing])
	check(order.find("hx_mines") < order.find("hx_kennel") and order.find("hx_mines") < order.find("hx_black_forge")
		and order.find("hx_slayers_open") < order.find("hx_slayers") and order.find("hx_kennel") < order.find("hx_slayers")
		and order.find("hx_black_forge") < order.find("hx_slayers") and order.find("hx_slayers") < order.find("hx_citadel_gate")
		and order.find("hx_warlord") < order.find(QuestsCatalog.ACT2_EPILOGUE),
		"Kharzun: K1 -> K1b/K1c -> K1d (porta do Xamã) -> K2 -> ... -> K4 -> epílogo (%s)" % [order])
	for c in MapsCatalog.Q_KH_CLANS:
		check(gd.quests[c].prereq_quest == MapsCatalog.Q_KH_GATE, "Kharzun: %s abre com o Portão (qualquer ordem)" % c)
	var wl: QuestDef = gd.quests[MapsCatalog.Q_KH_WARLORD]
	var need: Array = [wl.prereq_quest] + Array(wl.prereq_all)
	check(MapsCatalog.Q_KH_CLANS.all(func(c): return c in need), "Kharzun: o Trono pede os três clãs (K3)")
	var pl2: SimEntity = ws.spawn_player(gd.classes["paladin"], "Kharzun2", GameData.town_map_id())
	pl2.level = 45
	pl2.quests_completed.append_array(["hx_clan_wolf", "hx_clan_stone"])
	check(not QuestSystem.can_accept(pl2, wl), "Kharzun: com dois clãs o Trono não abre")
	check(gd.quests["hx_xs_brakka"].prereq_all.has("hx_deserters_help"), "Kharzun: o passo extra do Xamã só para quem ajudou os Desertores")
	# cadeias das cabanas (2-4) e PENDING vazio
	for giver in QuestsCatalog.KHARZUN_CHAINS:
		var n := 0
		var cur: String = QuestsCatalog.KHARZUN_CHAINS[giver]
		while cur != "" and gd.quests.has(cur) and not (cur in QuestsCatalog.KHARZUN_MAIN) and not cur.begins_with("hx_steppe") and not cur.begins_with("hx_kh_"):
			n += 1
			cur = gd.quests[cur].prereq_quest
		check(n >= 2 and n <= 4, "Kharzun: cadeia de %s tem 2-4 missões (%d)" % [giver, n])
	for cab in ["exiled_shaman", "freed_foreman"]:
		check(gd.quests.values().any(func(o): return o.giver_npc == cab and not o.repeatable), "Kharzun: a cabana %s dá missão" % cab)
	check(MapsCatalog.PENDING_GIVERS.is_empty(), "Kharzun: nenhuma cabana espera missão")
	# quadro de caçadas e Brasas
	check(QuestsCatalog.HUNT_GIVERS.get("field_kharzun", "") == "kharzun_board", "Kharzun: o quadro do acampamento paga as caçadas")
	check(gd.quests.has("h_dire_wolf") and gd.quests["h_dire_wolf"].giver_npc == "kharzun_board", "Kharzun: caçada de Lobo Atroz no quadro")
	check(gd.quests["hx_bf_embers"].repeatable and gd.quests["hx_bf_embers"].prereq_quest == MapsCatalog.Q_KH_FORGE, "Kharzun: Brasas da Forja repetível depois da Forja")
	# XP: peso da faixa 40-45 (a fração 40-50% vale quando Balance.XP_BANDS tiver [40, 45])
	var sum := 0
	var cnt := 0
	for qid in all_ids:
		var q: QuestDef = gd.quests[qid]
		if not q.repeatable and q.level_req >= 40 and q.level_req < 45:
			sum += q.reward_xp
			cnt += 1
	check(cnt >= 10 and sum > 0, "Kharzun: %d missões com XP na faixa 40-45" % cnt)
	if Balance.XP_BANDS.any(func(bd): return bd[0] == 40):
		var share: float = sum / float(Balance.band_xp(40, 45))
		check(share >= 0.38 and share <= 0.53, "Kharzun: missões dão %.0f%% da XP 40-45" % (share * 100.0))
	# Prova 45: uma por classe, só a classe, 0 XP, depois da ascensão
	for cid in gd.classes:
		var q: QuestDef = gd.quests.get("hx_asc45_" + cid)
		check(q != null and q.reward_xp == 0 and q.level_req == Balance.ASC_MAX_LEVEL and q.prereq_quest == "hx_asc_" + cid and q.giver_npc == "masters_herald"
			and QuestsCatalog.class_of(q.id) == cid and q.reward_items.has("legend_coin"), "Prova 45 de %s: Arauto, 45, ascensão, 0 XP, moedas" % cid)
	var bp: SimEntity = ws.spawn_player(gd.classes["bishop"], "Bispo", GameData.town_map_id())
	bp.level = 45
	bp.quests_completed.append_array(["hx_asc_paladin", "hx_asc_bishop"])
	check(not QuestSystem.can_accept(bp, gd.quests["hx_asc45_paladin"]) and QuestSystem.can_accept(bp, gd.quests["hx_asc45_bishop"]), "Prova 45: só a classe dela")
	# epílogo e fim do Ato II
	var ep: QuestDef = gd.quests[QuestsCatalog.ACT2_EPILOGUE]
	check(MapsCatalog.ACT2_END_QUEST == ep.id and ep.prereq_quest == MapsCatalog.VICTORY2_QUEST and MapsCatalog.VICTORY2_QUEST == MapsCatalog.Q_KH_WARLORD
		and ep.giver_npc == "kharzun_commander" and ep.turnin_npc == "port_governor" and npc_map.get("port_governor", "") == "city_port",
		"Fim do Ato II: epílogo sai da Comandante depois do Trono e volta à Governadora no porto")
	var H = load("res://game/ui/hud.gd")
	check(H.ACT_END_TEXT.has(1) and H.ACT_END_TEXT.has(2) and str(H.ACT_END_TEXT[2][0]) == "FIM DO ATO II" and str(H.ACT_END_TEXT[2][2]).count("%s") == 1, "Fim do Ato II: tela com texto próprio")
	for mid in MapsCatalog.FESTIVAL_ACT2:
		var def: MapDef = gd.maps[mid]
		var fest: Array = def.npcs.filter(func(n): return str(n["id"]).begins_with("fest2_"))
		check(fest.size() == (MapsCatalog.FESTIVAL_ACT2[mid] as Dictionary).size() and fest.all(func(n): return n.get("if", "") == MapsCatalog.VICTORY2_QUEST),
			"%s: festeiros do Ato II só depois do Trono (%d)" % [mid, fest.size()])
		var ws3 := WorldSim.new()
		ws3.load_map(gd.maps[GameData.town_map_id()])
		var m: Dictionary = ws3.load_map(def)
		for n in fest:
			check(ws3.is_walkable(n["pos"], def, 0.4) and (n["pos"] as Vector3).distance_to(def.town_center) < def.town_radius, "%s: festeiro %s em chão andável na praça (%s)" % [mid, n["id"], n["pos"]])
		ws3.player = ws3.spawn_player(gd.classes["paladin"], "Festa", def.id)
		var live := func() -> int:
			return m["entities"].filter(func(e): return str(e.npc_data.get("id", "")).begins_with("fest2_")).size()
		WorldState.sync_npcs(ws3, m)
		check(live.call() == 0, "%s: antes do Trono ninguém festeja" % mid)
		ws3.player.quests_completed.append(MapsCatalog.VICTORY2_QUEST)
		WorldState.sync_npcs(ws3, m)
		check(live.call() == fest.size(), "%s: Durgash caído, os festeiros aparecem (%d)" % [mid, live.call()])

func _check_kharzun_map(gd, sim) -> void:
	check(gd.maps.has("field_kharzun"), "Kharzun: mapa existe")
	if not gd.maps.has("field_kharzun"):
		return
	var kh: MapDef = gd.maps["field_kharzun"]
	var steppe: MapDef = gd.maps["field_steppe"]
	check(kh.level_range == Vector2i(40, 45) and kh.hub and not kh.is_town and kh.parent_map == "" and kh.bot_population > 0, "Kharzun: campo 40-45 com acampamento e bots")
	check(kh.has_hunting() and kh.spawners.size() >= 30, "Kharzun: campo de caça (%d spawners)" % kh.spawners.size())
	check(kh.model == "map_field_kharzun" and Music.theme_for("field_kharzun") != "", "Kharzun: modelo e tema de música")
	var ids := {}
	for n in kh.npcs:
		ids[n["id"]] = n
	for id in ["kharzun_commander", "kharzun_smith", "kharzun_alchemist", "kharzun_merchant", "kharzun_storage", "kharzun_board", "masters_herald", "crystal_field_kharzun"]:
		check(ids.has(id) and not ids[id].has("if") and not ids[id].has("unless"), "Kharzun: %s no acampamento desde o K0" % id)
	check(MapsCatalog.CRYSTALS.has("field_kharzun") and Vector2(MapsCatalog.CRYSTALS["field_kharzun"][0], MapsCatalog.CRYSTALS["field_kharzun"][1]).length() < kh.town_radius, "Kharzun: cristal dentro do acampamento")
	check(ids.get("dwarf_smith", {}).get("if", "") == MapsCatalog.Q_KH_MINES and ids.get("kharzun_arms_merchant", {}).get("if", "") == MapsCatalog.Q_KH_FORGE
		and ids.get("mine_slave_a", {}).get("unless", "") == MapsCatalog.Q_KH_MINES and ids.get("kharzun_orc_surrendered_a", {}).get("if", "") == MapsCatalog.Q_KH_WARLORD,
		"Kharzun: Ferreiro Anão (K1), armeira da Forja (K1c), escravos até K1 e orcs rendidos (K4)")
	var guards: Array = kh.npcs.filter(func(n): return n.has("fighter"))
	check(guards.size() >= 9 and guards.all(func(n): return is_equal_approx(float(n.get("power", 1.0)), Balance.KHARZUN_GUARD_POWER)), "Kharzun: guarnição de %d com KHARZUN_GUARD_POWER" % guards.size())
	# toda regra de estágio cita uma quest K0-K4 conhecida
	var rules: Array = kh.spawners + kh.npcs + kh.conquest_vis + kh.raids + kh.assaults + kh.obstacles + ([kh.raid] if not kh.raid.is_empty() else [])
	var bad: Array = []
	for r in rules:
		for k in ["if", "unless"]:
			if r.has(k):
				for q in (r[k] if r[k] is Array else [r[k]]):
					if not q in MapsCatalog.KHARZUN_STAGE_QUESTS and not (q in MapsCatalog.KHARZUN_SIDE_QUESTS and r in kh.npcs):
						bad.append(str(q))
	check(bad.is_empty(), "Kharzun: estágios só por quests K0-K4 (%s)" % [bad])
	check(kh.conquest_vis.size() >= 15, "Kharzun: peças do GLB trocam com o estágio (%d)" % kh.conquest_vis.size())
	for sp in kh.spawners:
		check(gd.monsters.has(sp["monster_id"]), "Kharzun: spawner de monstro que existe (%s)" % sp["monster_id"])
	# portal real das Estepes (E5) e volta livre
	var go: Array = steppe.portals.filter(func(p): return p["target_map"] == "field_kharzun")
	var back: Array = kh.portals.filter(func(p): return p["target_map"] == "field_steppe")
	check(go.size() == 1 and back.size() == 1, "Kharzun: um portal de ida nas Estepes e um de volta")
	if go.size() == 1 and back.size() == 1:
		check(go[0]["id"] == "to_field_kharzun" and go[0].get("gate", {}) == MapsCatalog.PORTAL_GATES["to_field_kharzun"], "Kharzun: a ida tem o portão E5")
		check((back[0] as Dictionary).get("gate", {}).is_empty(), "Kharzun: a volta para as Estepes não tem portão")
		check((go[0]["target_pos"] as Vector3).distance_to(kh.spawn_point) < 1.0, "Kharzun: chega das Estepes no ponto de chegada")
		var d: float = (back[0]["target_pos"] as Vector3).distance_to(go[0]["pos"])
		check(d > 5.0 and d < 16.0, "Estepes: quem volta de Kharzun aparece na frente do passo, fora do portal (%.1f m)" % d)
		var ws := WorldSim.new()
		ws.load_map(gd.maps[GameData.town_map_id()])
		ws.load_map(steppe)
		var pl: SimEntity = ws.spawn_player(gd.classes["paladin"], "Passo", "field_steppe")
		pl.level = 40
		check(PortalSystem.portal_block_reason(ws, pl, go[0]) != "", "KAC-01: nível 40 sem os acampamentos não passa")
		pl.quests_completed.append_array(MapsCatalog.Q_STEPPE_FORTS)
		pl.level = 39
		check(PortalSystem.portal_block_reason(ws, pl, go[0]) != "", "KAC-01: nível 39 com os acampamentos não passa")
		pl.level = 40
		check(PortalSystem.portal_block_reason(ws, pl, go[0]) == "", "KAC-01: nível 40 com os três acampamentos passa")
	check(not (steppe.obstacles.any(func(o): return o.get("kind", "") == "wall" and not o.get("visible", true) and (o["pos"] as Vector3).distance_to(Vector3(0, 0, -106.2)) < 1.0)),
		"Estepes: o muro provisório do passo saiu")
	# Contra-ataque: Canil e Cidadela, calados em K1b/K2; Ofensiva do aríete depois do K2
	var routes: Array = RaidSystem.routes(kh)
	var km: Dictionary = sim.maps["field_kharzun"] if sim.maps.has("field_kharzun") else sim.load_map(kh)
	var sides := {}
	for r in routes:
		sides[str(r.get("side", ""))] = str(r.get("unless", ""))
		for w in r.get("waves", []):
			for k in w["mobs"]:
				check(gd.monsters.has(k), "Kharzun: leva %s com monstro que existe (%s)" % [r.get("side", ""), k])
		for q in r["route"]:
			check(not MapGeometry.point_in_solid(sim, q, km), "Kharzun: rota %s passa por chão livre em %s" % [r.get("side", ""), q])
	check(sides == {"kennel": MapsCatalog.Q_KH_KENNEL, "citadel": MapsCatalog.Q_KH_GATE}, "Kharzun: Contra-ataque de Canil (até K1b) e Cidadela (até K2): %s" % [sides])
	check(kh.assaults.size() == 1 and kh.assaults[0].get("if", "") == MapsCatalog.Q_KH_GATE and kh.assaults[0].has("fighters"), "Kharzun: Ofensiva do aríete sobe depois do K2")
	# estágio de verdade (WorldState): portão da cidadela guardado até K2; Forja da Horda até K1c
	var ws2 := WorldSim.new()
	ws2.load_map(gd.maps[GameData.town_map_id()])
	ws2.load_map(kh)
	ws2.player = ws2.spawn_player(gd.classes["paladin"], "Estagio", "field_kharzun")
	var gate_sp: Array = kh.spawners.filter(func(sp): return sp["monster_id"] == "clan_guard" and str(sp.get("unless", "")) == MapsCatalog.Q_KH_GATE)
	var forge_sp: Array = kh.spawners.filter(func(sp): return str(sp.get("unless", "")) == MapsCatalog.Q_KH_FORGE)
	check(gate_sp.size() == 1 and forge_sp.size() >= 2 and WorldState.active(ws2, gate_sp[0]) and WorldState.active(ws2, forge_sp[0]), "Kharzun K0: Horda no portão e na Forja")
	ws2.player.quests_completed.append_array([MapsCatalog.Q_KH_FORGE, MapsCatalog.Q_KH_GATE])
	if gate_sp.size() == 1 and forge_sp.size() >= 2:
		check(not WorldState.active(ws2, gate_sp[0]) and not WorldState.active(ws2, forge_sp[0]), "Kharzun K1c/K2: Forja e portão retomados")
	# bots: 41 caça aqui, 38 não escolhe Kharzun (faixa de _plan_trip)
	check(41 >= kh.level_range.x - 1 and 38 < kh.level_range.x - 1, "KAC-02: bot 41 entra na faixa de Kharzun, 38 não")
	# atravessar a lava pela ponte (água que colide, como o rio)
	var m: Dictionary = ws2.maps["field_kharzun"]
	check((m["bridges"] as Array).size() >= 2, "Kharzun: pontes de basalto sobre a lava (%d)" % (m["bridges"] as Array).size())
	for br in m["bridges"]:
		check(ws2.is_walkable(Vector3(br["pos"].x, 0, br["pos"].y), kh, 0.45), "Kharzun: ponte andável em %s" % br["pos"])

## Salão dos Matadores e Cidadela de Kharzun (KAC-05): portões (missão / nível 43 + K2), masmorras do Monte Kharzun, as
## três alas alcançáveis em qualquer ordem, trono fechado até os três clãs (K3) e aberto depois, Ofensiva chega ao pátio.
func _check_kharzun_citadel(gd, sim) -> void:
	check(gd.maps.has(MapsCatalog.CITADEL_ID) and gd.maps.has("dg_slayers"), "Cidadela e Salão dos Matadores: mapas existem")
	if not (gd.maps.has(MapsCatalog.CITADEL_ID) and gd.maps.has("dg_slayers")):
		return
	var kh: MapDef = gd.maps["field_kharzun"]
	var cd: MapDef = gd.maps[MapsCatalog.CITADEL_ID]
	var sl: MapDef = gd.maps["dg_slayers"]
	check(cd.parent_map == "field_kharzun" and cd.level_range == Vector2i(44, 45) and MapBuilder.is_dungeon(cd) and cd.bot_population == 0,
		"Cidadela: masmorra 44-45 do Monte Kharzun (sem montaria, bots só com o grupo)")
	check(sl.parent_map == "field_kharzun" and sl.level_range == Vector2i(42, 44), "Matadores: masmorra 42-44 do Monte Kharzun")
	check(Music.theme_for(cd.id) != "" and Music.theme_for(sl.id) != "", "Cidadela e Matadores: tema de música")
	check(FileAccess.file_exists("res://assets/models/map_%s.glb" % cd.id), "Cidadela: GLB existe")
	var z: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MapsCatalog.ZONE_PATH % "field_kharzun"))
	check(not z.has("future_portals"), "Kharzun: os portais do Salão e da Cidadela viraram portais de verdade")
	# ---- portões: ida com portão, volta livre e junto da entrada ----
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	ws.load_map(kh)
	var pl: SimEntity = ws.spawn_player(gd.classes["paladin"], "Portao", "field_kharzun")
	for row in [[cd, "to_kharzun_citadel"], [sl, "to_dg_slayers"]]:
		var md: MapDef = row[0]
		var go: Array = kh.portals.filter(func(p): return p["target_map"] == md.id)
		var back: Array = md.portals.filter(func(p): return p["target_map"] == "field_kharzun")
		check(go.size() == 1 and back.size() == 1 and go[0]["id"] == row[1], "%s: um portal de ida (%s) e um de volta" % [md.id, row[1]])
		if go.size() != 1 or back.size() != 1:
			continue
		check(go[0].get("gate", {}) == MapsCatalog.PORTAL_GATES[row[1]] and (back[0] as Dictionary).get("gate", {}).is_empty(), "%s: portão só na ida" % md.id)
		check((go[0]["target_pos"] as Vector3).distance_to(md.spawn_point) < 1.0, "%s: chega no ponto de chegada" % md.id)
		var d: float = (back[0]["target_pos"] as Vector3).distance_to(go[0]["pos"])
		check(d > 3.0 and d < 16.0 and ws.is_walkable(back[0]["target_pos"], kh, 0.45), "%s: a volta aparece diante da entrada (%.1f m)" % [md.id, d])
	var go_c: Dictionary = kh.portals.filter(func(p): return p["target_map"] == cd.id)[0]
	var go_s: Dictionary = kh.portals.filter(func(p): return p["target_map"] == sl.id)[0]
	var gate_c: Dictionary = MapsCatalog.PORTAL_GATES["to_kharzun_citadel"]
	check(int(gate_c.get("level", 0)) == 43 and gate_c.get("quest", "") == MapsCatalog.Q_KH_GATE, "Cidadela: portão pede nível 43 e o aríete (K2)")
	check(not MapsCatalog.PORTAL_GATES["to_dg_slayers"].has("level") and MapsCatalog.PORTAL_GATES["to_dg_slayers"].get("quest", "") == "hx_slayers_open", "Matadores: portão de missão, sem nível")
	pl.level = 44
	check(PortalSystem.portal_block_reason(ws, pl, go_c) != "", "Cidadela: nível 44 sem o aríete não entra")
	check(PortalSystem.portal_block_reason(ws, pl, go_s) != "", "Matadores: sem a palavra do Xamã não entra")
	pl.quests_completed.append_array([MapsCatalog.Q_KH_GATE, "hx_slayers_open"])
	pl.level = 42
	check(PortalSystem.portal_block_reason(ws, pl, go_c) != "", "Cidadela: nível 42 com o aríete não entra")
	check(PortalSystem.portal_block_reason(ws, pl, go_s) == "", "Matadores: com a palavra do Xamã entra em qualquer nível")
	pl.level = 43
	check(PortalSystem.portal_block_reason(ws, pl, go_c) == "", "Cidadela: nível 43 com o aríete entra")
	for q in MapsCatalog.PENDING_GATE_QUESTS:
		check(not gd.quests.has(q), "portões: %s já existe, tire de PENDING_GATE_QUESTS" % q)
	# ---- Salão dos Matadores: quatro salões, elenco do plano, chefe no fundo ----
	var sl_ids := {}
	for sp in sl.spawners:
		sl_ids[sp["monster_id"]] = int(sl_ids.get(sp["monster_id"], 0)) + int(sp["count"])
		check(gd.monsters.has(sp["monster_id"]), "Matadores: spawner de monstro que existe (%s)" % sp["monster_id"])
	check(sl_ids.has("goblin_slayer") and sl_ids.has("goblin_assassin") and sl_ids.has("orc_fire_archer") and sl_ids.has(MapsCatalog.mob("boss_shazka")),
		"Matadores: Assassinos, Matadores, Arcos de Fogo e o Mestre (%s)" % [sl_ids])
	var sz: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MapsCatalog.ZONE_PATH % "dg_slayers"))
	check((sz["roads"] as Array).filter(func(r): return r["kind"] == "street").size() >= 5, "Matadores: chegada + 4 salões")
	# ---- Cidadela: dados das arenas e das alas ----
	var data := MapsCatalog.citadel_data()
	var arenas: Dictionary = data.get("arenas", {})
	var wings: Dictionary = data.get("wings", {})
	var chiefs := ["boss_ulgra", "boss_gorbash", "boss_kragmar"]
	check(chiefs.all(func(b): return arenas.has(b)) and arenas.has("boss_durgash"), "Cidadela: arena de cada chefe de clã e do trono no JSON (%s)" % [arenas.keys()])
	check(wings.size() == 3 and wings.values().map(func(w): return w["quest"]) == Array(MapsCatalog.Q_KH_CLANS), "Cidadela: três alas (Lobo, Pedra, Forja) com a quest do clã")
	if not (chiefs.all(func(b): return arenas.has(b)) and arenas.has("boss_durgash") and wings.size() == 3):
		return
	var at := func(a: Array) -> Vector3: return Vector3(float(a[0]), 0, float(a[1]))
	var throne: Vector3 = at.call(arenas["boss_durgash"]["pos"])
	var door: Vector3 = at.call(arenas["boss_durgash"]["door"])
	var door_front := door + Vector3(0, 0, 8.0)                 # antecâmara, do lado de quem chega
	var banners: Array = (arenas["boss_durgash"]["banners"] as Dictionary).values().map(func(a): return at.call(a))
	check(banners.size() == 3 and banners.all(func(b): return b.distance_to(throne) < float(arenas["boss_durgash"]["r"]) - 4.0)
		and banners[0].distance_to(banners[1]) > 10.0 and banners[1].distance_to(banners[2]) > 10.0 and banners[0].distance_to(banners[2]) > 10.0,
		"Cidadela: três soquetes de Estandarte de Clã dentro da sala do trono, afastados")
	check(float(arenas["boss_durgash"]["r"]) >= 20.0 and chiefs.all(func(b): return float(arenas[b]["r"]) >= 14.0), "Cidadela: arenas largas (clãs >= 14 m, trono >= 20 m)")
	var mobs := 0
	var bosses := 0
	for sp in cd.spawners:
		check(gd.monsters.has(sp["monster_id"]), "Cidadela: spawner de monstro que existe (%s)" % sp["monster_id"])
		var md2: MonsterDef = gd.monsters.get(sp["monster_id"])
		if md2 == null:
			continue
		bosses += 1 if md2.is_boss else 0
		mobs += int(sp["count"]) * (1 + int(md2.escort.get("count", 0)) if not md2.escort.is_empty() else 1)
	check(bosses == 4, "Cidadela: três chefes de clã e o Grão-Senhor (%d)" % bosses)
	check(mobs >= 50 and mobs <= 120, "Cidadela: %d monstros com as escoltas (orçamento: até 120)" % mobs)
	for id in ["clan_guard", "orc_warlord", "troll_brute", "basalt_golem", "dire_wolf_rider", "lava_salamander"]:
		check(cd.spawners.any(func(sp): return sp["monster_id"] == id), "Cidadela: %s no elenco" % id)
	# regras de estágio só com quests K
	var bad: Array = []
	for r in cd.spawners + cd.conquest_vis + cd.assaults + cd.obstacles:
		for k in ["if", "unless"]:
			if r.has(k):
				for q in (r[k] if r[k] is Array else [r[k]]):
					if not q in MapsCatalog.KHARZUN_STAGE_QUESTS:
						bad.append(str(q))
	check(bad.is_empty(), "Cidadela: estágios só por quests K0-K4 (%s)" % [bad])
	var seals: Array = cd.obstacles.filter(func(ob): return ob.get("solid", true) and ob.has("unless"))
	check(seals.size() == 1 and Array(seals[0]["unless"]) == Array(MapsCatalog.Q_KH_CLANS) and (seals[0]["pos"] as Vector3).distance_to(door) < 1.0,
		"Cidadela: a porta do trono é o único colisor de estágio (até os três clãs)")
	var dsp: Array = cd.spawners.filter(func(sp): return sp["monster_id"] == MapsCatalog.mob("boss_durgash") and sp.has("if"))
	check(dsp.size() == 1 and Array(dsp[0]["if"]) == Array(MapsCatalog.Q_KH_CLANS) and (dsp[0]["pos"] as Vector3).distance_to(throne) < 1.0, "Cidadela: Durgash só nasce no trono com os três clãs caídos")
	# peças do GLB que trocam existem com o nome da regra
	var f := FileAccess.open("res://assets/models/map_%s.glb" % cd.id, FileAccess.READ)
	if f != null:
		f.seek(12)
		var n := f.get_32()
		f.get_32()
		var doc: Dictionary = JSON.parse_string(f.get_buffer(n).get_string_from_utf8())
		var names: Array = (doc.get("nodes", []) as Array).map(func(nd): return str(nd.get("name", "")))
		for cv in cd.conquest_vis:
			check(names.any(func(nm): return nm.contains(str(cv["tag"]))), "Cidadela: peça %s existe no GLB" % cv["tag"])
	check(cd.conquest_vis.size() == 8, "Cidadela: porta do trono e um braseiro por clã trocam com o estágio")
	# ---- alcance (sem jogador nenhuma quest vale: porta fechada) ----
	sim.load_map(cd)
	var seen := _reach(sim, cd, cd.spawn_point)
	for sp in cd.spawners:
		if not sp.has("if"):
			check(_reached(seen, sp["pos"]), "Cidadela: spawner %s alcançável a pé" % sp["monster_id"])
	for pt in cd.portals:
		check(_reached(seen, pt["pos"]), "Cidadela: portal %s alcançável" % pt["id"])
	for b in chiefs:
		check(_reached(seen, at.call(arenas[b]["pos"])), "Cidadela: arena de %s alcançável" % b)
	check(_reached(seen, door_front), "Cidadela: antecâmara do trono alcançável")
	check(not _reached(seen, throne) and banners.all(func(b): return not _reached(seen, b)), "Cidadela: sala do trono fechada antes dos três clãs")
	for w in wings:                              # fechar uma ala (boca do 1º corredor) não fecha as outras nem a antecâmara
		var cut := _reach(sim, cd, cd.spawn_point, at.call(wings[w]["mouth"]), 8.0)
		check(not _reached(cut, at.call(arenas[wings[w]["boss"]]["pos"])), "Cidadela: a ala %s só tem a boca do pátio" % w)
		for o in wings:
			if o != w:
				check(_reached(cut, at.call(arenas[wings[o]["boss"]]["pos"])), "Cidadela: com a ala %s fechada, a ala %s continua alcançável" % [w, o])
		check(_reached(cut, door_front), "Cidadela: com a ala %s fechada, a porta do trono continua alcançável" % w)
	# ---- K3 de verdade (WorldState): dois clãs não abrem, três abrem; Durgash nasce ----
	var w2 := WorldSim.new()
	w2.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = w2.load_map(cd)
	w2.player = w2.spawn_player(gd.classes["paladin"], "Trono", cd.id)
	check(not _reached(_reach(w2, cd, cd.spawn_point), throne) and not WorldState.active(w2, dsp[0] if dsp.size() == 1 else {"if": "x"}), "Cidadela K2: trono fechado e vazio")
	w2.player.quests_completed.append_array(["hx_clan_wolf", "hx_clan_forge"])
	MapGeometry.sync_stage(w2, m)
	check(not _reached(_reach(w2, cd, cd.spawn_point), throne), "Cidadela: com dois clãs o trono continua fechado")
	w2.player.quests_completed.append("hx_clan_stone")
	MapGeometry.sync_stage(w2, m)
	var open := _reach(w2, cd, cd.spawn_point)
	check(_reached(open, throne) and banners.all(func(b): return _reached(open, b)), "Cidadela K3: com os três clãs o trono abre (KAC-05)")
	check(dsp.size() == 1 and WorldState.active(w2, dsp[0]), "Cidadela K3: Durgash nasce")
	for w in wings:
		var cut := _reach(w2, cd, cd.spawn_point, at.call(wings[w]["mouth"]), 8.0)
		check(_reached(cut, throne), "Cidadela K3: com a ala %s fechada, o trono continua alcançável" % w)
	# ---- Ofensiva da Aurora: nasce com o K2, some com o K4, anda até o pátio ----
	check(cd.assaults.size() == 1 and cd.assaults[0].get("if", "") == MapsCatalog.Q_KH_GATE and cd.assaults[0].get("unless", "") == MapsCatalog.Q_KH_WARLORD
		and cd.assaults[0].has("fighters"), "Cidadela: Ofensiva da Aurora do K2 ao K4")
	if cd.assaults.size() != 1:
		return
	var patio := Vector3(float(data["town"]["center"][0]), 0, float(data["town"]["center"][1]))
	check((cd.assaults[0]["target"] as Vector3).distance_to(patio) < 12.0, "Cidadela: a Ofensiva mira o pátio de armas")
	var w3 := WorldSim.new()
	w3.load_map(gd.maps[GameData.town_map_id()])
	var m3: Dictionary = w3.load_map(cd)
	w3.player = w3.spawn_player(gd.classes["paladin"], "Marcha", cd.id)
	w3.player.quests_completed.append(MapsCatalog.Q_KH_GATE)
	var first: Array = []
	for i in int(70.0 * 20):
		for e in m3["entities"].duplicate():
			if e.kind == SimEntity.Kind.MONSTER and not e.guard:
				w3.despawn(e)                     # caminho livre: só a rota está em teste
		w3.tick(0.05)
		if first.is_empty():
			first = m3["entities"].filter(func(e): return e.guard and str(e.npc_data.get("id", "")).begins_with("assault_"))
	var last_leg: int = cd.assaults[0]["route"].size()
	var stuck: Array = []
	for e in first:
		if is_instance_valid(e) and e.is_alive() and (e.raid_leg < last_leg or e.position.distance_to(patio) > 22.0):
			stuck.append("%s leg %d em (%.0f, %.0f)" % [e.npc_data.get("id", "?"), e.raid_leg, e.position.x, e.position.z])
	check(not first.is_empty() and first.size() <= Balance.ASSAULT_FORT_MAX and stuck.is_empty(), "Cidadela: a primeira leva da Ofensiva (%d) chega ao pátio em 70 s (%s)" % [first.size(), stuck])

## Kharzun WP10 (KAC-14): Ferreiro Anão aprimora lendário 40+ (Aço Anão / Brasa), lobo atroz, joias 45, título da Prova 45, brasa colhível no K1c.
func _check_kharzun_rewards(gd, sim) -> void:
	var cls: ClassDef = gd.classes["berserker"]
	var l40: ItemDef = gd.items[gd.legendary_pool(cls, 40)[0]]
	var l35: ItemDef = gd.items[gd.legendary_pool(cls, 35)[0]]
	var c1: Dictionary = sim.enhance_cost(l40, 0)
	var c6: Dictionary = sim.enhance_cost(l40, Balance.PLUS_STAR_FROM - 1)
	check(c1["item"] == "dwarf_steel" and c6["item"] == "kharzun_ember_core", "Kharzun: lendário 40 aprimora com Aço Anão e, do +6, Brasa (%s, %s)" % [c1["item"], c6["item"]])
	check(sim.enhance_cost(l35, 0)["item"] == "holy_silver", "Kharzun: lendário 35 continua na Prata Consagrada")
	var l45ids: Array = gd.legendary_pool(cls, 45)
	check(not l45ids.is_empty() and sim.enhance_cost(gd.items[l45ids[0]], 0)["item"] == "dwarf_steel", "Kharzun: lendário 45 também usa Aço Anão")
	var steel := 0
	var ember := 0
	for i in range(Balance.PLUS_MAX):
		var c: Dictionary = sim.enhance_cost(l40, i)
		if c["item"] == "dwarf_steel":
			steel += int(c["count"])
		else:
			ember += int(c["count"])
	check(steel >= 10 and ember >= 8, "Kharzun: +9 custa %d Aço Anão e %d Brasas" % [steel, ember])
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	ws.load_map(gd.maps["field_kharzun"])
	var p: SimEntity = ws.spawn_player(cls, "Anao", "field_kharzun")
	p.level = 45
	p.gold = 10_000_000
	p.add_item("dwarf_steel", steel)
	p.add_item("kharzun_ember_core", ember)
	p.add_item(l40.id, 1)
	check(ws.enhance_error(p, l40.id) != "" and ws.enhance_error(p, l40.id, -1, "kharzun_smith") != "", "Kharzun: lendário 40 recusado fora do Ferreiro Anão")
	check(ws.enhance_error(p, l40.id, -1, "dwarf_smith") == "", "Kharzun: Thrain aprimora lendário 40 (%s)" % ws.enhance_error(p, l40.id, -1, "dwarf_smith"))
	var cur: ItemDef = l40
	for i in range(Balance.PLUS_MAX):
		var nx: ItemDef = ws.enhance(p, cur.id, -1, "dwarf_smith")
		if nx == null:
			break
		cur = nx
	check(cur.plus == Balance.PLUS_MAX and int(p.inventory.get("dwarf_steel", 0)) == 0 and int(p.inventory.get("kharzun_ember_core", 0)) == 0, "Kharzun: Thrain leva o lendário 40 a +9 (+%d)" % cur.plus)
	var thrain: Dictionary = {}
	var keeper: Dictionary = {}
	for n in gd.maps["field_kharzun"].npcs:
		if n["id"] == "dwarf_smith":
			thrain = n
		if n["id"] == "kharzun_wolf_keeper":
			keeper = n
	check(thrain.get("role", "") == "smith" and (thrain.get("dialog_after", {}) as Dictionary).has("hx_dw_forge"), "Kharzun: Thrain fala do aprimoramento depois de hx_dw_forge")
	# tratadora: falas de base = lobo travado (citam a missão), dialog_after da missão do lobo = liberado
	var wolf_q: String = Balance.MOUNT_KINDS["dire_wolf"]["quest"]
	var keeper_base: Array = keeper.get("dialog", [])
	var keeper_after: Array = (keeper.get("dialog_after", {}) as Dictionary).get(wolf_q, [])
	check(not keeper_base.is_empty() and keeper_base.all(func(l): return not str(l).contains("escolheu você")) and str(keeper_base[0]).contains(gd.quests[wolf_q].title),
		"tratadora: travado, a fala aponta para \"%s\" (%s)" % [gd.quests[wolf_q].title, keeper_base])
	check(keeper_after.any(func(l): return str(l).contains("escolheu você")), "tratadora: com %s a fala é do lobo liberado" % wolf_q)
	# lobo atroz (D5)
	check(Balance.MOUNT_KINDS.has("dire_wolf") and Balance.MOUNT_KINDS["dire_wolf"]["quest"] == "hx_ov_hatch" and gd.quests.has("hx_ov_hatch"), "Kharzun: lobo atroz liberado por hx_ov_hatch")
	for k in Balance.MOUNT_KINDS:
		check(EntityView.MOUNT_LOOKS.has(k) and ResourceLoader.exists("res://assets/models/%s.glb" % EntityView.MOUNT_LOOKS[k][0]), "montaria %s: modelo" % k)
	check(EntityView.WOLF_COATS.all(func(c): return absf(c.r - c.g) < 0.08 and absf(c.g - c.b) < 0.08), "lobo atroz: pelagens cinzentas")
	check(p.mount_kind == "horse" and not ws.set_mount_kind(p, "dire_wolf") and p.mount_kind == "horse", "lobo atroz: sem a missão, só cavalo")
	check(MountSystem.from_save(p, "dire_wolf") == "horse" and MountSystem.from_save(p, "xyz") == "horse", "lobo atroz: save sem a missão (ou antigo) volta ao cavalo")
	p.mounted = true
	var sp_horse := MountedCombat.move_mult(p)
	var q: QuestDef = gd.quests["hx_ov_hatch"]
	for pre in ["hx_ov_nest", "hx_ov_warm", "hx_kennel"]:
		p.quests_completed.append(pre)
	QuestSystem.accept(p, q)
	p.add_item(q.target_id, q.count)
	var mount_notes: Array = [0]
	var on_mount_note := func(t: String) -> void: mount_notes[0] += int(t.contains("ontaria"))
	Events.notification.connect(on_mount_note)
	QuestSystem.complete(p, q, ws)
	Events.notification.disconnect(on_mount_note)
	check("hx_ov_hatch" in p.quests_completed and p.mount_kind == "dire_wolf" and not p.mounted, "lobo atroz: entregar hx_ov_hatch troca para o lobo (desce do cavalo)")
	check(ws.player == p and mount_notes[0] == 1, "lobo atroz: a entrega dá um aviso de montaria só (%d)" % mount_notes[0])
	p.mounted = true
	check(is_equal_approx(MountedCombat.move_mult(p), sp_horse), "lobo atroz: mesma velocidade do cavalo (D5)")
	p.mounted = false
	check(MountSystem.from_save(p, "dire_wolf") == "dire_wolf" and ws.set_mount_kind(p, "horse") and p.mount_kind == "horse", "lobo atroz: salva e troca de volta no tratador")
	check(keeper.get("if", "") == "hx_ov_hatch" and "kharzun_wolf_keeper" in Balance.MOUNT_KEEPER_NPCS, "Kharzun: tratadora aparece com hx_ov_hatch")
	if not keeper.is_empty():
		var kp: Vector3 = keeper["pos"]
		check(Vector2(kp.x, kp.z).length() < gd.maps["field_kharzun"].town_radius - 3.0 and MapGeometry.is_walkable(ws, kp, gd.maps["field_kharzun"], 0.6),
			"Kharzun: tratadora dentro do acampamento, em chão livre (%s)" % kp)
		for n in gd.maps["field_kharzun"].npcs:
			if n["id"] != keeper["id"]:
				check((n["pos"] as Vector3).distance_to(kp) > 1.6, "Kharzun: tratadora não sobrepõe %s" % n["id"])
	# joias e capas 45
	var n45 := 0
	for piece in GearCatalog.THEME_PIECES:
		for theme in GearCatalog.THEMES:
			var rid := "rec_%s_%s_k45" % [piece, theme]
			var rec: RecipeDef = gd.recipes.get(rid)
			check(rec != null, "Kharzun: receita %s" % rid)
			if rec == null:
				continue
			n45 += 1
			var it: ItemDef = gd.items.get(rec.result_item)
			var t5: ItemDef = gd.items.get("%s_%s_t5" % [piece, theme])
			check(it != null and it.level_req == 45 and rec.level_req == 45 and rec.station == ("alchemy" if piece == "cape" else "smith"), "%s: nível 45 e estação" % rid)
			if it and t5:
				var a45: float = it.attributes.values().reduce(func(x, y): return x + y, 0.0)
				var a40: float = t5.attributes.values().reduce(func(x, y): return x + y, 0.0)
				check(a45 > a40 and it.rarity == ItemDef.RARITY_LEGENDARY - 1 and not it.is_legendary(), "%s: épica e mais forte que a do 40 (%.0f > %.0f)" % [rid, a45, a40])
				check(UiKit.item_texture(it) != null, "%s: ícone" % rid)
				check(not sim.gear_pool(Balance.COMMON_TIER_LEVELS.size() - 1).has(it), "%s: não cai de monstro" % rid)
			var trophies := 0
			for mat in rec.ingredients:
				var pending: bool = RecipesCatalog.KHARZUN_TROPHIES.has(mat) and MapsCatalog.STAND_INS.has(RecipesCatalog.KHARZUN_TROPHIES[mat])
				check(gd.items.has(mat) and (_dropped_somewhere(gd, mat) or pending), "%s: material %s existe e cai (ou o chefe ainda é substituto)" % [rid, mat])
				if RecipesCatalog.KHARZUN_TROPHIES.has(mat):
					trophies += 1
			check(trophies == (2 if piece == "cape" else 1), "%s: troféu de chefe na receita" % rid)
	check(n45 == 9, "Kharzun: 9 joias/capas 45 (%d)" % n45)
	var b45: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Joia45", "city_aldara", Vector3(0, 0, 6), 45)
	check(not b45.equipment.values().any(func(x): return x != null and GearCatalog.craft_only(x)), "Kharzun: bot 45 não nasce com joia de troféu")
	sim.despawn(b45)
	for t in RecipesCatalog.KHARZUN_TROPHIES:
		check(gd.items.has(t) and UiKit.item_texture(gd.items[t]) != null, "troféu %s: item e ícone" % t)
	# título da Prova 45
	for c in QuestsCatalog.ASC_MASTERS:
		var tq: QuestDef = gd.quests.get("hx_asc45_" + c)
		check(tq != null and tq.reward_title == "Mestre " + QuestsCatalog.TRIAL45_TITLES[c] and tq.reward_xp == 0, "Prova 45 (%s): título e 0 XP" % c)
	check(p.honor_title() == "", "título: ninguém nasce Mestre")
	p.quests_completed.append("hx_asc45_berserker")
	check(p.honor_title() == "Mestre Berserker", "título: a Prova 45 dá Mestre Berserker (%s)" % p.honor_title())
	# brasa de Kharzun colhível só depois da Forja Negra (K1c)
	var embers: Array = (ws.maps["field_kharzun"]["gather"] as Array).filter(func(g): return g["item"] == "kharzun_ember_core")
	check(embers.size() >= 3 and embers.all(func(g): return g.get("if", "") == MapsCatalog.Q_KH_FORGE), "Kharzun: brasa colhível com regra do K1c (%d)" % embers.size())
	if not embers.is_empty():
		p.position = embers[0]["pos"] + Vector3(0.5, 0, 0)
		check(not ws.gather_ready(embers[0]) and GatherSystem.nearest_gather(ws, p).get("item", "") != "kharzun_ember_core", "Kharzun: sem a Forja Negra, a brasa não colhe")
		p.quests_completed.append(MapsCatalog.Q_KH_FORGE)
		check(ws.gather_ready(embers[0]) and GatherSystem.nearest_gather(ws, p).get("item", "") == "kharzun_ember_core", "Kharzun: com a Forja Negra, a brasa colhe")
	var plain: Array = (ws.maps["field_kharzun"]["gather"] as Array).filter(func(g): return not g.has("if"))
	check(not plain.is_empty() and ws.gather_ready(plain[0]), "colheita sem regra continua valendo")
	ws.free()

## Ato II fase 3 (Kharzun, kharzun-fase3-plan §4 / WP7): seis chefes com fases, falas pt-BR, lacaios 0 XP e os
## Estandartes de Clã do Durgash (o ward vale enquanto um vive; os três mortos, o chefe volta a levar dano cheio).
func _check_kharzun_bosses(gd) -> void:
	for bid in MonstersCatalog.KHARZUN_BOSSES:
		check(gd.monsters.has(bid), "Kharzun: chefe %s existe" % bid)
		if not gd.monsters.has(bid):
			continue
		var b: MonsterDef = gd.monsters[bid]
		check(b.is_boss and b.level >= 41 and b.level <= 45 and b.intro != "" and b.last_words != "", "%s: chefe 41-45 com intro e last_words" % bid)
		check(b.berserk_after > 0.0, "%s: chefe de grupo com berserk por tempo (a Mãe-Loba também, desde 2026-11-17)" % bid)
		check(gd.loot_tables.has(b.loot_table) and b.xp > 0 and b.coin_chance >= 1.0, "%s: loot próprio, XP e moedas" % bid)
		check(MonstersCatalog.KHARZUN_MODELS.has(bid) and b.model.begins_with("mob_") and ResourceLoader.exists("res://assets/models/%s.glb" % b.model), "%s: substituto %s existe e modelo pretendido anotado" % [bid, b.model])
		check(not Sfx.voice_of(b).is_empty(), "%s: voz (Sfx.MOB_VOICE)" % bid)
		var last := 1.01
		for ph in b.phases:
			check(float(ph["hp"]) > 0.0 and float(ph["hp"]) <= last, "%s: fases em ordem de HP" % bid)
			last = float(ph["hp"])
			if ph.has("say"):
				check(str(ph["say"]).strip_edges() != "", "%s: fala de fase não vazia" % bid)
			for sid in ph.get("skills", []):
				check(gd.skills.has(sid), "%s: skill de fase %s existe" % [bid, sid])
			if ph.has("summon"):
				var ad: MonsterDef = gd.monsters.get(str(ph["summon"]["id"]))
				check(ad != null and ad.xp == 0 and ad.loot_table == "" and not ad.is_boss and absi(ad.level - b.level) <= 4, "%s: lacaio %s 0 XP, sem loot, do nível" % [bid, str(ph["summon"]["id"])])
		for sid in b.skill_ids:
			check(gd.skills.has(sid), "%s: skill %s existe" % [bid, sid])
			for e in [gd.skills.get(sid)]:
				if e and e.effects.has("boss_summon"):
					var ad2: MonsterDef = gd.monsters.get(str(e.effects["boss_summon"]["id"]))
					check(ad2 != null and ad2.xp == 0, "%s: invocação %s 0 XP" % [bid, sid])
		check(b.phases.size() >= 3, "%s: fases suficientes" % bid)
	# Mãe-Loba (2026-11-16): com hp ×0,6 o grupo de 4-5 do 41 a derrubava em ~10 s (Ghar 40: 30-50 s).
	# 2026-11-17: chefe de grupo como o Ghar (faixa "group" da sonda, prêmio e dica "leve um grupo" na missão)
	var mom: MonsterDef = gd.monsters["boss_dire_mother"]
	var ghar: MonsterDef = gd.monsters["boss_ghar"]
	var ghar_hp: float = ghar.hp
	check(mom.hp >= ghar_hp * 0.9 and mom.hp <= ghar_hp * 1.3, "Mãe-Loba: vida na faixa do Ghar (%d / %d)" % [mom.hp, ghar_hp])
	var probe_bands = load("res://tools/tests/boss_probe.gd")
	check(probe_bands.GROUPS.get("boss_dire_mother", "group") == "group", "Mãe-Loba: faixa de grupo na sonda (boss_probe.GROUPS)")
	check(mom.xp >= ghar.xp and mom.coin_min >= ghar.coin_min and mom.gold_min >= ghar.gold_min, "Mãe-Loba: prêmio de chefe de grupo (XP/moedas/ouro do Ghar ou mais)")
	var kennel: QuestDef = gd.quests.get("hx_kennel")
	check(kennel != null and kennel.map_hint.ends_with("leve um grupo") and kennel.dialog_offer.contains("Leve um grupo"), "O Canil: a missão avisa que é de grupo")
	# Durgash: os três estandartes na F2, cada um com o seu efeito de clã
	var d: MonsterDef = gd.monsters["boss_durgash"]
	var planted: Array = []
	for ph in d.phases:
		if ph.has("summon"):
			planted.append(str(ph["summon"]["id"]))
	check(planted == MonstersCatalog.KHARZUN_BANNERS, "Durgash finca os 3 estandartes de clã (%s)" % str(planted))
	check(d.phases[0].get("ward", 0.0) == 0.6, "Durgash F2: ward 0,6 com estandarte vivo")
	for bn in MonstersCatalog.KHARZUN_BANNERS:
		var bd: MonsterDef = gd.monsters[bn]
		# ~4% no plano; o Durgash ganhou vida (luta de ~100 s, autor 2026-11-13) e os estandartes não (com vida junto, 5 sorteados caíam a 50%)
		check(bd.move_speed == 0.0 and bd.xp == 0 and absf(bd.hp - d.hp * 0.028) < d.hp * 0.01, "%s: parado, 0 XP, vida ~3%% do Durgash (%d)" % [bn, bd.hp])
	check(Balance.MOB_AURAS.has(gd.monsters["banner_wolf"].aura), "Estandarte do Lobo: aura de velocidade")
	check(gd.skills["mob_stone_mend"].kind == SkillDef.Kind.HEAL and "mob_stone_mend" in gd.monsters["banner_stone"].skill_ids, "Estandarte da Pedra: cura o chefe")
	check(gd.skills["mob_forge_embers"].effects.has("dot") and "mob_forge_embers" in gd.monsters["banner_forge"].skill_ids, "Estandarte da Forja: brasas em volta")
	# regra do ward na sim: estandarte vivo = corte; os três mortos = sem corte
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["fort_war"])
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		ws.despawn(e)
	var at := Vector3.ZERO
	for sp in gd.maps["fort_war"].spawners:
		if sp["monster_id"] == "boss_ghar":
			at = sp["pos"]
	var boss: SimEntity = ws.spawn_monster(d, "fort_war", at)
	var foe: SimEntity = ws.spawn_bot(gd.classes["paladin"], "Alvo", "fort_war", at + Vector3(2, 0, 0), 40)
	boss.aggro_target = foe.id
	boss.hp = boss.stats.max_hp * 0.69
	MobSystem.update_boss(ws, boss, 1.0)
	var banners: Array = (m["entities"] as Array).filter(func(o): return o.boss_id == boss.id and o.is_alive())
	check(banners.size() == 3 and boss.phase == 3, "Durgash a 69%%: 3 estandartes fincados de uma vez (%d)" % banners.size())
	MobSystem.update_boss(ws, boss, Balance.BOSS_WARD_CHECK + 0.1)
	check(is_equal_approx(boss.ward, 0.6), "estandarte vivo: ward 0,6 (%.2f)" % boss.ward)
	for o in banners.slice(0, 2):
		ws.despawn(o)
	MobSystem.update_boss(ws, boss, Balance.BOSS_WARD_CHECK + 0.1)
	check(is_equal_approx(boss.ward, 0.6), "um estandarte de pé ainda protege (%.2f)" % boss.ward)
	ws.despawn(banners[2])
	MobSystem.update_boss(ws, boss, Balance.BOSS_WARD_CHECK + 0.1)
	check(boss.ward == 0.0, "os três estandartes caídos: sem ward (%.2f)" % boss.ward)
	ws.despawn(boss)
	ws.despawn(foe)

## Splash de boot (tools/splash/make_splash.gd): cobre motor + autoloads + primeira cena. Imagem existe, fundo = cor de limpeza
## do projeto e a borda da imagem tem a mesma cor (sem costura nas faixas de 21:9), stretch Keep com filtro.
func _check_boot_splash() -> void:
	var ms = load("res://tools/splash/make_splash.gd")
	var path: String = ProjectSettings.get_setting("application/boot_splash/image", "")
	check(path != "" and ResourceLoader.exists(path), "splash: application/boot_splash/image aponta para um PNG que existe (%s)" % path)
	var bg: Color = ProjectSettings.get_setting("application/boot_splash/bg_color", Color.BLACK)
	check(bg.is_equal_approx(ms.bg_color()), "splash: bg_color = rendering/environment/defaults/default_clear_color")
	check(int(ProjectSettings.get_setting("application/boot_splash/stretch_mode", -1)) == 1 and bool(ProjectSettings.get_setting("application/boot_splash/use_filter", false)),
		"splash: stretch Keep (escala pela altura em tela larga) com filtro")
	var tex := load(path) as Texture2D if ResourceLoader.exists(path) else null
	var img := tex.get_image() if tex != null else null
	check(img != null and img.get_size() == ms.SIZE, "splash: imagem %s" % [ms.SIZE])
	if img == null:
		return
	var off: Array[String] = []
	for p in [Vector2i(0, 0), Vector2i(img.get_width() - 1, 0), Vector2i(0, img.get_height() - 1), Vector2i(img.get_width() - 1, img.get_height() - 1)]:
		var c := img.get_pixel(p.x, p.y)
		if absf(c.r - bg.r) > 0.006 or absf(c.g - bg.g) > 0.006 or absf(c.b - bg.b) > 0.006:
			off.append("%s=%s" % [p, c])
	check(off.is_empty(), "splash: cantos da imagem na cor de fundo (%s)" % [off])

## Cidades com identidade (GDD design/gdd/living-towns.md AC-A1/A2/A4): Aldara tem a Feira do Trigo no centro (mó/balança +
## roseta de bancas), nada de estátua/chafariz no miolo, nada alto perto do hub, cristal na borda, ofícios por quadrante.
const TOWN_LIVING := ["city_aldara", "field_forest"]         # mapas do Ato I com LIVING_NPCS ligado (AC-B1)
func _check_town_identity(gd, sim) -> void:
	var def: MapDef = gd.maps["city_aldara"]
	var z: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MapsCatalog.ZONE_PATH % "city_aldara"))
	var cp: Dictionary = (z["town"] as Dictionary).get("centerpiece", {})
	check(str(cp.get("kind", "")) == "feira_do_trigo", "Aldara: o centro é a Feira do Trigo (town.centerpiece no JSON)")
	if cp.is_empty():
		return
	var generic: Array = []
	var tall: Array = []
	var stalls: Array = []
	var mill := false
	for o in z["obstacles"]:
		var p := Vector2(float(o["pos"][0]), float(o["pos"][1]))
		if str(o["kind"]) in ["statue", "fountain"] and p.length() < 20.0:
			generic.append("%s (%.0f, %.0f)" % [o["kind"], p.x, p.y])
		if p.length() < 25.0 and float(o["size"][1]) > 6.0:
			tall.append("%s %.1f m" % [o["kind"], o["size"][1]])
		if str(o["kind"]) == "stall" and p.length() < 12.0:
			stalls.append(p)
		if p.length() < 0.1 and bool(o.get("solid", true)) and absf(float(o["size"][0]) - 2.0 * float(cp["mill_r"])) < 0.01:
			mill = true
	check(generic.is_empty(), "Aldara: sem estátua nem chafariz a menos de 20 m do centro (%s)" % [generic])
	check(mill, "Aldara: a mó/balança do trigo é a peça central (colisor no centro)")
	check(stalls.size() >= 6 and stalls.size() == (cp["stalls"] as Array).size(), "Aldara: 6+ bancas em roseta (%d)" % stalls.size())
	var ring_ok := true
	var gap := INF
	for i in stalls.size():
		ring_ok = ring_ok and absf((stalls[i] as Vector2).length() - float(cp["stall_r"])) < 0.5
		for j in range(i + 1, stalls.size()):
			gap = minf(gap, (stalls[i] as Vector2).distance_to(stalls[j]))
	check(ring_ok and gap >= 5.5, "Aldara: bancas no anel da roseta, com vão entre elas (%.1f m entre centros)" % gap)
	check(tall.is_empty() and float(cp["max_height"]) <= 6.0, "Aldara: nada acima de 6 m a menos de 25 m do centro (%s)" % [tall])
	# os 8 vãos da roseta (4 ruas + 4 diagonais) passam um personagem com folga (corredor >= 3 m)
	var shut: Array = []
	for k in 8:
		var a := TAU * k / 8.0
		var q := Vector3(cos(a), 0.0, sin(a)) * float(cp["stall_r"])
		if not sim.is_walkable(q, def, 1.5):
			shut.append(k * 45)
	check(shut.is_empty(), "Aldara: vãos da roseta abertos, corredor >= 3 m (fechados em %s graus)" % [shut])
	# cristal de retorno fora do centro, na borda da feira
	var cr: Array = MapsCatalog.CRYSTALS["city_aldara"]
	var cd := Vector2(float(cr[0]), float(cr[1])).length()
	check(cd >= float(cp["stall_r"]) + 2.0 and cd <= 16.0, "Aldara: Cristal de Retorno na borda da feira (%.1f m do centro)" % cd)
	# ofícios por quadrante: ferreiro no pátio da forja (NE), mercador numa banca, Estátua do Fundador fora da praça
	var by_id := {}
	for n in def.npcs:
		by_id[n["id"]] = n
	var forge := Vector3(float(cp["forge"][0]), 0.0, float(cp["forge"][1]))
	check(forge.x > 0.0 and forge.z < 0.0 and by_id.has("smith") and (by_id["smith"]["pos"] as Vector3).distance_to(forge) < 4.0, "Aldara: Brom trabalha no pátio da forja, a nordeste")
	var mp: Vector3 = by_id["merchant"]["pos"] if by_id.has("merchant") else Vector3.ZERO
	check(stalls.any(func(s): return Vector2(mp.x, mp.z).distance_to(s) < 3.5), "Aldara: o mercador atende numa banca da feira")
	# praça aberta (playtest 2026-11-18): anel livre >= 5,5 m entre a mó e os balcões, mercador do lado de dentro, feirantes
	# atrás do balcão (fora do anel), nos postos que o Blender gravou
	var sr := float(cp["stall_r"])
	check(sr - 0.5 - float(cp["mill_r"]) >= 5.5, "Aldara: anel livre de 5,5+ m entre a mó e as bancas (%.1f m)" % (sr - 0.5 - float(cp["mill_r"])))
	var ring_shut: Array = []
	for k in 16:
		var qa := TAU * k / 16.0
		var qq := Vector3(cos(qa), 0.0, sin(qa)) * (float(cp["mill_r"]) + 0.5 * (sr - 0.5 - float(cp["mill_r"])))
		if not sim.is_walkable(qq, def, 2.4):
			ring_shut.append(int(rad_to_deg(qa)))
	check(ring_shut.is_empty(), "Aldara: o miolo da praça é chão livre em toda a volta (fechado em %s graus)" % [ring_shut])
	check(Vector2(mp.x, mp.z).length() < sr, "Aldara: o mercador atende do lado de dentro da praça (%.1f m do centro)" % Vector2(mp.x, mp.z).length())
	var posts: Array = cp.get("keeper_posts", [])
	var keeper_ids: Array = by_id.keys().filter(func(id): return str(id).begins_with("ald_keeper_") or str(id) == "vil_baker")
	var off_post: Array = keeper_ids.filter(func(id): return not posts.any(func(q): return Vector2(by_id[id]["pos"].x, by_id[id]["pos"].z).distance_to(Vector2(float(q[0]), float(q[1]))) < 0.3))
	check(keeper_ids.size() >= 5 and off_post.is_empty(), "Aldara: feirantes atrás do balcão, nos postos do JSON (fora do posto: %s)" % [off_post])
	var in_stall: Array = def.npcs.filter(func(n): return n.get("role", "") != "crystal" and (n["pos"] as Vector3).length() < 14.0 and not sim.is_walkable(n["pos"], def, 0.3)).map(func(n): return n["id"])
	check(in_stall.is_empty(), "Aldara: nenhum NPC da praça nasce dentro de um colisor (%s)" % [in_stall])
	var fs: Dictionary = by_id.get("founder_statue", {})
	check(not fs.is_empty() and (fs["pos"] as Vector3).length() >= 20.0 and def.in_hub(fs["pos"]) and str(fs.get("model", "")) == "prop_statue",
		"Aldara: Estátua do Fundador fora da praça, dentro da vila, com nome e fala")
	check((by_id["board"]["dialog"] as Array).any(func(l): return str(l).contains("Fundador")), "Aldara: o Quadro de Avisos fala da Estátua do Fundador")
	check(float(cp["barn"][1]) > 15.0 and Vector2(float(cp["barn"][0]), float(cp["barn"][1])).length() < def.town_radius, "Aldara: celeiro no quadrante sul, dentro da muralha")
	# bots não ficam na faixa dos balcões (ali ficam feirantes e fregueses): ou no miolo aberto, ou fora do anel
	var inside: Array = def.bot_hangouts.filter(func(h): return absf(Vector2(h.x, h.z).length() - float(cp["stall_r"])) < 1.5)
	check(inside.is_empty() and def.bot_hangouts.all(func(h): return sim.is_walkable(h, def, 0.45)), "Aldara: pontos de bot fora da faixa das bancas e em chão livre (%d na faixa)" % inside.size())
	check(def.npcs.filter(func(n): return n.get("role", "") == "crystal").size() == 1, "Aldara: um cristal de retorno")
	# Posto dos Caçadores: Fogueira Comunal + roda de carroças no lugar do poço e da estátua
	var fdef: MapDef = gd.maps["field_forest"]
	if not sim.maps.has(fdef.id):
		sim.load_map(fdef)
	var fz: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MapsCatalog.ZONE_PATH % "field_forest"))
	var fcp: Dictionary = (fz["town"] as Dictionary).get("centerpiece", {})
	check(str(fcp.get("kind", "")) == "fogueira_comunal" and (fcp.get("wagons", []) as Array).size() >= 4, "Posto: o centro é a Fogueira Comunal com a roda de carroças")
	if fcp.is_empty():
		return
	var hub := Vector2(float(fz["town"]["center"][0]), float(fz["town"]["center"][1]))
	var fgen: Array = fz["obstacles"].filter(func(o): return str(o["kind"]) in ["statue", "fountain", "well"] and Vector2(float(o["pos"][0]), float(o["pos"][1])).distance_to(hub) < 20.0)
	var ftall: Array = fz["obstacles"].filter(func(o): return Vector2(float(o["pos"][0]), float(o["pos"][1])).distance_to(hub) < 12.0 and float(o["size"][1]) > 6.0)
	check(fgen.is_empty() and ftall.is_empty() and float(fcp["max_height"]) <= 6.0, "Posto: sem estátua/poço genérico no centro e nada alto perto da fogueira (%d, %d)" % [fgen.size(), ftall.size()])
	var fshut := 0
	for k in 4:                     # as quatro ruas dos portões passam entre as carroças
		var q := Vector3(hub.x + cos(TAU * k / 4.0) * float(fcp["wagon_r"]), 0.0, hub.y + sin(TAU * k / 4.0) * float(fcp["wagon_r"]))
		var side := Vector3(-sin(TAU * k / 4.0), 0.0, cos(TAU * k / 4.0))
		# corredor de 3 m no vão (o cristal de retorno fica no vão norte: vale passar de um lado dele)
		if not [-2.0, 0.0, 2.0].any(func(off): return sim.is_walkable(q + side * off, fdef, 1.5)):
			fshut += 1
	check(fshut == 0, "Posto: as quatro ruas passam pela roda de carroças (%d fechadas)" % fshut)
	check(fdef.bot_hangouts.all(func(h): return sim.is_walkable(h, fdef, 0.45)), "Posto: pontos de bot em chão livre")

## Mapas vivos do Ato I (AC-B1/B2): Aldara chama living_npcs(LIVING_NPCS[...]); toda rota anda em chão livre, cruza água só
## na ponte e não termina em colisor; a Carroça da Colheita faz ida e volta em <= 4 min e ninguém fica parado > 30 s.
func _check_living_routes(gd, sim) -> void:
	for mid in TOWN_LIVING:
		var def: MapDef = gd.maps[mid]
		if not sim.maps.has(mid):
			sim.load_map(def)
		var table: Dictionary = MapsCatalog.LIVING_NPCS.get(mid, {})
		var ids := {}
		for n in def.npcs:
			ids[n["id"]] = n
		check(not table.is_empty() and table.keys().all(func(k): return ids.has(k)), "%s: LIVING_NPCS ligado no mapa (%d NPCs)" % [mid, table.size()])
		var bad: Array = []
		var legs := 0
		for n in def.npcs:
			if not n.has("route"):
				if table.has(n["id"]) and not sim.is_walkable(n["pos"], def, 0.3):
					bad.append("%s posto em sólido" % n["id"])
				continue
			var pts: Array = n["route"]
			for i in pts.size():
				var a := Vector3(float(pts[i][0]), 0, float(pts[i][1]))
				var b := Vector3(float(pts[(i + 1) % pts.size()][0]), 0, float(pts[(i + 1) % pts.size()][1]))
				var why := _wet_or_solid(sim, def, a)
				if why != "":
					bad.append("%s ponto %d (%.1f, %.1f): %s" % [n["id"], i, a.x, a.z, why])
				var steps := int(a.distance_to(b) / 0.75)
				for k in range(1, steps):
					var q := a.lerp(b, float(k) / steps)
					var w2 := _wet_or_solid(sim, def, q)
					if not sim.is_walkable(q, def, 0.3) or w2 == "lago" or w2 == "rio":
						bad.append("%s perna %d em (%.1f, %.1f) %s" % [n["id"], i, q.x, q.z, w2])
						break
				legs += 1
		if not bad.is_empty():
			print("TOWN_ROUTE_BAD ", "\nTOWN_ROUTE_BAD ".join(bad))
		check(bad.is_empty() and legs >= 20, "%s: rotas dos NPCs em chão livre, água só na ponte (%d pernas; %s)" % [mid, legs, "; ".join(bad.slice(0, 6))])
		check(AmbientLife.count_for(mid) >= 6, "%s: bichos de ambiente (%d)" % [mid, AmbientLife.count_for(mid)])
	# R1: a carroça vai da fazenda ao celeiro e volta em <= 4 min; feirantes no posto com pregão; fregueses andam
	var def_a: MapDef = gd.maps["city_aldara"]
	var m: Dictionary = sim.maps["city_aldara"]
	var carter: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.NPC and o.npc_data.get("id", "") == "ald_carter")
	check(carter.size() == 1 and not CarryPose.draft_of(str(carter[0].npc_data.get("carry", ""))).is_empty() if carter.size() == 1 else false, "Aldara: Carroça da Colheita com animal de tiro")
	var keepers: Array = def_a.npcs.filter(func(n): return n.has("barks") and not n.has("route") and not n.has("wander") and (n["pos"] as Vector3).length() < 11.5)      # atrás dos balcões (raio 10)
	check(keepers.size() >= 4, "Aldara: 4+ feirantes parados na banca com pregão (%d)" % keepers.size())
	var shoppers: Array = def_a.npcs.filter(func(n): return str(n["id"]).begins_with("ald_shopper") and n.has("route"))
	check(shoppers.size() >= 4, "Aldara: 4+ fregueses de banca em banca (%d)" % shoppers.size())
	var extra: int = MapsCatalog.LIVING_NPCS["city_aldara"].size() + 1       # + Estátua do Fundador
	check(extra <= 12, "Aldara: NPCs de ambiente a mais dentro do orçamento (+%d <= 12)" % extra)
	check(MapsCatalog.LIVING_NPCS["field_forest"].size() <= 10 and gd.maps["field_forest"].npcs.filter(func(n): return n.get("carry", "") == "carry_log").size() >= 2,
		"Floresta: lenhadores com tora e orçamento de NPCs de ambiente (+%d <= 10)" % MapsCatalog.LIVING_NPCS["field_forest"].size())
	if carter.size() != 1:
		return
	var c: SimEntity = carter[0]
	var movers: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.NPC and o.npc_data.has("route") and MapsCatalog.LIVING_NPCS["city_aldara"].has(o.npc_data.get("id", "")))
	var start: Vector3 = c.npc_data["pos"]
	c.position = start
	c.npc_leg = 0
	c.npc_goal = Vector3.ZERO
	c.npc_wait = 0.0
	var route: Array = c.npc_data["route"]
	var barn := Vector3.ZERO
	for q in route:
		if (q as Array).size() > 2 and Vector3(float(q[0]), 0, float(q[1])).distance_to(start) > 5.0:
			barn = Vector3(float(q[0]), 0, float(q[1]))
	var at_barn := -1.0
	var back := -1.0
	var still := {}
	var worst := 0.0
	var last := {}
	var dt := 1.0 / 30.0
	for i in range(int(20.0 * 60.0 / dt)):
		var t := i * dt
		for o: SimEntity in movers:
			sim._update_npc(o, m, dt)
			if o.position.distance_to(last.get(o.id, Vector3.INF)) > 0.001:
				still[o.id] = 0.0
			else:
				still[o.id] = float(still.get(o.id, 0.0)) + dt
				worst = maxf(worst, float(still[o.id]))
			last[o.id] = o.position
		if at_barn < 0.0 and c.position.distance_to(barn) < 0.6:
			at_barn = t
		if at_barn >= 0.0 and back < 0.0 and c.position.distance_to(start) < 0.6:
			back = t
	check(at_barn > 0.0 and back > 0.0 and back <= 240.0, "Aldara: Carroça da Colheita vai ao celeiro (%.0f s) e volta à fazenda (%.0f s <= 240)" % [at_barn, back])
	check(worst <= 30.0, "Aldara: nenhum NPC de rota parado mais de 30 s em 20 min (pior %.1f s)" % worst)

## Eventos de estrada (RoadEventSystem; AC-B3/B4): relógio só com o jogador no mapa, 1 ativo, pontos fora do hub e longe de
## portal, expira e limpa os monstros, prêmio pago uma vez, NPC do evento não morre, nada de quest/saque/save.
func _check_road_events(gd, _sim) -> void:
	var def: MapDef = gd.maps["city_aldara"]
	check(def.road_events.size() >= 3 and def.road_events.size() <= 4, "eventos: Aldara tem 3-4 pontos de evento (%d)" % def.road_events.size())
	check(Balance.EVENT_XP_FRAC > 0.0 and Balance.EVENT_XP_FRAC <= 0.06 and Balance.EVENT_MAX_MOBS <= 4 and Balance.EVENT_NEAR_M < Balance.EVENT_FAR_M
		and Balance.EVENT_EVERY_S >= 180.0, "eventos: números dentro da faixa segura do GDD")
	var ws := WorldSim.new()
	ws.rng.seed = 23
	var m: Dictionary = ws.load_map(def)
	m["spawners"].clear()
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.MONSTER:
			ws.despawn(o)
	# pontos: regra, monstro, chão livre e seco, fora do hub, longe de portal/chegada/NPC/chefe
	var bad: Array = []
	for i in def.road_events.size():
		var p: Dictionary = def.road_events[i]
		var pos: Vector3 = p["pos"]
		var rule := RoadEventSystem.rules(def.id, str(p["kind"]))
		if rule.is_empty() or not gd.monsters.has(str(p.get("mob", rule.get("mob", "")))):
			bad.append("%d sem regra/monstro" % i)
		if not ws.is_walkable(pos, def, 0.6) or _wet_or_solid(ws, def, pos) != "":
			bad.append("%d fora de chão livre" % i)
		if pos.distance_to(def.town_center) < 40.0:
			bad.append("%d no hub" % i)
		for pt in def.portals:
			if pos.distance_to(pt["pos"]) < 25.0:
				bad.append("%d perto do portal %s" % [i, pt["id"]])
		for other in gd.maps:
			for pt in gd.maps[other].portals:
				if pt["target_map"] == def.id and pos.distance_to(pt["target_pos"]) < 25.0:
					bad.append("%d perto da chegada de %s" % [i, other])
		for n in def.npcs:
			if pos.distance_to(n["pos"]) < 25.0 and not n.has("route") and not n.has("wander"):
				bad.append("%d perto do NPC %s" % [i, n["id"]])
		for sp in def.spawners:
			var smd: MonsterDef = gd.monsters.get(str(sp["monster_id"]))
			if smd != null and smd.is_boss and pos.distance_to(sp["pos"]) < 25.0:
				bad.append("%d perto do chefe %s" % [i, smd.id])
		for j in range(i + 1, def.road_events.size()):
			if pos.distance_to(def.road_events[j]["pos"]) < 30.0:
				bad.append("%d colado no ponto %d" % [i, j])
	check(bad.is_empty(), "eventos: pontos válidos (%s)" % "; ".join(bad.slice(0, 6)))
	for kind in MapsCatalog.ROAD_EVENTS["city_aldara"]:
		var r: Dictionary = MapsCatalog.ROAD_EVENTS["city_aldara"][kind]
		var it: ItemDef = gd.items.get(str(r.get("reward_item", "")))
		check(it != null and it.type == ItemDef.Type.CONSUMABLE and not str(r["reward_item"]).begins_with("legend"), "eventos: prêmio de %s é consumível (%s)" % [kind, r.get("reward_item", "")])
		for key in ["cry", "thanks", "flee", "bot_chat"]:
			check(not (r.get(key, []) as Array).is_empty(), "eventos: %s tem falas de %s" % [kind, key])
	# sem jogador no mapa: nada nasce
	for i in 800:
		RoadEventSystem.update(ws, m, 0.5)
	check(not m.has("road_event") or (m["road_event"]["active"] as Dictionary).is_empty(), "eventos: sem jogador no mapa nada nasce")
	var p0: Vector3 = def.road_events[0]["pos"]
	var p: SimEntity = ws.spawn_player(gd.classes["berserker"], "Viajante", def.id)
	# jogador na vila (pontos a mais de EVENT_FAR_M): o relógio anda mas nada nasce
	p.position = def.town_center
	var st := RoadEventSystem.state(ws, m)
	var first: float = st["timer"]
	check(first >= Balance.EVENT_FIRST_S and first <= Balance.EVENT_FIRST_S + Balance.EVENT_JITTER_S, "eventos: 1º evento entre FIRST e FIRST+JITTER (%.0f s)" % first)
	check(RoadEventSystem.valid_points(ws, m).all(func(i): return def.road_events[i]["pos"].distance_to(p.position) >= Balance.EVENT_NEAR_M and def.road_events[i]["pos"].distance_to(p.position) <= Balance.EVENT_FAR_M),
		"eventos: só vale ponto a 35-70 m do jogador")
	# jogador na estrada, a 50 m do ponto 0: nasce quando o relógio zera
	p.position = p0 + (def.town_center - p0).normalized() * 50.0
	check(RoadEventSystem.valid_points(ws, m).has(0), "eventos: ponto a 50 m do jogador é válido")
	var born := -1.0
	var t := 0.0
	while t < Balance.EVENT_FIRST_S + Balance.EVENT_JITTER_S + 5.0 and born < 0.0:
		RoadEventSystem.update(ws, m, 0.25)
		ws.time += 0.25
		t += 0.25
		if bool(RoadEventSystem.status(ws, def.id)["active"]):
			born = t
	check(born >= first - 0.5 and born <= first + 0.5, "eventos: nasce quando o relógio zera (%.1f s, relógio %.1f s)" % [born, first])
	var a: Dictionary = st["active"]
	if a.is_empty():
		check(false, "eventos: evento ativo para conferir")
		ws.free()
		return
	var mobs: Array = (a["ids"] as Array).map(func(id): return ws.entities[id])
	var npc: SimEntity = ws.entities[a["npc"]]
	var wolf: MonsterDef = gd.monsters["wolf"]
	var mobs_ok := true
	for e: SimEntity in mobs:
		mobs_ok = mobs_ok and e.road_event and e.monster_def.xp == 0 and e.monster_def.loot_table == "" and e.monster_def.gold_max == 0 			and e.level <= wolf.level and is_equal_approx(e.monster_def.leash_range, Balance.EVENT_LEASH_M)
	check(mobs.size() >= 2 and mobs.size() <= Balance.EVENT_MAX_MOBS and mobs_ok, "eventos: 2-3 lobos do nível do ponto, sem XP/ouro/saque, presos a 30 m (%d)" % mobs.size())
	check(npc.kind == SimEntity.Kind.NPC and mobs.all(func(e): return not e.is_hostile_to(npc) and not npc.is_hostile_to(e)), "eventos: o lavrador não é alvo (não morre)")
	check(RoadEventSystem.start(ws, m).is_empty() and RoadEventSystem.start(ws, m, 1).is_empty(), "eventos: nunca 2 ativos no mapa")
	# graça dos bots: nos primeiros 25 s só o jogador (e o grupo dele) mira os lobos
	var bot: SimEntity = ws.spawn_bot(gd.classes["paladin"], "Curioso", def.id, p0 + Vector3(3, 0, 0), 8)
	check(bool(a["grace"]) and not bot.is_hostile_to(mobs[0]) and not mobs[0].is_hostile_to(bot) and p.is_hostile_to(mobs[0]) and mobs[0].is_hostile_to(p),
		"eventos: bots esperam a graça; o jogador não")
	a["t"] = Balance.EVENT_BOT_GRACE + 1.0
	RoadEventSystem.update(ws, m, 0.25)
	ws.time += 0.25
	check(not bool(a["grace"]) and bot.is_hostile_to(mobs[0]) and mobs[0].is_hostile_to(bot), "eventos: depois da graça os bots entram")
	# resolver: prêmio pago uma vez, sem XP de abate nem quest
	QuestSystem.accept(p, gd.quests["q06_wolves"])
	var xp0 := p.xp
	var lv0 := p.level
	var gold0 := p.gold
	var pot0: int = int(p.inventory.get("potion_hp_s", 0))
	for e: SimEntity in mobs:
		ws._deal_damage(p, e, int(e.hp + 99999), false, false, "physical")
	var want := RoadEventSystem.reward_of(lv0, 1)
	var last: Dictionary = RoadEventSystem.status(ws, def.id).get("last", {})
	check(not bool(RoadEventSystem.status(ws, def.id)["active"]) and str(last.get("outcome", "")) == "resolved" and int(last.get("paid", 0)) == 1, "eventos: matar os lobos resolve o evento")
	check(p.level > lv0 or p.xp - xp0 == int(want["xp"]), "eventos: XP só do prêmio, %d = %.0f%% do nível (ganhou %d)" % [want["xp"], Balance.EVENT_XP_FRAC * 100.0, p.xp - xp0])
	check(p.gold - gold0 == int(want["gold"]) and int(p.inventory.get("potion_hp_s", 0)) - pot0 == 2, "eventos: moedas (%d) e consumível x2" % int(want["gold"]))
	check(int(p.quests_active.get("q06_wolves", 0)) == 0, "eventos: lobo de evento não conta para quest")
	RoadEventSystem.finish(ws, m, "resolved")
	check(p.gold - gold0 == int(want["gold"]), "eventos: prêmio pago uma vez só")
	check(ws.entities.has(npc.id), "eventos: o lavrador agradece e vai embora andando")
	for i in int((Balance.EVENT_LEAVE_S + 1.0) / 0.25):
		RoadEventSystem.update(ws, m, 0.25)
		ws.time += 0.25
	check(not ws.entities.has(npc.id), "eventos: o lavrador some depois de ir embora")
	check(float(st["timer"]) >= Balance.EVENT_EVERY_S - Balance.EVENT_LEAVE_S - 2.0 and not RoadEventSystem.valid_points(ws, m).has(0), "eventos: próximo em 4-7 min e o ponto entra em recarga")
	# expirar: ninguém chega em EVENT_LIFETIME -> some sem prêmio, monstros limpos
	ws.despawn(bot)
	p.position = def.road_events[1]["pos"] + ((def.town_center - def.road_events[1]["pos"]) as Vector3).normalized() * 50.0
	var b2 := RoadEventSystem.start(ws, m, 1)
	var ids2: Array = (b2.get("ids", []) as Array).duplicate()
	var gold1 := p.gold
	for i in int((Balance.EVENT_LIFETIME + 2.0) / 0.5):
		RoadEventSystem.update(ws, m, 0.5)
		ws.time += 0.5
	last = RoadEventSystem.status(ws, def.id).get("last", {})
	check(not ids2.is_empty() and str(last.get("outcome", "")) == "expired" and ids2.all(func(id): return not ws.entities.has(id)) and p.gold == gold1,
		"eventos: expira sem prêmio e limpa os monstros")
	# jogador fora do mapa por mais que a janela: o evento congelado expira na volta
	st["cd"].clear()
	p.position = p0 + (def.town_center - p0).normalized() * 50.0
	RoadEventSystem.start(ws, m, 0)
	ws.time += Balance.EVENT_LIFETIME + 10.0
	RoadEventSystem.update(ws, m, 0.25)
	check(str(RoadEventSystem.status(ws, def.id).get("last", {}).get("outcome", "")) == "expired", "eventos: jogador some por mais que a janela, evento expira na volta")
	# investida no mapa cala o evento (a Floresta tem investida; a regra é a mesma)
	var fm: Dictionary = ws.load_map(gd.maps["field_forest"])
	check(not RoadEventSystem.raid_on(fm), "eventos: sem leva, sem bloqueio")
	RaidSystem.start_raid(ws, fm)
	check(RoadEventSystem.raid_on(fm), "eventos: investida em curso bloqueia e encerra eventos")
	# nada no save
	check(not FileAccess.get_file_as_string("res://core/save_system.gd").contains("road_event"), "eventos: nada de evento no save")
	ws.free()

## Tab = trava no chefe (BossLock, game/player/boss_lock.gd; decisão 2026-11-18): só chefe de verdade, regras de soltar,
## movimento W/S/A/D em volta do chefe (A/D puro orbita sem espiralar) e mira = chefe para todo tipo de alvo.
func _check_boss_lock() -> void:
	var mk_mob := func(id: int, pos: Vector3, boss: bool, elite: String, decoy: bool) -> SimEntity:
		var md := MonsterDef.new()
		md.id = "lock_test_%d" % id; md.name = "Chefe %d" % id; md.is_boss = boss; md.elite_of = elite; md.decoy = decoy
		var m := SimEntity.new()
		m.id = id; m.kind = SimEntity.Kind.MONSTER; m.monster_def = md; m.position = pos; m.map_id = "lock_map"; m.radius = 1.0
		return m
	var p := SimEntity.new()
	p.id = 1; p.kind = SimEntity.Kind.PLAYER; p.map_id = "lock_map"; p.position = Vector3.ZERO
	var trash: SimEntity = mk_mob.call(10, Vector3(2, 0, 0), false, "", false)
	var king: SimEntity = mk_mob.call(11, Vector3(3, 0, 0), true, "boar", false)       # elite "Rei": não trava
	var copy: SimEntity = mk_mob.call(12, Vector3(3, 0, 1), true, "", true)          # cópia da Shazka: não trava
	var near: SimEntity = mk_mob.call(13, Vector3(8, 0, 0), true, "", false)
	var far: SimEntity = mk_mob.call(14, Vector3(0, 0, -15), true, "", false)
	var out: SimEntity = mk_mob.call(15, Vector3(0, 0, Balance.BOSS_LOCK_RANGE + 5.0), true, "", false)
	var ents: Array = [p, trash, king, copy, near, far, out]
	var R := Balance.BOSS_LOCK_RANGE
	var pad := Balance.BOSS_LOCK_CURSOR_PAD
	check(BossLock.is_lockable(near) and not BossLock.is_lockable(trash) and not BossLock.is_lockable(king) and not BossLock.is_lockable(copy) and not BossLock.is_lockable(p),
		"Trava: só chefe de verdade (comum, Rei elite, cópia e jogador não)")
	check(BossLock.pick(ents, p.position, Vector3(50, 0, 50), R, pad) == near, "Trava: sem chefe sob o cursor, o mais perto")
	check(BossLock.pick(ents, p.position, Vector3(0.5, 0, -14.0), R, pad) == far, "Trava: o chefe sob o cursor vence o mais perto")
	check(BossLock.pick(ents, p.position, out.position, R, pad) == near, "Trava: chefe fora do alcance não trava nem sob o cursor")
	check(BossLock.pick([p, trash, king, copy, out], p.position, trash.position, R, pad) == null, "Trava: sem chefe por perto = nada")
	near.state = SimEntity.State.DEAD
	check(BossLock.pick(ents, p.position, near.position, R, pad) == far, "Trava: chefe morto não trava")
	near.state = SimEntity.State.IDLE
	# regras de soltar
	var lk := BossLock.new()
	lk.lock(near)
	var why := func() -> String: return BossLock.release_reason(p, near, lk.map_id, lk.epoch, Balance.BOSS_LOCK_RELEASE)
	check(why.call() == "", "Trava: chefe vivo por perto segue travado")
	p.mounted = true
	check(why.call() == "", "Trava: montar não solta (Combate Montado)")
	p.mounted = false
	near.state = SimEntity.State.DEAD
	check(why.call() == "boss_gone", "Trava: chefe morreu solta")
	near.state = SimEntity.State.IDLE
	check(BossLock.release_reason(p, null, lk.map_id, lk.epoch, Balance.BOSS_LOCK_RELEASE) == "boss_gone", "Trava: chefe sumiu solta")
	near.adds_epoch += 1
	check(why.call() == "reset", "Trava: chefe resetou solta")
	near.adds_epoch -= 1
	p.map_id = "other_map"
	check(why.call() == "map", "Trava: troca de mapa solta")
	p.map_id = "lock_map"
	near.position = Vector3(Balance.BOSS_LOCK_RELEASE + 1.0, 0, 0)
	check(why.call() == "range", "Trava: chefe longe demais solta")
	near.position = Vector3(8, 0, 0)
	p.state = SimEntity.State.DEAD
	check(why.call() == "player_dead", "Trava: jogador morreu solta")
	p.state = SimEntity.State.IDLE
	# movimento: W para o chefe, S para longe, A/D na tangente mantendo o raio
	var b := Vector3(8, 0, 0)
	var md := 2.0
	var ah := Balance.BOSS_LOCK_ORBIT_AHEAD
	var w := BossLock.move_vector(Vector3.ZERO, b, Vector2(0, 1), 8.0, md, ah)
	var sv := BossLock.move_vector(Vector3.ZERO, b, Vector2(0, -1), 8.0, md, ah)
	check(w.distance_to(Vector2(1, 0)) < 0.001 and sv.distance_to(Vector2(-1, 0)) < 0.001, "Trava: W vai para o chefe e S para longe")
	check(BossLock.move_vector(Vector3(7.5, 0, 0), b, Vector2(0, 1), 0.5, md, ah).length() < 0.001, "Trava: W colado no chefe não empurra para dentro")
	var dv := BossLock.move_vector(Vector3.ZERO, b, Vector2(1, 0), 8.0, md, ah)
	var av := BossLock.move_vector(Vector3.ZERO, b, Vector2(-1, 0), 8.0, md, ah)
	# olhando +X, a direita é +Z (a mesma conta do Node3D: frente × cima)
	check(dv.y > 0.95 and av.y < -0.95 and absf(dv.x) < 0.2, "Trava: D vai para a direita e A para a esquerda, quase na tangente (%s / %s)" % [dv, av])
	var diag := BossLock.move_vector(Vector3.ZERO, b, Vector2(1, 1).normalized(), 8.0, md, ah)
	check(diag.x > 0.5 and diag.y > 0.5 and diag.length() <= 1.0001, "Trava: W+D combina (frente e lado)")
	# A/D puro por 20 s a 5,5 m/s: dá voltas e o raio fica (sem espiralar)
	var pos := Vector3.ZERO
	var dt := 1.0 / 60.0
	var worst := 0.0
	var turned := 0.0
	var last_a := atan2(pos.z - b.z, pos.x - b.x)
	for i in range(1200):
		var mv := BossLock.move_vector(pos, b, Vector2(1, 0), 8.0, md, ah)
		pos += Vector3(mv.x, 0, mv.y) * 5.5 * dt
		worst = maxf(worst, absf(Vector2(pos.x - b.x, pos.z - b.z).length() - 8.0))
		var a := atan2(pos.z - b.z, pos.x - b.x)
		turned += absf(wrapf(a - last_a, -PI, PI))
		last_a = a
	check(worst < 0.15 and turned > TAU * 1.5, "Trava: D puro orbita no raio (desvio máx %.3f m, %.1f voltas)" % [worst, turned / TAU])
	check(BossLock.move_vector(Vector3.ZERO, b, Vector2.ZERO, 8.0, md, ah) == Vector2.ZERO, "Trava: sem tecla, parado")
	# mira = chefe para todo tipo de alvo (a sim encara a mira e limita o GROUND ao alcance)
	var caster := SimEntity.new()
	caster.id = 2; caster.kind = SimEntity.Kind.PLAYER; caster.map_id = "lock_map"; caster.position = Vector3(0, 0, 0)
	var boss: SimEntity = mk_mob.call(20, Vector3(4, 0, 3), true, "", false)
	var decoy_mob: SimEntity = mk_mob.call(21, Vector3(-3, 0, 0), false, "", false)     # outro alvo atrás, perto do cursor antigo
	var aim := BossLock.aim_point(boss)
	caster.face_towards(aim)
	var hit_all := true
	var why_not := ""
	for t in [SkillDef.Target.DIRECTION, SkillDef.Target.CONE, SkillDef.Target.TARGET, SkillDef.Target.GROUND]:
		var sk := SkillDef.new()
		sk.target = t; sk.range = 8.0; sk.radius = 6.0 if t == SkillDef.Target.CONE else 2.0; sk.cone_angle_deg = 60.0; sk.max_targets = 3
		var got: Array = Combat.select_targets(caster, sk, aim, [caster, boss, decoy_mob])
		if not got.has(boss) or got.has(decoy_mob):
			hit_all = false
			why_not += " %d" % t
	check(hit_all, "Trava: com a mira no chefe, DIRECTION/CONE/TARGET/GROUND acertam o chefe e não o de trás (falhou:%s)" % why_not)
	var far_aim := Combat.clamp_aim(caster, BossLock.aim_point(far), 6.0)
	check(far_aim.distance_to(caster.position) <= 6.001, "Trava: GROUND no chefe longe é limitado ao alcance como sempre")
	# controlador: Tab sem chefe não trava; lock_changed avisa
	var pc = load("res://game/player/player_controller.gd").new()
	check(not pc.lock.active(), "Trava: começa solta")
	check(InputMap.has_action("lock_target") and InputMap.action_get_events("lock_target").any(func(ev): return ev is InputEventKey and ev.physical_keycode == KEY_TAB),
		"Trava: ação lock_target ligada no Tab (InputMap, project.godot)")
	pc.free()

## Faixa dos bots (playtest 2026-11-18: lv 40 na praça de Aldara): cidade nasce na faixa, bot volta para o povoado
## da faixa dele (lv 40 não volta a Aldara), sai do povoado de faixa baixa e Aldara fica da faixa depois de minutos de sim.
func _check_bot_band(gd, sim) -> void:
	var town: String = gd.town_map_id()
	var tdef: MapDef = gd.maps[town]
	var band := BotBandSystem.spawn_levels(tdef)
	check(band.x == tdef.level_range.x and band.y <= tdef.level_range.y + Balance.BOT_BAND_SLACK and band.y <= 12, "Aldara: bots nascem em %d-%d (faixa da cidade)" % [band.x, band.y])
	check(BotBandSystem.home_map(5) == town and BotBandSystem.home_map(11) == town, "bot lv 5/11: casa é a cidade inicial")
	var spots := BotBandSystem.spawn_spots(tdef)
	var in_sq := spots.filter(func(h): return (h as Vector3).distance_to(tdef.town_center) < Balance.BOT_SQUARE_RADIUS).size()
	check(spots.size() >= 6 and in_sq <= Balance.BOT_SQUARE_CAP, "Aldara: bots nascem em %d pontos, só %d na praça" % [spots.size(), in_sq])
	var sq_spawn := 0
	for i in tdef.bot_population:
		if BotBandSystem.spawn_spot(tdef, i).distance_to(tdef.town_center) < Balance.BOT_SQUARE_RADIUS:
			sq_spawn += 1
	check(sq_spawn <= Balance.BOT_SQUARE_CAP, "Aldara: dos %d bots iniciais só %d nascem na praça" % [tdef.bot_population, sq_spawn])
	for h: Vector3 in spots:
		check(sim.is_walkable(sim.random_walkable(tdef, h, 2.0), tdef, 0.4), "ponto de nascer %s em chão livre" % h)
	for lv in [12, 22, 32, 37, 40, 45]:
		var home := BotBandSystem.home_map(lv)
		var hd: MapDef = gd.maps[home]
		check(home != town and lv >= hd.level_range.x and lv <= hd.level_range.y + 5, "bot lv %d: casa %s (%d-%d), não Aldara" % [lv, home, hd.level_range.x, hd.level_range.y])
	check(BotBandSystem.home_map(40) == "field_kharzun" or BotBandSystem.home_map(40) == "field_steppe", "bot lv 40: povoado do Ato II (%s)" % BotBandSystem.home_map(40))
	for mid in MapsCatalog.CRYSTALS:
		if not sim.maps.has(mid):
			sim.load_map(gd.maps[mid])
		var probe: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Faixa", mid, gd.maps[mid].town_center, gd.maps[mid].level_range.x + Balance.BOT_HOME_STEP_UP)
		probe.brain = null
		var h: Dictionary = sim.home_of(probe)
		check(h["map"] == mid and sim.is_walkable(h["pos"], gd.maps[mid], 0.5) and gd.maps[mid].in_hub(h["pos"]),
			"retorno de bot em %s: chão livre dentro do povoado" % mid)
		sim.despawn(probe)
	# lv 40 em Aldara: G/renascer levam ao povoado dele; voltando (RETURN) não para na loja de Aldara
	if not sim.maps.has(town):
		sim.load_map(tdef)
	var hi: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Visitante", town, tdef.town_center, 40)
	check(sim.home_of(hi)["map"] != town, "lv 40 sem cristal: casa não é Aldara")
	var b: BotBrain = hi.brain
	b.state = BotBrain.S.RETURN
	b.timer = 30.0
	b.think(hi, sim, sim.maps[town], 0.1)
	check(b.state != BotBrain.S.SHOP, "lv 40 voltando em Aldara não compra/fica na praça de Aldara")
	b.state = BotBrain.S.TOWN_IDLE
	b.timer = 0.0
	b.think(hi, sim, sim.maps[town], 0.1)
	check(b.state == BotBrain.S.TRAVEL and b.dest_map != town, "lv 40 à toa em Aldara sai para caçar na faixa (%s)" % b.dest_map)
	# no grupo do jogador a casa é a do jogador (segue para onde ele for)
	sim.despawn(hi)
	hi = null
	if sim.player != null and sim.player.party_id < 0 and sim.player.bind_map == "" and BotBandSystem.home_map(sim.player.level) == town:
		hi = sim.spawn_bot(gd.classes["berserker"], "Parceiro", town, tdef.town_center, mini(sim.player.level + 13, 45))
		check(sim.home_of(hi)["map"] != town, "bot lv %d sozinho: casa fora de Aldara" % hi.level)
		sim.party_invite(sim.player, hi)
		if not sim.same_party(sim.player, hi):
			sim.party_accept(hi)
		check(sim.same_party(sim.player, hi) and sim.home_of(hi)["map"] == sim.home_of(sim.player)["map"], "bot no grupo do jogador: casa = a do jogador (%s, grupo %s, erro '%s')"
			% [sim.home_of(hi)["map"], sim.same_party(sim.player, hi), sim.party_invite_error(sim.player, hi)])
		sim.party_leave(hi)
		sim.despawn(hi)
	# mini-censo de Aldara: 8 bots da faixa + 4 de lv 40 à toa na vila por 90 s
	var tm: Dictionary = sim.maps[town]
	var dt := 1.0 / 60.0
	var crowd: Array = []
	for i in 12:
		var hpos: Vector3 = tdef.bot_hangouts[i % tdef.bot_hangouts.size()] if tdef.bot_hangouts.size() > 0 else tdef.town_center
		var bt: SimEntity = sim.spawn_bot(gd.classes[["paladin", "ranger", "bishop", "berserker"][i % 4]], "Censo%d" % i, town,
			sim.random_walkable(tdef, hpos, 2.0), 40 if i >= 8 else 3 + i)
		(bt.brain as BotBrain).state = BotBrain.S.TOWN_IDLE
		(bt.brain as BotBrain).timer = 0.5 + i * 0.3
		bt.brain.personality = 0.0        # fica mais na vila (pior caso para a praça)
		crowd.append(bt)
	var sq_sum := 0.0
	var sq_n := 0
	for tick in range(60 * 90):
		for bt: SimEntity in crowd:
			if bt.map_id == town:
				sim._apply_command(bt, bt.brain.think(bt, sim, tm, dt), tm, dt)
		if tick % 60 == 0 and tick >= 60 * 20:
			var sq := 0
			for bt: SimEntity in crowd:
				if bt.map_id == town and bt.level <= tdef.level_range.y and bt.position.distance_to(tdef.town_center) < Balance.BOT_SQUARE_RADIUS:
					sq += 1
			sq_sum += sq
			sq_n += 1
	var idle_hi := 0
	for bt: SimEntity in crowd:
		var bb: BotBrain = bt.brain
		if bt.level > tdef.level_range.y + Balance.BOT_BAND_SLACK and bt.map_id == town and bb.state in [BotBrain.S.TOWN_IDLE, BotBrain.S.TOWN_WALK, BotBrain.S.SHOP]:
			idle_hi += 1
	check(idle_hi == 0, "Aldara após 90 s: nenhum lv 40 à toa na vila (%d)" % idle_hi)
	var sq_avg := sq_sum / maxf(1.0, sq_n)
	check(sq_avg <= Balance.BOT_SQUARE_CAP + 1.0, "Aldara: média de bots da faixa na praça %.1f <= %d" % [sq_avg, Balance.BOT_SQUARE_CAP + 1])
	print("BOT_BAND aldara praca_media=%.2f lv40_a_toa=%d" % [sq_avg, idle_hi])
	for bt: SimEntity in crowd:
		sim.despawn(bt)


## Mata dos Zumbidos (4-8, ramo lateral ao sul de Aldara): portal ida/volta, faixa, spawners, NPCs das quests, cadeia m0-m8,
## Floresta sem depender dela, Colmeia que invoca vespas 0 XP (com teto) e Ursa-Mãe com fases.
func _check_field_hollow(gd, sim) -> void:
	check(gd.maps.has("field_hollow"), "Mata dos Zumbidos existe")
	if not gd.maps.has("field_hollow"):
		return
	var md: MapDef = gd.maps["field_hollow"]
	# som: todo bicho da mata tem voz e o som existe no banco (Sfx.MOB_VOICE + tools/audio/build_sfx.py)
	for mid in ["wasp", "wasp_soldier", "hive_wasp", "bear_cub", "bear_cub_den", "bear", "bear_mother", "hive"]:
		var v: Array = Sfx.voice_of(gd.monsters[mid])
		var ok := v.size() == 3
		for snd in v:
			if str(snd) != "" and not FileAccess.file_exists("res://assets/audio/sfx/%s_1.wav" % snd):
				ok = false
		check(ok and (str(v[0]) != "" or str(v[1]) != ""), "Mata dos Zumbidos: %s tem voz no banco de sons" % mid)
	check(str(Sfx.voice_of(gd.monsters["bear_mother"])[0]) == "bear_roar" and Sfx.CAST_SOUND.get("mob_bear_roar", "") == "bear_roar", "Ursa-Mãe ruge ao entrar em luta e no rugido")
	check(md.level_range == Vector2i(4, 8) and md.bot_population == 3 and not md.is_town and md.model == "map_field_hollow", "Mata: faixa 4-8, 3 bots, campo com modelo próprio")
	check(md.name == "Mata dos Zumbidos" and md.ground_color.is_equal_approx(Color(0.3, 0.45, 0.29)), "Mata: nome e chão iguais à arte de carregamento")
	check(not MapsCatalog.CRYSTALS.has("field_hollow"), "Mata: sem cristal (não quebra a faixa dos bots)")
	var back: Array = md.portals.filter(func(p): return p["target_map"] == "city_aldara")
	var there: Array = gd.maps["city_aldara"].portals.filter(func(p): return p["target_map"] == "field_hollow")
	check(back.size() == 1 and there.size() == 1, "Mata: um portal de ida (Aldara) e um de volta")
	if back.size() == 1 and there.size() == 1:
		check(sim.is_walkable(there[0]["target_pos"], md, 0.45) and sim.is_walkable(back[0]["target_pos"], gd.maps["city_aldara"], 0.45), "Mata: chegadas dos dois lados andáveis")
		check(there[0]["target_pos"].distance_to(back[0]["pos"]) > back[0]["radius"] + 1.0, "Mata: chegada fora do portal de volta")
	check(sim.is_walkable(md.spawn_point, md, 0.45), "Mata: spawn andável")
	var ids := {}
	for sp in md.spawners:
		ids[sp["monster_id"]] = true
		check(gd.monsters.has(sp["monster_id"]), "Mata: spawner de %s existe" % sp["monster_id"])
		var mm: MonsterDef = gd.monsters.get(sp["monster_id"])
		if mm:
			check(mm.level >= 4 and mm.level <= 8, "Mata: %s na faixa (nv %d)" % [mm.id, mm.level])
	for mid in ["wasp", "wasp_soldier", "bear_cub", "bear", "hive", "bear_mother"]:
		check(ids.has(mid), "Mata: spawner de %s" % mid)
	check(md.spawners.size() >= 7, "Mata: 7+ spawners")
	for it in ["honey_comb", "bear_hide", "wasp_stinger"]:
		check(gd.items.has(it), "Mata: material %s" % it)
	# NPCs e quests
	var npc_ids := {}
	for m in gd.maps.values():
		for n in m.npcs:
			npc_ids[n["id"]] = m.id
	for nid in MapsCatalog.HOLLOW_NPCS:
		check(npc_ids.get(nid, "") == "field_hollow", "Mata: NPC %s no mapa" % nid)
	var chain := ["m0_rumor", "m1_wasps", "m2_honey", "m3_cubs", "m4_lost", "m5_hides", "m6_hive", "m7_mother", "m8_report"]
	var done := {}
	for qid in chain:
		check(gd.quests.has(qid), "Mata: quest %s" % qid)
		if not gd.quests.has(qid):
			continue
		var q: QuestDef = gd.quests[qid]
		check(npc_ids.has(q.giver_npc) and (q.turnin_npc == "" or npc_ids.has(q.turnin_npc)), "Mata: %s tem giver/turnin em algum mapa" % qid)
		var pre: Array = ([q.prereq_quest] if q.prereq_quest != "" else []) + Array(q.prereq_all)
		check(pre.all(func(p): return done.has(p)), "Mata: %s só pede quests anteriores da cadeia" % qid)
		check(q.dialog_progress != "", "Mata: %s tem dica no progresso" % qid)
		match q.type:
			QuestDef.Type.KILL:
				check(ids.has(q.target_id), "Mata: alvo de %s aparece na Mata" % qid)
			QuestDef.Type.COLLECT:
				var src := false
				for g in md.gather:
					src = src or str(g.get("item", "")) == q.target_id
				for mid in ids:
					var lt: LootTable = gd.loot_tables.get(gd.monsters[mid].loot_table) if gd.monsters[mid].loot_table != "" else null
					if lt:
						for e in lt.entries:
							src = src or e["item"] == q.target_id
				check(src, "Mata: %s tem fonte (colheita ou saque)" % qid)
			QuestDef.Type.TALK:
				check(npc_ids.has(q.target_id), "Mata: %s fala com NPC que existe" % qid)
		done[qid] = true
	check(gd.quests["m0_rumor"].giver_npc == "captain" and gd.quests["m8_report"].turnin_npc == "captain", "Mata: começa e termina com a Capitã Mira")
	check(QuestsCatalog.HUNT_GIVERS.get("field_hollow", "") == "hollow_brena" and gd.quests.has("h_wasp") and gd.quests["h_wasp"].giver_npc == "hollow_brena", "Mata: caçadas repetíveis com a Brena")
	# a Floresta não depende do ramo: nenhuma quest fora do ramo pede m*, nem portão
	var gated := false
	for qid in gd.quests:
		if str(qid).begins_with("m") and str(qid).substr(1, 1).is_valid_int():
			continue
		var q: QuestDef = gd.quests[qid]
		gated = gated or chain.has(q.prereq_quest) or Array(q.prereq_all).any(func(p): return chain.has(p))
	for pid in MapsCatalog.PORTAL_GATES:
		var g: Dictionary = MapsCatalog.PORTAL_GATES[pid]
		gated = gated or chain.has(str(g.get("quest", ""))) or Array(g.get("quests", [])).any(func(p): return chain.has(p))
	check(not gated, "Mata: ramo lateral não trava a Floresta nem outra quest")
	# Colmeia: parada, sem golpe, invoca vespas 0 XP no alcance do aggro, com teto
	var hv: MonsterDef = gd.monsters["hive"]
	var sw: SkillDef = gd.skills.get("mob_hive_swarm")
	check(hv.move_speed == 0.0 and hv.xp > 0 and not hv.is_boss and sw != null and hv.skill_ids.has("mob_hive_swarm"), "Colmeia: parada, dá XP e tem o Enxame")
	if sw:
		var bs: Dictionary = sw.effects.get("boss_summon", {})
		check(bs.get("id", "") == "hive_wasp" and gd.monsters["hive_wasp"].xp == 0, "Colmeia: invoca Vespa da Colmeia sem XP")
		var reach := MonsterBrain._skill_reach(sw, false)
		check(reach > 3.0 and reach <= hv.aggro_range, "Colmeia: Enxame sai com o alvo dentro do aggro (%.1f m)" % reach)
		var at := Vector3(10, 0, 64.5)
		var hive: SimEntity = sim.spawn_monster(hv, "field_hollow", at)
		hive.brain = null
		for i in range(4):
			MobSystem.spawn_adds(sim, hive, bs)
		var adds: Array = sim.maps["field_hollow"]["entities"].filter(func(o): return o.boss_id == hive.id and o.is_alive())
		check(adds.size() == int(bs.get("max", 0)) and adds.all(func(o): return o.monster_def.id == "hive_wasp"), "Colmeia: vespas param no teto (%d)" % adds.size())
		for o in adds:
			sim.despawn(o)
		sim.despawn(hive)
	# Ursa-Mãe: chefe com fases, filhotes 0 XP, falas e skills que existem
	var bm: MonsterDef = gd.monsters["bear_mother"]
	check(bm.is_boss and bm.phases.size() >= 2 and bm.intro != "" and bm.last_words != "", "Ursa-Mãe: chefe com fases e falas")
	var sm: Dictionary = bm.phases[0].get("summon", {})
	check(gd.monsters.has(sm.get("id", "")) and gd.monsters[sm.get("id", "")].xp == 0, "Ursa-Mãe: filhotes da fase sem XP")
	check(bm.skill_ids.all(func(s): return gd.skills.has(s)), "Ursa-Mãe: skills existem")
	check(Music.MAP_THEME.get("field_hollow", "") == "campo", "Mata: tema de música")
	check(BotsCatalog.MAP_KIND.has("field_hollow") and BotsCatalog.LINES.has("hunt_field_hollow"), "Mata: falas de bots")

## Bosque dos Xamãs (14-18, ramo lateral a leste da Floresta; plano shaman-grove pacote D): portais, faixa, xamãs com formas
## válidas, chamadores com teto de bichos 0 XP, Arquidruida com fases e Enlaçar (raiz), quests x*, Cidade Élfica sem trava, vozes. `--only=grove`
func _check_field_grove(gd, sim) -> void:
	check(gd.maps.has("field_grove"), "Bosque dos Xamãs existe")
	if not gd.maps.has("field_grove"):
		return
	var md: MapDef = gd.maps["field_grove"]
	check(md.level_range == Vector2i(14, 18) and md.bot_population == 3 and not md.is_town and md.model == "map_field_grove", "Bosque: faixa 14-18, 3 bots, campo com modelo próprio")
	check(md.name == "Bosque dos Xamãs" and md.ground_color.is_equal_approx(Color(0.25, 0.42, 0.36)), "Bosque: nome e chão iguais à arte de carregamento")
	check(not MapsCatalog.CRYSTALS.has("field_grove"), "Bosque: sem cristal")
	var back: Array = md.portals.filter(func(p): return p["target_map"] == "field_forest")
	var there: Array = gd.maps["field_forest"].portals.filter(func(p): return p["target_map"] == "field_grove")
	check(back.size() == 1 and there.size() == 1, "Bosque: um portal de ida (Floresta) e um de volta")
	if back.size() == 1 and there.size() == 1:
		check(sim.is_walkable(there[0]["target_pos"], md, 0.45) and sim.is_walkable(back[0]["target_pos"], gd.maps["field_forest"], 0.45), "Bosque: chegadas dos dois lados andáveis")
		check(there[0]["target_pos"].distance_to(back[0]["pos"]) > back[0]["radius"] + 1.0, "Bosque: chegada fora do portal de volta")
	check(sim.is_walkable(md.spawn_point, md, 0.45), "Bosque: spawn andável")
	var ids := {}
	for sp in md.spawners:
		ids[sp["monster_id"]] = true
		var mm: MonsterDef = gd.monsters.get(sp["monster_id"])
		check(mm != null, "Bosque: spawner de %s existe" % sp["monster_id"])
		if mm:
			check(mm.level >= 14 and mm.level <= 18 and mm.xp > 0, "Bosque: %s na faixa e dá XP (nv %d)" % [mm.id, mm.level])
	for mid in ["shaman_shifter", "shaman_caller", "grove_wolf", "grove_bear", "boss_archdruid"]:
		check(ids.has(mid), "Bosque: spawner de %s" % mid)
	for it in ["painted_hide", "spirit_feather", "totem_bark"]:
		check(gd.items.has(it) and FileAccess.file_exists("res://assets/icons/art_%s.png" % it), "Bosque: material %s com arte" % it)
	# Metamorfo: formas válidas, aggro/leash da base, sem XP/saque; lobo furtivo, gavião atirador que recua
	var sh: MonsterDef = gd.monsters["shaman_shifter"]
	var forms := {}
	for f in sh.shift_forms:
		forms[str(f["form"])] = float(f["weight"])
	check(forms.keys().size() == 3 and forms.has("shaman_bear") and forms.has("shaman_wolf") and forms.has("shaman_hawk"), "Metamorfo: urso, lobo e gavião")
	for fid in forms:
		var fm: MonsterDef = gd.monsters.get(fid)
		check(fm != null and fm.xp == 0 and fm.loot_table == "" and fm.shift_forms.is_empty(), "Metamorfo: forma %s sem XP/saque" % fid)
		if fm:
			check(is_equal_approx(fm.aggro_range, sh.aggro_range) and is_equal_approx(fm.leash_range, sh.leash_range) and fm.level == sh.level, "Metamorfo: %s com aggro/leash/nível da base" % fid)
			check(fm.skill_ids.all(func(x): return gd.skills.has(x)) and fm.model != "", "Metamorfo: %s com modelo e skills que existem" % fid)
	check(gd.monsters["shaman_wolf"].shift_stealth and gd.monsters["shaman_hawk"].kite and gd.monsters["shaman_hawk"].ranged, "Metamorfo: lobo furtivo, gavião atirador que recua")
	check(ShiftSystem.pick_form(sh.shift_forms, 0.0) == "shaman_bear" and ShiftSystem.pick_form(sh.shift_forms, 0.99) == "shaman_hawk", "Metamorfo: sorteio por peso")
	# Chamador: invoca bichos 0 XP com teto que soma as três skills
	var ca: MonsterDef = gd.monsters["shaman_caller"]
	var cap := 0
	for sid in ca.skill_ids:
		var sk: SkillDef = gd.skills.get(sid)
		var bs: Dictionary = sk.effects.get("boss_summon", {}) if sk else {}
		var ad: MonsterDef = gd.monsters.get(bs.get("id", ""))
		check(ad != null and ad.xp == 0 and ad.loot_table == "" and ad.atk < ca.matk, "Chamador: %s chama bicho fraco sem XP" % sid)
		check(sk != null and MonsterBrain._skill_reach(sk, false) <= ca.aggro_range + 0.01 and MonsterBrain._skill_reach(sk, false) > 3.0, "Chamador: %s sai com o alvo no aggro" % sid)
		cap = maxi(cap, int(bs.get("max", 0)))
	check(cap == 3 and ca.ranged, "Chamador: no máximo 3 bichos e raio fraco de longe")
	var at := Vector3(57.6, 0, 9.6)
	var c: SimEntity = sim.spawn_monster(ca, "field_grove", at) if sim.maps.has("field_grove") else null
	if c:
		c.brain = null
		for sid in ca.skill_ids:
			for i in range(3):
				MobSystem.spawn_adds(sim, c, gd.skills[sid].effects["boss_summon"])
		var adds: Array = sim.maps["field_grove"]["entities"].filter(func(o): return o.boss_id == c.id and o.is_alive())
		check(adds.size() == 3, "Chamador: bichos param no teto (%d)" % adds.size())
		for o in adds:
			sim.despawn(o)
		sim.despawn(c)
	# Arquidruida: chefe, fases 75/50/25 (lobos, ursos, árvores) e último fôlego; Enlaçar = raiz em alvo aleatório com aviso roxo
	var bd: MonsterDef = gd.monsters["boss_archdruid"]
	check(bd.is_boss and bd.level == 18 and bd.intro != "" and bd.last_words != "" and bd.phases.size() == 4, "Arquidruida: chefe 18 com 4 fases e falas")
	var want := ["archdruid_wolf", "archdruid_bear", "archdruid_treant"]
	for i in range(3):
		var ph: Dictionary = bd.phases[i]
		var ad: MonsterDef = gd.monsters.get(ph.get("summon", {}).get("id", ""))
		check(is_equal_approx(float(ph["hp"]), [0.75, 0.5, 0.25][i]) and ad != null and ad.id == want[i] and ad.xp == 0 and ad.loot_table == "", "Arquidruida: fase %d chama %s sem XP" % [i + 1, want[i]])
	check(float(bd.phases[3]["hp"]) <= 0.15 and float(bd.phases[3].get("enrage", 1.0)) > 1.0, "Arquidruida: último fôlego com fúria")
	var en: SkillDef = gd.skills.get("mob_entangle")
	check(en != null and bd.skill_ids.has("mob_entangle") and en.effects.has("root") and en.target == SkillDef.Target.GROUND and en.mob_pick == "random" and en.startup >= 1.0, "Arquidruida: Enlaçar prende (raiz) um alvo aleatório com aviso")
	check(FxManager.CONTROL_TELEGRAPH.has("mob_entangle") and FxManager.DANGER_CONTROL.b > FxManager.DANGER_CONTROL.g, "Enlaçar: aviso roxo (controle)")
	check(bd.skill_ids.all(func(x): return gd.skills.has(x)), "Arquidruida: skills existem")
	# NPCs e quests
	var npc_ids := {}
	for m in gd.maps.values():
		for n in m.npcs:
			npc_ids[n["id"]] = m.id
	for nid in MapsCatalog.GROVE_NPCS:
		check(npc_ids.get(nid, "") == "field_grove", "Bosque: NPC %s no mapa" % nid)
	var chain := ["x0_grove", "x1_shifters", "x2_hides", "x3_callers", "x4_scout", "x5_totems", "x6_archdruid", "x7_report"]
	var done := {}
	for qid in chain:
		check(gd.quests.has(qid), "Bosque: quest %s" % qid)
		if not gd.quests.has(qid):
			continue
		var q: QuestDef = gd.quests[qid]
		check(q.level_req >= 14 and q.level_req <= 18 and q.dialog_progress != "", "Bosque: %s na faixa e com dica" % qid)
		check(npc_ids.has(q.giver_npc) and (q.turnin_npc == "" or npc_ids.has(q.turnin_npc)), "Bosque: %s tem giver/turnin em algum mapa" % qid)
		var pre: Array = ([q.prereq_quest] if q.prereq_quest != "" else []) + Array(q.prereq_all)
		check(pre.all(func(p): return done.has(p)), "Bosque: %s só pede quests anteriores da cadeia" % qid)
		if q.type == QuestDef.Type.KILL:
			check(ids.has(q.target_id), "Bosque: alvo de %s aparece no Bosque" % qid)
		elif q.type == QuestDef.Type.COLLECT:
			var src := false
			for mid in ids:
				var lt: LootTable = gd.loot_tables.get(gd.monsters[mid].loot_table)
				if lt:
					for e in lt.entries:
						src = src or e["item"] == q.target_id
			check(src, "Bosque: %s tem fonte de saque" % qid)
		done[qid] = true
	check(gd.quests["x0_grove"].giver_npc == "ranger_post" and gd.quests["x7_report"].turnin_npc == "ranger_post", "Bosque: começa e termina com o Ranger Teo")
	var gated := false
	for qid in gd.quests:
		if chain.has(qid):
			continue
		var q: QuestDef = gd.quests[qid]
		gated = gated or chain.has(q.prereq_quest) or Array(q.prereq_all).any(func(p): return chain.has(p))
	for pid in MapsCatalog.PORTAL_GATES:
		var g: Dictionary = MapsCatalog.PORTAL_GATES[pid]
		gated = gated or chain.has(str(g.get("quest", ""))) or Array(g.get("quests", [])).any(func(p): return chain.has(p))
	check(not gated, "Bosque: ramo lateral não trava a Cidade Élfica nem outra quest")
	# Aldeia dos Xamãs maior e folgada (2026-11-19; build_field_grove.VILLAGE/VILLAGE_R): 16+ xamãs em grupos de até 3, anel da praça e
	# as quatro entradas passam um disco de 3,2-5 m (antes o gargalo era 2,3 m), nenhum spawner da aldeia em cima de sólido
	var vc := Vector3(50.0, 0, 13.0)
	var in_village := 0
	var big_group := 0
	for sp in md.spawners:
		if str(sp["monster_id"]).begins_with("shaman_") and Vector3(sp["pos"].x, 0, sp["pos"].z).distance_to(vc) < 29.0:
			in_village += int(sp["count"])
			big_group = maxi(big_group, int(sp["count"]))
			check(sim.is_walkable(Vector3(sp["pos"].x, 0, sp["pos"].z), md, 1.0), "Aldeia: spawner de %s em chão livre" % sp["monster_id"])
	check(in_village >= 16 and big_group <= 3, "Aldeia dos Xamãs: 16+ xamãs em grupos de até 3 (%d, maior grupo %d)" % [in_village, big_group])
	var tight := 0
	for i in range(24):
		var a := TAU * i / 24.0
		if not sim.is_walkable(vc + Vector3(cos(a), 0, sin(a)) * 9.6, md, 1.6):
			tight += 1
	for deg in [185.0, 290.0, 25.0, 105.0]:
		for r in [14.0, 17.0, 20.0]:
			if not sim.is_walkable(vc + Vector3(cos(deg_to_rad(deg)), 0, sin(deg_to_rad(deg))) * r, md, 2.5):
				tight += 1
	check(tight == 0, "Aldeia dos Xamãs: anel da praça e entradas sem aperto (%d pontos apertados)" % tight)
	check(QuestsCatalog.HUNT_GIVERS.get("field_grove", "") == "grove_warden", "Bosque: caçadas repetíveis com a Guardiã")
	# som: todo bicho do bosque tem voz no banco; metamorfose e Enlaçar têm som
	for mid in ["shaman_shifter", "shaman_bear", "shaman_wolf", "shaman_hawk", "shaman_caller", "grove_wolf", "grove_bear", "grove_boar", "grove_rabbit", "grove_deer",
			"boss_archdruid", "archdruid_wolf", "archdruid_bear", "archdruid_treant"]:
		var v: Array = Sfx.voice_of(gd.monsters[mid])
		var ok := v.size() == 3
		for snd in v:
			if str(snd) != "" and not (FileAccess.file_exists("res://assets/audio/sfx/%s_1.wav" % snd) or FileAccess.file_exists("res://assets/audio/sfx/%s_1.ogg" % snd)):
				ok = false
		check(ok and (str(v[0]) != "" or str(v[1]) != ""), "Bosque: %s tem voz no banco de sons" % mid)
	check(Sfx.CAST_SOUND.get("mob_entangle", "") != "" and Sfx.SHIFT_SOUND.has("cast") and Sfx.SHIFT_SOUND.has("shaman_bear"), "Bosque: Enlaçar e metamorfose têm som")
	check(Music.MAP_THEME.get("field_grove", "") == "campo", "Bosque: tema de música")
	check(BotsCatalog.MAP_KIND.has("field_grove") and BotsCatalog.LINES.has("hunt_field_grove"), "Bosque: falas de bots")
	check(DevRunner.TOURS.has("field_grove"), "Bosque: pontos do tour")

## Cidade Élfica por dentro (2026-11-19): grupos novos dentro do anel (MapsCatalog.ELF_CITY_GROUPS), andáveis, longe da entrada
## do Coração; com a escolta dos sargentos, o anel passa de 50 elfos. `--only=elf_city_inner`
func _check_elf_city_inner(gd, sim) -> void:
	var def: MapDef = gd.maps["elf_city"]
	var inner := 0
	var groups := 0
	for sp in def.spawners:
		var p: Vector3 = sp["pos"]
		if Vector2(p.x, p.z).length() > def.town_radius:
			continue
		var n := int(sp["count"])
		var md: MonsterDef = gd.monsters.get(sp["monster_id"])
		check(md != null, "elfos: monstro %s existe" % sp["monster_id"])
		if md and not md.escort.is_empty():
			n += int(md.escort.get("count", 0))
		inner += n
	for g in MapsCatalog.ELF_CITY_GROUPS:
		var c := Vector3(float(g[0]), 0, float(g[1]))
		groups += 1
		check(sim.is_walkable(c, def, 0.6) and c.length() < def.town_radius - 10.0 and c.distance_to(Vector3(6.2, 0, 6.2)) > 12.0,
			"elfos: grupo em (%.0f, %.0f) andável, dentro do anel e longe do Coração" % [c.x, c.z])
	check(groups >= 6 and inner >= 50, "elfos: %d grupos novos, %d elfos dentro do anel (com escoltas)" % [groups, inner])

## Quest trancada por outra da corrente (2026-11-19): o NPC mostra o que falta e com quem (QuestSystem.blocked_from_npc).
## Caso real: o Arquidruida pede O Que o Batedor Viu E a Casca dos Totens. `--only=quest_blocked_hint`
func _check_quest_blocked_hint(gd, sim) -> void:
	var p: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Trancada", "city_aldara", Vector3(30, 0, -44), 17)
	p.brain = null
	for qid in ["x0_grove", "x1_shifters", "x2_hides", "x3_callers", "x4_scout"]:
		p.quests_completed.append(qid)
	var ids: Array = QuestSystem.blocked_from_npc(p, "grove_warden").map(func(q): return q.id)
	check("x6_archdruid" in ids, "trancada: a Guardiã mostra O Arquidruida trancado sem a Casca dos Totens (%s)" % [ids])
	check(QuestSystem.missing_prereqs(p, gd.quests["x6_archdruid"]) == ["x5_totems"], "trancada: o que falta é a Casca dos Totens")
	p.quests_completed.append("x5_totems")
	check(QuestSystem.blocked_from_npc(p, "grove_warden").is_empty() and QuestSystem.can_accept(p, gd.quests["x6_archdruid"]), "trancada: com as duas feitas, a quest abre")
	var fresh: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Novato", "city_aldara", Vector3(31, 0, -44), 17)
	fresh.brain = null
	check(QuestSystem.blocked_from_npc(fresh, "grove_warden").is_empty(), "trancada: quem não começou a corrente não vê a quest trancada")
	sim.despawn(p)
	sim.despawn(fresh)

## Janela de Skills (J, decisão 2026-11-19): abas = builds + Gerais (+ Ascensão no 35), toda skill da classe cai numa aba só;
## a ficha (SkillSheet) mostra os números de agora e muda com o ATK e com a teia. `--only=skill_book`
func _check_skill_book(gd, sim) -> void:
	var w = load("res://game/ui/windows.gd").new()
	for cid in gd.classes:
		var p: SimEntity = sim.spawn_bot(gd.classes[cid], "Livro", "city_aldara", Vector3(30, 0, -44), 20)
		p.brain = null
		var tabs: Array = w._book_tabs(p)
		check(tabs.size() == gd.classes[cid].builds.size() + 1 and tabs[-1][0] == "geral", "skills J: %s tem %d abas (builds + Gerais) no 20" % [cid, tabs.size()])
		var seen := {}
		for t in tabs + [["asc", ""]]:
			for sk in w._book_skills(p, t[0]):
				seen[sk.id] = int(seen.get(sk.id, 0)) + 1
		var missing: Array = gd.classes[cid].skill_ids.filter(func(sid): return not gd.skills[sid].mount_only and int(seen.get(sid, 0)) != 1)
		check(missing.is_empty(), "skills J: toda skill de %s em exatamente uma aba (%s)" % [cid, missing])
		p.level = Balance.ASC_LEVEL
		var asc: bool = gd.classes[cid].skill_ids.any(func(sid): return gd.skills[sid].ascension)
		check(not asc or w._book_tabs(p)[-1][0] == "asc", "skills J: %s ganha a aba Ascensão no %d" % [cid, Balance.ASC_LEVEL])
		sim.despawn(p)
	# ficha: dano = ATK × poder; sobe com o ATK; buff longo mostra 60 s; gelo mostra a velocidade de ataque
	var e: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Ficha", "city_aldara", Vector3(30, 0, -44), 20)
	e.brain = null
	var fb: SkillDef = gd.skills["ele_fireball"]
	var d1: Dictionary = SkillSheet.damage_of(e, SkillSheet.resolved(e, fb))
	check(is_equal_approx(float(d1["avg"]), e.stats.matk * SkillSheet.power_of(e, SkillSheet.resolved(e, fb)) * (1.0 + e.stats.vit_dmg_pct / 100.0)) and float(d1["avg"]) > 0.0,
		"skills J: dano da Bola de Fogo = MATK × poder (%.0f)" % float(d1["avg"]))
	e.stats.matk *= 2.0
	check(is_equal_approx(float(SkillSheet.damage_of(e, SkillSheet.resolved(e, fb))["avg"]), float(d1["avg"]) * 2.0), "skills J: o dano da ficha acompanha o MATK")
	e.recompute_stats()
	var labels := func(sid: String) -> String:
		return " | ".join(SkillSheet.rows(e, gd.skills[sid]).map(func(r): return "%s: %s" % r))
	var fa: String = labels.call("ele_frost_armor")
	check("Buff" in fa and ("%d s" % int(Balance.BUFF_KEEP_S)) in fa and "Escudo" in fa and "Custo" in fa and "Recarga" in fa, "skills J: Armadura de Gelo mostra buff de 60 s, escudo, custo e recarga (%s)" % fa)
	var il: String = labels.call("ele_ice_lance")
	check("Dano" in il and "lentidão" in il and "vel. de ataque" in il and "Alcance" in il, "skills J: Lança de Gelo mostra dano, alcance e lentidão com velocidade de ataque (%s)" % il)
	sim.despawn(e)
	w.free()

## Armadura de Gelo (decisão 2026-11-19): corta o dano recebido em FROST_ARMOR_DR_BASE% + 1% a cada PER_INT de INT, até CAP
## (sem +DEF). `--only=frost_armor_dr`
func _check_frost_armor_dr(gd, sim) -> void:
	var fa: SkillDef = gd.skills["ele_frost_armor"]
	var b: Dictionary = fa.effects["buff"]
	check(b.get("dr_int", false) and not b.has("def_pct"), "armadura de gelo: corta dano pela INT, sem +DEF")
	check("15% do HP" in fa.description and "40%" in fa.description, "armadura de gelo: texto formatado (%s)" % fa.description)
	# nenhuma descrição de skill com código de formatação sobrando (%d, %.Nf, %%, %s)
	var raw: Array = []
	var rx := RegEx.create_from_string("%(\\d*\\.?\\d*[dfs]|%)")
	for sid in gd.skills:
		if rx.search(str(gd.skills[sid].description)) != null:
			raw.append(sid)
	check(raw.is_empty(), "skills: nenhuma descrição com %%d/%%s/%%%% cru (%s)" % [raw])
	check(is_equal_approx(Stats.frost_armor_dr(0.0), Balance.FROST_ARMOR_DR_BASE) and is_equal_approx(Stats.frost_armor_dr(100.0), Balance.FROST_ARMOR_DR_BASE + 100.0 / Balance.FROST_ARMOR_DR_PER_INT)
		and is_equal_approx(Stats.frost_armor_dr(99999.0), Balance.FROST_ARMOR_DR_CAP), "armadura de gelo: 15% + 1% a cada 10 INT, teto 40%")
	var e: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Geada", "city_aldara", Vector3(32, 0, -44), 30)
	e.brain = null
	var before := e.stats.dr_pct
	var def_before := e.stats.pdef
	sim._apply_effects(e, e, {"buff": b}, 1.0)
	var want := Stats.frost_armor_dr(float(e.stats.attrs["INT"]))
	check(is_equal_approx(e.stats.dr_pct - before, want) and is_equal_approx(e.stats.pdef, def_before), "armadura de gelo: -%.0f%% de dano com INT %d, DEF igual" % [want, int(e.stats.attrs["INT"])])
	# golpe real: o dano cai na proporção (dentro do teto geral DR_CAP)
	var foe: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", e.position + Vector3(1.5, 0, 0))
	foe.brain = null
	e.shield_hp = 0.0
	e.stats.evasion = 0.0
	e.hp = 1.0e6                   # o golpe de teste não pode matar
	e.mp = 0.0                     # sem Barreira de Mana / escudo de mana dos talentos: mede só a armadura
	var hp0 := e.hp
	sim._deal_damage(foe, e, 1000, false, false, "physical", null, false)
	var took := hp0 - e.hp
	var exp_took := roundi(1000.0 * (1.0 - minf(e.stats.dr_pct, Balance.DR_CAP) / 100.0))
	check(absf(took - exp_took) <= 2.0, "armadura de gelo: golpe de 1000 tira %.0f (esperado %d)" % [took, exp_took])
	sim.despawn(foe)
	sim.despawn(e)

## Lentidão de gelo (decisão 2026-11-19): além do movimento, -Balance.FROST_ASPD_SLOW% de velocidade de ataque (intervalo do
## básico maior); lentidão que não é de gelo (Esmagar do Druida) só mexe no movimento. `--only=frost_aspd`
func _check_frost_aspd(gd, sim) -> void:
	var ice: SkillDef = gd.skills["ele_ice_lance"]
	var maul: SkillDef = gd.skills["dru_maul"]
	check(bool(ice.effects["slow"].get("frost", false)) and not bool(maul.effects["slow"].get("frost", false)), "gelo: Lança de Gelo marca a lentidão como de gelo; Esmagar não")
	var at := Vector3(30, 0, -40)
	var src: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "GeloA", "city_aldara", at, 20)
	var t: SimEntity = sim.spawn_bot(gd.classes["berserker"], "GeloB", "city_aldara", at + Vector3(2, 0, 0), 20)
	src.brain = null
	t.brain = null
	check(is_equal_approx(Combat.frost_attack_mult(t), 1.0), "gelo: sem lentidão o ataque é o normal")
	sim._apply_effects(src, t, {"slow": maul.effects["slow"]}, 1.0)
	check(is_equal_approx(Combat.frost_attack_mult(t), 1.0) and t.slow_factor() < 1.0, "gelo: lentidão comum só retarda o movimento")
	sim._apply_effects(src, t, {"slow": ice.effects["slow"]}, 1.0)
	sim._apply_effects(src, t, {"slow": ice.effects["slow"]}, 1.0)
	var want := 1.0 / (1.0 - Balance.FROST_ASPD_SLOW / 100.0)
	check(is_equal_approx(Combat.frost_attack_mult(t), want), "gelo: -%d%% de velocidade de ataque (intervalo x%.2f; duas não somam)" % [int(Balance.FROST_ASPD_SLOW), want])
	# o básico de quem está gelado demora mais
	var cmd := InputCommand.new()
	cmd.attack = true
	cmd.aim = src.position
	t.basic_cd = 0.0
	t.set_state(SimEntity.State.IDLE)
	sim._apply_command(t, cmd, sim.maps["city_aldara"], 0.0)
	check(is_equal_approx(t.basic_cd, t.stats.basic_cooldown(t.basic_skill.cooldown) * want), "gelo: recarga do básico x%.2f (%.2f s)" % [want, t.basic_cd])
	sim.despawn(src)
	sim.despawn(t)

## Buffs de "ligar e esquecer" duram Balance.BUFF_KEEP_S (decisão 2026-11-19); o escudo absorvente das armaduras fica curto
## e a descrição diz o tempo novo. `--only=keep_buffs`
const KEEP_BUFFS := ["ele_frost_armor", "nec_bone_armor", "dru_oak_skin", "pal_blessed_armor", "dru_bark", "bis_blessing", "bis_ward",
	"bis_battle_hymn", "dru_grove", "nec_dark_pact", "ran_pack", "ass_plague_blade"]
func _check_keep_buffs(gd) -> void:
	check(Balance.BUFF_KEEP_S >= 60.0, "buffs longos: BUFF_KEEP_S = %.0f s" % Balance.BUFF_KEEP_S)
	var txt := "%ds" % int(Balance.BUFF_KEEP_S)
	for sid in KEEP_BUFFS:
		var s: SkillDef = gd.skills.get(sid)
		check(s != null and is_equal_approx(float(s.effects.get("buff", {}).get("duration", 0.0)), Balance.BUFF_KEEP_S) and txt in s.description,
			"buffs longos: %s dura %s (e o texto diz)" % [sid, txt])
		if s != null and s.effects.has("shield"):
			check(float(s.effects["shield"].get("duration", 0.0)) < Balance.BUFF_KEEP_S, "buffs longos: escudo de %s continua curto" % sid)
	check(float(gd.skills["ber_fury"].effects["buff"]["duration"]) < Balance.BUFF_KEEP_S, "buffs longos: os de explosão (Fúria) continuam curtos")

## Boneco de treino (MonsterDef.dummy, MapsCatalog.TRAINING_DUMMIES): em Aldara, entre o portão oeste e o rio; não morre,
## se recompõe parado, só o jogador (e as invocações dele) o acertam; bots/sentinelas/monstros o ignoram. `--only=dummy`
func _check_training_dummy(gd, sim) -> void:
	var dd: MonsterDef = gd.monsters.get("training_dummy")
	check(dd != null and dd.dummy and dd.hp >= 99999.0 and dd.xp == 0 and dd.loot_table == "" and dd.move_speed == 0.0, "boneco: monstro training_dummy (99999 de vida, sem XP/saque, parado)")
	check(Balance.DUMMY_REGEN_DELAY > 0.0 and Balance.DUMMY_REGEN_PCT > 0.0, "boneco: números no Balance")
	var mdef: MapDef = gd.maps["city_aldara"]
	var spots: Array = MapsCatalog.TRAINING_DUMMIES["city_aldara"]
	var n := 0
	for sp in mdef.spawners:
		if sp["monster_id"] == "training_dummy":
			n += 1
			var p: Vector3 = sp["pos"]
			check(MapGeometry.is_walkable(sim, p, mdef) and p.x < -31.0 and p.x > -50.0 and float(sp["radius"]) == 0.0, "boneco: (%.1f, %.1f) andável, entre o portão oeste e o rio" % [p.x, p.z])
	check(n == spots.size() and n >= 3, "boneco: %d spawners em Aldara" % n)
	var at := Vector3(-42.0, 0, -9.6)
	var dummy: SimEntity = sim.spawn_monster(dd, "city_aldara", at)
	var me: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "TreinoJogador", "city_aldara", at + Vector3(2, 0, 0), 20)
	me.brain = null
	me.kind = SimEntity.Kind.PLAYER
	var bot: SimEntity = sim.spawn_bot(gd.classes["berserker"], "TreinoBot", "city_aldara", at + Vector3(-2, 0, 0), 20)
	var mob: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", at + Vector3(0, 0, 2))
	mob.brain = null
	var guard := SimEntity.new()
	guard.kind = SimEntity.Kind.NPC
	guard.guard = true
	var pet := SimEntity.new()
	pet.kind = SimEntity.Kind.SUMMON
	pet.player_owned = true
	var bot_pet := SimEntity.new()
	bot_pet.kind = SimEntity.Kind.SUMMON
	check(me.is_hostile_to(dummy) and dummy.is_hostile_to(me) and pet.is_hostile_to(dummy), "boneco: o jogador e a invocação dele o acertam")
	check(not bot.is_hostile_to(dummy) and not guard.is_hostile_to(dummy) and not mob.is_hostile_to(dummy) and not bot_pet.is_hostile_to(dummy) and not dummy.is_hostile_to(bot),
		"boneco: bot, sentinela, monstro e invocação de bot não o miram")
	var m: Dictionary = sim.maps["city_aldara"]
	var found: SimEntity = Combat.nearest_hostile(bot, [dummy], 10.0)
	check(found == null and bot.brain._pick_monster(bot, {"entities": [dummy]}) == null, "boneco: bot não escolhe o boneco para caçar")
	# golpe enorme: segura em 1 HP, sem aggro nem crédito
	sim._deal_damage(me, dummy, 250000, false, false, "magical")
	check(dummy.is_alive() and is_equal_approx(dummy.hp, 1.0) and dummy.aggro_target < 0 and dummy.damage_by.is_empty(), "boneco: não morre (1 HP), sem aggro (hp %.0f)" % dummy.hp)
	sim._kill(dummy, me)
	check(dummy.is_alive(), "boneco: morte direta (execução) também não o derruba")
	# o cérebro fica parado mesmo apanhando
	var cmd: InputCommand = MonsterBrain.new().think(dummy, sim, m, 0.1)
	check(cmd.move == Vector2.ZERO and not cmd.attack, "boneco: cérebro parado")
	# recompõe: nada antes do atraso, cheio depois
	dummy.position = at + Vector3(1.5, 0, 0)
	MobSystem.update_dummy(sim, dummy, 0.5)
	check(is_equal_approx(dummy.hp, 1.0), "boneco: apanhando há pouco não se recompõe")
	dummy.hurt_at = sim.time - Balance.DUMMY_REGEN_DELAY - 0.1
	for i in 30:
		MobSystem.update_dummy(sim, dummy, 0.1)
	check(is_equal_approx(dummy.hp, dummy.stats.max_hp) and dummy.position.is_equal_approx(at), "boneco: parado se recompõe em %.0f s e volta ao lugar" % (1.0 / Balance.DUMMY_REGEN_PCT))
	for e in [dummy, me, bot, mob]:
		sim.despawn(e)

## Metamorfose de monstro (ShiftSystem; plano shaman-grove pacote C): sorteio fixo por roll, vida em %, skills da forma,
## volta no leash/reset/fora de combate, abate pela base, lobo furtivo com emboscada única, gavião recua, bots lutam contra.
## Monstros de teste montados aqui (cópias do golem); o conteúdo real (xamãs) entra depois. `--only=shift`
func _check_monster_shift(gd, sim) -> void:
	var src: MonsterDef = gd.monsters["golem"]
	var skill_src := ""
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		if not md.skill_ids.is_empty() and gd.skills.has(md.skill_ids[0]):
			skill_src = md.skill_ids[0]
			break
	var mk := func(id: String, nm: String) -> MonsterDef:
		var d: MonsterDef = src.duplicate()
		d.id = id; d.name = nm; d.skill_ids = [] as Array[String]; d.shift_forms = []; d.xp = 0; d.loot_table = ""
		gd.monsters[id] = d
		return d
	var base: MonsterDef = mk.call("t_shift_base", "Xamã Teste")
	base.xp = src.xp if src.xp > 0 else 20
	base.loot_table = src.loot_table
	var bear: MonsterDef = mk.call("t_shift_bear", "Urso")
	bear.hp = base.hp * 2.0
	bear.skill_ids = [skill_src] as Array[String]
	var wolf: MonsterDef = mk.call("t_shift_wolf", "Lobo")
	wolf.shift_stealth = true
	var hawk: MonsterDef = mk.call("t_shift_hawk", "Gavião")
	hawk.ranged = true
	hawk.kite = true
	hawk.attack_range = 9.0
	# sorteio: puro, mesmo roll = mesma forma, peso 0 nunca sai
	var forms := [{"form": "t_shift_bear", "weight": 1}, {"form": "t_shift_wolf", "weight": 0}, {"form": "t_shift_hawk", "weight": 3}]
	check(ShiftSystem.pick_form(forms, 0.1) == "t_shift_bear" and ShiftSystem.pick_form(forms, 0.1) == "t_shift_bear", "metamorfose: mesmo roll, mesma forma")
	var never := true
	for i in 100:
		never = never and ShiftSystem.pick_form(forms, i / 100.0) != "t_shift_wolf"
	check(never and ShiftSystem.pick_form(forms, 0.5) == "t_shift_hawk" and ShiftSystem.pick_form([], 0.5) == "", "metamorfose: peso 0 nunca sai; peso maior pega a maior faixa")
	check(Balance.SHIFT_CAST_S > 0.0 and Balance.SHIFT_REVERT_S > 0.0 and Balance.SHIFT_AMBUSH_MULT > 1.0 and Balance.SHIFT_KITE_DIST > 0.0, "metamorfose: números no Balance")
	var at := Vector3(-40, 0, 40)
	var foe: SimEntity = sim.spawn_bot(gd.classes["paladin"], "AlvoXama", "city_aldara", at + Vector3(2, 0, 0), maxi(1, base.level))
	foe.brain = null
	var m: Dictionary = sim.maps["city_aldara"]
	var mob: SimEntity = sim.spawn_monster(base, "city_aldara", at)
	mob.brain = null
	base.shift_forms = [{"form": "t_shift_bear", "weight": 1}]
	var aggro := func(x: SimEntity) -> void:
		x.aggro_target = foe.id; x.aggro_timer = Balance.AGGRO_LOSE_TIME; x.threat = {foe.id: 5.0}
	ShiftSystem.update(sim, mob, 0.05)
	check(mob.shift_left == 0.0 and mob.monster_def == base and mob.shift_base == null, "metamorfose: sem combate fica na base")
	mob.hp = mob.stats.max_hp * 0.5
	aggro.call(mob)
	ShiftSystem.update(sim, mob, 0.05)
	check(mob.shift_left > 0.0 and mob.shift_pick == "t_shift_bear" and mob.monster_def == base, "metamorfose: entrar em combate começa a conjuração")
	ShiftSystem.update(sim, mob, Balance.SHIFT_CAST_S + 0.1)
	check(mob.monster_def == bear and mob.shift_base == base and is_equal_approx(mob.stats.max_hp, bear.hp), "metamorfose: virou a forma (vida máxima da forma)")
	check(absf(mob.hp / mob.stats.max_hp - 0.5) < 0.01, "metamorfose: guarda o %% da vida (%.2f)" % (mob.hp / mob.stats.max_hp))
	var ids: Array = mob.skills.map(func(sk): return sk.id)
	check(ids == Array(bear.skill_ids) and mob.basic_skill.id == "basic_mob_t_shift_bear" and mob.name == "Xamã Teste (Urso)", "metamorfose: skills, básico e nome da forma (%s)" % mob.name)
	check(mob.aggro_target == foe.id and mob.threat.has(foe.id), "metamorfose: aggro e ameaça ficam")
	# fora de combate: volta depois de SHIFT_REVERT_S
	mob.aggro_target = -1
	mob.combat_timer = 0.0
	ShiftSystem.update(sim, mob, Balance.SHIFT_REVERT_S * 0.5)
	check(mob.monster_def == bear, "metamorfose: meio tempo fora de combate ainda é a forma")
	ShiftSystem.update(sim, mob, Balance.SHIFT_REVERT_S)
	check(mob.monster_def == base and mob.shift_base == null and mob.name == base.name and mob.skills.is_empty() and absf(mob.hp / mob.stats.max_hp - 0.5) < 0.01, "metamorfose: volta à base fora de combate, vida em %")
	# leash: o cérebro devolve a base
	aggro.call(mob)
	ShiftSystem.update(sim, mob, 0.05)
	ShiftSystem.update(sim, mob, Balance.SHIFT_CAST_S + 0.1)
	mob.brain = MonsterBrain.new()
	mob.position = at + Vector3(bear.leash_range + 5.0, 0, 0)
	mob.brain.think(mob, sim, m, 0.05)
	check(mob.monster_def == base and mob.shift_base == null, "metamorfose: leash volta à base")
	mob.position = at
	mob.brain = null
	# reset (chefe)
	aggro.call(mob)
	ShiftSystem.update(sim, mob, 0.05)
	ShiftSystem.update(sim, mob, Balance.SHIFT_CAST_S + 0.1)
	sim.reset_boss(mob)
	check(mob.monster_def == base, "metamorfose: reset volta à base")
	# conjuração cancelada ao perder o alvo
	aggro.call(mob)
	ShiftSystem.update(sim, mob, 0.05)
	mob.aggro_target = -1
	ShiftSystem.update(sim, mob, 0.05)
	check(mob.shift_left == 0.0 and mob.monster_def == base, "metamorfose: perder o alvo cancela a conjuração")
	# abate: morre como a forma, XP/saque/quest pela base
	aggro.call(mob)
	ShiftSystem.update(sim, mob, 0.05)
	ShiftSystem.update(sim, mob, Balance.SHIFT_CAST_S + 0.1)
	check(mob.monster_def == bear, "metamorfose: transformado antes do abate")
	mob.damage_by = {foe.id: 100.0}
	var xp0: int = foe.xp
	var lv0: int = foe.level
	sim._kill(mob, foe)
	check(mob.monster_def == base and not mob.is_alive(), "metamorfose: o morto devolve a base (abate/quest contam %s)" % mob.monster_def.id)
	check(foe.xp > xp0 or foe.level > lv0, "metamorfose: XP do abate vem da base (a forma tem 0)")
	sim.despawn(mob)
	# lobo: furtivo, emboscada uma vez, área ainda acerta
	base.shift_forms = [{"form": "t_shift_wolf", "weight": 1}]
	var w: SimEntity = sim.spawn_monster(base, "city_aldara", at)
	w.brain = null
	aggro.call(w)
	ShiftSystem.update(sim, w, 0.05)
	ShiftSystem.update(sim, w, Balance.SHIFT_CAST_S + 0.1)
	check(w.monster_def == wolf and is_equal_approx(w.stealth_left, Balance.SHIFT_STEALTH_S), "lobo: entra furtivo")
	check(Combat.nearest_hostile(foe, [w], 20.0) == null, "lobo furtivo: ninguém mira nele")
	var aoe: SkillDef = null
	for sid in gd.skills:
		var sk: SkillDef = gd.skills[sid]
		if sk.target == SkillDef.Target.SELF and sk.radius >= 3.0 and sk.kind == SkillDef.Kind.PHYSICAL and not String(sid).begins_with("mob_"):
			aoe = sk
			break
	check(aoe != null, "metamorfose: achou golpe em área de jogador para o teste")
	if aoe:
		foe.position = w.position + Vector3(1.0, 0, 0)
		check(w in Combat.select_targets(foe, aoe, foe.position, [w]), "lobo furtivo: golpe em área (%s) acerta" % aoe.id)
	# recém-furtivo: espreita SHIFT_STEALTH_MIN_S sem golpe nem skill (senão a furtividade quebrava na hora)
	foe.position = w.position + Vector3(1.0, 0, 0)
	var wb := MonsterBrain.new()
	var c0: InputCommand = wb.think(w, sim, m, 0.05)
	check(not c0.attack and c0.skill_slot < 0 and w.stealth_left > 0.0, "lobo furtivo: espreita antes do bote (sem golpe nem skill no começo)")
	w.stealth_left = Balance.SHIFT_STEALTH_S - Balance.SHIFT_STEALTH_MIN_S - 0.1
	w.basic_cd = 0.0
	var c1: InputCommand = wb.think(w, sim, m, 0.05)
	check(c1.attack or c1.skill_slot >= 0, "lobo furtivo: depois de espreitar, dá o bote")
	w.stealth_left = Balance.SHIFT_STEALTH_S
	sim._start_skill(w, w.basic_skill, -1, foe.position)
	check(w.stealth_left == 0.0 and w.ambush and is_equal_approx(ShiftSystem.ambush_mult(w), Balance.SHIFT_AMBUSH_MULT), "lobo: 1º golpe sai da furtividade como emboscada × SHIFT_AMBUSH_MULT")
	sim._apply_skill(w, w.basic_skill, m)
	sim._end_skill(w)
	sim._start_skill(w, w.basic_skill, -1, foe.position)
	check(not w.ambush, "lobo: emboscada só uma vez")
	sim._end_skill(w)
	sim.despawn(w)
	# gavião: recua entre os tiros
	base.shift_forms = [{"form": "t_shift_hawk", "weight": 1}]
	var h: SimEntity = sim.spawn_monster(base, "city_aldara", at)
	h.brain = null
	aggro.call(h)
	ShiftSystem.update(sim, h, 0.05)
	ShiftSystem.update(sim, h, Balance.SHIFT_CAST_S + 0.1)
	foe.position = h.position + Vector3(2.0, 0, 0)
	foe.hp = foe.stats.max_hp
	h.basic_cd = 1.0
	h.brain = MonsterBrain.new()
	var cmd: InputCommand = h.brain.think(h, sim, m, 0.05)
	var away := Vector2(h.position.x - foe.position.x, h.position.z - foe.position.z).normalized()
	check(h.monster_def == hawk and cmd.move.dot(away) > 0.7, "gavião: alvo a 2 m, recua entre os tiros (%s)" % str(cmd.move))
	sim.despawn(h)
	# bots de verdade contra o xamã (forma sorteada pela sim)
	base.shift_forms = [{"form": "t_shift_bear", "weight": 1}, {"form": "t_shift_wolf", "weight": 1}, {"form": "t_shift_hawk", "weight": 1}]
	sim.despawn(foe)
	for d in [base, bear, wolf, hawk]:
		d.hp *= 6.0          # aguenta a conjuração e um tempo na forma
	var mob2: SimEntity = sim.spawn_monster(base, "city_aldara", at)
	var b: SimEntity = sim.spawn_bot(gd.classes["berserker"], "CacaXama", "city_aldara", at + Vector3(3, 0, 0), maxi(1, base.level))
	MobSystem.retarget(sim, mob2, b)
	var shifted := false
	for i in 600:
		sim.tick(1.0 / 60.0)
		shifted = shifted or mob2.shift_base != null
		if not mob2.is_alive() or (shifted and mob2.hp < mob2.stats.max_hp * 0.8):
			break
	check(shifted and (not mob2.is_alive() or mob2.hp < mob2.stats.max_hp), "metamorfose: bot luta contra o xamã transformado (transformou=%s vivo=%s vida=%.0f/%.0f)" % [str(shifted), str(mob2.is_alive()), mob2.hp, mob2.stats.max_hp])
	sim.despawn(mob2)
	sim.despawn(b)
	for id in ["t_shift_base", "t_shift_bear", "t_shift_wolf", "t_shift_hawk"]:
		gd.monsters.erase(id)

## Skills pelo nível (2026-11-18): toda skill comum da classe chega sozinha no nível dela (spawn, subir de nível, bot),
## nunca as de ascensão; a barra pega as novas; o bot só põe na barra as da build e as gerais.
func _check_level_skills(gd, sim) -> void:
	var cls: ClassDef = gd.classes["paladin"]
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.PLAYER, cls, "Novato", "city_aldara", Vector3(-30, 0, 30), 1)
	var at1 := ProgressionSystem.level_skill_ids(cls, 1)
	check(at1.size() >= 2 and at1[0] == cls.starting_skills[0] and at1.all(func(sid): return e.knows(sid)), "nível 1: as skills iniciais (e as de nível 1) já vêm aprendidas (%d)" % at1.size())
	var later: Array = Array(cls.skill_ids).filter(func(sid): return not gd.skills[sid].ascension and gd.skills[sid].unlock_level > 1 and gd.skills[sid].unlock_level <= 8)
	check(not later.is_empty() and later.all(func(sid): return not e.knows(sid)), "nível 1: skill de nível maior ainda não vem (%d esperando)" % later.size())
	sim.gain_xp(e, Balance.band_xp(1, 8) + 10)
	var lv: int = e.level
	var want := ProgressionSystem.level_skill_ids(cls, lv)
	check(lv >= 8 and want.all(func(sid): return e.knows(sid)), "subiu ao %d: aprendeu as %d skills do nível sozinho" % [lv, want.size()])
	check(e.skills.slice(0, Balance.SKILL_SLOTS).filter(func(s): return s != null).size() >= mini(Balance.SKILL_SLOTS, 4), "skills novas entram nas vagas livres da barra")
	check(not e.learned.keys().any(func(sid): return gd.skills[sid].ascension), "skill de ascensão nunca vem pelo nível")
	sim.despawn(e)
	# bot do 20: todas as skills do nível, ranks de graça nas da build, barra só com build + gerais
	for cid in gd.classes:
		var bc: ClassDef = gd.classes[cid]
		var b: SimEntity = sim.spawn_bot(bc, "LvBot", "city_aldara", Vector3(-31, 0, 31), 20)
		b.brain = null
		check(ProgressionSystem.level_skill_ids(bc, 20).all(func(sid): return b.knows(sid)), "%s: bot do 20 conhece as skills do nível" % cid)
		var bw: Array = bc.build_by_id(b.build_id).get("skills", [])
		var ranked := bw.filter(func(sid): return b.knows(sid) and not gd.skills[sid].ascension)
		check(ranked.all(func(sid): return b.mastery_of(sid) == ProgressionSystem.bot_rank(b, gd.skills[sid])), "%s/%s: bot com rank de graça pelo nível nas skills da build" % [cid, b.build_id])
		var stray: Array = []
		for s in b.skills.slice(0, Balance.SKILL_SLOTS):
			if s != null and not (s.id in bw) and not (s.build in ["", b.build_id]) and not (s.id in bc.starting_skills):
				stray.append(s.id)
		check(stray.is_empty(), "%s/%s: barra do bot sem skill de outra build %s" % [cid, b.build_id, stray])
		sim.despawn(b)

## Nós da skill na teia (2026-11-18): "<Skill> Aprimorada" (+SKILL_UP_POWER de poder) e "<Skill> Ágil" (-SKILL_QUICK_PCT de
## recarga e de MP), 1 ponto cada, uma vez; precisam conhecer a skill; valem no resolve_skill e no try_cast.
func _check_skill_upgrade_nodes(gd, sim) -> void:
	var bad: Array = []
	for cid in gd.trees:
		for nid in gd.trees[cid]["nodes"]:
			var n: Dictionary = gd.trees[cid]["nodes"][nid]
			if n["kind"] in ["skill", "mastery"]:
				bad.append(nid)
			elif n["kind"] == "skill_up" and not (str(n["name"]).ends_with(" Aprimorada") and int(n["cost"]) == Balance.SKILL_LEARN_COST and str(nid).contains("_s_")):
				bad.append(nid)
			elif n["kind"] == "skill_quick" and not (str(n["name"]).ends_with(" Ágil") and int(n["cost"]) == Balance.SKILL_QUICK_COST and str(nid).contains("_m_")):
				bad.append(nid)
	check(bad.is_empty(), "teia comum: só nós Aprimorada/Ágil para as skills (sem skill/maestria; %s)" % [bad.slice(0, 4)])
	var cls: ClassDef = gd.classes["paladin"]
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Afiado", "city_aldara", Vector3(-33, 0, 33), 20)
	e.brain = null
	var sid: String = "pal_holy_strike"
	var s: SkillDef = gd.skills[sid]
	var up := "paladin_s_" + sid
	var quick := "paladin_m_" + sid
	e.mastery[sid] = 0
	check(sim.resolve_skill(e, s) == s, "sem nó comprado a skill resolvida é a própria (sem cópia)")
	e.mastery_points = 0
	check(sim.tree_block_reason(e, up).begins_with("precisa de um nó vizinho") or sim.tree_block_reason(e, up).begins_with("pontos"), "Aprimorada segue as regras da teia (vizinho/pontos)")
	var later := ""
	for k in cls.skill_ids:
		if not gd.skills[k].ascension and gd.skills[k].unlock_level > e.level:
			later = k
			break
	if later != "":
		var t0 := e.tree.duplicate()
		e.tree[str(gd.trees["paladin"]["nodes"]["paladin_s_" + later]["links"][0])] = true
		e.mastery_points = 5
		check(sim.tree_block_reason(e, "paladin_s_" + later) != "", "Aprimorada de skill acima do nível é recusada")
		e.tree = t0
	e.tree[up] = true
	var r1: SkillDef = sim.resolve_skill(e, s)
	check(r1 != s and is_equal_approx(r1.power, s.power * (1.0 + Balance.SKILL_UP_POWER)) and is_equal_approx(r1.cooldown, s.cooldown) and is_equal_approx(s.power, gd.skills[sid].power),
		"%s: +%d%% de poder, recarga igual, original intacta" % [up, roundi(Balance.SKILL_UP_POWER * 100)])
	e.mastery_points = 3
	check(sim.tree_allocate(e, quick) and e.mastery_points == 3 - Balance.SKILL_QUICK_COST and sim.tree_block_reason(e, quick) == "já comprado", "%s: compra uma vez, 1 ponto" % quick)
	var r2: SkillDef = sim.resolve_skill(e, s)
	check(is_equal_approx(r2.cooldown, s.cooldown * (1.0 - Balance.SKILL_QUICK_PCT)) and is_equal_approx(r2.mp_cost, s.mp_cost * (1.0 - Balance.SKILL_QUICK_PCT)), "Ágil: -%d%% de recarga e MP" % roundi(Balance.SKILL_QUICK_PCT * 100))
	# no lançamento: MP cobrado e recarga posta com o desconto
	var m: Dictionary = sim.maps["city_aldara"]
	e.ensure_slots()
	e.skills[0] = s
	e.mp = e.stats.max_mp
	e.cooldowns.clear()
	var mp0: float = e.mp
	var want_mp: float = e.stats.mp_cost_of(s.mp_cost_at(0) * (1.0 - Balance.SKILL_QUICK_PCT))
	var want_cd: float = s.cooldown_at(0) * (1.0 - Balance.SKILL_QUICK_PCT) * e.stats.skill_cooldown_mult(sid)
	check(sim.try_cast(e, 0, e.position + Vector3(0, 0, 2), m), "skill com Ágil sai")
	check(absf((mp0 - e.mp) - want_mp) < 0.01 and absf(float(e.cooldowns.get(sid, 0.0)) - want_cd) < 0.01,
		"Ágil no try_cast: MP %.2f (quer %.2f), recarga %.2f (quer %.2f)" % [mp0 - e.mp, want_mp, float(e.cooldowns.get(sid, 0.0)), want_cd])
	sim._end_skill(e)
	sim.despawn(e)

## Rank 1-5 da skill no Mestre de Skills (2026-11-18): ouro + materiais da faixa da skill, nível por rank, perto de um NPC
## com papel de Mestre (Balance.SKILL_TRAINER_ROLES); escreve e.mastery (os efeitos da maestria de sempre).
func _check_skill_ranks(gd, sim) -> void:
	# custos: todo material existe e o ouro cresce com rank e faixa
	var missing: Array = []
	for row in Balance.SKILL_RANK_MATS:
		for iid in row:
			if not gd.items.has(iid):
				missing.append(iid)
	check(Balance.SKILL_RANK_MATS.size() == Balance.COMMON_TIER_LEVELS.size() and missing.is_empty(), "materiais de rank: um par por faixa, todos itens do jogo (%s)" % [missing])
	var cls: ClassDef = gd.classes["paladin"]
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Aluno", "city_aldara", Vector3(-35, 0, 35), 1)
	e.brain = null
	var sid := "pal_holy_strike"
	var s: SkillDef = gd.skills[sid]
	e.mastery[sid] = 0
	var c1 := ProgressionSystem.rank_cost(e, sid)
	check(int(c1["rank"]) == 1 and int(c1["gold"]) == Balance.SKILL_RANK_GOLD_BASE and int(c1["items"].get(Balance.SKILL_RANK_MATS[0][0], 0)) == 1 and int(c1["level"]) == s.unlock_level,
		"rank 1 de skill do nível 1: %d de ouro e 1 %s (%s)" % [Balance.SKILL_RANK_GOLD_BASE, Balance.SKILL_RANK_MATS[0][0], c1])
	var c4 := ProgressionSystem.rank_cost(e, sid, 4)
	check(c4["items"].has(Balance.SKILL_RANK_MATS[0][1]) and int(c4["gold"]) > int(c1["gold"]) and int(c4["level"]) == s.unlock_level + 3 * Balance.SKILL_RANK_LEVEL_STEP, "rank 4: material raro, mais ouro, nível maior (%s)" % [c4])
	check(sim.skill_rank_cost(e, sid) == c1, "Sim.skill_rank_cost repassa")
	var hi := ""
	for k in cls.skill_ids:
		if not gd.skills[k].ascension and gd.skills[k].unlock_level >= Balance.COMMON_TIER_LEVELS[3]:
			hi = k
			break
	if hi != "":
		var ch := ProgressionSystem.rank_cost(e, hi, 1)
		check(ch["items"].has(Balance.SKILL_RANK_MATS[ProgressionSystem.skill_tier(gd.skills[hi])][0]) and int(ch["gold"]) > int(c1["gold"]), "skill de faixa alta pede o material da faixa dela (%s %s)" % [hi, ch])
	# erros: ouro, material, Mestre, nível, máximo, ascensão
	e.gold = 0
	check(ProgressionSystem.rank_error(sim, e, sid, true).begins_with("Ouro"), "sem ouro não sobe")
	e.gold = 10000
	check(ProgressionSystem.rank_error(sim, e, sid, true).begins_with("Faltam"), "sem material não sobe")
	for row in Balance.SKILL_RANK_MATS:
		for iid in row:
			e.add_item(iid, 30)
	check(ProgressionSystem.rank_error(sim, e, sid).contains("Mestre de Skills") and not sim.skill_rank_up(e, sid), "longe do Mestre de Skills não sobe")
	var mdef: MapDef = sim.maps["city_aldara"]["def"]
	var trainer := {"id": "test_trainer", "role": Balance.SKILL_TRAINER_ROLES[0], "name": "Mestre (teste)", "pos": e.position + Vector3(1, 0, 0)}
	mdef.npcs.append(trainer)
	var g0: int = e.gold
	var ore0 := int(e.inventory.get(Balance.SKILL_RANK_MATS[0][0], 0))
	var p0 := s.power_at(e.mastery_of(sid))
	check(sim.skill_rank_error(e, sid) == "" and sim.skill_rank_up(e, sid) and e.mastery_of(sid) == 1, "perto do Mestre: rank 1")
	check(e.gold == g0 - int(c1["gold"]) and int(e.inventory.get(Balance.SKILL_RANK_MATS[0][0], 0)) == ore0 - 1, "rank cobra o ouro e o material")
	check(s.power_at(e.mastery_of(sid)) > p0, "rank sobe o poder da skill (maestria de sempre)")
	check(ProgressionSystem.rank_error(sim, e, sid).begins_with("Rank 2 pede nível"), "rank 2 pede nível %d" % ProgressionSystem.rank_level(s, 2))
	e.level = Balance.MAX_LEVEL
	var n := 0
	while sim.skill_rank_up(e, sid) and n < 10:
		n += 1
	check(e.mastery_of(sid) == Balance.MASTERY_MAX and n == Balance.MASTERY_MAX - 1, "sobe até o rank %d" % Balance.MASTERY_MAX)
	mdef.npcs.erase(trainer)
	var asc := ""
	for k in cls.skill_ids:
		if gd.skills[k].ascension:
			asc = k
			break
	if asc != "":
		e.learned[asc] = true
		check(ProgressionSystem.rank_error(sim, e, asc, true).contains("ascensão"), "skill de ascensão não sobe no Mestre")
		e.learned.erase(asc)
	check(not ProgressionSystem.rank_up(sim, e, "ber_cleave", true), "skill de outra classe não sobe")
	# rank de graça do bot: nível/6, sem passar do nível de cada rank
	e.level = 30
	check(ProgressionSystem.bot_rank(e, s) == mini(Balance.MASTERY_MAX, 30 / Balance.BOT_SKILL_RANK_PER_LEVELS), "bot do 30: rank %d na skill do nível 1" % ProgressionSystem.bot_rank(e, s))
	var late: SkillDef = null
	for k in cls.skill_ids:
		if not gd.skills[k].ascension and gd.skills[k].unlock_level >= 24:
			late = gd.skills[k]
			break
	if late:
		var br := ProgressionSystem.bot_rank(e, late)
		check(br >= 1 and ProgressionSystem.rank_level(late, br) <= 30 and (br == Balance.MASTERY_MAX or ProgressionSystem.rank_level(late, br + 1) > 30), "bot do 30: %s (nível %d) no rank que o nível libera (%d)" % [late.id, late.unlock_level, br])
	sim.despawn(e)

## Save 6 -> 7: skills pelo nível, nó de maestria sai da teia (o rank fica, os pontos voltam), nó da skill vira Aprimorada.
func _check_save_skill_ranks(gd, sim, save) -> void:
	var cls: ClassDef = gd.classes["paladin"]
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Velho", "city_aldara", Vector3(-37, 0, 37), 20)
	e.brain = null
	SaveSystem.apply_to(e, {"level": 20, "class": "paladin", "save_version": 6, "mastery_points": 5,
		"tree": ["paladin_start", "paladin_s_pal_holy_strike", "paladin_m_pal_holy_strike"], "learned": ["pal_holy_strike", "pal_blessed_armor"],
		"mastery": {"pal_holy_strike": 3}, "loadout": ["pal_holy_strike", "pal_blessed_armor", "", "", "", ""]})
	check(not e.tree.has("paladin_m_pal_holy_strike") and e.tree.has("paladin_s_pal_holy_strike") and e.tree.has("paladin_start"), "save 6: nó de maestria sai, o da skill fica (vira Aprimorada), teia não reseta")
	check(e.mastery_of("pal_holy_strike") == 3 and e.mastery_points == 5 + 3, "save 6: rank 3 fica e os 3 pontos voltam (%d pontos)" % e.mastery_points)
	check(ProgressionSystem.level_skill_ids(cls, 20).all(func(sid): return e.knows(sid)), "save 6: skills do nível 20 aprendidas")
	check(e.skills[0] != null and e.skills[0].id == "pal_holy_strike", "save 6: barra mantida")
	# gravar e ler de novo (espaço de teste): versão 7, sem nó de maestria, nada muda
	var keep: int = save.slot
	save.slot = TEST_SLOT
	save.save_player(e)
	var d: Dictionary = save.load_data(TEST_SLOT)
	check(int(d.get("save_version", 0)) == 7 and not (d.get("tree", []) as Array).has("paladin_m_pal_holy_strike"), "save gravado na versão 7")
	var e2: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Velho2", "city_aldara", Vector3(-38, 0, 37), 20)
	e2.brain = null
	SaveSystem.apply_to(e2, d)
	check(e2.mastery_points == 8 and e2.mastery_of("pal_holy_strike") == 3 and e2.tree.size() == e.tree.size(), "save 7 relido: pontos, rank e teia iguais")
	save.delete_slot(TEST_SLOT)
	save.slot = keep
	sim.despawn(e)
	sim.despawn(e2)


## Mestres de Skills (plano tidy-painting-biscuit 2026-11-18): um por hub, papel em Balance.SKILL_TRAINER_ROLES, em chão livre
## (fora de colisor, com folga), alcançável a pé desde a chegada do mapa, e um jogador ao lado dele sobe o rank com ouro + materiais
## (e sem o Mestre por perto, não sobe).
const TRAINER_HUBS := ["city_aldara", "field_forest", "elf_city", "field_ruins", "city_port", "field_kharzun"]
func _check_trainers(gd) -> void:
	check(MapsCatalog.TRAINERS.size() == TRAINER_HUBS.size(), "Mestres de Skills: um por hub (%d)" % MapsCatalog.TRAINERS.size())
	for mid in TRAINER_HUBS:
		var def: MapDef = gd.maps[mid]
		var tr: Array = def.npcs.filter(func(n): return str(n.get("role", "")) in Balance.SKILL_TRAINER_ROLES)
		check(tr.size() == 1, "%s: um Mestre de Skills (%d)" % [mid, tr.size()])
		if tr.size() != 1:
			continue
		var n: Dictionary = tr[0]
		var p: Vector3 = n["pos"]
		check(str(n["name"]).contains("Mestr") and (n["dialog"] as Array).any(func(l): return str(l).contains("rank")), "%s: Mestre de Skills com nome e fala sobre rank" % mid)
		check(not n.has("if") and not n.has("unless"), "%s: o Mestre de Skills está sempre lá" % mid)
		var ws := WorldSim.new()
		ws.load_map(def)
		check(ws.is_walkable(p, def, 0.9), "%s: Mestre de Skills fora de colisor, com folga (%.1f, %.1f)" % [mid, p.x, p.z])
		var crowd: Array = def.npcs.filter(func(o): return o != n and (o["pos"] as Vector3).distance_to(p) < 2.0)
		check(crowd.is_empty(), "%s: ninguém em cima do Mestre de Skills (%s)" % [mid, crowd.map(func(o): return o["id"])])
		var from: Vector3 = def.town_center if def.town_radius > 0.0 and mid != "elf_city" and ws.is_walkable(def.town_center, def, 0.45) else def.spawn_point
		check(_reached(_reach(ws, def, from), p), "%s: Mestre de Skills alcançável a pé" % mid)
		if def.town_radius > 0.0 and mid != "elf_city":      # Cidade Élfica: o "hub" humano é o acampamento do cerco, fora do anel élfico
			check(def.in_hub(p), "%s: Mestre de Skills dentro do povoado" % mid)
	# rank no Mestre: Aldara, paladino nível 10 com a 1ª skill de nível 1
	var ws2 := WorldSim.new()
	var adef: MapDef = gd.maps["city_aldara"]
	ws2.load_map(adef)
	var pl: SimEntity = ws2.spawn_player(gd.classes["paladin"], "Teste", adef.id)
	pl.brain = null
	pl.level = 10
	var sid := ""
	for s in pl.class_def.skill_ids:
		var sd: SkillDef = gd.skills[s]
		if not sd.ascension and sd.unlock_level == 1 and pl.knows(s):
			sid = s
			break
	check(sid != "", "Mestre: o paladino nível 10 já sabe uma skill de nível 1")
	if sid == "":
		return
	var trainer: Dictionary = adef.npcs.filter(func(n): return str(n.get("role", "")) in Balance.SKILL_TRAINER_ROLES)[0]
	var c := ProgressionSystem.rank_cost(pl, sid)
	pl.gold = int(c["gold"]) + 5
	for iid in c["items"]:
		pl.add_item(iid, int(c["items"][iid]))
	pl.position = Vector3(0, 0, 10.0)
	check(not ProgressionSystem.rank_up(ws2, pl, sid) and pl.mastery_of(sid) == 0, "Mestre: longe dele o rank não sobe")
	pl.position = (trainer["pos"] as Vector3) + Vector3(1.2, 0, 0)
	var r0 := pl.mastery_of(sid)
	check(ProgressionSystem.rank_up(ws2, pl, sid) and pl.mastery_of(sid) == r0 + 1 and pl.gold == 5, "Mestre: ao lado dele o rank sobe e cobra o ouro (%s rank %d)" % [sid, pl.mastery_of(sid)])
	check((c["items"] as Dictionary).keys().all(func(iid): return not pl.has_item(iid, 1)), "Mestre: os materiais do rank saem da bolsa")
	# materiais de rank: tier 0-2 e 4-5 caem de monstro em algum mapa; o tier 3 (Ruínas) vem da colheita
	for t in Balance.SKILL_RANK_MATS.size():
		for iid in Balance.SKILL_RANK_MATS[t]:
			var drops: bool = gd.loot_tables.values().any(func(lt): return lt.entries.any(func(e): return str(e["item"]) == str(iid)))
			var gathered: bool = MapsCatalog.GATHER.values().any(func(rows): return (rows as Array).any(func(r): return str(r[0]) == str(iid)))
			check(drops or gathered, "material de rank %s (tier %d) cai de monstro ou se colhe" % [iid, t])

## Painel do Mestre de Skills (npc_ui): lista as skills aprendidas fora da ascensão (barra primeiro) e o botão
## "Aprimorar" segue skill_rank_error (longe do Mestre = desligado com o motivo; perto/dev com ouro e material = ligado).
func _check_trainer_panel(gd, sim) -> void:
	var ui = load("res://game/ui/npc_ui.gd").new()
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Treino", "city_aldara", Vector3(0, 0, 6), 20)
	e.brain = null
	var ids: Array = ui.trainer_skills(sim, e)
	var want := 0
	for sid in e.class_def.skill_ids:
		if e.knows(sid) and not gd.skills[sid].ascension:
			want += 1
			check(sid in ids, "mestre: skill aprendida %s está na lista" % sid)
	check(ids.size() == want and want > 0, "mestre: lista = skills aprendidas sem ascensão (%d/%d)" % [ids.size(), want])
	var bar_first := true
	var k := 0
	for sk in e.skills:
		if sk and not sk.ascension and e.knows(sk.id):
			bar_first = bar_first and ids[k] == sk.id
			k += 1
	check(bar_first, "mestre: as skills da barra vêm primeiro, na ordem das teclas")
	var sid0: String = ids[0]
	e.mastery[sid0] = 0
	e.gold = 0
	for free in [false, true]:
		ui.trainer_free = free
		var row: Control = ui._trainer_row(e, gd.skills[sid0], true)
		var b: Button = ui.trainer_rows[sid0]
		var err: String = ProgressionSystem.rank_error(sim, e, sid0, free)
		check(err != "" and b.disabled and b.tooltip_text == err, "mestre: sem ouro/longe o botão fica cinza com o motivo (free=%s, %s)" % [free, err])
		row.free()
	var c: Dictionary = sim.skill_rank_cost(e, sid0)
	e.gold = int(c["gold"])
	for iid in c["items"]:
		e.add_item(iid, int(c["items"][iid]))
	ui.trainer_free = true
	var row2: Control = ui._trainer_row(e, gd.skills[sid0], true)
	var b2: Button = ui.trainer_rows[sid0]
	check(not b2.disabled and ProgressionSystem.rank_error(sim, e, sid0, true) == "", "mestre: com ouro e material o botão liga (%s)" % b2.tooltip_text)
	row2.free()
	ui.trainer_free = false
	var row3: Control = ui._trainer_row(e, gd.skills[sid0], true)
	var err3: String = sim.skill_rank_error(e, sid0)
	check(ui.trainer_rows[sid0].disabled == (err3 != ""), "mestre: botão segue skill_rank_error no jogo (%s)" % err3)
	row3.free()
	e.mastery[sid0] = Balance.MASTERY_MAX
	var row4: Control = ui._trainer_row(e, gd.skills[sid0], true)
	check(ui.trainer_rows[sid0].disabled and ui.trainer_rows[sid0].text == "Máximo", "mestre: rank máximo = botão Máximo desligado")
	row4.free()
	check(not ui.rank_step_text(gd.skills[sid0], 1).is_empty() and ui.rank_step_text(gd.skills[sid0], 1).begins_with("Rank 2"), "mestre: texto do próximo rank (%s)" % ui.rank_step_text(gd.skills[sid0], 1))
	ui.free()
	sim.despawn(e)


# ---------------------------------------------------------------------------
# Preenchimento de skills (design/gdd/skills-fill-2026-11-19.md): 13 skills novas e as 4 mecânicas (zone, sunder, seed,
# sacrifice). `--only=skill_fill,zone_pulse,sunder,seed,sacrifice`
# ---------------------------------------------------------------------------
const FILL_SKILLS := {"pal_hallowed_ground": "templario", "pal_dawn_pillar": "templario", "ber_sunder": "executor", "ber_headsman_roar": "executor",
	"bis_faith_banner": "batalha", "bis_chain_of_faith": "batalha", "bis_guardian_light": "sacerdote", "dru_lacerate": "guardiao_verde",
	"ele_ember_seed": "fogo", "ele_bolt_step": "raio", "nec_dark_offering": "invocador", "nec_grave_grasp": "", "ran_field_dressing": ""}

## Bot de teste parado, nível 30, com a build e a arma lendária dela (e a secundária, se houver); sem talentos de classe.
func _fill_bot(gd, sim, cid: String, build: String, at: Vector3) -> SimEntity:
	var e: SimEntity = sim.spawn_bot(gd.classes[cid], "Fill", "city_aldara", at, 30)
	e.brain = null
	e.build_id = build
	e.ct = {}
	var w: ItemDef = gd.items.get("leg_%s_%s_30_weapon" % [cid, build])
	if w:
		e.equipment[ItemDef.Slot.WEAPON] = w
	var off: ItemDef = gd.items.get("leg_%s_%s_30_offhand" % [cid, build])
	if off:
		e.equipment[ItemDef.Slot.OFFHAND] = off
	e.recompute_stats()
	e.heal_full()
	return e

## Boneco de pancada: golem com vida enorme, parado.
func _fill_dummy(gd, sim, at: Vector3) -> SimEntity:
	var f: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at)
	f.brain = null
	f.stats.max_hp = 1.0e6
	f.hp = 1.0e6
	return f

func _fill_cast(sim, e: SimEntity, sid: String, aim: Vector3) -> void:
	var s: SkillDef = sim.resolve_skill(e, GameData.skills[sid])
	e.face_towards(aim)
	e.skill_aim = aim
	sim._apply_skill(e, s, sim.maps[e.map_id])

func _check_skill_fill(gd, sim) -> void:
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var general := 0
		var per_build := {}
		for sid in cls.skill_ids:
			var s: SkillDef = gd.skills[sid]
			if s.ascension or s.unlock_level >= Balance.ASC_LEVEL:
				continue
			if s.build == "":
				general += 1
			else:
				per_build[s.build] = int(per_build.get(s.build, 0)) + 1
		check(general >= 4, "%s: pelo menos 4 skills gerais sem ascensão (%d)" % [cid, general])
		for b in cls.builds:
			var n: int = int(per_build.get(b["id"], 0))
			check(n >= 8, "%s/%s: pelo menos 8 skills próprias sem ascensão (%d)" % [cid, b["id"], n])
	for sid in FILL_SKILLS:
		check(gd.skills.has(sid), "skill nova %s existe" % sid)
		if not gd.skills.has(sid):
			continue
		var s: SkillDef = gd.skills[sid]
		check(s.build == FILL_SKILLS[sid] and not s.ascension and s.unlock_level >= 2 and s.unlock_level <= 28, "%s: build %s, nível na escada (%d)" % [sid, FILL_SKILLS[sid], s.unlock_level])
		check(ResourceLoader.exists("res://assets/icons/skill_%s.png" % sid), "%s: tem ícone (make_icons)" % sid)
		check(s.description.length() > 20 and s.vfx != "", "%s: descrição e tema de efeito" % sid)
		check(s.startup <= 0.3 and s.cancel_after <= 0.2, "%s: sai rápido (startup %.2f, cancel %.2f)" % [sid, s.startup, s.cancel_after])
		var in_list := false
		for b in gd.classes[s.class_id].builds:
			if (s.build == "" or b["id"] == s.build) and (b["skills"] as Array).has(sid):
				in_list = true
		check(in_list, "%s: está na prioridade de alguma build (bot)" % sid)
	# níveis das skills antigas não mudaram (amostra das vizinhas)
	for pair in [["pal_brand", 7], ["ber_overhead", 4], ["ber_execute", 15], ["bis_mend", 17], ["dru_stampede", 18], ["ele_inferno", 22], ["nec_army", 27], ["ran_snipe", 8]]:
		check(gd.skills[pair[0]].unlock_level == pair[1], "%s continua no nível %d" % pair)
	for sid in ["ber_overhead", "ber_execute", "ber_decapitate"]:
		check(gd.skills[sid].effects.get("sunder_consume") is Dictionary, "%s gasta a rachadura (sunder_consume)" % sid)
	for k in ["zone", "sunder", "sunder_consume", "seed", "sacrifice"]:
		check(SkillDef.EFFECT_KEYS.has(k), "efeito %s é conhecido (SkillDef.EFFECT_KEYS)" % k)
	for mid in Balance.SACRIFICE_EXCLUDE:
		check(gd.monsters.has(mid), "SACRIFICE_EXCLUDE: %s é um monstro de verdade" % mid)
	# Urso: a magia-assinatura é do malho (Esmagar), não o Fogo Lunar do cajado do Xamã
	var ursa: Dictionary = gd.classes["druid"].build_by_id("guardiao_verde")
	var sig: SkillDef = gd.skills[str(ursa["signature"]["skill"])]
	check(sig.id == "dru_maul" and sig.build == "guardiao_verde" and sig.requires.has("mace2h"), "Urso: assinatura é Esmagar (skill do malho da própria build)")
	check(str(ursa["legend"]["skill"]) == "dru_oak_skin" and gd.skills["dru_oak_skin"].build == "guardiao_verde", "Urso: a arma lendária (Casca Viva) continua numa skill da build")
	check(BuffLooks.LOOKS.has("hallowed") and BuffLooks.LOOKS.has("headsman_roar") and BuffLooks.LOOKS.has("field_dressing"), "buffs novos têm visual (BuffLooks)")
	_check_fill_misc(gd, sim)

## As skills novas sem mecânica nova: cada uma faz o que diz.
func _check_fill_misc(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-44, 0, 52)
	var temps: Array = []
	# Luz Protetora: cura e escudo vão para o aliado sob o cursor, não para quem lança
	var pri: SimEntity = _fill_bot(gd, sim, "bishop", "sacerdote", at)
	var ally: SimEntity = _fill_bot(gd, sim, "paladin", "guardiao", at + Vector3(4, 0, 0))
	temps.append_array([pri, ally])
	pri.party_id = 9191
	ally.party_id = 9191
	ally.hp = ally.stats.max_hp * 0.5
	pri.shield_hp = 0.0
	_fill_cast(sim, pri, "bis_guardian_light", ally.position)
	check(ally.hp > ally.stats.max_hp * 0.5 and ally.shield_hp >= ally.stats.max_hp * 0.099 and pri.shield_hp == 0.0,
		"Luz Protetora: cura o aliado e o escudo (10%% da vida) fica nele, não no Sacerdote (%.0f / %.0f)" % [ally.shield_hp, pri.shield_hp])
	# Brado do Carrasco: buff e escudo em você e nos aliados a 8 m
	var exe: SimEntity = _fill_bot(gd, sim, "berserker", "executor", at + Vector3(0, 0, 3))
	temps.append(exe)
	exe.party_id = 9191
	ally.shield_hp = 0.0
	ally.buffs.clear()
	_fill_cast(sim, exe, "ber_headsman_roar", exe.position)
	check(exe.buffs.any(func(b): return b.get("id") == "headsman_roar") and ally.buffs.any(func(b): return b.get("id") == "headsman_roar") and ally.shield_hp > 0.0 and exe.shield_hp > 0.0,
		"Brado do Carrasco: +DEF/+ATK e escudo em você e no aliado a 8 m")
	# Curativo de Campo: cura 20% uma vez só (não 40%) e funciona sem companheiro
	var ran: SimEntity = _fill_bot(gd, sim, "ranger", "lanceiro", at + Vector3(-4, 0, 0))
	temps.append(ran)
	ran.learned["ran_field_dressing"] = true
	ran.skills[0] = gd.skills["ran_field_dressing"]
	ran.mp = ran.stats.max_mp
	ran.hp = ran.stats.max_hp * 0.3
	var cast_ok: bool = sim.try_cast(ran, 0, ran.position, m)
	check(cast_ok, "Curativo de Campo: lança sem companheiro (pet_buff opcional)")
	ran.cooldowns.erase("ran_field_dressing")
	var h0 := ran.hp
	_fill_cast(sim, ran, "ran_field_dressing", ran.position)
	var healed := (ran.hp - h0) / ran.stats.max_hp
	check(absf(healed - 0.2) < 0.02 and ran.buffs.any(func(b): return b.get("id") == "field_dressing"), "Curativo de Campo: cura 20%% da vida uma vez (%.0f%%) e dá velocidade" % (healed * 100.0))
	var bb := BotBrain.new()
	check(not bb._fill_ok(ran, sim, gd.skills["ran_field_dressing"], ran), "bot: Curativo não sai com a vida em %.0f%%" % (100.0 * ran.hp / ran.stats.max_hp))
	ran.hp = ran.stats.max_hp * 0.3
	check(bb._fill_ok(ran, sim, gd.skills["ran_field_dressing"], ran), "bot: Curativo sai com a vida abaixo de 45%")
	# Passo Relampejante: reaparece no cursor e o pouso fere em volta
	var ele: SimEntity = _fill_bot(gd, sim, "elementalist", "raio", Vector3(-26, 0, 58))     # chão aberto (o pouso não cai em parede)
	temps.append(ele)
	var foe: SimEntity = _fill_dummy(gd, sim, ele.position + Vector3(0, 0, 6))
	temps.append(foe)
	var land := ele.position + Vector3(0, 0, 5)
	_fill_cast(sim, ele, "ele_bolt_step", land)
	check(ele.position.distance_to(land) < 1.0 and foe.hp < 1.0e6, "Passo Relampejante: pousa no cursor (%.1f m) e fere quem está perto" % ele.position.distance_to(land))
	# Lacerar: sangra e provoca o monstro; na forma de urso pega até 3
	var bear: SimEntity = _fill_bot(gd, sim, "druid", "guardiao_verde", foe.position + Vector3(0, 0, -2))
	temps.append(bear)
	foe.aggro_target = -1
	_fill_cast(sim, bear, "dru_lacerate", foe.position)
	check(foe.aggro_target == bear.id and foe.debuffs.any(func(d): return d.get("kind") == "dot"), "Lacerar: sangra e provoca (o alvo vira para o urso)")
	bear.form = "bear"
	var lac: SkillDef = sim.resolve_skill(bear, gd.skills["dru_lacerate"])
	check(lac.max_targets == 3 and lac.radius >= 2.0 and lac.power > gd.skills["dru_lacerate"].power, "Lacerar na forma de urso: Garra Laceradora pega até 3, mais forte")
	bear.form = ""
	# Garra da Cova: puxa o comum e prende; chefe não vem; o bot não usa em chefe
	var nec: SimEntity = _fill_bot(gd, sim, "necromancer", "pestilento", at + Vector3(10, 0, 0))
	temps.append(nec)
	var far: SimEntity = _fill_dummy(gd, sim, nec.position + Vector3(0, 0, 7))
	temps.append(far)
	_fill_cast(sim, nec, "nec_grave_grasp", far.position)
	check(far.position.distance_to(nec.position) < 4.0 and far.debuffs.any(func(d): return d.get("kind") == "root"), "Garra da Cova: puxa o alvo até perto e prende")
	var boss_def: MonsterDef = null
	for mid in gd.monsters:
		if gd.monsters[mid].is_boss:
			boss_def = gd.monsters[mid]
			break
	if boss_def:
		var boss: SimEntity = sim.spawn_monster(boss_def, "city_aldara", nec.position + Vector3(0, 0, 7))
		boss.brain = null
		temps.append(boss)
		var b0 := boss.position
		_fill_cast(sim, nec, "nec_grave_grasp", boss.position)
		check(boss.position.distance_to(b0) < 0.1, "Garra da Cova: chefe não é puxado")
		check(not bb._fill_ok(nec, sim, gd.skills["nec_grave_grasp"], boss) and bb._fill_ok(nec, sim, gd.skills["nec_grave_grasp"], far), "bot: Garra da Cova nunca em chefe")
	# Corrente da Fé: cura o aliado mais ferido e salta para outro inimigo
	var cle: SimEntity = _fill_bot(gd, sim, "bishop", "batalha", at + Vector3(-10, 0, 0))
	temps.append(cle)
	var hurt: SimEntity = _fill_bot(gd, sim, "paladin", "guardiao", cle.position + Vector3(2, 0, 0))
	temps.append(hurt)
	cle.party_id = 9292
	hurt.party_id = 9292
	hurt.hp = hurt.stats.max_hp * 0.4
	var f1: SimEntity = _fill_dummy(gd, sim, cle.position + Vector3(0, 0, 1.8))
	var f2: SimEntity = _fill_dummy(gd, sim, cle.position + Vector3(0, 0, 5.5))
	temps.append_array([f1, f2])
	var hh := hurt.hp
	_fill_cast(sim, cle, "bis_chain_of_faith", f1.position)
	check(f1.hp < 1.0e6 and f2.hp < 1.0e6 and hurt.hp > hh, "Corrente da Fé: fere, salta para o vizinho e cura o aliado ferido")
	# Coluna da Alvorada: atordoa no cursor e salta
	var tem: SimEntity = _fill_bot(gd, sim, "paladin", "templario", at + Vector3(0, 0, 12))
	temps.append(tem)
	var p1: SimEntity = _fill_dummy(gd, sim, tem.position + Vector3(0, 0, 6))
	var p2: SimEntity = _fill_dummy(gd, sim, tem.position + Vector3(4, 0, 6))
	temps.append_array([p1, p2])
	_fill_cast(sim, tem, "pal_dawn_pillar", p1.position)
	check(p1.state == SimEntity.State.STUNNED and p2.hp < 1.0e6 and p1.debuffs.any(func(d): return d.get("fire", false)), "Coluna da Alvorada: atordoa, queima e salta para o vizinho")
	for t in temps:
		t.party_id = -1
		sim.despawn(t)

func _check_zone_pulse(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-30, 0, 60)
	var tem: SimEntity = _fill_bot(gd, sim, "paladin", "templario", at)
	var ally: SimEntity = _fill_bot(gd, sim, "paladin", "guardiao", at + Vector3(0, 0, 4))
	var out_ally: SimEntity = _fill_bot(gd, sim, "paladin", "guardiao", at + Vector3(0, 0, -8))
	tem.party_id = 9393
	ally.party_id = 9393
	out_ally.party_id = 9393
	var foe: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, 5))
	var aim := at + Vector3(0, 0, 4.5)
	_fill_cast(sim, tem, "pal_hallowed_ground", aim)
	var zones: Array = (m["traps"] as Array).filter(func(t): return t["kind"] == TrapSystem.ZONE and t["owner"] == tem.id)
	check(zones.size() == 1 and foe.hp < 1.0e6, "Chão Sagrado: o golpe bate e o chão fica (1 zona)")
	check(foe.debuffs.any(func(d): return d.get("kind") == "dot" and d.get("fire", false)), "Chão Sagrado: queima o atingido")
	var z: Dictionary = zones[0] if not zones.is_empty() else {}
	var pulses := 0
	var hp_steps := 0
	var t0: float = sim.time
	var dur := float(Balance.HALLOWED_ZONE["duration"])
	var step := 0.25
	var k := 0
	while sim.time < t0 + dur + 1.0 and k < 100:
		k += 1
		sim.time += step
		var h0 := foe.hp
		TrapSystem.update_traps(sim, m)
		if foe.hp < h0:
			hp_steps += 1
		if k == 5:      # 1,25 s: o 1º pulso já saiu
			check(ally.buffs.any(func(b): return b.get("id") == "hallowed") and not out_ally.buffs.any(func(b): return b.get("id") == "hallowed"),
				"Chão Sagrado: aliado dentro ganha +DEF, aliado fora não")
	if not z.is_empty():
		pulses = int(z["pulses"])
	var want := int(dur / float(Balance.HALLOWED_ZONE["pulse"]))
	check(pulses == want and hp_steps == want, "Chão Sagrado: %d pulsos em %.0f s (%d, %d com dano)" % [want, dur, pulses, hp_steps])
	check(not (m["traps"] as Array).has(z), "Chão Sagrado: some no fim do tempo")
	# relançar apaga a antiga; dono morto: some
	_fill_cast(sim, tem, "pal_hallowed_ground", aim)
	_fill_cast(sim, tem, "pal_hallowed_ground", aim)
	zones = (m["traps"] as Array).filter(func(t): return t["kind"] == TrapSystem.ZONE and t["owner"] == tem.id)
	check(zones.size() == 1, "zona: relançar apaga a antiga (uma por lançador e skill)")
	tem.set_state(SimEntity.State.DEAD)
	TrapSystem.update_traps(sim, m)
	zones = (m["traps"] as Array).filter(func(t): return t["kind"] == TrapSystem.ZONE and t["owner"] == tem.id)
	check(zones.is_empty(), "zona: some com o dono morto")
	tem.set_state(SimEntity.State.IDLE)
	tem.hp = tem.stats.max_hp
	# Estandarte da Fé: cura aliado dentro, não fora, e retarda o inimigo
	var cle: SimEntity = _fill_bot(gd, sim, "bishop", "batalha", at + Vector3(1, 0, 0))
	cle.party_id = 9393
	ally.hp = ally.stats.max_hp * 0.4
	out_ally.hp = out_ally.stats.max_hp * 0.4
	_fill_cast(sim, cle, "bis_faith_banner", aim)
	var a0 := ally.hp
	sim.time += 1.05
	TrapSystem.update_traps(sim, m)
	check(ally.hp > a0 and is_equal_approx(out_ally.hp, out_ally.stats.max_hp * 0.4), "Estandarte da Fé: cura o aliado dentro, não o de fora")
	check(foe.debuffs.any(func(d): return d.get("kind") == "slow"), "Estandarte da Fé: retarda o inimigo dentro")
	check((m["traps"] as Array).any(func(t): return t["kind"] == TrapSystem.ZONE and t["owner"] == cle.id and t["zone"] == "faith_banner"), "Estandarte da Fé: zona com o id do estandarte (desenho do mastro)")
	for e in [tem, ally, out_ally, cle, foe]:
		e.party_id = -1
		sim.despawn(e)
	m["traps"] = (m["traps"] as Array).filter(func(t): return t["kind"] != TrapSystem.ZONE)

func _check_sunder(gd, sim) -> void:
	var at := Vector3(-30, 0, 70)
	var exe: SimEntity = _fill_bot(gd, sim, "berserker", "executor", at)
	var foe: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, 1.8))
	var max_n := int(Balance.SUNDER["max"])
	for i in range(max_n):
		_fill_cast(sim, exe, "ber_sunder", foe.position)
	check(SunderSystem.stacks(foe) == max_n, "Fender: %d acertos = %d cargas (%d)" % [max_n, max_n, SunderSystem.stacks(foe)])
	check(is_equal_approx(Combat.taken_pct(foe), float(Balance.SUNDER["taken_per"]) * max_n), "Fender: +%.0f%% de dano recebido com %d cargas (%.0f)" % [float(Balance.SUNDER["taken_per"]) * max_n, max_n, Combat.taken_pct(foe)])
	_fill_cast(sim, exe, "ber_sunder", foe.position)
	check(SunderSystem.stacks(foe) == max_n, "Fender: o %dº acerto não passa de %d cargas" % [max_n + 1, max_n])
	foe.debuffs.append({"kind": "curse", "id": "curse_predator_1", "remaining": 6.0, "taken_pct": 15.0, "mark": true})
	check(is_equal_approx(Combat.taken_pct(foe), Balance.MARK_TAKEN_CAP), "rachadura é marca: com a Marca do Predador para no teto %.0f%% (%.0f)" % [Balance.MARK_TAKEN_CAP, Combat.taken_pct(foe)])
	foe.debuffs = foe.debuffs.filter(func(d): return d.get("id") != "curse_predator_1")
	var mult := SunderSystem.consume(foe, Balance.SUNDER_CONSUME)
	check(is_equal_approx(mult, 1.0 + float(Balance.SUNDER_CONSUME["per"]) * max_n) and SunderSystem.stacks(foe) == 0, "gastar: power x %.2f e zera as cargas" % mult)
	# finalizador de verdade gasta e bate mais (média de 12 golpes com e sem cargas)
	var dmg := [0.0, 0.0]
	for with_n in [0, 1]:
		for i in range(30):
			foe.hp = 1.0e6
			foe.debuffs.clear()
			if with_n == 1:
				for j in range(max_n):
					SunderSystem.apply(exe, foe, Balance.SUNDER)
			exe.cooldowns.clear()
			_fill_cast(sim, exe, "ber_execute", foe.position)
			dmg[with_n] += 1.0e6 - foe.hp
	check(SunderSystem.stacks(foe) == 0 and dmg[1] > dmg[0] * 1.25, "Executar gasta a rachadura e bate mais (%.0f x %.0f)" % [dmg[1], dmg[0]])
	# chefe acumula normal
	for mid in gd.monsters:
		if gd.monsters[mid].is_boss:
			var boss: SimEntity = sim.spawn_monster(gd.monsters[mid], "city_aldara", at + Vector3(6, 0, 0))
			boss.brain = null
			SunderSystem.apply(exe, boss, Balance.SUNDER)
			SunderSystem.apply(exe, boss, Balance.SUNDER)
			check(SunderSystem.stacks(boss) == 2, "chefe acumula rachadura normal (não é controle)")
			sim.despawn(boss)
			break
	# bot: com o Fender pronto, o finalizador espera as cargas (ou o alvo ferido)
	var bb := BotBrain.new()
	exe.learned["ber_sunder"] = true
	exe.skills[0] = gd.skills["ber_sunder"]
	exe.cooldowns.clear()
	exe.mp = exe.stats.max_mp
	foe.debuffs.clear()
	foe.hp = 1.0e6
	check(not bb._fill_ok(exe, sim, gd.skills["ber_execute"], foe), "bot: Executar espera a rachadura com o Fender pronto")
	for j in range(Balance.BOT_SUNDER_MIN):
		SunderSystem.apply(exe, foe, Balance.SUNDER)
	check(bb._fill_ok(exe, sim, gd.skills["ber_execute"], foe), "bot: com %d cargas, executa" % Balance.BOT_SUNDER_MIN)
	foe.debuffs.clear()
	exe.cooldowns["ber_sunder"] = 3.0
	check(bb._fill_ok(exe, sim, gd.skills["ber_execute"], foe), "bot: Fender em recarga, o finalizador não fica esperando")
	sim.despawn(exe)
	sim.despawn(foe)

## Onda 2 (GDD skills-fill §8.1): Eviscerar consome os venenos SEUS no alvo (não queimadura, não sangramento do Lanceiro,
## não veneno de outro), explode o que faltava e ganha poder por veneno.
func _check_eviscerate_poison(gd, sim) -> void:
	var at := Vector3(-30, 0, 80)
	var lam: SimEntity = _fill_bot(gd, sim, "assassin", "laminas", at)
	var other: SimEntity = _fill_bot(gd, sim, "assassin", "laminas", at + Vector3(4, 0, 0))
	var foe: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, 1.8))
	var s: SkillDef = gd.skills["ass_eviscerate"]
	check(s.effects.get("combust") is Dictionary and str(s.effects["combust"].get("kind", "")) == "poison", "Eviscerar: consome venenos (combust kind poison)")
	var mine := func(n: int) -> void:
		for i in range(n):
			foe.debuffs.append({"kind": "dot", "id": "dot_%d_t%d" % [lam.id, i], "remaining": 4.0, "dps": 10.0, "src": lam.id, "tag": true})
	mine.call(3)
	foe.debuffs.append({"kind": "dot", "id": "burn_t", "remaining": 4.0, "dps": 10.0, "src": lam.id, "fire": true})
	foe.debuffs.append({"kind": "dot", "id": "bleed_t", "remaining": 4.0, "dps": 10.0, "src": lam.id, "bleed": true})
	foe.debuffs.append({"kind": "dot", "id": "dot_other", "remaining": 4.0, "dps": 10.0, "src": other.id})
	check(WoundSystem.count(lam, foe) == 3, "veneno = dano no tempo seu sem fogo e sem sangramento do Lanceiro (%d)" % WoundSystem.count(lam, foe))
	var res: Array = WoundSystem.consume(lam, foe)
	check(int(res[1]) == 3 and is_equal_approx(float(res[0]), 120.0), "consumir: 3 venenos, 120 de dano que faltava (%s)" % str(res))
	check(foe.debuffs.size() == 3 and WoundSystem.count(lam, foe) == 0, "consumir: queimadura, sangramento e veneno de outro ficam")
	# no golpe de verdade: venenos saem e o dano sobe (média de 30 golpes com 3 venenos x sem)
	var dmg := [0.0, 0.0]
	for with_n in [0, 1]:
		for i in range(30):
			foe.hp = 1.0e6
			foe.debuffs.clear()
			if with_n == 1:
				mine.call(3)
			_fill_cast(sim, lam, "ass_eviscerate", foe.position)
			dmg[with_n] += 1.0e6 - foe.hp
	check(not foe.debuffs.any(func(d): return d.get("tag", false)), "Eviscerar: os venenos do alvo saem no golpe")
	var want := 1.0 + float(Balance.EVISCERATE_POISON["per"]) * 3.0
	check(dmg[1] > dmg[0] * (want - 0.1), "Eviscerar com 3 venenos bate x%.2f+ (%.0f x %.0f)" % [want - 0.1, dmg[1], dmg[0]])
	for e in [lam, other, foe]:
		sim.despawn(e)

## Onda 2 (GDD §8.2): Sangria cura por alvo que sangrava; Presas Gêmeas estende as feridas.
func _check_bleed_whirl(gd, sim) -> void:
	var at := Vector3(-20, 0, 80)
	var ber: SimEntity = _fill_bot(gd, sim, "berserker", "carniceiro", at)
	for sl in ber.equipment.keys():            # só as armas: conjunto sorteado (Fusão/Ápice) com roubo de vida enchia a vida nos dois lados
		if sl != ItemDef.Slot.WEAPON and sl != ItemDef.Slot.OFFHAND:
			ber.equipment.erase(sl)
	ber.recompute_stats()
	var s: SkillDef = gd.skills["ber_steel_whirl"]
	check(s.build == "carniceiro" and s.unlock_level == 12 and s.effects.get("wound_heal") is Dictionary and not s.effects.has("heal_pct_of_dmg"), "Sangria: nível 12, cura por ferida (sem o roubo genérico)")
	var foes: Array = []
	for i in range(5):
		foes.append(_fill_dummy(gd, sim, at + Vector3(cos(i * 1.2), 0, sin(i * 1.2)) * 1.6))
	var heal_of := func(n_bleed: int) -> float:
		for i in range(foes.size()):
			var f: SimEntity = foes[i]
			f.hp = 1.0e6
			f.debuffs.clear()
			if i < n_bleed:
				f.debuffs.append({"kind": "dot", "id": "dot_%d_ber_hack" % ber.id, "remaining": 4.0, "dps": 1.0, "src": ber.id})
		sim.rng.seed = 4242                # mesmos críticos: o roubo de vida do golpe é igual nos dois lados
		ber.cooldowns.clear()
		ber.buffs.clear()                  # arma lendária sorteada (Frenesi) dava roubo de vida que crescia entre as chamadas
		ber.recompute_stats()
		ber.stats.legend = {}
		ber.stats.lifesteal = 0.0          # roubo de vida do equipamento/teia sorteados enchia a vida nos dois lados (a diferença sumia)
		ber.stats.crit_leech = 0.0
		ber.stats.low_leech = 0.0
		ber.hp = ber.stats.max_hp * 0.3
		var h0 := ber.hp
		_fill_cast(sim, ber, "ber_steel_whirl", ber.position)
		return ber.hp - h0
	var pct := float(Balance.WOUND_WHIRL["pct"]) / 100.0
	var mx := int(Balance.WOUND_WHIRL["max"])
	var h0: float = heal_of.call(0)
	var h2: float = heal_of.call(2)
	var h5: float = heal_of.call(5)
	check(absf(h2 - h0 - ber.stats.max_hp * pct * 2.0) <= 2.0, "Sangria: 2 sangrando = +%.0f%% da vida (%.0f)" % [pct * 200.0, h2 - h0])
	check(absf(h5 - h0 - ber.stats.max_hp * pct * mx) <= 2.0, "Sangria: 5 sangrando cura no máximo %d alvos (%.0f)" % [mx, h5 - h0])
	# Presas Gêmeas: +add s, até cap
	var f0: SimEntity = foes[0]
	f0.debuffs.clear()
	f0.debuffs.append({"kind": "dot", "id": "w1", "remaining": 3.0, "dps": 1.0, "src": ber.id})
	f0.debuffs.append({"kind": "dot", "id": "w2", "remaining": 7.0, "dps": 1.0, "src": ber.id})
	f0.debuffs.append({"kind": "dot", "id": "b1", "remaining": 3.0, "dps": 1.0, "src": ber.id, "fire": true})
	for f in foes:
		if f != f0:
			sim.despawn(f)
	_fill_cast(sim, ber, "ber_twin_fang", f0.position)
	var rem := {}
	for d in f0.debuffs:
		rem[str(d.get("id", ""))] = float(d.get("remaining", 0.0))
	var add := float(Balance.WOUND_EXTEND["add"])
	var cap := float(Balance.WOUND_EXTEND["cap"])
	check(is_equal_approx(rem.get("w1", 0.0), 3.0 + add) and is_equal_approx(rem.get("w2", 0.0), cap) and is_equal_approx(rem.get("b1", 0.0), 3.0),
		"Presas Gêmeas: ferida +%.0fs, até %.0fs; queimadura não muda (%s)" % [add, cap, str(rem)])
	sim.despawn(f0)
	sim.despawn(ber)

## Onda 2 (GDD §8.3): Guarda do Duelista apara (0 de dano, chefe passa parte), responde até N por janela, dá Ímpeto;
## dano no tempo, zona avisada, golpe pelas costas e a cópia permanente do talento não aparam; Golpe de Mestre gasta.
func _check_riposte(gd, sim) -> void:
	var at := Vector3(-10, 0, 80)
	var duel: SimEntity = _fill_bot(gd, sim, "assassin", "duelista", at)
	var mob: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, 1.6))
	var back: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, -1.6))
	duel.face_towards(mob.position)
	var hit := func(from: SimEntity, kind := "physical", dodge := true) -> float:
		duel.stats.evasion = 0.0
		duel.hp = duel.stats.max_hp
		var h := duel.hp
		sim._deal_damage(from, duel, 100, false, false, kind, null, dodge)
		return h - duel.hp
	check(hit.call(mob) > 50.0, "sem a Guarda o golpe entra")
	_fill_cast(sim, duel, "ass_guard", mob.position)
	check(not RiposteSystem.window(duel).is_empty(), "Guarda do Duelista abre a janela de aparar")
	var m0 := mob.hp
	check(is_zero_approx(hit.call(mob)), "aparar: golpe de perto e de frente sai 0")
	var per: float = maxf(1.0, floorf(duel.stats.patk * (Balance.RIPOSTE_COUNTER_PCT + RiposteSystem.legend_pct(duel)) / 100.0))
	check(m0 - mob.hp >= per * 0.95, "aparar: resposta de %.0f%% do ATK em quem bateu (%.0f)" % [Balance.RIPOSTE_COUNTER_PCT + RiposteSystem.legend_pct(duel), m0 - mob.hp])
	check(duel.buff_stacks(Balance.RIPOSTE_MOMENTUM_BUFF) == 1, "aparar dá 1 Ímpeto")
	check(hit.call(back) > 50.0, "golpe pelas costas não é aparado")
	check(hit.call(mob, "dot_test") > 50.0, "dano no tempo não é aparado")
	check(hit.call(mob, "physical", false) > 50.0, "zona avisada no chão (não esquivável) não é aparada")
	# vários golpes no mesmo tick: todos aparados, só RIPOSTE_MAX_COUNTERS respondem; Ímpeto para no máximo
	duel.drop_buff(Balance.RIPOSTE_BUFF)
	_fill_cast(sim, duel, "ass_guard", mob.position)
	mob.hp = 1.0e6
	var took := 0.0
	for i in range(Balance.RIPOSTE_MAX_COUNTERS + 2):
		took += hit.call(mob)
	var answered := (1.0e6 - mob.hp) / per
	check(is_zero_approx(took) and answered < Balance.RIPOSTE_MAX_COUNTERS + 0.5 and answered > Balance.RIPOSTE_MAX_COUNTERS - 0.5,
		"%d golpes na janela: todos aparados, %d respostas (%.1f)" % [Balance.RIPOSTE_MAX_COUNTERS + 2, Balance.RIPOSTE_MAX_COUNTERS, answered])
	check(duel.buff_stacks(Balance.RIPOSTE_MOMENTUM_BUFF) == Balance.RIPOSTE_MOMENTUM_MAX, "Ímpeto para em %d" % Balance.RIPOSTE_MOMENTUM_MAX)
	# chefe: passa parte
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		if md.is_boss and md.elite_of == "":
			var boss: SimEntity = sim.spawn_monster(md, "city_aldara", at + Vector3(0.3, 0, 1.6))
			boss.brain = null
			var got: float = hit.call(boss)
			check(absf(got - 100.0 * (1.0 - Balance.RIPOSTE_BOSS_CUT)) <= 2.0, "chefe: aparado passa %.0f%% (%.0f)" % [(1.0 - Balance.RIPOSTE_BOSS_CUT) * 100.0, got])
			sim.despawn(boss)
			break
	# a cópia permanente do talento (ct) não apara
	duel.drop_buff(Balance.RIPOSTE_BUFF)
	duel.put_buff({"id": Balance.RIPOSTE_BUFF, "remaining": 1.0, "ct": true, "def_pct": 15.0})
	check(hit.call(mob) > 10.0, "a Guarda permanente do talento não apara")
	duel.drop_buff(Balance.RIPOSTE_BUFF)
	# Golpe de Mestre gasta o Ímpeto
	check(gd.skills["ass_master"].effects.get("momentum_spend") is Dictionary, "Golpe de Mestre gasta o Ímpeto")
	duel.cooldowns.clear()
	_fill_cast(sim, duel, "ass_master", mob.position)
	check(duel.buff_stacks(Balance.RIPOSTE_MOMENTUM_BUFF) == 0, "Golpe de Mestre: o Ímpeto some")
	RiposteSystem.gain(duel, 5)
	var mult := RiposteSystem.spend(duel, Balance.RIPOSTE_SPEND_PCT)
	check(is_equal_approx(mult, 1.0 + Balance.RIPOSTE_SPEND_PCT / 100.0 * Balance.RIPOSTE_MOMENTUM_MAX), "Golpe de Mestre: x%.2f com o Ímpeto cheio" % mult)
	# Riposte lendária: esquivar responde e dá Ímpeto (uma função só)
	if str(duel.stats.legend.get("kind", "")) == "riposte":
		mob.hp = 1.0e6
		RiposteSystem.legend_dodge(sim, duel, mob, "physical")
		check(mob.hp < 1.0e6 and duel.buff_stacks(Balance.RIPOSTE_MOMENTUM_BUFF) == 1, "Riposte lendária: esquiva responde e dá Ímpeto")
	# bot: só abre a Guarda com golpe vindo nele (ou cercado)
	var bb := BotBrain.new()
	var g: SkillDef = gd.skills["ass_guard"]
	mob.aggro_target = -1
	back.aggro_target = -1
	check(not bb._fill_ok(duel, sim, g, mob), "bot: sem golpe vindo, não abre a Guarda")
	mob.aggro_target = duel.id
	mob.current_skill = mob.basic_skill
	mob.skill_phase = "startup"
	check(bb._fill_ok(duel, sim, g, mob), "bot: inimigo colado preparando golpe nele, abre a Guarda")
	mob.current_skill = null
	mob.skill_phase = ""
	check(not bb._fill_ok(duel, sim, g, mob), "bot: um inimigo parado não basta")
	back.aggro_target = duel.id
	check(bb._fill_ok(duel, sim, g, mob), "bot: com %d inimigos em cima, abre a Guarda" % Balance.BOT_RIPOSTE_CROWD)
	for e in [duel, mob, back]:
		sim.despawn(e)

func _check_seed(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-20, 0, 70)
	var ele: SimEntity = _fill_bot(gd, sim, "elementalist", "fogo", at)
	var a: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, 6))
	var b: SimEntity = _fill_dummy(gd, sim, at + Vector3(1.5, 0, 6))
	var c: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, 16))
	_fill_cast(sim, ele, "ele_ember_seed", a.position)
	check(SeedSystem.seeds_on(a).size() == 1 and a.debuffs.any(func(d): return d.get("kind") == "dot" and d.get("fire", false)), "Semente Ígnea: planta a semente e queima o alvo")
	_fill_cast(sim, ele, "ele_ember_seed", a.position)
	check(SeedSystem.seeds_on(a).size() == 1 and is_equal_approx(float(SeedSystem.seeds_on(a)[0]["remaining"]), float(Balance.EMBER_SEED["delay"])), "Semente Ígnea: relançar renova (uma por lançador e alvo)")
	check(b.hp == 1.0e6, "Semente Ígnea: o vizinho não leva nada antes de explodir")
	sim._update_entity(a, m, float(Balance.EMBER_SEED["delay"]) + 0.05)
	check(b.hp < 1.0e6 and c.hp == 1.0e6, "Semente Ígnea: no fim do tempo explode em volta (o de longe não leva)")
	check(b.debuffs.any(func(d): return d.get("kind") == "dot" and d.get("fire", false) and str(d.get("id", "")).contains("ele_ember_seed")), "Semente Ígnea: a explosão espalha a queimadura da skill")
	check(SeedSystem.seeds_on(b).is_empty() and SeedSystem.seeds_on(a).is_empty(), "Semente Ígnea: a explosão não planta semente nova")
	# teto de cópias de queimadura por skill (PLAYER_DOT_MAX_STACKS)
	for i in range(Balance.PLAYER_DOT_MAX_STACKS + 2):
		SeedSystem.plant(ele, a, ({"delay": 0.0, "radius": 3.0, "power": 0.1, "spread_dot": true, "max_targets": 6, "mult": 1.0, "skill": "ele_ember_seed"} as Dictionary),
			{"dps": 8, "duration": 4, "fire": true, "skill": "ele_ember_seed"})
		SeedSystem.burst(sim, a, SeedSystem.seeds_on(a)[0])
		a.debuffs = a.debuffs.filter(func(d): return d.get("kind") != SeedSystem.KIND)
	var copies: int = b.debuffs.filter(func(d): return d.get("kind") == "dot" and str(d.get("id", "")).contains("ele_ember_seed")).size()
	check(copies <= Balance.PLAYER_DOT_MAX_STACKS, "Semente Ígnea: espalhar respeita o teto de %d queimaduras por skill (%d)" % [Balance.PLAYER_DOT_MAX_STACKS, copies])
	# o alvo morre antes: explode na hora
	b.hp = 1.0e6
	b.debuffs.clear()
	var d1: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(-1.5, 0, 6))
	d1.brain = null
	_fill_cast(sim, ele, "ele_ember_seed", d1.position)
	sim._deal_damage(ele, d1, int(d1.hp) + 10, false, false, "magical")
	check(not d1.is_alive() and b.hp < 1.0e6, "Semente Ígnea: o alvo morreu antes, a semente explode na hora")
	# dono morto: some sem explodir
	b.hp = 1.0e6
	a.debuffs.clear()
	_fill_cast(sim, ele, "ele_ember_seed", a.position)
	ele.set_state(SimEntity.State.DEAD)
	var bh := b.hp
	sim._update_entity(a, m, float(Balance.EMBER_SEED["delay"]) + 0.05)
	check(b.hp == bh and SeedSystem.seeds_on(a).is_empty(), "Semente Ígnea: dono morto, a semente some sem explodir")
	ele.set_state(SimEntity.State.IDLE)
	for e in [ele, a, b, c, d1]:
		sim.despawn(e)

func _check_sacrifice(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-10, 0, 70)
	var nec: SimEntity = _fill_bot(gd, sim, "necromancer", "invocador", at)
	var s: SkillDef = gd.skills["nec_dark_offering"]
	nec.learned[s.id] = true
	nec.skills[0] = s
	nec.cooldowns.clear()
	nec.mp = nec.stats.max_mp
	var foe: SimEntity = _fill_dummy(gd, sim, at + Vector3(0, 0, 6))
	var mp0 := nec.mp
	check(not sim.try_cast(nec, 0, foe.position, m) and nec.mp == mp0 and not nec.cooldowns.has(s.id), "Oferenda: sem morto-vivo por perto é recusada sem gastar MP nem recarga")
	var skel: Array = []
	for i in range(5):
		skel.append(sim.spawn_summon(nec, gd.monsters["skeleton_minion"], foe.position + Vector3(0.5 * i - 1.0, 0, -1.0), 25.0))
	var king: SimEntity = sim.spawn_summon(nec, gd.monsters["skeleton_king"], foe.position + Vector3(0, 0, -0.5), 30.0)
	var other: SimEntity = _fill_bot(gd, sim, "necromancer", "invocador", at + Vector3(3, 0, 0))
	var foreign: SimEntity = sim.spawn_summon(other, gd.monsters["skeleton_minion"], foe.position + Vector3(0, 0, 0.8), 25.0)
	check(SummonRites.pick(sim, nec, foe.position, s.effects["sacrifice"]).size() == int(Balance.DARK_OFFERING["max"]), "Oferenda: escolhe até %d (dos 5 esqueletos)" % int(Balance.DARK_OFFERING["max"]))
	check(sim.try_cast(nec, 0, foe.position, m) and nec.mp < mp0, "Oferenda: com mortos-vivos perto, lança")
	var xp0 := nec.xp
	var loot0: int = (m.get("loot", []) as Array).size()
	nec.skill_aim = foe.position
	sim._apply_skill(nec, sim.resolve_skill(nec, s), m)
	var gone := 0
	for sk in skel:
		if not sim.entities.has(sk.id):
			gone += 1
	check(gone == int(Balance.DARK_OFFERING["max"]) and foe.hp < 1.0e6, "Oferenda: %d esqueletos explodem e somem, o inimigo leva (%d)" % [int(Balance.DARK_OFFERING["max"]), gone])
	check(sim.entities.has(king.id) and sim.entities.has(foreign.id), "Oferenda: o Rei Esqueleto e a invocação de outro necromante ficam")
	check(nec.xp == xp0 and (m.get("loot", []) as Array).size() == loot0, "Oferenda: invocação oferecida não dá XP nem saque")
	# cheia de vida bate mais que quase morta (hp_weight)
	var hi: SimEntity = null
	var lo_skel: Array = (skel as Array).filter(func(x): return sim.entities.has(x.id))
	for x in lo_skel:
		sim.despawn(x)
	var full := 0.0
	var low := 0.0
	for i in range(10):
		foe.hp = 1.0e6
		hi = sim.spawn_summon(nec, gd.monsters["skeleton_minion"], foe.position + Vector3(0, 0, -1), 25.0)
		if i % 2 == 1:
			hi.hp = 1.0
		SummonRites.offer(sim, nec, s, foe.position, 1.5, s.effects["sacrifice"])
		if i % 2 == 1:
			low += 1.0e6 - foe.hp
		else:
			full += 1.0e6 - foe.hp
	check(full > low * 1.4, "Oferenda: morto-vivo cheio de vida explode mais forte (%.0f x %.0f)" % [full, low])
	# bot: só com BOT_SACRIFICE_MIN mortos-vivos perto do alvo
	var bb := BotBrain.new()
	check(not bb._fill_ok(nec, sim, s, foe), "bot: Oferenda não sai sem %d mortos-vivos perto" % Balance.BOT_SACRIFICE_MIN)
	for i in range(Balance.BOT_SACRIFICE_MIN):
		sim.spawn_summon(nec, gd.monsters["skeleton_minion"], foe.position + Vector3(0.4 * i, 0, -1), 25.0)
	check(bb._fill_ok(nec, sim, s, foe), "bot: com %d perto, oferece" % Balance.BOT_SACRIFICE_MIN)
	for e in m["entities"].duplicate():
		if e.kind == SimEntity.Kind.SUMMON and (e.owner_id == nec.id or e.owner_id == other.id):
			sim.despawn(e)
	for e in [nec, other, foe]:
		sim.despawn(e)

# =============================================================================================
# Supremas do nível 40 (GDD design/gdd/ultimates-lv40.md; UltimateSystem, StormSystem, HopSystem, InterceptSystem,
# UltEffects). `--only=ultimate`
# =============================================================================================

## Personagem de teste liberado (nível 40 + missão de ascensão), na build pedida, sem cérebro e com a carga zerada.
func _ult_char(gd, sim, cls: String, build: String, at: Vector3, nm: String, level: int = 40) -> SimEntity:
	var e: SimEntity = sim.spawn_bot(gd.classes[cls], nm, "city_aldara", at, level)
	e.brain = null
	e.build_id = build
	if not e.quests_completed.has("hx_asc_" + cls):
		e.quests_completed.append("hx_asc_" + cls)
	e.hp = e.stats.max_hp
	UltimateSystem.refresh(sim, e)
	UltimateSystem.zero(e)
	e.ult_gap_until = 0.0
	e.ult_budget = Balance.ULT_RATE_BURST
	return e

## Passa `secs` s "fora de combate" para o medidor (o relógio da sim fica parado nos testes: recua o último combate).
## O recuo sai de uma base fixa (base - k*dt), não de "-= dt" repetido: somar 0,1 muitas vezes errava a última casa e,
## com sim.time grande (depois de outros checks), o "6 s fora de luta" virava 6,0000001 e já esvaziava.
func _ult_idle(sim, e: SimEntity, secs: float, dt: float = 0.1) -> void:
	var n := int(round(secs / dt))
	var base: float = e.ult_combat_t
	for i in range(n):
		e.ult_combat_t = base - float(i + 1) * dt
		UltimateSystem.tick(sim, e, dt)

func _ult_mob(gd, sim, id: String, at: Vector3) -> SimEntity:
	var mob: SimEntity = sim.spawn_monster(gd.monsters[id], "city_aldara", at)
	mob.brain = null
	mob.hp = 1.0e7                    # aguenta a sequência inteira (o personagem é nível 40)
	return mob

func _ult_boss_id(gd) -> String:
	var ids: Array = gd.monsters.keys()
	ids.sort()
	for id in ids:
		var md: MonsterDef = gd.monsters[id]
		if md.resists_cc() and md.shift_forms.is_empty() and not md.dummy:
			return id
	return ""

## Liberação e catálogo: nível 40 E ascensão; a Suprema é a da build principal com a arma dela; fora da teia/barra.
func _check_ultimate_unlock(gd, sim) -> void:
	var at := Vector3(36, 0, -52)
	var e := _ult_char(gd, sim, "elementalist", "fogo", at, "UltLib", 39)
	check(not UltimateSystem.has_ultimate(e), "suprema: nível 39 com ascensão = sem Suprema")
	e.level = 40
	e.quests_completed.erase("hx_asc_elementalist")
	check(not UltimateSystem.has_ultimate(e), "suprema: nível 40 sem a missão de ascensão = sem Suprema")
	check(UltimateSystem.lock_reason(sim, e) == "Nível %d e Ascensão" % Balance.ULT_LEVEL, "suprema: travada diz o porquê (%s)" % UltimateSystem.lock_reason(sim, e))
	e.quests_completed.append("hx_asc_elementalist")
	check(UltimateSystem.has_ultimate(e), "suprema: nível 40 com a ascensão = liberada")
	var s: SkillDef = UltimateSystem.ultimate_of(sim, e)
	check(s != null and s.id == "ele_ult_meteor_rain", "suprema: build Fogo -> Chuva de Meteoros (%s)" % (s.id if s else "null"))
	check(sim.ultimate_of(e) == s and sim.has_ultimate(e) and sim.ultimate_lock(e) == "", "suprema: repasses públicos do Sim")
	e.build_id = "gelo"
	var gelo_ult: SkillDef = UltimateSystem.ultimate_of(sim, e)
	check(gelo_ult != null and gelo_ult.id == "ele_ult_eternal_winter", "suprema: trocar a build troca a Suprema (Gelo -> Inverno Eterno, onda B2)")
	e.build_id = "fogo"
	var keep: ItemDef = e.equipment.get(ItemDef.Slot.WEAPON)
	e.equipment[ItemDef.Slot.WEAPON] = null
	e.recompute_stats()
	check(UltimateSystem.ultimate_of(sim, e) == null and UltimateSystem.lock_reason(sim, e) == "Arma da build necessária", "suprema: sem o cajado = sem Suprema (arma da build)")
	e.equipment[ItemDef.Slot.WEAPON] = keep
	e.recompute_stats()
	sim.despawn(e)
	# catálogo
	var ult_n := 0
	for sid in gd.skills:
		var sk: SkillDef = gd.skills[sid]
		if not sk.ultimate:
			continue
		ult_n += 1
		check(sk.unlock_level == Balance.ULT_LEVEL and sk.mp_cost == 0.0 and sk.cooldown == 0.0, "suprema %s: nível %d, custo 0, sem recarga" % [sid, Balance.ULT_LEVEL])
		check(sk.ult_bot in ["boss", "save", "self"], "suprema %s: ult_bot válido (%s)" % [sid, sk.ult_bot])
		check(sid.contains("_ult_") and sk.build != "" and gd.ultimates.get(sk.class_id, {}).get(sk.build, "") == sid, "suprema %s: id <prefixo>_ult_<nome>, uma por build (GameData.ultimates)" % sid)
		check(not (sid in gd.classes[sk.class_id].skill_ids), "suprema %s: fora da ClassDef.skill_ids (teia, barra, rank)" % sid)
		check(not str(gd.trees.get(sk.class_id, {})).contains(sid) and not str(gd.asc_trees.get(sk.class_id, {})).contains(sid), "suprema %s: fora da teia e da teia de ascensão" % sid)
		check(Balance.ULT_NUMBERS.has(sid), "suprema %s: números em Balance.ULT_NUMBERS" % sid)
		check(ResourceLoader.exists("res://assets/icons/skill_%s.png" % sid), "suprema %s: ícone (make_icons -- --only=%s)" % [sid, sid])
		var aim_ok: bool = is_equal_approx(sk.startup, float((Balance.ULT_NUMBERS.get(sid, {}) as Dictionary).get("aim", -1.0)))     # mira longa declarada (Disparo do Fim)
		check(sk.description != "" and (sk.startup <= 0.3 + 0.001 or aim_ok), "suprema %s: texto e startup <= 0,3 s (ou a mira de ULT_NUMBERS)" % sid)
	check(ult_n >= 1, "suprema: ao menos a Chuva de Meteoros no catálogo (onda A)")
	var who := _ult_char(gd, sim, "elementalist", "fogo", at, "UltSlot")
	check(not ProgressionSystem.set_skill_slot(sim, who, 0, "ele_ult_meteor_rain") and not who.knows("ele_ult_meteor_rain"), "suprema: não entra nas vagas 1-0 (não é skill aprendida)")
	sim.despawn(who)

## Medidor: pesos por papel, dano no tempo, teto de alvos por ação, sobrecura, golpe recebido com teto, teto 100.
func _check_ultimate_meter(gd, sim) -> void:
	var at := Vector3(40, 0, -52)
	var dps := _ult_char(gd, sim, "elementalist", "fogo", at, "UltDps")
	var tank := _ult_char(gd, sim, "paladin", "guardiao", at + Vector3(2, 0, 0), "UltTank")
	var heal := _ult_char(gd, sim, "bishop", "sacerdote", at + Vector3(-2, 0, 0), "UltCura")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 3))
	var fb: SkillDef = gd.skills["ele_fireball"]
	check(dps.ult_role == "caster" and tank.ult_role == "tank" and heal.ult_role == "healer", "medidor: papéis da build (%s/%s/%s)" % [dps.ult_role, tank.ult_role, heal.ult_role])
	UltimateSystem.on_dealt(sim, dps, mob, fb, 2.0)
	check(is_equal_approx(dps.ult_charge, 2.0 * Balance.ULT_GAIN_PER_POWER), "medidor: golpe de poder 2,0 de dano dá %.2f pts (%.2f)" % [2.0 * Balance.ULT_GAIN_PER_POWER, dps.ult_charge])
	UltimateSystem.on_dealt(sim, tank, mob, fb, 2.0)
	check(is_equal_approx(tank.ult_charge, 2.0 * Balance.ULT_GAIN_PER_POWER * UltimateSystem.weight(tank, 0)), "medidor: o mesmo golpe do tanque dá × peso do tanque (%.2f)" % tank.ult_charge)
	check(UltimateSystem.weight(tank, 0) < UltimateSystem.weight(dps, 0) and UltimateSystem.weight(tank, 2) > UltimateSystem.weight(dps, 2) and UltimateSystem.weight(heal, 1) > UltimateSystem.weight(dps, 1),
		"medidor: tanque enche mais apanhando, cura mais curando, dano mais batendo")
	# dano no tempo: poder do pulso = dano / MATK
	UltimateSystem.zero(dps)
	var pulse := int(round(dps.stats.matk))
	UltimateSystem.on_dot(sim, dps, mob, pulse, {"kind": "dot"})
	check(absf(dps.ult_charge - Balance.ULT_GAIN_PER_POWER * Balance.ULT_DOT_MULT * float(pulse) / dps.stats.matk) < 0.01, "medidor: pulso de dano no tempo de poder 1 vale × ULT_DOT_MULT (%.2f)" % dps.ult_charge)
	UltimateSystem.zero(dps)
	UltimateSystem.on_dot(sim, dps, mob, pulse, {"kind": "dot", "ult": true})
	check(dps.ult_charge == 0.0, "medidor: dano no tempo de Suprema não enche")
	# área: 8 alvos na mesma ação contam ULT_AOE_TARGETS
	var mobs: Array = []
	for i in range(8):
		mobs.append(_ult_mob(gd, sim, "slime", at + Vector3(float(i) - 4.0, 0, 6)))
	UltimateSystem.zero(dps)
	dps.ult_budget = Balance.ULT_RATE_BURST
	dps.ult_act_tick = -1
	for o in mobs:
		UltimateSystem.on_dealt(sim, dps, o, gd.skills["ele_meteor"], 1.0)
	check(is_equal_approx(dps.ult_charge, float(Balance.ULT_AOE_TARGETS) * Balance.ULT_GAIN_PER_POWER), "medidor: área com 8 alvos conta %d (%.1f)" % [Balance.ULT_AOE_TARGETS, dps.ult_charge])
	# invocação: × ULT_SUMMON_MULT para o dono
	var nec := _ult_char(gd, sim, "necromancer", "invocador", at + Vector3(0, 0, -3), "UltNec")
	var sk: SimEntity = sim.spawn_summon(nec, gd.monsters["skeleton_minion"], nec.position + Vector3(1, 0, 0), 20.0)
	UltimateSystem.on_dealt(sim, sk, mob, gd.skills[gd.monsters["skeleton_minion"].skill_ids[0]] if not gd.monsters["skeleton_minion"].skill_ids.is_empty() else fb, 1.0)
	check(is_equal_approx(nec.ult_charge, Balance.ULT_SUMMON_MULT * Balance.ULT_GAIN_PER_POWER), "medidor: invocação enche o dono × %.1f (%.2f)" % [Balance.ULT_SUMMON_MULT, nec.ult_charge])
	# cura: efetiva / cura de poder 1 do lançador × peso; sobrecura = 0
	var ally := tank
	ally.combat_timer = 5.0
	ally.hp = ally.stats.max_hp - 100.0
	var ref := heal.stats.matk * heal.stats.heal_power
	sim._heal(heal, ally, 400)
	check(absf(heal.ult_charge - 100.0 / ref * UltimateSystem.weight(heal, 1) * Balance.ULT_GAIN_HEAL) < 0.01, "medidor: cura de 400 com 100 de falta conta só 100 (%.3f)" % heal.ult_charge)
	var before := heal.ult_charge
	sim._heal(heal, ally, 400)
	check(heal.ult_charge == before, "medidor: sobrecura não enche")
	ally.hp = ally.stats.max_hp - 100.0
	ally.combat_timer = 0.0
	heal.combat_timer = 0.0
	sim._heal(heal, ally, 50)
	check(heal.ult_charge == before, "medidor: cura fora de combate não enche")
	sim.ult_quiet = true
	ally.combat_timer = 5.0
	sim._heal(heal, ally, 50)
	sim.ult_quiet = false
	check(heal.ult_charge == before, "medidor: poção (ult_quiet) não enche")
	# escudo: conta quando absorve, para quem pôs
	UltimateSystem.zero(heal)
	sim._apply_effects(heal, ally, {"shield": {"amount_pct_hp": 10, "duration": 5}}, 1.0)
	check(ally.shield_src == heal.id and heal.ult_charge == 0.0, "medidor: escudo posto não enche ainda")
	sim._deal_damage(mob, ally, 30, false, false, "physical")
	check(heal.ult_charge > 0.0, "medidor: escudo que absorveu enche quem pôs (%.2f)" % heal.ult_charge)
	tank.ult_budget = Balance.ULT_RATE_BURST
	# golpe recebido: % da vida × ULT_GAIN_TAKEN, teto por golpe, × peso
	UltimateSystem.zero(tank)
	UltimateSystem.on_taken(sim, mob, tank, int(tank.stats.max_hp * 0.5), "physical")
	tank.ult_budget = Balance.ULT_RATE_BURST
	check(is_equal_approx(tank.ult_charge, Balance.ULT_TAKEN_HIT_CAP * UltimateSystem.weight(tank, 2)), "medidor: golpe de 50%% da vida dá no máximo %.1f × peso (%.2f)" % [Balance.ULT_TAKEN_HIT_CAP, tank.ult_charge])
	UltimateSystem.zero(tank)
	UltimateSystem.on_taken(sim, mob, tank, int(tank.stats.max_hp * 0.05), "physical")
	check(absf(tank.ult_charge - minf(Balance.ULT_TAKEN_HIT_CAP, Balance.ULT_GAIN_TAKEN * 100.0 * int(tank.stats.max_hp * 0.05) / tank.stats.max_hp) * UltimateSystem.weight(tank, 2)) < 0.01, "medidor: golpe de 5%% = ULT_GAIN_TAKEN × 5 × peso (%.2f)" % tank.ult_charge)
	UltimateSystem.zero(tank)
	UltimateSystem.on_taken(sim, mob, tank, 500, "intercept")
	check(tank.ult_charge == 0.0, "medidor: dano redirecionado pela Proteção não enche")
	# teto de ritmo: 10 s batendo 10 pts/s enchem no máximo estoque + CAP × 10
	UltimateSystem.zero(dps)
	dps.ult_budget = Balance.ULT_RATE_BURST
	dps.ult_combat_t = sim.time + 1000.0          # "em combate" o tempo todo (o gotejar entra à parte)
	for i in range(100):
		dps.ult_act_tick = -1
		UltimateSystem.on_dealt(sim, dps, mob, fb, 1.0)
		UltimateSystem.tick(sim, dps, 0.1)
	var most := Balance.ULT_RATE_BURST + (Balance.ULT_RATE_CAP + Balance.ULT_TRICKLE) * 10.0
	check(dps.ult_charge <= most + 0.01 and dps.ult_charge >= most - Balance.ULT_RATE_CAP, "medidor: teto de ritmo (%.1f de no máx. %.1f em 10 s)" % [dps.ult_charge, most])
	dps.ult_combat_t = sim.time
	dps.ult_budget = Balance.ULT_RATE_BURST
	# teto 100 e aviso de cheia
	dps.ult_charge = Balance.ULT_MAX - 1.0
	dps.ult_full_at = -1.0
	UltimateSystem.gain(sim, dps, 5.0)
	check(dps.ult_charge == Balance.ULT_MAX and dps.ult_full_at == sim.time, "medidor: cheia não passa de %d e marca a hora" % int(Balance.ULT_MAX))
	# sem liberação não enche
	var low := _ult_char(gd, sim, "elementalist", "fogo", at + Vector3(4, 0, 0), "UltBaixo", 35)
	UltimateSystem.on_dealt(sim, low, mob, fb, 3.0)
	check(low.ult_charge == 0.0, "medidor: nível 35 não enche")
	for o in mobs:
		sim.despawn(o)
	for o in [dps, tank, heal, nec, sk, mob, low]:
		sim.despawn(o)

## Esvaziar: 6 s fora de luta não perde, depois ULT_DECAY_RATE/s; cheia some em ~18,5 s; morrer e trocar de mapa zeram;
## o boneco de treino enche no ritmo normal e nada sobra 19 s depois. Gotejar em combate.
func _check_ultimate_decay(gd, sim) -> void:
	var at := Vector3(44, 0, -52)
	var keep_time: float = sim.time
	sim.time = ceilf(sim.time)                 # relógio inteiro: sim.time - (sim.time - 6) dá 6 exato (não depende dos checks de antes)
	var e := _ult_char(gd, sim, "elementalist", "fogo", at, "UltDecay")
	e.ult_charge = Balance.ULT_MAX
	e.ult_combat_t = sim.time
	_ult_idle(sim, e, Balance.ULT_DECAY_DELAY)
	check(e.ult_charge == Balance.ULT_MAX, "esvaziar: %.0f s fora de luta não perde (%.1f)" % [Balance.ULT_DECAY_DELAY, e.ult_charge])
	_ult_idle(sim, e, 1.0)
	check(absf(e.ult_charge - (Balance.ULT_MAX - Balance.ULT_DECAY_RATE)) < Balance.ULT_DECAY_RATE * 0.15, "esvaziar: depois perde %.0f/s (%.1f)" % [Balance.ULT_DECAY_RATE, e.ult_charge])
	_ult_idle(sim, e, 12.0)
	check(e.ult_charge == 0.0, "esvaziar: cheia vazia em %.1f s" % (Balance.ULT_DECAY_DELAY + Balance.ULT_MAX / Balance.ULT_DECAY_RATE))
	# gotejar em combate
	e.ult_combat_t = sim.time
	UltimateSystem.tick(sim, e, 1.0)
	check(is_equal_approx(e.ult_charge, Balance.ULT_TRICKLE), "gotejar: +%.2f/s em combate (%.2f)" % [Balance.ULT_TRICKLE, e.ult_charge])
	# boneco de treino: conta como combate e enche
	var dummy: SimEntity = sim.spawn_monster(gd.monsters["training_dummy"], "city_aldara", at + Vector3(2, 0, 0))
	e.kind = SimEntity.Kind.PLAYER                  # o boneco só é inimigo do jogador
	UltimateSystem.zero(e)
	e.ult_act_tick = -1
	UltimateSystem.on_dealt(sim, e, dummy, gd.skills["ele_fireball"], 2.0)
	check(is_equal_approx(e.ult_charge, 2.0 * Balance.ULT_GAIN_PER_POWER), "boneco: enche no ritmo normal (%.2f)" % e.ult_charge)
	e.ult_charge = Balance.ULT_MAX
	_ult_idle(sim, e, 19.0)
	check(e.ult_charge == 0.0, "boneco: 19 s depois de sair dele não sobra carga")
	e.kind = SimEntity.Kind.BOT
	sim.despawn(dummy)
	# morrer zera
	e.ult_charge = 60.0
	var mob := _ult_mob(gd, sim, "slime", at + Vector3(0, 0, 3))
	sim._kill(e, mob)
	check(e.ult_charge == 0.0, "esvaziar: morrer zera")
	sim.despawn(e)
	# trocar de mapa zera
	var f := _ult_char(gd, sim, "elementalist", "fogo", at, "UltMapa")
	f.ult_charge = 70.0
	var other := ""
	for mid in sim.maps:
		if mid != "city_aldara":
			other = mid
			break
	PortalSystem.change_map(sim, f, other, Vector3.ZERO)
	check(f.ult_charge == 0.0, "esvaziar: trocar de mapa zera (%s)" % other)
	sim.despawn(f)
	sim.despawn(mob)
	sim.time = maxf(sim.time, keep_time)

## R: recusa sem carga; cheia sai, zera, trava ULT_MIN_GAP; cancelada no preparo mantém; o dano dela não enche;
## InputCommand.ultimate é de 1 vez.
func _check_ultimate_cast(gd, sim) -> void:
	var at := Vector3(48, 0, -56)
	var m: Dictionary = sim.maps["city_aldara"]
	var e := _ult_char(gd, sim, "elementalist", "fogo", at, "UltR")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 3))
	var cmd := InputCommand.new()
	cmd.ultimate = true
	cmd.aim = mob.position
	e.ult_charge = Balance.ULT_MAX * 0.5
	sim._apply_command(e, cmd, m, 0.0)
	check(e.state != SimEntity.State.CASTING, "R: carga pela metade é recusada")
	check(UltimateSystem.cast_block(sim, e).begins_with("Carga Suprema incompleta"), "R: aviso diz a carga (%s)" % UltimateSystem.cast_block(sim, e))
	# cancelada no preparo (dash): a carga fica
	e.ult_charge = Balance.ULT_MAX
	sim._apply_command(e, cmd, m, 0.0)
	check(e.state == SimEntity.State.CASTING and e.current_skill != null and e.current_skill.ultimate and e.current_skill_slot == Balance.ULT_CAST_SLOT, "R: com a carga cheia a Suprema começa")
	var dash := InputCommand.new()
	dash.dash = true
	dash.aim = mob.position
	e.dash_cd = 0.0
	sim._apply_command(e, dash, m, 0.0)
	check(e.state == SimEntity.State.DASHING and e.ult_charge == Balance.ULT_MAX, "R: dash no preparo cancela e a carga fica")
	e.set_state(SimEntity.State.IDLE)
	# sai: zera, trava e posta o evento
	var seen: Array = []
	var cb := func(id: int, sid: String): seen.append([id, sid])
	Events.ultimate_cast.connect(cb)
	var cast_pos := e.position
	sim._apply_command(e, cmd, m, 0.0)
	for i in range(60):
		if e.state != SimEntity.State.CASTING:
			break
		sim._update_entity(e, m, 1.0 / 60.0)
	Events.ultimate_cast.disconnect(cb)
	check(e.ult_charge == 0.0 and e.ult_gap_until >= sim.time + Balance.ULT_MIN_GAP - 0.01, "R: saiu = carga zero e %.0f s sem encher" % Balance.ULT_MIN_GAP)
	check(seen.size() == 1 and seen[0][0] == e.id and seen[0][1] == "ele_ult_meteor_rain", "R: evento ultimate_cast (%s)" % str(seen))
	UltimateSystem.gain(sim, e, 10.0)
	check(e.ult_charge == 0.0, "R: na trava nada enche")
	check(UltimateSystem.cast_block(sim, e).begins_with("Suprema: aguarde"), "R: na trava o R avisa o tempo")
	var st: Array = StormSystem.storms_of(sim, e)
	check(st.size() == 1 and (st[0]["center"] as Vector3).distance_to(Vector3(cast_pos.x, 0, cast_pos.z)) < 0.01 and st[0]["anchor"] == "ground", "R: a Chuva de Meteoros fica presa onde o mago lançou")
	# o dano da própria Suprema não enche (mesmo sem a trava)
	e.ult_gap_until = 0.0
	UltimateSystem.on_dealt(sim, e, mob, gd.skills["ele_ult_meteor_rain"], 5.0)
	check(e.ult_charge == 0.0, "R: dano da Suprema não enche")
	# comando de 1 vez
	var dup := cmd.duplicate_cmd()
	check(dup.ultimate and cmd.has_action(), "R: duplicate_cmd leva o ultimate e conta como ação (buffer)")
	sim.player_cmd = cmd.duplicate_cmd()
	sim.tick(1.0 / 60.0)
	check(not sim.player_cmd.ultimate, "R: InputCommand.ultimate não se repete no tique seguinte")
	for x in (m.get("storms", []) as Array).duplicate():
		if int(x["owner"]) == e.id:
			m["storms"].erase(x)
	sim.despawn(e)
	sim.despawn(mob)

## storm: Chuva presa no chão (o mago anda e ela fica), tempestade que segue o lançador, meteoro acerta inimigo e queima
## com dano no tempo de Suprema; Gelo (pulse) congela no 3º pulso, chefe ×0,4 e uma vez; golpes avisados fora dos hazards.
func _check_ultimate_storm(gd, sim) -> void:
	var at := Vector3(52, 0, -60)
	var m: Dictionary = sim.maps["city_aldara"]
	var e := _ult_char(gd, sim, "elementalist", "fogo", at, "UltStorm")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 3))
	var s: SkillDef = gd.skills["ele_ult_meteor_rain"]
	var ally := _ult_char(gd, sim, "paladin", "guardiao", at + Vector3(0, 0, 3.5), "UltStormAliado")
	StormSystem.start(sim, e, s, at, 1.0, s.effects["storm"])
	var st: Dictionary = StormSystem.storms_of(sim, e)[0]
	e.position += Vector3(5, 0, 0)
	StormSystem.tick(sim, m)
	check((st["center"] as Vector3).distance_to(Vector3(at.x, 0, at.z)) < 0.01, "storm: presa no chão, o mago andou 5 m e ela ficou")
	var hz_before := (m.get("hazards", []) as Array).filter(func(h): return int(h["owner"]) == e.id).size()
	for i in range(20):
		st["next_at"] = sim.time
		StormSystem.tick(sim, m)
	var mine: Array = (m.get("ally_strikes", []) as Array).filter(func(h): return int(h["owner"]) == e.id)
	check(not mine.is_empty() and hz_before == 0 and (m.get("hazards", []) as Array).filter(func(h): return int(h["owner"]) == e.id).is_empty(),
		"storm: meteoros avisados na lista própria (ally_strikes), nunca em hazards (%d)" % mine.size())
	check(mine.all(func(h): return Vector2(h["pos"].x - at.x, h["pos"].z - at.z).length() <= float(st["radius"]) + 1.0), "storm: todo meteoro cai a até %.0f m do centro" % float(st["radius"]))
	var hp0 := mob.hp
	var ally_hp := ally.hp
	for h in mine:
		h["at"] = sim.time - 0.01
	StormSystem.tick(sim, m)
	check(mob.hp < hp0, "storm: meteoro acerta o inimigo (%.0f -> %.0f)" % [hp0, mob.hp])
	check(ally.hp == ally_hp, "storm: aliado dentro do meteoro não leva dano")
	var burn := mob.debuffs.filter(func(d): return d.get("kind") == "dot" and d.get("fire", false) and int(d.get("src", -1)) == e.id)
	check(burn.any(func(d): return d.get("ult", false)), "storm: o meteoro queima e a queimadura é de Suprema (não enche)")
	check(e.ult_charge == 0.0, "storm: o dano da Chuva não enche a carga")
	(m["storms"] as Array).erase(st)
	# tempestade que segue o lançador (anchor caster)
	StormSystem.start(sim, e, s, at, 1.0, {"anchor": "caster", "duration": 5.0, "every": 1.0, "radius": 4.0})
	var fol: Dictionary = StormSystem.storms_of(sim, e)[0]
	e.position += Vector3(0, 0, 5)
	StormSystem.tick(sim, m)
	check((fol["center"] as Vector3).distance_to(Vector3(e.position.x, 0, e.position.z)) < 0.01, "storm: anchor caster segue o lançador")
	e.position.x = -9999.0
	sim._kill(e, mob)
	StormSystem.tick(sim, m)
	check(StormSystem.storms_of(sim, e).is_empty(), "storm: o lançador morreu = a tempestade some")
	sim.despawn(e)
	# Gelo: pulsos em área, lentidão que acumula e congela no 3º (uma vez)
	var g := _ult_char(gd, sim, "elementalist", "gelo", at, "UltGelo")
	var foe := _ult_mob(gd, sim, "golem", at + Vector3(2, 0, 0))
	var ice := {"anchor": "ground", "mode": "pulse", "duration": 8.0, "every": 1.0, "radius": 6.0, "slow_stack": {"step": 15, "max": 45, "duration": 2.0}, "freeze": {"hits": 3, "duration": 2.0}}
	StormSystem.start(sim, g, s, at, 0.9, ice)
	var ist: Dictionary = StormSystem.storms_of(sim, g)[0]
	var bid := _ult_boss_id(gd)
	var boss: SimEntity = _ult_mob(gd, sim, bid, at + Vector3(-2, 0, 0)) if bid != "" else null
	for k in range(2):
		StormSystem._fire(sim, m, g, ist)
	check(foe.state != SimEntity.State.STUNNED, "storm gelo: 2 pulsos não congelam")
	var slow := foe.debuffs.filter(func(d): return d.get("kind") == "slow")
	check(slow.size() == 1 and is_equal_approx(float(slow[0]["pct"]), 30.0), "storm gelo: lentidão acumula 15%% por pulso, uma só (30%%)")
	StormSystem._fire(sim, m, g, ist)
	check(foe.state == SimEntity.State.STUNNED, "storm gelo: o 3º pulso congela")
	if boss != null:
		check(boss.state == SimEntity.State.STUNNED and boss.state_duration <= 2.0 * 0.4 + 0.01, "storm gelo: chefe congela ×0,4 (%.2f s)" % boss.state_duration)
		boss.set_state(SimEntity.State.IDLE)
	foe.set_state(SimEntity.State.IDLE)
	StormSystem._fire(sim, m, g, ist)
	check(foe.state != SimEntity.State.STUNNED and (boss == null or boss.state != SimEntity.State.STUNNED), "storm gelo: congela uma vez só por lançamento")
	slow = foe.debuffs.filter(func(d): return d.get("kind") == "slow")
	check(is_equal_approx(float(slow[0]["pct"]), 45.0), "storm gelo: lentidão para em 45%%")
	(m["storms"] as Array).erase(ist)
	for o in [g, foe, boss, ally, mob]:
		if o != null:
			sim.despawn(o)

## barrage do jogador: círculos na lista própria (bots não fogem), ferem inimigo e nunca aliado.
func _check_ultimate_barrage(gd, sim) -> void:
	var at := Vector3(56, 0, -48)
	var m: Dictionary = sim.maps["city_aldara"]
	var e := _ult_char(gd, sim, "assassin", "corsario", at, "UltCors")
	var ally := _ult_char(gd, sim, "paladin", "guardiao", at + Vector3(4, 0, 0), "UltCorsAliado")
	ally.party_id = 9100
	e.party_id = 9100
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(4, 0, 0.5))
	var s: SkillDef = gd.skills["mob_dragon_meteor"]
	StormSystem.place_barrage(sim, e, s, at + Vector3(4, 0, 0), 1.0, {"barrage": {"count": 3, "radius": 2.0, "delay": 0.4, "spread": 4.0}})
	var mine: Array = (m.get("ally_strikes", []) as Array).filter(func(h): return int(h["owner"]) == e.id)
	check(mine.size() == 3 and (m.get("hazards", []) as Array).filter(func(h): return int(h["owner"]) == e.id).is_empty(), "barrage do jogador: 3 círculos na lista própria, nenhum em hazards")
	var hp_a := ally.hp
	var hp_m := mob.hp
	for h in mine:
		h["at"] = sim.time - 0.01
	StormSystem.tick(sim, m)
	check(mob.hp < hp_m and ally.hp == hp_a, "barrage do jogador: fere o inimigo e não o aliado")
	ally.party_id = -1
	e.party_id = -1
	for o in [e, ally, mob]:
		sim.despawn(o)

## Acha dois pontos andáveis a ~5 m com parede entre eles (para "não salta através de parede").
func _ult_wall_pair(sim, m: Dictionary) -> Array:
	var def: MapDef = m["def"]
	for x in range(-70, 71, 4):
		for z in range(-70, 71, 4):
			var a := Vector3(x, 0, z)
			if not MapGeometry.is_walkable(sim, a, def, 0.5):
				continue
			for k in range(8):
				var b := a + Vector3(cos(k * PI / 4.0), 0, sin(k * PI / 4.0)) * 5.0
				if MapGeometry.is_walkable(sim, b, def, 0.5) and not MapGeometry.line_walkable(sim, m, a, b, 0.9):
					return [a, b]
	return []

## hop_strikes: 7 golpes; um alvo só = 7 nele; intocável com iframe "all"; nunca através de parede; sem alvo acaba; dash corta.
func _check_ultimate_hop(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var pair := _ult_wall_pair(sim, m)
	check(not pair.is_empty(), "hop: achou um muro em Aldara para o teste")
	if pair.is_empty():
		return
	var a: Vector3 = pair[0]
	var e := _ult_char(gd, sim, "berserker", "punhos", a, "UltHop")
	var near := _ult_mob(gd, sim, "golem", a + (a.direction_to(pair[1]).rotated(Vector3.UP, PI)) * 1.6)
	var far := _ult_mob(gd, sim, "golem", pair[1])
	var hits: Array = []
	var cb := func(att: int, tid: int, _amt: int, _c: bool, _b: bool, _k: String): hits.append([att, tid])
	Events.damage_dealt.connect(cb)
	var s: SkillDef = gd.skills["ele_fireball"]
	HopSystem.start(sim, e, s, 1.0, {"count": 7, "every": 0.2, "radius": 8.0, "iframe": "all"})
	check(e.iframe_left > 0.0, "hop: intocável durante a sequência (iframe all)")
	for i in range(10):
		if e.hop.is_empty():
			break
		e.hop["next_at"] = sim.time
		HopSystem.tick(sim, e, m)
	Events.damage_dealt.disconnect(cb)
	var on_near := hits.filter(func(h): return h[0] == e.id and h[1] == near.id).size()
	var on_far := hits.filter(func(h): return h[0] == e.id and h[1] == far.id).size()
	check(on_near == 7 and on_far == 0, "hop: 7 golpes no único alvo alcançável, nenhum através da parede (%d/%d)" % [on_near, on_far])
	check(e.hop.is_empty(), "hop: acabou depois do 7º")
	# dois alvos: alterna
	var other := _ult_mob(gd, sim, "slime", near.position + Vector3(1.5, 0, 0))
	hits.clear()
	Events.damage_dealt.connect(cb)
	HopSystem.start(sim, e, s, 1.0, {"count": 4, "every": 0.2, "radius": 8.0})
	for i in range(6):
		if e.hop.is_empty():
			break
		e.hop["next_at"] = sim.time
		HopSystem.tick(sim, e, m)
	Events.damage_dealt.disconnect(cb)
	var seq: Array = hits.filter(func(h): return h[0] == e.id).map(func(h): return h[1])
	var alternates := seq.size() >= 2
	for i in range(1, seq.size()):
		if seq[i] == seq[i - 1]:
			alternates = false
	check(alternates, "hop: com dois alvos salta entre eles (%s)" % str(seq))
	# sem alvo: acaba na hora; dash corta
	for o in [near, far, other]:
		sim.despawn(o)
	HopSystem.start(sim, e, s, 1.0, {"count": 7, "every": 0.2, "radius": 8.0})
	check(e.hop.is_empty(), "hop: sem inimigo no raio acaba na hora")
	var foe := _ult_mob(gd, sim, "golem", e.position + Vector3(2, 0, 0))
	HopSystem.start(sim, e, s, 1.0, {"count": 7, "every": 0.8, "radius": 8.0})
	var dash := InputCommand.new()
	dash.dash = true
	e.dash_cd = 0.0
	e.set_state(SimEntity.State.IDLE)
	sim._apply_command(e, dash, m, 0.0)
	check(e.hop.is_empty(), "hop: dash corta o resto")
	sim.despawn(foe)
	sim.despawn(e)

## intercept: aliado leva -30%, o protetor leva os 30%; vale o protetor mais perto; protetor não é protegido; para a 25%.
func _check_ultimate_intercept(gd, sim) -> void:
	var at := Vector3(60, 0, -40)
	var p := _ult_char(gd, sim, "paladin", "guardiao", at, "UltProt")
	var a := _ult_char(gd, sim, "bishop", "sacerdote", at + Vector3(3, 0, 0), "UltProtAliado")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 4))
	p.party_id = 9200
	a.party_id = 9200
	for o in [p, a]:
		o.stats.dr_pct = 0.0                  # só a Proteção mexe no número (sem aura/teia de redução)
		o.stats.evasion = 0.0
	InterceptSystem.start(sim, p, {"radius": 8.0, "pct": 30.0, "duration": 8.0, "stop_below": 25.0})
	var hp_a := a.hp
	var hp_p := p.hp
	sim._deal_damage(mob, a, 100, false, false, "physical")
	check(is_equal_approx(hp_a - a.hp, 70.0) and is_equal_approx(hp_p - p.hp, 30.0), "intercept: aliado leva 70 de 100 e o paladino 30 (%.0f / %.0f)" % [hp_a - a.hp, hp_p - p.hp])
	hp_p = p.hp
	sim._deal_damage(mob, p, 100, false, false, "physical")
	check(is_equal_approx(hp_p - p.hp, 100.0), "intercept: quem protege não é protegido")
	var stranger := _ult_char(gd, sim, "bishop", "sacerdote", at + Vector3(-3, 0, 0), "UltProtFora")
	stranger.stats.dr_pct = 0.0
	stranger.stats.evasion = 0.0
	var hp_s := stranger.hp
	sim._deal_damage(mob, stranger, 100, false, false, "physical")
	check(is_equal_approx(hp_s - stranger.hp, 100.0), "intercept: fora do grupo não é protegido")
	# perto de dois protetores: vale o mais perto
	var p2 := _ult_char(gd, sim, "paladin", "guardiao", at + Vector3(4, 0, 0), "UltProt2")
	p2.party_id = 9200
	p2.stats.dr_pct = 0.0
	p2.stats.evasion = 0.0
	InterceptSystem.start(sim, p2, {"radius": 8.0, "pct": 30.0, "duration": 8.0, "stop_below": 25.0})
	hp_p = p.hp
	var hp_p2 := p2.hp
	hp_a = a.hp
	sim._deal_damage(mob, a, 100, false, false, "physical")
	check(is_equal_approx(hp_a - a.hp, 70.0) and is_equal_approx(hp_p2 - p2.hp, 30.0) and p.hp == hp_p, "intercept: duas Proteções não somam, vale a do mais perto")
	sim.despawn(p2)
	# para a 25%
	p.hp = p.stats.max_hp * 0.26
	sim._deal_damage(mob, a, int(p.stats.max_hp * 0.2), false, false, "physical")
	check(not InterceptSystem.active(p), "intercept: protetor abaixo de 25%% encerra a Proteção")
	a.hp = a.stats.max_hp
	hp_a = a.hp
	sim._deal_damage(mob, a, 100, false, false, "physical")
	check(is_equal_approx(hp_a - a.hp, 100.0), "intercept: encerrada, o aliado leva tudo (%.0f, vida %.0f/%.0f)" % [hp_a - a.hp, a.hp, a.stats.max_hp])
	p.party_id = -1
	a.party_id = -1
	for o in [p, a, mob, stranger]:
		sim.despawn(o)

## dot_amp (só do lançador), detonar e espalhar no fim; curse_spread (só as suas); end_cast; oath_lock; ignore_max; pet_revive.
func _check_ultimate_small_keys(gd, sim) -> void:
	var at := Vector3(64, 0, -36)
	var m: Dictionary = sim.maps["city_aldara"]
	var src := _ult_char(gd, sim, "assassin", "laminas", at, "UltAmp")
	var src2 := _ult_char(gd, sim, "assassin", "laminas", at + Vector3(-2, 0, 0), "UltAmp2")
	var t := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 3))
	var t2 := _ult_mob(gd, sim, "golem", at + Vector3(2, 0, 3))
	sim._apply_effects(src, t, {"dot": {"dps": 10, "duration": 6, "skill": "ass_test"}}, 1.0)
	UltEffects.apply_amp(src, t, {"mult": 2.0, "duration": 8.0, "detonate": 1.5, "spread_radius": 4.0})
	check(UltEffects.amp(t, src, 10) == 20 and UltEffects.amp(t, src2, 10) == 10, "dot_amp: os danos no tempo do lançador valem ×2, os de outro não")
	var amp_d: Dictionary = t.debuffs.filter(func(d): return d.get("kind") == Balance.DOT_AMP_KIND)[0]
	var hp0 := t.hp
	UltEffects.amp_end(sim, t, amp_d)
	check(t2.debuffs.any(func(d): return d.get("kind") == "dot" and int(d.get("src", -1)) == src.id), "dot_amp: no fim o dano no tempo é copiado para o vizinho a 4 m")
	check(t.hp < hp0 and not t.debuffs.any(func(d): return d.get("kind") == "dot" and int(d.get("src", -1)) == src.id), "dot_amp: no fim o resto detona de uma vez")
	# curse_spread
	t.debuffs.append({"kind": "curse", "id": "curse_hex_%d" % src.id, "remaining": 6.0, "taken_pct": 10.0, "weaken_pct": 0.0})
	t.debuffs.append({"kind": "curse", "id": "curse_hex_%d" % src2.id, "remaining": 6.0, "taken_pct": 10.0, "weaken_pct": 0.0})
	UltEffects.curse_spread(sim, src, t2, {"radius": 6.0})
	check(t2.debuffs.any(func(d): return d.get("id") == "curse_hex_%d" % src.id) and not t2.debuffs.any(func(d): return d.get("id") == "curse_hex_%d" % src2.id),
		"curse_spread: copia só as SUAS maldições")
	# end_cast: o buff acaba e a skill sai sozinha
	var hp_t := t.hp
	src.position = t.position + Vector3(1.2, 0, 0)
	src.put_buff({"id": "ult_test_end", "remaining": 0.01, "end_cast": "mob_whirl", "end_power": 1.5})
	sim._update_entity(src, m, 0.05)
	check(t.hp < hp_t, "end_cast: o buff acabou e o golpe de fechamento saiu sozinho")
	# oath_lock
	var pal := _ult_char(gd, sim, "paladin", "templario", at + Vector3(4, 0, -3), "UltOath")
	pal.put_buff({"id": "ult_test_oath", "remaining": 5.0, "oath_lock": true})
	sim._update_entity(pal, m, 0.05)
	check(sim.oath_stacks(pal) == ClassTalentSystem.oath_max(pal), "oath_lock: Juramento cheio enquanto o buff dura (%d)" % sim.oath_stacks(pal))
	# ignore_max
	var nec := _ult_char(gd, sim, "necromancer", "invocador", at + Vector3(-4, 0, -3), "UltIgn")
	var army: SkillDef = gd.skills["nec_army"]
	var free := army.duplicate()
	free.effects = army.effects.duplicate(true)
	free.effects["summon"]["ignore_max"] = true
	free.effects["summon"]["count"] = 6
	free.effects["summon"]["max"] = 1
	nec.skill_aim = nec.position + Vector3(0, 0, 2)
	sim._apply_skill(nec, free, m)
	var mine := func(): return m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == nec.id and o.is_alive())
	var n_free: int = mine.call().size()
	check(n_free == 6 and mine.call().all(func(o): return o.free_summon), "ignore_max: 6 invocações fora do limite (max 1)")
	sim._apply_skill(nec, army, m)
	check(mine.call().size() == 6 + int(army.effects["summon"]["count"]), "ignore_max: as de fora não ocupam vaga das normais (%d)" % mine.call().size())
	for o in mine.call():
		sim.despawn(o)
	# pet_revive
	var ran := _ult_char(gd, sim, "ranger", "cacador", at + Vector3(0, 0, -6), "UltPet")
	check(sim.pet_of(ran) == null, "pet_revive: começa sem lince")
	var pet: SimEntity = UltEffects.pet_revive(sim, ran, {"skill": "ran_companion"})
	check(pet != null and sim.pet_of(ran) == pet and pet.hp == pet.stats.max_hp, "pet_revive: sem lince, ele volta com a vida cheia")
	pet.hp = 1.0
	UltEffects.pet_revive(sim, ran, {"skill": "ran_companion"})
	check(pet.hp == pet.stats.max_hp, "pet_revive: vivo, vida cheia")
	sim.despawn(pet)
	for o in [src, src2, t, t2, pal, nec, ran]:
		sim.despawn(o)

## Bots: "boss" solta contra chefe e não contra 1 bicho comum; dois do grupo não soltam a menos de BOT_ULT_STAGGER s;
## "save" com 2 aliados feridos.
func _check_ultimate_bots(gd, sim) -> void:
	var at := Vector3(68, 0, -30)
	var e := _ult_char(gd, sim, "elementalist", "fogo", at, "UltBot")
	var mob := _ult_mob(gd, sim, "slime", at + Vector3(0, 0, 3))
	e.ult_charge = Balance.ULT_MAX
	e.ult_full_at = sim.time
	check(not UltimateSystem.bot_release(sim, e, mob), "bot boss: não solta contra 1 bicho comum")
	var bid := _ult_boss_id(gd)
	var boss: SimEntity = _ult_mob(gd, sim, bid, at + Vector3(0, 0, 4))
	check(UltimateSystem.bot_release(sim, e, boss), "bot boss: solta contra chefe (%s)" % bid)
	var pid := 9300
	sim.parties[pid] = {"id": pid, "leader": e.id, "members": [e.id], "ult_at": sim.time - 1.0}
	e.party_id = pid
	check(not UltimateSystem.bot_release(sim, e, boss), "bot boss: outro do grupo soltou há 1 s = espera (stagger)")
	sim.parties[pid]["ult_at"] = sim.time - Balance.BOT_ULT_STAGGER - 0.1
	check(UltimateSystem.bot_release(sim, e, boss), "bot boss: depois do stagger solta")
	e.party_id = -1
	sim.parties.erase(pid)
	e.ult_charge = Balance.ULT_MAX - 1.0
	check(not UltimateSystem.bot_release(sim, e, boss), "bot: sem a carga cheia não solta")
	# save (regra pura, com uma Suprema de mentira)
	var b := _ult_char(gd, sim, "bishop", "sacerdote", at + Vector3(3, 0, 0), "UltSave")
	var x1 := _ult_char(gd, sim, "berserker", "executor", at + Vector3(4, 0, 0), "UltSave1")
	var x2 := _ult_char(gd, sim, "berserker", "executor", at + Vector3(5, 0, 0), "UltSave2")
	for o in [b, x1, x2]:
		o.party_id = 9301
	check(not UltimateSystem._save_needed(sim, b, sim.maps["city_aldara"], 8.0), "bot save: ninguém ferido = segura")
	x1.hp = x1.stats.max_hp * 0.5
	x2.hp = x2.stats.max_hp * 0.5
	check(UltimateSystem._save_needed(sim, b, sim.maps["city_aldara"], 8.0), "bot save: 2 aliados a 50%% = solta")
	# o BotBrain chama a regra
	e.ult_charge = Balance.ULT_MAX
	var bb := BotBrain.new()
	bb.rng = _seeded_rng()
	var cmd := InputCommand.new()
	cmd = bb._fight(e, sim, sim.maps["city_aldara"], boss, cmd)
	check(cmd.ultimate, "bot: o BotBrain liga cmd.ultimate na luta de chefe com a carga cheia")
	for o in [b, x1, x2, e, mob, boss]:
		o.party_id = -1
		sim.despawn(o)

## Bot não corta a própria Suprema com dash (boss_probe 2026-11-19: Sete Ventos/Lua Rubra perdiam os saltos e a mira do
## Disparo do Fim recomeçava quando a fuga de área ou a aproximação davam dash). Abaixo de BOT_ULT_KEEP_HP % ainda foge.
## Golpe de Suprema no alvo só sai com o alvo no alcance. `--only=ultimate`
func _check_ultimate_bot_commit(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(64, 0, -36)
	var e := _ult_char(gd, sim, "berserker", "punhos", at, "UltCommit")
	e.equipment[ItemDef.Slot.WEAPON] = gd.items["claw_t5"]
	e.equipment[ItemDef.Slot.OFFHAND] = gd.items["claw_t5"]
	e.recompute_stats()
	e.hp = e.stats.max_hp
	var boss: SimEntity = _ult_mob(gd, sim, _ult_boss_id(gd), at + Vector3(0, 0, 2.5))
	var hz := {"pos": e.position, "radius": 4.0, "at": sim.time + 1.0}
	(m.get_or_add("hazards", []) as Array).append(hz)
	var dashes := func(n: int) -> int:
		var bb := BotBrain.new()
		bb.rng = _seeded_rng()
		var k := 0
		for i in range(n):
			e.dash_cd = 0.0
			var c: InputCommand = bb._fight(e, sim, m, boss, InputCommand.new())
			k += 1 if c.dash else 0
		return k
	var free: int = dashes.call(20)
	check(free > 0, "bot: área de perigo em cima sem Suprema = foge com dash (%d/20; controle do teste)" % free)
	e.hop = {"skill": "ber_ult_seven_winds", "left": 4}
	var hop_n: int = dashes.call(20)
	check(hop_n == 0, "bot: com os saltos da Suprema em andamento não dá dash (cortaria o resto) (%d/20)" % hop_n)
	e.hp = e.stats.max_hp * (Balance.BOT_ULT_KEEP_HP - 10.0) / 100.0
	var low_n: int = dashes.call(20)
	check(low_n > 0, "bot: com a vida abaixo de BOT_ULT_KEEP_HP foge mesmo nos saltos (%d/20)" % low_n)
	e.hp = e.stats.max_hp
	e.hop = {}
	var ult: SkillDef = gd.skills["ran_ult_end_shot"]
	e.current_skill = ult
	e.skill_phase = "startup"
	e.set_state(SimEntity.State.CASTING, ult.startup)
	check(BotBrain.ult_committed(e), "bot: Suprema no preparo (mira do Disparo do Fim) conta como em andamento")
	var aim_n: int = dashes.call(20)
	check(aim_n == 0, "bot: mirando a própria Suprema não dá dash (%d/20)" % aim_n)
	e.skill_phase = "recovery"
	check(not BotBrain.ult_committed(e), "bot: na recuperação da Suprema o dash volta a valer")
	e.current_skill = null
	e.set_state(SimEntity.State.IDLE, 0.0)
	m["hazards"].erase(hz)
	# golpe no alvo (Sete Ventos, alcance 8): o bot só solta com o chefe no alcance
	e.ult_charge = Balance.ULT_MAX
	e.ult_full_at = sim.time
	var s7 := UltimateSystem.ultimate_of(sim, e)
	check(s7 != null and s7.id == "ber_ult_seven_winds", "bot: Punhos com garras tem Sete Ventos (%s)" % (s7.id if s7 else "nada"))
	if s7 != null:
		check(UltimateSystem.bot_release(sim, e, boss), "bot: Sete Ventos sai com o chefe a 2,5 m")
		boss.position = at + Vector3(0, 0, s7.range + boss.radius + 4.0)
		check(not UltimateSystem.bot_release(sim, e, boss), "bot: Sete Ventos espera com o chefe fora do alcance (%.0f m)" % s7.range)
	for o in [e, boss]:
		sim.despawn(o)

## HUD da Suprema: moldura do R à esquerda do 1, maior que as vagas; mostra a Suprema da build, cheia diz PRONTA, travada
## diz o motivo; som ult_ready no banco; tecla R no InputMap. `--only=ultimate`
func _check_ultimate_hud(gd, sim) -> void:
	var bar := ActionBar.new()
	bar.build()
	check(bar.ult != null and bar.ult.custom_minimum_size.x > ActionBar.SKILL_PX, "HUD R: moldura própria, maior que as vagas")
	var row: Control = bar.ult.get_parent()
	check(row.get_children().find(bar.ult) < row.get_children().find(bar.skill_slots[0]["root"]), "HUD R: à esquerda da vaga 1")
	var e := _ult_char(gd, sim, "elementalist", "fogo", Vector3(72, 0, -24), "UltHud")
	bar.update_ult(e)
	check(not bar.ult.locked and bar.ult.skill != null and bar.ult.skill.id == "ele_ult_meteor_rain", "HUD R: liberada mostra a Suprema da build")
	e.ult_charge = Balance.ULT_MAX
	bar.update_ult(e)
	check(bar.ult.frac == 1.0 and bar.ult.tooltip_text.contains("PRONTA"), "HUD R: cheia = anel completo e PRONTA na dica")
	e.ult_gap_until = sim.time + 5.0
	bar.update_ult(e)
	check(bar.ult.gap > 0.0 and bar.ult.tooltip_text.contains("Recarregando"), "HUD R: na trava mostra os segundos")
	e.level = 39
	UltimateSystem.refresh(sim, e)
	bar.update_ult(e)
	check(bar.ult.locked and bar.ult.tooltip_text.contains("Nível %d e Ascensão" % Balance.ULT_LEVEL), "HUD R: travada mostra o cadeado e o motivo")
	check(Sfx.VOL.has("ult_ready") and ResourceLoader.exists("res://assets/audio/sfx/ult_ready_1.wav"), "HUD R: som ult_ready no banco (build_sfx --only=ult_ready)")
	check(InputMap.has_action("ultimate") and InputMap.action_get_events("ultimate").any(func(ev): return ev is InputEventKey and ev.physical_keycode == KEY_R), "HUD R: ação ultimate na tecla R")
	bar.free()
	sim.despawn(e)

## Cérebro de teste: todo pensamento pede a Suprema (o comando repetido entre pensamentos não pode repetir o R).
class UltAskBrain:
	extends RefCounted
	func think(_e, _sim, _m, _dt) -> InputCommand:
		var c := InputCommand.new()
		c.ultimate = true
		return c

## Revisão da onda A (2026-11-19): golpe que não pegou não enche; Proteção nunca suicida; salto sem chão não bate;
## R desmonta; tempestade some quando o dono troca de mapa; bots: elite conta, SELF exige o alvo na área, segurar contra
## lixo, regra "self"; comando repetido do bot não repete o R; poção (ItemSystem) não enche; boneco com o tique de verdade.
func _check_ultimate_review(gd, sim) -> void:
	var at := Vector3(76, 0, -20)
	var m: Dictionary = sim.maps["city_aldara"]
	# 7) esquiva/intocável: não enche nem quem bate nem quem apanha
	var e := _ult_char(gd, sim, "berserker", "executor", at, "UltRev")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 2))
	mob.iframe_left = 1.0
	sim._strike(e, mob, gd.skills["ber_execute"] if gd.skills.has("ber_execute") else gd.skills["ele_fireball"], 2.0, SkillDef.Kind.PHYSICAL, e.position)
	check(e.ult_charge == 0.0, "golpe no intocável (dash) não enche a carga")
	mob.iframe_left = 0.0
	e.stats.evasion = 100.0
	var landed: bool = sim._deal_damage(mob, e, 50, false, false, "physical")
	check(not landed and e.ult_charge == 0.0, "golpe esquivado não enche a carga de quem esquivou (on_taken depois da esquiva)")
	landed = sim._deal_damage(mob, mob, 5, false, false, "physical")
	check(landed, "_deal_damage devolve true quando pega")
	e.stats.evasion = 0.0
	# 16) R desmonta
	e.ult_charge = Balance.ULT_MAX
	var ele := _ult_char(gd, sim, "elementalist", "fogo", at + Vector3(3, 0, 0), "UltRevMont")
	ele.ult_charge = Balance.ULT_MAX
	ele.mounted = true
	var r := InputCommand.new()
	r.ultimate = true
	r.aim = mob.position
	sim._apply_command(ele, r, m, 0.0)
	check(not ele.mounted and ele.state == SimEntity.State.CASTING and ele.current_skill.ultimate, "R a cavalo: desmonta e a Suprema começa")
	ele.set_state(SimEntity.State.IDLE)
	ele.current_skill = null
	# 16) tempestade some quando o dono troca de mapa
	StormSystem.start(sim, ele, gd.skills["ele_ult_meteor_rain"], at, 1.0, {"anchor": "ground", "duration": 9.0, "every": 1.0, "radius": 4.0})
	var other := ""
	for mid in sim.maps:
		if mid != "city_aldara":
			other = mid
			break
	PortalSystem.change_map(sim, ele, other, Vector3.ZERO)
	StormSystem.tick(sim, m)
	check((m.get("storms", []) as Array).filter(func(st): return int(st["owner"]) == ele.id).is_empty(), "tempestade some quando o dono troca de mapa")
	sim.despawn(ele)
	# 3/4) bots: Suprema em volta de si exige o alvo na área; elite conta como alvo grande
	var b := _ult_char(gd, sim, "elementalist", "fogo", at + Vector3(0, 0, -6), "UltRevBot")
	b.ult_charge = Balance.ULT_MAX
	b.ult_full_at = sim.time
	var bid := _ult_boss_id(gd)
	var far_boss: SimEntity = _ult_mob(gd, sim, bid, b.position + Vector3(20, 0, 0))
	check(not UltimateSystem.bot_release(sim, b, far_boss), "bot: Suprema em volta de si não sai com o chefe a 20 m")
	far_boss.position = b.position + Vector3(3, 0, 0)
	check(UltimateSystem.bot_release(sim, b, far_boss), "bot: com o chefe dentro da área sai")
	var elite: SimEntity = sim.spawn_monster(sim.elite_def(gd.monsters["slime"]), "city_aldara", b.position + Vector3(2, 0, 1))
	elite.brain = null
	check(elite.monster_def.elite_of != "" and UltimateSystem.bot_release(sim, b, elite), "bot: elite (Rei) conta como alvo grande")
	sim.despawn(elite)
	sim.despawn(far_boss)
	# 16) segurar contra lixo no grupo do jogador; depois de BOT_ULT_HOLD solta em bando
	var trash: Array = []
	for i in range(3):
		trash.append(_ult_mob(gd, sim, "slime", b.position + Vector3(float(i) - 1.0, 0, 2.0)))
	var keep_pid: int = sim.player.party_id
	sim.player.party_id = 9400
	b.party_id = 9400
	check(not UltimateSystem.bot_release(sim, b, trash[0]), "bot do grupo do jogador segura contra lixo (BOT_ULT_HOLD)")
	b.ult_full_at = sim.time - Balance.BOT_ULT_HOLD - 1.0
	check(UltimateSystem.bot_release(sim, b, trash[0]), "bot do grupo do jogador: depois de BOT_ULT_HOLD s solta no bando")
	sim.player.party_id = keep_pid
	b.party_id = -1
	# 16) regra "self" (cercado ou vida baixa), com a Suprema do Fogo emprestando a regra
	var mr: SkillDef = gd.skills["ele_ult_meteor_rain"]
	var keep_rule := mr.ult_bot
	mr.ult_bot = "self"
	check(UltimateSystem.bot_release(sim, b, trash[0]), "bot self: 3 inimigos em cima = solta")
	for o in trash:
		sim.despawn(o)
	var lone := _ult_mob(gd, sim, "slime", b.position + Vector3(0, 0, 3))
	b.hp = b.stats.max_hp
	check(not UltimateSystem.bot_release(sim, b, lone), "bot self: 1 inimigo e vida cheia = segura")
	b.hp = b.stats.max_hp * (Balance.BOT_ULT_SELF_HP - 5.0) / 100.0
	check(UltimateSystem.bot_release(sim, b, lone), "bot self: vida baixa = solta")
	mr.ult_bot = keep_rule
	sim.despawn(lone)
	# 15) comando repetido do bot (entre pensamentos) não repete o R
	b.brain = UltAskBrain.new()
	b.ult_charge = 0.0
	var seen_think := false
	var seen_repeat := false
	for i in range(6):
		sim.tick(1.0 / 60.0)
		if b.last_cmd == b.repeat_cmd and b.repeat_cmd != null:
			seen_repeat = true
			check(not b.last_cmd.ultimate, "bot: comando repetido entre pensamentos não leva o R")
		elif b.last_cmd != null and b.last_cmd.ultimate:
			seen_think = true
	check(seen_think and seen_repeat, "bot: viu um pensamento com R e um tique repetido")
	b.brain = null
	sim.despawn(b)
	# 14) poção de verdade (ItemSystem.use_potion) em combate não enche
	var pid := ""
	for iid in gd.items:
		var it: ItemDef = gd.items[iid]
		if it.consume.has("heal") or it.consume.has("heal_pct"):
			pid = iid
			break
	e.combat_timer = 5.0
	e.hp = e.stats.max_hp * 0.4
	e.ult_charge = 0.0
	e.inventory[pid] = 3
	e.potion_slots[0] = pid
	e.potion_cds[0] = 0.0
	var hp0 := e.hp
	ItemSystem.use_potion(sim, e, 0)
	check(e.hp > hp0 and e.ult_charge == 0.0, "poção (%s) cura e não enche a carga" % pid)
	sim.despawn(e)
	sim.despawn(mob)
	# 5) Proteção nunca suicida: a parte redirecionada para no limite
	var p := _ult_char(gd, sim, "paladin", "guardiao", at + Vector3(6, 0, 0), "UltRevProt")
	var a := _ult_char(gd, sim, "bishop", "sacerdote", at + Vector3(8, 0, 0), "UltRevProtA")
	var foe := _ult_mob(gd, sim, "golem", at + Vector3(7, 0, 3))
	p.party_id = 9401
	a.party_id = 9401
	for o in [p, a]:
		o.stats.dr_pct = 0.0
		o.stats.evasion = 0.0
	InterceptSystem.start(sim, p, {"radius": 8.0, "pct": 30.0, "duration": 8.0, "stop_below": 25.0})
	p.hp = p.stats.max_hp * 0.27
	sim._deal_damage(foe, a, int(p.stats.max_hp * 2.0), false, false, "physical")
	check(p.is_alive() and p.hp >= p.stats.max_hp * 0.25 - 1.0, "Proteção não suicida: o protetor fica no limite (%.0f%% da vida)" % (100.0 * p.hp / p.stats.max_hp))
	check(not InterceptSystem.active(p), "Proteção: chegou ao limite e acabou")
	for o in [p, a]:
		o.party_id = -1
		sim.despawn(o)
	sim.despawn(foe)
	# 6) salto sem chão andável ao lado do alvo: não salta (nem bate de longe)
	var pair := _ult_wall_pair(sim, m)
	if not pair.is_empty():
		var pa: Vector3 = pair[0]
		var pb: Vector3 = pair[1]
		var dir := (pb - pa).normalized()
		var edge := pa
		var k := 0.0
		while k < 5.0 and MapGeometry.is_walkable(sim, pa + dir * (k + 0.1), m["def"], 0.45):
			k += 0.1
			edge = pa + dir * k
		var hopper := _ult_char(gd, sim, "berserker", "punhos", pb, "UltRevHop")
		var tgt := _ult_mob(gd, sim, "golem", edge)
		var from := hopper.position
		var jumped: bool = HopSystem._jump(sim, hopper, tgt, m, gd.skills["ele_fireball"])
		check(not jumped and hopper.position == from, "hop: sem chão andável ao lado do alvo não salta")
		sim.despawn(hopper)
		sim.despawn(tgt)
	# 13) boneco com o tique de verdade: bater enche, ir embora esvazia
	var dd: SimEntity = sim.spawn_monster(gd.monsters["training_dummy"], "city_aldara", at + Vector3(0, 0, 8))
	var t := _ult_char(gd, sim, "berserker", "executor", dd.position + Vector3(0, 0, -1.6), "UltRevBoneco")
	t.kind = SimEntity.Kind.PLAYER
	var hit := InputCommand.new()
	hit.attack = true
	hit.aim = dd.position
	var dt := 1.0 / 60.0
	for i in range(600):
		sim.time += dt
		sim.tick_count += 1
		sim._apply_command(t, hit, m, dt)
		sim._update_entity(t, m, dt)
		sim._update_entity(dd, m, dt)
	var after_fight := t.ult_charge
	check(after_fight > Balance.ULT_TRICKLE * 10.0 + 5.0, "boneco (tique de verdade): 10 s batendo enchem %.1f pts" % after_fight)
	var idle := InputCommand.new()
	idle.aim = dd.position
	for i in range(int(19.0 / dt)):
		sim.time += dt
		sim.tick_count += 1
		sim._apply_command(t, idle, m, dt)
		sim._update_entity(t, m, dt)
	check(t.ult_charge == 0.0, "boneco: 19 s depois de ir embora não sobra carga (%.1f)" % t.ult_charge)
	t.kind = SimEntity.Kind.BOT
	sim.despawn(t)
	sim.despawn(dd)

# =============================================================================================
# Supremas da onda B1 (GDD ultimates-lv40 §3.5 1-12): Paladino, Berserker, Bispo, Druida. `--only=ultimate`
# =============================================================================================

const ULT_B1 := {"paladin": {"guardiao": "pal_ult_dawn_bastion", "cruzado": "pal_ult_dawn_judgement", "templario": "pal_ult_hammer_sky"},
	"berserker": {"carniceiro": "ber_ult_blood_feast", "executor": "ber_ult_headsman_verdict", "punhos": "ber_ult_seven_winds"},
	"bishop": {"sacerdote": "bis_ult_grace_dome", "inquisidor": "bis_ult_judgement_sun", "batalha": "bis_ult_faith_avatar"},
	"druid": {"guardiao_verde": "dru_ult_primal_colossus", "fera": "dru_ult_blood_moon", "xama": "dru_ult_elder_heart"}}

var _b1_spot := Vector3.INF

## Centro de uma área aberta de Aldara (tudo andável num raio de 13 m): os saltos e as invocações não esbarram em casa.
func _ult_open(sim) -> Vector3:
	if _b1_spot != Vector3.INF:
		return _b1_spot
	var m: Dictionary = sim.maps["city_aldara"]
	var def: MapDef = m["def"]
	for x in range(-90, 91, 6):
		for z in range(-90, 91, 6):
			var c := Vector3(x, 0, z)
			var ok := true
			for k in range(16):
				for r in [3.0, 6.0, 9.0, 13.0]:
					if ok and not MapGeometry.is_walkable(sim, c + Vector3(cos(k * PI / 8.0), 0, sin(k * PI / 8.0)) * r, def, 0.6):
						ok = false
			if ok and MapGeometry.is_walkable(sim, c, def, 0.6):
				_b1_spot = c
				return c
	_b1_spot = Vector3(52, 0, -60)
	return _b1_spot

## Roda a skill em andamento de `e` até acabar (passos de 1/60 s; também move os saltos da sequência).
func _ult_run(sim, e: SimEntity, m: Dictionary, secs: float) -> void:
	for i in range(int(secs * 60.0)):
		sim._update_entity(e, m, 1.0 / 60.0)

## Catálogo B1: as 12 na build certa, uma por build, ult_bot pedido pelo GDD, números de ULT_NUMBERS e ícone.
func _check_ultimate_b1_catalog(gd, sim) -> void:
	var want_bot := {"pal_ult_dawn_bastion": "save", "pal_ult_dawn_judgement": "boss", "pal_ult_hammer_sky": "boss", "ber_ult_blood_feast": "boss",
		"ber_ult_headsman_verdict": "boss", "ber_ult_seven_winds": "boss", "bis_ult_grace_dome": "save", "bis_ult_judgement_sun": "boss",
		"bis_ult_faith_avatar": "self", "dru_ult_primal_colossus": "self", "dru_ult_blood_moon": "boss", "dru_ult_elder_heart": "boss"}
	for cid in ULT_B1:
		for bid in ULT_B1[cid]:
			var sid: String = ULT_B1[cid][bid]
			var s: SkillDef = gd.skills.get(sid)
			check(s != null and s.ultimate and s.class_id == cid and s.build == bid, "suprema B1 %s: existe, é Suprema da build %s/%s" % [sid, cid, bid])
			if s == null:
				continue
			check(gd.ultimates.get(cid, {}).get(bid, "") == sid, "suprema B1 %s: GameData.ultimates[%s][%s]" % [sid, cid, bid])
			check(s.ult_bot == want_bot[sid], "suprema B1 %s: ult_bot %s (%s)" % [sid, want_bot[sid], s.ult_bot])
			check(Balance.ULT_NUMBERS.has(sid) and s.startup <= 0.3 + 0.001, "suprema B1 %s: números em ULT_NUMBERS e startup <= 0,3 s" % sid)
	var h: SkillDef = gd.skills.get("ber_ult_blood_feast_end")
	check(h != null and not h.ultimate and h.class_id == "" and not gd.classes["berserker"].skill_ids.has("ber_ult_blood_feast_end"),
		"Festim: a Sangria de fechamento é skill de apoio (sem classe: fora da teia, da barra e do livro)")
	var fe: SkillDef = gd.skills["ber_ult_blood_feast"]
	check(str(fe.effects["buff"].get("end_cast", "")) == "ber_ult_blood_feast_end", "Festim: o buff fecha com a Sangria (end_cast)")
	for sid in ["intercept", "hammer_sky", "blood_feast", "faith_avatar", "primal_colossus"]:
		check(BuffLooks.LOOKS.has(sid), "suprema B1: buff %s tem visual no boneco (BuffLooks)" % sid)

## Paladino: Bastião (provoca, escudo, Juramento, Proteção), Juízo (salto uma vez, 3 golpes, último atordoa), Céu (martelos, marca, Juramento preso).
func _check_ultimate_b1_paladin(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	# Bastião da Aurora
	var p := _ult_char(gd, sim, "paladin", "guardiao", at, "B1Bastiao")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 4))
	var s: SkillDef = gd.skills["pal_ult_dawn_bastion"]
	var n: Dictionary = Balance.ULT_NUMBERS["pal_ult_dawn_bastion"]
	p.shield_hp = 0.0
	sim._apply_skill(p, s, m)
	check(mob.aggro_target == p.id and mob.taunt_left > 0.0, "Bastião: provoca o inimigo a %d m" % int(n["radius"]))
	check(absf(p.shield_hp - p.stats.max_hp * float(n["shield_pct"]) / 100.0) < 2.0, "Bastião: escudo de %d%% da vida (%.0f)" % [int(n["shield_pct"]), p.shield_hp])
	check(sim.oath_stacks(p) == ClassTalentSystem.oath_max(p), "Bastião: Juramento cheio (%d)" % sim.oath_stacks(p))
	check(InterceptSystem.active(p), "Bastião: Proteção ligada (intercept)")
	sim.despawn(p)
	sim.despawn(mob)
	# Juízo da Alvorada
	var c := _ult_char(gd, sim, "paladin", "cruzado", at, "B1Juizo")
	var aim := at + Vector3(0, 0, 6)
	var foe := _ult_mob(gd, sim, "golem", aim + Vector3(0, 0, 0.8))
	var js: SkillDef = gd.skills["pal_ult_dawn_judgement"]
	var hits: Array = []
	var cb := func(att: int, tid: int, _amt: int, _c: bool, _b: bool, _k: String): hits.append([att, tid])
	Events.damage_dealt.connect(cb)
	c.face_towards(aim)
	sim._start_skill(c, js, Balance.ULT_CAST_SLOT, aim)
	var after_leap := Vector3.INF
	var iframe_seen := false
	for i in range(120):
		sim._update_entity(c, m, 1.0 / 60.0)
		if c.channel_done >= 1 and after_leap == Vector3.INF and c.skill_applied:
			after_leap = c.position
			iframe_seen = c.iframe_left > 0.0
		if c.state != SimEntity.State.CASTING:
			break
	Events.damage_dealt.disconnect(cb)
	var on_foe := hits.filter(func(hh): return hh[0] == c.id and hh[1] == foe.id).size()
	check(after_leap != Vector3.INF and after_leap.distance_to(at) > 4.0, "Juízo: salta até o cursor (%.1f m)" % (after_leap.distance_to(at) if after_leap != Vector3.INF else -1.0))
	check(iframe_seen, "Juízo: intocável no salto")
	check(after_leap != Vector3.INF and c.position.distance_to(after_leap) < 0.3, "Juízo: o salto sai só no 1º golpe (não anda nos outros dois)")
	check(on_foe == 3, "Juízo: 3 golpes no alvo (%d)" % on_foe)
	check(foe.state == SimEntity.State.STUNNED, "Juízo: o golpe final atordoa")
	sim.despawn(c)
	sim.despawn(foe)
	# só o último golpe atordoa (o 1º não)
	var c2 := _ult_char(gd, sim, "paladin", "cruzado", at, "B1Juizo2")
	var foe2 := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 2))
	c2.skill_aim = foe2.position
	c2.channel_done = 1
	sim._apply_skill(c2, js, m)
	check(foe2.state != SimEntity.State.STUNNED, "Juízo: o 1º golpe não atordoa")
	sim.despawn(c2)
	sim.despawn(foe2)
	# Céu de Martelos
	var t := _ult_char(gd, sim, "paladin", "templario", at, "B1Ceu")
	var near := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 3))
	var ks: SkillDef = gd.skills["pal_ult_hammer_sky"]
	sim._apply_skill(t, ks, m)
	var hp0 := near.hp
	for i in range(int(2.0 / Balance.AURA_TICK)):
		AuraSystem.tick(sim, m, Balance.AURA_TICK)
	sim._update_entity(t, m, 1.0 / 60.0)
	check(t.buffs.any(func(b): return b.get("id") == "hammer_sky" and b.get("oath_lock", false) and b.get("orbit") is Dictionary), "Céu: buff dos martelos com o Juramento preso")
	check(sim.oath_stacks(t) == ClassTalentSystem.oath_max(t), "Céu: Juramento cheio enquanto os martelos giram")
	check(near.debuffs.any(func(d): return str(d.get("id", "")).begins_with("curse_penance")), "Céu: quem é atingido recebe a Marca da Penitência")
	var ob: Dictionary = t.buffs.filter(func(b): return b.get("id") == "hammer_sky")[0]["orbit"]
	check(is_equal_approx(float(ob["radius"]), float(Balance.ULT_NUMBERS["pal_ult_hammer_sky"]["radius"])), "Céu: martelos a %d m" % int(ob["radius"]))
	check(near.hp < hp0, "Céu: os martelos batem no inimigo perto")
	sim.despawn(t)
	sim.despawn(near)

## Berserker: Festim (feridas presas, Sangria no fim), Veredito (rachadura em volta, consome, execução), Sete Ventos (7 golpes, Fúria cheia).
func _check_ultimate_b1_berserker(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	# Festim de Sangue
	var b := _ult_char(gd, sim, "berserker", "carniceiro", at, "B1Festim")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 1.6))
	var aspd0: float = b.stats.attack_speed
	sim._apply_skill(b, gd.skills["ber_ult_blood_feast"], m)
	check(b.stats.attack_speed > aspd0 and b.stats.lifesteal >= 10.0, "Festim: +velocidade de ataque e roubo de vida")
	sim._deal_damage(b, mob, 50, false, false, "physical")
	var wound := mob.debuffs.filter(func(d): return WoundSystem.is_wound(d, b))
	check(not wound.is_empty(), "Festim: golpe físico abre ferida")
	var rem0: float = float(wound[0]["remaining"]) if not wound.is_empty() else 0.0
	for i in range(int(6.0 * 60.0)):
		sim._update_entity(b, m, 1.0 / 60.0)
		sim._update_entity(mob, m, 1.0 / 60.0)
	wound = mob.debuffs.filter(func(d): return WoundSystem.is_wound(d, b))
	check(not wound.is_empty() and float(wound[0]["remaining"]) >= rem0 - 0.05, "Festim: a ferida não fecha enquanto dura (%.2f s depois de 6 s; antes %.2f)" % [float(wound[0]["remaining"]) if not wound.is_empty() else -1.0, rem0])
	b.hp = b.stats.max_hp * 0.5
	var hpb := b.hp
	var hpm := mob.hp
	for x in b.buffs:
		if x.get("id") == "blood_feast":
			x["remaining"] = 0.01
	sim._update_entity(b, m, 1.0 / 60.0)
	var fea: Dictionary = Balance.ULT_NUMBERS["ber_ult_blood_feast"]
	check(mob.hp < hpm, "Festim: no fim a Sangria gigante sai sozinha e acerta")
	check(b.hp - hpb >= b.stats.max_hp * float(fea["end_heal_pct"]) / 100.0 * 0.95, "Festim: a Sangria cura %d%% por inimigo que sangrava (%.0f)" % [int(fea["end_heal_pct"]), b.hp - hpb])
	sim.despawn(b)
	sim.despawn(mob)
	# Veredito do Carrasco
	var x := _ult_char(gd, sim, "berserker", "executor", at, "B1Veredito")
	var tgt := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 5))
	var nb := _ult_mob(gd, sim, "golem", tgt.position + Vector3(2, 0, 0))
	var far := _ult_mob(gd, sim, "golem", tgt.position + Vector3(-7, 0, 0))
	var vs: SkillDef = gd.skills["ber_ult_headsman_verdict"]
	x.face_towards(tgt.position)
	x.skill_aim = tgt.position
	var hp_t := tgt.hp
	sim._apply_skill(x, vs, m)
	check(x.position.distance_to(tgt.position) < 2.0, "Veredito: salta no alvo (%.1f m)" % x.position.distance_to(tgt.position))
	check(SunderSystem.stacks(nb) == 5 and SunderSystem.stacks(far) == 0, "Veredito: vizinho a 2 m com 5 cargas, o de 7 m sem (%d/%d)" % [SunderSystem.stacks(nb), SunderSystem.stacks(far)])
	check(SunderSystem.stacks(tgt) == 0 and tgt.hp < hp_t, "Veredito: o golpe consome a rachadura do alvo")
	var vn: Dictionary = Balance.ULT_NUMBERS["ber_ult_headsman_verdict"]
	var ex: Dictionary = vs.effects["ult_execute"]
	tgt.hp = tgt.stats.max_hp * 0.2
	check(is_equal_approx(UltEffects.execute_mult(tgt, ex), float(vn["exec_mult"])), "Veredito: abaixo de %d%% vale x%.1f" % [roundi(float(vn["below"]) * 100.0), float(vn["exec_mult"])])
	tgt.hp = tgt.stats.max_hp * 0.5
	check(is_equal_approx(UltEffects.execute_mult(tgt, ex), 1.0), "Veredito: acima do limiar x1")
	var bid := _ult_boss_id(gd)
	if bid != "":
		var boss := _ult_mob(gd, sim, bid, at + Vector3(6, 0, 6))
		boss.hp = boss.stats.max_hp * 0.2
		check(not boss.monster_def.is_boss or is_equal_approx(UltEffects.execute_mult(boss, ex), float(vn["boss_mult"])), "Veredito: chefe abaixo do limiar x%.2f" % float(vn["boss_mult"]))
		sim.despawn(boss)
	for o in [x, tgt, nb, far]:
		sim.despawn(o)
	# Sete Ventos
	var f := _ult_char(gd, sim, "berserker", "punhos", at, "B1Ventos")
	var one := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 3))
	var hits: Array = []
	var cb := func(att: int, tid: int, _amt: int, _c: bool, _b: bool, _k: String): hits.append([att, tid])
	Events.damage_dealt.connect(cb)
	f.skill_aim = one.position
	sim._apply_skill(f, gd.skills["ber_ult_seven_winds"], m)
	check(f.iframe_left > 0.0, "Sete Ventos: intocável durante")
	for i in range(12):
		if f.hop.is_empty():
			break
		f.hop["next_at"] = sim.time
		HopSystem.tick(sim, f, m)
	Events.damage_dealt.disconnect(cb)
	var n7 := hits.filter(func(hh): return hh[0] == f.id and hh[1] == one.id).size()
	check(n7 == int(Balance.ULT_NUMBERS["ber_ult_seven_winds"]["count"]), "Sete Ventos: um alvo só leva os %d golpes (%d)" % [int(Balance.ULT_NUMBERS["ber_ult_seven_winds"]["count"]), n7])
	check(f.buff_stacks(Balance.FIST_FURY_BUFF) == Balance.FIST_FURY_MAX, "Sete Ventos: termina com a Fúria do Punho cheia (%d)" % f.buff_stacks(Balance.FIST_FURY_BUFF))
	# com lacaios em volta: salta entre eles, mas o último golpe volta no alvo mirado (termina ao lado do chefe, não de um lacaio)
	var add1 := _ult_mob(gd, sim, "golem", one.position + Vector3(2.5, 0, 0))
	var add2 := _ult_mob(gd, sim, "golem", one.position + Vector3(-2.5, 0, 0))
	hits.clear()
	Events.damage_dealt.connect(cb)
	f.skill_aim = one.position
	sim._apply_skill(f, gd.skills["ber_ult_seven_winds"], m)
	for i in range(12):
		if f.hop.is_empty():
			break
		f.hop["next_at"] = sim.time
		HopSystem.tick(sim, f, m)
	Events.damage_dealt.disconnect(cb)
	var seq: Array = hits.filter(func(hh): return hh[0] == f.id).map(func(hh): return hh[1])
	check(seq.size() == 7 and seq[seq.size() - 1] == one.id and (seq.has(add1.id) or seq.has(add2.id)), "Sete Ventos: salta pelos lacaios e o último golpe volta no alvo mirado (%s)" % str(seq))
	sim.despawn(add1)
	sim.despawn(add2)
	sim.despawn(f)
	sim.despawn(one)

## Bispo: Cúpula (parada, -50%, cura, não soma com a Barreira), Sol (atordoa, chão que cura o mais ferido), Avatar (cura, buff, dano físico cura, escala).
func _check_ultimate_b1_bishop(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var b := _ult_char(gd, sim, "bishop", "sacerdote", at, "B1Cupula")
	var ally := _ult_char(gd, sim, "berserker", "executor", at + Vector3(0, 0, 4), "B1CupulaAliado")
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(3, 0, 4))
	b.party_id = 9400
	ally.party_id = 9400
	ally.stats.dr_pct = 0.0
	ally.stats.evasion = 0.0
	ally.hp = ally.stats.max_hp * 0.5
	var hp_a := ally.hp
	b.skill_aim = ally.position
	sim._apply_skill(b, gd.skills["bis_ult_grace_dome"], m)
	var domes: Array = (m.get("barriers", []) as Array).filter(func(x): return int(x["owner"]) == b.id and x.get("dome", false))
	check(domes.size() == 1 and is_equal_approx(float(domes[0]["dr"]), 50.0), "Cúpula: ergue a cúpula de 50%%")
	check(ally.hp > hp_a, "Cúpula: cura quem está dentro ao erguer")
	var hp1 := ally.hp
	sim._deal_damage(mob, ally, 100, false, false, "physical")
	check(is_equal_approx(hp1 - ally.hp, 50.0), "Cúpula: aliado dentro leva -50%% (%.0f de 100)" % (hp1 - ally.hp))
	b.position += Vector3(6, 0, 0)
	ChoirSystem.tick(sim, m, 0.5)
	check(domes.size() == 1 and (domes[0]["pos"] as Vector3).distance_to(Vector3(ally.position.x, 0, ally.position.z)) < 0.01, "Cúpula: fica parada quando o Bispo anda")
	# Barreira Sagrada de outro Bispo em cima: vale a maior, não somam
	var b2 := _ult_char(gd, sim, "bishop", "sacerdote", at + Vector3(0, 0, 3), "B1CupulaBarreira")
	b2.party_id = 9400
	ChoirSystem.place_barrier(sim, b2, gd.skills["bis_choir_barrier"], ally.position, m)
	var hp2 := ally.hp
	sim._deal_damage(mob, ally, 100, false, false, "physical")
	check(is_equal_approx(hp2 - ally.hp, 50.0), "Cúpula + Barreira Sagrada: vale a maior, não somam (%.0f de 100)" % (hp2 - ally.hp))
	b.position -= Vector3(6, 0, 0)
	sim._apply_skill(b, gd.skills["bis_ult_grace_dome"], m)
	check((m.get("barriers", []) as Array).filter(func(x): return int(x["owner"]) == b2.id and not x.get("dome", false)).size() == 1, "Cúpula: a Barreira de quem já tinha fica")
	for x in (m.get("barriers", []) as Array).duplicate():
		if int(x["owner"]) in [b.id, b2.id]:
			m["barriers"].erase(x)
	sim.despawn(b2)
	# Sol do Julgamento
	var i := _ult_char(gd, sim, "bishop", "inquisidor", at, "B1Sol")
	i.party_id = 9400
	ally.hp = ally.stats.max_hp * 0.5
	i.skill_aim = mob.position
	sim._apply_skill(i, gd.skills["bis_ult_judgement_sun"], m)
	check(mob.state == SimEntity.State.STUNNED, "Sol: o impacto atordoa")
	var zones: Array = (m["traps"] as Array).filter(func(x): return int(x["owner"]) == i.id and x["skill"] == "bis_ult_judgement_sun")
	check(zones.size() == 1 and float(zones[0]["mend_pct"]) > 0.0, "Sol: o chão fica aceso (zona com cura do mais ferido)")
	if zones.size() == 1:
		var hp_al := ally.hp
		var hp_m := mob.hp
		TrapSystem._zone_pulse(sim, zones[0], i, m)
		check(mob.hp < hp_m and ally.hp > hp_al, "Sol: o pulso fere e cura o aliado mais ferido")
		m["traps"].erase(zones[0])
	sim.despawn(i)
	# Avatar da Fé
	var c := _ult_char(gd, sim, "bishop", "batalha", at, "B1Avatar")
	c.party_id = 9400
	ally.hp = ally.stats.max_hp * 0.5
	var hp_b := ally.hp
	var hp_mob := mob.hp
	sim._apply_skill(c, gd.skills["bis_ult_faith_avatar"], m)
	check(ally.hp > hp_b, "Avatar: cura o grupo a %d m" % int(Balance.ULT_NUMBERS["bis_ult_faith_avatar"]["heal_radius"]))
	check(c.buffs.any(func(x): return x.get("id") == "faith_avatar") and c.stats.phys_mend > 0.0 and c.stats.cc_resist_pct >= 49.0, "Avatar: buff com ATK/DEF, resistência a controle e cura pelo dano físico")
	check(is_equal_approx(EntityView.buff_scale(c), 1.25), "Avatar: o boneco cresce x1,25 (EntityView.buff_scale)")
	ally.hp = ally.stats.max_hp * 0.5
	var hp_c := ally.hp
	sim._deal_damage(c, mob, 400, false, false, "physical")
	check(ally.hp > hp_c, "Avatar: o dano físico cura o aliado mais ferido")
	check(mob.hp < hp_mob, "Avatar: o martelo de luz fere em volta")
	for o in [b, ally, mob, c]:
		o.party_id = -1
		sim.despawn(o)

## Druida: Colosso (vira urso, HP ganho entra cheio, % de vida no fim e ao sair do urso, Ent recusa), Lua Rubra (lobo, prefere quem não sangra), Coração (prende, 3 alvos a 10 m, cura).
func _check_ultimate_b1_druid(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var d := _ult_char(gd, sim, "druid", "guardiao_verde", at, "B1Colosso")
	if not d.stats.meets(["mace2h"]):           # o bot nasce com a arma de uma build sorteada: a do Urso é a maça de 2 mãos
		for iid in gd.items:
			var it: ItemDef = gd.items[iid]
			if it.slot == ItemDef.Slot.WEAPON and it.weapon_type == "mace2h":
				d.equipment[ItemDef.Slot.WEAPON] = it
				d.recompute_stats()
				break
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 4))
	var cs: SkillDef = gd.skills["dru_ult_primal_colossus"]
	d.form = "ent"
	check(UltEffects.form_refused(d, "bear"), "Colosso: em Ent é recusado")
	d.form = "wolf"
	check(UltEffects.form_refused(d, "bear"), "Colosso: em outra forma é recusado")
	d.form = ""
	d.recompute_stats()
	check(not UltEffects.form_refused(d, "bear"), "Colosso: em forma humana sai")
	sim._apply_skill(d, cs, m)
	check(d.form == "bear", "Colosso: vira urso na hora")
	for x in d.buffs.duplicate():
		if x.get("id") == "primal_colossus":
			d.buffs.erase(x)
	d.recompute_stats()
	d.hp = d.stats.max_hp * 0.8
	var max_bear: float = d.stats.max_hp
	var hp_bear: float = d.hp
	sim._apply_skill(d, cs, m)
	check(d.buffs.any(func(x): return x.get("id") == "primal_colossus") and is_equal_approx(EntityView.buff_scale(d), 1.5), "Colosso: buff e urso x1,5")
	check(d.stats.max_hp > max_bear * 1.4 and absf((d.hp - hp_bear) - (d.stats.max_hp - max_bear)) < 1.0, "Colosso: +HP máx. e a vida ganha entra cheia (%.0f -> %.0f, máx. %.0f -> %.0f)" % [hp_bear, d.hp, max_bear, d.stats.max_hp])
	check(mob.aggro_target == d.id, "Colosso: urra e provoca")
	d.hp = d.stats.max_hp * 0.6
	for x in d.buffs:
		if x.get("id") == "primal_colossus":
			x["remaining"] = 0.01
	sim._update_entity(d, m, 1.0 / 60.0)
	check(not d.buffs.any(func(x): return x.get("id") == "primal_colossus") and absf(d.hp / d.stats.max_hp - 0.6) < 0.01,
		"Colosso: ao acabar, a vida máx. volta e a %% fica (%.2f)" % (d.hp / d.stats.max_hp))
	# urso desligado no meio: acaba junto, pela %
	sim._apply_skill(d, cs, m)
	d.hp = d.stats.max_hp * 0.7
	sim._apply_effects(d, d, {"form": "bear"}, 0.0)
	check(d.form == "" and not d.buffs.any(func(x): return x.get("id") == "primal_colossus") and absf(d.hp / d.stats.max_hp - 0.7) < 0.01,
		"Colosso: sair do urso acaba o Colosso e a %% fica (%.2f)" % (d.hp / d.stats.max_hp))
	sim.despawn(d)
	sim.despawn(mob)
	# Garras da Lua Rubra
	var w := _ult_char(gd, sim, "druid", "fera", at, "B1Lua")
	var ws: SkillDef = gd.skills["dru_ult_blood_moon"]
	check(ws.requires_form == "wolf", "Lua Rubra: só como lobo (o Alfa conta por form_ok)")
	var bled := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 2))
	var fresh := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 4.5))
	sim._apply_effects(w, bled, {"dot": {"dps": 4, "duration": 8, "skill": "dru_claw"}}, 1.0)
	w.form = "wolf"
	sim._apply_skill(w, ws, m)
	check(not w.hop.is_empty() and is_equal_approx(float(w.hop["every"]), 0.8) and str(w.hop["prefer"]) == "unbled", "Lua Rubra: salta a cada 0,8 s preferindo quem não sangra")
	check(fresh.debuffs.any(func(x): return x.get("kind") == "dot" and int(x.get("src", -1)) == w.id), "Lua Rubra: o 1º salto vai em quem não sangrava e o faz sangrar")
	w.hop = {}
	sim.despawn(w)
	sim.despawn(bled)
	sim.despawn(fresh)
	# Coração do Bosque Ancião
	var x := _ult_char(gd, sim, "druid", "xama", at, "B1Coracao")
	var ally := _ult_char(gd, sim, "paladin", "guardiao", at + Vector3(0, 0, 6), "B1CoracaoAliado")
	x.party_id = 9500
	ally.party_id = 9500
	var center := at + Vector3(0, 0, 6)
	var inner := _ult_mob(gd, sim, "golem", center + Vector3(2, 0, 0))
	var ring: Array = []
	for k in range(4):
		ring.append(_ult_mob(gd, sim, "golem", center + Vector3(cos(k * PI / 2.0), 0, sin(k * PI / 2.0)) * (7.5 + k * 0.5)))
	x.skill_aim = center
	sim._apply_skill(x, gd.skills["dru_ult_elder_heart"], m)
	check(inner.has_debuff("root") and not (ring[0] as SimEntity).has_debuff("root"), "Coração: ao nascer prende quem está a 6 m (e só eles)")
	var zs: Array = (m["traps"] as Array).filter(func(t): return int(t["owner"]) == x.id and t["skill"] == "dru_ult_elder_heart")
	check(zs.size() == 1, "Coração: a árvore fica no chão (zona)")
	if zs.size() == 1:
		var before := {}
		for o in [inner] + ring:
			before[o.id] = o.hp
		ally.hp = ally.stats.max_hp * 0.5
		var hpa := ally.hp
		TrapSystem._zone_pulse(sim, zs[0], x, m)
		var hit_n := 0
		for o in [inner] + ring:
			if o.hp < float(before[o.id]):
				hit_n += 1
		check(hit_n == int(Balance.ULT_NUMBERS["dru_ult_elder_heart"]["foe_max"]), "Coração: Fogo Lunar em até 3 inimigos a 10 m (%d)" % hit_n)
		check((ring[3] as SimEntity).hp == float(before[(ring[3] as SimEntity).id]), "Coração: o mais longe dos 5 fica de fora")
		check(ally.hp > hpa, "Coração: cura o aliado a 6 m")
		m["traps"].erase(zs[0])
	for o in [x, ally, inner] + ring:
		o.party_id = -1
		sim.despawn(o)

## Revisão da onda A (hop): o limite de pulos sem chão é por salto, não pela sequência (sequência longa não morre depois de 4 pulos).
func _check_ultimate_b1_hop_skip(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var e := _ult_char(gd, sim, "druid", "fera", at, "B1HopSkip")
	var foe := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 2.5))
	HopSystem.start(sim, e, gd.skills["dru_ult_blood_moon"], 1.0, {"count": 6, "every": 0.5, "radius": 8.0})
	var landed := 0
	for i in range(5):
		if e.hop.is_empty():
			break
		e.hop["skip"] = 3                       # três pulos sem chão antes deste salto (o limite é > 3 seguidos)
		e.hop["next_at"] = sim.time
		var left := int(e.hop["left"])
		HopSystem.tick(sim, e, m)
		if e.hop.is_empty() or int(e.hop["left"]) < left:
			landed += 1
		if not e.hop.is_empty():
			check(int(e.hop.get("skip", 0)) == 0, "hop: salto que pousou zera os pulos sem chão (%d)" % int(e.hop.get("skip", 0)))
	check(landed == 5, "hop: com pulos sem chão entre os saltos a sequência continua (%d de 5)" % landed)
	e.hop = {}
	sim.despawn(e)
	sim.despawn(foe)

# ----------------------------------------------------------------------------
# Supremas da onda B2 (GDD ultimates-lv40 §3.5 13-24): Ranger, Assassino, Elementalista Gelo/Raio, Necromante.
# `--only=ultimate_b2`
# ----------------------------------------------------------------------------

## Personagem do nível 40 com a ascensão e as armas da build (as de nível mais baixo, sem lendário).
func _ult_b2_char(gd, sim, cls: String, build: String, at: Vector3, nm: String) -> SimEntity:
	var e := _ult_char(gd, sim, cls, build, at, nm)
	sim._gear_bot(e)                       # armadura da build (o bot nasce vestido para uma build sorteada: a força variava)
	var b: Dictionary = e.class_def.build_by_id(build)
	var slots := [[ItemDef.Slot.WEAPON, str(b["main"][0])]]
	if (b["off"] as Array).size() > 0:
		slots.append([ItemDef.Slot.OFFHAND, str(b["off"][0])])
	for sl in slots:
		var best: ItemDef = null
		for iid in gd.items:
			var it: ItemDef = gd.items[iid]
			if it.weapon_type != sl[1] or it.is_legendary() or (it.class_restriction.size() > 0 and not (cls in it.class_restriction)):
				continue
			if best == null or it.level_req < best.level_req:
				best = it
		if best != null:
			e.equipment[sl[0]] = best
	e.recompute_stats()
	e.hp = e.stats.max_hp
	UltimateSystem.refresh(sim, e)
	return e

## Lança a Suprema da build de `e` direto (sem medidor): mira em `aim`, aplica o efeito como na fase ativa.
func _ult_b2_fire(sim, e: SimEntity, aim: Vector3, m: Dictionary) -> SkillDef:
	var s: SkillDef = UltimateSystem.ultimate_of(sim, e)
	e.face_towards(aim)
	e.skill_aim = aim
	sim._apply_skill(e, s, m)
	return s

## Dano de `src` em `t` registrado pelo evento damage_dealt enquanto `fn` roda: [[amount, crit, kind], ...].
func _ult_b2_hits(src: SimEntity, t: SimEntity, fn: Callable) -> Array:
	var seen: Array = []
	var cb := func(a: int, b: int, amount: int, crit: bool, _blk: bool, kind: String):
		if a == src.id and b == t.id:
			seen.append([amount, crit, kind])
	Events.damage_dealt.connect(cb)
	fn.call()
	Events.damage_dealt.disconnect(cb)
	return seen

## As 11 da onda B2: uma por build, com a arma da build, números de Balance.ULT_NUMBERS.
func _check_ultimate_b2_catalog(gd, sim) -> void:
	var want := {"ranger": {"cacador": "ran_ult_wild_bond", "atirador": "ran_ult_end_shot", "lanceiro": "ran_ult_endless_lance"},
		"assassin": {"laminas": "ass_ult_royal_toxin", "duelista": "ass_ult_grand_duel", "corsario": "ass_ult_fleet_call"},
		"elementalist": {"gelo": "ele_ult_eternal_winter", "raio": "ele_ult_storm_eye"},
		"necromancer": {"invocador": "nec_ult_tide_of_dead", "ceifador": "nec_ult_soul_reaping", "pestilento": "nec_ult_void_eclipse"}}
	var at := _ult_open(sim)
	for cls in want:
		for b in want[cls]:
			var e := _ult_b2_char(gd, sim, cls, b, at, "UltB2Cat")
			var s: SkillDef = UltimateSystem.ultimate_of(sim, e)
			check(s != null and s.id == want[cls][b], "suprema B2: %s/%s -> %s (%s)" % [cls, b, want[cls][b], s.id if s else "null"])
			check(s != null and Balance.ULT_NUMBERS.has(s.id) and BuffLooks.LOOKS.size() > 0, "suprema B2 %s: números em ULT_NUMBERS" % want[cls][b])
			sim.despawn(e)
	var es: SkillDef = gd.skills["ran_ult_end_shot"]
	check(is_equal_approx(es.startup, float(Balance.ULT_NUMBERS["ran_ult_end_shot"]["aim"])) and es.startup > 0.3,
		"Disparo do Fim: mira longa (%.1f s) é a exceção ao teto de 0,3 s, vinda de ULT_NUMBERS" % es.startup)
	for sid in ["wild_bond", "wild_bond_pet", "wild_bond_spirit", "grand_duel", "storm_eye", "tide_of_dead", "tide_frenzy", "soul_reaping"]:
		check(BuffLooks.LOOKS.has(sid), "suprema B2: buff %s tem visual (BuffLooks.LOOKS)" % sid)

## Ranger: Laço Selvagem (revive + 2º lince), Disparo do Fim (perfura, crítico, 1º leva mais, empurra), Lança Incansável.
func _check_ultimate_b2_ranger(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var N: Dictionary = Balance.ULT_NUMBERS
	# Laço Selvagem
	var ran := _ult_b2_char(gd, sim, "ranger", "cacador", at, "UltB2Laco")
	check(sim.pet_of(ran) == null, "Laço Selvagem: começa sem lince (morto)")
	_ult_b2_fire(sim, ran, ran.position + Vector3(0, 0, 2), m)
	var pet: SimEntity = sim.pet_of(ran)
	check(pet != null and pet.hp == pet.stats.max_hp, "Laço Selvagem: o lince volta com a vida cheia")
	var wb: Dictionary = N["ran_ult_wild_bond"]
	if pet != null:
		check(pet.buffs.any(func(b): return b.get("id") == "wild_bond_pet" and is_equal_approx(float(b.get("scale", 1.0)), float(wb["pet_grow"]))),
			"Laço Selvagem: o lince ganha o buff e cresce ×%.1f (scale)" % float(wb["pet_grow"]))
		check(pet.stats.cc_mult() <= 1.0 - float(wb["pet_cc_resist"]) / 100.0 + 0.001, "Laço Selvagem: lince resiste %d%% ao controle (%.2f)" % [int(wb["pet_cc_resist"]), pet.stats.cc_mult()])
		check(absf(pet.stats.patk / pet.summon_patk - (1.0 + float(wb["atk_pct"]) / 100.0)) < 0.01, "Laço Selvagem: lince +%d%% de ataque (%.2f)" % [int(wb["atk_pct"]), pet.stats.patk / pet.summon_patk])
	check(ran.buffs.any(func(b): return b.get("id") == "wild_bond" and float(b.get("atk_pct", 0)) == float(wb["atk_pct"])), "Laço Selvagem: você +%d%% de ATK" % int(wb["atk_pct"]))
	var spirits: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == ran.id and o != pet and o.is_alive())
	check(spirits.size() == 1 and spirits[0].free_summon and spirits[0].summon_expires < INF, "Laço Selvagem: um 2º lince espiritual com tempo, fora do limite")
	if spirits.size() == 1 and pet != null:
		var sp: SimEntity = spirits[0]
		check(absf(sp.stats.max_hp / pet.stats.max_hp - float(wb["spirit_mult"])) < 0.02 and sp.buffs.any(func(b): return b.get("id") == "wild_bond_spirit"),
			"Laço Selvagem: o espiritual tem %d%% da vida do lince e o buff próprio (%.2f)" % [roundi(float(wb["spirit_mult"]) * 100.0), sp.stats.max_hp / pet.stats.max_hp])
		check(sim.pet_of(ran) == pet, "Laço Selvagem: o companheiro de verdade continua sendo o lince (pet_of)")
		sim.despawn(sp)
	if pet != null:
		pet.hp = 1.0
		_ult_b2_fire(sim, ran, ran.position + Vector3(0, 0, 2), m)
		check(pet.hp == pet.stats.max_hp, "Laço Selvagem: lince vivo volta à vida cheia")
		for o in m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == ran.id):
			sim.despawn(o)
	sim.despawn(ran)
	# Disparo do Fim: 3 alvos em fila; o tiro passa por todos, crítico garantido, 1º leva mais
	var gun := _ult_b2_char(gd, sim, "ranger", "atirador", at, "UltB2Tiro")
	var fila: Array = []
	for d in [3.0, 6.0, 11.0]:
		fila.append(_ult_mob(gd, sim, "golem", gun.position + Vector3(d, 0, 0)))
	var hp0: Array = fila.map(func(o): return o.hp)
	var pos0: Vector3 = fila[1].position
	var crits := {}
	var fila_ids: Array = fila.map(func(o): return o.id)
	var cb := func(a: int, b: int, _amt: int, crit: bool, _blk: bool, kind: String):
		if a == gun.id and b in fila_ids and kind == "physical" and crit:
			crits[b] = true
	Events.damage_dealt.connect(cb)
	_ult_b2_fire(sim, gun, gun.position + Vector3(10, 0, 0), m)
	for i in range(90):
		sim._update_projectiles(m, 1.0 / 60.0)
	Events.damage_dealt.disconnect(cb)
	var dmg: Array = []
	for i in range(3):
		dmg.append(float(hp0[i]) - fila[i].hp)
	check(dmg[0] > 0.0 and dmg[1] > 0.0 and dmg[2] > 0.0, "Disparo do Fim: atravessa os três (%s)" % str(dmg))
	check(crits.size() == 3, "Disparo do Fim: crítico garantido em todos (%d)" % crits.size())
	var ratio: float = dmg[1] / maxf(1.0, dmg[0])
	check(absf(ratio - float(N["ran_ult_end_shot"]["rest"])) < 0.15, "Disparo do Fim: depois do 1º, × %.1f (%.2f)" % [float(N["ran_ult_end_shot"]["rest"]), ratio])
	check(fila[1].position.distance_to(pos0) > 1.0, "Disparo do Fim: empurra quem não é chefe (%.1f m)" % fila[1].position.distance_to(pos0))
	for o in fila:
		sim.despawn(o)
	# mira longa: cancelar no preparo (dash) mantém a carga
	gun.ult_charge = Balance.ULT_MAX
	gun.ult_combat_t = sim.time + 100.0          # em luta: a carga não esvazia durante a mira
	var foe := _ult_mob(gd, sim, "golem", gun.position + Vector3(6, 0, 0))
	check(UltimateSystem.try_cast(sim, gun, foe.position, m) and gun.skill_phase == "startup", "Disparo do Fim: começa a mirar")
	for i in range(60):
		sim._update_entity(gun, m, 1.0 / 60.0)
	check(gun.skill_phase == "startup" and gun.ult_charge == Balance.ULT_MAX, "Disparo do Fim: 1 s depois ainda mira e a carga está cheia")
	var dash := InputCommand.new()
	dash.dash = true
	dash.aim = foe.position
	gun.dash_cd = 0.0
	sim._apply_command(gun, dash, m, 0.0)
	check(gun.state == SimEntity.State.DASHING and gun.ult_charge == Balance.ULT_MAX, "Disparo do Fim: o dash na mira cancela e a carga fica")
	gun.set_state(SimEntity.State.IDLE)
	sim.despawn(foe)
	sim.despawn(gun)
	# Lança Incansável: 12 estocadas, sangra e marca; no fim arremessa e prende
	var lan := _ult_b2_char(gd, sim, "ranger", "lanceiro", at, "UltB2Lanca")
	var prey := _ult_mob(gd, sim, "golem", lan.position + Vector3(3, 0, 0))
	var el: Dictionary = N["ran_ult_endless_lance"]
	lan.ult_charge = Balance.ULT_MAX
	var hits := _ult_b2_hits(lan, prey, func():
		UltimateSystem.try_cast(sim, lan, prey.position, m)
		for i in range(int((0.2 + float(el["channel"]) + 0.4) * 60.0)):
			sim._update_entity(lan, m, 1.0 / 60.0)
			sim._update_projectiles(m, 1.0 / 60.0))
	var stabs := hits.filter(func(h): return h[2] == "physical").size()
	check(stabs >= int(el["ticks"]) + 1 and stabs <= int(el["ticks"]) + 2, "Lança Incansável: %d estocadas + o arremesso (%d golpes)" % [int(el["ticks"]), stabs])
	check(prey.debuffs.any(func(d): return d.get("id") == "bleed_%d" % lan.id) and prey.debuffs.any(func(d): return d.get("id") == "curse_predator_%d" % lan.id),
		"Lança Incansável: sangra e marca (Marca do Predador)")
	check(prey.has_debuff("root"), "Lança Incansável: o arremesso do fim prende")
	sim.despawn(prey)
	sim.despawn(lan)

## Assassino: Toxina Real (dot_amp no alvo), Duelo Supremo (arco, Ímpeto 2, uma resposta por 0,5 s, Golpe de Mestre no fim),
## Chamado da Frota (tempestade de balas, Bravata cheia). Decisão do aparo: golpe aparado por inteiro não enche a carga.
func _check_ultimate_b2_assassin(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var N: Dictionary = Balance.ULT_NUMBERS
	# Toxina Real
	var lam := _ult_b2_char(gd, sim, "assassin", "laminas", at, "UltB2Tox")
	var t := _ult_mob(gd, sim, "golem", lam.position + Vector3(1.5, 0, 0))
	_ult_b2_fire(sim, lam, t.position, m)
	var rt: Dictionary = N["ass_ult_royal_toxin"]
	var amp := t.debuffs.filter(func(d): return d.get("kind") == Balance.DOT_AMP_KIND and int(d.get("src", -1)) == lam.id)
	check(amp.size() == 1 and is_equal_approx(float(amp[0]["mult"]), float(rt["mult"])) and is_equal_approx(float(amp[0]["remaining"]), float(rt["duration"]))
		and is_equal_approx(float(amp[0]["spread_radius"]), float(rt["spread"])), "Toxina Real: marca o alvo (×%.0f por %d s, espalha a %d m)" % [float(rt["mult"]), int(rt["duration"]), int(rt["spread"])])
	sim.despawn(t)
	sim.despawn(lam)
	# Duelo Supremo
	var du := _ult_b2_char(gd, sim, "assassin", "duelista", at, "UltB2Duelo")
	du.facing = 0.0
	var gd2: Dictionary = N["ass_ult_grand_duel"]
	var front := _ult_mob(gd, sim, "golem", du.position + du.forward().rotated(Vector3.UP, deg_to_rad(60.0)) * 1.5)
	var side := _ult_mob(gd, sim, "golem", du.position + du.forward().rotated(Vector3.UP, deg_to_rad(110.0)) * 1.5)
	_ult_b2_fire(sim, du, du.position + du.forward() * 2.0, m)
	var w := RiposteSystem.window(du)
	check(not w.is_empty() and float(w.get("riposte_arc", 0)) == float(gd2["arc"]) and w.has("end_cast"), "Duelo Supremo: janela de aparar longa com arco %d° e fechamento" % int(gd2["arc"]))
	sim._apply_effects(du, du, {"buff": gd.skills["ass_guard"].effects["buff"]}, 1.0)
	check(RiposteSystem.window(du) == w and du.buffs.any(func(b): return b.get("id") == "grand_duel"), "Duelo Supremo: a Guarda comum lançada no meio não apaga o Duelo (id próprio)")
	du.buffs = du.buffs.filter(func(b): return b.get("id") != Balance.RIPOSTE_BUFF)
	var hp_f := front.hp
	var landed: bool = sim._deal_damage(front, du, 100, false, false, "physical")
	check(not landed and du.buff_stacks(Balance.RIPOSTE_MOMENTUM_BUFF) == int(gd2["gain"]) and front.hp < hp_f, "Duelo Supremo: apara a 60° da frente, responde e dá %d de Ímpeto" % int(gd2["gain"]))
	hp_f = front.hp
	sim._deal_damage(front, du, 100, false, false, "physical")
	check(front.hp == hp_f, "Duelo Supremo: no máximo uma resposta a cada %.1f s" % float(gd2["gap"]))
	w["next_counter"] = sim.time - 0.01
	sim._deal_damage(front, du, 100, false, false, "physical")
	check(front.hp < hp_f, "Duelo Supremo: passado o intervalo, responde de novo (sem o teto de 2 da Guarda)")
	du.stats.evasion = 0.0
	var hp_d := du.hp
	sim._deal_damage(side, du, 100, false, false, "physical")
	check(du.hp < hp_d, "Duelo Supremo: golpe de fora do arco (110°) entra")
	# contador do Duelo (decisão do usuário 2026-11-19): aparo soma "gain"; golpe seu soma "hit_gain" até "hit_cap" golpes; teto "duel_cap"
	var cap := int(gd2["duel_cap"])
	check(int(w.get("duel", 0)) == mini(cap, 3 * int(gd2["gain"])), "Duelo Supremo: cada aparo soma %d ao Duelo (3 aparos: %d)" % [int(gd2["gain"]), int(w.get("duel", 0))])
	w["duel"] = 0
	sim._strike(du, front, du.basic_skill, 1.0, SkillDef.Kind.PHYSICAL, du.position)
	check(int(w["duel"]) == int(gd2["hit_gain"]), "Duelo Supremo: o básico do duelista no alvo soma %d ao Duelo (%d)" % [int(gd2["hit_gain"]), int(w["duel"])])
	for k in range(int(gd2["hit_cap"]) + 3):
		RiposteSystem.duel_hit(du)
	var from_hits: int = mini(cap, int(gd2["hit_cap"]) * int(gd2["hit_gain"]))
	check(int(w["duel"]) == from_hits, "Duelo Supremo: os golpes enchem até %d golpes (%d)" % [int(gd2["hit_cap"]), int(w["duel"])])
	w["next_counter"] = sim.time + 10.0
	sim._deal_damage(front, du, 100, false, false, "physical")
	check(int(w["duel"]) == mini(cap, from_hits + int(gd2["gain"])), "Duelo Supremo: aparar ainda soma depois do teto dos golpes (%d)" % int(w["duel"]))
	sim._deal_damage(front, du, 100, false, false, "physical")
	sim._deal_damage(front, du, 100, false, false, "physical")
	check(int(w["duel"]) == cap, "Duelo Supremo: o Duelo para no teto %d (%d)" % [cap, int(w["duel"])])
	check(cap * float(gd2["duel_per"]) > 0.4 and 1.0 + from_hits * float(gd2["duel_per"]) >= 1.4,
		"Duelo Supremo: só com os seus golpes o fecho já sai bem mais forte que o piso (x%.2f)" % (1.0 + from_hits * float(gd2["duel_per"])))
	# fim: Golpe de Mestre com o Ímpeto cheio
	var hp_m := front.hp
	w["remaining"] = 0.01
	sim._update_entity(du, m, 0.05)
	check(RiposteSystem.window(du).is_empty() and front.hp < hp_m and du.buff_stacks(Balance.RIPOSTE_MOMENTUM_BUFF) == 0, "Duelo Supremo: no fim sai o Golpe de Mestre e gasta o Ímpeto")
	# decisão (GDD §3.2 item 5): aparo inteiro é golpe que não pegou -> não enche quem aparou
	du.ult_gap_until = 0.0
	UltimateSystem.zero(du)
	du.ult_budget = Balance.ULT_RATE_BURST
	du.put_buff({"id": Balance.RIPOSTE_BUFF, "remaining": 1.0})
	du.stats.evasion = 0.0
	sim._deal_damage(front, du, 200, false, false, "physical")
	var c_parry := du.ult_charge
	du.stats.evasion = 0.0
	du.buffs = du.buffs.filter(func(b): return b.get("id") != Balance.RIPOSTE_BUFF)
	UltimateSystem.zero(du)
	du.ult_budget = Balance.ULT_RATE_BURST
	sim._deal_damage(front, du, 200, false, false, "physical")
	check(c_parry == 0.0 and du.ult_charge > 0.0, "aparo inteiro do Duelista não enche a carga (golpe que não pegou; %.2f) e o mesmo golpe sem aparar enche (%.2f)" % [c_parry, du.ult_charge])
	for o in [front, side, du]:
		sim.despawn(o)
	# Chamado da Frota
	var cor := _ult_b2_char(gd, sim, "assassin", "corsario", at, "UltB2Frota")
	var fc: Dictionary = N["ass_ult_fleet_call"]
	var tgt := _ult_mob(gd, sim, "golem", cor.position + Vector3(6, 0, 0))
	var hp_t := tgt.hp
	_ult_b2_fire(sim, cor, tgt.position, m)
	check(cor.buff_stacks(Balance.BRAVADO_BUFF) == Balance.BRAVADO_MAX, "Chamado da Frota: Bravata cheia (%d)" % cor.buff_stacks(Balance.BRAVADO_BUFF))
	check(tgt.hp == hp_t, "Chamado da Frota: nada bate na hora (as balas são avisadas)")
	var st: Array = StormSystem.storms_of(sim, cor)
	check(st.size() == 1 and st[0]["anchor"] == "ground" and (st[0]["center"] as Vector3).distance_to(Vector3(tgt.position.x, 0, tgt.position.z)) < 0.01,
		"Chamado da Frota: a frota mira o ponto (presa no chão)")
	check(ceili(float(fc["duration"]) / float(st[0]["every"]) - 0.0001) == int(fc["shots"]) if st.size() == 1 else false, "Chamado da Frota: %d balas em %d s" % [int(fc["shots"]), int(fc["duration"])])
	if st.size() == 1:
		st[0]["bias"] = 1.0
		st[0]["next_at"] = sim.time
		StormSystem.tick(sim, m)
		var mine: Array = (m.get("ally_strikes", []) as Array).filter(func(h): return int(h["owner"]) == cor.id)
		check(mine.size() == 1 and is_equal_approx(float(mine[0]["at"]) - sim.time, float(fc["warn"])), "Chamado da Frota: cada bala é avisada %.1f s antes" % float(fc["warn"]))
		for h in mine:
			h["at"] = sim.time - 0.01
		StormSystem.tick(sim, m)
		check(tgt.hp < hp_t, "Chamado da Frota: a bala acerta o inimigo")
		(m["storms"] as Array).erase(st[0])
	sim.despawn(tgt)
	sim.despawn(cor)

## Elementalista: Inverno Eterno (ancorado no ponto, congela no 3º pulso) e Olho da Tempestade (segue, encadeia, velocidade,
## Passo Relampejante sem recarga).
func _check_ultimate_b2_elementalist(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var N: Dictionary = Balance.ULT_NUMBERS
	var g := _ult_b2_char(gd, sim, "elementalist", "gelo", at, "UltB2Gelo")
	var foe := _ult_mob(gd, sim, "golem", g.position + Vector3(5, 0, 0))
	var hp0 := foe.hp
	_ult_b2_fire(sim, g, foe.position, m)
	var st: Array = StormSystem.storms_of(sim, g)
	var ew: Dictionary = N["ele_ult_eternal_winter"]
	check(st.size() == 1 and st[0]["mode"] == "pulse" and (st[0]["center"] as Vector3).distance_to(Vector3(foe.position.x, 0, foe.position.z)) < 0.01,
		"Inverno Eterno: tempestade de pulsos presa no ponto mirado")
	if st.size() == 1:
		for k in range(int(ew["freeze_hits"])):
			StormSystem._fire(sim, m, g, st[0])
		check(foe.hp < hp0 and foe.state == SimEntity.State.STUNNED, "Inverno Eterno: fere e congela no %dº pulso" % int(ew["freeze_hits"]))
		(m["storms"] as Array).erase(st[0])
	foe.set_state(SimEntity.State.IDLE)
	sim.despawn(g)
	# Olho da Tempestade
	var r := _ult_b2_char(gd, sim, "elementalist", "raio", at, "UltB2Raio")
	var se: Dictionary = N["ele_ult_storm_eye"]
	r.cooldowns["ele_bolt_step"] = 7.0
	var a := _ult_mob(gd, sim, "golem", r.position + Vector3(3, 0, 0))
	var b := _ult_mob(gd, sim, "golem", r.position + Vector3(4.5, 0, 0))
	_ult_b2_fire(sim, r, r.position + Vector3(0, 0, 1), m)
	check(not r.cooldowns.has("ele_bolt_step"), "Olho da Tempestade: Passo Relampejante volta da recarga")
	check(r.buffs.any(func(x): return x.get("id") == "storm_eye" and float(x.get("speed_pct", 0)) == float(se["speed_pct"])), "Olho da Tempestade: +%d%% de velocidade" % int(se["speed_pct"]))
	var est: Array = StormSystem.storms_of(sim, r)
	check(est.size() == 1 and est[0]["anchor"] == "caster", "Olho da Tempestade: a tempestade segue o mago")
	if est.size() == 1:
		var ha := a.hp
		var hb := b.hp
		est[0]["next_at"] = sim.time
		StormSystem.tick(sim, m)
		check(a.hp < ha and b.hp < hb, "Olho da Tempestade: o raio cai num e salta para o vizinho (chain)")
		var first: SimEntity = a if (est[0]["last_hit"] as Dictionary).get(a.id, -1.0) == sim.time and (est[0]["last_hit"] as Dictionary).size() == 1 else b
		var pick: SimEntity = StormSystem._pick(sim, m, r, est[0])
		check(pick != null and (pick != first or (est[0]["last_hit"] as Dictionary).size() > 1), "Olho da Tempestade: prefere quem não levou agora")
		(m["storms"] as Array).erase(est[0])
	for o in [foe, a, b, r]:
		sim.despawn(o)

## Necromante: Maré dos Mortos (6 fora do limite, +MATK nelas, explodem ao sumir, fora da Oferenda), Ceifa das Almas (cura
## por atingido, buff, variantes de forma), Eclipse do Vazio (sem dano no pulso, lentidão, maldição copiada, dot ×, implosão).
func _check_ultimate_b2_necro(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var N: Dictionary = Balance.ULT_NUMBERS
	var nec := _ult_b2_char(gd, sim, "necromancer", "invocador", at, "UltB2Mare")
	var td: Dictionary = N["nec_ult_tide_of_dead"]
	var ref: SimEntity = sim.spawn_summon(nec, gd.monsters["skeleton_minion"], nec.position + Vector3(-1, 0, 0), 20.0)
	_ult_b2_fire(sim, nec, nec.position + Vector3(0, 0, 2), m)
	var free: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == nec.id and o.free_summon and o.is_alive())
	check(free.size() == int(td["count"]) and free.all(func(o): return not o.expire_blast.is_empty()), "Maré dos Mortos: %d esqueletos fora do limite, que explodem ao sumir" % int(td["count"]))
	check(nec.buffs.any(func(x): return x.get("id") == "tide_of_dead"), "Maré dos Mortos: +MATK em você")
	if free.size() > 0:
		var k: float = free[0].summon_patk / maxf(0.01, ref.summon_patk)
		check(absf(k - (1.0 + float(td["matk_pct"]) / 100.0)) < 0.05, "Maré dos Mortos: os novos já nascem com o +%d%% de MATK (×%.2f)" % [int(td["matk_pct"]), k])
		check(free[0].buffs.any(func(x): return x.get("id") == "tide_frenzy") and ref.buffs.any(func(x): return x.get("id") == "tide_frenzy"),
			"Maré dos Mortos: suas invocações (as novas e as que já estavam) atacam mais rápido")
		check(SummonRites.pick(sim, nec, nec.position, {"pick_radius": 20.0, "max": 20}).all(func(o): return not o.free_summon), "Maré dos Mortos: a Oferenda Sombria não pega os 6")
		var sk: SimEntity = free[0]
		var near := _ult_mob(gd, sim, "golem", sk.position + Vector3(1, 0, 0))
		var hp_n := near.hp
		sk.summon_expires = sim.time - 0.01
		sim._update_entity(sk, m, 0.05)
		check(not m["entities"].has(sk), "Maré dos Mortos: o esqueleto some no fim do tempo")
		check(near.hp < hp_n, "Maré dos Mortos: a explosão fere quem está perto (%.0f)" % (hp_n - near.hp))
		sim.despawn(near)
	for o in m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == nec.id):
		sim.despawn(o)
	sim.despawn(nec)
	# Ceifa das Almas
	var rp := _ult_b2_char(gd, sim, "necromancer", "ceifador", at, "UltB2Ceifa")
	var sr: Dictionary = N["nec_ult_soul_reaping"]
	var ring: Array = []
	for i in range(3):
		ring.append(_ult_mob(gd, sim, "golem", rp.position + Vector3(cos(i * 2.1), 0, sin(i * 2.1)) * 3.0))
	rp.hp = rp.stats.max_hp * 0.3
	var h0 := rp.hp
	_ult_b2_fire(sim, rp, rp.position + Vector3(0, 0, 1), m)
	var healed := (rp.hp - h0) / rp.stats.max_hp * 100.0
	check(healed >= float(sr["heal_pct"]) * 3.0 - 0.5, "Ceifa das Almas: cura %d%% por inimigo atingido (3 -> %.1f%%)" % [int(sr["heal_pct"]), healed])
	check(ring.all(func(o): return o.hp < 1.0e7), "Ceifa das Almas: o giro pega todos a %d m" % int(sr["radius"]))
	check(rp.buffs.any(func(x): return x.get("id") == "soul_reaping" and float(x.get("lifesteal", 0)) == float(sr["lifesteal"])), "Ceifa das Almas: buff de ATK/MATK e roubo de vida")
	rp.ult_charge = Balance.ULT_MAX
	rp.ult_gap_until = 0.0
	rp.form = "demon"
	UltimateSystem.try_cast(sim, rp, rp.position + Vector3(0, 0, 1), m)
	var cur: SkillDef = rp.current_skill
	check(cur != null and cur.ultimate and absf(cur.power - gd.skills["nec_ult_soul_reaping"].power * float(sr["demon"])) < 0.01, "Ceifa das Almas: na Forma Demoníaca o giro vale ×%.1f (%.2f)" % [float(sr["demon"]), cur.power if cur else 0.0])
	rp.set_state(SimEntity.State.IDLE)
	rp.current_skill = null
	rp.form = "phantom"
	UltimateSystem.try_cast(sim, rp, rp.position + Vector3(0, 0, 1), m)
	cur = rp.current_skill
	check(cur != null and cur.talent_effects.has("dash"), "Ceifa das Almas: na Forma Fantasma avança no giro")
	rp.set_state(SimEntity.State.IDLE)
	rp.current_skill = null
	rp.form = ""
	for o in ring:
		sim.despawn(o)
	sim.despawn(rp)
	# Eclipse do Vazio
	var sh := _ult_b2_char(gd, sim, "necromancer", "pestilento", at, "UltB2Eclipse")
	var ve: Dictionary = N["nec_ult_void_eclipse"]
	var cursed := _ult_mob(gd, sim, "golem", sh.position + Vector3(6, 0, 0))
	var fresh := _ult_mob(gd, sim, "golem", sh.position + Vector3(8, 0, 2))
	sim._apply_effects(sh, cursed, gd.skills["nec_curse_doom"].effects, 1.0)
	var bid := _ult_boss_id(gd)
	var boss: SimEntity = _ult_mob(gd, sim, bid, sh.position + Vector3(9, 0, -2.5)) if bid != "" else null
	var center := sh.position + Vector3(7, 0, 0)
	var hp_c := fresh.hp
	_ult_b2_fire(sim, sh, center, m)
	var vst: Array = StormSystem.storms_of(sim, sh)
	check(vst.size() == 1, "Eclipse do Vazio: o disco fica no ponto")
	if vst.size() == 1:
		StormSystem._fire(sim, m, sh, vst[0])
		check(fresh.hp == hp_c, "Eclipse do Vazio: o pulso não fere (só prende o vazio)")
		check(fresh.debuffs.any(func(d): return d.get("kind") == "slow" and is_equal_approx(float(d.get("pct", 0)), float(ve["slow"])) and not d.get("frost", false)),
			"Eclipse do Vazio: %d%% mais lento (sem estilhaço de gelo)" % int(ve["slow"]))
		check(fresh.debuffs.any(func(d): return d.get("id") == "curse_doom_%d" % sh.id), "Eclipse do Vazio: quem entra recebe cópia das suas maldições")
		check(fresh.debuffs.any(func(d): return d.get("kind") == Balance.DOT_AMP_KIND and is_equal_approx(float(d.get("mult", 0)), float(ve["amp"]))), "Eclipse do Vazio: seus danos no tempo ×%.1f dentro" % float(ve["amp"]))
		var far := fresh.position.distance_to(Vector3(center.x, 0, center.z))
		var boss_pos: Vector3 = boss.position if boss else Vector3.ZERO
		vst[0]["until"] = sim.time - 0.01
		vst[0]["next_at"] = sim.time + 100.0
		StormSystem.tick(sim, m)
		check(fresh.hp < hp_c and fresh.position.distance_to(Vector3(center.x, 0, center.z)) < far - 0.5, "Eclipse do Vazio: no fim implode, puxa e fere")
		if boss:
			check(boss.position.distance_to(boss_pos) < 0.01, "Eclipse do Vazio: chefe não é puxado")
	for o in [cursed, fresh, boss, sh]:
		if o != null:
			sim.despawn(o)

## Força das Supremas de dano (decisão do usuário 2026-11-19: 16-22 de poder em alvo único somando a duração, GDD §3.5/§4):
## lança contra um chefe parado (sem cérebro) e soma o dano DA SUPREMA (SimEntity.ult_dealt: golpes, pulsos, saltos,
## martelos, dots dela, fecho e o que a marca dela acrescenta) ÷ o dano médio de um golpe de poder 1,0 de quem lançou no
## mesmo alvo; média de ULT_POW_RUNS lançamentos (crítico de golpe único oscila). Festim e Duelo são buffs: quem lança bate de
## básico 11 s com e sem a Suprema e a diferença é a força dela (velocidade, crítico, sangria, fecho). Imprime
## "ULT_POWER <id> ef=<x>". O relógio da sim anda aqui (tempestades/zonas por sim.time). `--only=ultimate_b2_power`
## (`--ult_pow_only=<build,...>` só essas; `--ult_pow_trace` cada golpe da Suprema).
const ULT_POW_RUNS := 5
## O check aceita ULT_POW_NOISE de folga em volta da faixa: golpe único com crítico (Duelo, Veredito) e golpes sorteados
## (meteoros, balas) oscilam ±1-2 entre ordens de check; o alvo de calibragem continua Balance.ULT_POWER_BAND.
const ULT_POW_NOISE := 1.5

func _check_ultimate_b2_power(gd, sim) -> void:
	var keep_time: float = sim.time           # cada lançamento anda ~14 s: o relógio volta no fim (checks seguintes não dependem disto)
	_ult_pow_all(gd, sim)
	sim.time = keep_time

func _ult_pow_all(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var bid := _ult_boss_id(gd)
	# [classe, build, distância do alvo, buff: bate de básico com e sem]
	var cases := [["elementalist", "fogo", 0.0, false], ["ranger", "atirador", 6.0, false], ["ranger", "lanceiro", 2.5, false],
		["assassin", "laminas", 1.5, false], ["assassin", "corsario", 6.0, false], ["elementalist", "gelo", 5.0, false],
		["elementalist", "raio", 3.0, false], ["necromancer", "ceifador", 2.5, false], ["necromancer", "pestilento", 5.0, false],
		["paladin", "cruzado", 3.0, false], ["paladin", "templario", 2.5, false], ["berserker", "executor", 3.0, false],
		["berserker", "punhos", 2.0, false], ["bishop", "inquisidor", 5.0, false], ["druid", "fera", 2.0, false],
		["druid", "xama", 5.0, false], ["berserker", "carniceiro", 1.2, true], ["assassin", "duelista", 1.2, true]]
	var only := ""
	for a in OS.get_cmdline_user_args():
		if a.begins_with("--ult_pow_only="):
			only = a.get_slice("=", 1)          # só estas builds (iterar a calibragem)
	for c in cases:
		if only != "" and not (c[1] in only.split(",")):
			continue
		var ef := 0.0
		var duel_max := 0
		var sid := ""
		var runs: int = ULT_POW_RUNS * (3 if c[1] in ["duelista", "executor"] else 1)     # um golpe só: o crítico pesa
		for k in range(runs):
			var r: Dictionary = _ult_pow_run(gd, sim, m, at, bid, c, true)
			sid = r["id"]
			duel_max = maxi(duel_max, int(r["duel"]))
			if c[3]:
				var off: Dictionary = _ult_pow_run(gd, sim, m, at, bid, c, false)
				ef += (float(r["total"]) - float(off["total"])) / maxf(1.0, float(r["ref"])) / runs
			else:
				ef += float(r["ult"]) / maxf(1.0, float(r["ref"])) / runs
		print("ULT_POWER %s ef=%.1f%s" % [sid, ef, (" duelo=%d" % duel_max) if c[1] == "duelista" else ""])
		if Balance.ULT_POWER_PART.has(sid):     # dano + utilidade: só a parte de dano tem faixa própria
			var band: Array = Balance.ULT_POWER_PART[sid]
			check(ef >= float(band[0]) - ULT_POW_NOISE and ef <= float(band[1]) + ULT_POW_NOISE, "suprema %s: a parte de dano na faixa %.0f-%.0f (%.1f)" % [sid, float(band[0]), float(band[1]), ef])
		else:
			check(ef >= Balance.ULT_POWER_BAND[0] - ULT_POW_NOISE and ef <= Balance.ULT_POWER_BAND[1] + ULT_POW_NOISE, "suprema %s: força em alvo único na faixa %.0f-%.0f de poder (decisão 2026-11-19; %.1f)" % [
				sid, Balance.ULT_POWER_BAND[0], Balance.ULT_POWER_BAND[1], ef])
		if c[1] == "duelista":
			check(duel_max >= int(Balance.ULT_NUMBERS["ass_ult_grand_duel"]["hit_cap"]) * int(Balance.ULT_NUMBERS["ass_ult_grand_duel"]["hit_gain"]),
				"Duelo Supremo: só os seus golpes já enchem o contador do Duelo (%d) sem ninguém bater nele" % duel_max)

## Um lançamento (ou, com `use_ult` falso, só os básicos) contra um chefe parado: {"id", "ult" (dano da Suprema no alvo),
## "total" (todo o dano no alvo), "ref" (golpe médio de poder 1,0), "duel" (maior contador do Duelo)}.
func _ult_pow_run(gd, sim, m: Dictionary, at: Vector3, bid: String, c: Array, use_ult: bool) -> Dictionary:
	var e := _ult_b2_char(gd, sim, c[0], c[1], at, "UltPow")
	if c[1] == "fera":
		e.form = "wolf"                      # Lua Rubra: só como lobo
		e.recompute_stats()
	e.facing = 0.0
	var t: SimEntity = _ult_mob(gd, sim, bid, e.position + e.forward() * maxf(1.2, float(c[2])))
	t.position.y = 0.0
	var s: SkillDef = UltimateSystem.ultimate_of(sim, e)
	var kind: int = SkillDef.Kind.MAGICAL if s.kind == SkillDef.Kind.MAGICAL else SkillDef.Kind.PHYSICAL
	var ref := 0.0
	for i in range(400):
		ref += float(Combat.calc_damage(e, t, 1.0, kind, sim.rng, e.position)["amount"])
	ref /= 400.0
	if c[1] == "laminas":                # Toxina Real: o que ela dobra = os venenos da build (Lâmina Pestilenta + Virulência)
		sim._apply_effects(e, e, {"buff": gd.skills["ass_plague_blade"].effects["buff"]}, 1.0)
		sim._apply_effects(e, t, {"dot": (gd.skills["ass_virulence"].effects["dot"] as Dictionary).merged({"skill": "ass_virulence"})}, 1.0)
	if c[1] == "pestilento":             # Eclipse: o que ele multiplica = as maldições/danos no tempo da build
		sim._apply_effects(e, t, {"dot": (gd.skills["nec_pandemic"].effects["dot"] as Dictionary).merged({"skill": "nec_pandemic"})}, 1.0)
	e.ult_charge = Balance.ULT_MAX
	e.ult_gap_until = 0.0
	e.ult_combat_t = sim.time + 100.0
	var got := [0.0, e.ult_dealt, 0.0]
	var trace := OS.get_cmdline_user_args().has("--ult_pow_trace")
	var cb := func(a: int, b: int, amount: int, _c: bool, _bl: bool, _k: String):
		if a == e.id:
			if b == t.id:
				got[0] += e.ult_dealt - float(got[1])     # a parte da Suprema neste golpe (somada antes do evento)
				got[2] += float(amount)
				if trace and e.ult_dealt > float(got[1]):
					print("  ULT_HIT %s %.0f %s t=%.2f" % [e.build_id, e.ult_dealt - float(got[1]), _k, sim.time])
			got[1] = e.ult_dealt
	Events.damage_dealt.connect(cb)
	if trace:
		print("  ULT_RUN %s ref=%.0f patk=%.0f matk=%.0f crit=%.1f" % [c[1], ref, e.stats.patk, e.stats.matk, e.stats.crit_phys])
	if use_ult:
		UltimateSystem.try_cast(sim, e, t.position, m)
	var cmd := InputCommand.new()
	cmd.attack = true
	var dt := 1.0 / 60.0
	var duel_max := 0
	for i in range(int(14.0 / dt)):
		sim.time += dt
		var in_ult: bool = e.state == SimEntity.State.CASTING and e.current_skill != null and e.current_skill.ultimate
		if c[3] and not in_ult and i * dt < 11.0:
			cmd.aim = t.position
			sim._apply_command(e, cmd, m, dt)
		sim._update_entity(e, m, dt)
		sim._update_entity(t, m, dt)
		StormSystem.tick(sim, m)
		TrapSystem.update_traps(sim, m)
		AuraSystem.tick(sim, m, dt)
		sim._update_projectiles(m, dt)
		if in_ult:
			e.skill_aim = t.position
		if i % 30 == 0:
			e.facing = atan2(t.position.x - e.position.x, t.position.z - e.position.z)
		for b in e.buffs:
			if b.has("duel_cap"):
				duel_max = maxi(duel_max, int(b.get("duel", 0)))
	Events.damage_dealt.disconnect(cb)
	for x in (m.get("storms", []) as Array).duplicate():
		if int(x["owner"]) == e.id:
			m["storms"].erase(x)
	m["ally_strikes"] = (m.get("ally_strikes", []) as Array).filter(func(h): return int(h["owner"]) != e.id)
	m["traps"] = (m.get("traps", []) as Array).filter(func(h): return int(h.get("owner", -1)) != e.id)
	sim.despawn(t)
	sim.despawn(e)
	return {"id": s.id, "ult": got[0], "total": got[2], "ref": ref, "duel": duel_max}

## Laço Selvagem / Maré dos Mortos: a defesa que o lince herda do dono (PET_DEF_SHARE) fica depois que o buff de invocação acaba
## (o recompute_stats do fim do buff a perdia).
func _check_ultimate_pet_def(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var e := _ult_b2_char(gd, sim, "ranger", "cacador", at, "UltPetDef")
	var sm: Dictionary = gd.skills["ran_companion"].effects["summon"]
	var pet: SimEntity = sim.spawn_summon(e, gd.monsters[str(sm["monster_id"])], at + Vector3(1.2, 0, 0), 0.0, bool(sm.get("owner_stats", false)))
	pet.brain = null
	var pd: float = pet.stats.pdef
	check(pd > 0.0 and is_equal_approx(pd, e.stats.pdef * Balance.PET_DEF_SHARE), "Laço: o lince nasce com a defesa herdada do dono (%.1f)" % pd)
	var wb: Dictionary = gd.skills["ran_ult_wild_bond"].effects["pet_revive"]
	for buff in [wb["buff"], {"id": "tide_frenzy", "duration": 5.0, "aspd_pct": 25.0}]:
		UltEffects.pet_buff(pet, buff)
		for b in pet.buffs:
			if b.get("id") == buff["id"]:
				b["remaining"] = 0.01
		sim._update_entity(pet, m, 0.05)
		check(not pet.buffs.any(func(b): return b.get("id") == buff["id"]) and is_equal_approx(pet.stats.pdef, pd),
			"Laço: acabou o buff %s e o lince mantém a defesa herdada (%.1f -> %.1f)" % [buff["id"], pd, pet.stats.pdef])
	sim.despawn(pet)
	sim.despawn(e)

## Cúpula da Graça (decisão 2026-11-19): fica no chão até acabar, mesmo com o Sacerdote morto (efeito posto para salvar o grupo).
func _check_ultimate_dome_stays(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := _ult_open(sim)
	var pr := _ult_b2_char(gd, sim, "bishop", "sacerdote", at, "UltDomePr")
	var ally := _ult_b2_char(gd, sim, "paladin", "guardiao", at + Vector3(2, 0, 0), "UltDomeAl")
	pr.party_id = 9601
	ally.party_id = 9601
	var mob := _ult_mob(gd, sim, "golem", at + Vector3(0, 0, 4))
	_ult_b2_fire(sim, pr, at + Vector3(1, 0, 0), m)
	var domes: Array = (m.get("barriers", []) as Array).filter(func(b): return int(b["owner"]) == pr.id and b.get("dome", false))
	check(domes.size() == 1, "Cúpula: posta no chão")
	sim._kill(pr, mob)
	ChoirSystem.tick(sim, m, 0.1)
	var left: Array = (m.get("barriers", []) as Array).filter(func(b): return int(b["owner"]) == pr.id and b.get("dome", false))
	check(left.size() == 1, "Cúpula: o Sacerdote caiu e ela fica até acabar")
	check(ChoirSystem.damage_in(sim, mob, ally, 100) == int(round(100 * (1.0 - float(Balance.ULT_NUMBERS["bis_ult_grace_dome"]["dr"]) / 100.0))),
		"Cúpula: com o Sacerdote caído ainda corta o dano do grupo dentro (%d)" % ChoirSystem.damage_in(sim, mob, ally, 100))
	if left.size() == 1:
		left[0]["until"] = sim.time - 0.01
	ChoirSystem.tick(sim, m, 0.1)
	check(not (m.get("barriers", []) as Array).any(func(b): return int(b["owner"]) == pr.id and b.get("dome", false)), "Cúpula: some no fim do tempo")
	for o in [pr, ally]:
		o.party_id = -1
		sim.despawn(o)
	sim.despawn(mob)
