	check(members.size() == 5 and members.all(func(m): return m.map_id == "field_ruins" and m.level == 20), "começo 20: grupo de 5 nas Ruínas, nível 20")
	for m in members:
		if m != e:
			sim.despawn(m)
	sim.despawn(e)

## Investida: a leitura da apresentação (faixa do HUD e minimapa) acompanha a leva.
func _check_raid_status(gd, sim) -> void:
	check(sim.raid_status("city_aldara").is_empty(), "investida: mapa sem investida não tem estado")
	var m: Dictionary = sim.maps["field_forest"]
	var before: Dictionary = sim.raid_status("field_forest")
	check(not before.is_empty() and before.has("next_in") and before.has("target"), "investida: estado com contagem e alvo")
	if not (m.get("raid", {}).get("ids", []) as Array).is_empty():
		return                              # outro check deixou uma leva viva: não mexe
	var ids: Array = RaidSystem.start_raid(sim, m)
	var rs: Dictionary = sim.raid_status("field_forest")
	check(rs["active"] and rs["total"] == ids.size() and rs["alive"] == ids.size() and rs["phase"] == "march", "investida: leva ativa marchando (%d/%d)" % [rs["alive"], rs["total"]])
	var first: SimEntity = sim.entities.get(ids[0])
	first.hp = 0.0
	first.set_state(SimEntity.State.DEAD)
	check(sim.raid_status("field_forest")["alive"] == ids.size() - 1, "investida: abate desconta da faixa")
	for id in ids:
		var x: SimEntity = sim.entities.get(id)
		if x != null:
			sim.despawn(x)
	RaidSystem.update_raids(sim, m, 0.1)
	check(not sim.raid_status("field_forest")["active"], "investida: leva desfeita volta à contagem")

## Defesa do portão: bot perto do povoado larga a caça e vai ao portão atacado; Bastião (defesa + regeneração)
## só perto das muralhas; ferido recua para dentro; bot do meio do jogo anda com poções (M).
func _check_raid_defense(gd, sim) -> void:
	var ws := WorldSim.new()
	ws.rng.seed = 11
	var def: MapDef = gd.maps["field_forest"].duplicate()
	check(not def.raid.is_empty(), "defesa: Floresta tem investida")
	if def.raid.is_empty():
		return
	def.spawners = []
	def.raid = def.raid.duplicate(true)
	def.raid["first"] = 999.0
	def.raid["lifetime"] = 400.0
	def.raid["waves"] = [{"mobs": {"elf_raider": 2, "elf_raider_archer": 1}}]
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(def)
	var target: Vector3 = def.raid["target"]
	var gate := RaidSystem.gate_point(def)
	check(gate.distance_to(target) > 5.0 and gate.distance_to(def.raid["route"][def.raid["route"].size() - 1]) < 8.0, "defesa: portão atacado é o do fim da rota (%s)" % str(gate))
	var b: SimEntity = ws.spawn_bot(gd.classes["paladin"], "Def", def.id, ws.random_walkable(def, target + Vector3(40, 0, 10), 4.0), 16)
	check(b.potion_slots[0] == "potion_hp_m" and b.has_item("potion_hp_m"), "defesa: bot nível 16 anda com Poção de Vida (M)")
	var low: SimEntity = ws.spawn_bot(gd.classes["ranger"], "Novato", "city_aldara", Vector3(0, 0, 8), 3)
	check(low.potion_slots[0] == "potion_hp_s", "defesa: bot de nível baixo continua com a (P)")
	ws.despawn(low)
	var far: SimEntity = ws.spawn_bot(gd.classes["ranger"], "Longe", def.id, ws.random_walkable(def, target + Vector3(0, 0, 0), 2.0), 16)
	far.position = ws.random_walkable(def, target + Vector3(80, 0, 62), 6.0)   # bem longe do povoado (e da rota)
	var ids: Array = RaidSystem.start_raid(ws, m)
	var wave: int = ws.raid_status(def.id)["wave"]
	b.brain.skip_wave = -1
	b.brain.rng.seed = 1
	var d0 := b.position.distance_to(gate)
	for i in 14 * 20:                         # leva ainda na garganta (trompas): o bot chega ao portão
		ws.tick(1.0 / 20.0)
	check(b.brain.defend_wave == wave or b.brain.skip_wave == wave, "defesa: bot decide uma vez por leva")
	if b.brain.skip_wave == wave:              # sorteio negou: força a decisão para conferir o resto
		b.brain.skip_wave = -1
		b.brain.defend_wave = wave
		for i in 14 * 20:
			ws.tick(1.0 / 20.0)
	check(b.position.distance_to(gate) < 8.0 and b.position.distance_to(gate) < d0, "defesa: bot vai ao portão atacado (%.1f m, antes %.1f)" % [b.position.distance_to(gate), d0])
	check(far.brain.defend_wave != wave, "defesa: bot longe do povoado não larga a caça")
	var bastion := b.buffs.filter(func(x): return x.get("id") == "bastion")
	check(bastion.size() == 1 and float(bastion[0]["def_pct"]) == Balance.RAID_RALLY_DEF_PCT, "defesa: Bastião no defensor junto da muralha")
	check(not far.buffs.any(func(x): return x.get("id") == "bastion"), "defesa: sem Bastião longe das muralhas")
	var pdef_with := b.stats.pdef
	b.hp = b.stats.max_hp * 0.5
	var hp0 := b.hp
	for i in 20:
		ws.tick(1.0 / 20.0)
	check(b.hp > hp0, "defesa: Bastião regenera vida (%.0f -> %.0f)" % [hp0, b.hp])
	# ferido: recua para dentro das muralhas
	b.hp = b.stats.max_hp * 0.2
	b.potion_cd = 99.0
	for i in 3 * 20:
		ws.tick(1.0 / 20.0)
	check(b.brain.falling_back and b.position.distance_to(target) < gate.distance_to(target) - 2.0, "defesa: ferido recua para dentro (%.1f m do centro)" % b.position.distance_to(target))
	b.potion_cd = 0.0
	# leva desfeita: Bastião some, bot solto
	for id in ids:
		var x: SimEntity = ws.entities.get(id)
		if x != null:
			ws.despawn(x)
	for i in 3 * 20:
		ws.tick(1.0 / 20.0)
	check(not b.buffs.any(func(x): return x.get("id") == "bastion") and b.stats.pdef < pdef_with, "defesa: Bastião some depois da leva")
	check(b.brain.defend_wave == -1, "defesa: bot volta à rotina")

## Força da investida pelo nível do jogador: passo 0 até RAID_SCALE_FROM, sobe por nível até RAID_SCALE_TO (teto);
## invasor reforçado tem o mesmo id (quest conta), mais nível/vida/ataque/XP; passos altos trazem reforço na leva.
func _check_raid_scaling(gd, sim) -> void:
	var ws := WorldSim.new()
	ws.rng.seed = 5
	var def: MapDef = gd.maps["field_forest"].duplicate()
	def.spawners = []
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(def)
	for o in m["entities"].duplicate():
		if o.guard:
			ws.despawn(o)
	ws.player = ws.spawn_player(gd.classes["berserker"], "Escala", def.id)
	ws.player.position = ws.random_walkable(def, def.raid["target"] + Vector3(0, 0, 10), 3.0)
	var steps := {}
	for lv in [10, Balance.RAID_SCALE_FROM, Balance.RAID_SCALE_FROM + 2, Balance.RAID_SCALE_TO, 30]:
		ws.player.level = lv
		steps[lv] = RaidSystem.power_step(ws, m)
	check(steps[10] == 0 and steps[Balance.RAID_SCALE_FROM] == 0 and steps[Balance.RAID_SCALE_FROM + 2] == 2, "investida: força sobe com o nível do jogador (%s)" % str(steps))
	check(steps[Balance.RAID_SCALE_TO] == steps[30] and steps[30] == Balance.RAID_SCALE_TO - Balance.RAID_SCALE_FROM, "investida: força para no nível %d" % Balance.RAID_SCALE_TO)
	var base: MonsterDef = gd.monsters["elf_raider"]
	var top := RaidSystem.scaled_def(ws, base, steps[30])
	check(top.id == base.id and top.level == base.level + steps[30] and top.hp > base.hp * 1.3 and top.atk > base.atk * 1.2 and top.xp > base.xp, "investida: invasor reforçado (nv %d, %.0f HP, %.0f ATK)" % [top.level, top.hp, top.atk])
	var s0 := RaidSystem.scaled_def(ws, base, 0)
	check(s0.level == base.level and is_equal_approx(s0.hp, base.hp * Balance.RAID_POWER) and is_equal_approx(s0.atk, base.atk * Balance.RAID_POWER) and s0.aggro_range > base.aggro_range,
		"investida: força 0 = base x RAID_POWER (HP/ATK) e aggro maior")
	check(RaidSystem.scaled_def(ws, base, 3) == RaidSystem.scaled_def(ws, base, 3), "investida: reforço guardado por passo")
	check(base.level == 16 and base.hp == gd.monsters["elf_raider"].hp, "investida: monstro base não muda")
	# Kharzun (usuário 2026-11-13): RAID_MAP_POWER só na leva do mapa dela; o monstro do campo não muda
	var kmp: float = float(Balance.RAID_MAP_POWER.get("field_kharzun", 1.0))
	var kz := RaidSystem.scaled_def(ws, base, 0, "field_kharzun")
	check(is_equal_approx(kz.hp, base.hp * Balance.RAID_POWER * kmp) and is_equal_approx(kz.atk, base.atk * Balance.RAID_POWER * kmp) and is_equal_approx(kz.matk, base.matk * Balance.RAID_POWER * kmp)
		and is_equal_approx(kz.def, s0.def), "investida de Kharzun: vida/ATK x RAID_MAP_POWER %.2f (defesa igual)" % kmp)
	check(is_equal_approx(RaidSystem.scaled_def(ws, base, 0, "field_forest").hp, s0.hp) and (kz != s0 or is_equal_approx(kmp, 1.0)), "investida: mapa sem RAID_MAP_POWER = x1, guardado por mapa")
	var kdef: MapDef = gd.maps["field_kharzun"]
	var km: Dictionary = ws.load_map(kdef)
	var kids: Array = RaidSystem.start_raid(ws, km)
	var k_ok := kids.size() > 0
	for id in kids:
		var ke: SimEntity = ws.entities.get(id)
		if ke != null and ke.monster_def != null and not ke.monster_def.id.begins_with("boss_"):
			var wild: MonsterDef = gd.monsters[ke.monster_def.id]
			k_ok = k_ok and (ke.monster_def == RaidSystem.scaled_def(ws, wild, RaidSystem.power_step(ws, km), kdef.id) or ke.monster_def.elite_of != "")
		if ke != null:
			ws.despawn(ke)
	check(k_ok, "investida de Kharzun: a leva nasce com a força do mapa (%d invasores)" % kids.size())
	for _i in range(3):
		MobSystem.update_spawners(ws, km, 100.0)       # enche os spawners do campo
	var wild_n := 0
	var wild_ok := true
	for o: SimEntity in km["entities"]:
		if o.kind == SimEntity.Kind.MONSTER and o.raid_id < 0 and o.monster_def != null and gd.monsters.has(o.monster_def.id):
			wild_n += 1
			wild_ok = wild_ok and not ws._raid_defs.values().has(o.monster_def)
	check(wild_n > 0 and wild_ok, "comuns do campo de Kharzun sem RAID_MAP_POWER (%d)" % wild_n)
	ws.player.level = 10
	var weak: Array = RaidSystem.start_raid(ws, m)
	var n_weak := weak.size()
	var lv_weak: int = ws.raid_status(def.id)["level"]
	for id in weak:
		ws.despawn(ws.entities[id])
	RaidSystem.update_raids(ws, m, 0.1)
	RaidSystem.state(m)["n"] = 0                 # mesma leva de antes, agora com o jogador no nível máximo da força
	ws.player.level = 30
	var strong: Array = RaidSystem.start_raid(ws, m)
	var rs: Dictionary = ws.raid_status(def.id)
	check(strong.size() > n_weak and rs["step"] == steps[30] and rs["level"] > lv_weak, "investida: leva forte maior e de nível maior (%d -> %d, nv %d -> %d)" % [n_weak, strong.size(), lv_weak, rs["level"]])
	var r0: SimEntity = ws.entities[strong[0]]
	check(r0.level == r0.monster_def.level and r0.stats.max_hp == r0.monster_def.hp and r0.monster_def.level > gd.monsters[r0.monster_def.id].level, "investida: invasor nasce com os números reforçados")
	for id in strong:
		ws.despawn(ws.entities[id])
	ws.despawn(ws.player)
	ws.player = null

## Faixa 10-20: chefes com repertório (3+ golpes somando as fases), fala de abertura uma vez por luta e fala ao cair;
## capanga do Chefe dos Bandidos sem XP; skills novas existem e estão no tema certo.
## Assinaturas dos chefes (GDD design/gdd/act2-boss-signatures.md, AC-S1/S2): 1 por chefe com assinatura, aviso mínimo,
## efeitos conhecidos. Hoje: os 6 chefes fora de Kharzun + Shazka, Ulgra, Gorbash e Kragmar (Durgash num trabalho à parte).
const SIG_BOSSES := {"boss_tide_mother": "mob_tide_flood", "boss_agitator_lord": "mob_drum_frenzy", "boss_troll_king": "mob_troll_avalanche",
	"boss_crossbow_master": "mob_marksman_brand", "boss_ghar": "mob_ghar_wall", "boss_dire_mother": "mob_dire_pounce",
	"boss_shazka": "mob_shazka_twins", "boss_ulgra": "mob_ulgra_stampede", "boss_gorbash": "mob_gorbash_waves", "boss_kragmar": "mob_kragmar_temper",
	"boss_durgash": "mob_durgash_throneaxe"}

## Aviso (s) que a assinatura dá antes do dano, lido dos dados.
static func _sig_warn(s: SkillDef) -> float:
	var fx := s.effects
	if fx.has("islands"):
		return float(fx["islands"].get("delay", 0.0))
	if fx.has("mark"):
		return float(fx["mark"].get("time", Balance.BOSS_MARK_TIME))
	if fx.has("boss_channel"):
		return s.active
	if fx.has("avalanche"):
		return s.startup
	if fx.has("wall"):
		return float(fx["wall"].get("time", 0.0))
	if fx.has("decoys"):
		return float(fx.get("stealth", 0.0))          # a fumaça antes das cópias (elas não dão dano de área; a nuvem só morrendo)
	if fx.get("barrage") is Dictionary:
		return float(fx["barrage"].get("delay", Balance.BOSS_HAZARD_DELAY))
	return s.startup

func _check_boss_signatures(gd) -> void:
	for k in ["islands", "mark", "boss_channel", "repeat", "avalanche", "wall", "decoys"]:
		check(k in SkillDef.EFFECT_KEYS, "assinaturas: efeito %s em SkillDef.EFFECT_KEYS" % k)
	var owners := {}
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		var ids: Array = md.skill_ids.duplicate()      # cópia: Array(tipado) devolve o MESMO array (append mexeria no MonsterDef)
		for ph in md.phases:
			ids.append_array(ph.get("skills", []))
		var sigs: Array = ids.filter(func(id): return gd.skills.has(id) and (gd.skills[id] as SkillDef).boss_signature)
		for id in sigs:
			owners[id] = int(owners.get(id, 0)) + 1
		if SIG_BOSSES.has(mid):
			check(sigs.size() == 1 and sigs[0] == SIG_BOSSES[mid], "AC-S1 %s: exatamente 1 assinatura (%s)" % [mid, ", ".join(sigs)])
		elif not sigs.is_empty():
			check(md.is_boss, "assinatura só em chefe (%s)" % mid)
	for id in gd.skills:
		var s: SkillDef = gd.skills[id]
		if not s.boss_signature:
			continue
		check(int(owners.get(id, 0)) == 1, "assinatura %s pertence a um chefe só (%d)" % [id, int(owners.get(id, 0))])
		var warn := _sig_warn(s)
		var need := Balance.BOSS_SIG_REPEAT_WARN_MIN if s.effects.has("repeat") else Balance.BOSS_SIG_WARN_MIN
		check(warn >= need - 0.001, "AC-S2 %s avisa %.1f s (mín. %.1f)" % [id, warn, need])
		check(s.cooldown >= 15.0 and s.cooldown <= 40.0, "%s: intervalo %.0f s na faixa 15-40 (GDD §7)" % [id, s.cooldown])
	var troll: MonsterDef = gd.monsters["boss_troll_king"]
	check(float(troll.cover.get("radius", 0.0)) > 0.0 and "mob_boulder_barrage" in troll.cover.get("skills", []), "Troll Rei: a Chuva de Pedras deixa pedregulho (MonsterDef.cover)")
	# soma ao kit (OQ-1): nada do kit atual saiu
	for mid in SIG_BOSSES:
		var md: MonsterDef = gd.monsters[mid]
		var kit: Array = md.skill_ids.duplicate()      # cópia: Array(tipado) devolve o MESMO array (append mexeria no MonsterDef)
		for ph in md.phases:
			kit.append_array(ph.get("skills", []))
		kit = kit.filter(func(id): return not (gd.skills[id] as SkillDef).boss_signature)
		# Mãe Atroz e Kragmar têm 3 no kit atual (GDD 3.6/3.10; o >= 4 do Kragmar só passava com o vazamento que dobrava as fases)
		check(kit.size() >= (3 if mid in ["boss_dire_mother", "boss_kragmar"] else 4), "%s: kit atual mantido (%d skills)" % [mid, kit.size()])

## Conferir o kit dos chefes não mexe no MonsterDef (Array(tipado) devolve o MESMO array: o append das fases ia para
## skill_ids e, rodando duas vezes (--only=boss_sig,zone), a assinatura aparecia 3 vezes). Roda as conferências 2x e compara.
func _check_boss_sig_idempotent(gd) -> void:
	var before := {}
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		before[mid] = [md.skill_ids.duplicate(), md.phases.map(func(ph): return Array(ph.get("skills", [])).duplicate())]
	var bap = load("res://tools/tests/boss_anim_probe.gd")
	for i in 2:
		_check_boss_signatures(gd)
		bap.check_boss("boss_gorbash", self)      # assinatura na fase: o caso que vazava
	var changed: Array = []
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		var now := [md.skill_ids.duplicate(), md.phases.map(func(ph): return Array(ph.get("skills", [])).duplicate())]
		if now != before[mid]:
			changed.append(mid)
	check(changed.is_empty(), "conferir assinaturas 2x não muda skill_ids/fases dos monstros (%s)" % ", ".join(changed))
	for mid in SIG_BOSSES:
		var md: MonsterDef = gd.monsters[mid]
		var n := Array(md.skill_ids).count(SIG_BOSSES[mid])
		for ph in md.phases:
			n += Array(ph.get("skills", [])).count(SIG_BOSSES[mid])
		check(n == 1, "%s: assinatura %s uma vez só no kit depois de conferir 2x (%d)" % [mid, SIG_BOSSES[mid], n])

## Regras compartilhadas R-A..R-D e únicas R-E/R-G (AC-S3, AC-S4), com um mundo só para o teste.
func _check_boss_sig_rules(gd) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["dg_ninho"])
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		ws.despawn(e)
	var at := Vector3.ZERO
	for sp in gd.maps["dg_ninho"].spawners:
		if sp["monster_id"] == "spider_queen":
			at = sp["pos"]
	at.y = 0.0
	var mkboss := func(id: String, pos: Vector3) -> SimEntity:
		var d: MonsterDef = gd.monsters[id].duplicate()
		d.phases = []
		d.berserk_after = 0.0
		d.aggro_range = 0.0
		d.escort = {}
		var b: SimEntity = ws.spawn_monster(d, "dg_ninho", pos)
		b.brain = null
		return b
	var mkbot := func(cname: String, pos: Vector3) -> SimEntity:
		var b: SimEntity = ws.spawn_bot(gd.classes[cname], cname, "dg_ninho", pos, 40)
		b.brain = null
		b.stats.max_hp = 100000.0              # ninguém morre no meio do teste (morto não leva efeito)
		b.hp = b.stats.max_hp
		return b
	var tank: SimEntity = mkbot.call("paladin", at + Vector3(2, 0, 0))
	var dps: SimEntity = mkbot.call("berserker", at + Vector3(-2, 0, 0))
	var far: SimEntity = mkbot.call("ranger", at + Vector3(0, 0, 8))
	var heal := func() -> void:
		for o in [tank, dps, far]:
			o.hp = o.stats.max_hp
			o.debuffs.clear()
			o.set_state(SimEntity.State.IDLE)
	# --- R-A formas: faixa e anel ---
	var line := {"pos": at, "dir": Vector3(1, 0, 0), "length": 10.0, "width": 2.0, "shape": "line"}
	check(BossSignatures.inside(line, at + Vector3(5, 0, 0.9)) and not BossSignatures.inside(line, at + Vector3(5, 0, 1.6)) and not BossSignatures.inside(line, at + Vector3(11, 0, 0)),
		"R-A faixa: acerta dentro da largura, não ao lado nem além do fim")
	check(BossSignatures.escape(line, at + Vector3(5, 0, 0.5), 0.5).is_equal_approx(Vector2(0, 1)), "R-A faixa: o desvio é de lado (para o vão)")
	var ring := {"pos": at, "inner": 4.0, "radius": 6.0, "shape": "ring"}
	check(BossSignatures.inside(ring, at + Vector3(5, 0, 0)) and not BossSignatures.inside(ring, at + Vector3(2, 0, 0)) and not BossSignatures.inside(ring, at + Vector3(8, 0, 0)),
		"R-A anel: acerta entre inner e radius, não dentro nem fora")
	check(BossSignatures.escape(ring, at + Vector3(4.5, 0, 0), 0.0).x < 0.0 and BossSignatures.escape(ring, at + Vector3(5.6, 0, 0), 0.0).x > 0.0, "R-A anel: sai pelo lado mais perto")
	var boss: SimEntity = mkboss.call("boss_ulgra", at)
	boss.aggro_target = tank.id
	var lb := {"shape": "line", "count": 3, "width": 3.0, "gap": 3.0, "length": 24.0, "delay": 2.0, "stagger": 0.6}
	var ls: SkillDef = gd.skills["mob_ghar_quake"]
	tank.position = at + Vector3(0, 0, 6)
	dps.position = at + Vector3(3.0, 0, 6)                 # no vão entre a 1ª e a 2ª faixa
	tank.stats.evasion = 100.0                             # esquiva total: a zona avisada pega mesmo assim (decisão 2026-11-13)
	MobSystem.place_barrage(ws, boss, ls, tank.position, 1.5, {"barrage": lb})
	var hz: Array = m["hazards"]
	check(hz.size() == 3 and hz.all(func(h): return h["shape"] == "line") and float(hz[2]["at"]) > float(hz[0]["at"]), "R-A barrage line: 3 faixas em sequência")
	var hp_t: float = tank.hp
	var hp_d: float = dps.hp
	ws.time += 2.0 + 1.3
	MobSystem.update_hazards(ws, m)
	check(tank.hp < hp_t and is_equal_approx(dps.hp, hp_d) and hz.is_empty(), "R-A faixa cai: o tanque sob ela leva, quem está no vão não")
	check(tank.hp < hp_t, "zona avisada: alvo com 100% de esquiva leva o dano da faixa (só sair dela salva)")
	hp_t = tank.hp
	BossSignatures._hit(ws, boss, tank, 1.0, SkillDef.Kind.MAGICAL, {}, boss.position)
	check(tank.hp < hp_t, "zona avisada: golpe de assinatura (BossSignatures._hit) ignora a esquiva passiva")
	hp_t = tank.hp
	ws._deal_damage(boss, tank, 50, false, false, "physical")
	check(is_equal_approx(tank.hp, hp_t), "esquiva 100%: golpe direto comum continua esquivado")
	tank.recompute_stats()
	tank.stats.max_hp = 100000.0
	ws.despawn(boss)
	heal.call()
	# --- R-A invertido: Maré Cheia ---
	tank.position = at + Vector3(2, 0, 0)
	dps.position = at + Vector3(-5, 0, 0)
	far.position = at + Vector3(0, 0, 8)
	var tide: SimEntity = mkboss.call("boss_tide_mother", at)
	tide.aggro_target = tank.id
	tide.crowd = 3
	var fs: SkillDef = gd.skills["mob_tide_flood"]
	BossSignatures.place_islands(ws, tide, fs, fs.power, fs.effects)
	var isl: Array = m["hazards"].filter(func(h): return h.get("invert", false))
	check(isl.size() >= Balance.TIDE_ISLAND_MIN and isl.any(func(h): return BossSignatures.inside(h, tank.position)), "Maré Cheia: %d ilhas, uma no tanque" % isl.size())
	check(BossSignatures.ground_busy(m, tide), "Maré Cheia pendente: a chuva espera (uma mecânica de chão por vez)")
	for h in isl:
		check(not BossSignatures.inside(h, dps.position), "dps fora das ilhas")
	far.position = Vector3(isl[-1]["pos"].x, 0, isl[-1]["pos"].z)          # far correu para uma ilha
	hp_t = tank.hp
	hp_d = dps.hp
	var hp_f: float = far.hp
	MobSystem.update_hazards(ws, m)
	check(tank.hp == hp_t and dps.hp == hp_d, "Maré Cheia: nada antes do aviso acabar")
	ws.time += float(fs.effects["islands"]["delay"]) + 0.1
	MobSystem.update_hazards(ws, m)
	check(tank.hp == hp_t and far.hp == hp_f, "AC Maré: dentro da ilha leva 0")
	check(dps.hp < hp_d and dps.debuffs.any(func(d): return d.get("kind") == "slow"), "AC Maré: fora leva dano e fica lento")
	check(m["hazards"].is_empty(), "Maré Cheia: todas as ilhas do grupo somem juntas")
	ws.despawn(tide)
	heal.call()
	# --- R-B marca que segue (spread) + chão que fica ---
	var vor: SimEntity = mkboss.call("boss_crossbow_master", at)
	vor.aggro_target = tank.id
	tank.position = at + Vector3(2, 0, 0)
	far.position = at + Vector3(0, 0, 8)
	dps.position = at + Vector3(-12, 0, 0)
	var ms: SkillDef = gd.skills["mob_marksman_brand"]
	var one: Dictionary = ms.effects.duplicate(true)
	one["mark"]["count"] = 1
	ws.rng.seed = 7
	dps.position = at + Vector3(0, 0, -40)                  # fora: só tanque e far na mira (sem o tanque)
	BossSignatures.place_marks(ws, vor, ms, ms.power, one)
	var mk: Array = m["hazards"].filter(func(h): return h.get("mark", false))
	check(mk.size() == 1 and int(mk[0]["victim"]) == far.id, "Marca do Atirador: não marca o tanque se há outro")
	far.position = at + Vector3(4, 0, 8)
	MobSystem.update_hazards(ws, m)
	check((mk[0]["pos"] as Vector3).distance_to(Vector3(far.position.x, 0, far.position.z)) < 0.01, "AC-S3 follow: a marca segue a vítima")
	dps.position = far.position + Vector3(1.5, 0, 0)        # aliado colado na marca
	hp_d = dps.hp
	hp_f = far.hp
	hp_t = tank.hp
	ws.time += float(ms.effects["mark"]["time"]) + 0.05
	MobSystem.update_hazards(ws, m)
	check(far.hp < hp_f and dps.hp < hp_d and tank.hp == hp_t, "AC Vorgul: a marca explode em quem está no raio (e só neles)")
	check(m["hazards"].size() == 1 and m["hazards"][0].get("landed", false), "marca deixa fogo no chão (linger)")
	hp_d = dps.hp
	ws.time += Balance.BOSS_LINGER_TICK + 0.01
	MobSystem.update_hazards(ws, m)
	check(dps.hp < hp_d, "chão que fica: tique em quem pisa")
	ws.time += 10.0
	MobSystem.update_hazards(ws, m)
	check(m["hazards"].is_empty(), "chão que fica some depois de linger")
	# vítima some: a marca fica onde estava
	BossSignatures.place_marks(ws, vor, ms, ms.power, one)
	var mk2: Dictionary = m["hazards"][-1]
	var v2: SimEntity = ws.entities.get(int(mk2["victim"]))
	var stay: Vector3 = mk2["pos"]
	v2.stealth_left = 5.0
	v2.position += Vector3(6, 0, 0)
	MobSystem.update_hazards(ws, m)
	check((mk2["pos"] as Vector3).is_equal_approx(stay) and not mk2.has("follow"), "vítima furtiva: a marca fica parada onde estava")
	v2.stealth_left = 0.0
	m["hazards"].clear()
	ws.despawn(vor)
	heal.call()
	# --- R-B soak: dividido por quem está dentro (F-S1) ---
	var dur: SimEntity = mkboss.call("boss_ulgra", at)
	dur.aggro_target = tank.id
	var soak := {"mark": {"mode": "soak", "count": 1, "radius": 3.5, "time": 5.0, "no_tank": false}}
	var solo_dmg := 0.0
	ws.rng.seed = 11
	var group_dmg := 0.0
	for trial in range(6):
		for o in [tank, dps, far]:
			o.hp = o.stats.max_hp
		far.position = at + Vector3(0, 0, 8)
		tank.position = at + Vector3(0, 0, 30)
		dps.position = at + Vector3(0, 0, 31)
		var with_group: bool = trial % 2 == 1
		if with_group:
			tank.position = far.position + Vector3(1, 0, 0)
			dps.position = far.position + Vector3(-1, 0, 0)
		BossSignatures.add_hazard(m, {"owner": dur.id, "pos": far.position, "radius": 3.5, "at": ws.time, "power": 6.0, "kind": SkillDef.Kind.PHYSICAL,
			"effects": {}, "skill": "mob_ghar_quake", "follow": far.id, "victim": far.id, "mode": "soak", "mark": true}, ws.time)
		ws.sig_stats.clear()
		MobSystem.update_hazards(ws, m)
		if with_group:
			group_dmg += far.stats.max_hp - far.hp
			check(int(ws.sig_stats.get("soak_n", 0)) == 3, "soak: 3 dentro")
		else:
			solo_dmg += far.stats.max_hp - far.hp
	check(group_dmg > 0.0 and group_dmg < solo_dmg * 0.5 and group_dmg > solo_dmg * 0.2, "AC-S3 soak: 3 dentro levam ~1/3 cada (%.0f vs %.0f sozinho)" % [group_dmg, solo_dmg])
	ws.despawn(dur)
	heal.call()
	# --- R-C canal (Grukk) ---
	var gru: SimEntity = mkboss.call("boss_agitator_lord", at)
	gru.aggro_target = tank.id
	tank.position = at + Vector3(2, 0, 0)
	var cs: SkillDef = gd.skills["mob_drum_frenzy"]
	ws._add_skills(gru, [cs.id])
	var slot := gru.skills.find(cs)
	var start_channel := func() -> void:
		ws._start_skill(gru, cs, slot, gru.position)
		gru.state_time = cs.startup
		ws._apply_skill(gru, cs, m)
	start_channel.call()
	check(gru.sig.has("channel") and gru.buffs.any(func(b): return b.get("id") == BossSignatures.CHANNEL_BUFF), "canal começa: estado + buff (aviso)")
	ws._deal_damage(tank, gru, int(gru.stats.max_hp * (Balance.BOSS_CHANNEL_BREAK_PCT + 0.01)), false, false, "physical")
	BossSignatures.update(ws, gru, 0.05)
	check(not gru.sig.has("channel") and gru.state == SimEntity.State.STUNNED and gru.state_duration >= Balance.BOSS_CHANNEL_STAGGER - 0.01 and gru.has_debuff("curse"),
		"AC Grukk: 6%% da vida no canal quebra (atordoado + Tambor Rasgado)")
	check(Combat.taken_pct(gru) >= Balance.BOSS_CHANNEL_VULN - 0.01, "Tambor Rasgado: +%d%% de dano recebido" % int(Balance.BOSS_CHANNEL_VULN))
	gru.set_state(SimEntity.State.IDLE)
	gru.debuffs.clear()
	gru.hp = gru.stats.max_hp
	start_channel.call()
	ws._apply_effects(tank, gru, {"stun": {"duration": 1.0}}, 1.0)
	BossSignatures.update(ws, gru, 0.05)
	check(not gru.sig.has("channel") and gru.state_duration >= Balance.BOSS_CHANNEL_STAGGER - 0.01, "AC-S3 canal: atordoar quebra")
	gru.set_state(SimEntity.State.IDLE)
	gru.debuffs.clear()
	var add: SimEntity = ws.spawn_monster(gd.monsters["goblin_rabble"], "dg_ninho", at + Vector3(3, 0, 3))
	add.brain = null
	add.boss_id = gru.id
	add.hp = add.stats.max_hp * 0.5
	var rab0 := MobSystem.adds_alive(ws, gru)
	start_channel.call()
	ws._deal_damage(tank, gru, int(gru.stats.max_hp * Balance.BOSS_CHANNEL_BREAK_PCT * 0.5), false, false, "physical")
	ws.time += cs.active + 0.01
	BossSignatures.update(ws, gru, 0.05)
	check(not gru.sig.has("channel") and gru.state != SimEntity.State.STUNNED and add.buffs.any(func(b): return b.get("id") == BossSignatures.FRENZY_BUFF),
		"AC Grukk: sem dano bastante o canal completa e a turba ganha Frenesi")
	check(add.hp > add.stats.max_hp * 0.75 and MobSystem.adds_alive(ws, gru) > rab0, "canal completo: a turba cura e chegam mais Turbas")
	for o in m["entities"].duplicate():
		if o.boss_id == gru.id:
			ws.despawn(o)
	ws.despawn(gru)
	heal.call()
	# --- R-D sequência (Mãe-Loba) ---
	var wolf: SimEntity = mkboss.call("boss_dire_mother", at)
	wolf.aggro_target = tank.id
	var ps: SkillDef = gd.skills["mob_dire_pounce"]
	ws._add_skills(wolf, [ps.id])
	var ws_slot := wolf.skills.find(ps)
	far.position = at + Vector3(0, 0, 8)
	tank.position = at + Vector3(2, 0, 0)
	var casts := 0
	var aims: Array = []
	ws._start_skill(wolf, ps, ws_slot, far.position)
	for step in range(3):
		casts += 1
		aims.append(wolf.skill_aim)
		ws._apply_skill(wolf, ps, m)
		ws._end_skill(wolf)
		far.position = wolf.position + Vector3(4, 0, 4 + step)       # a vítima anda: o próximo bote re-mira
		if wolf.sig.has("seq"):
			ws.time = float(wolf.sig["seq"]["next"]) + 0.01
			BossSignatures.update(ws, wolf, 0.05)
			if wolf.current_skill != ps:
				break
	check(casts == 3 and not wolf.sig.has("seq"), "AC Mãe-Loba: 3 botes e a sequência acaba (%d)" % casts)
	check(aims.size() == 3 and (aims[1] as Vector3).distance_to(aims[2]) > 0.5, "AC Mãe-Loba: cada bote re-mira a vítima")
	ws._end_skill(wolf)
	ws._start_skill(wolf, ps, ws_slot, far.position)
	ws._apply_skill(wolf, ps, m)
	ws._end_skill(wolf)
	ws._apply_effects(tank, wolf, {"root": {"duration": 2.0}}, 1.0)
	BossSignatures.update(ws, wolf, 0.05)
	check(not wolf.sig.has("seq"), "AC-S3 repeat: root corta a sequência")
	wolf.debuffs.clear()
	ws.despawn(wolf)
	heal.call()
	# --- R-E cobertura (Troll Rei) ---
	var troll: SimEntity = mkboss.call("boss_troll_king", at)
	troll.aggro_target = tank.id
	var av: SkillDef = gd.skills["mob_troll_avalanche"]
	BossSignatures.avalanche_prep(ws, troll, av)
	var cv: Array = BossSignatures.covers_of(m, troll.id)
	check(cv.size() == int(av.effects["avalanche"]["guarantee"]), "Avalanche sem pedra no chão: arremessa %d antes (garantia)" % cv.size())
	var c0: Dictionary = cv[0]
	var cp: Vector3 = c0["pos"]
	var dirc := Vector3(cp.x - troll.position.x, 0, cp.z - troll.position.z).normalized()
	tank.position = cp + dirc * (float(c0["radius"]) + 0.8)
	dps.position = troll.position - dirc * 5.0
	far.position = troll.position + Vector3(0, 0, 40)               # fora do alcance
	check(not BossSignatures.cover_between(m, troll, tank.position).is_empty() and BossSignatures.cover_between(m, troll, dps.position).is_empty(), "cobertura: pedra entre o chefe e o alvo")
	hp_t = tank.hp
	hp_d = dps.hp
	ws.time += 0.1
	var fx_ids: Array = []
	var grab_fx := func(sid: String, _o: Vector3, _a: Vector3, _r: float): fx_ids.append(sid)
	Events.skill_effect.connect(grab_fx)
	BossSignatures.avalanche(ws, troll, av, av.power, av.effects)
	Events.skill_effect.disconnect(grab_fx)
	check(fx_ids.has(BossSignatures.COVER_BREAK_FX) and fx_ids.has(av.id), "Avalanche avisa a pedra rachada (som %s) e o impacto" % BossSignatures.COVER_BREAK_FX)
	check(tank.hp == hp_t and dps.hp < hp_d and dps.state == SimEntity.State.STUNNED, "AC Troll: atrás da pedra leva 0; no aberto leva e cai")
	check(not BossSignatures.covers_of(m, troll.id).has(c0) and BossSignatures.covers_of(m, troll.id).size() == cv.size() - 1, "AC Troll: a pedra que protegeu racha e some")
	var bs: SkillDef = gd.skills["mob_boulder_barrage"]
	var nc := BossSignatures.covers_of(m, troll.id).size()
	MobSystem.place_barrage(ws, troll, bs, tank.position, bs.power, bs.effects)
	check(m["hazards"].filter(func(h): return h.get("cover", false)).size() == 1, "Chuva de Pedras do Troll Rei: um círculo deixa pedregulho")
	ws.time += 5.0
	MobSystem.update_hazards(ws, m)
	check(BossSignatures.covers_of(m, troll.id).size() == nc + 1, "pedregulho no chão depois da chuva")
	for i in range(5):
		BossSignatures.add_cover(ws, m, troll, at + Vector3(i * 3, 0, -6))
	check(BossSignatures.covers_of(m, troll.id).size() == Balance.TROLL_COVER_MAX, "no máximo %d pedregulhos" % Balance.TROLL_COVER_MAX)
	# reset limpa tudo (AC-S4)
	troll.sig["channel"] = {"skill": "x", "until": 0.0, "start": 0.0, "dmg": 0.0, "need": 1.0, "cfg": {}}
	troll.sig["seq"] = {"left": 1}
	troll.sig["wall"] = {"until": 0.0, "fury": 0}
	troll.put_buff({"id": BossSignatures.TEMPER_BUFF, "remaining": 1.0e9, "stacks": 3})
	BossSignatures.add_hazard(m, {"owner": troll.id, "pos": at, "radius": 3.0, "at": ws.time + 3.0, "power": 1.0, "kind": 0, "effects": {}, "skill": "x", "follow": tank.id, "mark": true}, ws.time)
	ws.reset_boss(troll)
	check(troll.sig.is_empty() and troll.buff_stacks(BossSignatures.TEMPER_BUFF) == 0 and BossSignatures.covers_of(m, troll.id).is_empty() and m["hazards"].is_empty(),
		"AC-S4 reset_boss limpa marcas, canal, sequência, Muralha, Têmpera e pedregulhos")
	ws.despawn(troll)
	heal.call()
	# --- R-G Muralha (Ghar) ---
	var ghar: SimEntity = mkboss.call("boss_ghar", at)
	ghar.aggro_target = tank.id
	tank.position = at + Vector3(0, 0, 2.5)
	dps.position = at + Vector3(0, 0, -2.5)
	ghar.face_towards(tank.position)
	var wl: SkillDef = gd.skills["mob_ghar_wall"]
	BossSignatures.wall_start(ws, ghar, wl, wl.effects)
	var g0: float = ghar.hp
	ws._deal_damage(tank, ghar, 1000, false, false, "physical")
	var front: float = g0 - ghar.hp
	g0 = ghar.hp
	ws._deal_damage(tank, ghar, 1000, false, false, "magical")
	var front_m: float = g0 - ghar.hp
	g0 = ghar.hp
	ws._deal_damage(dps, ghar, 1000, false, false, "physical")
	var back: float = g0 - ghar.hp
	check(is_equal_approx(front, 1000.0 * (1.0 - Balance.GHAR_WALL_CUT)) and is_equal_approx(front_m, front) and is_equal_approx(back, 1000.0),
		"AC Ghar: de frente perde 90%% (física e mágica), de costas passa inteiro (%.0f/%.0f/%.0f)" % [front, front_m, back])
	check(int(ghar.sig["wall"]["fury"]) == 2, "Muralha: cada golpe bloqueado soma 1 fúria")
	check(is_equal_approx(BossSignatures.counter_power(wl.effects["wall"]["counter"], 2), 1.3) and is_equal_approx(BossSignatures.counter_power(wl.effects["wall"]["counter"], 99), 2.5),
		"F-S5: contragolpe 1,0 + 0,15 × fúria, teto 2,5")
	hp_t = tank.hp
	hp_d = dps.hp
	ws.time += float(wl.effects["wall"]["time"]) + 0.01
	BossSignatures.update(ws, ghar, 0.05)
	check(not ghar.sig.has("wall") and ghar.sig.has("counter") and tank.hp == hp_t,
		"Muralha acaba: o contragolpe arma (clipe wall_counter) e ainda não bateu")
	ws.time += Balance.GHAR_COUNTER_DELAY + 0.01
	BossSignatures.update(ws, ghar, 0.05)
	check(is_equal_approx(Balance.GHAR_COUNTER_DELAY, float(int(EntityView.IMPACT_FRAME.get("wall_counter", 0)) - 1) / 24.0),
		"contragolpe do Ghar cai no quadro de impacto do clipe wall_counter (EntityView.IMPACT_FRAME)")
	check(not ghar.sig.has("counter") and tank.hp < hp_t and dps.hp == hp_d and not ghar.buffs.any(func(b): return b.get("id") == BossSignatures.WALL_BUFF),
		"Muralha acaba: contragolpe em cone na frente (tanque leva, quem está nas costas não)")
	ws.despawn(ghar)
	heal.call()
	# --- R-A empower (Têmpera, pronto para o Kragmar) ---
	var kr: SimEntity = mkboss.call("boss_ulgra", at)
	var dm0: float = kr.dmg_mult
	BossSignatures.add_hazard(m, {"owner": kr.id, "pos": at + Vector3(10, 0, 0), "radius": 2.0, "at": ws.time, "power": 0.5, "kind": 0, "effects": {}, "skill": "x",
		"linger": 20.0, "tick_power": 0.0, "empower": {"id": BossSignatures.TEMPER_BUFF, "max": Balance.KRAGMAR_TEMPER_MAX}}, ws.time)
	MobSystem.update_hazards(ws, m)
	for i in range(3):
		ws.time += Balance.BOSS_LINGER_TICK + 0.01
		MobSystem.update_hazards(ws, m)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == 0, "AC-S3 Têmpera: fora da poça não sobe")
	kr.position = at + Vector3(10, 0, 0)
	for i in range(6):                                  # 1 acúmulo a cada KRAGMAR_TEMPER_EVERY (2 s)
		ws.time += Balance.BOSS_LINGER_TICK + 0.01
		MobSystem.update_hazards(ws, m)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == 3 and kr.dmg_mult > dm0 * (1.0 + Balance.KRAGMAR_TEMPER_STEP * 3) - 0.001, "AC-S3 Têmpera: dentro da poça sobe e dá dano (F-S3)")
	m["hazards"].clear()
	ws.despawn(kr)

## Bots nas assinaturas (sempre perfeitos, decisão do usuário 2026-11-13).
func _check_boss_sig_bots(gd) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["dg_ninho"])
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		ws.despawn(e)
	var at := Vector3.ZERO
	for sp in gd.maps["dg_ninho"].spawners:
		if sp["monster_id"] == "spider_queen":
			at = sp["pos"]
	at.y = 0.0
	var mkbot := func(cname: String, pos: Vector3) -> SimEntity:
		var b: SimEntity = ws.spawn_bot(gd.classes[cname], cname, "dg_ninho", pos, 40)
		b.brain = null
		return b
	var d: MonsterDef = gd.monsters["boss_ghar"].duplicate()
	d.phases = []
	d.escort = {}
	d.aggro_range = 0.0
	var boss: SimEntity = ws.spawn_monster(d, "dg_ninho", at)
	boss.brain = null
	var tank: SimEntity = mkbot.call("paladin", at + Vector3(0, 0, 2.5))
	var dps: SimEntity = mkbot.call("berserker", at + Vector3(1.0, 0, 2.6))
	var bt := BotBrain.new()
	bt.setup(tank, ws.rng)
	bt.my_role = "tank"
	var bd := BotBrain.new()
	bd.setup(dps, ws.rng)
	bd.my_role = "dps"
	boss.aggro_target = tank.id
	boss.face_towards(tank.position)
	# Muralha: o tanque guarda; o dps de frente vai para as costas
	BossSignatures.wall_start(ws, boss, gd.skills["mob_ghar_wall"], gd.skills["mob_ghar_wall"].effects)
	check(bt._sig_spot(tank, ws, m, boss, true) == Vector3.INF and bt.sig_guard, "bot no alvo da Muralha: guarda parado de frente, sem golpe")
	var spot := bd._sig_spot(dps, ws, m, boss, true)
	check(spot != Vector3.INF and not BossSignatures.wall_blocks(boss, spot), "bot dps de frente na Muralha: vai para as costas")
	dps.position = at + Vector3(0, 0, -2.0)
	check(bd._sig_spot(dps, ws, m, boss, true) == Vector3.INF, "bot dps já nas costas: segue batendo")
	boss.sig.erase("wall")
	# ilhas: fora → centro da ilha mais perto; dentro → fica; o desvio comum não foge da ilha
	BossSignatures.add_hazard(m, {"owner": boss.id, "pos": at + Vector3(6, 0, 0), "radius": 2.5, "at": ws.time + 3.0, "power": 1.0, "kind": 0, "effects": {}, "skill": "x",
		"invert": true, "group": -1, "center": at}, ws.time)
	m["hazards"][-1]["group"] = m["hazards"][-1]["id"]
	dps.position = at + Vector3(0, 0, -3)
	check((bd._sig_spot(dps, ws, m, boss, true) as Vector3).distance_to(at + Vector3(6, 0, 0)) < 0.01, "bot fora da ilha corre para ela")
	dps.position = at + Vector3(6.2, 0, 0)
	check(bd._sig_spot(dps, ws, m, boss, true) == dps.position and bd._danger_escape(dps, m) == Vector2.ZERO, "bot dentro da ilha fica (a ilha não é perigo)")
	m["hazards"].clear()
	# marca de espalhar em mim: ponto longe dos aliados; soak: o grupo vai até o marcado
	dps.position = at + Vector3(0, 0, -3)
	tank.position = at + Vector3(0.8, 0, -3)
	BossSignatures.add_hazard(m, {"owner": boss.id, "pos": dps.position, "radius": 4.0, "at": ws.time + 4.0, "power": 1.0, "kind": 0, "effects": {}, "skill": "x",
		"follow": dps.id, "victim": dps.id, "mode": "spread", "mark": true}, ws.time)
	var sp2: Vector3 = bd._sig_spot(dps, ws, m, boss, true)
	check(sp2 != Vector3.INF and Vector2(sp2.x - tank.position.x, sp2.z - tank.position.z).length() > 4.0 + 1.0, "bot marcado (espalhar) se afasta do grupo (%.1f m)" % Vector2(sp2.x - tank.position.x, sp2.z - tank.position.z).length())
	check(bt._danger_escape(tank, m) != Vector2.ZERO, "aliado foge da marca do outro (perigo móvel)")
	m["hazards"].clear()
	var heal: SimEntity = mkbot.call("bishop", at + Vector3(-8, 0, -3))
	var bh := BotBrain.new()
	bh.setup(heal, ws.rng)
	bh.my_role = "healer"
	BossSignatures.add_hazard(m, {"owner": boss.id, "pos": dps.position, "radius": 3.5, "at": ws.time + 1.0, "power": 6.0, "kind": 0, "effects": {}, "skill": "x",
		"follow": dps.id, "victim": dps.id, "mode": "soak", "mark": true}, ws.time)
	check(bd._sig_spot(dps, ws, m, boss, true) == dps.position, "soak: o marcado para")
	check((bh._sig_spot(heal, ws, m, boss, false) as Vector3).distance_to(m["hazards"][0]["pos"]) < 0.01 and bt._sig_spot(tank, ws, m, boss, true) == Vector3.INF,
		"soak: quem não é tanque a 15 m vai dividir; o tanque segura o chefe")
	m["hazards"].clear()
	# Avalanche: atrás da pedra (a pedra fica entre o bot e o chefe)
	var td: MonsterDef = gd.monsters["boss_troll_king"].duplicate()
	td.phases = []
	td.escort = {}
	var troll: SimEntity = ws.spawn_monster(td, "dg_ninho", at + Vector3(0, 0, 10))
	troll.brain = null
	var av: SkillDef = gd.skills["mob_troll_avalanche"]
	ws._add_skills(troll, [av.id])
	ws._start_skill(troll, av, troll.skills.find(av), troll.position)
	var cv: Array = BossSignatures.covers_of(m, troll.id)
	check(not cv.is_empty() and troll.skill_phase == "startup", "Avalanche começa com pedra no chão")
	var cs: Vector3 = bd._sig_spot(dps, ws, m, troll, true)
	check(cs != Vector3.INF and not BossSignatures.cover_between(m, troll, cs).is_empty(), "bot na Avalanche: corre para trás da pedra")
	# canal: guarda o atordoar quando o Rufar está para voltar
	var gd2: MonsterDef = gd.monsters["boss_agitator_lord"].duplicate()
	gd2.phases = []
	gd2.escort = {}
	var gru: SimEntity = ws.spawn_monster(gd2, "dg_ninho", at + Vector3(0, 0, -10))
	gru.brain = null
	ws._add_skills(gru, ["mob_drum_frenzy"])
	gru.cooldowns["mob_drum_frenzy"] = 1.0
	check(BotBrain._save_stun(ws, gru), "bot guarda o atordoar: o Rufar volta logo")
	gru.cooldowns["mob_drum_frenzy"] = 30.0
	check(not BotBrain._save_stun(ws, gru), "Rufar longe: o atordoar sai normal")
	# faixa: o desvio comum sai de lado
	BossSignatures.add_hazard(m, {"owner": boss.id, "pos": dps.position - Vector3(5, 0, 0), "dir": Vector3(1, 0, 0), "length": 10.0, "width": 3.0, "shape": "line", "radius": 10.0,
		"at": ws.time + 2.0, "power": 1.0, "kind": 0, "effects": {}, "skill": "x"}, ws.time)
	var esc := bd._danger_escape(dps, m)
	check(absf(esc.x) < 0.01 and absf(esc.y) > 0.9, "bot sai da faixa de lado (para o vão)")
	m["hazards"].clear()

## Kragmar — Têmpera na Lava (GDD act2-boss-signatures 3.10): poças de 20 s, Têmpera só dentro (1 a cada 2 s, teto,
## cura 1 vez por segundo mesmo com poças sobrepostas), perde fora, reset limpa; o bot que ele mira arrasta ele para fora.
func _check_boss_sig_kragmar(gd) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["dg_ninho"])
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		ws.despawn(e)
	var at := Vector3.ZERO
	for sp in gd.maps["dg_ninho"].spawners:
		if sp["monster_id"] == "spider_queen":
			at = sp["pos"]
	at.y = 0.0
	var mkbot := func(cname: String, pos: Vector3) -> SimEntity:
		var b: SimEntity = ws.spawn_bot(gd.classes[cname], cname, "dg_ninho", pos, 44)
		b.brain = null
		b.stats.max_hp = 100000.0
		b.hp = b.stats.max_hp
		return b
	var ks: SkillDef = gd.skills["mob_kragmar_temper"]
	var kb: Dictionary = ks.effects["barrage"]
	var kdef: MonsterDef = gd.monsters["boss_kragmar"]
	check(ks.boss_signature and "mob_kragmar_temper" in Array(kdef.skill_ids) and "mob_lava_waves" in Array(kdef.skill_ids) and kb.get("on_self", false)
		and is_equal_approx(float(kb["linger"]), 20.0) and kb.get("empower") is Dictionary and float(kb["tick_power"]) > 0.0,
		"Kragmar: Têmpera na Lava soma ao kit (Ondas de Lava ficam), 1ª poça embaixo dele, 20 s, tique e fortalecer (GDD 3.10)")
	var d: MonsterDef = kdef.duplicate()
	d.phases = []
	d.berserk_after = 0.0
	d.aggro_range = 0.0
	d.escort = {}
	var kr: SimEntity = ws.spawn_monster(d, "dg_ninho", at)
	kr.brain = null
	var tank: SimEntity = mkbot.call("paladin", at + Vector3(0, 0, 3.2))
	var dps: SimEntity = mkbot.call("berserker", at + Vector3(-3.5, 0, 0))
	kr.aggro_target = tank.id
	MobSystem.place_barrage(ws, kr, ks, kr.position, ks.power, ks.effects)
	var hz: Array = m["hazards"]
	check(hz.size() == int(kb["count"]) and int(kb["count"]) >= 1 and (hz[0]["pos"] as Vector3).distance_to(at) < 0.01, "Têmpera na Lava: %d círculos, o 1º embaixo do Kragmar" % int(kb["count"]))
	var ids: Array = hz.map(func(h): return int(h["id"]))
	kr.position = at + Vector3(0, 0, -8)                        # fora das poças
	ws.time += float(kb["delay"]) + 0.01
	MobSystem.update_hazards(ws, m)
	check(hz.size() == int(kb["count"]) and hz.all(func(h): return h.get("landed", false)), "Têmpera na Lava: os círculos caem e viram poça")
	var t_land := ws.time
	tank.position = at                                          # pisa na poça dele
	var hp_t := tank.hp + dps.hp
	for i in range(2):
		ws.time += Balance.BOSS_LINGER_TICK + 0.01
		MobSystem.update_hazards(ws, m)
	check(tank.hp + dps.hp < hp_t, "poça de lava queima quem pisa (tique)")
	tank.position = at + Vector3(0, 0, 3.2)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == 0 and not BossSignatures.in_empower_pool(m, kr), "AC-S3 Têmpera: Kragmar fora da poça não ganha acúmulo")
	# dentro (com uma 2ª poça por cima da 1ª: conta uma vez só)
	BossSignatures.add_hazard(m, {"owner": kr.id, "pos": at + Vector3(0.5, 0, 0), "radius": 2.4, "at": ws.time, "power": 0.5, "kind": 0, "effects": {}, "skill": "mob_kragmar_temper",
		"linger": 20.0, "tick_power": 0.0, "empower": {"id": BossSignatures.TEMPER_BUFF}}, ws.time)
	MobSystem.update_hazards(ws, m)
	kr.position = at
	kr.hp = kr.stats.max_hp * 0.5
	var hp0 := kr.hp
	var dm0 := kr.dmg_mult
	ws.time += Balance.BOSS_LINGER_TICK + 0.01
	MobSystem.update_hazards(ws, m)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == 0 and BossSignatures.in_empower_pool(m, kr), "Têmpera: 1 s na poça ainda não dá acúmulo (1 a cada %.0f s)" % Balance.KRAGMAR_TEMPER_EVERY)
	ws.time += Balance.BOSS_LINGER_TICK + 0.01
	MobSystem.update_hazards(ws, m)
	var heal: float = kr.hp - hp0
	var want: float = kr.stats.max_hp * Balance.KRAGMAR_TEMPER_HEAL * Balance.BOSS_LINGER_TICK * 2.0
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == 1, "Têmpera: 2 s na poça = 1 acúmulo, mesmo com 2 poças sobrepostas")
	check(absf(heal - want) < want * 0.1, "Têmpera: cura %.1f%%/s dentro da poça, uma vez só com poças sobrepostas (%.0f, quer %.0f)" % [Balance.KRAGMAR_TEMPER_HEAL * 100.0, heal, want])
	for i in range(12):
		ws.time += Balance.BOSS_LINGER_TICK + 0.01
		MobSystem.update_hazards(ws, m)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == Balance.KRAGMAR_TEMPER_MAX, "Têmpera: teto de %d acúmulos" % Balance.KRAGMAR_TEMPER_MAX)
	check(is_equal_approx(kr.dmg_mult, dm0 * (1.0 + Balance.KRAGMAR_TEMPER_STEP * Balance.KRAGMAR_TEMPER_MAX)), "F-S3: dano × (1 + %.2f × acúmulos) no teto" % Balance.KRAGMAR_TEMPER_STEP)
	kr.position = at + Vector3(0, 0, -8)
	BossSignatures.update(ws, kr, Balance.KRAGMAR_TEMPER_DECAY - 0.2)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == Balance.KRAGMAR_TEMPER_MAX, "Têmpera: fora há menos de %.0f s, não perde ainda" % Balance.KRAGMAR_TEMPER_DECAY)
	BossSignatures.update(ws, kr, 0.3)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == Balance.KRAGMAR_TEMPER_MAX - 1 and kr.dmg_mult < dm0 * (1.0 + Balance.KRAGMAR_TEMPER_STEP * Balance.KRAGMAR_TEMPER_MAX) - 0.001,
		"Têmpera: fora da poça perde 1 acúmulo a cada %.0f s" % Balance.KRAGMAR_TEMPER_DECAY)
	# vida da poça: 20 s depois de cair
	ws.time = t_land + float(kb["linger"]) - 0.05
	MobSystem.update_hazards(ws, m)
	check(hz.filter(func(h): return int(h["id"]) in ids).size() == int(kb["count"]), "poça ainda viva pouco antes de %.0f s" % float(kb["linger"]))
	ws.time = t_land + float(kb["linger"]) + 0.05
	MobSystem.update_hazards(ws, m)
	check(hz.filter(func(h): return int(h["id"]) in ids).is_empty(), "poça some depois de %.0f s" % float(kb["linger"]))
	# reset (AC-S4)
	kr.put_buff({"id": BossSignatures.TEMPER_BUFF, "remaining": 1.0e9, "stacks": 4})
	MobSystem._apply_fury(kr)
	MobSystem.reset_boss(ws, kr)
	check(kr.buff_stacks(BossSignatures.TEMPER_BUFF) == 0 and not kr.sig.has("temper_in") and is_equal_approx(kr.dmg_mult, 1.0)
		and (m.get("hazards", []) as Array).filter(func(h): return int(h["owner"]) == kr.id).is_empty(), "AC-S4 reset do Kragmar: Têmpera e poças somem")
	# bots: quem ele mira arrasta para o ponto livre de poça mais perto; os outros só saem da lava
	kr.position = at
	kr.aggro_target = tank.id
	tank.position = at + Vector3(0, 0, 2.6)
	dps.position = at + Vector3(-1.5, 0, 0)
	BossSignatures.add_hazard(m, {"owner": kr.id, "pos": at, "radius": 2.4, "at": ws.time, "power": 0.5, "kind": 0, "effects": {}, "skill": "mob_kragmar_temper",
		"linger": 20.0, "tick_power": 0.25, "empower": {"id": BossSignatures.TEMPER_BUFF}}, ws.time)
	MobSystem.update_hazards(ws, m)
	kr.aggro_target = tank.id                                  # a poça caiu batendo nos dois (reflexo/acerto podia virar o aggro)
	var bt := BotBrain.new()
	bt.setup(tank, ws.rng)
	bt.my_role = "tank"
	var bd := BotBrain.new()
	bd.setup(dps, ws.rng)
	bd.my_role = "dps"
	var spot: Vector3 = bt._sig_spot(tank, ws, m, kr, true)
	var pool: Dictionary = m["hazards"][-1]
	var to := Vector3(kr.position.x - spot.x, 0, kr.position.z - spot.z)
	var q: Vector3 = spot + to.normalized() * minf(to.length(), d.attack_range + kr.radius)
	check(spot != Vector3.INF and tank.position.distance_to(spot) >= Balance.BOT_SIG_DRAG_DIST - 0.01 and not BossSignatures.inside(pool, spot, tank.radius)
		and not BossSignatures.inside(pool, q, kr.radius), "bot tanque: Kragmar na poça -> anda %.1f m para um ponto onde ele chega fora da lava" % tank.position.distance_to(spot))
	check(bd._sig_spot(dps, ws, m, kr, true) == Vector3.INF and bd._danger_escape(dps, m) != Vector2.ZERO, "bot dps: não arrasta (não é o alvo), só sai da poça")
	kr.position = q
	check(bt._sig_spot(tank, ws, m, kr, true) == Vector3.INF and bt.drag_to == Vector3.INF, "bot tanque: Kragmar fora da poça -> volta a lutar")
	m["hazards"].clear()
	ws.despawn(kr)

## Durgash — Machado do Trono (GDD act2-boss-signatures 3.11, F-S1): marca de dividir na vítima (não o tanque) que a segue,
## golpe dividido por N dentro, hora de cair, reset; bots entram a tempo (seguem lutando até a hora) e voltam depois.
func _check_boss_sig_durgash(gd) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["dg_ninho"])
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		ws.despawn(e)
	var at := Vector3.ZERO
	for sp in gd.maps["dg_ninho"].spawners:
		if sp["monster_id"] == "spider_queen":
			at = sp["pos"]
	at.y = 0.0
	var mkbot := func(cname: String, pos: Vector3) -> SimEntity:
		var bot: SimEntity = ws.spawn_bot(gd.classes[cname], cname, "dg_ninho", pos, 45)
		bot.brain = null
		bot.stats.max_hp = 1.0e7
		bot.hp = bot.stats.max_hp
		return bot
	var s: SkillDef = gd.skills["mob_durgash_throneaxe"]
	var mk: Dictionary = s.effects.get("mark", {})
	var ddef: MonsterDef = gd.monsters["boss_durgash"]
	check(s.boss_signature and "mob_durgash_throneaxe" in Array(ddef.skill_ids) and str(mk.get("mode", "")) == "soak" and bool(mk.get("no_tank", false))
		and is_equal_approx(s.power, Balance.DURGASH_AXE_POWER) and is_equal_approx(float(mk["radius"]), Balance.DURGASH_AXE_RADIUS)
		and is_equal_approx(float(mk["time"]), Balance.DURGASH_AXE_TIME) and is_equal_approx(s.cooldown, Balance.DURGASH_AXE_EVERY),
		"Durgash: Machado do Trono desde 100%, marca de dividir fora do tanque, números em Balance.DURGASH_AXE_* (GDD 3.11)")
	check(Sfx.SIG_WARN.has(s.id) and Sfx.SIG_EFFECT.has(s.id), "Machado do Trono: som de aviso e de impacto")
	var d: MonsterDef = ddef.duplicate()
	d.phases = []
	d.berserk_after = 0.0
	d.aggro_range = 0.0
	d.escort = {}
	var du: SimEntity = ws.spawn_monster(d, "dg_ninho", at)
	du.brain = null
	var tank: SimEntity = mkbot.call("paladin", at + Vector3(0, 0, 2.5))
	var a: SimEntity = mkbot.call("berserker", at + Vector3(2.0, 0, 0))
	var b: SimEntity = mkbot.call("bishop", at + Vector3(-2.0, 0, 0))
	var c: SimEntity = mkbot.call("elementalist", at + Vector3(0, 0, -2.0))
	var dd: SimEntity = mkbot.call("ranger", at + Vector3(1.5, 0, -1.5))
	var crew: Array = [a, b, c, dd]
	du.aggro_target = tank.id
	# --- a marca: 1 vítima que não é o tanque, segue, cai na hora ---
	ws.rng.seed = 5
	for trial in range(6):
		BossSignatures.place_marks(ws, du, s, s.power, s.effects)
		var hz: Array = (m.get("hazards", []) as Array).filter(func(x): return x.get("mark", false))
		check(hz.size() == 1 and int(hz[0]["victim"]) != tank.id, "Machado do Trono: 1 marca, nunca no tanque (#%d)" % trial)
		m["hazards"].clear()
	BossSignatures.place_marks(ws, du, s, s.power, s.effects)
	var h: Dictionary = m["hazards"][0]
	var v: SimEntity = ws.entities[int(h["victim"])]
	check(is_equal_approx(float(h["at"]) - ws.time, Balance.DURGASH_AXE_TIME) and float(h["at"]) - ws.time >= Balance.BOSS_SIG_WARN_MIN,
		"Machado do Trono: cai %.1f s depois (aviso >= %.1f)" % [Balance.DURGASH_AXE_TIME, Balance.BOSS_SIG_WARN_MIN])
	var v0 := v.position
	v.position = v0 + Vector3(3, 0, 0)
	ws.time += 1.0
	MobSystem.update_hazards(ws, m)
	check((h["pos"] as Vector3).distance_to(Vector3(v.position.x, 0, v.position.z)) < 0.01 and m["hazards"].size() == 1, "Machado do Trono: o círculo segue a vítima")
	ws.time = float(h["at"]) - 0.05
	MobSystem.update_hazards(ws, m)
	check(m["hazards"].size() == 1, "Machado do Trono: ainda não caiu antes da hora")
	MobSystem.reset_boss(ws, du)
	check((m.get("hazards", []) as Array).filter(func(x): return int(x["owner"]) == du.id).is_empty(), "AC-S4 reset do Durgash: o machado some")
	du.aggro_target = tank.id
	v.position = v0
	# --- F-S1: dividido por N dentro (média de 8 golpes por N; o mesmo sorteio para cada N) ---
	# determinístico: sem esquiva (AGI), bloqueio passivo nem crítico; mede sempre o mesmo personagem (a, sempre dentro)
	for o in crew + [tank]:
		o.stats.evasion = 0.0
		o.stats.block_chance = 0.0
	du.stats.crit_phys = 0.0
	du.stats.crit_mag = 0.0
	var per := {}
	var spot := at + Vector3(-12, 0, -6)
	for n in [1, 2, 4]:
		var tot := 0.0
		for trial in range(8):
			for i in range(crew.size()):
				var o: SimEntity = crew[i]
				o.hp = o.stats.max_hp
				o.position = (spot + Vector3(0.6 * (i % 2), 0, 0.6 * (i / 2))) if i < n else (at + Vector3(10 + 3 * i, 0, 10))
			tank.position = at + Vector3(0, 0, 2.5)
			tank.hp = tank.stats.max_hp
			for o in crew + [tank]:                      # a cada golpe (stats podem ser recalculados)
				o.stats.evasion = 0.0
				o.stats.block_chance = 0.0
			du.stats.crit_phys = 0.0
			du.stats.crit_mag = 0.0
			ws.rng.seed = 100 + trial
			BossSignatures.add_hazard(m, {"owner": du.id, "pos": spot, "radius": Balance.DURGASH_AXE_RADIUS, "at": ws.time, "power": 6.0, "kind": s.kind,      # power fixo: a regra, não o número
				"effects": {}, "skill": s.id, "follow": a.id, "victim": a.id, "mode": "soak", "mark": true}, ws.time)
			ws.sig_stats.clear()
			MobSystem.update_hazards(ws, m)
			if int(ws.sig_stats.get("soak_n", 0)) != n:            # diagnóstico se falhar
				for o2 in crew: print("soak diag %s vivo=%s hp=%.0f pos=%s mapa=%s" % [o2.class_def.id, o2.is_alive(), o2.hp, o2.position, o2.map_id])
			check(int(ws.sig_stats.get("soak_n", 0)) == n, "F-S1: %d dentro contados (%d)" % [n, int(ws.sig_stats.get("soak_n", 0))])
			for i in range(n):
				check((crew[i] as SimEntity).hp < (crew[i] as SimEntity).stats.max_hp, "F-S1: todo mundo dentro leva a sua parte (%d dentro)" % n)
			tot += a.stats.max_hp - a.hp
			check(tank.hp == tank.stats.max_hp, "F-S1: quem está fora não leva nada")
		per[n] = tot / 8.0
	# a DEF sai do pedaço de cada um: a parte fica em até 1/N (variação ±10% na média de 8 golpes) e sempre cai com N
	check(per[2] < per[1] * 0.5 * 1.15 and per[4] < per[1] * 0.25 * 1.15 and per[4] > per[1] * 0.05 and per[1] > per[2] and per[2] > per[4],
		"AC-S3 F-S1: cada um leva até ~1/N (1: %.0f, 2: %.0f, 4: %.0f)" % [per[1], per[2], per[4]])
	# --- bots: o marcado para; tanque segura; os outros seguem no que faziam até a hora e entram a tempo; depois voltam ---
	var brains := {}
	var roles := {tank.id: "tank", a.id: "dps", b.id: "healer", c.id: "caster", dd.id: "ranged"}
	for o in [tank, a, b, c, dd]:
		var br := BotBrain.new()
		br.setup(o, ws.rng)
		br.my_role = roles[o.id]
		br.cur_sim = ws
		brains[o.id] = br
		o.hp = o.stats.max_hp
	tank.position = at + Vector3(0, 0, 2.5)
	a.position = at + Vector3(0, 0, -4)          # a vítima
	b.position = a.position + Vector3(6, 0, 0)
	c.position = a.position + Vector3(-9, 0, 0)
	dd.position = a.position + Vector3(0, 0, -12)
	var walk := {}
	for o in [b, c, dd]:
		walk[o.id] = maxf(0.0, Vector2(o.position.x - a.position.x, o.position.z - a.position.z).length() - (Balance.DURGASH_AXE_RADIUS - o.radius - Balance.BOT_SIG_SOAK_PAD)) / o.stats.move_speed
	BossSignatures.add_hazard(m, {"owner": du.id, "pos": a.position, "radius": Balance.DURGASH_AXE_RADIUS, "at": ws.time + Balance.DURGASH_AXE_TIME, "power": s.power, "kind": s.kind,
		"effects": {}, "skill": s.id, "follow": a.id, "victim": a.id, "mode": "soak", "mark": true}, ws.time)
	var mark: Dictionary = m["hazards"][-1]
	check((brains[a.id] as BotBrain)._sig_spot(a, ws, m, du, true) == Vector3.INF, "bot marcado pelo machado: com tempo, segue no que fazia")
	ws.time += Balance.DURGASH_AXE_TIME - Balance.BOT_SIG_SOAK_VICTIM_HOLD + 0.01
	check((brains[a.id] as BotBrain)._sig_spot(a, ws, m, du, true) == a.position, "bot marcado pelo machado: para nos últimos %.1f s (o grupo vem)" % Balance.BOT_SIG_SOAK_VICTIM_HOLD)
	ws.time -= Balance.DURGASH_AXE_TIME - Balance.BOT_SIG_SOAK_VICTIM_HOLD + 0.01
	check((brains[tank.id] as BotBrain).soak_spot(tank, ws, mark) == Vector3.INF, "tanque não sai do Durgash para dividir")
	check((brains[b.id] as BotBrain).soak_spot(b, ws, mark) == Vector3.INF, "bot a 6 m com 5 s: segue no que fazia (ainda dá tempo)")
	var started := {}
	var dt := 0.1
	var t0 := ws.time
	var landed_n := -1
	for step in range(int(Balance.DURGASH_AXE_TIME / dt) + 3):
		for o in [b, c, dd]:
			var cmd := InputCommand.new()
			var br: BotBrain = brains[o.id]
			if br._soak_move(o, ws, m, cmd) and cmd.move != Vector2.ZERO:
				if not started.has(o.id):
					started[o.id] = ws.time - t0
				var mv: Vector2 = cmd.move.normalized() * o.stats.move_speed * dt
				o.position += Vector3(mv.x, 0, mv.y)
		ws.time += dt
		ws.sig_stats.clear()
		var had: bool = m["hazards"].has(mark)
		MobSystem.update_hazards(ws, m)
		if had and not m["hazards"].has(mark):
			landed_n = int(ws.sig_stats.get("soak_n", 0))
			break
	var helpers: Array = [b, c, dd].slice(0, Balance.BOT_SIG_SOAK_HELPERS)       # os mais perto (6 e 9 m); o de 12 m segue no que fazia
	check(landed_n == 1 + helpers.size(), "bots entram no Machado do Trono a tempo: %d dentro quando cai (%d)" % [1 + helpers.size(), landed_n])
	for o in [b, c, dd]:
		if not o in helpers:
			check(not started.has(o.id), "bot %s (mais longe que os %d ajudantes) não sai do lugar" % [roles[o.id], Balance.BOT_SIG_SOAK_HELPERS])
			continue
		var lead: float = Balance.DURGASH_AXE_TIME - float(started.get(o.id, 0.0))
		check(started.has(o.id) and lead <= float(walk[o.id]) + Balance.BOT_SIG_SOAK_MARGIN + 0.25 and lead >= float(walk[o.id]),
			"bot %s parte só na hora (%.1f s antes de cair; precisa %.1f)" % [roles[o.id], lead, float(walk[o.id])])
		var cmd2 := InputCommand.new()
		var br2: BotBrain = brains[o.id]
		check(not br2._soak_move(o, ws, m, cmd2) and not br2.soak_pin and br2._sig_spot(o, ws, m, du, true) == Vector3.INF,
			"bot %s volta ao que fazia depois do machado" % roles[o.id])
	# longe demais (> BOT_SIG_SOAK_RANGE): não vem
	BossSignatures.add_hazard(m, {"owner": du.id, "pos": a.position, "radius": Balance.DURGASH_AXE_RADIUS, "at": ws.time + 0.5, "power": s.power, "kind": s.kind,
		"effects": {}, "skill": s.id, "follow": a.id, "victim": a.id, "mode": "soak", "mark": true}, ws.time)
	dd.position = a.position + Vector3(0, 0, -(Balance.BOT_SIG_SOAK_RANGE + 2.0))
	check((brains[dd.id] as BotBrain).soak_spot(dd, ws, m["hazards"][-1]) == Vector3.INF, "bot a mais de %.0f m não atravessa a arena" % Balance.BOT_SIG_SOAK_RANGE)
	m["hazards"].clear()
	ws.despawn(du)

## Assinaturas de Kharzun (GDD act2-boss-signatures 3.7-3.9): faixas do Estouro da Matilha, anéis das Ondas da Montanha,
## cópias das Sombras Gêmeas (R-F) e a resposta dos bots (lado da faixa/anel no ritmo, sempre o Shazka verdadeiro).
func _check_boss_sig_kharzun(gd) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["dg_ninho"])
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		ws.despawn(e)
	var at := Vector3.ZERO
	for sp in gd.maps["dg_ninho"].spawners:
		if sp["monster_id"] == "spider_queen":
			at = sp["pos"]
	at.y = 0.0
	var mkboss := func(id: String, pos: Vector3) -> SimEntity:
		var d: MonsterDef = gd.monsters[id].duplicate()
		d.phases = []
		d.berserk_after = 0.0
		d.aggro_range = 0.0
		d.escort = {}
		var b: SimEntity = ws.spawn_monster(d, "dg_ninho", pos)
		b.brain = null
		return b
	var mkbot := func(cname: String, pos: Vector3) -> SimEntity:
		var b: SimEntity = ws.spawn_bot(gd.classes[cname], cname, "dg_ninho", pos, 40)
		b.brain = null
		b.stats.max_hp = 100000.0
		b.hp = b.stats.max_hp
		return b
	var tank: SimEntity = mkbot.call("paladin", at + Vector3(0, 0, 3))
	var dps: SimEntity = mkbot.call("berserker", at + Vector3(-3, 0, 0))
	var heal := func() -> void:
		for o in [tank, dps]:
			o.hp = o.stats.max_hp
			o.debuffs.clear()
			o.set_state(SimEntity.State.IDLE)
	# --- Ulgra: Estouro da Matilha (3 faixas paralelas, uma no tanque, vãos seguros) ---
	var ul: SimEntity = mkboss.call("boss_ulgra", at)
	ul.aggro_target = tank.id
	var us: SkillDef = gd.skills["mob_ulgra_stampede"]
	var lb: Dictionary = us.effects["barrage"]
	check(lb["shape"] == "line" and int(lb["count"]) == 3 and is_equal_approx(float(lb["width"]), 3.0) and is_equal_approx(float(lb["gap"]), 3.0), "Ulgra: 3 faixas de 3 m com vãos de 3 m (GDD 3.8)")
	tank.position = at + Vector3(0, 0, 3)
	dps.position = at + Vector3(3.0, 0, 3)                        # no vão ao lado da faixa do tanque (faixas correm em z)
	MobSystem.place_barrage(ws, ul, us, tank.position, us.power, us.effects)
	var hz: Array = m["hazards"]
	check(hz.size() == 3 and hz.all(func(h): return h["shape"] == "line" and h.get("sig_line", false)), "Ulgra: o estouro marca 3 faixas")
	var ats: Array = hz.map(func(h): return snappedf(float(h["at"]) - ws.time, 0.01))
	check(ats == [2.0, 2.6, 3.2], "Ulgra: faixas caem em 2,0 / 2,6 / 3,2 s (%s)" % [ats])
	check(BossSignatures.inside(hz[0], tank.position) and not hz.any(func(h): return BossSignatures.inside(h, dps.position, dps.radius)), "Ulgra: uma faixa sobre o tanque, o vão livre")
	# bot: sai da faixa de lado para o vão (não atravessa para a faixa seguinte)
	var bt := BotBrain.new()
	bt.setup(tank, ws.rng)
	bt.my_role = "tank"
	var esc: Vector2 = bt._danger_escape(tank, m, true)
	var exit := tank.position + Vector3(esc.x, 0, esc.y) * (1.5 + tank.radius + Balance.BOT_SIG_PAD + 0.05)
	check(esc != Vector2.ZERO and absf(esc.y) < 0.01 and not hz.any(func(h): return BossSignatures.inside(h, exit, tank.radius)), "bot sai da faixa do estouro para o vão (%s)" % esc)
	var hp_t: float = tank.hp
	var hp_d: float = dps.hp
	ws.time += 3.3
	MobSystem.update_hazards(ws, m)
	check(tank.hp < hp_t and tank.state == SimEntity.State.STUNNED and is_equal_approx(dps.hp, hp_d) and hz.is_empty(), "AC Ulgra: faixa acerta e derruba; o vão não leva")
	ws.despawn(ul)
	heal.call()
	# --- Gorbash: Ondas da Montanha (3 pisadas × 3 anéis, a 2ª pisada anda para fora) ---
	var go: SimEntity = mkboss.call("boss_gorbash", at)
	go.aggro_target = tank.id
	var gs: SkillDef = gd.skills["mob_gorbash_waves"]
	var gb: Dictionary = gs.effects["barrage"]
	MobSystem.place_barrage(ws, go, gs, at, gs.power, gs.effects)
	hz = m["hazards"]
	check(hz.size() == int(gb["count"]) * int(gb["pulses"]) and hz.all(func(h): return h["shape"] == "ring"), "Gorbash: %d anéis (3 pisadas × 3)" % hz.size())
	check(hz.all(func(h): return float(h["radius"]) <= 16.0 + 0.01) and hz.any(func(h): return float(h["radius"]) >= 15.99), "Gorbash: anéis até 16 m")
	check(is_equal_approx(float(hz[0]["at"]) - ws.time, float(gb["delay"])) and is_equal_approx(float(hz[1]["at"]) - float(hz[0]["at"]), float(gb["stagger"]))
		and is_equal_approx(float(hz[3]["at"]) - float(hz[0]["at"]), float(gb["pulse_gap"])), "Gorbash: anel a cada 0,5 s, pisada a cada 1,2 s")
	check(is_equal_approx(float(hz[3]["inner"]) - float(hz[0]["inner"]), float(gb["pulse_shift"])) and is_equal_approx(float(hz[6]["inner"]), float(hz[0]["inner"])), "Gorbash: 2ª pisada anda para fora (o lugar seguro muda)")
	# bot no 1º anel: para dentro esbarra no chefe -> sai para fora; depois que ele cai, foge do anel seguinte pelo lado livre mais tempo
	tank.position = at + Vector3(0, 0, 3)
	check(bt._danger_escape(tank, m, true, ws.time) == Vector2.ZERO and bt._danger_escape(tank, m, true, float(hz[0]["at"]) - 0.5) != Vector2.ZERO,
		"bot segue lutando enquanto o anel demora mais de %.1f s; perto da queda, sai" % Balance.BOT_SIG_REACT)
	esc = bt._danger_escape(tank, m, true)
	check(esc.y > 0.9, "bot no anel colado no Gorbash sai para fora (para dentro esbarra nele) (%s)" % esc)
	dps.position = at + Vector3(0, 0, -20.0)                       # longe: além dos 16 m
	hp_t = tank.hp
	hp_d = dps.hp
	ws.time = float(hz[0]["at"]) + 0.01
	MobSystem.update_hazards(ws, m)
	check(tank.hp < hp_t and is_equal_approx(dps.hp, hp_d), "AC Gorbash: anel acerta entre inner e radius; além de 16 m não")
	check(hz.size() == 8, "anel que caiu sai da lista")
	tank.hp = tank.stats.max_hp
	tank.position = at + Vector3(0, 0, 4.0 + tank.radius + Balance.BOT_SIG_PAD + 0.1)   # saiu para fora: agora no anel da 2ª pisada
	esc = bt._danger_escape(tank, m, true)
	var dest := tank.position + Vector3(esc.x, 0, esc.y) * 2.6
	var land_t: float = 0.0
	for h in hz:
		if BossSignatures.inside(h, tank.position, tank.radius + Balance.BOT_SIG_PAD):
			land_t = float(h["at"])
			break
	var soon := hz.filter(func(h): return BossSignatures.inside(h, dest, tank.radius) and float(h["at"]) < land_t + 1.0)
	check(esc != Vector2.ZERO and soon.is_empty(), "bot no ritmo: foge do anel seguinte para onde nada cai logo (%s)" % esc)
	ws.time += 10.0
	MobSystem.update_hazards(ws, m)
	check(m["hazards"].is_empty() and int(ws.sig_stats.get("ring_hits", 0)) >= 1, "Gorbash: série acaba; sonda conta anéis que acertaram")
	ws.despawn(go)
	heal.call()
	# --- Shazka: Sombras Gêmeas (R-F) ---
	var sz: SimEntity = mkboss.call("boss_shazka", at)
	sz.aggro_target = tank.id
	sz.stats.max_hp *= 1.37                           # vida escalada (raide/grupo) diferente da do def da cópia
	sz.hp = sz.stats.max_hp
	tank.position = at + Vector3(0, 0, 2.5)
	var ts: SkillDef = gd.skills["mob_shazka_twins"]
	ws._add_skills(sz, [ts.id])
	ws._start_skill(sz, ts, sz.skills.find(ts), sz.position)
	sz.state_time = ts.startup
	ws._apply_skill(sz, ts, m)
	check(sz.stealth_left > 0.0 and sz.sig.has("twins") and BossSignatures.decoys_of(ws, sz).is_empty(), "Sombras Gêmeas: some na fumaça; cópias só no fim dela")
	ws.time += float(ts.effects["stealth"]) + 0.01
	BossSignatures.update(ws, sz, 0.05)
	var cps: Array = BossSignatures.decoys_of(ws, sz)
	check(cps.size() == int(ts.effects["decoys"]["count"]) and sz.stealth_left <= 0.0, "Sombras Gêmeas: volta com %d cópias" % cps.size())
	if cps.size() < 2:
		return
	var c0: SimEntity = cps[0]
	check(c0.name == sz.name and c0.monster_def.model == sz.monster_def.model and c0.monster_def.decoy and not c0.monster_def.is_boss, "cópia: mesmo nome e modelo, marcada decoy, não é chefe")
	check(c0.monster_def.xp == 0 and c0.monster_def.loot_table == "" and c0.boss_id < 0, "AC Shazka: cópia sem XP, sem loot e sem boss_id (não conta como chefe nem lacaio do ward)")
	check(is_equal_approx(c0.hp, sz.hp) and absf(c0.stats.patk - sz.stats.patk * Balance.SHAZKA_DECOY_DMG) < sz.stats.patk * 0.02, "cópia: vida igual à dele, dano %d%%" % int(Balance.SHAZKA_DECOY_DMG * 100))
	c0.put_buff({"id": "test_decoy_buff", "remaining": 1.0, "atk_pct": 10.0, "mob_stat": true})
	c0.recompute_stats()                              # buff/debuff recalcula: a vida máxima segue a do chefe (barra <= 100%)
	check(is_equal_approx(c0.stats.max_hp, sz.stats.max_hp) and c0.hp <= c0.stats.max_hp, "cópia: vida máxima do chefe sobrevive ao recompute_stats (%.0f/%.0f)" % [c0.hp, c0.stats.max_hp])
	c0.drop_buff("test_decoy_buff")
	c0.recompute_stats()
	check(cps.all(func(c): return c.position.distance_to(sz.position) > 1.0), "cópias e o verdadeiro em lugares diferentes")
	check(BotBrain._decoy_real(ws, c0) == sz and BotBrain._decoy_real(ws, sz) == sz, "bot mira o Shazka verdadeiro, nunca a cópia")
	# 1 golpe mata e solta veneno
	var n0: int = m["hazards"].size()
	ws._deal_damage(dps, c0, 1, false, false, "physical")
	check(not c0.is_alive(), "AC Shazka: cópia morre com 1 golpe")
	var cl: Array = m["hazards"].filter(func(h): return h.get("decoy_cloud", false))
	check(m["hazards"].size() == n0 + 1 and cl.size() == 1 and int(cl[0]["owner"]) == sz.id, "AC Shazka: cópia morrendo solta nuvem de veneno")
	if cl.size() == 1:
		dps.position = Vector3(cl[0]["pos"].x, 0, cl[0]["pos"].z)
		hp_d = dps.hp
		for i in range(6):                    # tique da nuvem pode ser esquivado (AGI): alguns tiques
			ws.time += 0.5
			MobSystem.update_hazards(ws, m)
			if dps.hp < hp_d and dps.debuffs.any(func(d): return d.get("kind") == "dot"):
				break
		check(dps.hp < hp_d and dps.debuffs.any(func(d): return d.get("kind") == "dot"), "nuvem da cópia: dano + veneno em quem ficou")
	m["hazards"].clear()
	# dano no tempo no verdadeiro não desfaz; golpe direto desfaz as cópias
	var c1: SimEntity = cps[1]
	ws._deal_damage(dps, sz, 10, false, false, "dot")
	check(c1.is_alive() and sz.sig.has("decoys"), "dano no tempo no verdadeiro não desfaz as cópias")
	ws._deal_damage(dps, sz, 10, false, false, "physical")
	BossSignatures.update_decoy(ws, c1)
	check(not ws.entities.has(c1.id) and not sz.sig.has("decoys") and m["hazards"].is_empty(), "AC Shazka: golpe no verdadeiro = as cópias somem (sem veneno)")
	# tempo acaba, reset e morte limpam
	var recast := func() -> void:
		BossSignatures.decoys_start(ws, sz, ts, ts.effects)
		sz.stealth_left = 0.0
		BossSignatures.update(ws, sz, 0.05)
	recast.call()
	cps = BossSignatures.decoys_of(ws, sz)
	ws.time += float(ts.effects["decoys"]["time"]) + 0.01
	BossSignatures.update(ws, sz, 0.05)
	for c in cps:
		BossSignatures.update_decoy(ws, c)
	check(cps.size() == 2 and cps.all(func(c): return not ws.entities.has(c.id)), "cópias somem depois de %.0f s" % float(ts.effects["decoys"]["time"]))
	recast.call()
	cps = BossSignatures.decoys_of(ws, sz)
	ws.reset_boss(sz)
	for c in cps:
		BossSignatures.update_decoy(ws, c)
	check(cps.size() == 2 and cps.all(func(c): return not ws.entities.has(c.id)) and sz.sig.is_empty(), "AC-S4 reset_boss: cópias somem")
	recast.call()
	cps = BossSignatures.decoys_of(ws, sz)
	ws._deal_damage(tank, sz, int(sz.hp) + 10, false, false, "magical")
	for c in cps:
		BossSignatures.update_decoy(ws, c)
	check(not sz.is_alive() and cps.size() == 2 and cps.all(func(c): return not ws.entities.has(c.id)) and m["hazards"].is_empty(), "chefe morre: cópias somem junto (sem veneno)")

## Chefes: mira em quem está longe (mob_pick), lacaios a qualquer distância, chuva avisada (barrage), gancho (pull),
## fúria por tempo (berserk_after), escudo dos lacaios (ward) e o kit mínimo de todo chefe da sonda.
func _check_boss_mechanics(gd) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["dg_ninho"])
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		ws.despawn(e)
	var at := Vector3(0, 0, 0)
	for sp in gd.maps["dg_ninho"].spawners:
		if sp["monster_id"] == "spider_queen":
			at = sp["pos"]
	var mdef: MonsterDef = gd.monsters["spider_queen"].duplicate()
	mdef.skill_ids = ["mob_whirl", "mob_bone_hook"] as Array[String]
	mdef.phases = []
	mdef.berserk_after = 0.0
	mdef.aggro_range = 0.0
	var boss: SimEntity = ws.spawn_monster(mdef, "dg_ninho", at)
	var tank: SimEntity = ws.spawn_bot(gd.classes["paladin"], "Tanque", "dg_ninho", at + Vector3(1.5, 0, 0), 20)
	var far: SimEntity = ws.spawn_bot(gd.classes["ranger"], "Longe", "dg_ninho", at + Vector3(-11, 0, 0), 20)
	for b in [tank, far]:
		b.brain = null                          # parados: o teste mexe neles na mão
	boss.aggro_target = tank.id
	boss.aggro_timer = 5.0
	var cmd: InputCommand = boss.brain.think(boss, ws, m, 0.05)
	check(cmd.skill_slot == 1 and cmd.aim.distance_to(far.position) < 0.01 and boss.aggro_target == tank.id,
		"chefe: gancho (far) mira quem está longe e o aggro fica no tanque (slot %d)" % cmd.skill_slot)
	check(MobSystem.pick_victim(ws, boss, "far") == far, "pick far = o mais longe")
	var bishop: SimEntity = ws.spawn_bot(gd.classes["bishop"], "Cura", "dg_ninho", at + Vector3(0, 0, 5), 20)
	bishop.brain = null
	bishop.build_id = "sacerdote"          # curandeiro de verdade (as outras builds do Bispo batem)
	far.position = at + Vector3(0, 0, -14)
	tank.position = at + Vector3(0, 0, 10)
	check(MobSystem.pick_victim(ws, boss, "soft") in [bishop, far] and MobSystem.pick_victim(ws, boss, "far") == far, "pick soft prefere curandeiro/atirador")
	far.position = at + Vector3(-30, 0, 0)
	tank.position = at + Vector3(0, 0, 10)
	check(MobSystem.pick_victim(ws, boss, "soft") == bishop, "pick soft: curandeiro antes do tanque mais longe")
	bishop.position = at + Vector3(0, 0, 40)
	tank.position = at + Vector3(1.5, 0, 0)
	far.position = at + Vector3(-11, 0, 0)
	# monstro comum com a mesma skill: mira o alvo dele, não escolhe vítima
	var plain: MonsterDef = mdef.duplicate()
	plain.is_boss = false
	var mob: SimEntity = ws.spawn_monster(plain, "dg_ninho", at + Vector3(0.5, 0, 0.5))
	mob.aggro_target = tank.id
	mob.aggro_timer = 5.0
	cmd = mob.brain.think(mob, ws, m, 0.05)
	check(cmd.skill_slot == 1 and cmd.aim.distance_to(tank.position) < 0.01, "monstro comum ignora mob_pick")
	ws.despawn(mob)
	# invocar lacaios vale a qualquer distância
	var sdef: MonsterDef = mdef.duplicate()
	sdef.skill_ids = ["mob_whirl", "mob_raise_fallen"] as Array[String]
	var caller: SimEntity = ws.spawn_monster(sdef, "dg_ninho", at + Vector3(0, 0, -15))
	caller.aggro_target = tank.id
	caller.aggro_timer = 5.0
	cmd = caller.brain.think(caller, ws, m, 0.05)
	check(cmd.skill_slot == 1, "chefe invoca lacaios com o alvo a 15 m (slot %d)" % cmd.skill_slot)
	ws.despawn(caller)
	# gancho: puxa para o lado do chefe; chefe nunca é puxado
	ws._apply_effects(boss, far, {"pull": {"gap": 0.6}}, 1.0)
	check(far.position.distance_to(boss.position) <= boss.radius + far.radius + 0.6 + 0.3, "gancho traz o alvo para o lado do chefe (%.1f m)" % far.position.distance_to(boss.position))
	var bp := boss.position
	ws._apply_effects(tank, boss, {"pull": {"gap": 0.6}}, 1.0)
	check(boss.position == bp, "chefe não é puxado")
	far.position = at + Vector3(-11, 0, 0)
	# chuva: círculos avisados que caem depois do atraso
	var placed: Array = []
	var on_hz := func(_map: String, p: Vector3, _r: float, _d: float, _s: String): placed.append(p)
	Events.hazard_placed.connect(on_hz)
	var hs: SkillDef = gd.skills["mob_hail_barrage"]
	MobSystem.place_barrage(ws, boss, hs, far.position, hs.power, hs.effects)
	Events.hazard_placed.disconnect(on_hz)
	var hz: Array = m["hazards"]
	check(hz.size() >= 3 and placed.size() == hz.size(), "chuva marca círculos no chão (%d)" % hz.size())
	check(hz.any(func(h): return (h["pos"] as Vector3).distance_to(Vector3(far.position.x, 0, far.position.z)) < 0.1)
		and hz.any(func(h): return (h["pos"] as Vector3).distance_to(Vector3(tank.position.x, 0, tank.position.z)) < 0.1), "chuva: um círculo em cada inimigo")
	var bb := BotBrain.new()
	bb.setup(far, ws.rng)
	check(bb._danger_escape(far, m) != Vector2.ZERO, "bot foge do círculo marcado")
	var hp0: float = far.hp
	MobSystem.update_hazards(ws, m)
	check(far.hp == hp0 and not hz.is_empty(), "chuva: nada cai antes do atraso")
	ws.time += float(hs.effects["barrage"]["delay"]) + 0.1
	far.stats.evasion = 0.0                  # a esquiva da AGI apagava o golpe inteiro às vezes (sorteio do rng compartilhado)
	MobSystem.update_hazards(ws, m)
	check(far.hp < hp0 and far.debuffs.any(func(d): return d.get("kind") == "slow") and m["hazards"].is_empty(), "chuva cai: dano e lentidão")
	MobSystem.place_barrage(ws, boss, hs, far.position, hs.power, hs.effects)
	ws.reset_boss(boss)
	check(m["hazards"].is_empty(), "reset do chefe apaga a chuva")
	# fúria por tempo e fúria da fase se multiplicam; reset desfaz
	var base_atk: float = boss.stats.patk
	mdef.berserk_after = 10.0
	mdef.phases = [{"hp": 0.5, "enrage": 1.5}]
	boss.aggro_target = tank.id
	MobSystem.update_boss(ws, boss, 10.1)
	check(boss.berserk and is_equal_approx(boss.stats.patk, base_atk * Balance.BOSS_BERSERK_MULT) and boss.buffs.any(func(b): return b.get("id") == "boss_berserk"),
		"chefe enlouquece depois de berserk_after")
	boss.hp = boss.stats.max_hp * 0.4
	MobSystem.update_boss(ws, boss, 0.05)
	check(is_equal_approx(boss.stats.patk, base_atk * 1.5 * Balance.BOSS_BERSERK_MULT), "fúria da fase soma com a do tempo")
	ws.reset_boss(boss)
	check(not boss.berserk and is_equal_approx(boss.stats.patk, base_atk) and boss.fight_time == 0.0, "reset desfaz a fúria")
	# escudo dos lacaios: corta o dano enquanto um lacaio vive
	mdef.berserk_after = 0.0
	mdef.phases = [{"hp": 0.9, "ward": 0.5, "summon": {"id": "spiderling", "count": 1, "max": 1}}]
	boss.aggro_target = tank.id
	boss.hp = boss.stats.max_hp * 0.85
	MobSystem.update_boss(ws, boss, 0.05)
	check(boss.ward == 0.5 and boss.buffs.any(func(b): return b.get("id") == "boss_ward"), "fase com ward: escudo com lacaio vivo")
	var h1: float = boss.hp
	ws._deal_damage(tank, boss, 1000, false, false, "physical")
	check(is_equal_approx(h1 - boss.hp, 500.0), "escudo corta metade do dano (%.0f)" % (h1 - boss.hp))
	for o in m["entities"].duplicate():
		if o.boss_id == boss.id:
			ws.despawn(o)
	MobSystem.update_boss(ws, boss, Balance.BOSS_WARD_CHECK + 0.1)
	h1 = boss.hp
	ws._deal_damage(tank, boss, 1000, false, false, "physical")
	check(boss.ward == 0.0 and is_equal_approx(h1 - boss.hp, 1000.0), "sem lacaio, dano inteiro")
	for e in m["entities"].duplicate():
		ws.despawn(e)
	# kit mínimo de todo chefe da sonda
	var probe = load("res://tools/tests/boss_probe.gd")
	for bid in probe.BOSSES:
		var md: MonsterDef = gd.monsters[bid]
		var grp: String = probe.GROUPS.get(bid, "group")
		var kit: Array = md.skill_ids.duplicate()      # cópia: Array(tipado) devolve o MESMO array (append mexeria no MonsterDef)
		for ph in md.phases:
			kit.append_array(ph.get("skills", []))
		var ranged_answer := false
		var summons := false
		for sid in kit:
			var sk: SkillDef = gd.skills.get(sid)
			check(sk != null, "%s: skill %s existe" % [bid, sid])
			if sk == null:
				continue
			if (sk.mob_pick != "" and (maxf(sk.range, sk.radius) >= 10.0 or sk.effects.has("barrage") or sk.effects.has("pull"))) \
					or (sk.target == SkillDef.Target.SELF and sk.effects.has("pull") and sk.radius >= 9.0):
				ranged_answer = true
			if sk.effects.has("boss_summon"):
				summons = true
				var ad: MonsterDef = gd.monsters.get(str(sk.effects["boss_summon"]["id"]))
				check(ad != null and ad.xp == 0 and ad.loot_table == "", "%s: lacaio de %s sem XP/loot" % [bid, sid])
		check(ranged_answer, "%s: tem resposta para quem luta de longe (alcance 10 m+ com mira, chuva ou gancho)" % bid)
		if grp == "group":
			check(md.phases.size() >= 3 and summons and md.berserk_after > 0.0, "%s: chefe de grupo com 3 fases, lacaios no ritmo e fúria por tempo" % bid)
			check(md.phases.any(func(ph): return ph.has("ward")), "%s: alguma fase protegida pelos lacaios (ward)" % bid)
		elif grp == "elite":
			check(md.phases.is_empty() and not md.is_boss, "%s: elite sem fases (missão e escolta)" % bid)
		else:
			check(md.berserk_after == 0.0, "%s: chefe de campo sem fúria por tempo (dá para solar)" % bid)

func _check_band_bosses(gd, sim) -> void:
	for bid in ["bandit_chief", "spider_queen", "elf_king", "count_vargo", "bone_captain", "wailing_widow", "golem_ancient", "crystal_warden", "quarry_heart", "elf_captain_hunter", "elf_captain_sky", "elf_captain_sap"]:
		var md: MonsterDef = gd.monsters[bid]
		var kit := {}
		for sid in md.skill_ids:
			kit[sid] = true
		for ph in md.phases:
			for sid in ph.get("skills", []):
				kit[sid] = true
		for sid in kit:
			check(gd.skills.has(sid), "%s: skill %s existe" % [bid, sid])
		if bid in ["bandit_chief", "spider_queen", "elf_king", "count_vargo", "elf_captain_hunter", "elf_captain_sky", "elf_captain_sap"]:
			check(kit.size() >= 4 and md.phases.size() >= 2, "%s: repertório de chefe (%d golpes, %d fases)" % [bid, kit.size(), md.phases.size()])
		check(md.intro != "" and md.last_words != "", "%s: fala de abertura e de queda" % bid)
	check(gd.monsters["bandit_thug"].xp == 0 and gd.monsters["bandit_thug"].loot_table == "", "Capanga: lacaio sem XP nem saque")
	check(gd.skills["mob_venom_pool"].vfx == "poison" and gd.skills["mob_shadow_bats"].vfx == "shadow"
		and gd.skills["mob_thorn_lash"].vfx == "nature", "skills novas de monstro no tema certo")
	# falas: abertura uma vez por luta (volta no reset), queda ao morrer
	var said: Array = []
	var on_note := func(t: String): said.append(t)
	Events.notification.connect(on_note)
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["dg_ninho"])
	m["spawners"].clear()
	ws.player = ws.spawn_player(gd.classes["berserker"], "Falas", "dg_ninho")
	var q: SimEntity = ws.spawn_monster(gd.monsters["spider_queen"], "dg_ninho", ws.player.position + Vector3(6, 0, 0))
	q.aggro_target = ws.player.id
	MobSystem.update_boss(ws, q)
	MobSystem.update_boss(ws, q)
	var intro := said.filter(func(t): return t.ends_with(gd.monsters["spider_queen"].intro))
	check(intro.size() == 1, "chefe diz a abertura uma vez (%d)" % intro.size())
	ws.reset_boss(q)
	q.aggro_target = ws.player.id
	MobSystem.update_boss(ws, q)
	check(said.filter(func(t): return t.ends_with(gd.monsters["spider_queen"].intro)).size() == 2, "reset: a abertura volta na próxima luta")
	LootSystem.on_monster_killed(ws, q, ws.player)
	check(said.any(func(t): return t.ends_with(gd.monsters["spider_queen"].last_words)), "chefe fala ao cair")
	Events.notification.disconnect(on_note)

## Monstro atirador cujo tiro não tira vida (obstáculo no meio) chega mais perto; corpo a corpo contorna obstáculo (MonsterBrain._steer).
func _check_monster_unstick(gd, sim) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(gd.maps["field_forest"])
	m["spawners"].clear()
	var a: SimEntity = ws.spawn_monster(gd.monsters["bandit_archer"], "field_forest", Vector3(40, 0, 40))
	var t: SimEntity = ws.spawn_bot(gd.classes["paladin"], "Alvo", "field_forest", Vector3(46, 0, 40), 15)
	var br: MonsterBrain = a.brain
	var blocked := false
	for i in range(int(MonsterBrain.NO_HIT_LIMIT * 20) + 2):
		blocked = br._shots_blocked(a, t, 0.05)
		if blocked:
			break
	check(blocked, "atirador sem acertar por %.0f s vai chegar mais perto" % MonsterBrain.NO_HIT_LIMIT)
	br.close_in = 0.0
	br.no_hit = 0.0
	t.hp -= 10.0
	check(not br._shots_blocked(a, t, 0.05), "tiro que acerta zera a espera")

## Posto dos Caçadores: moradores (refugiados) nascem em chão livre dentro das muralhas e passeiam;
## os bots falam do lugar onde estão (falas por mapa existem só para mapas que existem).
func _check_post_life(gd, sim) -> void:
	var def: MapDef = gd.maps["field_forest"]
	var vil: Array = def.npcs.filter(func(n): return n["id"] in MapsCatalog.POST_VILLAGERS)
	check(vil.size() == MapsCatalog.POST_VILLAGERS.size() and vil.size() >= 5, "Posto: moradores no mapa (%d)" % vil.size())
	for n in vil:
		var pos: Vector3 = n["pos"]
		check(sim.is_walkable(pos, def, 0.4), "Posto: %s em chão livre" % n["id"])
		check(Vector2(pos.x - def.town_center.x, pos.z - def.town_center.z).length() + float(n.get("wander", 0.0)) < def.town_radius - 1.0,
			"Posto: %s passeia dentro das muralhas" % n["id"])
	for ctx in BotsCatalog.LINES:
		for pre in ["hunt_", "town_"]:
			if str(ctx).begins_with(pre):
				check(gd.maps.has(str(ctx).trim_prefix(pre)), "falas de bot: mapa %s existe" % ctx)
	for mid in ["field_forest", "dg_ninho", "elf_city", "dg_coracao", "dg_pedreira"]:
		check(BotsCatalog.LINES.has("hunt_" + mid) and (BotsCatalog.LINES["hunt_" + mid] as Array).size() >= 5, "falas de bot na faixa 10-20: %s" % mid)

## Faixa 10-20: toda quest tem alvo que nasce (spawner ou investida), item com fonte; monstros comuns sobem de vida com o nível
## dentro de cada mapa (sem aranha nível 13 mais dura que bandido nível 15).
func _check_band_consistency(gd, sim) -> void:
	var spawns := {}
	for mid in gd.maps:
		for sp in gd.maps[mid].spawners:
			spawns[sp["monster_id"]] = true
	for mid in gd.maps:
		for r in RaidSystem.routes(gd.maps[mid]):
			for w in r.get("waves", []):
				for mon in w["mobs"]:
					spawns[mon] = true
	var drops := {}
	for mon in spawns:
		var md: MonsterDef = gd.monsters.get(mon)
		if md and gd.loot_tables.has(md.loot_table):
			for en in gd.loot_tables[md.loot_table].entries:
				drops[en["item"]] = true
	var gather := {}
	for mid in MapsCatalog.GATHER:
		for g in MapsCatalog.GATHER[mid]:
			gather[g[0]] = true
	for qid in gd.quests:
		var q: QuestDef = gd.quests[qid]
		if q.level_req < 10 or q.level_req > 20:
			continue
		if q.type == QuestDef.Type.KILL:
			check(spawns.has(q.target_id), "%s: %s nasce em algum lugar" % [qid, q.target_id])
		elif q.type == QuestDef.Type.COLLECT:
			check(not q.give_items.is_empty() or gather.has(q.target_id) or drops.has(q.target_id), "%s: %s tem fonte" % [qid, q.target_id])
	for mid in ["field_forest", "elf_city"]:
		var mons: Array = []
		for sp in gd.maps[mid].spawners:
			var md: MonsterDef = gd.monsters[sp["monster_id"]]
			if not md.is_boss and md.hp < 1500 and not mons.has(md):
				mons.append(md)
		for x in mons:
			for y in mons:
				if x.level + 2 <= y.level:
					check(x.hp * (1.0 if x.ranged == y.ranged else 0.8) <= y.hp * 1.15, "%s: %s (nv %d) não mais duro que %s (nv %d)" % [mid, x.id, x.level, y.id, y.level])

## Começo rápido nível 16: Posto dos Caçadores, cadeia élfica até a garganta, garganta liberada, grupo do nível.
func _check_start_elf(gd, sim) -> void:
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.PLAYER, gd.classes["paladin"], "Elfico", "city_aldara", Vector3(2, 0, 8))
	sim.apply_start_preset(e, 16)
	check(e.level == 16 and e.map_id == "field_forest", "começo 16: nível 16 na Floresta (%d, %s)" % [e.level, e.map_id])
	check(sim.is_walkable(e.position, gd.maps["field_forest"], 0.45), "começo 16: nasce em chão livre")
	check(e.quests_active.has("el3_scout") and "el2_defense" in e.quests_completed and "q09_spiders" in e.quests_completed, "começo 16: quest da Cidade Élfica ativa")
	var gate := {}
	for pt in gd.maps["field_forest"].portals:
		if pt["id"] == "to_elf_city":
			gate = pt
	check(not gate.is_empty() and sim.portal_block_reason(e, gate) == "", "começo 16: garganta élfica liberada")
	var w: ItemDef = e.equipment.get(ItemDef.Slot.WEAPON)
	check(w != null and w.rarity >= 2, "começo 16: arma de Mitril")
	var members: Array = sim.party_members(e)
	check(members.size() == 5 and members.all(func(m): return m.map_id == "field_forest" and m.level == 16), "começo 16: grupo de 5 no Posto, nível 16")
	for m in members:
		if m != e:
			sim.despawn(m)
	sim.despawn(e)

# ---------------------------------------------------------------------------
# kit do tanque (Escudo Ricochete, Aura do Bastião) e Combustão
# ---------------------------------------------------------------------------
func _check_tank_kit(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(66, 0, 44)
	var made: Array = []
	for o in m["entities"].duplicate():          # sobras de outros testes perto: o ricochete pularia nelas
		if o.kind in [SimEntity.Kind.MONSTER, SimEntity.Kind.SUMMON] and o.position.distance_to(at) < 45.0:
			sim.despawn(o)
	m["projectiles"].clear()
	var mob_at := func(p: Vector3):
		var w = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", p)
		w.brain = null
		w.stats.max_hp = 50000.0
		w.hp = 50000.0
		made.append(w)
		return w
	var pal = sim.spawn_bot(gd.classes["paladin"], "TK", "city_aldara", at, 20)
	pal.brain = null
	pal.build_id = "guardiao"
	sim._gear_bot(pal)
	sim._skill_bot(pal)
	made.append(pal)
	var ally = sim.spawn_bot(gd.classes["ranger"], "TK2", "city_aldara", at + Vector3(0, 0, 3), 20)
	ally.brain = null
	made.append(ally)
	sim.party_invite(pal, ally)
	sim.party_accept(ally)
	var bar: Array = []
	for s in pal.skills:
		if s:
			bar.append(s.id)
	check(pal.stats.has_shield and "pal_shield_throw" in bar and "pal_bastion_aura" in bar and "pal_taunt" in bar, "Guardião bot leva ricochete, aura e provocar na barra %s" % [bar])
	# Escudo Ricochete: persegue, salta em 3, provoca, interrompe e volta
	var throw: SkillDef = gd.skills["pal_shield_throw"]
	check(throw.target == SkillDef.Target.TARGET and throw.requires.has("shield") and throw.build == "guardiao" and throw.vfx == "holy", "Escudo Ricochete: alvo, exige escudo, tema sagrado")
	check(throw.startup <= 0.3 and throw.cancel_after <= 0.2, "Escudo Ricochete sai rápido")
	var w: Array = []
	for i in range(3):
		w.append(mob_at.call(at + Vector3(4.0 + 2.5 * i, 0, 0)))
	var far = mob_at.call(at + Vector3(30, 0, 0))
	for x in w:
		x.aggro_target = ally.id
	sim._start_skill(w[1], gd.skills["mob_whirl"], 0, w[1].position)       # w1 está preparando um golpe
	pal.face_towards(w[0].position)
	pal.skill_aim = w[0].position
	var projs: int = m["projectiles"].size()
	sim._apply_skill(pal, sim.resolve_skill(pal, throw), m)
	check(m["projectiles"].size() == projs + 1 and not m["projectiles"][-1].bounce.is_empty(), "o escudo vira projétil que persegue")
	var gone := false
	for k in range(120):
		sim._update_projectiles(m, 1.0 / 20.0)
		if m["projectiles"].size() == projs:
			gone = true
			break
	var hit := w.all(func(x): return x.hp < x.stats.max_hp)
	check(hit and far.hp == far.stats.max_hp, "ricocheteia nos 3 perto e não no distante %s" % [w.map(func(x): return int(x.hp))])
	check(w.all(func(x): return x.aggro_target == pal.id and x.taunt_left > 0.0), "cada inimigo atingido fica provocado no tanque")
	check(w[1].state == SimEntity.State.STUNNED, "quem preparava um golpe é interrompido")
	check(gone, "o escudo volta para a mão (projétil some)")
	# Aura do Bastião: liga, chega no grupo em alcance, não em estranho nem longe; ameaça e redução de dano
	var aura: SkillDef = gd.skills["pal_bastion_aura"]
	var stranger = sim.spawn_bot(gd.classes["ranger"], "TK3", "city_aldara", at + Vector3(-3, 0, 0), 20)
	stranger.brain = null
	made.append(stranger)
	var far_ally = sim.spawn_bot(gd.classes["bishop"], "TK4", "city_aldara", at + Vector3(0, 0, 30), 20)
	far_ally.brain = null
	made.append(far_ally)
	sim.party_invite(pal, far_ally)
	sim.party_accept(far_ally)
	pal.buffs.clear()
	ally.buffs.clear()
	pal.recompute_stats()
	ally.recompute_stats()
	sim._apply_skill(pal, sim.resolve_skill(pal, aura), m)
	check(AuraSystem.aura_on(pal, aura) and pal.stats.threat_pct >= 150.0, "Aura do Bastião liga e dá ameaça ao tanque")
	AuraSystem.tick(sim, m, Balance.AURA_TICK + 0.01)
	var has := func(e, id): return e.buffs.any(func(b): return b.get("id") == id)
	check(has.call(ally, "bastion_aura") and ally.stats.dr_pct >= 10.0, "aura chega no aliado do grupo por perto")
	check(not has.call(stranger, "bastion_aura") and not has.call(far_ally, "bastion_aura"), "aura não pega estranho nem aliado longe")
	check(ally.stats.threat_pct == 0.0, "aliado não ganha a ameaça do tanque")
	var near_mob = mob_at.call(pal.position + Vector3(2, 0, -2))
	var far_mob = mob_at.call(pal.position + Vector3(-9, 0, -9))
	pal.combat_timer = 5.0
	for k in range(3):
		AuraSystem.tick(sim, m, Balance.AURA_TICK + 0.01)
	check(near_mob.hp < near_mob.stats.max_hp and far_mob.hp == far_mob.stats.max_hp, "pulso da aura queima quem está perto do tanque, não longe")
	check(near_mob.threat.get(pal.id, 0.0) > near_mob.stats.max_hp - near_mob.hp, "pulso gera ameaça multiplicada pela aura")
	var hp0: float = ally.hp
	sim._deal_damage(far, ally, 1000, false, false, "magical")
	check(hp0 - ally.hp <= 905.0, "aura reduz o dano no aliado (%d)" % int(hp0 - ally.hp))
	var dummy = mob_at.call(at + Vector3(-6, 0, 4))
	sim._deal_damage(pal, dummy, 100, false, false, "physical")
	sim._deal_damage(ally, dummy, 200, false, false, "physical")
	check(dummy.aggro_target == pal.id, "com a aura, o tanque segura o monstro contra o dobro do dano")
	var slot: int = pal.slot_of("pal_bastion_aura")
	pal.cooldowns.clear()
	pal.mp = pal.stats.max_mp
	check(slot >= 0 and not sim.try_cast(pal, slot, pal.position, m), "bot não desliga a própria aura")
	sim._apply_skill(pal, sim.resolve_skill(pal, aura), m)
	check(not AuraSystem.aura_on(pal, aura), "lançar de novo desliga a aura")
	# Combustão: marca, explode em volta, detona as queimaduras e reacende
	var comb: SkillDef = gd.skills["ele_combustion"]
	check(comb.startup >= 0.25 and comb.startup <= 0.3 and comb.radius >= 2.0 and comb.effects.has("combust"), "Combustão: preparo visível, área e detonação")
	var ele = sim.spawn_bot(gd.classes["elementalist"], "TK5", "city_aldara", at + Vector3(0, 0, -6), 20)
	ele.brain = null
	ele.build_id = "fogo"
	sim._gear_bot(ele)
	made.append(ele)
	var c1 = mob_at.call(at + Vector3(4, 0, -6))
	var c2 = mob_at.call(at + Vector3(5.5, 0, -5))
	var c3 = mob_at.call(at + Vector3(14, 0, -6))
	c1.debuffs.append({"kind": "dot", "id": "dot_%d" % ele.id, "remaining": 4.0, "dps": 60.0, "src": ele.id, "fire": true})
	var kinds: Array = []
	var fx_at: Array = []
	var on_dmg := func(_a, t, amount, _c, _b, kind): kinds.append([t, kind, amount])
	var on_fx := func(sid, _o, aim, _r): fx_at.append([sid, aim])
	Events.damage_dealt.connect(on_dmg)
	Events.skill_effect.connect(on_fx)
	ele.face_towards(c1.position)
	ele.skill_aim = c1.position + Vector3(0.6, 0, 0.6)
	sim._apply_skill(ele, sim.resolve_skill(ele, comb), m)
	Events.damage_dealt.disconnect(on_dmg)
	Events.skill_effect.disconnect(on_fx)
	var det: Array = kinds.filter(func(k): return k[0] == c1.id and k[1] == "detonate")
	check(det.size() == 1 and int(det[0][2]) >= int(240 * 1.25) - 1, "Combustão detona a queimadura que faltava (%s)" % [det])
	check(c2.hp < c2.stats.max_hp and c3.hp == c3.stats.max_hp, "Combustão explode em volta do alvo, não longe")
	var burns := func(e): return e.debuffs.filter(func(d): return d.get("kind") == "dot" and d.get("fire", false) and int(d.get("src", -1)) == ele.id)
	check(burns.call(c1).size() == 1 and burns.call(c2).size() == 1, "o fogo reacende no alvo e espalha para o vizinho")
	var at_target: Array = fx_at.filter(func(f): return f[0] == "ele_combustion")
	check(not at_target.is_empty() and Vector2(at_target[0][1].x, at_target[0][1].z).distance_to(Vector2(c1.position.x, c1.position.z)) < 0.05, "efeito de skill no alvo de verdade (não no cursor)")
	for x in made:
		sim.despawn(x)
	# auditoria das skills: tema e clipe certos onde a palavra do id enganava
	var moon: SkillDef = gd.skills["dru_moonfire"]
	check(moon.vfx == "lunar" and not bool(moon.effects.get("dot", {}).get("fire", false)), "Fogo Lunar é lunar (não queima como fogo)")
	check(gd.skills["ber_leap"].startup >= 0.15, "Salto Selvagem tem preparo de salto (clipe atk_leap)")
	for sid in gd.skills:
		var sk: SkillDef = gd.skills[sid]
		if sk.clip != "":
			check(EntityView.IMPACT_FRAME.has(sk.clip), "%s: clipe próprio %s existe" % [sid, sk.clip])

## Bot não escolhe skill que a sim recusa (sem companheiro, invocação no limite): antes pedia a mesma skill todo
## tick e ficava parado até morrer (Caçador com o lince morto: 0 vitórias solo no boss_probe).
func _check_bot_skill_reject(gd, sim) -> void:
	var r = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["ranger"], "Caca", "city_aldara", Vector3(-30, 0, 30), 30)
	r.build_id = "cacador"
	var sic: SkillDef = gd.skills["ran_sic"]
	r.learned[sic.id] = true
	r.skills[0] = sic
	r.cooldowns.clear()
	r.mp = r.stats.max_mp
	var mob = sim.spawn_monster(gd.monsters["slime"], "city_aldara", r.position + Vector3(0, 0, 3.0))
	var m: Dictionary = sim.maps["city_aldara"]
	check(sim.pet_of(r) == null, "bot sem companheiro para o teste")
	var brain := BotBrain.new()
	brain.setup(r, RandomNumberGenerator.new())
	var pick: int = brain._best_skill(r, sim, m, mob, r.position.distance_to(mob.position))
	check(pick != 0, "bot sem companheiro não escolhe Ataque da Fera (a sim recusaria e o bot travava)")
	mob.hp = 0

## Druida bot entra na forma (Lobo/Urso) com inimigo perto; antes pulava a skill de forma e lutava como humano (0/40 solo).
func _check_bot_form(gd, sim) -> void:
	for row in [["fera", "dru_wolf_form", "wolf"], ["guardiao_verde", "dru_bear_form", "bear"]]:
		var d = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["druid"], "Forma", "city_aldara", Vector3(-30, 0, 30), 30)
		d.build_id = row[0]
		sim._gear_bot(d)
		var fs: SkillDef = gd.skills[row[1]]
		d.learned[fs.id] = true
		d.skills[0] = fs
		d.cooldowns.clear()
		d.mp = d.stats.max_mp
		var mob = sim.spawn_monster(gd.monsters["slime"], "city_aldara", d.position + Vector3(0, 0, 3.0))
		var m: Dictionary = sim.maps["city_aldara"]
		var brain := BotBrain.new()
		brain.setup(d, RandomNumberGenerator.new())
		check(d.stats.meets(fs.requires), "%s: equipamento do bot permite a forma" % row[0])
		var pick: int = brain._best_skill(d, sim, m, mob, d.position.distance_to(mob.position))
		check(pick == 0, "%s: bot com inimigo perto escolhe entrar na forma (%d)" % [row[0], pick])
		d.form = row[2]
		pick = brain._best_skill(d, sim, m, mob, d.position.distance_to(mob.position))
		check(pick != 0, "%s: já na forma, o bot não a desliga" % row[0])
		mob.hp = 0
		sim.despawn(d)

## Chefe escala com quem luta contra ele (MobSystem.crowd_of/crowd_mult): conta quem o atingiu e o grupo dessas pessoas
## a até BOSS_CROWD_RANGE m; quem só passa perto não conta; solo/dupla iguais; reset volta ao normal.
func _check_boss_crowd(gd, sim) -> void:
	check(MobSystem.crowd_mult(1) == 1.0 and MobSystem.crowd_mult(2) == 1.0, "chefe: solo e dupla sem reforço")
	check(Balance.BOSS_CROWD_MULT.size() == Balance.PARTY_MAX + 1, "BOSS_CROWD_MULT tem uma entrada por tamanho de grupo (0..PARTY_MAX)")
	var grows := true
	for i in range(1, Balance.BOSS_CROWD_MULT.size()):
		grows = grows and float(Balance.BOSS_CROWD_MULT[i]) >= float(Balance.BOSS_CROWD_MULT[i - 1])
	check(grows and MobSystem.crowd_mult(Balance.PARTY_MAX) > 1.0, "chefe: reforço cresce com o grupo")
	# reforço extra por chefe (BOSS_CROWD_EXTRA): só a partir de BOSS_CROWD_EXTRA_FROM pessoas e só nos chefes da lista
	check(Balance.BOSS_CROWD_EXTRA_FROM >= 4, "reforço extra não mexe em solo/dupla/trio")
	for bid in Balance.BOSS_CROWD_EXTRA:
		var x: float = float(Balance.BOSS_CROWD_EXTRA[bid])
		check(gd.monsters.has(bid) and gd.monsters[bid].is_boss and x >= 1.0, "reforço extra: %s é chefe e × >= 1" % bid)
		var same := true
		for n in range(0, Balance.BOSS_CROWD_EXTRA_FROM):
			same = same and MobSystem.crowd_mult(n, bid) == MobSystem.crowd_mult(n)
		check(same, "reforço extra de %s não vale abaixo de %d pessoas" % [bid, Balance.BOSS_CROWD_EXTRA_FROM])
		check(is_equal_approx(MobSystem.crowd_mult(Balance.BOSS_CROWD_EXTRA_FROM, bid), MobSystem.crowd_mult(Balance.BOSS_CROWD_EXTRA_FROM) * x), "reforço extra de %s vale com %d" % [bid, Balance.BOSS_CROWD_EXTRA_FROM])
	# chefe de raide (BOSS_CROWD_RAID): tabela própria, uma entrada por tamanho de grupo, igual ao comum até o trio
	for bid in Balance.BOSS_CROWD_RAID:
		var tb: Array = Balance.BOSS_CROWD_RAID[bid]
		check(gd.monsters.has(bid) and gd.monsters[bid].is_boss and tb.size() == Balance.PARTY_MAX + 1 and not Balance.BOSS_CROWD_EXTRA.has(bid), "raide %s: chefe, tabela 0..PARTY_MAX, fora do BOSS_CROWD_EXTRA" % bid)
		var own := true
		for n in tb.size():
			own = own and is_equal_approx(MobSystem.crowd_mult(n, bid), float(tb[n])) and (n > 3 or is_equal_approx(float(tb[n]), MobSystem.crowd_mult(n)))
		check(own, "raide %s: usa a tabela própria; solo/dupla/trio como o comum" % bid)
	check(MobSystem.crowd_mult(4, "boss_durgash") > MobSystem.crowd_mult(5, "boss_durgash") and MobSystem.crowd_mult(5, "boss_durgash") < MobSystem.crowd_mult(5), "Durgash (raide de 5): com 4 bate mais que com 5; com 5, menos que o comum")
	check(not Balance.BOSS_CROWD_EXTRA.has("bandit_chief") and MobSystem.crowd_mult(Balance.PARTY_MAX, "bandit_chief") == MobSystem.crowd_mult(Balance.PARTY_MAX), "chefe fora da lista: só o reforço comum")
	var at := Vector3(-40, 0, 40)
	var boss: SimEntity = sim.spawn_monster(gd.monsters["bandit_chief"], "city_aldara", at)
	boss.brain = null
	var mk := func(name: String, pos: Vector3) -> SimEntity:
		var b = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["paladin"], name, "city_aldara", pos, 20)
		b.brain = null
		return b
	var a: SimEntity = mk.call("A", at + Vector3(2, 0, 0))
	var members: Array = [a]
	for i in 3:
		var o: SimEntity = mk.call("M%d" % i, at + Vector3(-3 - i, 0, 2))
		sim.party_invite(a, o)
		sim.party_accept(o)
		members.append(o)
	var passer: SimEntity = mk.call("Passante", at + Vector3(0, 0, -3))
	boss.threat = {a.id: 50.0}
	boss.aggro_target = a.id
	check(MobSystem.crowd_of(sim, boss) == 4, "chefe conta quem bateu e o grupo dele, não quem passa (%d)" % MobSystem.crowd_of(sim, boss))
	members[3].position = at + Vector3(Balance.BOSS_CROWD_RANGE + 5.0, 0, 0)
	check(MobSystem.crowd_of(sim, boss) == 3, "membro longe do chefe não conta")
	members[3].position = at + Vector3(-6, 0, 2)
	var patk0: float = boss.stats.patk
	boss.crowd_t = 0.0
	MobSystem.update_boss(sim, boss, 0.05)
	check(boss.crowd == 4 and is_equal_approx(boss.stats.patk, patk0 * MobSystem.crowd_mult(4)), "chefe com 4 contra: dano × %.1f" % MobSystem.crowd_mult(4))
	sim.reset_boss(boss)
	check(boss.crowd == 0 and is_equal_approx(boss.stats.patk, patk0), "reset do chefe tira o reforço")
	for o in members.slice(1):
		sim.party_leave(o)
	for o in members + [passer, boss]:
		sim.despawn(o)

## Mecânica de grupo grande (MonsterDef.crowd_skills; GDD design/gdd/spider-queen-4p.md): a Rainha Aranha ganha o Casulo de Seda
## só quando o pico da luta chega a BOSS_CROWD_EXTRA_FROM (solo/trio nunca), segue com o pico depois de uma morte e sai no reset.
## Casulo: prende (STUNNED) até quebrar; quebrado solta sem dano; tempo esgotado aperta COCOON_BURST da vida; bot dps acha o casulo.
func _check_boss_crowd_cocoon(gd, sim) -> void:
	for mid in gd.monsters:
		for sid in gd.monsters[mid].crowd_skills:
			check(gd.skills.has(sid) and gd.monsters[mid].is_boss, "crowd_skills de %s: %s existe e é chefe" % [mid, sid])
	var qd: MonsterDef = gd.monsters["spider_queen"]
	check("mob_cocoon" in qd.crowd_skills and not ("mob_cocoon" in qd.skill_ids), "Rainha: Casulo só como mecânica de 4+")
	for ph in qd.phases:
		check(not ("mob_cocoon" in ph.get("skills", [])), "Rainha: Casulo não entra por fase (valeria no solo)")
	var cd: MonsterDef = gd.monsters.get("web_cocoon")
	check(cd != null and cd.move_speed == 0.0 and cd.xp == 0 and cd.loot_table == "", "casulo: não anda, sem XP nem saque")
	check((gd.skills["mob_cocoon"] as SkillDef).effects.has("cocoon") and (gd.skills["mob_cocoon"] as SkillDef).mob_pick == "soft", "Casulo mira o frágil (mob_pick soft)")
	var at := Vector3(-40, 0, 40)
	var q: SimEntity = sim.spawn_monster(qd, "city_aldara", at)
	q.brain = null
	var mk := func(cname: String, pos: Vector3) -> SimEntity:
		var b = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cname], cname, "city_aldara", pos, 20)
		b.brain = null
		return b
	var a: SimEntity = mk.call("paladin", at + Vector3(2, 0, 0))
	var members: Array = [a]
	for cname in ["bishop", "elementalist", "berserker"]:
		var o: SimEntity = mk.call(cname, at + Vector3(-3 - members.size(), 0, 2))
		members.append(o)
	q.threat = {a.id: 50.0}
	q.aggro_target = a.id
	var has_cocoon := func() -> bool: return gd.skills["mob_cocoon"] in q.skills
	# solo e trio: sem casulo (o grupo vai crescendo de 1 em 1)
	for n in [1, 2, 3]:
		if n > 1:
			sim.party_invite(a, members[n - 1])
			sim.party_accept(members[n - 1])
		q.crowd_t = 0.0
		MobSystem.update_boss(sim, q, 0.05)
		check(q.crowd == n and not has_cocoon.call(), "Rainha com %d: sem Casulo (crowd=%d)" % [n, q.crowd])
	sim.party_invite(a, members[3])
	sim.party_accept(members[3])
	q.crowd_t = 0.0
	MobSystem.update_boss(sim, q, 0.05)
	check(q.crowd == 4 and q.crowd_peak == 4 and has_cocoon.call(), "Rainha com 4: Casulo entra (crowd=%d)" % q.crowd)
	members[3].position = at + Vector3(Balance.BOSS_CROWD_RANGE + 5.0, 0, 0)
	q.crowd_t = 0.0
	MobSystem.update_boss(sim, q, 0.05)
	check(q.crowd == 3 and has_cocoon.call(), "Rainha: um sai (ou morre) e o Casulo fica (vale pelo pico da luta)")
	members[3].position = at + Vector3(-6, 0, 2)
	# casulo quebrado: solta sem dano
	var v: SimEntity = members[1]
	var hp0: float = v.hp
	MobSystem.cocoon(sim, q, v, {"id": "web_cocoon"})
	var add: SimEntity = null
	for o: SimEntity in sim.maps["city_aldara"]["entities"]:
		if o.monster_def == cd and o.aggro_target == v.id:
			add = o
	check(add != null and add.boss_id == q.id and v.state == SimEntity.State.STUNNED and v.has_debuff("cocoon"), "Casulo prende a vítima num lacaio da Rainha")
	check(MobSystem.adds_alive(sim, q) >= 1, "casulo conta como lacaio (escudo da fase 2)")
	check(MobSystem.cocoon_of(sim, members[2], members, Balance.BOT_COCOON_RANGE) == add, "bot do grupo acha o casulo do aliado")
	MobSystem.cocoon(sim, q, v, {"id": "web_cocoon"})
	var n_add := 0
	for o: SimEntity in sim.maps["city_aldara"]["entities"]:
		if o.monster_def == cd and o.is_alive():
			n_add += 1
	check(n_add == 1, "vítima já presa não ganha 2º casulo")
	MobSystem.cocoon_tick(sim, v)
	check(v.state == SimEntity.State.STUNNED, "casulo inteiro e tempo correndo: segue preso")
	sim.despawn(add)                          # quebrado (morto ou sumido com o chefe)
	MobSystem.cocoon_tick(sim, v)
	check(v.state != SimEntity.State.STUNNED and not v.has_debuff("cocoon"), "casulo quebrado: solta (estado %d)" % v.state)
	check(is_equal_approx(v.hp, hp0), "casulo quebrado: sem dano (%.0f -> %.0f)" % [hp0, v.hp])
	# tempo esgotado: aperta
	MobSystem.cocoon(sim, q, v, {"id": "web_cocoon"})
	var add2: SimEntity = null
	for o: SimEntity in sim.maps["city_aldara"]["entities"]:
		if o.monster_def == cd and o.is_alive() and o.aggro_target == v.id:
			add2 = o
	v.iframe_left = 0.0
	v.state_time = v.state_duration
	MobSystem.cocoon_tick(sim, v)
	var lost: float = (hp0 - v.hp) / v.stats.max_hp
	check(v.state != SimEntity.State.STUNNED and not v.has_debuff("cocoon") and not sim.entities.has(add2.id), "tempo esgotado: casulo some e solta")
	check(absf(lost - Balance.COCOON_BURST) < 0.02, "tempo esgotado: aperta %.2f da vida (perdeu %.2f)" % [Balance.COCOON_BURST, lost])
	sim.reset_boss(q)
	check(not has_cocoon.call() and q.crowd_peak == 0, "reset da Rainha tira o Casulo")
	for o in members.slice(1):
		sim.party_leave(o)
	for o in members + [q]:
		sim.despawn(o)
	_cocoon_breakers(gd, sim)

## Quem quebra o casulo (BotBrain._cocoon_target): o LÍDER dps do grupo também (antes só seguidores), o bot sozinho
## perto do jogador preso também; o tanque líder segue no chefe. A Rainha fica mais perto que o casulo (o combate
## reativo pegaria o mais perto: o teste é da regra, não da distância).
func _cocoon_breakers(gd, sim) -> void:
	var map_id := "field_forest" if sim.maps.has("field_forest") else "city_aldara"
	var m: Dictionary = sim.maps[map_id]
	var def: MapDef = m["def"]
	var at: Vector3 = def.spawn_point + Vector3(30, 0, 30)
	var qd: MonsterDef = gd.monsters["spider_queen"]
	var mk := func(kind: int, cname: String, pos: Vector3) -> SimEntity:
		var b: SimEntity = sim.spawn_character(kind, gd.classes[cname], cname, map_id, pos, 20)
		b.brain = null
		b.stats.evasion = 0.0
		return b
	var cocoon_on := func(v: SimEntity, q: SimEntity) -> SimEntity:
		MobSystem.cocoon(sim, q, v, {"id": "web_cocoon"})
		for o: SimEntity in m["entities"]:
			if o.monster_def != null and o.monster_def.id == "web_cocoon" and o.is_alive() and o.aggro_target == v.id:
				return o
		return null
	# [classe do bot que pensa, quebra?, sozinho perto do jogador?]
	for row in [["berserker", true, false], ["paladin", false, false], ["berserker", true, true]]:
		var solo: bool = row[2]
		var q: SimEntity = sim.spawn_monster(qd, map_id, at)
		q.brain = null
		var lead: SimEntity = mk.call(SimEntity.Kind.BOT, row[0], at + Vector3(1.5, 0, 0))
		var v: SimEntity = mk.call(SimEntity.Kind.PLAYER if solo else SimEntity.Kind.BOT, "bishop", at + Vector3(1.5 + 6.0, 0, 0))
		var keep = sim.player
		if solo:
			sim.player = v
		else:
			sim.party_invite(lead, v)
			sim.party_accept(v)
		q.threat = {lead.id: 50.0}
		q.aggro_target = lead.id
		var add: SimEntity = cocoon_on.call(v, q)
		var role: String = sim.role_of(lead)
		var bb := BotBrain.new()
		bb.setup(lead, RandomNumberGenerator.new())
		var cmd: InputCommand = bb.think(lead, sim, m, 0.05)
		var tag := "%s %s (%s)" % ["sozinho perto do jogador" if solo else "líder do grupo", row[0], role]
		check(add != null and (solo or sim.party_leader(lead) == lead) and not def.in_town(lead.position), "%s: casulo de pé e fora da vila" % tag)
		if row[1]:
			check(role != "tank" and role != "healer" and bb.hunt_target_id == add.id and cmd.aim.is_equal_approx(add.position),
				"%s quebra o casulo do aliado (alvo %d, casulo %d)" % [tag, bb.hunt_target_id, add.id])
		else:
			check(role == "tank" and bb.hunt_target_id != add.id and not cmd.aim.is_equal_approx(add.position),
				"%s segue no chefe e não quebra o casulo (alvo %d)" % [tag, bb.hunt_target_id])
		if solo:
			sim.player = keep
		else:
			sim.party_leave(v)
		for o in [add, v, lead, q]:
			if o != null and sim.entities.has(o.id):
				sim.despawn(o)

## IA de grupo (BotBrain): papel pela build, lugar por papel contra chefe preso no tanque (costas/flanco, fora da frente),
## ameaça (passou o tanque: para), cura com o tanque primeiro, tanque não foge do golpe do próprio chefe, sem guarda
## nas costas, dps de perto tira lacaio de quem cura. Números em Balance.BOT_* (medidos com boss_probe --comp).
## Ameaça do tanque (2026-11-12): toda build de tanque tem postura que multiplica a ameaça (Aura do Bastião, Urso) e
## provocar; provocar deixa folga de TAUNT_THREAT_LEAD; o tanque bot provoca de novo antes de o dps frear; e no mesmo
## dano o tanque gera bem mais ameaça que um dps (o dps não chega a BOT_THREAT_HOLD da ameaça dele).
func _check_tank_threat(gd, sim) -> void:
	var at := Vector3(-30, 0, 30)
	var n_tanks := 0
	for cid in gd.classes:
		var cd = gd.classes[cid]
		for b in cd.builds:
			if str(b.get("role", "")) != "tank":
				continue
			n_tanks += 1
			var stance := 0.0
			var taunts := false
			for sid in b.get("skills", []):
				var sk: SkillDef = gd.skills.get(sid)
				if sk == null:
					continue
				taunts = taunts or sk.effects.has("taunt")
				var bf = sk.effects.get("buff")
				if bf is Dictionary and bf.get("toggle", false):
					stance = maxf(stance, float(bf.get("threat_pct", 0)))
				if sk.effects.has("form") and Balance.FORM_STATS.has(str(sk.effects["form"])):
					stance = maxf(stance, float(Balance.FORM_STATS[str(sk.effects["form"])].get("threat_pct", 0)))
			check(stance >= Balance.BEAR_THREAT_PCT and taunts, "tanque %s/%s: postura com +%d%% de ameaça ou mais e provocar (tem %d%%, provoca=%s)" % [cid, b["id"], Balance.BEAR_THREAT_PCT, stance, taunts])
	check(n_tanks >= 2, "há builds de tanque para conferir (%d)" % n_tanks)
	check(Balance.TAUNT_THREAT_LEAD * Balance.BOT_THREAT_HOLD > 1.0 and Balance.BOT_TANK_RETAUNT < Balance.BOT_THREAT_HOLD, "provocar deixa o dps abaixo do freio e o tanque provoca antes do freio")
	var mk := func(cid: String, bid: String, pos: Vector3) -> SimEntity:
		var e = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], "T" + bid, "city_aldara", pos, 30)
		e.build_id = bid
		sim._gear_bot(e)
		sim._skill_bot(e)
		e.brain = null
		return e
	for pair in [["paladin", "guardiao"], ["druid", "guardiao_verde"]]:
		var tank: SimEntity = mk.call(pair[0], pair[1], at + Vector3(0, 0, 2))
		var dps: SimEntity = mk.call("berserker", "executor", at + Vector3(0, 0, -2))
		sim.party_invite(tank, dps)
		sim.party_accept(dps)
		var boss: SimEntity = sim.spawn_monster(gd.monsters["bandit_chief"], "city_aldara", at)
		boss.brain = null
		# postura ligada: lança a skill de postura do tanque (aura ou forma)
		var stance_slot := -1
		var taunt_slot := -1
		for i in tank.skills.size():
			var sk: SkillDef = tank.skills[i]
			if sk == null:
				continue
			var bf = sk.effects.get("buff")
			if (bf is Dictionary and bf.get("toggle", false) and float(bf.get("threat_pct", 0)) > 0.0) or (sk.effects.has("form") and float(Balance.FORM_STATS.get(str(sk.effects["form"]), {}).get("threat_pct", 0)) > 0.0):
				stance_slot = i
			if sk.effects.has("taunt"):
				taunt_slot = i
		check(stance_slot >= 0 and taunt_slot >= 0, "%s nv 30 leva postura e provocar na barra" % pair[1])
		if stance_slot < 0 or taunt_slot < 0:
			for o in [tank, dps, boss]:
				sim.despawn(o)
			continue
		var stance_sk: SkillDef = tank.skills[stance_slot]
		if stance_sk.effects.has("form"):
			tank.form = str(stance_sk.effects["form"])
		else:
			var nb: Dictionary = (stance_sk.effects["buff"] as Dictionary).duplicate()
			nb["remaining"] = 999.0
			tank.put_buff(nb)
		tank.recompute_stats()
		# luta roteirizada: o mesmo dano dos dois, golpe a golpe; quem bate primeiro é o tanque
		boss.threat = {}
		for k in 40:
			sim._deal_damage(tank, boss, 100, false, false, "physical", tank.position)
			boss.hp = boss.stats.max_hp
			sim._deal_damage(dps, boss, 100, false, false, "physical", dps.position)
			boss.hp = boss.stats.max_hp
		var r := float(boss.threat.get(dps.id, 0.0)) / maxf(1.0, float(boss.threat.get(tank.id, 0.0)))
		check(boss.aggro_target == tank.id and r < Balance.BOT_THREAT_HOLD * 0.6, "%s: mesmo dano, o dps fica bem abaixo do freio (dps/tanque=%.2f < %.2f) e o chefe fica no tanque" % [pair[1], r, Balance.BOT_THREAT_HOLD * 0.6])
		# provocar: folga de TAUNT_THREAT_LEAD sobre o maior
		boss.threat = {tank.id: 100.0, dps.id: 1000.0}
		boss.aggro_target = dps.id
		MobSystem.taunt(sim, boss, tank, 4.0)
		check(boss.aggro_target == tank.id and is_equal_approx(float(boss.threat[tank.id]), 1000.0 * Balance.TAUNT_THREAT_LEAD + 1.0), "%s: provocar deixa a ameaça em %.1f x a maior" % [pair[1], Balance.TAUNT_THREAT_LEAD])
		# tanque bot provoca de novo o chefe que segura quando o dps chega perto da ameaça dele (antes do freio)
		var bt := BotBrain.new()
		bt.setup(tank, RandomNumberGenerator.new())
		var m: Dictionary = sim.maps["city_aldara"]
		tank.cooldowns.clear()
		tank.mp = tank.stats.max_mp
		boss.taunt_left = 0.0
		boss.threat = {tank.id: 1000.0, dps.id: 1000.0 * Balance.BOT_TANK_RETAUNT + 1.0}
		var cmd := InputCommand.new()
		check(bt._taunt_party(tank, sim, m, sim.party_members(tank), cmd) and cmd.skill_slot == taunt_slot, "%s: o dps chegou a %d%% da ameaça: provoca de novo" % [pair[1], int(Balance.BOT_TANK_RETAUNT * 100)])
		boss.threat[dps.id] = 1000.0 * Balance.BOT_TANK_RETAUNT * 0.5
		cmd = InputCommand.new()
		check(not bt._taunt_party(tank, sim, m, sim.party_members(tank), cmd), "%s: com folga na ameaça não gasta a provocação" % pair[1])
		# dps com provocação (ex.: Brado da Arena do Executor) não rouba o chefe que o tanque do grupo segura
		var bd := BotBrain.new()
		bd.setup(dps, RandomNumberGenerator.new())
		var dslot := dps.skills.size()
		var tsk: SkillDef = tank.skills[taunt_slot].duplicate(true)
		tsk.requires.clear()
		tsk.unlock_level = 1
		tsk.radius = maxf(tsk.radius, 8.0)
		dps.skills.append(tsk)
		dps.learned[tsk.id] = true
		dps.cooldowns.clear()
		dps.mp = dps.stats.max_mp
		dps.position = boss.position + Vector3(1.5, 0, 0)
		boss.aggro_target = tank.id
		boss.threat = {tank.id: 1000.0, dps.id: 999.0}
		cmd = InputCommand.new()
		check(bd._role(dps, sim) != "tank" and not bd._taunt_party(dps, sim, m, sim.party_members(dps), cmd), "%s: dps com provocação não puxa o chefe do tanque do grupo" % pair[1])
		boss.aggro_target = -1                  # controle: a mesma provocação vale em monstro que bate num aliado que não é o tanque
		var mob2: SimEntity = sim.spawn_monster(gd.monsters["bandit_chief"], "city_aldara", dps.position + Vector3(0, 0, 1.5))
		mob2.brain = null
		var ally: SimEntity = mk.call("bishop", "sacerdote", dps.position + Vector3(0, 0, 3))
		sim.party_invite(tank, ally)
		sim.party_accept(ally)
		mob2.aggro_target = ally.id
		cmd = InputCommand.new()
		check(bd._taunt_party(dps, sim, m, sim.party_members(dps), cmd), "%s: controle: dps provoca o que bate num aliado que não é o tanque" % pair[1])
		sim.party_leave(ally)
		sim.despawn(ally)
		sim.despawn(mob2)
		dps.skills.remove_at(dslot)
		sim.party_leave(dps)
		for o in [tank, dps, boss]:
			sim.despawn(o)

func _check_bot_group(gd, sim) -> void:
	var at := Vector3(-30, 0, 30)
	var mk := func(cid: String, bid: String, name: String, pos: Vector3) -> SimEntity:
		var b = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], name, "city_aldara", pos, 30)
		b.build_id = bid
		sim._gear_bot(b)
		sim._skill_bot(b)
		b.brain = null
		return b
	var tank: SimEntity = mk.call("paladin", "guardiao", "Tq", at + Vector3(0, 0, 2.5))
	var heal: SimEntity = mk.call("bishop", "sacerdote", "Cura", at + Vector3(6, 0, -6))
	var dps: SimEntity = mk.call("berserker", "carniceiro", "Dps", at + Vector3(0, 0, -2.5))
	var gun: SimEntity = mk.call("ranger", "atirador", "Arma", at + Vector3(-7, 0, -5))
	check(sim.role_of(tank) == "tank" and sim.role_of(heal) == "healer" and sim.role_of(dps) == "dps" and sim.role_of(gun) == "ranged", "papel no grupo vem da build")
	for o in [heal, dps, gun]:
		sim.party_invite(tank, o)
		sim.party_accept(o)
	var boss: SimEntity = sim.spawn_monster(gd.monsters["bandit_chief"], "city_aldara", at)
	boss.brain = null
	boss.aggro_target = tank.id
	boss.aggro_timer = 5.0
	boss.threat = {tank.id: 1000.0}
	var m: Dictionary = sim.maps["city_aldara"]
	var bd := BotBrain.new()
	bd.setup(dps, RandomNumberGenerator.new())
	check(bd._tank_of(dps, sim) == tank, "dps acha o tanque do grupo")
	check(BotBrain._in_front(dps, boss, tank) == false and BotBrain._in_front(mk.call("berserker", "carniceiro", "Frente", at + Vector3(0, 0, 1.0)), boss, tank), "frente do chefe = lado do tanque (costas não são frente)")
	var reach: float = dps.basic_skill.radius if dps.basic_skill else 1.8
	var spot: Vector3 = bd._role_spot(dps, sim, boss, true, reach, tank)
	check(not BotBrain._in_front(dps, boss, tank) and (spot - boss.position).dot(tank.position - boss.position) < 0.0, "corpo a corpo: lugar nas costas do chefe")
	var bg := BotBrain.new()
	bg.setup(gun, RandomNumberGenerator.new())
	var gspot: Vector3 = bg._role_spot(gun, sim, boss, false, 14.0, tank)
	check((gspot - boss.position).dot(tank.position - boss.position) < 0.0 and gspot.distance_to(boss.position) >= Balance.BOT_RANGED_DIST, "longe: flanco de trás a %.0f m+" % Balance.BOT_RANGED_DIST)
	# na frente: sai antes de bater
	dps.position = at + Vector3(0.6, 0, 1.6)
	var cmd: InputCommand = bd._fight(dps, sim, m, boss, InputCommand.new())
	check(cmd.move != Vector2.ZERO and not cmd.attack and cmd.skill_slot < 0, "dps na frente do chefe preso no tanque: sai antes de bater")
	# ameaça: passou o tanque, para
	dps.position = spot
	dps.cooldowns.clear()
	boss.threat[dps.id] = 1000.0 * Balance.BOT_THREAT_STOP + 1.0
	cmd = bd._fight(dps, sim, m, boss, InputCommand.new())
	check(not cmd.attack and cmd.skill_slot < 0, "dps com mais ameaça que o tanque para de bater")
	boss.threat[dps.id] = 0.0
	# tanque bem à frente do básico previsto (crítico + assinatura: 1000 não basta para o Carniceiro do nível)
	boss.threat[tank.id] = maxf(1000.0, (BotBrain._skill_threat(dps, dps.basic_skill, boss, true) + BotBrain._signature_threat(dps, sim, boss)) * 10.0)
	cmd = bd._fight(dps, sim, m, boss, InputCommand.new())
	check(cmd.attack or cmd.skill_slot >= 0 or cmd.move != Vector2.ZERO, "dps nas costas com pouca ameaça luta")
	# cura: tanque primeiro
	var bh := BotBrain.new()
	bh.setup(heal, RandomNumberGenerator.new())
	heal.cooldowns.clear()
	heal.mp = heal.stats.max_mp
	tank.hp = tank.stats.max_hp * (Balance.BOT_HEAL_TANK_HP - 0.05)
	dps.hp = dps.stats.max_hp * (Balance.BOT_HEAL_HP - 0.1)
	cmd = InputCommand.new()
	check(bh._heal_party(heal, sim, sim.party_members(heal), cmd, 0.05) and cmd.aim.distance_to(tank.position) < 0.01, "quem cura vai primeiro no tanque abaixo de %d%%" % int(Balance.BOT_HEAL_TANK_HP * 100))
	tank.hp = tank.stats.max_hp
	cmd = InputCommand.new()
	check(bh._heal_party(heal, sim, sim.party_members(heal), cmd, 0.05) and cmd.aim.distance_to(dps.position) < 0.01, "tanque cheio: cura o mais ferido")
	tank.hp = tank.stats.max_hp * (Balance.BOT_HEAL_TANK_HP - 0.05)
	dps.hp = dps.stats.max_hp * (Balance.BOT_HEAL_CRIT_HP - 0.1)
	cmd = InputCommand.new()
	check(bh._heal_party(heal, sim, sim.party_members(heal), cmd, 0.05) and cmd.aim.distance_to(dps.position) < 0.01, "dps quase morrendo passa na frente do tanque fora de perigo")
	tank.hp = tank.stats.max_hp * (Balance.BOT_HEAL_TANK_SAFE - 0.1)
	cmd = InputCommand.new()
	check(bh._heal_party(heal, sim, sim.party_members(heal), cmd, 0.05) and cmd.aim.distance_to(tank.position) < 0.01, "tanque em perigo continua primeiro")
	tank.hp = tank.stats.max_hp
	dps.hp = dps.stats.max_hp
	# tanque não foge do golpe de frente do chefe que segura; sozinho foge
	boss.state = SimEntity.State.CASTING
	boss.current_skill = gd.skills["mob_whirl"]
	boss.skill_phase = "startup"
	boss.skill_aim = boss.position
	var bt := BotBrain.new()
	bt.setup(tank, RandomNumberGenerator.new())
	check(bt._danger_escape(tank, m, true) == Vector2.ZERO and bt._danger_escape(tank, m, false) != Vector2.ZERO, "tanque no grupo aguenta o giro do chefe que segura (sozinho, foge)")
	check(bd._danger_escape(dps, m) != Vector2.ZERO, "dps foge do giro")
	# investida: foge da linha mesmo estreita
	var ch: SkillDef = gd.skills["mob_charge"]
	check(ch.radius < Balance.BOT_DODGE_MIN_RADIUS and ch.is_charge(), "investida é estreita (abaixo do mínimo de desvio)")
	boss.current_skill = ch
	dps.position = boss.position + boss.forward() * 3.0
	check(bd._danger_escape(dps, m) != Vector2.ZERO, "bot sai da linha da investida")
	boss.state = SimEntity.State.IDLE
	boss.current_skill = null
	# nas costas, sem guarda: quem cura com escudo não bloqueia golpe que não vem
	heal.position = spot
	boss.state = SimEntity.State.CASTING
	boss.current_skill = gd.skills["mob_whirl"]
	boss.skill_phase = "active"
	bh.block_timer = 0.0
	var blocked := false
	for i in 20:
		bh.block_timer = 0.0
		var c: InputCommand = bh._fight(heal, sim, m, boss, InputCommand.new())
		blocked = blocked or c.block
	check(not blocked, "nas costas do chefe preso no tanque: sem guarda")
	boss.state = SimEntity.State.IDLE
	boss.current_skill = null
	# lacaio em quem cura: o dps de perto vai nele; o atirador não
	var add: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", heal.position + Vector3(1.5, 0, 0))
	add.brain = null
	add.aggro_target = heal.id
	check(bd._peel_target(dps, sim, m, sim.party_members(dps)) == add, "dps de perto pega o lacaio em cima de quem cura")
	check(bg._peel_target(gun, sim, m, sim.party_members(gun)) == null, "quem atira não larga o chefe pelo lacaio")
	sim.despawn(add)
	sim.despawn(boss)
	for o in [heal, dps, gun]:
		sim.party_leave(o)
	for o in m["entities"].duplicate():
		if o.name == "Frente":
			sim.despawn(o)
	for o in [tank, heal, dps, gun]:
		sim.despawn(o)

## WP8 (design/gdd/kharzun-fase3-plan.md §4, §9, KAC-02/KAC-11): IA de raide. Lacaio de `ward` (estandarte primeiro), proteger
## quem cura do Matador (tanque provoca de novo, quem cura sai do alcance, dps de perto tira o aprendiz), 5 no lugar contra o
## talho de 150°, tanque vira o chefe, berserk por chefe (MonsterDef.berserk_mult) e viagem a Kharzun.
func _check_bot_raid(gd, sim) -> void:
	var mid := "city_aldara"
	var at := Vector3(-30, 0, -30)
	var m: Dictionary = sim.maps[mid]
	var mk := func(cid: String, bid: String, name: String, pos: Vector3) -> SimEntity:
		var b = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], name, mid, pos, 45)
		b.build_id = bid
		sim._gear_bot(b)
		sim._skill_bot(b)
		b.brain = null
		return b
	var tank: SimEntity = mk.call("paladin", "guardiao", "RTq", at + Vector3(0, 0, 3.0))
	var heal: SimEntity = mk.call("bishop", "sacerdote", "RCura", at + Vector3(6, 0, -6))
	var dps: SimEntity = mk.call("berserker", "executor", "RDps", at + Vector3(0, 0, -3.0))
	var fire: SimEntity = mk.call("elementalist", "fogo", "RFogo", at + Vector3(-7, 0, -5))
	var bat: SimEntity = mk.call("bishop", "batalha", "RBat", at + Vector3(2, 0, -3.0))
	var all: Array = [tank, heal, dps, fire, bat]
	for o in all.slice(1):
		sim.party_invite(tank, o)
		sim.party_accept(o)
	var members: Array = sim.party_members(tank)
	check(members.size() == 5, "raide: grupo de 5 (%d)" % members.size())
	var brains := {}
	for o in all:
		var b := BotBrain.new()
		b.setup(o, RandomNumberGenerator.new())
		brains[o.id] = b
	var bd: BotBrain = brains[dps.id]
	var bf: BotBrain = brains[fire.id]
	var bt: BotBrain = brains[tank.id]
	var bh: BotBrain = brains[heal.id]
	# --- 1. estandartes do Durgash: sem ward fica no chefe; com ward, dps e atirador vão no estandarte mais perto ---
	var boss: SimEntity = sim.spawn_monster(gd.monsters["boss_durgash"], mid, at)
	boss.brain = null
	boss.aggro_target = tank.id
	boss.aggro_timer = 5.0
	boss.threat = {tank.id: 1.0e7}
	bd._fight(dps, sim, m, boss, InputCommand.new())
	check(bd.hunt_target_id == boss.id, "raide: sem ward o dps fica no chefe")
	boss.hp = boss.stats.max_hp * 0.69
	MobSystem.update_boss(sim, boss, Balance.BOSS_WARD_CHECK + 0.1)
	var banners: Array = (m["entities"] as Array).filter(func(o): return o.boss_id == boss.id and o.is_alive())
	for o in banners:
		o.brain = null
	check(boss.ward > 0.0 and banners.size() == 3 and banners.all(func(o): return BotBrain.is_banner(o)), "raide: Durgash a 69%% finca 3 estandartes e liga o ward")
	var guard: SimEntity = sim.spawn_monster(gd.monsters["throne_guard"], mid, dps.position + Vector3(0.8, 0, 0))
	guard.brain = null
	guard.boss_id = boss.id
	var near_of := func(e: SimEntity) -> SimEntity:
		var best: SimEntity = null
		for o in banners:
			if best == null or o.position.distance_to(e.position) < best.position.distance_to(e.position):
				best = o
		return best
	bd._fight(dps, sim, m, boss, InputCommand.new())
	check(bd.hunt_target_id == near_of.call(dps).id, "raide: ward ligado = dps de perto vai no estandarte mais perto (não no guarda colado nele)")
	bf._fight(fire, sim, m, boss, InputCommand.new())
	check(bf.hunt_target_id == near_of.call(fire).id, "raide: quem luta de longe também mira estandarte")
	bd._fight(dps, sim, m, guard, InputCommand.new())
	check(bd.hunt_target_id != guard.id and BotBrain.is_banner(sim.entities[bd.hunt_target_id]), "raide: lacaio que anda perde para o estandarte")
	bt._fight(tank, sim, m, boss, InputCommand.new())
	check(bt.hunt_target_id == boss.id, "raide: o tanque segura o chefe com ward")
	check(bh._ward_add(heal, sim, m, boss) == null, "raide: quem cura não larga a cura pelo estandarte")
	for o in banners:
		sim.despawn(o)
	bd._fight(dps, sim, m, boss, InputCommand.new())
	check(bd.hunt_target_id == guard.id, "raide: sem estandarte, o lacaio de ward que sobrou")
	sim.despawn(guard)
	MobSystem.update_boss(sim, boss, Balance.BOSS_WARD_CHECK + 0.1)
	bd._fight(dps, sim, m, boss, InputCommand.new())
	check(boss.ward == 0.0 and bd.hunt_target_id == boss.id, "raide: lacaios caídos = de volta ao chefe")
	# --- 3. raide de 5 no lugar: frente do talho de 150°, cada um numa vaga, tanque vira o chefe ---
	var cleave: SkillDef = gd.skills["mob_durgash_cleave"]
	check(BotBrain.front_arc(boss) >= cleave.cone_angle_deg * 0.5 + 5.0, "raide: frente do Durgash cobre o talho de %d° (%.0f°)" % [cleave.cone_angle_deg, BotBrain.front_arc(boss)])
	var side80 := Vector3(sin(deg_to_rad(80.0)), 0, cos(deg_to_rad(80.0))) * 3.0      # 80° da direção do tanque (+z)
	dps.position = at + side80
	check(BotBrain._in_front(dps, boss, tank), "raide: a 80° do tanque ainda é frente do Durgash (talho pega)")
	var spots := {}
	for o in all.slice(1):
		var reach: float = o.basic_skill.radius if o.basic_skill and o.basic_skill.target == SkillDef.Target.CONE else (o.basic_skill.range if o.basic_skill else 1.8)
		var melee: bool = not o.class_def.basic_attack_is_ranged or (o.basic_skill != null and o.basic_skill.target == SkillDef.Target.CONE)
		spots[o.id] = brains[o.id]._role_spot(o, sim, boss, melee, reach, tank)
	var keep := {}
	for o in all.slice(1):
		keep[o.id] = o.position
		o.position = spots[o.id]
	check(all.slice(1).all(func(o): return not BotBrain._in_front(o, boss, tank)), "raide: as 4 vagas ficam fora da frente do Durgash")
	var min_gap := INF
	for i in range(1, all.size()):
		for j in range(i + 1, all.size()):
			min_gap = minf(min_gap, (spots[all[i].id] as Vector3).distance_to(spots[all[j].id]))
	check(min_gap >= 1.5, "raide: vagas separadas (menor vão %.1f m)" % min_gap)
	check(bt._turn_spot(tank, sim, boss, 2.0) == Vector3.INF, "raide: grupo nas costas = tanque não mexe")
	for o in all.slice(1):
		o.position = at + Vector3(0.5 * (all.find(o) - 2), 0, 2.2)
	var turn: Vector3 = bt._turn_spot(tank, sim, boss, 2.0)
	check(turn != Vector3.INF and (turn - boss.position).z < 0.0, "raide: grupo na frente do chefe = tanque dá a volta para o outro lado")
	for o in all.slice(1):
		o.position = keep[o.id]
	sim.despawn(boss)
	# --- 2. Shazka: tanque provoca de novo, quem cura sai do alcance da Misericórdia, dps de perto tira o aprendiz ---
	var sz: SimEntity = sim.spawn_monster(gd.monsters["boss_shazka"], mid, at)
	sz.brain = null
	sz.aggro_target = tank.id
	sz.threat = {tank.id: 1.0e7}
	sim._add_skills(sz, ["mob_shazka_mercy"])
	check(BotBrain.soft_striker(sz) and not BotBrain.soft_striker(sim.spawn_monster(gd.monsters["boss_ulgra"], mid, at + Vector3(40, 0, 40))), "Shazka (Misericórdia) é golpe curto em quem cura; Ulgra não")
	for o in (m["entities"] as Array).duplicate():
		if o.monster_def and o.monster_def.id == "boss_ulgra":
			sim.despawn(o)
	tank.position = at + Vector3(0, 0, 2.5)
	heal.position = at + Vector3(10, 0, 10)
	check(not BotBrain.soft_in_danger(sz, members), "Shazka longe de quem cura: sem provocação extra")
	var c0 := InputCommand.new()
	check(not bh._evade_boss(heal, sim, m, c0), "quem cura longe do Matador não foge")
	heal.position = at + Vector3(2.5, 0, -1.5)
	check(BotBrain.soft_in_danger(sz, members), "Shazka colado em quem cura = perigo")
	tank.cooldowns.clear()
	tank.mp = tank.stats.max_mp
	var ct := InputCommand.new()
	var taunted: bool = bt._taunt_party(tank, sim, m, members, ct)
	check(taunted and ct.skill_slot >= 0 and tank.skills[ct.skill_slot].effects.has("taunt"), "Shazka em cima de quem cura: o tanque provoca de novo")
	var ch := InputCommand.new()
	check(bh._evade_boss(heal, sim, m, ch) and Vector2(heal.position.x - sz.position.x, heal.position.z - sz.position.z).dot(ch.move) > 0.0, "quem cura sai para longe do Matador (fora da Misericórdia)")
	heal.position = at + Vector3(9, 0, 9)
	sz.state = SimEntity.State.CASTING
	sz.current_skill = gd.skills["mob_shazka_step"]
	sz.skill_aim = heal.position
	check(BotBrain.soft_in_danger(sz, members), "Passo nas Costas mirado em quem cura = o tanque provoca")
	sz.state = SimEntity.State.IDLE
	sz.current_skill = null
	var ap: SimEntity = sim.spawn_monster(gd.monsters["shadow_apprentice"], mid, heal.position + Vector3(1.2, 0, 0))
	ap.brain = null
	ap.boss_id = sz.id
	ap.aggro_target = heal.id
	check(bd._peel_target(dps, sim, m, members) == ap, "aprendiz em cima de quem cura: o dps de perto vai nele")
	sim.despawn(ap)
	sim.despawn(sz)
	# --- 5. berserk por chefe ---
	var dd: MonsterDef = gd.monsters["boss_durgash"]
	check(dd.berserk_mult > Balance.BOSS_BERSERK_MULT and dd.berserk_after > 0.0, "Durgash: berserk próprio (×%.2f aos %.0f s) acima do padrão ×%.1f" % [dd.berserk_mult, dd.berserk_after, Balance.BOSS_BERSERK_MULT])
	check(is_equal_approx(MobSystem.berserk_mult(gd.monsters["boss_ghar"]), Balance.BOSS_BERSERK_MULT), "chefe sem berserk_mult usa Balance.BOSS_BERSERK_MULT")
	var db: SimEntity = sim.spawn_monster(dd, mid, at)
	db.brain = null
	db.aggro_target = tank.id
	db.fight_time = dd.berserk_after
	MobSystem.update_boss(sim, db, 0.05)
	check(db.berserk and is_equal_approx(db.dmg_mult, db.enrage_mult * dd.berserk_mult * db.crowd_mult), "Durgash enlouquecido: dano × berserk_mult dele (%.2f)" % db.dmg_mult)
	sim.despawn(db)
	for o in (m["entities"] as Array).duplicate():
		if o.boss_id >= 0 and not sim.entities.has(o.boss_id):
			sim.despawn(o)
	for o in all.slice(1):
		sim.party_leave(o)
	for o in all:
		sim.despawn(o)
	# --- 4. viagem: 41 caça em Kharzun sozinho, 38 nunca; masmorras só seguindo o grupo (portal pelo campo) ---
	var trip := func(lv: int) -> Dictionary:
		var b = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["berserker"], "RViaja", mid, at, lv)
		var br := BotBrain.new()
		var r := RandomNumberGenerator.new()
		r.seed = 4507
		br.setup(b, r)
		var seen := {}
		for i in 80:
			br._plan_trip(b, sim)
			seen[br.dest_map] = true
		sim.despawn(b)
		return seen
	var s41: Dictionary = trip.call(41)
	var s38: Dictionary = trip.call(38)
	check(s41.has("field_kharzun") and not s41.has("dg_slayers") and not s41.has("kharzun_citadel"), "bot 41 sozinho caça no Monte Kharzun, nunca nas masmorras (%s)" % str(s41.keys()))
	check(not s38.has("field_kharzun"), "bot 38 nunca escolhe Kharzun (%s)" % str(s38.keys()))
	for dg in ["dg_slayers", "kharzun_citadel"]:
		check(gd.maps[dg].parent_map == "field_kharzun" and PortalSystem.portal_towards(gd.maps["field_kharzun"], dg).get("target_map", "") == dg, "%s: seguidor acha o portal no Monte Kharzun" % dg)
		check(not PortalSystem.portal_towards(gd.maps[GameData.town_map_id()], dg).is_empty(), "%s: da cidade o seguidor acha o caminho" % dg)

## Abertura do grupo (BotBrain._opener): com tanque no grupo, quem não é o tanque segura as skills no chefe/elite até ele
## ficar BOT_OPENER_TIME s preso no tanque (com ameaça dele) e só usa o básico abaixo de BOT_OPENER_RATIO × a ameaça do
## tanque (buff em si pode); área num lacaio perto do chefe também espera; tanque que não pega em BOT_OPENER_WAIT s libera; o
## tanque guarda a provocação para o estouro. Antes o Fogo tirava o chefe do tanque na abertura do Ato II.
func _check_bot_opener(gd, sim) -> void:
	check(Balance.BOT_OPENER_TIME > 0.0 and Balance.BOT_OPENER_WAIT > Balance.BOT_OPENER_TIME and Balance.BOT_OPENER_RATIO > 0.0 and Balance.BOT_OPENER_RATIO < Balance.BOT_THREAT_HOLD, "abertura: números coerentes (espera > tempo preso; razão abaixo do freio)")
	var at := Vector3(-30, 0, 30)
	var mk := func(cid: String, bid: String, name: String, pos: Vector3) -> SimEntity:
		var b = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], name, "city_aldara", pos, 30)
		b.build_id = bid
		sim._gear_bot(b)
		sim._skill_bot(b)
		b.brain = null
		return b
	var t0: float = sim.time
	var tank: SimEntity = mk.call("paladin", "guardiao", "TqA", at + Vector3(0, 0, 2.5))
	var dps: SimEntity = mk.call("berserker", "carniceiro", "DpsA", at + Vector3(0, 0, -2.5))
	var fire: SimEntity = mk.call("elementalist", "fogo", "FogoA", at + Vector3(-8, 0, -6))
	for o in [dps, fire]:
		sim.party_invite(tank, o)
		sim.party_accept(o)
	var boss: SimEntity = sim.spawn_monster(gd.monsters["bandit_chief"], "city_aldara", at)
	boss.brain = null
	boss.aggro_target = tank.id
	boss.aggro_timer = 5.0
	boss.threat = {tank.id: 1000.0}
	var m: Dictionary = sim.maps["city_aldara"]
	var bf := BotBrain.new()
	bf.setup(fire, RandomNumberGenerator.new())
	check(bf._opener(fire, sim, m, boss, tank) == boss, "abertura: chefe recém-preso no tanque segura as skills do Fogo")
	check(bf._opener(tank, sim, m, boss, tank) == null and bf._opener(fire, sim, m, boss, null) == null, "abertura: não vale para o tanque nem sem tanque")
	sim.time = t0 + Balance.BOT_OPENER_TIME + 0.1
	check(bf._opener(fire, sim, m, boss, tank) == null, "abertura: %.0f s preso no tanque, luta normal" % Balance.BOT_OPENER_TIME)
	boss.aggro_target = fire.id
	check(bf._opener(fire, sim, m, boss, tank) == boss, "abertura: chefe largou o tanque, segura de novo")
	sim.time += Balance.BOT_OPENER_WAIT + 0.1
	bf.opener_id = -1
	check(bf._opener(fire, sim, m, boss, tank) == boss, "abertura: chefe novo, relógio da espera recomeça")
	sim.time += Balance.BOT_OPENER_WAIT + 0.1
	check(bf._opener(fire, sim, m, boss, tank) == null, "abertura: tanque não pegou em %.0f s, luta normal (não trava o grupo)" % Balance.BOT_OPENER_WAIT)
	boss.aggro_target = tank.id
	# área no lacaio colado no chefe também espera
	var add: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", at + Vector3(2, 0, 0))
	add.brain = null
	bf.opener_id = -1
	check(bf._opener(fire, sim, m, add, tank) == boss, "abertura: lacaio a %.0f m do chefe conta como o chefe" % Balance.BOT_OPENER_AOE_RANGE)
	add.position = at + Vector3(Balance.BOT_OPENER_AOE_RANGE + 3.0, 0, 0)
	check(bf._opener(fire, sim, m, add, tank) == null, "abertura: lacaio longe do chefe, luta normal")
	sim.despawn(add)
	BotBrain.opener_enabled = false
	bf.opener_id = -1
	check(bf._opener(fire, sim, m, boss, tank) == null, "abertura desligada (sonda --no_opener): luta normal")
	BotBrain.opener_enabled = true
	# no comando: o dps de perto nas costas só usa o básico, e nem ele acima da razão
	var bd := BotBrain.new()
	bd.setup(dps, RandomNumberGenerator.new())
	var reach: float = dps.basic_skill.radius if dps.basic_skill else 1.8
	dps.position = bd._role_spot(dps, sim, boss, true, reach, tank)
	dps.cooldowns.clear()
	dps.mp = dps.stats.max_mp
	dps.basic_cd = 0.0
	var dist: float = dps.position.distance_to(boss.position)
	check(bd._best_skill(dps, sim, m, boss, dist) >= 0, "abertura: o dps tem skill pronta (base do teste)")
	var tk_thr: float = 1000.0 + 20.0 * BotBrain._skill_threat(dps, dps.basic_skill, boss)     # tanque bem à frente do básico do dps
	boss.threat = {tank.id: tk_thr, dps.id: 0.0}
	var cmd: InputCommand = bd._fight(dps, sim, m, boss, InputCommand.new())
	check(cmd.skill_slot < 0 and cmd.attack, "abertura: dps nas costas só no básico (sem skill)")
	boss.threat[dps.id] = tk_thr * Balance.BOT_OPENER_RATIO + 1.0
	cmd = bd._fight(dps, sim, m, boss, InputCommand.new())
	check(cmd.skill_slot < 0 and not cmd.attack, "abertura: dps a %.0f%% da ameaça do tanque nem básico" % (Balance.BOT_OPENER_RATIO * 100.0))
	boss.threat[dps.id] = 0.0
	sim.time += Balance.BOT_OPENER_TIME + 0.1
	cmd = bd._fight(dps, sim, m, boss, InputCommand.new())
	check(cmd.skill_slot >= 0 or cmd.attack, "abertura: passado o tempo, o dps luta normal")
	# dash que fere (Avanço Brutal) não sai na fuga durante a abertura: o Executor tirava o Besteiro do tanque a ~1 s
	dps.talents["ber_t_crash"] = true
	dps.dash_cd = 0.0
	check(BotBrain._dash_hits(dps, sim) and not BotBrain._dash_hits(fire, sim), "abertura: Avanço Brutal conta como dash que fere")
	m["hazards"] = [{"pos": dps.position, "radius": 3.0}]
	var dashes := [0, 0]
	for k in range(2):
		sim.time += 0.0 if k == 0 else Balance.BOT_OPENER_TIME + 0.1
		for i in range(12):
			var bz := BotBrain.new()
			var rz := RandomNumberGenerator.new()
			rz.seed = 31 + i
			bz.setup(dps, rz)
			if k == 1:
				bz.opener_id = boss.id
				bz.opener_seen = sim.time - Balance.BOT_OPENER_WAIT - 1.0
				bz.opener_held = sim.time - Balance.BOT_OPENER_TIME - 1.0
			dashes[k] += 1 if bz._fight(dps, sim, m, boss, InputCommand.new()).dash else 0
	check(dashes[0] == 0, "abertura: fugindo da área, sem dash que fere (%d/12 deram dash)" % dashes[0])
	check(dashes[1] > 0, "abertura: passada a abertura, a fuga volta a usar o dash (%d/12)" % dashes[1])
	m["hazards"] = []
	dps.talents.erase("ber_t_crash")
	# buff em si (sem dano/provocação) não espera; skill de dano espera
	var bl: SkillDef = gd.skills["ber_bloodlust"]
	check(BotBrain._self_buff(bl) and not BotBrain._self_buff(gd.skills["pal_taunt"]) and not BotBrain._self_buff(gd.skills["ele_fireball"]), "abertura: Sede de Sangue pode, Provocar e Bola de Fogo esperam")
	# o tanque guarda a provocação (recarga longa) para quando o dps estourar: não provoca o chefe que já mira nele
	var bt := BotBrain.new()
	bt.setup(tank, RandomNumberGenerator.new())
	tank.cooldowns.clear()
	tank.mp = tank.stats.max_mp
	boss.threat = {}
	boss.taunt_left = 0.0
	boss.aggro_target = tank.id
	cmd = InputCommand.new()
	check(not bt._taunt_party(tank, sim, m, sim.party_members(tank), cmd), "abertura: tanque com o chefe nele guarda a provocação")
	boss.aggro_target = dps.id
	cmd = InputCommand.new()
	check(bt._taunt_party(tank, sim, m, sim.party_members(tank), cmd) and tank.skills[cmd.skill_slot].effects.has("taunt"), "chefe no dps: o tanque provoca")
	sim.time = t0
	sim.despawn(boss)
	for o in [dps, fire]:
		sim.party_leave(o)
	for o in [tank, dps, fire]:
		sim.despawn(o)

## Ameaça prevista (BotBrain._threat_budget/_skill_threat/_pending_threat): com o chefe preso no tanque, a skill cujo golpe
## (+ dano no tempo) passaria BOT_THREAT_HOLD × a ameaça do tanque espera; o dano no tempo pendente conta como ameaça já
## feita; área num lacaio colado no chefe usa o orçamento do chefe. Antes o Meteoro saía a 0,6 do tanque e passava dele.
func _check_bot_threat_budget(gd, sim) -> void:
	var at := Vector3(-30, 0, 30)
	var mk := func(cid: String, bid: String, name: String, pos: Vector3) -> SimEntity:
		var b = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], name, "city_aldara", pos, 30)
		b.build_id = bid
		sim._gear_bot(b)
		sim._skill_bot(b)
		b.brain = null
		return b
	var tank: SimEntity = mk.call("paladin", "guardiao", "TqB", at + Vector3(0, 0, 2.5))
	var fire: SimEntity = mk.call("elementalist", "fogo", "FogoB", at + Vector3(-8, 0, -6))
	sim.party_invite(tank, fire)
	sim.party_accept(fire)
	var boss: SimEntity = sim.spawn_monster(gd.monsters["bandit_chief"], "city_aldara", at)
	boss.brain = null
	boss.aggro_target = tank.id
	boss.aggro_timer = 5.0
	var m: Dictionary = sim.maps["city_aldara"]
	var bf := BotBrain.new()
	bf.setup(fire, RandomNumberGenerator.new())
	var meteor: float = BotBrain._skill_threat(fire, gd.skills["ele_meteor"], boss)
	var ball: float = BotBrain._skill_threat(fire, gd.skills["ele_fireball"], boss)
	check(meteor > ball and ball > 0.0 and BotBrain._skill_threat(fire, gd.skills["ber_bloodlust"], boss) == 0.0, "ameaça prevista: Meteoro > Bola de Fogo > 0; buff = 0 (%.0f / %.0f)" % [meteor, ball])
	fire.cooldowns.clear()
	fire.mp = fire.stats.max_mp
	var dist: float = fire.position.distance_to(boss.position)
	# tanque muito à frente: tudo cabe
	boss.threat = {tank.id: meteor * 100.0, fire.id: 0.0}
	bf._threat_budget(fire, m, boss, tank)
	check(bf.threat_boss == boss and bf._best_skill(fire, sim, m, boss, dist) >= 0, "ameaça prevista: com folga o Fogo usa skill")
	# folga menor que qualquer golpe: nenhuma skill de dano sai
	boss.threat = {tank.id: 10.0, fire.id: 0.0}
	bf._threat_budget(fire, m, boss, tank)
	var pick: int = bf._best_skill(fire, sim, m, boss, dist)
	check(pick < 0 or BotBrain._skill_threat(fire, fire.skills[pick], boss) * Balance.BOT_THREAT_PREDICT <= bf.threat_room, "ameaça prevista: skill que passaria o tanque espera")
	# folga que cabe a Bola de Fogo mas não o Meteoro: o Meteoro nunca sai
	boss.threat = {tank.id: (ball * Balance.BOT_THREAT_PREDICT + 1.0) / Balance.BOT_THREAT_HOLD, fire.id: 0.0}
	bf._threat_budget(fire, m, boss, tank)
	pick = bf._best_skill(fire, sim, m, boss, dist)
	check(pick < 0 or fire.skills[pick].id != "ele_meteor", "ameaça prevista: Meteoro espera, golpe menor pode")
	# dano no tempo pendente conta como ameaça
	boss.debuffs.append({"kind": "dot", "id": "dot_%d" % fire.id, "remaining": 2.0, "dps": 50.0, "src": fire.id, "fire": true})
	check(is_equal_approx(BotBrain._pending_threat(fire, boss), 100.0 * (1.0 + fire.stats.threat_pct / 100.0)), "ameaça prevista: queimadura que ainda vai cair conta")
	boss.threat = {tank.id: 1000.0, fire.id: 0.0}
	bf._threat_budget(fire, m, boss, tank)
	check(is_equal_approx(bf.threat_room, 1000.0 * Balance.BOT_THREAT_HOLD - BotBrain._pending_threat(fire, boss)), "ameaça prevista: folga desconta o dano no tempo pendente")
	boss.debuffs.clear()
	# básico pesado: segura quando o próximo golpe passaria BOT_THREAT_STOP × o tanque
	var bb: float = BotBrain._skill_threat(fire, fire.basic_skill, boss)
	check(bb > 0.0, "ameaça prevista: o básico do Fogo tem ameaça (%.0f)" % bb)
	# básico conta o crítico (no teto da variação) para quem tem crítico: o do Executor passava o tanque na abertura
	var ex: SimEntity = mk.call("berserker", "executor", "ExecB", at + Vector3(1.5, 0, 0))
	var eb_mean: float = BotBrain._skill_threat(ex, ex.basic_skill, boss)
	var eb_crit: float = BotBrain._skill_threat(ex, ex.basic_skill, boss, true)
	var cmean: float = 1.0 + clampf(ex.stats.crit_phys / 100.0, 0.0, 1.0) * (Balance.CRIT_MULT - 1.0)
	check(ex.stats.crit_phys >= Balance.BOT_THREAT_CRIT_CHANCE and is_equal_approx(eb_crit / eb_mean, Balance.CRIT_MULT * (1.0 + Balance.DMG_VARIANCE) / cmean),
		"ameaça prevista: básico do Executor conta o crítico no teto (%.0f vs médio %.0f, crítico %.0f%%)" % [eb_crit, eb_mean, ex.stats.crit_phys])
	var ex_sk: SkillDef = gd.skills["ber_overhead"]
	check(is_equal_approx(BotBrain._skill_threat(ex, ex_sk, boss, false), BotBrain._skill_threat(ex, ex_sk, boss)), "ameaça prevista: skill segue com o crítico médio")
	var ex_crit0: float = ex.stats.crit_phys
	ex.stats.crit_phys = Balance.BOT_THREAT_CRIT_CHANCE - 1.0
	check(is_equal_approx(BotBrain._skill_threat(ex, ex.basic_skill, boss, true), BotBrain._skill_threat(ex, ex.basic_skill, boss)), "ameaça prevista: crítico abaixo de BOT_THREAT_CRIT_CHANCE usa o médio")
	ex.stats.crit_phys = ex_crit0
	# o golpe de verdade aplica a marca no alvo: a estimativa também
	boss.debuffs.append({"kind": "curse", "id": "t_mark", "remaining": 5.0, "taken_pct": 20.0, "src": tank.id})
	var marked: float = BotBrain._skill_threat(ex, ex.basic_skill, boss)
	boss.debuffs.clear()
	check(marked > eb_mean * 1.05, "ameaça prevista: marca no alvo (+%% de dano levado) entra na estimativa (%.0f vs %.0f)" % [marked, eb_mean])
	# abertura: o básico que só passaria RATIO × o tanque com o crítico espera (com o médio, sairia)
	var bex := BotBrain.new()
	bex.setup(ex, RandomNumberGenerator.new())
	sim.party_invite(tank, ex)
	sim.party_accept(ex)
	ex.position = bex._role_spot(ex, sim, boss, true, ex.basic_skill.range, tank)
	ex.cooldowns.clear()
	ex.basic_cd = 0.0
	var thr_tank: float = (eb_mean + eb_crit) * 0.5 / Balance.BOT_OPENER_RATIO     # médio cabe, crítico não
	boss.threat = {tank.id: thr_tank, ex.id: 0.0}
	bex.opener_id = boss.id
	bex.opener_seen = sim.time
	bex.opener_held = sim.time
	var c3: InputCommand = bex._fight(ex, sim, m, boss, InputCommand.new())
	check(not c3.attack and (c3.skill_slot < 0 or BotBrain._self_buff(ex.skills[c3.skill_slot])), "abertura: básico do Executor que passaria com crítico espera")
	# a assinatura (Golpe Avassalador) que o básico lança junto conta, fora da recarga dela
	ex.sig_ready_at = 0.0
	var sig: float = BotBrain._signature_threat(ex, sim, boss)
	check(sig > eb_mean * 0.5, "ameaça prevista: assinatura do Executor conta no básico (%.0f, básico %.0f)" % [sig, eb_mean])
	ex.sig_ready_at = sim.time + 10.0
	check(BotBrain._signature_threat(ex, sim, boss) == 0.0, "ameaça prevista: assinatura em recarga não conta")
	ex.sig_ready_at = 0.0
	sim.party_leave(ex)
	sim.despawn(ex)
	var bfire := BotBrain.new()
	bfire.setup(fire, RandomNumberGenerator.new())
	fire.position = bfire._role_spot(fire, sim, boss, false, fire.basic_skill.range, tank)
	fire.cooldowns.clear()
	fire.basic_cd = 0.0
	sim.time += Balance.BOT_OPENER_TIME + Balance.BOT_OPENER_WAIT + 1.0
	boss.threat = {tank.id: 1000.0 + bb * 50.0, fire.id: (1000.0 + bb * 50.0) * Balance.BOT_THREAT_STOP - bb * 0.5}
	bfire.opener_held = 0.0
	bfire.opener_id = boss.id
	var c2: InputCommand = bfire._fight(fire, sim, m, boss, InputCommand.new())
	check(not c2.attack and c2.skill_slot < 0, "ameaça prevista: básico que passaria o tanque espera")
	# chefe solto (não está no tanque): sem orçamento (as outras regras cuidam); lacaio colado no chefe usa o do chefe
	boss.aggro_target = fire.id
	bf._threat_budget(fire, m, boss, tank)
	check(bf.threat_boss == null and bf.threat_room == INF, "ameaça prevista: chefe fora do tanque, sem orçamento")
	boss.aggro_target = tank.id
	var add: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", at + Vector3(2, 0, 0))
	add.brain = null
	bf._threat_budget(fire, m, add, tank)
	check(bf.threat_boss == boss, "ameaça prevista: área no lacaio colado no chefe conta no chefe")
	add.position = at + Vector3(Balance.BOT_OPENER_AOE_RANGE + 3.0, 0, 0)
	bf._threat_budget(fire, m, add, tank)
	check(bf.threat_boss == null, "ameaça prevista: lacaio longe do chefe, sem orçamento")
	bf.threat_room = INF
	bf.threat_boss = null
	sim.despawn(add)
	sim.despawn(boss)
	sim.party_leave(fire)
	for o in [tank, fire]:
		sim.despawn(o)

## Sonda de chefes: o grupo sorteado só depende de (chefe, luta, semente), não da ordem/lista dos chefes nem do rng da sim
## (antes as builds vinham do rng que passava pelas lutas dos chefes anteriores: Rei Élfico 75% numa lista, 52,5% noutra).
func _check_probe_sampler(gd) -> void:
	var probe = load("res://tools/tests/boss_probe.gd")
	var a: Array = probe.random_comp("elf_king", 3, 1337, 4)
	Sim.rng.randi()                               # rng da sim andou (outra luta, outro chefe): não muda o sorteio
	probe.random_comp("spider_queen", 3, 1337, 4)
	var b: Array = probe.random_comp("elf_king", 3, 1337, 4)
	check(a == b and a.size() == 4, "sonda: mesmo (chefe, luta, semente) = mesmo grupo (%s / %s)" % [a, b])
	var cls := {}
	for c in a:
		var cid: String = str(c).get_slice(":", 0)
		cls[cid] = true
		var ok := false
		for bd in gd.classes[cid].builds:
			ok = ok or bd["id"] == str(c).get_slice(":", 1)
		check(ok, "sonda: build sorteada %s existe na classe" % c)
	check(cls.size() == 4, "sonda: 4 classes distintas no grupo sorteado (%s)" % [a])
	var differ := 0
	for t in range(20):
		if probe.random_comp("elf_king", t, 1337, 4) != probe.random_comp("elf_king", t, 7, 4):
			differ += 1
	check(differ >= 15, "sonda: outra semente sorteia outros grupos (%d/20 diferentes)" % differ)
	var no_pal: Array = probe.random_comp("elf_king", 3, 1337, 3, ["paladin"])
	check(no_pal.filter(func(c): return str(c).begins_with("paladin:")).is_empty(), "sonda: classe do líder fica fora do sorteio")
	check(probe.fight_seed("elf_king", 3, 1337) == probe.fight_seed("elf_king", 3, 1337) and probe.fight_seed("elf_king", 3, 1337) != probe.fight_seed("elf_king", 4, 1337), "sonda: semente da luta fixa por (chefe, luta, semente)")
	# baralho: cobertura igual das classes (±1 em qualquer prefixo de lutas), classes distintas, builds de cada classe na vez delas
	var n_cls: int = gd.classes.size()
	for cfg in [[4, [], 20], [3, ["paladin"], 21], [4, [], 9]]:
		var party: int = cfg[0]
		var excl: Array = cfg[1]
		var per := {}
		var per_build := {}
		var spread_ok := true
		var distinct_ok := true
		for t in range(int(cfg[2])):
			var c: Array = probe.random_comp("boss_ghar", t, 7, party, excl)
			var seen := {}
			for s in c:
				var cid: String = str(s).get_slice(":", 0)
				distinct_ok = distinct_ok and not seen.has(cid) and not (cid in excl)
				seen[cid] = true
				per[cid] = int(per.get(cid, 0)) + 1
				per_build[s] = int(per_build.get(s, 0)) + 1
			var lo := 1 << 30
			var hi := 0
			for cid in gd.classes:
				if not (cid in excl):
					lo = mini(lo, int(per.get(cid, 0)))
					hi = maxi(hi, int(per.get(cid, 0)))
			spread_ok = spread_ok and hi - lo <= 1 and c.size() == party
		check(distinct_ok, "sonda: baralho dá classes distintas, sem a do líder (party %d, fora %s)" % [party, excl])
		check(spread_ok, "sonda: baralho cobre as %d classes por igual (±1 a cada luta; party %d, fora %s): %s" % [n_cls - excl.size(), party, excl, per])
		var b_ok := true
		for cid in per:
			var nb: int = gd.classes[cid].builds.size()
			var lo := 1 << 30
			var hi := 0
			for bd in gd.classes[cid].builds:
				var k: int = int(per_build.get("%s:%s" % [cid, bd["id"]], 0))
				lo = mini(lo, k)
				hi = maxi(hi, k)
			b_ok = b_ok and (nb == 0 or hi - lo <= 1)
		check(b_ok, "sonda: builds de cada classe se revezam (±1; party %d): %s" % [party, per_build])
	check(probe.random_comp("boss_ghar", 13, 7, 4) == probe.random_comp("boss_ghar", 13, 7, 4) and probe.random_comp("boss_ghar", 13, 7, 4) != probe.random_comp("boss_troll_king", 13, 7, 4), "sonda: baralho fixo por chefe/semente e diferente entre chefes")

## Lâminas: Sumir está na barra do bot, abre a luta furtivo (alvo ainda não o mira), e na sombra o bot contorna o alvo
## sem golpe básico e sai com a skill mais forte pelas costas (antes Sumir nunca entrava na barra: 6/40 solo).
func _check_bot_stealth(gd, sim) -> void:
	var d = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["assassin"], "Sombra", "city_aldara", Vector3(-30, 0, 30), 30)
	d.build_id = "laminas"
	sim._gear_bot(d)
	sim._skill_bot(d)
	var vs: int = d.slot_of("ass_vanish")
	check(vs >= 0, "Lâminas nível 30: Sumir está na barra do bot")
	check(d.slot_of("ass_shadowstep") >= 0, "Lâminas: Passo das Sombras (dano) continua na barra")
	d.cooldowns.clear()
	d.mp = d.stats.max_mp
	var mob = sim.spawn_monster(gd.monsters["slime"], "city_aldara", d.position + Vector3(0, 0, 6.0))
	var m: Dictionary = sim.maps["city_aldara"]
	var brain := BotBrain.new()
	brain.setup(d, RandomNumberGenerator.new())
	var dist: float = d.position.distance_to(mob.position)
	check(vs >= 0 and brain._best_skill(d, sim, m, mob, dist) == vs, "Lâminas: alvo ainda solto a 6 m, o bot abre com Sumir")
	mob.aggro_target = d.id
	d.hp = d.stats.max_hp * 0.2
	check(brain._best_skill(d, sim, m, mob, dist) != vs, "Lâminas: alvo mirando o bot (mesmo com pouca vida), nada de Sumir no meio da luta")
	d.hp = d.stats.max_hp
	mob.aggro_target = -1
	d.combat_timer = Balance.AGGRO_LOSE_TIME
	check(brain._best_skill(d, sim, m, mob, dist) != vs, "Lâminas: em combate (lacaio solto), nada de Sumir no meio da luta")
	d.combat_timer = 0.0
	d.stealth_left = 5.0
	d.position = mob.position + mob.forward() * 6.0      # de frente para o slime (pela frente, longe das costas)
	var cmd := brain._fight(d, sim, m, mob, InputCommand.new())
	check(not cmd.attack and cmd.skill_slot < 0 and cmd.move != Vector2.ZERO, "furtivo pela frente: contorna o alvo sem golpear")
	d.position = mob.position + mob.forward() * (mob.radius + d.radius + 0.5)      # colado na frente, costas inalcançáveis
	d.stealth_left = 5.0 - Balance.BOT_STEALTH_CIRCLE - 0.2
	cmd = brain._fight(d, sim, m, mob, InputCommand.new())
	check(cmd.skill_slot >= 0, "furtivo há tempo sem chegar às costas: golpeia de frente (não fica parado até a sombra acabar)")
	d.stealth_left = 5.0
	brain.stealth_peak = 0.0
	d.position = mob.position - mob.forward() * (mob.radius + d.radius + 0.5)
	cmd = brain._fight(d, sim, m, mob, InputCommand.new())
	var hit: SkillDef = d.skills[cmd.skill_slot] if cmd.skill_slot >= 0 else null
	check(hit != null and hit.kind == SkillDef.Kind.PHYSICAL, "furtivo pelas costas: sai da sombra com uma skill de dano (%s)" % (hit.id if hit else "nada"))
	mob.hp = 0
	sim.despawn(d)

## Erros de digitação nos catálogos: chave que o Resource não tem (CatalogUtil), stat fora de Stats.STAT_KEYS em
## passivos/bônus/buffs e efeito fora de SkillDef.EFFECT_KEYS. Antes todos somavam 0 ou sumiam em silêncio.
func _check_catalog_keys(gd) -> void:
	check(CatalogUtil.unknown_keys.is_empty(), "catálogos: nenhuma chave desconhecida (%s)" % [CatalogUtil.unknown_keys])
	var bad: Array[String] = []
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			var bid: String = b["id"]
			if not (str(b["stat"]) in Stats.STAT_KEYS):
				bad.append("%s.stat=%s" % [bid, b["stat"]])
			for p in b.get("passives", []):
				_bad_stats(bad, "%s.passives" % bid, p, [])
			var extra: Dictionary = b.get("set_extra", {})
			for n in extra:
				_bad_stats(bad, "%s.set_extra" % bid, extra[n], [])
	for sid in gd.sets:
		var bon: Dictionary = gd.sets[sid].bonuses
		for n in bon:
			_bad_stats(bad, "%s.bonus" % sid, bon[n], Stats.SET_BONUS_META)
	for kid in gd.skills:
		var s: SkillDef = gd.skills[kid]
		for k in s.effects:
			if not (k in SkillDef.EFFECT_KEYS):
				bad.append("%s.effects.%s" % [kid, k])
		if s.effects.get("buff") is Dictionary:
			_bad_stats(bad, "%s.buff" % kid, s.effects["buff"], Stats.BUFF_META)
		var aura = s.effects.get("aura")
		if aura is Dictionary and aura.get("ally") is Dictionary:
			_bad_stats(bad, "%s.aura.ally" % kid, aura["ally"], Stats.BUFF_META)
	check(bad.is_empty(), "catálogos: stats e efeitos só com chaves conhecidas (%s)" % [bad])

## Todo portal de todo mapa: a chegada no destino fica fora de todos os portais de lá (senão o jogador volta na hora:
## Fortaleza dos Ossos, chegada a 1,2 m do portal do Bastião). Antes só os 4 mapas de _check_zone_layout conferiam.
func _check_portal_arrivals(gd) -> void:
	var bad: Array[String] = []
	for src in gd.maps:
		for pt in gd.maps[src].portals:
			var dst: MapDef = gd.maps.get(pt["target_map"])
			if dst == null:
				bad.append("%s.%s: destino %s não existe" % [src, pt["id"], pt["target_map"]])
				continue
			var arrive: Vector3 = pt["target_pos"]
			for own in dst.portals:
				var gap: float = Vector2(arrive.x, arrive.z).distance_to(Vector2(own["pos"].x, own["pos"].z))
				if gap <= float(own.get("radius", 2.0)) + Balance.PORTAL_ARRIVE_GAP:
					bad.append("%s.%s -> %s chega a %.1f m de %s" % [src, pt["id"], dst.id, gap, own["id"]])
	check(bad.is_empty(), "portais: toda chegada fica fora dos portais do destino (%s)" % [bad])

## Leva de assalto (MapDef.assaults): os guardas andam reto de ponto a ponto (só a água tem desvio, por water_path),
## então nenhum trecho from -> route -> target pode passar por sólido (água conta como livre: a ponte resolve). Antes só
## a Cidadela conferia; na Fortaleza dos Ossos a leva parava contra o muro de ossos e o reforço do Bastião fazia a rota
## da investida ao contrário (cortava a muralha fora do portão).
func _check_assault_routes(gd, sim) -> void:
	var bad: Array[String] = []
	for mid in gd.maps:
		var md: MapDef = gd.maps[mid]
		if md.assaults.is_empty():
			continue
		sim.load_map(md)
		for a in md.assaults:
			var route: Array = [a["from"]] + a["route"] + [a["target"]]
			for i in route.size() - 1:
				var p0: Vector3 = route[i]
				var p1: Vector3 = route[i + 1]
				var steps := maxi(2, int(p0.distance_to(p1) / Balance.ASSAULT_ROUTE_STEP))
				for k in steps + 1:
					var q := p0.lerp(p1, float(k) / steps)
					if MapGeometry.point_in_solid(sim, q, sim.maps[mid]):
						bad.append("%s.%s trecho %d (%s -> %s) bloqueado em (%.1f, %.1f)" % [mid, a["id"], i, p0, p1, q.x, q.z])
						break
	check(bad.is_empty(), "levas de assalto: todo trecho da rota andável em linha reta (%s)" % [bad])

## A leva da Aurora na Fortaleza dos Ossos sobe a estrada inteira até o pátio (sem mortos no caminho para não parar
## para lutar): o muro de ossos no trecho (-4,40)->(-22,24) prendia todos (o jogador viu a leva amontoada no muro).
func _check_assault_march(gd) -> void:
	const MARCH_TIME := 90.0                    # s: a estrada inteira com folga
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var fd: MapDef = gd.maps["fort_bones"]
	var m: Dictionary = ws.load_map(fd)
	ws.player = ws.spawn_player(gd.classes["paladin"], "Marcha", fd.id)
	ws.player.quests_completed.append("dw_ghoul_boss")
	var first: Array = []
	for i in int(MARCH_TIME * 20):
		for e in m["entities"].duplicate():
			if e.kind == SimEntity.Kind.MONSTER and not e.guard:
				ws.despawn(e)                     # caminho livre: só a rota está em teste
		ws.tick(0.05)
		if first.is_empty():
			first = m["entities"].filter(func(e): return e.guard and str(e.npc_data.get("id", "")).begins_with("assault_"))
	check(first.size() <= Balance.ASSAULT_FORT_MAX, "Ossos: leva de apoio com até %d soldados (%d)" % [Balance.ASSAULT_FORT_MAX, first.size()])
	var weak: bool = not first.is_empty() and first.all(func(e): return e.stats.max_hp < GameData.monsters[e.monster_def.id].hp * (Balance.ASSAULT_FORT_POWER + 0.05))
	check(weak, "Ossos: soldados da leva com vida x%.1f (apoio, não limpeza)" % Balance.ASSAULT_FORT_POWER)
	var last_leg: int = fd.assaults[0]["route"].size()        # marcha = route + [target]
	var stuck: Array = []
	for e in first:
		if is_instance_valid(e) and e.is_alive() and e.raid_leg < last_leg:
			stuck.append("%s leg %d em (%.0f, %.0f)" % [e.npc_data.get("id", "?"), e.raid_leg, e.position.x, e.position.z])
	check(not first.is_empty() and stuck.is_empty(), "Ossos: a primeira leva (%d) chega ao pátio em %.0f s (%s)" % [first.size(), MARCH_TIME, stuck])

