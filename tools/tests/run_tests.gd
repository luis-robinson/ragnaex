extends Node
## Testes headless da simulação:
##   godot --headless --path . tools/tests/tests.tscn
## Cobre catálogo, fórmulas, bloqueio, XP, loot, quests, crafting, mira de skills e 3000 ticks de mundo com bots.
## Determinismo: `-- --count_per_check` imprime `COUNT <função> <aprovados>` por função; compare duas execuções (diff) para achar check que roda número variável de vezes.
## Só uma parte (iterar rápido):  ... tools/tests/tests.tscn -- --only=party,shield
##   roda cada `_check_*` cujo nome contém um dos pedaços (com o que ele chama dentro); o run completo continua obrigatório.

var fails := 0
var passes := 0
var gd_ref
var save_ref
var per_fn := {}           # --count_per_check: checks aprovados por função (diagnóstico de determinismo)
var count_per := false

## RNG de teste com semente fixa: `RandomNumberGenerator.new()` nasce aleatório e fazia a contagem de checks mudar entre execuções.
func _seeded_rng(seed_value: int = 4242) -> RandomNumberGenerator:
	var r := RandomNumberGenerator.new()
	r.seed = seed_value
	return r

func check(cond: bool, msg: String) -> void:
	if count_per:
		var fn: String = get_stack()[1]["function"]
		per_fn[fn] = int(per_fn.get(fn, 0)) + (1 if cond else 0)
	if cond:
		passes += 1
	else:
		fails += 1
		push_error("FAIL: " + msg)
		print("FAIL: " + msg)

func _ready() -> void:
	Sim.running = false
	ClassTalentSystem.bot_picks = false        # bots de teste sem talentos de classe sorteados (_check_class_talents escolhe os seus)
	ProgressionSystem.bot_core = false         # bots de teste sem o anel de base (contas calibradas antes dele); _check_core_notables e a força da teia ligam
	count_per = DevArgs.has("--count_per_check")
	var only := DevArgs.value("--only")
	if only != "":
		run_only(Array(only.split(",")), GameData, Sim, SaveSystem)
	else:
		run_all(GameData, Sim, Balance, SaveSystem)
	if count_per:
		var ks := per_fn.keys()
		ks.sort()
		for k in ks:
			print("COUNT %s %d" % [k, per_fn[k]])
	print("\n=== %d passed, %d failed ===" % [passes, fails])
	get_tree().quit(1 if fails > 0 else 0)

class FakeMain:
	var views := {}
	var current_map_id := ""

## Dano no tempo (2026-11-17, "impossível tancar"): o de MONSTRO com o mesmo id renova (1 acúmulo, maior dps, duração nova);
## todo dano no tempo bate em pulsos de Balance.DOT_PULSE_S com o mesmo total; o do jogador continua acumulando.
func _check_dot_pulse(gd, sim) -> void:
	var at := Vector3(-30, 0, 30)
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at)
	mob.brain = null
	var tgt: SimEntity = sim.spawn_bot(gd.classes["berserker"], "DotAlvo", "city_aldara", at + Vector3(2, 0, 0), 30)
	tgt.brain = null
	tgt.stats.evasion = 0.0
	tgt.stats.dr_pct = 0.0          # notáveis de sobrevivência (Balance.ROLE_NOTABLES): o total do dano no tempo é sem redução
	tgt.stats.max_hp = 10000000.0
	tgt.hp = tgt.stats.max_hp
	var ele: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "DotFonte", "city_aldara", at + Vector3(-2, 0, 0), 30)
	ele.brain = null
	var m: Dictionary = sim.maps["city_aldara"]
	var dt := 1.0 / 60.0
	var hits := []
	var on_dmg := func(src: int, tid: int, amount: int, _c: bool, _b: bool, k: String): hits.append([src, amount, tid, k])
	var got := func() -> Array: return hits.filter(func(h): return int(h[2]) == tgt.id and str(h[3]).begins_with("dot"))
	Events.damage_dealt.connect(on_dmg)
	var dots := func(src_id: int) -> Array: return tgt.debuffs.filter(func(d): return d.get("kind") == "dot" and int(d.get("src", -1)) == src_id)
	var fx := {"dot": {"dps": 10, "duration": 4}}
	# monstro: reaplicar 5 vezes = 1 acúmulo; reaplicar depois de 1 s renova a duração
	for i in 5:
		sim._apply_effects(mob, tgt, fx, 1.0)
	check(dots.call(mob.id).size() == 1, "dano no tempo de monstro reaplicado 5x = 1 acúmulo (%d)" % dots.call(mob.id).size())
	for i in 60:
		sim._update_entity(tgt, m, dt)
	sim._apply_effects(mob, tgt, fx, 1.0)
	var md: Array = dots.call(mob.id)
	check(md.size() == 1 and is_equal_approx(float(md[0]["remaining"]), 4.0 * Balance.MONSTER_DOT_TIME_MULT), "dano no tempo de monstro: reaplicar renova a duração (x%.1f) (%s)" % [Balance.MONSTER_DOT_TIME_MULT, str(md.map(func(d): return d["remaining"]))])
	# pulsos: 2 s = 4 pulsos; total = dps x duração (±1)
	tgt.debuffs.clear()
	hits.clear()
	sim._apply_effects(mob, tgt, fx, 1.0)
	var dps: float = float(dots.call(mob.id)[0]["dps"])
	for i in 120:
		sim._update_entity(tgt, m, dt)
	check(got.call().size() == 4, "dano no tempo bate em pulsos de %.1f s: 4 em 2 s (%d)" % [Balance.DOT_PULSE_S, got.call().size()])
	for i in 200:
		sim._update_entity(tgt, m, dt)
	var total := 0
	for h in got.call():
		total += int(h[1])
	var mob_dur := 4.0 * Balance.MONSTER_DOT_TIME_MULT
	check(dots.call(mob.id).is_empty() and absf(total - dps * mob_dur) <= 1.0, "dano no tempo: total = dps x duração (%d vs %.1f)" % [total, dps * mob_dur])
	# reaplicar a cada 0,3 s não atrasa o pulso (o relógio do pulso não volta)
	tgt.debuffs.clear()
	hits.clear()
	for i in 120:
		if i % 18 == 0:
			sim._apply_effects(mob, tgt, fx, 1.0)
		sim._update_entity(tgt, m, dt)
	check(got.call().size() == 4, "monstro reaplicando a cada 0,3 s: ainda 4 pulsos em 2 s (%d)" % got.call().size())
	# jogador: continua acumulando (sem mudança), mas também bate em pulsos
	tgt.debuffs.clear()
	hits.clear()
	for i in 3:
		sim._apply_effects(ele, tgt, fx, 1.0)
	check(dots.call(ele.id).size() == 3, "dano no tempo do jogador acumula até %d cópias (%d)" % [Balance.PLAYER_DOT_MAX_STACKS, dots.call(ele.id).size()])
	for i in 120:
		sim._update_entity(tgt, m, dt)
	check(got.call().size() == 12, "dano no tempo do jogador: 3 acúmulos x 4 pulsos em 2 s (%d)" % got.call().size())
	Events.damage_dealt.disconnect(on_dmg)
	tgt.debuffs.clear()
	for o in [mob, tgt, ele]:
		sim.despawn(o)

## Dano no tempo, rodada 2 (2026-11-17): o de monstro dura x Balance.MONSTER_DOT_TIME_MULT (mesmo dps); o mágico do jogador
## tem no máximo Balance.PLAYER_DOT_MAX_STACKS cópias por (quem lançou, skill): a 4ª tira a mais antiga; skills diferentes têm teto próprio.
func _check_dot_cap(gd, sim) -> void:
	var at := Vector3(-30, 0, 36)
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at)
	mob.brain = null
	mob.stats.max_hp = 10000000.0
	mob.hp = mob.stats.max_hp
	var tgt: SimEntity = sim.spawn_bot(gd.classes["berserker"], "CapAlvo", "city_aldara", at + Vector3(2, 0, 0), 30)
	tgt.brain = null
	var nec: SimEntity = sim.spawn_bot(gd.classes["necromancer"], "CapFonte", "city_aldara", at + Vector3(-2, 0, 0), 30)
	nec.brain = null
	var on := func(t: SimEntity, src_id: int) -> Array: return t.debuffs.filter(func(d): return d.get("kind") == "dot" and int(d.get("src", -1)) == src_id)
	# monstro: duração x0,7, dps igual
	sim._apply_effects(mob, tgt, {"dot": {"dps": 10, "duration": 4}}, 1.0)
	var md: Array = on.call(tgt, mob.id)
	check(md.size() == 1 and is_equal_approx(float(md[0]["remaining"]), 4.0 * Balance.MONSTER_DOT_TIME_MULT),
		"dano no tempo de monstro dura x%.1f (%s)" % [Balance.MONSTER_DOT_TIME_MULT, str(md.map(func(d): return d["remaining"]))])
	sim._apply_effects(mob, tgt, {"dot": {"dps": 10, "duration": 5, "fire": true, "skill": "mob_x"}}, 1.0)
	md = on.call(tgt, mob.id).filter(func(d): return d.get("fire", false))
	check(md.size() == 1 and is_equal_approx(float(md[0]["remaining"]), 5.0 * Balance.MONSTER_DOT_TIME_MULT), "queimadura de monstro também dura x%.1f" % Balance.MONSTER_DOT_TIME_MULT)
	# jogador: 5 aplicações da mesma skill = 3 cópias; a mais antiga sai
	for i in 5:
		sim._apply_effects(nec, mob, {"dot": {"dps": 10 + i, "duration": 4, "skill": "cap_a"}}, 1.0)
	var pa: Array = on.call(mob, nec.id)
	var dps_a: Array = pa.map(func(d): return float(d["dps"]))      # base 10..14 x escala do MATK/talento: só a razão importa
	var kept_new: bool = dps_a.size() == 3 and absf(float(dps_a[1]) / float(dps_a[0]) - 13.0 / 12.0) < 0.005 and absf(float(dps_a[2]) / float(dps_a[0]) - 14.0 / 12.0) < 0.005
	check(pa.size() == Balance.PLAYER_DOT_MAX_STACKS, "jogador: 5 aplicações da mesma skill = %d cópias (%d)" % [Balance.PLAYER_DOT_MAX_STACKS, pa.size()])
	check(kept_new, "jogador: a 4ª e a 5ª substituem as mais antigas (ficam as de base 12, 13, 14: %s)" % str(dps_a))
	# outra skill tem o próprio teto
	for i in 4:
		sim._apply_effects(nec, mob, {"dot": {"dps": 5, "duration": 4, "skill": "cap_b"}}, 1.0)
	pa = on.call(mob, nec.id)
	var ids := {}
	for d in pa:
		ids[d["id"]] = int(ids.get(d["id"], 0)) + 1
	check(pa.size() == 2 * Balance.PLAYER_DOT_MAX_STACKS and ids.size() == 2 and ids.values().all(func(n): return n == Balance.PLAYER_DOT_MAX_STACKS),
		"jogador: skills diferentes têm teto separado (%s)" % str(ids))
	# a skill de verdade marca o dano no tempo com o id dela (Agonia)
	mob.debuffs.clear()
	var ag: SkillDef = gd.skills["nec_curse_agony"]
	nec.skill_aim = mob.position
	for i in 5:
		sim._apply_skill(nec, ag, sim.maps["city_aldara"])
	pa = on.call(mob, nec.id)
	check(pa.size() == Balance.PLAYER_DOT_MAX_STACKS and pa.all(func(d): return str(d["id"]).ends_with("nec_curse_agony")),
		"Agonia lançada 5x: %d cópias com o id da skill (%s)" % [Balance.PLAYER_DOT_MAX_STACKS, str(pa.map(func(d): return d["id"]))])
	mob.debuffs.clear()
	tgt.debuffs.clear()
	for o in [mob, tgt, nec]:
		sim.despawn(o)

## Texto flutuante (FloatText) e nomes de matilha (NameplateCrowd), arte 2026-11-13 itens 4 e 5:
## repetição vira "Esquiva! ×N", teto por alvo, faixas distintas, Label3D reaproveitados; comum em matilha esconde o nome.
func _check_float_text_crowd(gd) -> void:
	var ft := FloatText.new()
	add_child(ft)
	for i in 5:
		ft.pop(Vector3.ZERO, "Esquiva!", Color.WHITE, 1.0, 7, true)
	check(ft.live_count() == 1 and (ft._live[0]["label"] as Label3D).text == "Esquiva! ×5", "texto flutuante: 5 esquivas no mesmo alvo = 1 pop ×5")
	ft._process(FloatText.MERGE_WINDOW + 0.05)
	ft.pop(Vector3.ZERO, "Esquiva!", Color.WHITE, 1.0, 7, true)
	check(ft.live_count() == 2, "texto flutuante: fora da janela de fusão abre pop novo")
	for i in 6:
		ft.pop(Vector3.ZERO, str(100 + i), Color.WHITE, 1.0, 8)
	var whole := ft._live.filter(func(r: Dictionary) -> bool: return int(r["key"]) == 8 and float(r["life"]) >= FloatText.LIFE)
	check(whole.size() == FloatText.MAX_PER_TARGET, "texto flutuante: no máximo %d pops inteiros por alvo" % FloatText.MAX_PER_TARGET)
	var lanes := {}
	for r: Dictionary in whole:
		lanes[int(r["lane"])] = true
	check(lanes.size() == whole.size(), "texto flutuante: pops vivos do alvo em faixas diferentes")
	ft._process(FloatText.EVICT_LEFT + 0.02)
	check(ft._live.filter(func(r: Dictionary) -> bool: return int(r["key"]) == 8).size() == FloatText.MAX_PER_TARGET, "texto flutuante: o mais velho sai rápido")
	ft._process(FloatText.LIFE + 0.1)
	var kids := ft.get_child_count()
	check(ft.live_count() == 0 and ft.pooled_count() == kids, "texto flutuante: tudo volta para o pool")
	for i in 3:
		ft.pop(Vector3.ZERO, "x", Color.WHITE, 1.0, 9)
	check(ft.get_child_count() == kids, "texto flutuante: reaproveita Label3D (sem nó novo)")
	for i in FloatText.MAX_TOTAL + 10:
		ft.pop(Vector3.ZERO, str(i), Color.WHITE, 1.0, 1000 + i)
	check(ft.live_count() <= FloatText.MAX_TOTAL and ft.get_child_count() <= FloatText.MAX_TOTAL + 1, "texto flutuante: teto geral de Label3D")
	check(FloatText.merged_text("Esquiva!", 1) == "Esquiva!", "texto flutuante: sem contador quando é 1")
	remove_child(ft)
	ft.free()
	# matilha: 5 comuns colados + 1 longe; o 0 é o alvo do jogador
	var pts: Array[Vector3] = [Vector3(0, 0, 0), Vector3(1, 0, 0), Vector3(0, 0, 1), Vector3(1, 0, 1), Vector3(0.5, 0, 0.5), Vector3(30, 0, 0)]
	var keep: Array[bool] = [true, false, false, false, false, false]
	var hid := NameplateCrowd.hidden_names(pts, keep)
	check(not hid[0] and hid[1] and hid[4] and not hid[5], "nomes da matilha: alvo mostra, comum na matilha esconde, sozinho mostra")
	var few: Array[Vector3] = [Vector3.ZERO, Vector3(1, 0, 0)]
	var nk: Array[bool] = [false, false]
	check(not NameplateCrowd.hidden_names(few, nk).has(true), "nomes da matilha: par pequeno mostra os dois")
	var near := NameplateCrowd.nearest(pts, [5, 1, 3] as Array[int], Vector3.ZERO, 2)
	check(near.size() == 2 and near.has(1) and not near.has(5), "nomes da matilha: agressores mais perto do jogador mantêm o nome")
	var boss_ok := false
	var trash_ok := false
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		var e := SimEntity.new()
		e.kind = SimEntity.Kind.MONSTER
		e.monster_def = md
		if md.is_boss:
			boss_ok = not NameplateCrowd.is_trash(e)
		elif md.stat_role == "comum":
			trash_ok = NameplateCrowd.is_trash(e)
	check(boss_ok and trash_ok, "nomes da matilha: chefe nunca esconde, comum esconde")

## Revisão de arte R2 (ui-polish): "Esquiva!" soma enquanto o pop ainda se vê (sem fantasma ao lado do ×N); aura de monstro
## inimigo não desenha o círculo grande; golpe em linha de monstro não deixa faixa no chão; corvo/morcego/urubu em valor médio;
## chat e painel de quests quase opacos.
func _check_ui_polish_r2(gd, sim) -> void:
	var ft := FloatText.new()
	add_child(ft)
	ft.pop(Vector3.ZERO, "Esquiva!", Color.WHITE, 1.0, 7, true)
	ft._process(1.0)                       # ~1 s depois (ritmo de ataque de monstro): o pop ainda aparece
	ft.pop(Vector3.ZERO, "Esquiva!", Color.WHITE, 1.0, 7, true)
	check(ft.live_count() == 1, "ui-polish: esquiva 1 s depois soma no mesmo pop (sem fantasma)")
	check(FloatText.MERGE_WINDOW < FloatText.LIFE, "ui-polish: janela de fusão cabe na vida do pop")
	remove_child(ft)
	ft.free()
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		if md.aura == "":
			continue
		var e := SimEntity.new()
		e.kind = SimEntity.Kind.MONSTER
		e.monster_def = md
		e.owner_id = -1
		check(FxManager.mob_ring_reach(e) == 0.0 and FxManager.mob_aura_reach(md) > 0.0, "ui-polish: %s inimigo sem círculo de aura no chão" % mid)
	check(FxManager.mob_hit_ground_free("mob_impale") and not FxManager.mob_hit_ground_free("pal_charge"), "ui-polish: golpe em linha de monstro sem faixa no chão")
	for kid in ["crow", "bat", "vulture"]:
		var c: Color = AmbientLife.KINDS[kid]["color"]
		check(c.get_luminance() >= 0.3 and bool(AmbientLife.KINDS[kid].get("lit", false)), "ui-polish: %s em valor médio e sombreado (%.2f)" % [kid, c.get_luminance()])
	check(Hud.PANEL_BG_A >= 0.85, "ui-polish: chat e quests quase opacos (%.2f)" % Hud.PANEL_BG_A)
	# R2 #17: capacho da porta = tapete opaco sem brilho, virado da casa para fora
	var hd := MapDef.new()
	hd.obstacles = [{"kind": "house", "pos": Vector3(10, 0, 10), "size": Vector3(5, 4, 4)}]
	var fr := MapBuilder.door_front(Vector3(7, 0, 7), hd)
	check(fr.distance_to(Vector3(-1, 0, -1).normalized()) < 0.01, "ui-polish: capacho virado da casa para a porta (%s)" % fr)
	check(MapBuilder.door_front(Vector3(0, 0, 4), MapDef.new()) == Vector3(0, 0, 1), "ui-polish: porta sem casa perto (interior) olha para +z")
	var dm := MapBuilder._door_marker({"id": "t", "pos": Vector3(7, 0, 7), "label": "Botica"}, hd)
	var glow := 0
	for c in dm.get_children():
		if c is MeshInstance3D:
			var m: Material = (c as MeshInstance3D).material_override
			if m is BaseMaterial3D and ((m as BaseMaterial3D).emission_enabled or (m as BaseMaterial3D).transparency != BaseMaterial3D.TRANSPARENCY_DISABLED):
				glow += 1
	check(glow == 0 and dm.get_child(dm.get_child_count() - 1) is Label3D, "ui-polish: capacho sem disco brilhante/translúcido, nome é o último filho")
	check(absf(dm.rotation.y - atan2(fr.x, fr.z)) < 0.01, "ui-polish: capacho gira com a frente da porta")
	dm.free()
	# R2 #21: nome com o mesmo tamanho na tela de 20 a 34 m, sem crescer muito perto
	var px_at := func(dist: float) -> float: return EntityView.name_pixel_size(dist) / dist
	var ref: float = px_at.call(24.0)
	for dist in [20.0, 28.0, 34.0]:
		check(absf(px_at.call(dist) / ref - 1.0) < 0.05, "ui-polish: nome do mesmo tamanho na tela a %.0f m" % dist)
	check(px_at.call(14.0) / ref < 1.35, "ui-polish: nome no zoom mais perto cresce pouco (x%.2f)" % (px_at.call(14.0) / ref))
	check(EntityView.NAME_FONT * EntityView.NAME_PX * 1080.0 / (2.0 * 24.0 * tan(deg_to_rad(17.5))) >= 13.0, "ui-polish: nome legível (>= 13 px) na câmera padrão")
	# R2 #12/#16: fala de chefe na faixa própria; nomes do mundo sob a HUD somem
	check(Hud.boss_speaker("Ulgra Presa-Atroz: A MATILHA!", ["Lobo", "Ulgra Presa-Atroz"]) == "Ulgra Presa-Atroz", "ui-polish: fala de chefe reconhecida pelo nome")
	check(Hud.boss_speaker("Ulgra emerge do lago!", ["Ulgra"]) == "" and Hud.boss_speaker("Pegou: Poção", []) == "", "ui-polish: aviso comum não vai para a faixa do chefe")
	check(Hud.NOTIF_TOP > Hud.BOSS_LANE_TOP + 40.0, "ui-polish: notificações abaixo da faixa do chefe")
	var rs: Array[Rect2] = [Rect2(420, 950, 1070, 110)]
	check(Hud.covered(Vector2(900, 1000), rs) and not Hud.covered(Vector2(900, 500), rs), "ui-polish: ponto sob a barra conta como coberto")
	# nome/barra acima do topo real do modelo (Ulgra tinha o nome sobre o corpo); 1,95 × escala segue como mínimo
	check(EntityView.plate_top(1.0, false, 0.0) == 1.95 and EntityView.plate_top(2.0, true, 0.0) == 2.8, "ui-polish: sem modelo .glb a barra fica onde estava")
	check(EntityView.plate_top(1.0, false, 1.2) == 1.95, "ui-polish: modelo baixo não mexe na barra (mínimo 1,95)")
	check(is_equal_approx(EntityView.plate_top(1.5, true, 2.0), 2.0 * 1.5 + EntityView.PLATE_MARGIN), "ui-polish: modelo alto empurra a barra para o topo + folga")
	for mid in ["boss_ulgra", "boss_troll_king", "boss_kragmar", "boss_durgash", "trent", "ghoul_giant", "boss_gorbash", "troll_brute", "troll"]:
		var md: MonsterDef = gd.monsters.get(mid)
		if md == null or not ResourceLoader.exists("res://assets/models/%s.glb" % md.model):
			check(md == null and not mid.begins_with("boss_"), "ui-polish: %s existe com modelo .glb" % mid)
			continue
		var me: SimEntity = sim.spawn_monster(md, "city_aldara", Vector3(0, 0, 30))
		me.brain = null
		var mv := EntityView.new()
		add_child(mv)
		mv.setup(me, false)
		var head: float = mv._model_top * me.scale
		var bar_y: float = mv.hp_bar.position.y
		print("  placa %s: topo do modelo %.2f m, barra %.2f m (antes %.2f)" % [mid, head, bar_y, (1.4 if md.shape in ["sphere", "box"] else 1.95) * me.scale + 0.2])
		check(mv._model_top > 0.5 and bar_y >= head + EntityView.PLATE_MARGIN - 0.001, "ui-polish: barra de %s acima do topo do modelo (%.2f >= %.2f)" % [mid, bar_y, head])
		check(mv.nameplate.position.y > bar_y and bar_y >= EntityView.plate_top(me.scale, md.shape in ["sphere", "box"], 0.0) + 0.2 - 0.001, "ui-polish: nome de %s acima da barra, nunca abaixo do mínimo" % mid)
		remove_child(mv)
		mv.free()
		sim.despawn(me)
	var pc: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Placa", "city_aldara", Vector3(0, 0, 30), 30)
	pc.brain = null
	var pv := EntityView.new()
	add_child(pv)
	pv.setup(pc, false)
