## Janela C compacta: os 11 slots no boneco (cada um uma vez), as duas abas cabem sem rolar e a janela cabe em 1280×720
## (tela base 1600×900, abaixo do quadro do jogador e acima da barra) com no máximo 60% da área antiga (490×868).
func _check_character_window(gd, sim) -> void:
	var W = load("res://game/ui/windows.gd")
	var placed: Array = W.CHAR_LEFT + W.CHAR_RIGHT + W.CHAR_BOTTOM
	for slot in UiKit.EQUIP_SLOTS:
		check(placed.count(slot) == 1, "janela C: slot %s aparece uma vez no boneco" % UiKit.slot_name(slot))
	check(placed.size() == UiKit.EQUIP_SLOTS.size(), "janela C: só slots de equipamento no boneco")
	var p = sim.spawn_bot(gd.classes["paladin"], "Ficha", "city_aldara", Vector3(0, 0, 4), 35)
	for iid in gd.sets["set_paladin_mix_guardiao_cruzado_35"].pieces:
		p.add_item(iid)
		sim.equip(p, iid, false)
	var keep = sim.player
	sim.player = p
	var w = W.new()
	add_child(w)
	for tab in ["status", "sets"]:
		w._char_tab = tab
		w._rebuild("character")
		var win: Dictionary = w.wins["character"]
		var body: Control = (win["scroll"] as ScrollContainer).get_child(0)
		var need: Vector2 = body.get_combined_minimum_size()
		var room: Vector2 = W.SIZES["character"]
		check(need.x <= room.x + 0.5 and need.y <= room.y + 0.5, "janela C (%s): conteúdo %s cabe sem rolar em %s" % [tab, need, room])
		var size: Vector2 = (win["panel"] as Control).get_combined_minimum_size()
		check(size.y + 150.0 <= 900.0 - 190.0 and size.x <= 700.0, "janela C (%s): %s cabe em 1280×720 entre o quadro e a barra" % [tab, size])
		check(size.x * size.y <= 0.6 * 490.0 * 868.0, "janela C (%s): área %.0f ≤ 60%% da antiga" % [tab, size.x * size.y])
		check(w.char_slots.size() == UiKit.EQUIP_SLOTS.size(), "janela C (%s): %d quadrados de slot" % [tab, w.char_slots.size()])
	check(w._can_drop_on_bag(Vector2.ZERO, {"rx_drag": "slot", "slot": ItemDef.Slot.HEAD}), "janela C: slot arrasta para a bolsa")
	# aba Conjuntos: conta só as 5 peças de armadura (arma lendária fora), peça faltando apagada, bônus ativos marcados
	var bad_sets: Array = []
	for sid in gd.sets:
		var arm: Array = W.set_armor_items(gd.sets[sid])
		if arm.size() != 5 or arm.any(func(it): return it.slot in [ItemDef.Slot.WEAPON, ItemDef.Slot.OFFHAND]):
			bad_sets.append(sid)
	check(bad_sets.is_empty(), "conjuntos: 5 peças de armadura, sem arma/mão secundária (%s)" % [bad_sets.slice(0, 4)])
	var sid0 := "set_paladin_mix_guardiao_cruzado_35"
	for wid in gd.sets[sid0].alt_pieces:          # arma lendária da build A na mão (híbrido: as armas ficam em alt_pieces)
		if str(wid).ends_with("_guardiao_weapon"):
			p.add_item(wid)
			sim.equip(p, wid, false)
	check(not p.stats.legend.is_empty() and p.stats.active_sets.size() == 1 and int(p.stats.active_sets[sid0]) == 5,
		"janela C: conjunto vestido conta 5/5 com a arma lendária na mão (%s)" % [p.stats.active_sets])
	for drop in [0, 2]:
		if drop > 0:
			for it in W.set_armor_items(gd.sets[sid0]).slice(0, drop):
				sim.unequip(p, it.slot)
		w._char_tab = "sets"
		w._rebuild("character")
		var root: Control = (w.wins["character"]["panel"] as Control)
		var tab_txt := ""
		var worn := 0
		var icons := 0
		var on := 0
		var badges := 0
		for c in root.find_children("*", "", true, false):
			if c is Button and (c as Button).text.begins_with("Conjuntos"):
				tab_txt = (c as Button).text
			if c.has_meta("worn"):
				icons += 1
				worn += 1 if c.get_meta("worn") else 0
			if c.has_meta("active"):
				badges += 1
				on += 1 if c.get_meta("active") else 0
		var n_on: int = gd.sets[sid0].bonuses.keys().filter(func(k): return 5 - drop >= int(k)).size()
		check(tab_txt == "Conjuntos (1)", "janela C: aba conta conjuntos, não a arma lendária (%s)" % tab_txt)
		check(icons == 5 and worn == 5 - drop, "janela C: %d/5 peças vestidas na aba Conjuntos (%d de %d)" % [5 - drop, worn, icons])
		check(badges == gd.sets[sid0].bonuses.size() and on == n_on, "janela C: bônus ativos marcados (%d de %d, esperado %d)" % [on, badges, n_on])
		var need2: Vector2 = ((w.wins["character"]["scroll"] as ScrollContainer).get_child(0) as Control).get_combined_minimum_size()
		check(need2.y <= W.SIZES["character"].y + 0.5, "janela C (conjuntos, %d peças): cabe sem rolar (%s)" % [5 - drop, need2])
	w.close_all()
	w.free()
	sim.player = keep
	sim.despawn(p)

## Aba Roteiro da janela L: os guias de cada faixa existem e viram BBCode legível (títulos, linhas de tabela, sem separador).
func _check_roteiro(gd, sim) -> void:
	var W = load("res://game/ui/windows.gd")
	var bands: Array = W.ROTEIROS.map(func(b): return b[0])
	for band in ["1_10", "10_20", "20_30", "30_35", "35_40", "40_45"]:
		check(bands.has(band), "aba Roteiro tem a faixa %s" % band)
	check(W.roteiro_band_for(1) == "1_10" and W.roteiro_band_for(19) == "10_20" and W.roteiro_band_for(30) == "30_35"
		and W.roteiro_band_for(38) == "35_40" and W.roteiro_band_for(42) == "40_45" and W.roteiro_band_for(45) == "40_45", "roteiro abre na faixa do nível")
	# quebra no meio do parágrafo vira espaço; título, tabela, lista e linha em branco continuam separados
	var soft: PackedStringArray = W.roteiro_lines("# T\nTema: um\ndois **ne\ngrito**\n\n- item\n  segue\n- outro\n| a | b |\nfim\n1. passo\nmais")
	check(Array(soft) == ["# T", "Tema: um dois **ne grito**", "", "- item segue", "- outro", "| a | b |", "fim", "1. passo mais"],
		"roteiro junta linhas quebradas em parágrafos (%s)" % [soft])
	for band in bands:
		var path := "res://docs/roteiro_%s.md" % band
		check(FileAccess.file_exists(path), "roteiro %s existe" % band)
		var bb: String = W.roteiro_bbcode(FileAccess.get_file_as_string(path))
		check(bb.contains("[font_size=18]") and bb.contains("• [b]"), "roteiro %s: título e linhas de tabela" % band)
		check(not bb.contains("|---") and not bb.contains("**"), "roteiro %s: sem markdown cru" % band)
		check(bb.count("[b]") == bb.count("[/b]"), "roteiro %s: negrito fechado" % band)
		var md_text := FileAccess.get_file_as_string(path)
		var words := md_text.replace("\r", " ").replace("\n", " ").replace("\t", " ").split(" ", false).size()
		check(" ".join(W.roteiro_lines(md_text)).split(" ", false).size() == words, "roteiro %s: juntar linhas não perde palavra" % band)

func _check_quest_guide(gd, sim) -> void:
	var p = sim.spawn_bot(gd.classes["paladin"], "Seta", "city_aldara", Vector3(0, 0, 6), 30)
	var giver_map := {}
	for mid in gd.maps:
		for n in gd.maps[mid].npcs:
			giver_map[n.get("id", "")] = mid
	for qid in gd.quests:
		var q: QuestDef = gd.quests[qid]
		p.quests_active.clear()
		p.inventory.clear()
		p.map_id = giver_map.get(q.giver_npc, "city_aldara")
		p.quests_active[qid] = 0
		var obj: Dictionary = QuestSystem.objective(p, q)
		check(not obj.is_empty() and gd.maps.has(obj["map"]), "quest %s tem objetivo no mapa (%s)" % [qid, obj])
		var g: Dictionary = QuestSystem.guide_point(p, q)
		check(not g.is_empty(), "seta da quest %s acha o rumo a partir de %s" % [qid, p.map_id])
		if not obj.is_empty() and obj["map"] != p.map_id and not g.is_empty():
			check(g["via_portal"], "quest %s noutro mapa aponta para um portal" % qid)
	# caminho de portais: Aldara → Cidade Élfica passa pela Floresta; dungeon da floresta também
	check(PortalSystem.portal_towards(gd.maps["city_aldara"], "elf_city").get("target_map", "") == "field_forest", "Aldara → cidade élfica: portal da floresta")
	check(PortalSystem.portal_towards(gd.maps["city_aldara"], "dg_ninho").get("target_map", "") == "field_forest", "Aldara → ninho: portal da floresta")
	check(PortalSystem.portal_towards(gd.maps["elf_city"], "dg_catacumbas_trono").get("target_map", "") == "field_forest", "cidade élfica → trono: volta pela floresta")
	# pronta → NPC de entrega
	var q1: QuestDef = gd.quests["q01_welcome"]
	p.map_id = "city_aldara"
	p.quests_active.clear()
	p.quests_active[q1.id] = q1.count
	var npc_pos = QuestSystem._npc_of(gd.maps["city_aldara"], q1.turnin())
	check(npc_pos != null and QuestSystem.guide_point(p, q1).get("pos") == npc_pos, "quest pronta aponta para quem recebe")
	p.quests_active.clear()
	sim.despawn(p)

## Cor de destaque da roupa contrasta com a principal e nunca cai em verde-oliva escuro.
func _check_accents() -> void:
	for i in range(40):
		for s in [0.1, 0.5, 0.9]:
			var c := Color.from_hsv(i / 40.0, s, 0.8)
			var a := ItemDef.accent(c)
			check(not (a.h > 0.12 and a.h < 0.26 and a.v < 0.7), "destaque de %s não é oliva (%s)" % [c, a])
			check(Vector3(a.r - c.r, a.g - c.g, a.b - c.b).length() > 0.3, "destaque de %s contrasta (%s)" % [c, a])

## Pontos alcançáveis a pé a partir de `from` (grade de 1,5 m), para provar que nada ficou isolado.
## `wall_r` > 0 fecha um círculo em `wall`: prova que uma passagem é a única ligação.
func _reach(sim, md: MapDef, from: Vector3, wall := Vector3.ZERO, wall_r := 0.0) -> Dictionary:
	var step := 1.5
	var seen := {}
	var open: Array[Vector2i] = [Vector2i(roundi(from.x / step), roundi(from.z / step))]
	seen[open[0]] = true
	while not open.is_empty():
		var c: Vector2i = open.pop_back()
		for d in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
			var n: Vector2i = c + d
			var p := Vector3(n.x * step, 0, n.y * step)
			if not seen.has(n) and sim.is_walkable(p, md, 0.45) and (wall_r <= 0.0 or p.distance_to(wall) > wall_r):
				seen[n] = true
				open.append(n)
	return seen

func _reached(seen: Dictionary, p: Vector3) -> bool:
	var c := Vector2i(roundi(p.x / 1.5), roundi(p.z / 1.5))
	for dx in range(-3, 4):
		for dz in range(-3, 4):
			if seen.has(c + Vector2i(dx, dz)):
				return true
	return false

## Toda zona tem os quatro tipos de lugar, todos alcançáveis, com NPC/quest/monstro/portal ligados.
func _check_places(gd, sim, md: MapDef) -> void:
	var mid := md.id
	var count := {}
	var seen := _reach(sim, md, md.spawn_point)
	for pl in md.places:
		count[pl["type"]] = int(count.get(pl["type"], 0)) + 1
		var d: float = Vector2(pl["pos"].x, pl["pos"].z).length()
		var far: float = 112.0 * (1.2 if mid == "city_aldara" else 1.0)       # o Vale cresceu 20% (places.grow_aldara)
		if pl.get("style", "") == "tree":     # porta no tronco da árvore do centro: fica no hub de propósito
			check(d < 15.0, "%s: porta %s no tronco da árvore (%.0f m)" % [mid, pl["id"], d])
			continue
		check(d > 40.0 and d < far, "%s: lugar %s a %.0f m do hub" % [mid, pl["id"], d])
		for other in md.places:
			if other != pl and other.get("style", "") != "tree":
				check(pl["pos"].distance_to(other["pos"]) > 25.0, "%s: %s longe de %s" % [mid, pl["id"], other["id"]])
	for t in ["cabin", "camp", "shrine", "dungeon"]:
		check(int(count.get(t, 0)) >= 1, "%s: tem lugar %s" % [mid, t])
	check(int(count.get("cabin", 0)) >= 2, "%s: 2+ cabanas" % mid)
	for n in md.npcs:
		check(_reached(seen, n["pos"]), "%s: NPC %s alcançável a pé" % [mid, n["id"]])
	for sp in md.spawners:
		check(_reached(seen, sp["pos"]), "%s: spawner %s alcançável a pé" % [mid, sp["monster_id"]])
	for pt in md.portals:
		check(_reached(seen, pt["pos"]), "%s: portal %s alcançável a pé" % [mid, pt["id"]])
	var quest_npcs := 0
	for n in md.npcs:
		if MapsCatalog.PLACE_NPCS[mid].has(n["id"]) and n["role"] == "quest":
			quest_npcs += 1
			var has_quest: bool = n["id"] in MapsCatalog.PENDING_GIVERS       # quests do Ato II chegam pelo pacote de missões
			for qid in gd.quests:
				has_quest = has_quest or gd.quests[qid].giver_npc == n["id"]
			check(has_quest, "%s: %s dá quest" % [mid, n["id"]])
	check(quest_npcs >= 2, "%s: cabanas têm NPC de quest (%d)" % [mid, quest_npcs])
	for n in md.npcs:
		if n["role"] == "board" and MapsCatalog.PLACE_NPCS[mid].has(n["id"]):
			check(ResourceLoader.exists("res://assets/models/%s.glb" % n.get("model", "")), "%s: %s é uma pedra, não um boneco" % [mid, n["id"]])

## Fortalezas do terceiro andar com layout próprio (não o molde de muralha): Covil do Carniçal (pântano-ninho, rio de
## bile), Fortaleza dos Ossos (necrópole, fenda com ponte de ossos), Torre do Mago Gélido (lago congelado, canal de água
## escura em volta da ilha). Tudo alcançável a pé da chegada; fechando as duas pontes, o chefe fica isolado.
## Dicas contextuais: cada uma uma vez, desligar cala, o "visto" fica salvo (arquivo próprio do teste, nunca o do jogador).
func _check_tips() -> void:
	for id in Tips.TIPS:
		check(str(Tips.TIPS[id]).length() <= 120, "dica %s cabe no cartão (%d letras)" % [id, str(Tips.TIPS[id]).length()])
	var old := Tips.cfg_path
	Tips.cfg_path = "user://test_tips.cfg"
	DirAccess.remove_absolute(ProjectSettings.globalize_path(Tips.cfg_path))
	var t := Tips.new()
	t.load_state()
	check(t.enabled and t.seen.is_empty(), "dicas: arquivo novo começa ligado e sem nenhuma vista")
	check(t.request("attack"), "dicas: a primeira vez entra na fila")
	check(not t.request("attack"), "dicas: a mesma dica não volta")
	check(not t.request("nao_existe"), "dicas: id desconhecido é ignorado")
	t.set_enabled(false)
	check(not t.request("dash"), "dicas: desligadas não aparecem")
	var t2 := Tips.new()
	t2.load_state()
	check(t2.seen.has("attack") and not t2.seen.has("dash") and not t2.enabled, "dicas: vistas e o desligado ficam salvos")
	t.free()
	t2.free()
	DirAccess.remove_absolute(ProjectSettings.globalize_path(Tips.cfg_path))
	Tips.cfg_path = old

## Fim do Ato I: o epílogo sai do Lich, volta ao Ancião Ravi; a festa (NPCs, fogos, chat dos bots) só depois do Lich.
func _check_epilogue(gd) -> void:
	var q: QuestDef = gd.quests.get(MapsCatalog.ACT_END_QUEST)
	check(q != null, "epílogo %s existe" % MapsCatalog.ACT_END_QUEST)
	if q == null:
		return
	check(q.prereq_quest == MapsCatalog.VICTORY_QUEST and q.giver_npc == "dawn_commander" and q.turnin_npc == "elder",
		"epílogo: sai do Comandante depois do Lich e volta ao Ancião Ravi")
	check(gd.quests.values().all(func(o): return o.prereq_quest != MapsCatalog.ACT_END_QUEST or str(o.id).begins_with("hx_")),
		"epílogo é a última quest do Ato I (depois dele só o Ato II)")
	var aldara: MapDef = gd.maps["city_aldara"]
	check(aldara.npcs.any(func(n): return n["id"] == "elder"), "Ancião Ravi está em Aldara")
	check(gd.maps["field_ruins"].npcs.any(func(n): return n["id"] == "dawn_commander"), "Comandante está no Bastião")
	check(BotChat.pool("place:victory").size() >= 8, "bots têm falas de vitória")
	var ff := FestivalFx.new()
	check(ff is Node3D and Sfx.VOL.has("firework"), "fogos têm efeito e som")
	ff.free()
	for mid in MapsCatalog.FESTIVAL:
		var def: MapDef = gd.maps[mid]
		var fest: Array = def.npcs.filter(func(n): return str(n["id"]).begins_with("fest_"))
		check(fest.size() == (MapsCatalog.FESTIVAL[mid] as Dictionary).size() and fest.all(func(n): return n.get("if", "") == MapsCatalog.VICTORY_QUEST),
			"%s: festeiros só depois do Lich (%d)" % [mid, fest.size()])
		var ws := WorldSim.new()
		ws.load_map(gd.maps[GameData.town_map_id()])
		var m: Dictionary = ws.load_map(def)
		for n in fest:
			check(ws.is_walkable(n["pos"], def, 0.4), "%s: festeiro %s em chão andável" % [mid, n["id"]])
		ws.player = ws.spawn_player(gd.classes["paladin"], "Teste", def.id)
		var live := func() -> int:
			return m["entities"].filter(func(e): return str(e.npc_data.get("id", "")).begins_with("fest_")).size()
		WorldState.sync_npcs(ws, m)
		check(live.call() == 0, "%s: sem o Lich morto, ninguém festeja" % mid)
		ws.player.quests_completed.append(MapsCatalog.VICTORY_QUEST)
		WorldState.sync_npcs(ws, m)
		check(live.call() == fest.size(), "%s: Lich morto, os festeiros aparecem (%d)" % [mid, live.call()])

## Áudio: todo som citado pelo Sfx existe no banco (tools/audio/build_sfx.py), todo tema de skill soa,
## o banco carrega e os barramentos de volume existem.
func _check_sfx_bank(gd) -> void:
	var sfx := Sfx.new()
	sfx._load_bank()
	check(sfx.bank.size() >= 40, "banco de sons carregado (%d nomes; rode tools/audio/build_sfx.py + --import)" % sfx.bank.size())
	var names: Array = Sfx.VOL.keys() + Sfx.THEME_SOUND.values() + Sfx.RANGED_SOUND.values()
	for n in names:
		check(sfx.bank.has(n) and (sfx.bank[n] as Array).size() > 0, "som '%s' no banco" % n)
	for th in SkillFx.PALETTE:
		check(th == "physical" or Sfx.THEME_SOUND.has(th), "tema de skill '%s' tem som (Sfx.THEME_SOUND)" % th)
	for n in sfx.bank:
		check(Sfx.VOL.has(n), "som '%s' do banco tem volume em Sfx.VOL" % n)
	# Ato II: vozes de monstro, skills com som próprio e o laço da aura apontam para sons e dados que existem
	var act2: Array = Sfx.CAST_SOUND.values() + Sfx.EFFECT_SOUND.values() + Sfx.AURA_SOUND.values()
	for row in Sfx.MOB_VOICE.values():
		check((row as Array).size() == 3, "voz de monstro tem 3 entradas (luta, skill, morte)")
		act2 += (row as Array).filter(func(s): return s != "")
	for n in act2:
		check(sfx.bank.has(n), "som '%s' (vozes/skills do Ato II) no banco" % n)
	for sid in Sfx.CAST_SOUND.keys() + Sfx.EFFECT_SOUND.keys():
		check(gd.skills.has(sid), "skill '%s' com som próprio existe" % sid)
	for a in Balance.MOB_AURAS:
		check(Sfx.AURA_SOUND.has(a), "aura de monstro '%s' tem som em laço (Sfx.AURA_SOUND)" % a)
	for a in Sfx.AURA_SOUND:
		check(Balance.MOB_AURAS.has(a), "Sfx.AURA_SOUND cita aura que existe (%s)" % a)
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		if md.faction == "horde" or mid.begins_with("naga_") or mid == "boss_tide_mother":
			check(not Sfx.voice_of(md).is_empty(), "monstro do Ato II '%s' tem voz (Sfx.MOB_VOICE)" % mid)
	check(Sfx.voice_of(gd.monsters["slime"]).is_empty(), "monstro sem voz própria fica só com os sons comuns")
	# trolls das Estepes: voz própria (rugido, grunhido, queda), pancada no chão e pulso da regeneração
	for mid in gd.monsters:
		var tmd: MonsterDef = gd.monsters[mid]
		if tmd.regen > 0.0 and tmd.faction == "horde":
			var tv := Sfx.voice_of(tmd)
			check(tv.size() == 3 and str(tv[0]).begins_with("troll_") and str(tv[2]) != "", "troll '%s' tem voz de troll e som de queda (%s)" % [mid, tv])
	check(Sfx.BUFF_SOUND.has(Balance.TROLL_REGEN_BUFF) and sfx.bank.has(Sfx.BUFF_SOUND[Balance.TROLL_REGEN_BUFF]), "regeneração do troll pulsa com som próprio")
	for b in Sfx.BUFF_SOUND:
		check(sfx.bank.has(Sfx.BUFF_SOUND[b]) and BuffLooks.LOOKS.has(b), "Sfx.BUFF_SOUND: buff '%s' existe e o som está no banco" % b)
	for sid in ["mob_troll_slam", "mob_rock_quake"]:
		check(Sfx.EFFECT_SOUND.get(sid, "") == "troll_slam", "skill de troll '%s' bate com a pancada de troll" % sid)
	# assinaturas dos chefes: toda skill boss_signature avisa com som quando o desenho aparece; impactos/quebras no banco
	for sid in gd.skills:
		if (gd.skills[sid] as SkillDef).boss_signature:
			check(Sfx.SIG_WARN.has(sid), "assinatura '%s' tem som de aviso (Sfx.SIG_WARN)" % sid)
	for sid in Sfx.SIG_WARN:
		var row: Array = Sfx.SIG_WARN[sid]
		check(gd.skills.has(sid) and (gd.skills[sid] as SkillDef).boss_signature, "Sfx.SIG_WARN cita assinatura que existe (%s)" % sid)
		check(row.size() >= 2 and str(row[0]) in ["startup", "active"], "Sfx.SIG_WARN '%s' = [fase, sons...]" % sid)
		for n in row.slice(1):
			check(sfx.bank.has(n) and Sfx.VOL.has(n), "aviso de assinatura '%s': som '%s' no banco" % [sid, n])
	var sig_fx := [BossSignatures.CHANNEL_BREAK_FX, BossSignatures.COUNTER_FX, BossSignatures.COVER_BREAK_FX, BossSignatures.DECOY_FX]
	for k in sig_fx:
		check(Sfx.SIG_EFFECT.has(k), "quebra/contragolpe de assinatura '%s' tem som (Sfx.SIG_EFFECT)" % k)
	for k in Sfx.SIG_EFFECT:
		check(sfx.bank.has(Sfx.SIG_EFFECT[k]) and (gd.skills.has(k) or k in sig_fx), "Sfx.SIG_EFFECT '%s' cita skill/efeito que existe e som do banco" % k)
	sfx.free()
	AudioSettings.load_and_apply()
	for b in AudioSettings.BUSES:
		check(AudioServer.get_bus_index(b) >= 0, "barramento de áudio %s" % b)

## Ponto do desenho original de uma fortaleza (chegada ao sul) -> no mapa girado: o `"turn"` do JSON da zona
## (graus, horário visto de cima; zone_lib.Zone.apply_turn).
func _turned(mid: String, v: Vector3) -> Vector3:
	var z: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MapsCatalog.ZONE_PATH % mid))
	var a := deg_to_rad(float(z.get("turn", 0.0)))
	return Vector3(v.x * cos(a) - v.z * sin(a), v.y, v.x * sin(a) + v.z * cos(a))

func _check_fort_lairs(gd, sim) -> void:
	for row in [["fort_ghoul", "Covil", 6], ["fort_bones", "Ossos", 0], ["fort_frost", "Gélido", 6]]:
		_check_fort_lair(gd, sim, row[0], row[1], row[2])
	_check_citadel(gd, sim)

## Cidadela do Lich (necrópole): cidade morta com ruas, casas e torres; tudo alcançável a pé; a Ofensiva anda a avenida inteira;
## o trono não depende de uma rua só (fechar o meio da avenida ou o portão da cidade ainda deixa chegar pelas ruas/brechas).
func _check_citadel(gd, sim) -> void:
	var md: MapDef = gd.maps["lich_citadel"]
	sim.load_map(md)
	var kinds := {}
	for o in md.obstacles:
		kinds[o["kind"]] = int(kinds.get(o["kind"], 0)) + 1
	check(int(kinds.get("ruin", 0)) + int(kinds.get("house", 0)) >= 120, "Cidadela: casas mortas pela cidade (ruína %d, casa %d)" % [kinds.get("ruin", 0), kinds.get("house", 0)])
	check(md.roads.filter(func(r): return r["kind"] == "road").size() >= 6, "Cidadela: avenida, ruas e becos (%d)" % md.roads.size())
	check(md.water.filter(func(w): return w["kind"] == "lake").size() >= 5, "Cidadela: poços de almas")
	var seen := _reach(sim, md, md.spawn_point)
	for n in md.npcs:
		check(_reached(seen, n["pos"]), "Cidadela: NPC %s alcançável a pé" % n["id"])
	for sp in md.spawners:
		check(_reached(seen, sp["pos"]), "Cidadela: spawner %s alcançável a pé" % sp["monster_id"])
	check(_reached(seen, md.town_gates[0]), "Cidadela: portão do palácio alcançável")
	var boss: Dictionary = md.spawners.filter(func(sp): return sp["monster_id"] == "lich_king")[0]
	check(_reached(seen, boss["pos"]), "Cidadela: trono alcançável")
	for pt in md.portals:
		check(_reached(seen, pt["pos"]), "Cidadela: portal %s alcançável" % pt["id"])
	var a: Dictionary = md.assaults[0]
	var route: Array = [a["from"]] + a["route"] + [a["target"]]
	var ok := true
	for i in route.size() - 1:
		var p0: Vector3 = route[i]
		var p1: Vector3 = route[i + 1]
		for k in 11:
			if not sim.is_walkable(p0.lerp(p1, k / 10.0), md, 0.45):
							ok = false
	check(ok, "Cidadela: a Ofensiva anda a avenida em linha reta entre os pontos")
	var mid := _turned("lich_citadel", Vector3(8, 0, 34))        # pontos do desenho original (chegada ao sul): o mapa é girado (zone_lib.FORT_TURN)
	check(_reached(_reach(sim, md, md.spawn_point, mid, 7.0), boss["pos"]), "Cidadela: com o meio da avenida fechado, as ruas de lado chegam ao trono")
	check(_reached(_reach(sim, md, md.spawn_point, _turned("lich_citadel", Vector3(0, 0, 73)), 7.0), boss["pos"]), "Cidadela: com o portão da cidade fechado, as brechas chegam ao trono")
	var spire := _turned("lich_citadel", Vector3(0, 0, -53))
	var tall := md.obstacles.filter(func(o): return o.get("hidden", false) and float(o["size"].y) >= 10.0 and Vector2(o["pos"].x, o["pos"].z).distance_to(Vector2(spire.x, spire.z)) < 14.0)
	check(not tall.is_empty(), "Cidadela: palácio com a agulha no fundo da praça")

func _check_fort_lair(gd, sim, fid: String, label: String, min_lakes: int) -> void:
	var md: MapDef = gd.maps[fid]
	sim.load_map(md)
	var rivers := md.water.filter(func(w): return w["kind"] == "river")
	var lakes := md.water.filter(func(w): return w["kind"] == "lake")
	check(rivers.size() == 1 and lakes.size() >= min_lakes, "%s: rio/fenda/canal e lagoas (%d)" % [label, lakes.size()])
	var seen := _reach(sim, md, md.spawn_point)
	for n in md.npcs:
		check(_reached(seen, n["pos"]), "%s: NPC %s alcançável a pé" % [label, n["id"]])
	for sp in md.spawners:
		check(_reached(seen, sp["pos"]), "%s: spawner %s alcançável a pé" % [label, sp["monster_id"]])
	check(_reached(seen, md.town_gates[0]), "%s: portão/brecha alcançável" % label)
	# pontes: onde as trilhas cruzam o rio; sem elas o covil fica isolado
	var pts: Array = rivers[0]["pts"]
	var crossings: Array = []
	for rd in md.roads:
		if rd["kind"] != "road":
			continue
		for q in rd["pts"]:
			var near := false
			for i in pts.size() - 1:
				var a := Vector2(pts[i][0], pts[i][1])
				var b := Vector2(pts[i + 1][0], pts[i + 1][1])
				var qq := Vector2(q.x, q.z) if q is Vector3 else Vector2(q[0], q[1])
				near = near or Geometry2D.get_closest_point_to_segment(qq, a, b).distance_to(qq) < 2.0
			if near and not crossings.any(func(c): return c.distance_to(q if q is Vector3 else Vector3(q[0], 0, q[1])) < 10.0):
				crossings.append(q if q is Vector3 else Vector3(q[0], 0, q[1]))
	check(crossings.size() == 2, "%s: duas pontes (%d)" % [label, crossings.size()])
	if crossings.size() == 2:
		var cut2 := {}                     # flood fill com as duas pontes fechadas
		var open: Array[Vector2i] = [Vector2i(roundi(md.spawn_point.x / 1.5), roundi(md.spawn_point.z / 1.5))]
		cut2[open[0]] = true
		while not open.is_empty():
			var c: Vector2i = open.pop_back()
			for d in [Vector2i.LEFT, Vector2i.RIGHT, Vector2i.UP, Vector2i.DOWN]:
				var n: Vector2i = c + d
				var p := Vector3(n.x * 1.5, 0, n.y * 1.5)
				if not cut2.has(n) and sim.is_walkable(p, md, 0.45) and p.distance_to(crossings[0]) > 9.0 and p.distance_to(crossings[1]) > 9.0:
					cut2[n] = true
					open.append(n)
		var boss_id: String = str(MapsCatalog.FORT_DEFS.get(fid, {}).get("boss", {"fort_ghoul": "ghoul_giant", "fort_bones": "death_knight", "fort_frost": "frost_mage"}[fid]))
		var boss: Dictionary = md.spawners.filter(func(sp): return sp["monster_id"] == boss_id)[0]
		check(not _reached(cut2, boss["pos"]), "%s: sem as pontes, a chegada não alcança o chefe" % label)

## Dungeon: entrada e saída casam, chefe no fim, tudo alcançável, bots não entram sozinhos.
func _check_dungeons(gd, sim) -> void:
	for did in MapsCatalog.DUNGEON_DEFS:
		var md: MapDef = gd.maps[did]
		var zone: MapDef = gd.maps[md.parent_map]
		sim.load_map(md)
		var entry := {}
		for pt in zone.portals:
			if pt["target_map"] == did:
				entry = pt
		check(not entry.is_empty(), "%s: entrada em %s" % [did, zone.id])
		var exit := {}
		for pt in md.portals:
			if pt["target_map"] == zone.id:
				exit = pt
		check(not exit.is_empty(), "%s: saída volta para %s" % [did, zone.id])
		check(zone.portals[0]["target_map"] != did, "%s: entrada não é o portal principal da zona (fallback dos bots)" % did)
		if not entry.is_empty() and not exit.is_empty():
			check(sim.is_walkable(entry["target_pos"], md, 0.45), "%s: chegada andável" % did)
			check(sim.is_walkable(exit["target_pos"], zone, 0.45), "%s: retorno na zona andável" % did)
			check(exit["target_pos"].distance_to(entry["pos"]) > float(entry["radius"]) + 1.0, "%s: retorno fora do portal" % did)
		var seen := _reach(sim, md, md.spawn_point)
		var bosses := 0
		for sp in md.spawners:
			check(_reached(seen, sp["pos"]), "%s: spawner %s alcançável" % [did, sp["monster_id"]])
			bosses += 1 if gd.monsters[sp["monster_id"]].is_boss else 0
		var want: int = MapsCatalog.DUNGEON_DEFS[did].get("bosses", 1)
		check(bosses == want, "%s: %d chefe(s) (%d)" % [did, want, bosses])
		for pt in md.portals:
			check(_reached(seen, pt["pos"]), "%s: portal %s alcançável" % [did, pt["id"]])
		for n in md.npcs:
			check(_reached(seen, n["pos"]), "%s: NPC %s alcançável" % [did, n["id"]])
		check(FileAccess.file_exists("res://assets/models/map_%s.glb" % did), "%s: GLB existe" % did)
		var far = sim.spawn_bot(gd.classes["ranger"], "Turista", "city_aldara", Vector3(0, 0, 6), md.level_range.x)
		for i in range(40):
			far.brain._plan_trip(far, sim)
			check(far.brain.dest_map != did, "bot não planeja caçar em %s" % did)
		sim.despawn(far)

## Catacumbas: 3 chefes no total, alas separadas por rocha e NPCs de quest lá dentro.
func _check_catacombs(gd, sim) -> void:
	var md: MapDef = gd.maps["dg_catacumbas"]
	var bosses := {}
	for mid in ["dg_catacumbas", "dg_catacumbas_trono"]:
		for sp in gd.maps[mid].spawners:
			if gd.monsters[sp["monster_id"]].is_boss:
				bosses[sp["monster_id"]] = true
	check(bosses.size() == 3, "Catacumbas: 3 chefes (%d)" % bosses.size())
	for b in bosses:
		check(gd.monsters[b].phases.size() >= 1, "%s tem fases" % b)
		check(gd.loot_tables.has(gd.monsters[b].loot_table) and gd.monsters[b].loot_table != "lt_boar_king", "%s tem saque próprio" % b)
	check(gd.monsters["count_vargo"].phases.size() >= 2, "Conde tem 3 fases")
	# as alas só se ligam pelo vestíbulo: sem ele a ala oeste não alcança a leste
	var west: Vector3 = _spawner_pos(md, "bone_captain")
	var east: Vector3 = _spawner_pos(md, "wailing_widow")
	var vest := Vector3(0, 0, 20 * 1.25)               # vestíbulo (build_dungeons.SCALE = 1.25)
	var seen: Dictionary = _reach(sim, md, west, vest, 12.0 * 1.25 + 4.5)      # raio do salão + recortes da parede de rochas
	check(not _reached(seen, east), "alas oeste e leste só se ligam pelo vestíbulo")
	check(md.portals.size() == 2, "Catacumbas: saída + selo")
	for n in md.npcs:
		check(n["role"] == "quest", "%s dá quest" % n["id"])
	check(md.npcs.size() >= 2, "NPCs de quest dentro da dungeon")
	for mdef in gd.monsters.values():
		if mdef.model != "":
			check(FileAccess.file_exists("res://assets/models/%s.glb" % mdef.model), "modelo %s existe" % mdef.model)

func _spawner_pos(md: MapDef, monster_id: String) -> Vector3:
	for sp in md.spawners:
		if sp["monster_id"] == monster_id:
			return sp["pos"]
	return Vector3.ZERO

## Estradas limpas: nada sólido em cima de estrada/trilha, trilha não entra no lago nem em morro, estrada não termina
## solta, spawner não pega a estrada. Vale para toda zona exportada do Blender.
## Moradores passeiam perto de casa, nunca dentro de sólidos; conversa segura o NPC; serviços ficam no posto.
func _check_villagers(gd, sim) -> void:
	var def: MapDef = gd.maps["city_aldara"]
	check(MapsCatalog.VILLAGERS.size() >= 10 and MapsCatalog.VILLAGERS.size() <= 12, "Aldara: 10-12 moradores (%d)" % MapsCatalog.VILLAGERS.size())
	var m: Dictionary = sim.maps["city_aldara"]
	var vil: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.NPC and o.npc_data.get("role", "") == "villager")
	var smith: SimEntity = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.NPC and o.npc_data.get("id", "") == "smith")[0]
	check(vil.size() == MapsCatalog.VILLAGERS.size(), "moradores nascem no mapa (%d)" % vil.size())
	for v in vil:
		check(sim.is_walkable(v.position, def, 0.4), "%s nasce em chão livre" % v.npc_data["id"])
		check(not v.look.is_empty(), "%s tem visual" % v.npc_data["id"])
	var start := {}
	for v in vil:
		start[v.id] = v.position
	var smith_at: Vector3 = smith.position
	var far := 0.0
	var moved := 0
	var went := {}
	var bad: Array = []
	for i in range(60 * 40):
		for v in vil:
			sim._update_npc(v, m, 1.0 / 60.0)
		if i % 30 == 0:
			for v in vil:
				var home: Vector3 = v.npc_data["pos"]
				var lim: float = float(v.npc_data.get("wander", 0.0)) + 1.5 if v.npc_data.has("wander") else 40.0
				far = maxf(far, home.distance_to(v.position) - lim)
				went[v.id] = maxf(float(went.get(v.id, 0.0)), v.position.distance_to(start[v.id]))     # passear e voltar para casa também conta
				if not sim.is_walkable(v.position, def, 0.3):
					bad.append(v.npc_data["id"])
	for v in vil:
		if float(went.get(v.id, 0.0)) > 1.0:
			moved += 1
	check(moved >= vil.size() - 2, "moradores andam (%d/%d se moveram em 40 s)" % [moved, vil.size()])
	check(far <= 0.0, "moradores ficam perto de casa (excesso %.1f m)" % far)
	check(bad.is_empty(), "moradores nunca entram em sólido (%s)" % str(bad.slice(0, 3)))
	check(smith.position == smith_at, "ferreiro fica no posto")
	# conversa: segura o NPC parado
	var v0: SimEntity = vil[0]
	v0.npc_wait = 0.0
	v0.npc_goal = v0.position + Vector3(3, 0, 0)
	v0.npc_hold = 0.0
	sim.player = sim.player if sim.player else null
	v0.npc_hold = Balance.NPC_TALK_HOLD
	var at := v0.position
	sim._update_npc(v0, m, 0.5)
	check(v0.position == at, "morador conversando fica parado")
	v0.npc_hold = 0.0

## Casas que abrem: porta em Aldara só para o jogador, sala com saída de volta para a frente da casa, NPCs dentro.
## Druida começa com as armas das formas na bolsa, e o ferreiro forja as armas comuns das builds.
func _check_druid_start(gd, sim) -> void:
	var cls: ClassDef = gd.classes["druid"]
	var d: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Dru", "city_aldara", Vector3(0, 0, 6), 1)
	check(d.has_item("mace_t0", 2) and d.has_item("mace2h_t0"), "druida começa com duas maças e um martelo na bolsa")
	check(sim.equip(d, "mace_t0") and sim.equip(d, "mace_t0", true) and d.stats.meets([Balance.FORM_REQUIRES["wolf"]]), "duas maças: libera a Forma de Lobo")
	var shop: Array = []
	for n in gd.maps["city_aldara"].npcs:
		if n["id"] == "merchant":
			shop = n["shop"]
	for iid in ["mace_t0", "mace2h_t0", "axe_t0", "rifle_t0", "staff_oak", "bow_short"]:
		check(not gd.items.has(iid) or shop.has(iid), "mercador vende a arma de nível 1 %s" % iid)
	sim.despawn(d)

## Ato II (design/gdd/ato2-horda.md F1, R7): XP achatada depois do 30, faixa nova, pontos e nível de ascensão.
func _check_act2_xp_curve(gd) -> void:
	check(Balance.MAX_LEVEL >= 40 and Balance.ASC_LEVEL == 35, "nível máximo do Ato II (%d) e ascensão no 35" % Balance.MAX_LEVEL)
	check(Balance.xp_for_level(Balance.MAX_LEVEL) == 0, "sem XP no nível máximo")
	check(Balance.xp_for_level(34) == 52250, "F1: 34 -> 35 = 52 250 (%d)" % Balance.xp_for_level(34))
	check(absf(Balance.xp_for_level(30) - 44030.0) <= 440.3, "F1: 30 -> 31 ≈ 44 030 ±1%% (%d)" % Balance.xp_for_level(30))
	check(is_equal_approx(Balance.level_minutes(30), 57.25), "F1: minutos no 30 = 57,25 (%.2f)" % Balance.level_minutes(30))
	for lv in range(30, 44):
		check(is_equal_approx(Balance.level_minutes(lv + 1) - Balance.level_minutes(lv), Balance.XP_MIN_PER_LEVEL_ACT2), "F1: minutos crescem 0,75 de %d para %d" % [lv, lv + 1])
	for lv in range(1, 29):
		check(is_equal_approx(Balance.level_minutes(lv + 1) - Balance.level_minutes(lv), Balance.XP_MIN_PER_LEVEL), "Ato I: minutos crescem 1,75 de %d para %d" % [lv, lv + 1])
	check(Balance.XP_BANDS.has([30, 35]) and is_equal_approx(Balance.quest_share(30), 0.55), "faixa 30-35 com 55%% de XP de missão")
	# fase 2 (35-40): mesma fórmula achatada; valores do F1 nível a nível e ~5,2 h de faixa
	check(Balance.XP_BANDS.has([35, 40]) and is_equal_approx(Balance.quest_share(35), 0.55), "faixa 35-40 com 55%% de XP de missão")
	var f1_35_40 := {35: 54400, 36: 56580, 37: 58800, 38: 61060, 39: 63360}
	for l in f1_35_40:
		check(Balance.xp_for_level(l) == f1_35_40[l], "F1: %d -> %d = %d (%d)" % [l, l + 1, f1_35_40[l], Balance.xp_for_level(l)])
	check(Balance.band_xp(35, 40) == 294200, "F1: faixa 35-40 = 294 200 de XP (%d)" % Balance.band_xp(35, 40))
	var h_35_40 := 0.0
	for l in range(35, 40):
		h_35_40 += Balance.level_minutes(l) / 60.0
	check(absf(h_35_40 - 5.2) < 0.1, "F1: faixa 35-40 ≈ 5,2 h (%.2f)" % h_35_40)
	for i in range(Balance.XP_BANDS.size() - 1):
		check(Balance.XP_BANDS[i][1] == Balance.XP_BANDS[i + 1][0], "faixas de XP emendam (%s -> %s)" % [Balance.XP_BANDS[i], Balance.XP_BANDS[i + 1]])
	check(Balance.XP_BANDS[-1][1] == Balance.MAX_LEVEL, "a última faixa de XP termina no nível máximo (%d)" % Balance.MAX_LEVEL)
	var web_points := 0
	for l in range(2, 41):
		web_points += Balance.points_at(l)
	check(web_points == 316, "teia: 316 pontos no 40 (%d)" % web_points)
	# pontos de ascensão no 40: 3 por nível do 35 ao 40 + 3 da missão = 21 (calculados, R6)
	var asc := SimEntity.new()
	asc.class_def = gd.classes["paladin"]
	asc.level = 40
	asc.quests_completed.append("hx_asc_paladin")
	check(ProgressionSystem.asc_points_total(asc) == 21, "ascensão: 21 pontos no 40 (%d)" % ProgressionSystem.asc_points_total(asc))
	check(Balance.points_at(40) == 9 and Balance.points_at(30) == 9 and Balance.points_at(35) == 8, "pontos: +1 no 40 como no 10/20/30, 8 no 35")
	for lv in range(31, 46):
		if lv != 40:
			check(Balance.points_at(lv) == 8, "pontos no %d = 8" % lv)
	# um personagem sobe do 30 ao máximo e para lá com XP 0
	var e := SimEntity.new()
	e.level = 30
	e.xp = 0
	var need := Balance.band_xp(30, Balance.MAX_LEVEL)
	var lv := 30
	var left := need
	while lv < Balance.MAX_LEVEL:
		left -= Balance.xp_for_level(lv)
		lv += 1
	check(left == 0 and need > 500000, "30 -> %d: %d de XP (níveis de 44-63 mil)" % [Balance.MAX_LEVEL, need])

## Ato II (GDD F10): tier comum do 32, lendário do 35 (preço 7 moedas), bônus percentuais achatados acima do tier 5.
func _check_act2_gear(gd, sim) -> void:
	check(Balance.COMMON_TIER_LEVELS.has(32) and Balance.LEGENDARY_LEVELS.find(35) == 6, "tier comum do 32 e lendário 35 no índice 6")
	var t4 := Balance.COMMON_TIER_LEVELS.find(32)
	# raridade do comum nunca vira lendário
	check(GearCatalog.common_rarity(t4) == ItemDef.RARITY_LEGENDARY - 1, "comum do 32 é épico, não lendário")
	for wtype in GearCatalog.WEAPONS:
		var it: ItemDef = gd.items.get("%s_t%d" % [wtype, t4])
		check(it != null and it.level_req == 32 and not it.is_legendary() and it.set_id == "", "arma comum do 32: %s" % wtype)
	for armor in GearCatalog.ARMOR:
		for piece in GearCatalog.FULL_PIECES:
			var it: ItemDef = gd.items.get("%s_%s_t%d" % [piece, armor, t4])
			check(it != null and it.level_req == 32 and not it.is_legendary() and it.armor_style == armor, "armadura comum do 32: %s %s" % [piece, armor])
	var pool: Array = sim.gear_pool(t4)
	check(pool.size() >= 30 and pool.all(func(x): return x.level_req >= 32 and not x.is_legendary()), "drop comum do tier 32 (%d itens)" % pool.size())
	check(not sim.gear_pool(t4 - 1).any(func(x): return x.level_req >= 32), "tier 24 não mistura peças do 32")
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	for cid in gd.classes:
		var b: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato2", "city_aldara", Vector3(0, 0, 6), 33)
		var w: ItemDef = b.equipment.get(ItemDef.Slot.WEAPON)
		var body: ItemDef = b.equipment.get(ItemDef.Slot.BODY)
		check(w != null and w.level_req == 32 and body != null and body.level_req == 32, "bot %s nível 33 veste o tier do 32" % cid)
		sim.despawn(b)
		var b30: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato1", "city_aldara", Vector3(0, 0, 6), 30)
		check(b30.equipment.values().all(func(x): return x == null or x.level_req <= 30), "bot %s nível 30 não veste peça do 32" % cid)
		sim.despawn(b30)
	# lendário 35: preço 7 moedas, fator 1,393 × 1,2, visual do 30 reaproveitado, bônus i_ef
	check(is_equal_approx(Balance.set_pct_tier(6), 5.5) and is_equal_approx(Balance.set_pct_tier(8), 6.5) and is_equal_approx(Balance.set_pct_tier(5), 5.0), "F10: i_ef 5 / 5,5 / 6,5")
	var n35 := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.level != 35 or sd.is_hybrid():
			continue
		n35 += 1
		var v4: float = sd.bonuses[4]["skill_dmg"].values()[0]
		var cdr: float = sd.bonuses[5]["skill_cdr"].values()[0]
		check(is_equal_approx(v4, 42.0) and is_equal_approx(cdr, 21.0), "%s: 4 peças 42%% e recarga 21%% (%.1f, %.1f)" % [sid, v4, cdr])
		var stat_pct := 0.0
		for k in sd.bonuses[5]:
			if k != "skill_cdr" and str(k).ends_with("_pct") and not sd.bonuses[5][k] is Dictionary:
				stat_pct = maxf(stat_pct, float(sd.bonuses[5][k]))
		check(stat_pct >= 17.0, "%s: 5 peças +17%% no stat da build (%.1f)" % [sid, stat_pct])
		var vis: Dictionary = GearCatalog.visual_of(sid)
		var base30: String = sid.trim_suffix("_35") + "_30"
		check(vis.get("reuse", "") == base30 and vis.get("style", "") == GearCatalog.SET_VISUALS[base30]["style"], "%s: visual do conjunto 30" % sid)
		var head: ItemDef = gd.items[sd.armor[0]]
		check(head.armor_style == vis["style"] and head.name.ends_with("da Ascensão"), "%s: peça com estilo do 30 e nome próprio (%s)" % [sid, head.name])
		var w: ItemDef = gd.items[sid.replace("set_", "leg_") + "_weapon"]
		check(sim.relic_cost(w) == 7, "%s: custa 7 moedas" % sid)
		var w30: ItemDef = gd.items[base30.replace("set_", "leg_") + "_weapon"]
		check(w.atk >= w30.atk, "%s: arma não fica abaixo da do 30" % sid)
	check(n35 == 24, "24 conjuntos lendários do 35, um por build (%d)" % n35)
	var fire30: SetDef = gd.sets["set_elementalist_fogo_30"]
	check(is_equal_approx(fire30.bonuses[4]["skill_dmg"].values()[0], 40.0), "Ato I sem mudança: 4 peças do 30 = 40%")
	_check_act2_gear_40(gd, sim)
	_check_kharzun_cap(gd, sim)
	var sword35: ItemDef = gd.items["sword_t%d" % t4]
	var f35 := GearCatalog.level_factor(35)
	check(absf(f35 - 39.0 / 28.0) < 0.001, "F10: fator do nível 35 = 1,393 (%.3f)" % f35)
	check(absf(GearCatalog.level_factor(40) * Balance.LEGENDARY_MULT - 1.886) < 0.01, "F10: lendário 40 = 1,89 do item base 24")
	check(sword35.atk > gd.items["sword_dragon"].atk, "espada do 32 bate a Dracônica (%d)" % int(sword35.atk))

## Conjuntos híbridos e Fusões (GDD Ato II R7.1, AC-32b/c; design/gdd/ato2-proposals-2026-11-11.md §1.7).
func _check_hybrid_sets(gd, sim) -> void:
	var hyb: Array = gd.sets.values().filter(func(x): return x.is_hybrid())
	check(hyb.size() == 72, "72 conjuntos híbridos (8 classes × 3 pares × 3 tiers): %d" % hyb.size())
	var n_build: int = gd.sets.size() - hyb.size()
	check(n_build == 24 * Balance.LEGENDARY_LEVELS.size(), "conjuntos da build seguem 24 × níveis lendários (%d)" % n_build)
	check(Balance.HYBRID_LEVELS == [35, 40, 45] and Balance.legend_tier(35) == 6 and Balance.legend_tier(40) == 7 and Balance.legend_tier(45) == 8, "híbridos 35/40/45 nos tiers 6/7/8")
	# Fusões: 24, uma por par, números e textos coerentes
	check(GearCatalog.FUSIONS.size() == 24 and Balance.FUSION_NUMBERS.size() == 24, "24 Fusões com números (%d, %d)" % [GearCatalog.FUSIONS.size(), Balance.FUSION_NUMBERS.size()])
	check(FusionEffects.NEW_HOOKS.size() <= 6, "no máximo 6 ganchos novos na sim (%d)" % FusionEffects.NEW_HOOKS.size())
	var names := {}
	var dup: Array = []
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var pairs: Array = GearCatalog.hybrid_pairs(cls)
		check(pairs.size() == 3, "%s: 3 pares (A+B, B+C, C+A)" % cid)
		for pair in pairs:
			var fid := "%s+%s" % pair
			check(GearCatalog.FUSIONS.has(fid) and Balance.FUSION_NUMBERS.has(fid), "%s: Fusão %s existe" % [cid, fid])
			var fu: Dictionary = GearCatalog.FUSIONS.get(fid, {})
			var ba: Dictionary = cls.build_by_id(pair[0])
			var bb: Dictionary = cls.build_by_id(pair[1])
			var same_weapon: bool = ba["main"] == bb["main"] and ba["off"] == bb["off"]
			var faces: Array = (fu.get("text", {}) as Dictionary).keys()
			check(faces.all(func(k): return k == "all" or k in pair), "%s: faces da Fusão são de A, B ou 'all'" % fid)
			check(not same_weapon or faces == ["all"], "%s: mesma arma = uma face" % fid)
			for lv in Balance.HYBRID_LEVELS:
				var sd: SetDef = gd.sets.get(GearCatalog.hybrid_set_id(cid, pair[0], pair[1], lv))
				check(sd != null, "%s: híbrido %s nível %d existe" % [cid, fid, lv])
				if sd == null:
					continue
				var tier := Balance.legend_tier(lv)
				check(sd.armor.size() == 5 and sd.pieces == sd.armor and sd.fusion == fid and sd.pair == pair and sd.class_id == cid, "%s: 5 peças de armadura, par e Fusão" % sd.id)
				for pid in sd.armor:
					var it: ItemDef = gd.items[pid]
					var piece: String = pid.get_slice("_", pid.get_slice_count("_") - 1)
					check(it.set_id == sd.id and it.is_legendary() and it.level_req == lv and it.class_restriction == [cid], "%s: peça coerente" % pid)
					check(it.armor_style == ba["armor"] or (piece != "legs" and it.armor_style != ""), "%s: armadura do lado A (%s)" % [pid, it.armor_style])
					check(it.attr(ba["attr"]) > 0 and (ba["attr"] == bb["attr"] or it.attr(bb["attr"]) > 0), "%s: atributo de A e de B" % pid)
					check(it.icon != "" and ResourceLoader.exists("res://assets/icons/%s.png" % it.icon) if piece != "legs" else ResourceLoader.exists("res://assets/icons/art_%s.png" % pid), "%s: ícone/arte" % pid)
				# armas das duas builds como peças alternativas
				for bd in [ba, bb]:
					var wid := "leg_%s_mix_%s_%s_%d_%s_weapon" % [cid, pair[0], pair[1], lv, bd["id"]]
					var w: ItemDef = gd.items.get(wid)
					check(w != null and wid in sd.alt_pieces and w.weapon_type == bd["main"][0] and str(w.legend_effect.get("kind", "")) == str(bd["legend"]["kind"]), "%s: arma da build %s (efeito %s)" % [sd.id, bd["id"], bd["legend"]["kind"]])
					if bd["off"].size() > 0:
						check(gd.items.has(wid.replace("_weapon", "_offhand")) and wid.replace("_weapon", "_offhand") in sd.alt_pieces, "%s: mão secundária da build %s" % [sd.id, bd["id"]])
				for iid in sd.pieces + sd.alt_pieces:
					var nm: String = gd.items[iid].name
					if names.has(nm):
						dup.append(nm)
					names[nm] = true
					if iid in sd.alt_pieces:
						var w2: ItemDef = gd.items[iid]
						check(w2.icon == "" or ResourceLoader.exists("res://assets/icons/%s.png" % w2.icon) or ResourceLoader.exists("res://assets/icons/art_%s.png" % iid), "%s: ícone da arma" % iid)
				check(sim.relic_cost(gd.items[sd.armor[0]]) == tier + 1, "%s: custa %d moedas" % [sd.id, tier + 1])
				# bônus R7.1: 2 = de A, 3 = de B, 4 = metade do 4 de A e de B, 5 = Fusão (substitui o 5 normal)
				var pa := GearCatalog.set_skills(ba, gd.skills, lv, tier)
				var pb := GearCatalog.set_skills(bb, gd.skills, lv, tier)
				var na := GearCatalog.set_bonuses(ba, pa[0], pa[1], tier)
				var nb := GearCatalog.set_bonuses(bb, pb[0], pb[1], tier)
				var ks := sd.bonuses.keys()
				ks.sort()
				check(ks == [2, 3, 4, 5], "%s: bônus de 2/3/4/5" % sd.id)
				check(str(sd.bonuses[2].keys()) == str(na[2].keys()) and str(sd.bonuses[3].keys()) == str(nb[3].keys()), "%s: 2 peças de A, 3 peças de B" % sd.id)
				var want4 := 0.0
				for src in [na[4], nb[4]]:
					for v in src["skill_dmg"].values():
						want4 += float(v) * Balance.HYBRID_4PC_SHARE
				var got4 := 0.0
				for v in sd.bonuses[4]["skill_dmg"].values():
					got4 += float(v)
				check(absf(got4 - want4) < 0.2 and sd.bonuses[4]["skill_dmg"].has(pa[0]) and sd.bonuses[4]["skill_dmg"].has(pb[0]), "%s: 4 peças = metade de A + metade de B (%.1f)" % [sd.id, got4])
				var f5: Dictionary = sd.bonuses[5]
				check(f5.size() == 1 and f5.get("fusion") is Dictionary and str(f5["fusion"]["id"]) == fid, "%s: 5 peças = só a Fusão (sem stat%% e recarga)" % sd.id)
				var nums: Dictionary = Balance.FUSION_NUMBERS[fid]
				for k in nums:
					var want: float = float(nums[k][0]) + float(nums[k][1]) * (tier - 6) if nums[k] is Array else float(nums[k])
					check(absf(float(f5["fusion"].get(k, -999.0)) - want) < 0.011, "%s: F-FUS1 %s = %.2f" % [sd.id, k, want])
					if nums[k] is Array:
						check(float(f5["fusion"][k]) >= 0.79 * float(nums[k][0]), "%s: %s nunca abaixo de 80%% do v35" % [sd.id, k])
	check(dup.is_empty(), "nomes das peças híbridas únicos %s" % str(dup.slice(0, 4)))
	# Relicária: os híbridos aparecem para as duas builds; o 45 espera o MAX_LEVEL
	check(ItemSystem.relic_levels().has(35) and ItemSystem.relic_levels().has(40) and (Balance.MAX_LEVEL >= 45) == ItemSystem.relic_levels().has(45), "Relicária: híbridos até o MAX_LEVEL")
	var pal: ClassDef = gd.classes["paladin"]
	for bid in ["guardiao", "cruzado"]:
		var hs: Array = gd.hybrid_sets_for(pal, bid, 40).map(func(x): return x.id)
		check(GearCatalog.hybrid_set_id("paladin", "guardiao", "cruzado", 40) in hs and hs.size() == 2, "aba %s da Relicária mostra os 2 híbridos dela (%s)" % [bid, hs])
	check(gd.legendary_pool(pal, 35, "templario").has("leg_paladin_mix_cruzado_templario_35_head"), "híbrido cai/troca para as duas builds do par")
	# face pela arma; 4 peças sem Fusão; arma de fora apaga
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	var p: SimEntity = sim.spawn_bot(pal, "Hib", "city_aldara", Vector3(0, 0, 6), 40)
	var sd1: SetDef = gd.sets[GearCatalog.hybrid_set_id("paladin", "guardiao", "cruzado", 40)]
	for i in range(4):
		p.equipment[gd.items[sd1.armor[i]].slot] = gd.items[sd1.armor[i]]
	p.equipment[ItemDef.Slot.WEAPON] = gd.items["sword2h_t5"]
	p.equipment.erase(ItemDef.Slot.OFFHAND)
	p.recompute_stats()
	check(p.stats.fusion.is_empty(), "4 peças: sem Fusão")
	p.equipment[gd.items[sd1.armor[4]].slot] = gd.items[sd1.armor[4]]
	p.recompute_stats()
	check(str(p.stats.fusion.get("id", "")) == "guardiao+cruzado" and p.stats.fusion["face"] == "cruzado", "5 peças + 2 mãos: face do Cruzado")
	p.equipment[ItemDef.Slot.WEAPON] = gd.items["sword_t5"]
	p.equipment[ItemDef.Slot.OFFHAND] = gd.items["shield_t5"] if gd.items.has("shield_t5") else gd.items["shield_wood"]
	p.recompute_stats()
	check(p.stats.fusion["face"] == "guardiao", "5 peças + espada e escudo: face do Guardião")
	# P1 face 2 mãos: golpe direto dá Juramento (com recarga própria)
	p.equipment[ItemDef.Slot.WEAPON] = gd.items["sword2h_t5"]
	p.equipment.erase(ItemDef.Slot.OFFHAND)
	p.recompute_stats()
	var mob: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(1, 0, 6))
	p.drop_buff("juramento")
	FusionEffects.on_hit(sim, p, mob, gd.basic_skill_for_class(pal, "sword2h"), 10, false)
	FusionEffects.on_hit(sim, p, mob, gd.basic_skill_for_class(pal, "sword2h"), 10, false)
	check(p.buff_stacks("juramento") == 1, "Juramento Rubro: golpe de 2 mãos dá 1 Juramento (recarga segura o 2º): %d" % p.buff_stacks("juramento"))
	sim.despawn(mob)
	sim.despawn(p)
	# Bi1: o dano da sobrecura não gera Radiância (trava do laço)
	var bis: ClassDef = gd.classes["bishop"]
	var h: SimEntity = sim.spawn_bot(bis, "Luz", "city_aldara", Vector3(0, 0, 6), 40)
	var ally: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Ali", "city_aldara", Vector3(0.5, 0, 6), 40)
	sim.party_invite(h, ally)
	sim.party_accept(ally)
	var sdb: SetDef = gd.sets[GearCatalog.hybrid_set_id("bishop", "sacerdote", "inquisidor", 40)]
	for pid in sdb.armor:
		h.equipment[gd.items[pid].slot] = gd.items[pid]
	h.recompute_stats()
	h.stats.radiance = 50.0
	h.stats.lifesteal = 0.0          # só a Radiância conta aqui (a teia do bot pode dar roubo de vida)
	var foe: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(1.5, 0, 6))
	foe.stats.max_hp = 1.0e6
	foe.hp = 1.0e6
	ally.hp = ally.stats.max_hp * 0.5
	var ally_hp := ally.hp
	h.hp = h.stats.max_hp * 0.5
	var foe_hp := foe.hp
	FusionEffects.on_overheal(sim, h, ally, 500.0)
	check(foe.hp < foe_hp, "Luz que Julga: sobrecura vira dano no inimigo perto do aliado")
	check(is_equal_approx(ally.hp, ally_hp) and h.hp <= h.stats.max_hp * 0.5 + 0.01, "Luz que Julga: o dano da sobrecura não gera cura (Radiância) ally %.0f->%.0f h %.0f/%.0f" % [ally_hp, ally.hp, h.hp, h.stats.max_hp])
	sim.despawn(foe)
	sim.despawn(ally)
	sim.despawn(h)
	# AC-32c: bot da build A com a teia mais comprada no braço B pega o híbrido A+B (e C+A se for C)
	var b: SimEntity = sim.spawn_bot(pal, "Esc", "city_aldara", Vector3(0, 0, 6), 40)
	b.build_id = "guardiao"
	var nodes: Dictionary = ProgressionSystem.tree_of(sim, b)["nodes"]
	for want in [["cruzado", GearCatalog.hybrid_set_id("paladin", "guardiao", "cruzado", 40)], ["templario", GearCatalog.hybrid_set_id("paladin", "templario", "guardiao", 40)]]:
		b.tree = {}
		var k := 0
		for nid in nodes:
			if str(nodes[nid].get("branch", "")) == want[0] and k < 12:
				b.tree[nid] = true
				k += 1
		check(sim.bot_legendary_set(b, 40) == want[1], "AC-32c: Guardião com a teia no %s pega %s (%s)" % [want[0], want[1], sim.bot_legendary_set(b, 40)])
	check(sim.bot_legendary_set(b, 30) == "set_paladin_guardiao_30", "abaixo do 35 o bot fica com o conjunto da build")
	sim.despawn(b)
	# E1 Vapor: gelo em alvo queimando consome a queimadura e causa o dano na hora
	var ele: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Vap", "city_aldara", Vector3(0, 0, 6), 40)
	var sde: SetDef = gd.sets[GearCatalog.hybrid_set_id("elementalist", "fogo", "gelo", 40)]
	for pid in sde.armor:
		ele.equipment[gd.items[pid].slot] = gd.items[pid]
	ele.recompute_stats()
	var t2: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(1, 0, 6))
	t2.stats.max_hp = 1.0e6
	t2.hp = 1.0e6
	t2.debuffs.append({"kind": "dot", "id": "dot_%d" % ele.id, "remaining": 4.0, "dps": 100.0, "src": ele.id, "fire": true})
	FusionEffects.on_hit(sim, ele, t2, gd.skills["ele_ice_lance"], 10, false)
	check(t2.hp <= 1.0e6 - 400.0 * 1.4 and not t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor: gelo apaga a queimadura e causa %d%% dela na hora" % int(FusionEffects.num(ele, "quench")))
	# E1 (2026-11-12): fogo em alvo retardado também faz Vapor; com recarga (o vapor retarda: não se encadeia) e nada sem o alvo retardado
	var fb: SkillDef = gd.skills["ele_fireball"]
	var burn := {"kind": "dot", "id": "dot_%d" % ele.id, "remaining": 4.0, "dps": 100.0, "src": ele.id, "fire": true}
	t2.debuffs.clear()
	t2.hp = 1.0e6
	t2.debuffs.append(burn.duplicate())
	FusionEffects.on_hit(sim, ele, t2, fb, 10, false)
	check(is_equal_approx(t2.hp, 1.0e6) and t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor: fogo em alvo SEM lentidão não apaga a queimadura")
	t2.debuffs.append({"kind": "slow", "remaining": 3.0, "pct": 30.0})
	ele.fus.erase("vapor_at")
	FusionEffects.on_hit(sim, ele, t2, fb, 10, false)
	check(t2.hp <= 1.0e6 - 400.0 * 1.4 and not t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor: fogo em alvo retardado apaga a queimadura e causa %d%% dela na hora" % int(FusionEffects.num(ele, "quench")))
	var hp1 := t2.hp
	t2.debuffs.append(burn.duplicate())
	FusionEffects.on_hit(sim, ele, t2, fb, 10, false)
	check(is_equal_approx(t2.hp, hp1) and t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor por fogo tem recarga de %.1f s (não se encadeia no próprio retardo)" % Balance.FUSION_VAPOR_ICD)
	FusionEffects.on_hit(sim, ele, t2, gd.skills["ele_ice_lance"], 10, false)
	check(t2.hp < hp1 and not t2.debuffs.any(func(d): return d.get("fire", false)), "Vapor por gelo segue sem recarga")
	check(GearCatalog.FUSIONS["fogo+gelo"]["text"]["all"].contains("fogo em alvo retardado"), "texto do Vapor cita o gatilho do fogo")
	sim.despawn(t2)
	sim.despawn(ele)
	_check_fusion_redesign(gd, sim)

## Veste `n` peças do híbrido A+B nível 40 e a arma (e mão secundária) dada; devolve o personagem com os stats refeitos.
func _wear_hybrid(gd, e: SimEntity, a: String, b: String, n: int, weapon: String, off: String = "") -> SimEntity:
	var sd: SetDef = gd.sets[GearCatalog.hybrid_set_id(e.class_def.id, a, b, 40)]
	for i in range(5):
		var it: ItemDef = gd.items[sd.armor[i]]
		if i < n:
			e.equipment[it.slot] = it
		else:
			e.equipment.erase(it.slot)
	e.equipment[ItemDef.Slot.WEAPON] = gd.items[weapon]
	if off != "":
		e.equipment[ItemDef.Slot.OFFHAND] = gd.items[off]
	else:
		e.equipment.erase(ItemDef.Slot.OFFHAND)
	e.recompute_stats()
	return e

func _big_mob(gd, sim, at: Vector3) -> SimEntity:
	var m: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", at)
	m.stats.max_hp = 1.0e7
	m.hp = 1.0e7
	return m

## Redesenho 2026-11-12 (GDD ato2-proposals 1.9): P2, Bi2, D2, N2 quase sempre ligadas; E1 com regra de bot. Cada uma
## dispara com 5 peças e fica apagada com 4.
func _check_fusion_redesign(gd, sim) -> void:
	var at := Vector3(0, 0, 6)
	# P2 Sentença Ardente: golpe direto põe Penitência; cada carga +pen_dmg% em todo o dano no alvo; na 5ª explode e volta a 2
	var pal: SimEntity = _wear_hybrid(gd, sim.spawn_bot(gd.classes["paladin"], "Sen", "city_aldara", at, 40), "cruzado", "templario", 5, "sword2h_t5")
	var mob: SimEntity = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	var basic: SkillDef = gd.basic_skill_for_class(pal.class_def, "sword2h")
	check(FusionEffects.face(pal) == "cruzado" and is_equal_approx(FusionEffects.damage_mult(pal, mob), 1.0), "Sentença Ardente: sem Penitência, dano normal")
	FusionEffects.on_hit(sim, pal, mob, basic, 10, false)
	var pd := FusionEffects.num(pal, "pen_dmg")
	check(FusionEffects._penance(pal, mob) == 1 and absf(FusionEffects.damage_mult(pal, mob) - (1.0 + pd / 100.0)) < 0.001, "Sentença Ardente: golpe põe 1 Penitência e +%.2f%% de dano no alvo" % pd)
	mob.put_debuff({"kind": "penance", "id": "legend_penance_%d" % pal.id, "remaining": 5.0, "stacks": 4})
	check(absf(FusionEffects.damage_mult(pal, mob) - (1.0 + 4.0 * pd / 100.0)) < 0.001, "Sentença Ardente: o bônus cresce por carga (4)")
	pal.fus.erase("pen_%d" % mob.id)
	var hp0: float = mob.hp
	FusionEffects.on_hit(sim, pal, mob, basic, 10, false)
	check(mob.hp < hp0 and FusionEffects._penance(pal, mob) == Balance.FUSION_PEN_KEEP, "Sentença Ardente: a 5ª carga explode e volta a %d (%d)" % [Balance.FUSION_PEN_KEEP, FusionEffects._penance(pal, mob)])
	_wear_hybrid(gd, pal, "cruzado", "templario", 4, "sword2h_t5")
	check(is_equal_approx(FusionEffects.damage_mult(pal, mob), 1.0), "Sentença Ardente: 4 peças = apagada")
	sim.despawn(pal)
	sim.despawn(mob)
	# Bi2 Martelo da Aurora: magia sagrada dá Aurora (+ATK/+MATK); golpe de arma cura o aliado mais ferido
	var bis: SimEntity = _wear_hybrid(gd, sim.spawn_bot(gd.classes["bishop"], "Aur", "city_aldara", at, 40), "inquisidor", "batalha", 5, "scepter_t5")
	var ally: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Ali", "city_aldara", at + Vector3(0.5, 0, 0), 40)
	sim.party_invite(bis, ally)
	sim.party_accept(ally)
	var matk0: float = bis.stats.matk
	FusionEffects.on_cast(sim, bis, gd.skills["bis_smite"], at)
	var au := FusionEffects.num(bis, "aurora")
	check(bis.buffs.any(func(x): return x.get("id") == FusionEffects.AURORA_BUFF) and bis.stats.matk > matk0 * (1.0 + au / 200.0),
		"Martelo da Aurora: magia sagrada dá Aurora (MATK %.0f -> %.0f)" % [matk0, bis.stats.matk])
	check(BuffLooks.LOOKS.has(FusionEffects.AURORA_BUFF), "Aurora tem visual (BuffLooks)")
	ally.hp = ally.stats.max_hp * 0.5
	var ahp: float = ally.hp
	mob = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	FusionEffects.on_hit(sim, bis, mob, gd.basic_skill_for_class(bis.class_def, "scepter"), 1000, false)
	check(ally.hp > ahp, "Martelo da Aurora: golpe de arma cura o aliado mais ferido (%.0f -> %.0f)" % [ahp, ally.hp])
	bis.drop_buff(FusionEffects.AURORA_BUFF)
	_wear_hybrid(gd, bis, "inquisidor", "batalha", 4, "scepter_t5")
	FusionEffects.on_cast(sim, bis, gd.skills["bis_smite"], at)
	check(not bis.buffs.any(func(x): return x.get("id") == FusionEffects.AURORA_BUFF), "Martelo da Aurora: 4 peças = sem Aurora")
	sim.despawn(ally)
	sim.despawn(bis)
	sim.despawn(mob)
	# D2 Lua Caçadora: face duas maças +hunt% em alvo sangrando/com Fogo Lunar; face cajado: Fogo Lunar faz sangrar, magia em sangrando +hunt%
	var dru: SimEntity = _wear_hybrid(gd, sim.spawn_bot(gd.classes["druid"], "Lua", "city_aldara", at, 40), "fera", "xama", 5, "mace_t5", "mace_t5")
	mob = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	var hunt := FusionEffects.num(dru, "hunt")
	check(FusionEffects.face(dru) == "fera" and is_equal_approx(FusionEffects.damage_mult(dru, mob), 1.0), "Lua Caçadora (lobo): alvo limpo, dano normal")
	FusionEffects.on_hit(sim, dru, mob, gd.skills["dru_moonfire"], 10, false)
	check(absf(FusionEffects.damage_mult(dru, mob) - (1.0 + hunt / 100.0)) < 0.001, "Lua Caçadora (lobo): alvo com Fogo Lunar +%.0f%%" % hunt)
	_wear_hybrid(gd, dru, "fera", "xama", 5, "staff_t5")
	var m2: SimEntity = _big_mob(gd, sim, at + Vector3(-1, 0, 0))
	check(FusionEffects.face(dru) == "xama" and is_equal_approx(FusionEffects.hit_mult(sim, dru, m2, gd.skills["dru_moonfire"]), 1.0), "Lua Caçadora (cajado): alvo sem sangrar, magia normal")
	FusionEffects.on_hit(sim, dru, m2, gd.skills["dru_moonfire"], 10, false)
	check(m2.debuffs.any(func(d): return d.get("bleed", false) and int(d.get("src", -1)) == dru.id), "Lua Caçadora (cajado): Fogo Lunar faz sangrar")
	check(absf(FusionEffects.hit_mult(sim, dru, m2, gd.skills["dru_moonfire"]) - (1.0 + hunt / 100.0)) < 0.001, "Lua Caçadora (cajado): magia em alvo sangrando +%.0f%%" % hunt)
	_wear_hybrid(gd, dru, "fera", "xama", 4, "mace_t5", "mace_t5")
	check(is_equal_approx(FusionEffects.damage_mult(dru, mob), 1.0), "Lua Caçadora: 4 peças = apagada")
	sim.despawn(dru)
	sim.despawn(mob)
	sim.despawn(m2)
	# N2 Colheita da Praga: golpe de foice põe Praga Menor (maldição, até 3); cada maldição dá dano e roubo de vida
	var nec: SimEntity = _wear_hybrid(gd, sim.spawn_bot(gd.classes["necromancer"], "Pra", "city_aldara", at, 40), "ceifador", "pestilento", 5, "scythe_t5")
	mob = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	var nb: SkillDef = gd.basic_skill_for_class(nec.class_def, "scythe")
	for i in range(4):
		FusionEffects.on_hit(sim, nec, mob, nb, 10, false)
	var cd := FusionEffects.num(nec, "curse_dmg")
	check(FusionEffects._curses(nec, mob) == Balance.FUSION_PLAGUE_MAX and mob.debuffs.any(func(d): return d.get("kind") == "curse" and int(d.get("stacks", 0)) == Balance.FUSION_PLAGUE_MAX),
		"Colheita da Praga: golpes de foice põem Praga Menor até %d (maldição)" % Balance.FUSION_PLAGUE_MAX)
	check(absf(FusionEffects.hit_mult(sim, nec, mob, nb) - (1.0 + 3.0 * cd / 100.0)) < 0.001, "Colheita da Praga: +%.1f%% por maldição na foice" % cd)
	nec.hp = nec.stats.max_hp * 0.5
	var nhp: float = nec.hp
	FusionEffects.on_hit(sim, nec, mob, nb, 1000, false)
	check(nec.hp > nhp, "Colheita da Praga: roubo de vida por maldição")
	var m3: SimEntity = _big_mob(gd, sim, at + Vector3(-1, 0, 0))
	_wear_hybrid(gd, nec, "ceifador", "pestilento", 4, "scythe_t5")
	FusionEffects.on_hit(sim, nec, m3, nb, 10, false)
	check(FusionEffects._curses(nec, m3) == 0, "Colheita da Praga: 4 peças = sem Praga Menor")
	sim.despawn(nec)
	sim.despawn(mob)
	sim.despawn(m3)
	# E1 Vapor (bots): com a Fusão, gelo em alvo que queima com o seu fogo pesa mais na escolha
	var ele: SimEntity = _wear_hybrid(gd, sim.spawn_bot(gd.classes["elementalist"], "Vp2", "city_aldara", at, 40), "fogo", "gelo", 5, "staff_t5")
	mob = _big_mob(gd, sim, at + Vector3(1, 0, 0))
	check(is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_ice_lance"]), 1.0), "Vapor (bot): alvo sem queimar, gelo sem peso extra")
	mob.debuffs.append({"kind": "dot", "id": "dot_%d" % ele.id, "remaining": 4.0, "dps": 10.0, "src": ele.id, "fire": true})
	check(is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_ice_lance"]), Balance.BOT_FUSION_SCORE) and is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_fireball"]), 1.0),
		"Vapor (bot): alvo queimando, gelo pesa x%.1f (fogo não)" % Balance.BOT_FUSION_SCORE)
	ele.build_id = "fogo"
	sim._slot_bot(ele)
	var fs: SkillDef = FusionEffects.bot_slot_skill(ele)
	check(fs != null and ele.slot_of(fs.id) >= 0 and ele.slot_of(fs.id) < Balance.SKILL_SLOTS, "Vapor (bot): bot do Fogo com a Fusão leva uma skill de gelo na barra (%s)" % (fs.id if fs else "nenhuma"))
	_wear_hybrid(gd, ele, "fogo", "gelo", 4, "staff_t5")
	check(is_equal_approx(FusionEffects.bot_skill_mult(ele, mob, gd.skills["ele_ice_lance"]), 1.0) and FusionEffects.bot_slot_skill(ele) == null, "Vapor (bot): 4 peças = sem peso nem skill de gelo forçada")
	sim.despawn(ele)
	sim.despawn(mob)

## Ato II fase 2 (GDD F10, AC-32): tier comum do 40 ("de Oricalco", épico), lendário do 40 no índice 7 (8 moedas,
## i_ef = 6 -> 4 peças 44%, 5 peças 18%, recarga 22%), visual do 30 reaproveitado, bots vestem pelo nível.
func _check_act2_gear_40(gd, sim) -> void:
	check(Balance.COMMON_TIER_LEVELS == [1, 8, 16, 24, 32, 40] and Balance.LEGENDARY_LEVELS.find(40) == 7, "tiers comuns 32/40 e lendário 40 no índice 7")
	check(GearCatalog.COMMON_TIER_NAMES.size() == Balance.COMMON_TIER_LEVELS.size() and GearCatalog.TIER_EPITHETS.size() == Balance.LEGENDARY_LEVELS.size(),
		"um nome por tier comum e um epíteto por nível lendário")
	var t5 := Balance.COMMON_TIER_LEVELS.find(40)
	check(GearCatalog.common_rarity(t5) == ItemDef.RARITY_LEGENDARY - 1, "comum do 40 é épico, não lendário")
	var ids: Array = []
	for wtype in GearCatalog.WEAPONS:
		var it: ItemDef = gd.items.get("%s_t%d" % [wtype, t5])
		check(it != null and it.level_req == 40 and not it.is_legendary() and it.set_id == "" and it.name.ends_with(GearCatalog.COMMON_TIER_NAMES[t5]), "arma comum do 40: %s" % wtype)
		var prev: ItemDef = gd.items.get("%s_t%d" % [wtype, t5 - 1])
		check(it != null and prev != null and it.atk + it.matk + it.def > prev.atk + prev.matk + prev.def and it.price > prev.price, "%s do 40 passa a do 32" % wtype)
		ids.append("%s_t%d" % [wtype, t5])
	for armor in GearCatalog.ARMOR:
		for piece in GearCatalog.FULL_PIECES:
			var it: ItemDef = gd.items.get("%s_%s_t%d" % [piece, armor, t5])
			check(it != null and it.level_req == 40 and not it.is_legendary() and it.armor_style == armor, "armadura comum do 40: %s %s" % [piece, armor])
			ids.append("%s_%s_t%d" % [piece, armor, t5])
	for it in GearCatalog.wearables(t5):
		check(gd.items.has(it.id) and it.level_req == 40 and it.rarity == ItemDef.RARITY_LEGENDARY - 1, "calça/capa/joia do 40: %s" % it.id)
		ids.append(it.id)
	for iid in ids:
		check(ResourceLoader.exists("res://assets/icons/art_%s.png" % iid), "ícone pintado de %s (item_icons.tscn)" % iid)
	var pool: Array = sim.gear_pool(t5)
	check(pool.size() >= 30 and pool.all(func(x): return x.level_req >= 40 and not x.is_legendary()), "drop comum do tier 40 (%d itens)" % pool.size())
	check(not sim.gear_pool(t5 - 1).any(func(x): return x.level_req >= 40), "tier 32 não mistura peças do 40")
	for cid in gd.classes:
		var b: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato2b", "city_aldara", Vector3(0, 0, 6), 40)
		var w: ItemDef = b.equipment.get(ItemDef.Slot.WEAPON)
		var body: ItemDef = b.equipment.get(ItemDef.Slot.BODY)
		check(w != null and w.level_req == 40 and body != null and body.level_req == 40, "bot %s nível 40 veste o tier do 40" % cid)
		check(b.equipment.values().all(func(x): return x == null or x.level_req == 40), "bot %s nível 40: todas as peças do tier do 40" % cid)
		sim.despawn(b)
		var b39: SimEntity = sim.spawn_bot(gd.classes[cid], "Ato2a", "city_aldara", Vector3(0, 0, 6), 39)
		check(b39.equipment.values().all(func(x): return x == null or x.level_req == 32), "bot %s nível 39 fica no tier do 32" % cid)
		sim.despawn(b39)
	check(is_equal_approx(Balance.set_pct_tier(7), 6.0), "F10: i_ef do lendário 40 = 6")
	var n40 := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.level != 40 or sd.is_hybrid():
			continue
		n40 += 1
		var v4: float = sd.bonuses[4]["skill_dmg"].values()[0]
		var cdr: float = sd.bonuses[5]["skill_cdr"].values()[0]
		check(is_equal_approx(v4, 44.0) and is_equal_approx(cdr, 22.0), "%s: 4 peças 44%% e recarga 22%% (%.1f, %.1f)" % [sid, v4, cdr])
		var stat_pct := 0.0
		for k in sd.bonuses[5]:
			if k != "skill_cdr" and str(k).ends_with("_pct") and not sd.bonuses[5][k] is Dictionary:
				stat_pct = maxf(stat_pct, float(sd.bonuses[5][k]))
		check(stat_pct >= 18.0, "%s: 5 peças +18%% no stat da build (%.1f)" % [sid, stat_pct])
		var vis: Dictionary = GearCatalog.visual_of(sid)
		var base30: String = sid.trim_suffix("_40") + "_30"
		check(vis.get("reuse", "") == base30 and vis.get("style", "") == GearCatalog.SET_VISUALS[base30]["style"], "%s: visual do conjunto 30" % sid)
		var head: ItemDef = gd.items[sd.armor[0]]
		check(head.armor_style == vis["style"] and head.name.ends_with(GearCatalog.TIER_EPITHETS[7]) and head.level_req == 40, "%s: peça com estilo do 30 e nome próprio (%s)" % [sid, head.name])
		var w: ItemDef = gd.items[sid.replace("set_", "leg_") + "_weapon"]
		check(sim.relic_cost(w) == 8, "%s: custa 8 moedas" % sid)
		var w35: ItemDef = gd.items[(sid.trim_suffix("_40") + "_35").replace("set_", "leg_") + "_weapon"]
		check(w.atk > w35.atk or w.matk > w35.matk, "%s: arma acima da do 35" % sid)
		var t5w: ItemDef = gd.items.get("%s_t%d" % [w.weapon_type, t5])
		check(t5w != null and w.atk >= t5w.atk and w.matk >= t5w.matk, "%s: arma lendária do 40 não fica abaixo da comum do 40" % sid)
	check(n40 == 24, "24 conjuntos lendários do 40, um por build (%d)" % n40)
	check(absf(GearCatalog.level_factor(40) - 44.0 / 28.0) < 0.001, "F10: fator do nível 40 = 1,571 (%.3f)" % GearCatalog.level_factor(40))

## Teto 45 (Monte Kharzun, design/gdd/kharzun-fase3-plan.md WP1/KAC-03/KAC-13): faixa de XP 40-45, lendários e híbridos
## do 45 na Relicária (9 moedas, i_ef 6,5), linha de talento 45, pontos de teia e de ascensão no 45, bots no 45.
func _check_kharzun_cap(gd, sim) -> void:
	check(Balance.MAX_LEVEL == 45 and Balance.ASC_MAX_LEVEL == Balance.MAX_LEVEL, "teto do Ato II: nível 45 (%d), ascensão até o teto" % Balance.MAX_LEVEL)
	check(Balance.XP_BANDS[-1] == [40, 45] and is_equal_approx(Balance.quest_share(40), 0.5), "faixa 40-45 com 50%% de XP de missão (F1)")
	check(absf(Balance.xp_for_level(44) - 75390.0) <= 753.9, "F1: 44 -> 45 ≈ 75 390 ±1%% (%d)" % Balance.xp_for_level(44))
	var h := 0.0
	for l in range(40, 45):
		h += Balance.level_minutes(l) / 60.0
	check(absf(h - 5.5) < 0.1, "F1: faixa 40-45 ≈ 5,5 h (%.2f)" % h)
	var web_points := 0
	for l in range(2, 46):
		web_points += Balance.points_at(l)
	check(web_points == 356 and Balance.points_at(45) == 8, "teia: 356 pontos no 45 (%d), sem bônus no 45" % web_points)
	var asc := SimEntity.new()
	asc.class_def = gd.classes["paladin"]
	asc.level = 45
	asc.quests_completed.append("hx_asc_paladin")
	check(ProgressionSystem.asc_points_total(asc) == 36, "ascensão: 36 pontos no 45 (%d)" % ProgressionSystem.asc_points_total(asc))
	# lendários do 45: índice 8, 9 moedas, epíteto próprio, bônus % pelo i_ef 6,5 (F10: 46% / 19% / 23%)
	check(Balance.LEGENDARY_LEVELS[-1] == 45 and Balance.legend_tier(45) == 8 and is_equal_approx(Balance.set_pct_tier(8), 6.5), "lendário 45 no índice 8 (i_ef 6,5)")
	check(GearCatalog.TIER_EPITHETS.size() == Balance.LEGENDARY_LEVELS.size() and not GearCatalog.TIER_EPITHETS.slice(0, 8).has(GearCatalog.TIER_EPITHETS[8]), "epíteto próprio do 45 (%s)" % GearCatalog.TIER_EPITHETS[-1])
	check(ItemSystem.relic_levels().has(45), "Relicária troca o 45")
	var n45 := 0
	var n45h := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.level != 45:
			continue
		if sd.is_hybrid():
			n45h += 1
			continue
		n45 += 1
		var v4: float = sd.bonuses[4]["skill_dmg"].values()[0]
		var cdr: float = sd.bonuses[5]["skill_cdr"].values()[0]
		check(is_equal_approx(v4, 46.0) and is_equal_approx(cdr, 23.0), "%s: 4 peças 46%% e recarga 23%% (%.1f, %.1f)" % [sid, v4, cdr])
		var w: ItemDef = gd.items[sid.replace("set_", "leg_") + "_weapon"]
		check(sim.relic_cost(w) == 9 and w.level_req == 45, "%s: arma do 45 custa 9 moedas" % sid)
		var w40: ItemDef = gd.items[(sid.trim_suffix("_45") + "_40").replace("set_", "leg_") + "_weapon"]
		check(w.atk > w40.atk or w.matk > w40.matk, "%s: arma acima da do 40" % sid)
		var head: ItemDef = gd.items[sd.armor[0]]
		check(head.name.ends_with(GearCatalog.TIER_EPITHETS[8]) and head.level_req == 45 and not GearCatalog.visual_of(sid).is_empty(), "%s: peça com nome do 45 e visual reaproveitado (%s)" % [sid, head.name])
	check(n45 == 24 and n45h == 24, "24 conjuntos de build e 24 híbridos do 45 (%d, %d)" % [n45, n45h])
	for cid in gd.classes:
		var p := SimEntity.new()
		p.class_def = gd.classes[cid]
		p.level = 45
		var offer: Array = sim.relic_offer(p)
		check(offer.any(func(iid): return gd.items[iid].level_req == 45 and gd.items[iid].set_id != "" and not gd.sets[gd.items[iid].set_id].is_hybrid()), "%s: Relicária oferece conjunto da build do 45" % cid)
		check(offer.any(func(iid): return gd.items[iid].level_req == 45 and gd.items[iid].set_id != "" and gd.sets[gd.items[iid].set_id].is_hybrid()), "%s: Relicária oferece híbrido do 45" % cid)
	# linha de talento 45: fechada no 44, abre no 45 (uma opção por classe)
	var cat: Dictionary = ClassTalentsCatalog.build()
	var at: Vector3 = sim.maps["city_aldara"]["def"].town_center
	# save do teto antigo (40, XP zerada no teto): carrega igual e volta a subir
	var old: SimEntity = sim.spawn_bot(gd.classes["paladin"], "K40", "city_aldara", at, 40)
	old.xp = 0
	ProgressionSystem.gain_xp(sim, old, Balance.xp_for_level(40))
	check(Balance.xp_for_level(40) > 0 and old.level == 41 and old.xp == 0, "save no 40 (teto antigo) sobe para o 41 (nv %d)" % old.level)
	sim.despawn(old)
	for cid in gd.classes:
		var row45: Array = (cat[cid] as Array).filter(func(r): return int(r[0]) == 45)
		check(row45.size() == 1, "%s: linha de talento 45" % cid)
		if row45.is_empty():
			continue
		var nid: String = "%s_c_%s" % [cid, row45[0][1][0]["id"]]
		var b: SimEntity = sim.spawn_bot(gd.classes[cid], "K45", "city_aldara", at, 44)
		check(sim.tree_block_reason(b, nid) == "requer nível 45", "%s: talento 45 fechado no 44 (%s)" % [cid, sim.tree_block_reason(b, nid)])
		# sobe do 44 ao 45 pela XP: para no 45 com XP 0, ganha os 8 pontos e o talento abre; bot veste o tier comum do 40
		ProgressionSystem.gain_xp(sim, b, Balance.xp_for_level(44) + 500)
		check(b.level == 45 and b.xp == 0, "%s: 44 -> 45 pela XP e para (nv %d, xp %d)" % [cid, b.level, b.xp])
		ProgressionSystem.gain_xp(sim, b, 100000)
		check(b.level == 45 and b.xp == 0, "%s: no 45 a XP não acumula" % cid)
		check(not sim.tree_block_reason(b, nid).begins_with("requer nível"), "%s: talento 45 abre no 45 (%s)" % [cid, sim.tree_block_reason(b, nid)])
		sim.despawn(b)
		var b45: SimEntity = sim.spawn_bot(gd.classes[cid], "K45b", "city_aldara", at, 45)
		var w: ItemDef = b45.equipment.get(ItemDef.Slot.WEAPON)
		check(w != null and w.level_req == 40, "bot %s nível 45 veste o tier comum do 40" % cid)
		check(b45.mastery_points <= Balance.MASTERY_POINTS_PER_LEVEL, "bot %s nível 45 gasta a teia (sobra %d)" % [cid, b45.mastery_points])
		sim.despawn(b45)

## Níveis lendários com visual próprio (até GearCatalog.OWN_VISUALS_UNTIL); acima o conjunto reaproveita (visual_of).
func _own_visual_levels() -> Array:
	return Balance.LEGENDARY_LEVELS.filter(func(l): return l <= GearCatalog.OWN_VISUALS_UNTIL)

## Faixas de XP abertas antes das missões delas chegarem (outra árvore de trabalho). Tire a entrada depois do merge.
const QUEST_PENDING_BANDS := [40]

## Ritmo: ~15 h até o 30 e as quests dando ~45% de cada faixa.
func _check_xp_budget(gd) -> void:
	var hours := 0.0
	for lv in range(1, 30):
		hours += Balance.level_minutes(lv) / 60.0
	check(hours > 13.0 and hours < 17.0, "ritmo planejado até o 30: %.1f h" % hours)
	for band in Balance.XP_BANDS:
		var need := Balance.band_xp(band[0], band[1])
		var qx := 0
		var n := 0
		for qid in gd.quests:
			var q: QuestDef = gd.quests[qid]
			if not q.repeatable and q.level_req >= band[0] and q.level_req < band[1]:
				qx += q.reward_xp
				n += 1
		# faixa cujas missões ainda não entraram nesta árvore (QUEST_PENDING_BANDS): pula só enquanto nenhuma missão da faixa
		# dá XP (as de ascensão do 35 dão 0); com a primeira missão de XP a faixa passa a ser cobrada sozinha
		if qx == 0 and band[0] in QUEST_PENDING_BANDS:
			print("  PENDENTE: faixa %d-%d sem missões de XP nesta árvore (entram com o Monte Kharzun, WP9); parte de quest não conferida" % [band[0], band[1]])
			continue
		var share := float(qx) / maxf(1.0, need)
		var want := Balance.quest_share(band[0])
		check(absf(share - want) < 0.05, "faixa %d-%d: quests dão %.0f%% da XP (alvo %.0f%%, %d quests)" % [band[0], band[1], share * 100.0, want * 100.0, n])
		check(n >= 10, "faixa %d-%d: pelo menos 10 quests (%d)" % [band[0], band[1], n])
	# nível a nível (faixas 1-10 e 10-20): nenhum nível fica só no grind (o 6-7 e o 11-13 já ficaram quase sem quest)
	for lv in range(2, 20):
		var qx_lv := 0
		for qid in gd.quests:
			var q: QuestDef = gd.quests[qid]
			if not q.repeatable and q.level_req == lv:
				qx_lv += q.reward_xp
		check(qx_lv >= Balance.xp_for_level(lv) * 0.35, "nível %d: quests dão %d de %d XP (>= 35%%)" % [lv, qx_lv, Balance.xp_for_level(lv)])
	var kills_l25: float = Balance.xp_for_level(25) * (1.0 - Balance.XP_QUEST_SHARE) / gd.monsters["skeleton"].xp
	check(kills_l25 > 100 and kills_l25 < 400, "nível 25: ~%d abates de esqueleto (não milhares)" % int(kills_l25))

## Teia no 30 (design/gdd/progression.md): a média das builds dá ~x1,4 de ATK e ~x1,2 de HP (Balance.WEB_GAIN_*);
## cada build fica com ATK×HP em WEB_GAIN_BUILD (tanque troca ATK por HP, curandeiro tem pouco ATK).
## Fronteira da teia (Ato II, 31-45): só nós de nível > 30 (a teia do 30 não muda), cada setor de build com uma pedra-angular
## (duas opções que se excluem: ofensiva e segura) e um Ápice no 45, o Geral com a sua pedra-angular; stats só de STAT_KEYS;
## comprar uma pedra-angular tranca a outra; o bot pega a do papel dele e nunca passa do nível.
func _check_web_frontier(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var nodes: Dictionary = gd.trees[cid]["nodes"]
		var late: Array = []
		var keys := {}                     # ramo -> pedras-angulares
		var apex := {}
		var elos := 0
		var bad_keys: Array = []
		for nid in nodes:
			var n: Dictionary = nodes[nid]
			if n["kind"] == "pick" or int(n["level"]) <= 30:
				continue
			late.append(nid)
			for k in n["stats"]:
				if not (str(k).begins_with("attr_") or k in Stats.STAT_KEYS):
					bad_keys.append("%s:%s" % [nid, k])
			if n.has("keystone"):
				if not keys.has(n["branch"]):
					keys[n["branch"]] = []
				keys[n["branch"]].append(n)
			if n.get("apex", false):
				apex[n["branch"]] = n
			if str(n["name"]).begins_with("Elo:"):
				elos += 1
		check(late.size() >= 120, "%s: Fronteira com 120+ nós acima do 30 (%d)" % [cid, late.size()])
		check(bad_keys.is_empty(), "%s: Fronteira só com stats de Stats.STAT_KEYS %s" % [cid, bad_keys.slice(0, 4)])
		check(elos >= 2, "%s: notáveis de elo entre builds vizinhas (%d)" % [cid, elos])
		for b in [{"id": ""}] + cls.builds:
			var ks: Array = keys.get(b["id"], [])
			var ok: bool = ks.size() == 2 and ks[0]["excludes"] == [ks[1]["id"]] and ks[1]["excludes"] == [ks[0]["id"]] 				and ks.all(func(k): return int(k["level"]) == Balance.WEB_KEYSTONE_LEVEL) and ks.map(func(k): return k["keystone"]).has("atk") and ks.map(func(k): return k["keystone"]).has("def")
			check(ok, "%s/%s: uma pedra-angular com 2 opções que se excluem (ofensiva e segura) no %d" % [cid, b["id"] if b["id"] != "" else "geral", Balance.WEB_KEYSTONE_LEVEL])
			if b["id"] != "":
				check(apex.has(b["id"]) and int(apex[b["id"]]["level"]) == Balance.WEB_APEX_LEVEL, "%s/%s: Ápice da build no %d" % [cid, b["id"], Balance.WEB_APEX_LEVEL])
	# bot: no 30 nada da Fronteira; no 45 pega a pedra-angular do papel e a outra fica trancada
	var cls2: ClassDef = gd.classes["paladin"]
	for b in cls2.builds:
		for lv in [30, Balance.WEB_APEX_LEVEL]:
			var e: SimEntity = sim.spawn_bot(cls2, "Fr", "city_aldara", Vector3(0, 0, 8), lv)
			e.brain = null
			e.build_id = b["id"]
			sim._skill_bot(e)
			var nodes: Dictionary = gd.trees["paladin"]["nodes"]
			var over := e.tree.keys().filter(func(x): return nodes.has(x) and nodes[x]["kind"] != "pick" and int(nodes[x]["level"]) > lv)
			check(over.is_empty(), "bot paladin/%s no %d: nada acima do nível %s" % [b["id"], lv, over.slice(0, 3)])
			var mine: Array = e.tree.keys().filter(func(x): return nodes.has(x) and nodes[x].has("keystone"))
			if lv <= 30:
				check(mine.is_empty() and not e.tree.keys().any(func(x): return nodes.has(x) and nodes[x]["kind"] != "pick" and int(nodes[x]["level"]) > 30),
					"bot paladin/%s no 30: nada da Fronteira" % b["id"])
			else:
				var lean := "def" if b["role"] in ["tank", "healer"] else "atk"
				check(not mine.is_empty() and mine.all(func(x): return nodes[x]["keystone"] == lean), "bot paladin/%s no %d: pedra-angular do papel (%s: %s)" % [b["id"], lv, lean, mine])
				for x in mine:
					e.mastery_points = 5
					var other: String = nodes[x]["excludes"][0]
					check(sim.tree_block_reason(e, other).begins_with("exclui") and not sim.tree_allocate(e, other), "paladin: %s tranca %s" % [nodes[x]["name"], nodes[other]["name"]])
			sim.despawn(e)

func _check_web_strength(gd, sim) -> void:
	if not sim.maps.has("city_aldara"):
		sim.load_map(gd.maps["city_aldara"])
	var sum_atk := 0.0
	var sum_hp := 0.0
	var n := 0
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		for b in cls.builds:
			var r := WebGain.measure(sim, cls, b["id"], Balance.WEB_GAIN_LEVEL)
			var both: float = r["atk"] * r["hp"]
			sum_atk += r["atk"]
			sum_hp += r["hp"]
			n += 1
			check(both >= Balance.WEB_GAIN_BUILD[0] and both <= Balance.WEB_GAIN_BUILD[1],
				"teia %s/%s no 30: ATK x%.2f × HP x%.2f = x%.2f (faixa %s)" % [cid, b["id"], r["atk"], r["hp"], both, Balance.WEB_GAIN_BUILD])
	var atk := sum_atk / maxf(1, n)
	var hp := sum_hp / maxf(1, n)
	check(atk >= Balance.WEB_GAIN_ATK[0] and atk <= Balance.WEB_GAIN_ATK[1], "teia no 30, média de %d builds: ATK x%.2f (alvo %s)" % [n, atk, Balance.WEB_GAIN_ATK])
	check(hp >= Balance.WEB_GAIN_HP[0] and hp <= Balance.WEB_GAIN_HP[1], "teia no 30, média de %d builds: HP x%.2f (alvo %s)" % [n, hp, Balance.WEB_GAIN_HP])
	# Ato II: a Fronteira (níveis 31-45) nas faixas próprias do 40 e do 45 (Balance.WEB_GAIN_LATE), sem ponto sobrando
	for lv in Balance.WEB_GAIN_LATE:
		var band: Dictionary = Balance.WEB_GAIN_LATE[lv]
		var sa := 0.0
		var sh := 0.0
		var m := 0
		var left: Array = []
		for cid in gd.classes:
			var cls: ClassDef = gd.classes[cid]
			for b in cls.builds:
				var r := WebGain.measure(sim, cls, b["id"], lv)
				var both: float = r["atk"] * r["hp"]
				sa += r["atk"]
				sh += r["hp"]
				m += 1
				if int(r["left"]) > 0:
					left.append("%s/%s=%d" % [cid, b["id"], int(r["left"])])
				check(both >= band["build"][0] and both <= band["build"][1],
					"teia %s/%s no %d: ATK x%.2f × HP x%.2f = x%.2f (faixa %s)" % [cid, b["id"], lv, r["atk"], r["hp"], both, band["build"]])
		check(left.is_empty(), "teia no %d: bots gastam todos os pontos (sobra: %s)" % [lv, left])
		check(sa / m >= band["atk"][0] and sa / m <= band["atk"][1], "teia no %d, média: ATK x%.2f (alvo %s)" % [lv, sa / m, band["atk"]])
		check(sh / m >= band["hp"][0] and sh / m <= band["hp"][1], "teia no %d, média: HP x%.2f (alvo %s)" % [lv, sh / m, band["hp"]])

## Colheita: pontos em chão livre, F colhe em ~1 s, andar cancela, volta depois; COLLECT conta.
func _check_gather(gd, sim) -> void:
	for mid in ["city_aldara", "field_forest", "field_ruins", "elf_city"]:
		var list: Array = sim.maps[mid].get("gather", [])
		check(list.size() >= 15, "%s: pontos de colheita (%d)" % [mid, list.size()])
		var bad := list.filter(func(g): return not sim.is_walkable(g["pos"], gd.maps[mid], 0.5))
		check(bad.is_empty(), "%s: pontos em chão livre (%d fora)" % [mid, bad.size()])
		for g in list:
			check(gd.items.has(g["item"]) and UiKit.item_texture(gd.items[g["item"]]) != null, "%s: item %s com ícone" % [mid, g["item"]])
	var m: Dictionary = sim.maps["city_aldara"]
	var node: Dictionary = m["gather"][0]
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Colhe", "city_aldara", node["pos"] + Vector3(0.8, 0, 0), 5)
	e.brain = null
	var before := int(e.inventory.get(node["item"], 0))
	sim._interact(e, m)
	check(e.gather_left > 0.0, "F perto do ponto começa a colher")
	var idle := InputCommand.new()
	for i in range(int(Balance.GATHER_TIME * 60) + 5):
		sim._update_gather(e, idle, idle, 1.0 / 60.0)
	check(int(e.inventory.get(node["item"], 0)) > before, "colheu %s" % node["item"])
	check(float(node["ready_at"]) > sim.time and sim.nearest_gather(e).get("pos", Vector3.INF) != node["pos"], "ponto colhido some até voltar")
	# andar cancela
	var node2: Dictionary = m["gather"][1]
	e.position = node2["pos"] + Vector3(0.6, 0, 0)
	sim._interact(e, m)
	var walk := InputCommand.new()
	walk.move = Vector2(1, 0)
	sim._update_gather(e, walk, walk, 0.1)
	check(e.gather_left == 0.0 and float(node2["ready_at"]) <= sim.time, "andar cancela a colheita")
	node["ready_at"] = 0.0
	sim.despawn(e)
	# animação: o kit gera os clipes de colher; minério usa a picareta
	var kit := KitModel.create("male", Color.WHITE, 0.02, "paladin")
	if kit:
		check(kit.anim.has_animation("gather_herb") and kit.anim.has_animation("gather_mine"), "kit tem os clipes de colher (erva e picareta)")
		check(GatherPose.clip_for("ore") == "gather_mine" and GatherPose.clip_for("star") == "gather_mine" and GatherPose.clip_for("herb") == "gather_herb"
			and GatherPose.clip_for("shell") == "gather_herb", "minério usa picareta; erva, concha e cogumelo, agachar e puxar")
		kit.free()

## Entregas, cadeias, colheita nas quests; sem chefe repetido; caçada paga por quem está na zona do monstro.
func _check_quest_variety(gd, sim) -> void:
	var kinds := {}
	var boss_quests := {}
	var dup: Array = []
	var kh_ids := {}
	for kd in QuestsCatalog.act2_kharzun():
		kh_ids[kd["id"]] = true
	for qid in gd.quests:
		var q: QuestDef = gd.quests[qid]
		if not q.give_items.is_empty():
			kinds["entrega"] = int(kinds.get("entrega", 0)) + 1
			check(q.type == QuestDef.Type.COLLECT and q.give_items.has(q.target_id) and q.turnin() != q.giver_npc, "%s: entrega leva o item a outro NPC" % qid)
		if q.type == QuestDef.Type.COLLECT and q.give_items.is_empty():
			for mid in MapsCatalog.GATHER:
				for g in MapsCatalog.GATHER[mid]:
					if g[0] == q.target_id:
						kinds["colheita"] = int(kinds.get("colheita", 0)) + 1
		if qid in MapsCatalog.Q_STEPPE_FORTS and MapsCatalog.FORT_DEFS[str(qid).replace("hx_", "")]["boss"] != q.target_id:
			continue          # chefe dos acampamentos ainda é substituto (MapsCatalog.STAND_INS): os três caem no mesmo id
		if MapsCatalog.STAND_INS.values().has(q.target_id) and kh_ids.has(qid):
			continue          # chefes de Kharzun ainda são substitutos de chefes da Horda (STAND_INS): o id cai no mesmo
		if q.type == QuestDef.Type.KILL and gd.monsters.has(q.target_id) and gd.monsters[q.target_id].is_boss and not q.repeatable and not str(qid).begins_with("hx_asc45_"):
			if boss_quests.has(q.target_id):
				dup.append(q.target_id)
			boss_quests[q.target_id] = true
	check(int(kinds.get("entrega", 0)) >= 5, "quests de entrega (%d)" % int(kinds.get("entrega", 0)))
	check(int(kinds.get("colheita", 0)) >= 6, "quests de colheita (%d)" % int(kinds.get("colheita", 0)))
	check(dup.is_empty(), "nenhum chefe com duas quests de história (%s)" % str(dup))
	check(boss_quests.has("crab_king") and boss_quests.has("boar_brute"), "Caranguejo-Rei e Presa-Rachada têm quest")
	# cadeias longas: o Lago (6), os bandidos (6), a erudita (4+)
	for pair in [["l6_rei", 6], ["b6_limpeza", 6], ["r4_chave", 4]]:
		var depth := 0
		var cur: String = pair[0]
		while cur != "" and gd.quests.has(cur):
			depth += 1
			cur = gd.quests[cur].prereq_quest
		check(depth >= int(pair[1]), "cadeia até %s tem %d passos" % [pair[0], depth])
	# todo NPC de quest existe em algum mapa
	var npcs := {}
	for mid in gd.maps:
		for n in gd.maps[mid].npcs:
			npcs[n["id"]] = true
	var missing: Array = []
	for qid in gd.quests:
		var q: QuestDef = gd.quests[qid]
		for who in [q.giver_npc, q.turnin()]:
			if not npcs.has(who):
				missing.append("%s:%s" % [qid, who])
	check(missing.is_empty(), "NPCs das quests existem (%s)" % str(missing.slice(0, 4)))
	# entrega: aceitar dá o pacote, desistir tira
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Entrega", "city_aldara", Vector3(0, 0, 6), 5)
	e.brain = null
	var dq: QuestDef = gd.quests["d1_carta"]
	QuestSystem.accept(e, dq)
	check(e.has_item("sealed_letter") and QuestSystem.is_complete(e, dq), "aceitar a entrega põe a carta na bolsa")
	QuestSystem.abandon(e, dq)
	check(not e.has_item("sealed_letter"), "desistir tira a carta")
	sim.despawn(e)
	# caçada: quem paga é da zona do monstro
	var zone_giver := {"slime": "board", "crab": "board", "spider": "stone_druid", "skeleton": "dawn_board", "zombie": "board"}
	for mon in zone_giver:
		if gd.quests.has("h_" + mon):
			check(gd.quests["h_" + mon].giver_npc == zone_giver[mon], "caçada de %s paga por %s" % [mon, zone_giver[mon]])

## Polimento dos monstros: chefes com loot próprio, bando vem junto, nome pela diferença de nível.
func _check_monster_polish(gd, sim) -> void:
	var tables := {}
	for mid in gd.monsters:
		var md: MonsterDef = gd.monsters[mid]
		if md.is_boss and md.loot_table != "" and md.xp > 0:
			check(not tables.has(md.loot_table), "%s: tabela de loot própria (%s já usada por %s)" % [mid, md.loot_table, tables.get(md.loot_table, "")])
			tables[md.loot_table] = mid
			check(gd.loot_tables.has(md.loot_table), "%s: tabela %s existe" % [mid, md.loot_table])
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-60, 0, -40)
	var a: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at)
	var b: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at + Vector3(3, 0, 0))
	var c: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at + Vector3(14, 0, 0))
	var other: SimEntity = sim.spawn_monster(gd.monsters["boar"], "city_aldara", at + Vector3(0, 0, 2))
	for x in [a, b, c, other]:
		x.brain = null
		x.aggro_target = -1
	var hunter: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Puxa", "city_aldara", at + Vector3(0, 0, -8), 10)
	hunter.brain = null
	sim._retarget(a, hunter)
	check(a.aggro_target == hunter.id and b.aggro_target == hunter.id, "bando: o lobo do lado vem junto")
	check(c.aggro_target < 0 and other.aggro_target < 0, "longe ou de outra espécie: fica")
	for x in [a, b, c, other, hunter]:
		sim.despawn(x)
	check(EntityView.level_color(20, 10).r > 0.9 and EntityView.level_color(20, 10).g < 0.4, "monstro 10 níveis acima: nome vermelho")
	check(EntityView.level_color(3, 12).is_equal_approx(Color(0.62, 0.62, 0.62)), "monstro muito abaixo: nome cinza")

## Dungeons do Vale (maiores): bandos também nos corredores, mas a chegada fica livre.
func _check_dungeon_density(gd, sim) -> void:
	for pair in [["dg_gruta", 6, 40], ["dg_catacumbas", 12, 60], ["dg_ninho", 6, 40], ["dg_cripta", 6, 36], ["dg_pedreira", 12, 60]]:
		var def: MapDef = gd.maps[pair[0]]
		var mobs := 0
		for sp in def.spawners:
			mobs += int(sp["count"])
			check((sp["pos"] as Vector3).distance_to(def.spawn_point) > 14.0, "%s: %s longe da chegada" % [pair[0], sp["monster_id"]])
			check(sim.is_walkable(sp["pos"], def, 0.4) or float(sp["radius"]) >= 3.0, "%s: %s em chão livre" % [pair[0], sp["monster_id"]])
		check(def.spawners.size() >= int(pair[1]) and mobs >= int(pair[2]), "%s: %d pontos de caça, %d monstros" % [pair[0], def.spawners.size(), mobs])

## Loja: não vende o que não tem preço (moeda lendária, pacote de entrega); "vender materiais" poupa o que a quest pede.
func _check_shop_rules(gd, sim) -> void:
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Loja", "city_aldara", Vector3(0, 0, 6), 5)
	e.brain = null
	e.add_item("legend_coin", 1)
	e.add_item("fish_basket", 1)
	e.add_item("slime_gel", 4)
	e.add_item("boar_tusk", 3)
	check(not CraftSystem.sell(e, "legend_coin", 1) and not CraftSystem.sell(e, "fish_basket", 1), "moeda lendária e pacote de entrega não se vendem")
	e.quests_active["q05_boars"] = 0          # quest ativa que pede presas de javali
	var junk: Array = load("res://game/ui/npc_ui.gd").junk_of(e)
	check(junk.has("slime_gel") and not junk.has("boar_tusk") and not junk.has("legend_coin"), "vender materiais poupa o que a quest ativa pede (%s)" % str(junk))
	var g0 := e.gold
	check(CraftSystem.sell(e, "slime_gel", 4) and e.gold == g0 + int(gd.items["slime_gel"].price * 0.5) * 4, "vende a pilha pela metade do preço")
	sim.despawn(e)

## Tratadora de montarias (npc_ui, Kharzun WP10): um botão por tipo; travado sem a missão; em uso desligado; clique troca na sim.
func _check_mount_keeper_ui(gd, sim) -> void:
	var ui: GDScript = load("res://game/ui/npc_ui.gd")
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Montaria", "city_aldara", Vector3(0, 0, 6), 45)
	e.brain = null
	var opts: Array = ui.mount_options(sim, e)
	check(opts.size() == Balance.MOUNT_KINDS.size() and opts.all(func(o): return o["text"] != "" and o["tip"] != ""), "tratador: um botão com texto e dica por montaria (%d)" % opts.size())
	var h0: Dictionary = _mount_opt(opts, "horse")
	var w0: Dictionary = _mount_opt(opts, "dire_wolf")
	check(h0.get("disabled", false) and str(h0.get("text", "")).contains("Em uso"), "tratador: cavalo em uso fica desligado (%s)" % h0.get("text", ""))
	check(w0.get("disabled", false) and str(w0.get("text", "")).contains("travado") and str(w0.get("tip", "")).contains(gd.quests["hx_ov_hatch"].title), "tratador: lobo travado sem hx_ov_hatch, dica diz a missão (%s)" % w0.get("tip", ""))
	check(not ui.pick_mount(sim, e, "dire_wolf") and e.mount_kind == "horse", "tratador: clicar no lobo travado não troca")
	e.quests_completed.append("hx_ov_hatch")
	var w1: Dictionary = _mount_opt(ui.mount_options(sim, e), "dire_wolf")
	check(not w1.get("disabled", true) and str(w1.get("text", "")).contains("Trocar para"), "tratador: com hx_ov_hatch o lobo libera (%s)" % w1.get("text", ""))
	e.mounted = true
	check(ui.pick_mount(sim, e, "dire_wolf") and e.mount_kind == "dire_wolf" and not e.mounted, "tratador: clicar troca para o lobo e desce do cavalo")
	var opts2: Array = ui.mount_options(sim, e)
	check(_mount_opt(opts2, "dire_wolf").get("disabled", false) and not _mount_opt(opts2, "horse").get("disabled", true), "tratador: depois da troca o lobo fica em uso e o cavalo volta a ser clicável")
	check(ui.pick_mount(sim, e, "horse") and e.mount_kind == "horse", "tratador: troca de volta para o cavalo")
	sim.despawn(e)

func _mount_opt(opts: Array, kind: String) -> Dictionary:
	for o in opts:
		if o["kind"] == kind:
			return o
	return {}

## Material que dá para conseguir: cai de alguma tabela de saque ou se colhe em algum mapa.
func _dropped_somewhere(gd, iid: String) -> bool:
	for lid in gd.loot_tables:
		for en in gd.loot_tables[lid].entries:
			if str(en.get("item", "")) == iid:
				return true
	for mid in MapsCatalog.GATHER:
		for g in MapsCatalog.GATHER[mid]:
			if str(g[0]) == iid:
				return true
	return false

## Forja nova: joias e capas por tier e tema, bolsas ampliadas; aprimoramento +1..+9; bolsa com limite; colher para em combate.
func _check_forge(gd, sim) -> void:
	var n_jewel := 0
	var n_tiers: int = Balance.COMMON_TIER_LEVELS.size()
	check(RecipesCatalog.JEWEL_MATS.size() == n_tiers and RecipesCatalog.CAPE_MATS.size() == n_tiers
		and RecipesCatalog.THEME_MAT.values().all(func(a): return a.size() == n_tiers), "materiais de joia/capa para os %d tiers" % n_tiers)
	for tier in range(n_tiers):
		for piece in GearCatalog.THEME_PIECES:
			for theme in GearCatalog.THEMES:
				var rid := "rec_%s_%s_t%d" % [piece, theme, tier]
				check(gd.recipes.has(rid), "receita %s" % rid)
				if gd.recipes.has(rid):
					n_jewel += 1
					var rec: RecipeDef = gd.recipes[rid]
					check(rec.station == ("alchemy" if piece == "cape" else "smith"), "%s: estação certa" % rid)
					check(rec.level_req == int(Balance.COMMON_TIER_LEVELS[tier]) and gd.items.has(rec.result_item)
						and gd.items[rec.result_item].level_req == rec.level_req, "%s: nível do tier e item existe" % rid)
					for mat in rec.ingredients:
						check(gd.items.has(mat) and _dropped_somewhere(gd, mat), "%s: material %s existe e cai/colhe-se" % [rid, mat])
	check(n_jewel == 9 * n_tiers, "%d receitas de anel/amuleto/capa (%d)" % [9 * n_tiers, n_jewel])
	for i in range(Balance.BAG_UPGRADES):
		check(gd.recipes.has("rec_bag_t%d" % i) and UiKit.item_texture(gd.items["bag_t%d" % i]) != null, "Bolsa Ampliada %d: receita e ícone" % (i + 1))
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Forja", "city_aldara", Vector3(0, 0, 6), 25)
	e.brain = null
	# drop: equipamento comum do tier que a classe usa (sem joia/capa)
	for tier in range(4):
		var pool: Array = sim.gear_pool(tier)
		check(pool.size() > 0 and not pool.any(func(it): return it.slot in [ItemDef.Slot.AMULET, ItemDef.Slot.RING, ItemDef.Slot.CAPE]), "tier %d: drop de arma/armadura (%d itens)" % [tier, pool.size()])
		check(pool.filter(func(it): return sim.fits_class(e, it)).size() > 0, "tier %d: tem drop para paladino" % tier)
	# aprimoramento
	var sw: ItemDef = e.equipment[ItemDef.Slot.WEAPON]
	var body: ItemDef = null
	for sl in e.equipment:
		if e.equipment[sl] and e.equipment[sl].def > 0.0 and sl != ItemDef.Slot.OFFHAND:
			body = e.equipment[sl]
	var atk0: float = e.stats.patk
	var def0: float = e.stats.pdef
	e.gold = 1_000_000
	e.add_item("iron_ore", 400)
	e.add_item("star_ore", 400)
	for i in range(Balance.PLUS_MAX):
		check(sim.enhance(e, e.equipment[ItemDef.Slot.WEAPON].id, ItemDef.Slot.WEAPON) != null, "arma vestida sobe para +%d" % (i + 1))
	var w9: ItemDef = e.equipment[ItemDef.Slot.WEAPON]
	check(w9.plus == Balance.PLUS_MAX and w9.base_id == sw.id and w9.id == "%s+%d" % [sw.id, Balance.PLUS_MAX], "a arma vestida é a versão +%d" % Balance.PLUS_MAX)
	check(sim.enhance(e, w9.id, ItemDef.Slot.WEAPON) == null, "não passa de +%d" % Balance.PLUS_MAX)
	# por cópia: duas espadas iguais na bolsa, aprimora uma — a outra continua +0
	e.add_item(sw.id, 2)
	var v1: ItemDef = sim.enhance(e, sw.id)
	check(v1 != null and e.has_item(sw.id, 1) and not e.has_item(sw.id, 2) and e.has_item(v1.id, 1), "aprimorar uma cópia não muda as outras (%s x1 + %s x1)" % [sw.id, v1.id if v1 else "?"])
	check(GameData.resolve_item(sw.id + "+4") and GameData.items[sw.id + "+4"].plus == 4 and not GameData.resolve_item(sw.id + "+12"), "id +N do save volta a existir (até +%d)" % Balance.PLUS_MAX)
	check(UiKit.item_texture(v1) != null, "versão aprimorada usa a arte da base")
	# save: versão +N na bolsa e vestida volta igual; save antigo (por tipo) vira uma cópia +N
	var sv: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Save", "city_aldara", Vector3(0, 0, 8), 10)
	sv.brain = null
	SaveSystem.apply_to(sv, {"level": 10, "inventory": {sw.id + "+3": 1, sw.id: 2}, "equipment": {str(ItemDef.Slot.WEAPON): sw.id + "+7"}})
	check(sv.has_item(sw.id + "+3") and sv.equipment[ItemDef.Slot.WEAPON].plus == 7, "save guarda cada cópia com o seu +N")
	SaveSystem.apply_to(sv, {"level": 10, "inventory": {sw.id: 2}, "equipment": {}, "plus": {sw.id: 4}})
	check(sv.has_item(sw.id, 1) and sv.has_item(sw.id + "+4", 1), "save antigo: uma cópia vira +4, a outra continua +0")
	sim.despawn(sv)
	check(e.stats.patk > atk0 * 1.15, "arma +9 bate mais (%.0f -> %.0f)" % [atk0, e.stats.patk])
	if body:
		var bslot := -1
		for sl in e.equipment:
			if e.equipment[sl] == body:
				bslot = sl
		for i in range(5):
			sim.enhance(e, e.equipment[bslot].id, bslot)
		check(e.stats.pdef > def0 and e.equipment[bslot].plus == 5, "armadura +5 protege mais (%.0f -> %.0f)" % [def0, e.stats.pdef])
	check(int(sim.enhance_cost(sw, 0)["count"]) < int(sim.enhance_cost(sw, 8)["count"]) + 1 and sim.enhance_cost(sw, 8)["item"] == "star_ore"
		and sim.enhance_cost(sw, 0)["item"] == "iron_ore", "custo: ferro até +5, estelar do +6 em diante")
	check(int(sim.enhance_cost(sw, 8)["gold"]) > int(sim.enhance_cost(sw, 0)["gold"]) * 10, "ouro cresce a cada nível")
	check(Stats.plus_attr(4, 9) >= 2 and Stats.plus_attr(0, 9) == 0, "atributo da peça cresce com o aprimoramento")
	# bolsa com limite + ampliação na ordem
	var cap0 := e.bag_capacity()
	check(cap0 == Balance.BAG_BASE, "bolsa começa com %d espaços" % Balance.BAG_BASE)
	e.add_item("bag_t1", 1)
	check(not sim.use_bag_upgrade(e, "bag_t1"), "Bolsa II exige a I antes")
	e.add_item("bag_t0", 1)
	check(sim.use_bag_upgrade(e, "bag_t0") and e.bag_capacity() == cap0 + Balance.BAG_STEP, "Bolsa I: +%d espaços" % Balance.BAG_STEP)
	check(sim.use_bag_upgrade(e, "bag_t1") and e.bag_capacity() == cap0 + 2 * Balance.BAG_STEP, "Bolsa II depois da I")
	var fill := 0
	for iid in gd.items:
		if e.inventory.size() >= e.bag_capacity():
			break
		if not e.inventory.has(iid):
			e.add_item(iid, 1)
			fill += 1
	var outside := ""
	for iid in gd.items:
		if not e.inventory.has(iid):
			outside = iid
			break
	check(e.bag_full_for(outside) and not e.bag_full_for("iron_ore"), "bolsa cheia não aceita item novo (o que já tem empilha)")
	# colher: não começa e para em combate
	var m: Dictionary = sim.maps["city_aldara"]
	var node: Dictionary = m["gather"][2]
	node["ready_at"] = 0.0
	e.inventory.clear()
	e.position = node["pos"] + Vector3(0.6, 0, 0)
	e.combat_timer = 3.0
	sim._interact(e, m)
	check(e.gather_left == 0.0, "em combate não começa a colher")
	e.combat_timer = 0.0
	sim._interact(e, m)
	check(e.gather_left > 0.0, "fora de combate começa a colher")
	var idle := InputCommand.new()
	e.combat_timer = 3.0                     # levou um golpe (até absorvido pelo escudo marca combate)
	sim._update_gather(e, idle, idle, 0.1)
	check(e.gather_left == 0.0, "levar dano para a colheita")
	sim.despawn(e)

func _check_interiors(gd, sim) -> void:
	var in_aldara: Array = MapsCatalog.INTERIORS.keys().filter(func(i): return MapsCatalog.interior_map(i) == "city_aldara")
	check(in_aldara.size() >= 4 and in_aldara.size() <= 6, "Aldara: 4-6 casas que abrem (%d)" % in_aldara.size())
	check(MapsCatalog.interior_map("in_tavern") == "city_aldara" and MapsCatalog.interior_map("in_port_tavern") == "city_port",
		"casas que abrem: sem `map` é Aldara; a taverna do porto fica em city_port")
	var saved = sim.player
	for iid in MapsCatalog.INTERIORS:
		var host := MapsCatalog.interior_map(iid)
		var town: MapDef = gd.maps[host]
		if not sim.maps.has(host):
			sim.load_map(town)
		var m: Dictionary = sim.maps[host]
		var idef: MapDef = gd.maps.get(iid)
		check(idef != null and idef.interior and idef.is_town and idef.parent_map == host, "%s: mapa de interior de %s" % [iid, host])
		if idef == null:
			continue
		check(gd.town_map_id() == "city_aldara", "a cidade de respawn continua sendo Aldara")
		var door: Dictionary = {}
		for pt in town.portals:
			if pt["id"] == "door_" + iid:
				door = pt
		check(not door.is_empty() and door.get("player_only", false), "%s: porta em %s (só jogador)" % [iid, host])
		if door.is_empty():
			continue
		var dpos: Vector3 = door["pos"]
		check(sim.is_walkable(dpos, town, 0.45), "%s: porta em chão livre" % iid)
		check(sim.is_walkable(door["target_pos"], idef, 0.45), "%s: chegada dentro da casa é andável" % iid)
		var exit: Dictionary = idef.portals[0] if idef.portals.size() > 0 else {}
		check(not exit.is_empty() and exit["target_map"] == host and (exit["target_pos"] as Vector3).distance_to(dpos) < 2.6
			and (exit["target_pos"] as Vector3).distance_to(dpos) > float(door["radius"]) + 0.3, "%s: saída volta para a frente da porta (sem cair nela de novo)" % iid)
		check(not exit.is_empty() and (door["target_pos"] as Vector3).distance_to(exit["pos"]) > float(exit["radius"]) + 0.5, "%s: entrar não cai na saída" % iid)
		check(idef.npcs.size() >= 2, "%s: tem gente dentro (%d)" % [iid, idef.npcs.size()])
		for n in idef.npcs:
			check(sim.is_walkable(n["pos"], idef, 0.4), "%s: %s em chão livre" % [iid, n["id"]])
		# entrar: o jogador pisa na porta e vai para dentro; um bot no mesmo lugar não entra
		var bot: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Porta", host, dpos, 5)
		bot.brain = null
		sim.player = null
		sim._check_portals(bot, m)
		check(sim._pending_map_changes.is_empty(), "%s: bot passa pela porta sem entrar" % iid)
		sim.player = bot
		sim._check_portals(bot, m)
		sim._process_map_changes()
		check(bot.map_id == iid, "%s: jogador entra pela porta" % iid)
		if bot.map_id == iid:
			bot.position = exit["pos"]
			sim._check_portals(bot, sim.maps[iid])
			sim._process_map_changes()
			check(bot.map_id == host and bot.position.distance_to(dpos) < 2.6, "%s: sai de volta na frente da casa" % iid)
		sim.player = saved
		sim.despawn(bot)
	sim.player = saved

func _check_layout_conflicts(gd, sim) -> void:
	for mid in ["city_aldara", "field_forest", "field_ruins", "elf_city", "field_coast", "city_port", "field_steppe", "field_kharzun"]:
		var z: Dictionary = MapsCatalog.load_zone(mid)
		var roads: Array = z["roads"].filter(func(r): return r["kind"] in ["road", "trail"])
		var bad: Array = []
		for o in z["obstacles"]:
			if not o.get("solid", true) or o.get("kind", "") in ["wall", "cliff", "water"]:
				continue
			var p := Vector2(o["pos"].x, o["pos"].z)
			var half: float = maxf(o["size"].x, o["size"].z) * 0.5 * (1.0 if o.get("kind", "") == "fence" else 0.85)
			for r in roads:
				if _poly_dist2(p, r["pts"]) < float(r["w"]) * 0.5 + half - 0.25:
					bad.append("%s@%.0f,%.0f" % [o.get("kind", "?"), p.x, p.y])
					break
		check(bad.is_empty() or mid != "city_aldara", "%s: nada sólido nas estradas (%d: %s)" % [mid, bad.size(), str(bad.slice(0, 4))])
		var wet: Array = []
		for r in roads:
			for w in z["water"]:
				if w["kind"] == "lake":
					for q in r["pts"]:
						if q.distance_to(w["pos"]) < float(w["r"]):
							wet.append(r["kind"])
							break
		check(wet.is_empty(), "%s: estrada/trilha não entra no lago (%s)" % [mid, str(wet)])
		if mid != "city_aldara":
			continue
		var crossed: Array = []
		for sp in z["spawners"]:
			if float(sp["radius"]) <= 2.0:
				continue
			for r in roads:
				if r["kind"] == "road" and _poly_dist2(Vector2(sp["pos"].x, sp["pos"].z), r["pts"]) < float(sp["radius"]) * 0.6:
					crossed.append(sp["monster_id"])
					break
		check(crossed.is_empty(), "city_aldara: spawner fora da estrada (%s)" % str(crossed))
	# a praia dos caranguejos e o rei que sai do lago
	var md: MapDef = gd.maps["city_aldara"]
	var crabs: Array = md.spawners.filter(func(s): return s["monster_id"] in ["crab", "crab_king"])
	check(crabs.size() >= 3, "Vale: praia dos caranguejos com o Rei (%d spawners)" % crabs.size())
	var m: Dictionary = sim.maps["city_aldara"]
	for s in crabs:
		check(not sim._point_in_solid(s["pos"], m), "%s nasce em chão livre" % s["monster_id"])
	var king: Array = crabs.filter(func(s): return s["monster_id"] == "crab_king")
	check(king.size() == 1 and king[0].has("emerge"), "Caranguejo-Rei sai do lago (emerge)")
	check(gd.monsters["crab_king"].phases.size() >= 2 and gd.monsters["crab_small"].xp == 0, "Caranguejo-Rei: fases e filhotes sem XP")

func _poly_dist2(p: Vector2, pts: Array) -> float:
	var best := INF
	for i in range(pts.size() - 1):
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[i + 1]
		var ab := b - a
		var t := clampf((p - a).dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
		best = minf(best, p.distance_to(a + ab * t))
	return best

## Regras de layout de toda zona do Blender: vale fechado, POIs a 40-120 m do hub, tudo alcançável.
func _check_zone_layout(gd, sim, md: MapDef) -> void:
	var mid := md.id
	check(md.model == "map_" + mid and FileAccess.file_exists("res://assets/models/map_%s.glb" % mid), "%s: GLB da zona existe" % mid)
	check(md.roads.size() >= 5 and md.water.size() >= 1, "%s: estradas e água" % mid)
	check(md.has_hunting() and md.spawners.size() >= 7, "%s: spawners" % mid)
	var cliffs := 0
	for ob in md.obstacles:
		if ob.get("kind", "") == "cliff":
			cliffs += 1
	check(cliffs >= 60, "%s: borda de penhascos fecha o vale (%d)" % [mid, cliffs])
	# raios do hub pra fora: todos batem na borda antes do fim do mapa (menos onde há portal)
	var open_rays := 0
	for i in range(24):
		var dir := Vector3(cos(TAU * i / 24.0), 0, sin(TAU * i / 24.0))
		var near_portal := false
		for pt in md.portals:
			if Vector3(pt["pos"].x, 0, pt["pos"].z).normalized().dot(dir) > 0.985:
				near_portal = true
		var hit := false
		var r := 60.0
		while r < md.size.x * 0.5 - 1.0:
			if not sim.is_walkable(dir * r, md, 0.45) and r > 95.0:
				hit = true
				break
			r += 0.5
		if not hit and not near_portal:
			open_rays += 1
	check(open_rays == 0, "%s: borda fecha o vale (%d raios escapam)" % [mid, open_rays])
	check(sim.is_walkable(md.spawn_point, md, 0.45), "%s: ponto de chegada andável" % mid)
	for sp in md.spawners:
		var d: float = Vector2(sp["pos"].x, sp["pos"].z).length()
		var hostile_hub: bool = mid in HOSTILE_HUBS and d < gd.maps[mid].town_radius         # cidade inimiga: a guarnição mora no hub
		check((d > 40.0 or hostile_hub) and d < 120.0 * (1.2 if mid == "city_aldara" else 1.0), "%s: spawner %s a %.0f m do hub" % [mid, sp["monster_id"], d])
		check(sim.is_walkable(sim.random_walkable(md, sp["pos"], float(sp["radius"])), md), "%s: spawner %s andável" % [mid, sp["monster_id"]])
	for n in md.npcs:
		if n.get("role", "") == "crystal":          # o cristal é a própria coluna sólida: confere a frente dele
			check(sim.is_walkable(n["pos"] + (md.town_center - n["pos"]).normalized() * Balance.CRYSTAL_ARRIVE, md, 0.5), "%s: frente do cristal livre" % mid)
			continue
		check(float(n.get("perch", 0.0)) > 0.0 or sim.is_walkable(n["pos"], md, 0.3), "%s: NPC %s em chão livre" % [mid, n["id"]])
	for pt in md.portals:
		check(sim.is_walkable(pt["pos"], md, 0.45), "%s: portal %s alcançável" % [mid, pt["id"]])
	for other in gd.maps:
		for pt in gd.maps[other].portals:
			if pt["target_map"] == mid:
				var arrive: Vector3 = pt["target_pos"]
				check(sim.is_walkable(arrive, md, 0.45), "%s: chegada de %s andável" % [mid, other])
				for own in md.portals:
					check(arrive.distance_to(own["pos"]) > float(own["radius"]) + 1.0, "%s: chegada de %s fora do portal de volta" % [mid, other])


# ---------------------------------------------------------------------------
# personagens: kit modular (kit_male/kit_female) tem os clipes que a EntityView pede
# ---------------------------------------------------------------------------
func _check_character_models(gd, sim) -> void:
	# kits genéricos (NPCs, sem conjuntos) e um por classe (com os conjuntos/armas/escudos só dela)
	var kits: Array = [["male", ""], ["female", ""]]
	for cid in gd.classes:                 # cada classe nos dois sexos (criação de personagem)
		kits.append(["male", cid])
		kits.append(["female", cid])
	for pair in kits:
		var body: String = pair[0]
		var own: String = pair[1]
		var kid: String = ("%s_%s" % [own, body]) if own != "" else body
		check(KitModel.exists(body, own) and KitModel.path_for(body, own).ends_with("kit_%s.glb" % kid), "kit_%s.glb existe" % kid)
		var k := KitModel.create(body, Color.WHITE, 0.025, own)
		var mine := func(set_id: String) -> bool: return gd.sets[set_id].class_id == own
		for clip in ["idle", "run", "atk_1h_a", "atk_2h", "atk_bow", "atk_staff", "cast", "cast_buff", "hit", "die", "block", "jump", "fall", "land", "dash", "idle_bow", "idle_staff"]:
			check(k.resolve(clip) != "", "kit_%s: clipe %s" % [kid, clip])
		for piece in ["arm_cape_cape_", "arm_plate_legs_", "arm_leather_legs_", "arm_cloth_legs_", "arm_plate_head_", "arm_leather_body_", "arm_cloth_body_"]:     # armadura comum: 1 malha por slot (chibi_kit.join_style_slots)
			check(k.pieces(piece + "*").size() > 0, "kit_%s: detalhe %s" % [kid, piece])
		check(k.has_material("tint2"), "kit_%s: tem peças de cor de destaque" % kid)
		# cada boneco instancia o kit inteiro: malha demais estoura o limite de recursos da GPU com a cidade cheia
		var meshes := k.pieces("*").size()
		check(meshes < 200, "kit_%s: poucas malhas por boneco (%d; kit por classe, peças de conjunto juntas por slot)" % [kid, meshes])
		if own == "":
			check(k.pieces("arm_pal*").is_empty() and k.pieces("arm_ber*").is_empty(), "kit_%s: genérico não leva conjuntos" % kid)
		# espada própria de cada conjunto com visual (ItemDef.weapon_style -> wpn_main_<tipo>_<estilo>)
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			for iid in gd.sets[set_id].pieces:
				var wit: ItemDef = gd.items[iid]
				if wit.slot == ItemDef.Slot.WEAPON and not iid.ends_with("_offhand"):
					check(wit.weapon_style != "" and k._nodes.has("wpn_main_%s_%s" % [wit.weapon_type, wit.weapon_style]), "kit_%s: espada própria de %s" % [kid, set_id])
					check(k.main_node(wit) == "wpn_main_%s_%s" % [wit.weapon_type, wit.weapon_style], "kit_%s: %s usa a espada própria" % [kid, iid])
		# maça do conjunto (variante da espada): modelo próprio no kit
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			for aid in gd.sets[set_id].alt_pieces:
				var ait: ItemDef = gd.items[aid]
				check(k.main_node(ait) == "wpn_main_%s_%s" % [ait.weapon_type, ait.weapon_style], "kit_%s: %s usa a maça própria" % [kid, aid])
		# segundo machado dos Gêmeos: arma própria na mão esquerda
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			for iid in gd.sets[set_id].pieces:
				var oit: ItemDef = gd.items[iid]
				if iid.ends_with("_offhand") and oit.weapon_type == "axe":
					check(k.off_node_of(oit) == "wpn_off_axe_%s" % oit.weapon_style and k._nodes.has(k.off_node_of(oit)), "kit_%s: %s com machado próprio na mão esquerda" % [kid, iid])
				elif iid.ends_with("_offhand") and oit.weapon_type in ["dagger", "sword"]:      # Assassino: par próprio (Trapaceiro: adaga de aparar)
					check(k.off_node_of(oit) == "wpn_off_%s_%s" % [oit.weapon_type, oit.weapon_style] and k._nodes.has(k.off_node_of(oit)), "kit_%s: %s com arma própria na mão esquerda" % [kid, iid])
		var plain: ItemDef = gd.items["sword_iron"]
		check(k.main_node(plain) == "wpn_main_sword", "arma comum continua com o modelo do tipo")
		# todo conjunto com visual próprio (GearCatalog.SET_VISUALS) tem as 4 peças no kit
		for set_id in GearCatalog.SET_VISUALS.keys().filter(mine):
			var style: String = GearCatalog.SET_VISUALS[set_id]["style"]
			for slot in ["head", "body", "gloves", "boots"]:
				check(k.pieces("arm_%s_%s_*" % [style, slot]).size() > 0, "kit_%s: peças do conjunto %s (%s)" % [kid, style, slot])
		k.free()
	# todo conjunto lendário do paladino tem visual próprio, cada um diferente
	var pal_styles := {}
	for set_id in gd.sets:
		var psd: SetDef = gd.sets[set_id]
		if psd.class_id != "paladin" or psd.is_hybrid():
			continue
		check(not GearCatalog.visual_of(set_id).is_empty(), "%s tem visual próprio" % set_id)
		for iid in psd.pieces:
			var pit: ItemDef = gd.items[iid]
			if pit.armor_style != "" and pit.slot != ItemDef.Slot.LEGS:      # calça: estilo da build (o kit tem), na cor do conjunto
				pal_styles[pit.armor_style] = true
				check(pit.armor_style == GearCatalog.visual_of(set_id).get("style", ""), "%s usa o visual do conjunto" % iid)
	check(pal_styles.size() == 18, "18 conjuntos do paladino, 18 visuais (%d)" % pal_styles.size())
	var ber := 0
	for set_id in gd.sets:
		if gd.sets[set_id].class_id == "berserker" and not gd.sets[set_id].is_hybrid():
			ber += 1
			check(not GearCatalog.visual_of(set_id).is_empty(), "%s tem visual próprio" % set_id)
	check(ber == 3 * Balance.LEGENDARY_LEVELS.size(), "3 conjuntos do berserker por nível lendário (%d)" % ber)
	var bis := 0
	for set_id in gd.sets:
		if gd.sets[set_id].class_id == "bishop" and not gd.sets[set_id].is_hybrid():
			bis += 1
			check(not GearCatalog.visual_of(set_id).is_empty(), "%s tem visual próprio" % set_id)
			for pid in gd.sets[set_id].pieces:
				var bit: ItemDef = gd.items[pid]
				if bit.weapon_type == "shield":
					check(bit.shield_style == GearCatalog.visual_of(set_id)["style"] and ResourceLoader.exists("res://assets/icons/%s.png" % bit.icon), "%s: escudo próprio com ícone" % pid)
	check(bis == 3 * Balance.LEGENDARY_LEVELS.size(), "3 conjuntos do bispo por nível lendário (%d)" % bis)
	# cada conjunto do paladino tem uma maça além da espada: cai junto, conta como a peça de arma, não muda o total
	var mace_sets := 0
	for set_id in gd.sets:
		var msd: SetDef = gd.sets[set_id]
		if msd.class_id != "paladin" or msd.is_hybrid():
			continue
		check(msd.alt_pieces.size() == 1, "%s: tem maça alternativa" % set_id)
		if msd.alt_pieces.is_empty():
			continue
		mace_sets += 1
		var mace: ItemDef = gd.items[msd.alt_pieces[0]]
		check(mace.weapon_type in ["mace", "mace2h"] and mace.set_id == set_id and mace.weapon_style != "", "%s: maça do conjunto com visual" % mace.id)
		check(not (mace.id in msd.pieces) and not (mace.id in msd.armor), "%s: maça não soma no total de peças" % set_id)
		check(ResourceLoader.exists("res://assets/icons/%s.png" % mace.icon), "%s: ícone da maça" % mace.id)
		var pool: Array = gd.legendary_pool(gd.classes["paladin"], msd.level)
		check(mace.id in pool, "%s: maça cai como lendário" % mace.id)
		var sword: ItemDef = null
		for pid in msd.pieces:
			if gd.items[pid].slot == ItemDef.Slot.WEAPON and not pid.ends_with("_offhand"):
				sword = gd.items[pid]
		check(sword != null and mace.attributes == sword.attributes and mace.is_two_handed() == sword.is_two_handed(), "%s: maça com os atributos e as mãos da espada" % mace.id)
	check(mace_sets == 3 * Balance.LEGENDARY_LEVELS.size(), "maça de conjunto em todo nível lendário (Guardião, Cruzado e Templário) (%d)" % mace_sets)
	# bônus: maça + armadura conta igual a espada + armadura
	var ms: SetDef = gd.sets["set_paladin_guardiao_20"]
	var pa: SimEntity = sim.spawn_bot(gd.classes["paladin"], "SetMace", "city_aldara", Vector3(0, 0, 6), 30)
	pa.brain = null
	pa.equipment.clear()
	for pid in ms.pieces:
		var pit: ItemDef = gd.items[pid]
		if pit.slot != ItemDef.Slot.WEAPON or pid.ends_with("_offhand"):
			pa.equipment[pit.slot] = pit
	pa.equipment[ItemDef.Slot.WEAPON] = gd.items[ms.alt_pieces[0]]
	pa.recompute_stats()
	check(int(pa.stats.active_sets.get(ms.id, 0)) == ms.armor.size(), "armadura completa: %d/%d (arma não conta)" % [int(pa.stats.active_sets.get(ms.id, 0)), ms.armor.size()])
	check(pa.stats.thorns_pct > 0.0, "maça lendária do Guardião (tanque): Retaliação")
	sim.despawn(pa)
	for set_id in GearCatalog.SET_VISUALS:
		var vis: Dictionary = GearCatalog.SET_VISUALS[set_id]
		if vis.has("icon"):
			for iid in gd.sets[set_id].pieces:          # só as peças que o conjunto tem (Cruzado não tem mão secundária)
				var piece: String = iid.get_slice("_", iid.get_slice_count("_") - 1)
				if piece == "legs":
					check(UiKit.item_texture(gd.items[iid]) != null, "%s: calça com arte pintada" % set_id)
					continue
				check(ResourceLoader.exists("res://assets/icons/%s_%s.png" % [vis["icon"], piece]), "%s: ícone %s" % [set_id, piece])
	# primeiro lendário do paladino (Guardião lv5): visual próprio + ícones
	var sd: SetDef = gd.sets.get("set_paladin_guardiao_5")
	check(sd != null and sd.name == "Conjunto Cavaleiro da Fortaleza", "set do paladino lv5 com nome da referência")
	for iid in sd.pieces:
		var it: ItemDef = gd.items[iid]
		check(UiKit.item_texture(it) != null, "%s tem ícone" % iid)
		if it.armor_style != "" and it.slot != ItemDef.Slot.LEGS:
			check(it.armor_style == "pal1", "%s usa o visual pal1" % iid)


## Pulo (Espaço): sobe, volta ao chão; golpe apertado no ar espera o pouso (buffer).
func _check_jump(gd, sim) -> void:
	var j = sim.spawn_bot(gd.classes["berserker"], "Pulo", "city_aldara", Vector3(0, 0, 5), 5)
	j.brain = null
	var c := InputCommand.new()
	c.jump = true
	c.aim = j.position + Vector3(0, 0, 2)
	sim._apply_command(j, c, sim.maps["city_aldara"], 1.0 / 60.0)
	check(j.airborne() and j.jump_v > 0.0, "Espaço: pula")
	var peak := 0.0
	var a := InputCommand.new()
	a.attack = true
	a.aim = j.position + Vector3(0, 0, 2)
	sim._apply_command(j, a, sim.maps["city_aldara"], 1.0 / 60.0)
	check(j.state != SimEntity.State.CASTING, "no ar o golpe não sai")
	for i in range(90):
		sim._update_entity(j, sim.maps["city_aldara"], 1.0 / 60.0)
		peak = maxf(peak, j.jump_h)
	check(not j.airborne() and j.jump_h == 0.0, "volta ao chão")
	check(peak > 0.7 and peak < 1.3, "altura do pulo ~1 m (%.2f)" % peak)
	sim.despawn(j)


## Compra o caminho mais curto (BFS) dos nós já comprados até `target`, nó a nó pelas regras da sim.
## Devolve o custo total, ou -1 se algum nó do caminho for recusado.
func _buy_path(sim, e, target: String) -> int:
	var nodes: Dictionary = gd_ref.trees[e.class_def.id]["nodes"]
	var prev := {}
	var queue: Array = []
	for nid in e.tree:
		queue.append(nid)
		prev[nid] = ""
	while queue.size() > 0:
		var cur: String = queue.pop_front()
		if cur == target:
			break
		for l in nodes[cur]["links"]:
			if not prev.has(l):
				prev[l] = cur
				queue.append(l)
	if not prev.has(target):
		return -1
	var path: Array = []
	var cur := target
	while cur != "" and not e.tree.has(cur):
		path.push_front(cur)
		cur = prev[cur]
	var total := 0
	for nid in path:
		var c: int = int(nodes[nid]["cost"])
		if not sim.tree_allocate(e, nid):
			return -1
		total += c
	return total


# ---------------------------------------------------------------------------
# árvore de pontos de skill (TreeCatalog): forma, regras e um "jogador" por build do 1 ao 30 (loops)
# ---------------------------------------------------------------------------
## Talentos de classe (aba Talentos): 6 linhas × 3 por classe, ganchos válidos e o comportamento dos principais.
func _check_class_talents(gd, sim) -> void:
	var known_hooks := ["id", "name", "text", "kind", "permanent", "aura", "strength", "radius", "summon_permanent", "summon_extra",
		"skill_mods", "stats", "form_mult", "form_time", "cheat_death", "ally_save", "ambush_mult", "on_kill", "low_hp", "execute",
		"regen", "mana_shield", "trap_max", "oath_max", "build"]
	var cat: Dictionary = ClassTalentsCatalog.build()
	for cid in gd.classes:
		var rows: Array = cat.get(cid, [])
		check(rows.map(func(r): return int(r[0])) == ClassTalentsCatalog.ROW_LEVELS, "%s: talentos nos níveis 5..45 (%s)" % [cid, str(rows.map(func(r): return r[0]))])
		var skill_ids: Array = gd.classes[cid].skill_ids
		for row in rows:
			check((row[1] as Array).size() == 3, "%s nv %d: 3 escolhas" % [cid, int(row[0])])
			for o in row[1]:
				var bad: Array = (o as Dictionary).keys().filter(func(k): return not (k in known_hooks))
				check(bad.is_empty(), "%s: %s só com ganchos conhecidos %s" % [cid, o["id"], bad])
				check(str(o["text"]).length() > 10 and o["kind"] in ClassTalentsCatalog.KINDS, "%s: %s com texto e tipo" % [cid, o["id"]])
				check(o.keys().size() > 4, "%s: %s tem efeito" % [cid, o["id"]])
				var refs: Array = o.get("permanent", []) + o.get("aura", []) + o.get("summon_permanent", []) + o.get("summon_extra", {}).keys() + o.get("skill_mods", {}).keys()
				if o.has("on_kill") and (o["on_kill"] as Dictionary).has("buff"):
					refs.append(o["on_kill"]["buff"])
				for r in refs:
					check(r in skill_ids, "%s: %s cita skill da classe (%s)" % [cid, o["id"], r])
				for r in o.get("permanent", []) + o.get("aura", []):
					check(ClassTalentSystem.passive_buff(r, 1.0).size() > 2, "%s: %s — %s tem bônus para ficar permanente" % [cid, o["id"], r])
				for r in o.get("summon_permanent", []) + o.get("summon_extra", {}).keys():
					check(gd.skills.has(r) and gd.skills[r].effects.has("summon"), "%s: %s — %s invoca" % [cid, o["id"], r])
				check(gd.trees[cid]["nodes"].has("%s_c_%s" % [cid, o["id"]]), "%s: %s é nó de escolha" % [cid, o["id"]])
	var m: Dictionary = sim.maps["city_aldara"]
	var at: Vector3 = m["def"].town_center
	var mk := func(cid: String, lv: int, pick: String, pos: Vector3) -> SimEntity:
		var e: SimEntity = sim.spawn_bot(gd.classes[cid], "CT", "city_aldara", pos, lv)
		e.brain = null
		for nid in e.tree.keys():
			if gd.trees[cid]["nodes"][nid]["kind"] == "pick":
				e.tree.erase(nid)
		if pick != "":
			e.tree["%s_c_%s" % [cid, pick]] = true
		sim.recompute_tree_bonus(e)
		e.heal_full()
		return e
	var run := func(secs: float) -> void:
		for i in range(int(secs / 0.5)):
			sim.time += 0.5
			ClassTalentSystem.tick(sim, m, 0.5)
	# Baluarte: Armadura Abençoada + Muralha sempre ativas (60%, sem a lentidão), por muito tempo
	var pal: SimEntity = mk.call("paladin", 10, "", at)
	var def0: float = pal.stats.pdef
	var spd0: float = pal.stats.move_speed
	pal.tree["paladin_c_pal_c_bulwark"] = true
	sim.recompute_tree_bonus(pal)
	run.call(36.0)
	var ids: Array = pal.buffs.map(func(b): return b.get("id"))
	check(pal.stats.pdef > def0 * 1.3 and pal.stats.move_speed >= spd0 - 0.01, "Baluarte: DEF sobe sem lançar e sem lentidão (%.0f -> %.0f)" % [def0, pal.stats.pdef])
	check(ids.size() >= 2 and ids.size() == ids.filter(func(x): return ids.count(x) == 1).size(), "Baluarte: um buff de cada (não acumula) %s" % str(ids))
	sim._apply_skill(pal, gd.skills["pal_blessed_armor"], m)
	var ba: Array = pal.buffs.filter(func(b): return b.get("id") == gd.skills["pal_blessed_armor"].effects["buff"]["id"])
	check(ba.size() == 1 and not ba[0].get("ct", false), "lançar com o permanente ativo: o lançado (mais forte) vale, um só")
	sim.despawn(pal)
	# Aura de Proteção: grupo a 10 m sim, a 25 m não, de fora do grupo não
	var ap: SimEntity = mk.call("paladin", 10, "pal_c_aura_prot", at)
	var near: SimEntity = mk.call("ranger", 10, "", at + Vector3(10, 0, 0))
	var far: SimEntity = mk.call("ranger", 10, "", at + Vector3(0, 0, 25))
	var stranger: SimEntity = mk.call("ranger", 10, "", at + Vector3(-8, 0, 0))
	for x in [near, far]:
		sim.party_invite(ap, x)
		sim.party_accept(x)
		check(x.party_id >= 0 and x.party_id == ap.party_id, "aura: entra no grupo")
	run.call(1.0)
	var has_aura := func(x: SimEntity) -> bool: return x.buffs.any(func(b): return b.get("ct", false))
	check(has_aura.call(ap) and has_aura.call(near), "Aura de Proteção: você e o aliado a 10 m")
	check(not has_aura.call(far) and not has_aura.call(stranger), "Aura de Proteção: nem a 25 m nem quem está fora do grupo")
	for x in [ap, near, far, stranger]:
		sim.despawn(x)
	# Elemental Vinculado: fica para sempre e invocar outro troca o elemento
	var ele: SimEntity = mk.call("elementalist", 10, "ele_c_bound", at + Vector3(4, 0, 4))
	sim._apply_skill(ele, gd.skills["ele_summon_fire"], m)
	var mine := func(owner: SimEntity) -> Array: return m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == owner.id and o.is_alive())
	check(mine.call(ele).size() == 1 and mine.call(ele)[0].summon_expires == INF, "Elemental Vinculado: elemental sem prazo")
	check(sim._summons_full(ele, gd.skills["ele_summon_fire"]) and not sim._summons_full(ele, gd.skills["ele_summon_ice"]), "Elemental Vinculado: o mesmo não repete, outro elemento pode")
	sim._apply_skill(ele, gd.skills["ele_summon_ice"], m)
	var now: Array = mine.call(ele)
	check(now.size() == 1 and now[0].monster_def.id == gd.skills["ele_summon_ice"].effects["summon"]["monster_id"] and now[0].summon_expires == INF, "Elemental Vinculado: troca de elemento")
	sim.despawn(ele)
	# Exército Eterno: esqueletos sem prazo, sem passar do máximo
	var nec: SimEntity = mk.call("necromancer", 10, "nec_c_army", at + Vector3(-4, 0, 4))
	for i in range(4):
		sim._apply_skill(nec, gd.skills["nec_raise"], m)
	var sk: Array = mine.call(nec)
	check(sk.size() == int(gd.skills["nec_raise"].effects["summon"]["max"]) and sk.all(func(o): return o.summon_expires == INF), "Exército Eterno: %d esqueletos para sempre" % sk.size())
	for o in sk:
		sim.despawn(o)
	sim.despawn(nec)
	# Recusa a Morrer: golpe fatal deixa com 1 HP e imortal 6 s; depois disso, morre (recarga 60 s)
	var ber: SimEntity = mk.call("berserker", 5, "ber_c_undying", at + Vector3(6, 0, -4))
	var wolf: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", at + Vector3(7, 0, -4))
	wolf.brain = null
	ber.stats.evasion = 0.0          # build sorteada (Punhos tem esquiva): o golpe fatal tem de pegar
	sim._deal_damage(wolf, ber, 999999, false, false, "physical")
	check(ber.is_alive() and int(ber.hp) == 1 and ber.immortal_left > 5.0, "Recusa a Morrer: fica com 1 HP e imortal")
	sim._deal_damage(wolf, ber, 999999, false, false, "physical")
	check(ber.is_alive(), "Recusa a Morrer: imortal segura o golpe seguinte")
	run.call(7.0)
	sim._deal_damage(wolf, ber, 999999, false, false, "physical")
	check(not ber.is_alive(), "Recusa a Morrer: só uma vez por minuto")
	sim.despawn(ber)
	sim.despawn(wolf)
	# Emboscada e troca só na cidade
	var ass: SimEntity = mk.call("assassin", 5, "ass_c_ambush", at)
	check(is_equal_approx(ClassTalentSystem.ambush_mult(ass), 2.0), "Emboscada: 2,0x saindo da furtividade")
	check(sim.tree_allocate(ass, "assassin_c_ass_c_venom") and not ass.tree.has("assassin_c_ass_c_ambush"), "trocar a escolha na cidade tira a outra")
	ass.position = Vector3(90, 0, 60)
	check(sim.tree_block_reason(ass, "assassin_c_ass_c_reflex") == "troque a escolha desta linha na cidade", "fora da cidade não troca")
	check(sim.tree_block_reason(ass, "assassin_c_ass_c_vanish").begins_with("requer nível"), "linha de nível alto bloqueada")
	sim.despawn(ass)
	_check_act2_talent_rows(gd, sim, cat, mk)

## Ato II (ato2-horda.md R6/R7, AC-04): linhas 35/40/45, 3 por classe, uma para cada build; bot escolhe a da build;
## os refinos que dependem da ascensão ficam em ASC_REFINES_PENDING (dados válidos, fora da janela).
func _check_act2_talent_rows(gd, sim, cat: Dictionary, mk: Callable) -> void:
	check(ClassTalentsCatalog.ROW_LEVELS.slice(-3) == [35, 40, 45], "talentos: linhas 35, 40 e 45 em ROW_LEVELS")
	var seen := {}
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var build_ids: Array = cls.builds.map(func(b): return b["id"])
		for lv in [35, 40, 45]:
			var rows: Array = (cat.get(cid, []) as Array).filter(func(r): return int(r[0]) == lv)
			check(rows.size() == 1 and (rows[0][1] as Array).size() == 3, "%s: linha %d com 3 talentos" % [cid, lv])
			if rows.size() != 1:
				continue
			var opts: Array = rows[0][1]
			check(opts.map(func(o): return o.get("build", "")) == build_ids, "%s nv %d: um talento para cada build, na ordem %s" % [cid, lv, str(build_ids)])
			for o in opts:
				check(not seen.has(o["id"]), "%s: id de talento repetido" % o["id"])
				seen[o["id"]] = true
				var b: Dictionary = cls.build_by_id(o.get("build", ""))
				for sid in (o.get("skill_mods", {}) as Dictionary).keys() + o.get("aura", []) + o.get("permanent", []) + (o.get("summon_extra", {}) as Dictionary).keys():
					check(sid in b.get("skills", []), "%s: %s mexe em skill da build %s (%s)" % [cid, o["id"], o.get("build", ""), sid])
				for sid in o.get("skill_mods", {}):
					var md: Dictionary = o["skill_mods"][sid]
					var sk: SkillDef = gd.skills[sid]
					for k in md.get("mult", {}):
						var f := float(md["mult"][k])
						check(k == "duration" or (k in sk and float(sk.get(k)) > 0.0), "%s: %s multiplica %s que a skill tem" % [o["id"], sid, k])
						check(f >= 0.6 and f <= 1.5, "%s: %s x%.2f dentro do orçamento da linha (0,6-1,5)" % [o["id"], k, f])
					for k in md.get("effects", {}):
						check(k in SkillDef.EFFECT_KEYS and sk.effects.has(k), "%s: %s reforça efeito que a skill já tem (%s)" % [o["id"], sid, k])
		for pr in ClassTalentsCatalog.ASC_REFINES_PENDING.get(cid, []):
			check(int(pr["level"]) in [40, 45] and pr["build"] in build_ids and str(pr["text"]).length() > 10 and str(pr["needs"]) != "",
				"%s: refino pendente %s com nível, build e mecânica" % [cid, pr["name"]])
			check(not gd.trees[cid]["nodes"].values().any(func(n): return n["name"] == pr["name"]), "%s: refino pendente %s não é nó (só dado)" % [cid, pr["name"]])
	check(ClassTalentsCatalog.ASC_REFINES_PENDING.keys().size() == gd.classes.size(), "refinos pendentes: as 8 classes")
	# efeito de verdade: Quebra-Fileiras (+25%) e Linha de Escudos (raio/recarga do Provocar)
	var at: Vector3 = sim.maps["city_aldara"]["def"].town_center
	var pal: SimEntity = mk.call("paladin", 35, "pal_c_breaker", at)
	var base: SkillDef = gd.skills["pal_crusader_strike"]
	check(is_equal_approx(ClassTalentSystem.apply_mods(pal, base).power, base.power * 1.25), "Quebra-Fileiras: Golpe do Cruzado +25%")
	sim.despawn(pal)
	pal = mk.call("paladin", 35, "pal_c_shield_line", at)
	var tn: SkillDef = gd.skills["pal_taunt"]
	var tn2: SkillDef = ClassTalentSystem.apply_mods(pal, tn)
	check(is_equal_approx(tn2.radius, tn.radius * 1.3) and is_equal_approx(tn2.cooldown, tn.cooldown * 0.75), "Linha de Escudos: Provocar mais longe e mais rápido")
	check(sim.tree_block_reason(pal, "paladin_c_pal_c_rebound") == "requer nível 40", "linha 40 fechada no 35 (%s)" % sim.tree_block_reason(pal, "paladin_c_pal_c_rebound"))
	pal.level = 40
	check(Balance.MAX_LEVEL >= 40 and not sim.tree_block_reason(pal, "paladin_c_pal_c_rebound").begins_with("requer nível"), "linha 40 abre no nível 40 (%s)" % sim.tree_block_reason(pal, "paladin_c_pal_c_rebound"))
	sim.despawn(pal)
	var nec: SimEntity = mk.call("necromancer", 35, "nec_c_kennel", at)
	check(ClassTalentSystem.summon_extra(nec, "nec_bone_hound") == 1, "Canil dos Mortos: +1 cão")
	sim.despawn(nec)
	# bot de cada build fica com o talento da build na linha 35
	var rng_state: int = sim.rng.state          # o sorteio das linhas antigas não muda os checks seguintes
	ClassTalentSystem.bot_picks = true
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			var e: SimEntity = sim.spawn_bot(gd.classes[cid], "CT", "city_aldara", at, 35)
			e.brain = null
			e.build_id = b["id"]
			for nid in e.tree.keys():
				if gd.trees[cid]["nodes"][nid]["kind"] == "pick":
					e.tree.erase(nid)
			ClassTalentSystem.bot_pick(sim, e)
			var got: Array = ClassTalentSystem.picked(e).filter(func(o): return o.has("build"))
			check(got.size() == 1 and got[0]["build"] == b["id"], "bot %s/%s: talento 35 da build (%s)" % [cid, b["id"], str(got.map(func(o): return o["id"]))])
			sim.despawn(e)
	ClassTalentSystem.bot_picks = false
	sim.rng.state = rng_state

func _check_tree(gd, sim, save) -> void:
	var total_points := 0
	for lv in range(2, Balance.MAX_LEVEL + 1):
		total_points += Balance.points_at(lv)
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var tr: Dictionary = gd.trees.get(cid, {})
		check(not tr.is_empty(), "%s: tem árvore" % cid)
		var nodes: Dictionary = {}
		var picks: Array = []
		for nid in tr["nodes"]:                  # talentos de escolha (aba própria, sem ligações) contam à parte
			if tr["nodes"][nid]["kind"] == "pick":
				picks.append(tr["nodes"][nid])
			else:
				nodes[nid] = tr["nodes"][nid]
		# --- forma (teia estilo Path of Exile) ---
		check(nodes.size() >= 200 and nodes.size() <= 650, "%s: teia com 200-650 nós (%d; a Fronteira do Ato II soma ~190)" % [cid, nodes.size()])
		var kinds := {}
		for nid in nodes:
			kinds[nodes[nid]["kind"]] = int(kinds.get(nodes[nid]["kind"], 0)) + 1
		print("TEIA %s: %d nós %s" % [cid, nodes.size(), kinds])
		check(int(kinds.get("notable", 0)) >= 6, "%s: notáveis na teia (%d)" % [cid, int(kinds.get("notable", 0))])
		var attr_nodes := 0
		for nid in nodes:
			for k in nodes[nid]["stats"]:
				if str(k).begins_with("attr_"):
					attr_nodes += 1
					break
		check(attr_nodes >= 40, "%s: nós de atributo (FOR/AGI/VIT/WILL/INT) na teia (%d)" % [cid, attr_nodes])
		# escala nova: estrada/junção +1; entrada de círculo +5..+10 (mais longe do início = mais)
		var road_bad: Array = []
		var near_in := 99
		var far_in := 0
		for nid in nodes:
			var nd: Dictionary = nodes[nid]
			if nd["kind"] == "stat" and nd["branch"] == "ring":
				var tot := 0
				for k in nd["stats"]:
					tot += int(nd["stats"][k])
				if tot != TreeCatalog.ROAD_ATTR:
					road_bad.append(nid)
			elif nd["kind"] == "stat" and str(nid).ends_with("_in"):
				var v: int = nd["stats"].values()[0]
				check(v >= TreeCatalog.CLUSTER_ATTR.x and v <= TreeCatalog.CLUSTER_ATTR.y, "%s: entrada de círculo %s dá +5..+10 (%d)" % [cid, nid, v])
				near_in = mini(near_in, v)
			if nd["kind"] == "stat" and nd["branch"] != "ring":
				for k in nd["stats"]:
					if str(k).begins_with("attr_"):
						far_in = maxi(far_in, int(nd["stats"][k]))
		check(road_bad.is_empty(), "%s: estradas e junções dão +%d de atributo %s" % [cid, TreeCatalog.ROAD_ATTR, road_bad.slice(0, 3)])
		check(near_in == TreeCatalog.CLUSTER_ATTR.x and far_in == TreeCatalog.CLUSTER_ATTR.y, "%s: círculo perto dá +%d e no fundo +%d (%d..%d)" % [cid, TreeCatalog.CLUSTER_ATTR.x, TreeCatalog.CLUSTER_ATTR.y, near_in, far_in])
		var seen := {tr["start"]: true}
		var queue: Array = [tr["start"]]
		while queue.size() > 0:
			var cur: String = queue.pop_front()
			for l in nodes[cur]["links"]:
				check(cur in nodes[l]["links"], "%s: ligação %s-%s nos dois sentidos" % [cid, cur, l])
				if not seen.has(l):
					seen[l] = true
					queue.append(l)
		check(seen.size() == nodes.size(), "%s: todos os nós alcançáveis do início (%d/%d)" % [cid, seen.size(), nodes.size()])
		var skill_nodes := 0
		var cost_all := 0
		for nid in nodes:
			cost_all += int(nodes[nid]["cost"])
			if nodes[nid]["kind"] == "skill":
				skill_nodes += 1
		var web_ids: Array = Array(cls.skill_ids).filter(func(x): return not gd.skills[x].ascension)     # ascensão: teia própria
		check(skill_nodes == web_ids.size(), "%s: cada skill da classe é um nó (%d/%d)" % [cid, skill_nodes, web_ids.size()])
		for sid in web_ids:
			check(nodes.has("%s_s_%s" % [cid, sid]) and nodes.has("%s_m_%s" % [cid, sid]), "%s: nó e maestria de %s" % [cid, sid])
		for t in gd.talents_for_class(cid):
			check(nodes.has("%s_t_%s" % [cid, t.id]), "%s: evolução %s na árvore" % [cid, t.id])
		var overlap: Array = []
		var ids := nodes.keys()
		for i in range(ids.size()):
			for k in range(i + 1, ids.size()):
				if (nodes[ids[i]]["pos"] as Vector2).distance_to(nodes[ids[k]]["pos"]) < 0.35:
					overlap.append("%s~%s" % [ids[i], ids[k]])
		check(overlap.is_empty(), "%s: nós não se sobrepõem no desenho %s" % [cid, overlap])
		check(cost_all > total_points, "%s: não dá pra comprar tudo — escolher é a build (%d > %d)" % [cid, cost_all, total_points])
		# --- regras ---
		var t0 = sim.spawn_character(SimEntity.Kind.BOT, cls, "Arv", "city_aldara", Vector3(-6, 0, 10), 1)
		for sid in cls.starting_skills:
			check(t0.tree.has("%s_s_%s" % [cid, sid]), "%s: skill inicial %s já comprada" % [cid, sid])
		var far := ""
		var lvl_gate := ""
		for nid in nodes:
			if t0.tree.has(nid):
				continue
			var adj := false
			for l in nodes[nid]["links"]:
				adj = adj or t0.tree.has(l)
			if not adj and far == "":
				far = nid
			if adj and int(nodes[nid]["level"]) > 1 and lvl_gate == "":
				lvl_gate = nid
		t0.mastery_points = 50
		check(far != "" and not sim.tree_allocate(t0, far), "%s: nó sem vizinho comprado é recusado" % cid)
		if lvl_gate != "":
			check(not sim.tree_allocate(t0, lvl_gate), "%s: nó acima do nível é recusado" % cid)
		t0.mastery_points = 0
		var cheap := ""
		for nid in nodes:
			if sim.tree_block_reason(t0, nid) == "pontos insuficientes (1)":
				cheap = nid
		check(cheap != "", "%s: sem pontos, nada é comprado" % cid)
		sim.despawn(t0)
		# --- um jogador por build, do nível 1 ao 30, sempre indo atrás das skills da build ---
		for b in cls.builds:
			var e = sim.spawn_character(SimEntity.Kind.BOT, cls, "Build", "city_aldara", Vector3(-6, 0, 10), 1)
			var want: Array = b["skills"]
			var refused := 0
			for lv in range(2, Balance.MAX_LEVEL + 1):
				e.level = lv
				e.mastery_points += Balance.points_at(lv)
				var guard := 0
				while e.mastery_points > 0 and guard < 30:
					guard += 1
					var target := ""
					for sid in want:
						if not e.knows(sid) and gd.skills[sid].unlock_level <= lv:
							target = "%s_s_%s" % [cid, sid]
							break
					if target != "":
						var before: int = e.mastery_points
						if _path_cost(gd, e, target) <= e.mastery_points:
							if _buy_path(sim, e, target) < 0:
								refused += 1
								break
							continue
						if before == e.mastery_points:
							break
					# sobra: maestria das skills da build, depois passivos
					var bought := false
					for kind in ["mastery", "notable", "stat", "talent"]:
						for nid in nodes:
							var n: Dictionary = nodes[nid]
							if n["kind"] == kind and (kind != "mastery" or n["ref"] in want) and sim.tree_block_reason(e, nid) == "":
								bought = sim.tree_allocate(e, nid)
								break
						if bought:
							break
					if not bought:
						break
			var missing: Array = []
			for sid in want:
				if not e.knows(sid):
					missing.append(sid)
			check(refused == 0 and missing.is_empty(), "%s/%s: do 1 ao 30 pela árvore pega todas as skills da build (faltam %s)" % [cid, b["id"], missing])
			check(not e.tree_bonus.is_empty(), "%s/%s: passivos da árvore ativos (%s)" % [cid, b["id"], e.tree_bonus])
			if cid == "paladin" and b["id"] == "guardiao":
				e.recompute_stats()
				var hp_with: float = e.stats.max_hp
				var bonus: Dictionary = e.tree_bonus.duplicate()
				e.tree_bonus = {}
				e.recompute_stats()
				check(bonus.has("hp_pct") == (hp_with > e.stats.max_hp + 0.5) or not bonus.has("hp_pct"), "passivo de HP muda o HP máximo")
				sim.recompute_tree_bonus(e)
			sim.despawn(e)
	# --- save/load guarda a árvore ---
	var pl = sim.player
	var had: Array = pl.tree.keys()
	var bonus_before: Dictionary = pl.tree_bonus.duplicate()
	save.save_player(pl)
	var data: Dictionary = save.load_data()
	check(data.get("tree", []).size() == had.size(), "save guarda os nós da árvore (%d)" % had.size())
	save.delete_slot(TEST_SLOT)

func _path_cost(gd, e, target: String) -> int:
	var nodes: Dictionary = gd.trees[e.class_def.id]["nodes"]
	var dist := {}
	var queue: Array = []
	for nid in e.tree:
		dist[nid] = 0
		queue.append(nid)
	while queue.size() > 0:
		var cur: String = queue.pop_front()
		for l in nodes[cur]["links"]:
			if not dist.has(l):
				dist[l] = int(dist[cur]) + int(nodes[l]["cost"])
				queue.append(l)
	return int(dist.get(target, 999))


# ---------------------------------------------------------------------------
# skills: tema visual válido, clipe certo nos dois kits, impacto dentro do clipe (bancada: game/dev/showcase.gd)
# ---------------------------------------------------------------------------
func _check_skill_visuals(gd) -> void:
	var view_script: GDScript = load("res://game/entities/entity_view.gd")
	var impacts: Dictionary = view_script.IMPACT_FRAME
	var kits := [KitModel.create("male", Color.WHITE), KitModel.create("female", Color.WHITE)]
	var bad_theme: Array = []
	var themes_used := {}
	for sid in gd.skills:
		var s: SkillDef = gd.skills[sid]
		if not (s.vfx in SkillsCatalog.VFX_THEMES):
			bad_theme.append(sid)
		themes_used[s.vfx] = true
		check(SkillFx.PALETTE.has(s.vfx) and SkillFx.PARTS.has(s.vfx), "tema %s (%s) tem cor e partículas" % [s.vfx, sid])
	check(bad_theme.is_empty(), "toda skill tem tema visual válido %s" % [bad_theme])
	check(themes_used.size() >= 10, "skills usam temas variados (%d)" % themes_used.size())
	# cada clipe que a EntityView pode escolher existe nos dois kits e o impacto cabe nele
	for clip in impacts:
		if clip in EntityView.FORM_CLIP.values() or EntityView.MOB_ONLY_CLIPS.has(clip):
			continue                     # gesto de bicho: só nas formas (_check_form_clips); de monstro: _check_skill_clips
		for k in kits:
			var name: String = k.resolve(clip)
			check(name != "", "clipe %s existe no kit" % clip)
			if name != "":
				var frames: float = k.anim.get_animation(name).length * 24.0
				check(float(impacts[clip]) <= frames + 1.0, "impacto de %s (quadro %d) dentro do clipe (%d quadros)" % [clip, impacts[clip], int(frames)])
	for k in kits:
		k.free()


