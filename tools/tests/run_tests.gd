## Conversa dos bots por contexto (BotChat): lugar, classe/build, grupo com o jogador (nome, eventos, ritmo, sem repetir).
func _check_bot_chat(gd, sim) -> void:
	var full := {"p": "Fulano", "pcls": "paladino", "map": "Mapa", "lv": "12", "me": "Bot", "boss": "Chefão", "item": "Anel"}
	full.merge(BotsCatalog.place_words("Mapa"))     # falas de viagem: {pra} {em} {nome}
	var bad := 0
	for key in gd.bot_chat:
		for line in gd.bot_chat[key]:
			var s := str(line)
			if s.strip_edges() == "" or (not s.contains("%") and s.format(full).contains("{")):
				bad += 1
				print("  fala com marca desconhecida/vazia: %s -> %s" % [key, s])
	check(bad == 0, "falas de bot: marcas conhecidas e nada vazio (%d ruins)" % bad)
	# classe e build
	for cid in gd.classes:
		var cp: Array = BotChat.pool("class:" + cid)
		check(cp.size() >= 20, "falas de bot: %s tem voz própria (%d)" % [cid, cp.size()])
		for ev in ["join", "hunt", "player_low", "boss_fight"]:
			check(not BotChat.pool("party:%s:%s" % [ev, cid]).is_empty(), "falas de grupo: %s reage a %s" % [cid, ev])
		for b in gd.classes[cid].builds:
			check(BotChat.pool("build:" + str(b["id"])).size() >= 2, "falas de bot: build %s" % b["id"])
	# lugar: todo mapa (dentro e fora da muralha) cai num tipo com falas; os tipos esperados existem
	var kinds := {}
	for mid in gd.maps:
		var def: MapDef = gd.maps[mid]
		var spots: Array = [def.spawn_point, def.town_center, def.town_center + Vector3(def.town_radius + 6.0, 0, 0)]
		for pos in spots:
			var k := BotChat.place_kind(def, pos)
			kinds[k] = true
			check(BotChat.pool("place:" + k).size() >= 4, "falas de bot: %s (%s) tem conversa do lugar" % [mid, k])
	for k in ["aldara_town", "aldara_field", "forest", "forest_town", "elf_city", "dawn", "dawn_town", "fort", "citadel", "dungeon", "interior"]:
		check(kinds.has(k), "falas de bot: algum mapa é '%s'" % k)
	check(BotChat.place_kind(gd.maps["dg_catacumbas"], Vector3.ZERO) == "dungeon" and BotChat.place_kind(gd.maps["in_tavern"], Vector3.ZERO) == "interior",
		"falas de bot: dungeon e interior pelos dados")
	# eventos do grupo: todos têm fala com o nome do jogador
	for ev in BotsCatalog.PARTY_LINES:
		if str(ev).begins_with("reply") and ev != "reply_hi":
			continue
		var pp: Array = BotChat.pool("party:" + ev)
		check(pp.any(func(l): return str(l).contains("{p}")), "falas de grupo: '%s' chama o jogador pelo nome" % ev)
	check(BotChat.reply_kind("valeu mano") == "reply_thanks" and BotChat.reply_kind("bora la") == "reply_go" and BotChat.reply_kind("que horas?") == "reply_ask"
		and BotChat.reply_kind("hm") == "reply", "resposta do grupo pelas palavras")
	# viagem: artigo certo pelo nome do lugar ("no Vale", "nas Estepes"), sem marca sobrando
	check(BotsCatalog.place_words("Vale de Aldara")["em"] == "no Vale de Aldara" and BotsCatalog.place_words("Estepes de Cinza")["pra"] == "pras Estepes de Cinza"
		and BotsCatalog.place_words("Floresta Sombria")["em"] == "na Floresta Sombria" and BotsCatalog.place_words("Arraial de Ghar")["pra"] == "pro Arraial de Ghar",
		"falas de viagem: artigo do lugar (no/na/nas/pro)")
	check(BotsCatalog.place_words("Monte Kharzun")["em"] == "no Monte Kharzun" and BotsCatalog.place_words("Salão dos Matadores")["pra"] == "pro Salão dos Matadores",
		"falas de viagem: Monte e Salão são masculinos (no Monte Kharzun, pro Salão dos Matadores)")
	for mid in gd.maps:
		for line in gd.bot_lines["leaving"]:
			var s := str(line).format(BotsCatalog.place_words(gd.maps[mid].name))
			check(not s.contains("{") and not s.contains("%"), "falas de viagem sem marca sobrando: %s" % s)
	var pl: SimEntity = sim.player
	if pl.party_id >= 0:
		sim.party_leave(pl)
	var b1: SimEntity = sim.spawn_bot(gd.classes["paladin"], "ChatA", "city_aldara", pl.position + Vector3(2, 0, 0), pl.level)
	var b2: SimEntity = sim.spawn_bot(gd.classes["bishop"], "ChatB", "city_aldara", pl.position + Vector3(-2, 0, 0), pl.level)
	# sem repetir em seguida (conjunto grande e conjunto de 2)
	var rep := 0
	var last := ""
	for i in 300:
		var l := BotChat.pick(sim, b1, ["a", "b"] if i < 100 else BotChat.pool("class:paladin"), full)
		rep += 1 if l == last else 0
		last = l
	check(rep == 0, "bot não repete a mesma fala duas vezes seguidas (%d)" % rep)
	# chefe vivo perto: a conversa fala dele pelo nome
	var boss_def: MonsterDef = null
	for mid in gd.monsters:
		if gd.monsters[mid].is_boss:
			boss_def = gd.monsters[mid]
			break
	var boss: SimEntity = sim.spawn_monster(boss_def, "city_aldara", b1.position + Vector3(0, 0, 6))
	var said_boss := false
	for i in 60:
		if BotChat.ambient_line(sim, b1).contains(boss_def.name):
			said_boss = true
	check(said_boss, "bot perto de chefe vivo fala dele (%s)" % boss_def.name)
	sim.despawn(boss)
	# custo: uma fala solta (lugar, chefe perto, investida) é barata mesmo no mapa cheio
	var us0 := Time.get_ticks_usec()
	for i in 500:
		BotChat.ambient_line(sim, b1)
	var per := float(Time.get_ticks_usec() - us0) / 500.0
	print("fala de bot: %.1f µs" % per)
	check(per < 300.0, "fala de bot custa pouco (%.1f µs)" % per)
	# grupo com o jogador: cumprimenta pelo canal do grupo, reage, respeita o ritmo
	var heard: Array = []
	var listen := func(who: String, text: String, ch: String): heard.append([who, text, ch, sim.time])
	Events.chat_message.connect(listen)
	sim.party_invite(pl, b1)
	sim.party_accept(b1)
	sim.party_invite(pl, b2)
	sim.party_accept(b2)
	var t0: float = sim.time
	for i in 80:
		sim.time += 0.1
		BotChat.update(sim)
	var greets: Array = heard.filter(func(h): return h[2] == "party" and h[0] in ["ChatA", "ChatB"])
	check(greets.size() >= 2, "bots que entram no grupo do jogador cumprimentam no grupo (%d)" % greets.size())
	BotChat.ambient(sim, b1)
	check(not heard.any(func(h): return h[0] == "ChatA" and h[2] == "global"), "bot no grupo do jogador não fala no global")
	check(BotChat.party_event(sim, pl, "player_died"), "grupo reage à morte do jogador")
	check(not BotChat.party_event(sim, pl, "player_died"), "mesma reação tem recarga")
	var named := 0
	for i in 40:
		if BotChat.party_line(sim, b2, "player_low").contains(pl.name):
			named += 1
	check(named > 0, "fala de grupo usa o nome do jogador (%d/40)" % named)
	heard.clear()
	var minutes := 10.0
	for i in int(minutes * 60.0 / 0.25):
		sim.time += 0.25
		BotChat.update(sim)
	var party_said: Array = heard.filter(func(h): return h[2] == "party")
	var min_gap := 999.0
	for i in range(1, party_said.size()):
		min_gap = minf(min_gap, float(party_said[i][3]) - float(party_said[i - 1][3]))
	check(party_said.size() >= 4 and party_said.size() <= int(minutes * 60.0 / Balance.PARTY_CHAT_MIN) + 6,
		"grupo conversa sem virar spam (%d falas em %d min)" % [party_said.size(), int(minutes)])
	check(min_gap >= Balance.PARTY_CHAT_GAP - 0.01, "intervalo mínimo entre falas do grupo (%.1f s)" % min_gap)
	Events.chat_message.disconnect(listen)
	sim.party_leave(b1)
	sim.party_leave(b2)
	if pl.party_id >= 0:
		sim.party_leave(pl)
	sim.despawn(b1)
	sim.despawn(b2)
	check(sim.time > t0, "relógio andou")

## Janela P: a lista "Por perto" só traz quem aceitaria um convite agora (fora de grupo, sem convite pendente,
## nível compatível, vivo, perto); quem não pode convidar (não é líder / grupo cheio) não vê ninguém.
func _check_party_invitable(gd, sim) -> void:
	var at := Vector3(-14, 0, 14)
	var me: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Lider", "city_aldara", at, 15)
	me.brain = null
	var ok_bot: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Livre", "city_aldara", at + Vector3(3, 0, 0), 16)
	var far_lv: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Alto", "city_aldara", at + Vector3(4, 0, 0), 15 + Balance.PARTY_LEVEL_GAP + 4)
	var grouped: SimEntity = sim.spawn_bot(gd.classes["druid"], "Agrupado", "city_aldara", at + Vector3(5, 0, 0), 15)
	var other: SimEntity = sim.spawn_bot(gd.classes["assassin"], "Outro", "city_aldara", at + Vector3(6, 0, 0), 15)
	var away: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Longe", "city_aldara", at + Vector3(Balance.PARTY_NEARBY_RANGE + 5, 0, 0), 15)
	var dead: SimEntity = sim.spawn_bot(gd.classes["necromancer"], "Morto", "city_aldara", at + Vector3(2, 0, 2), 15)
	for x in [ok_bot, grouped, other, away, dead]:
		x.brain = null           # far_lv fica com cérebro: a regra de nível vale para bots
	sim.party_invite(other, grouped)
	sim.party_accept(grouped)
	sim._kill(dead, null)
	var pending: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Pendente", "city_aldara", at + Vector3(2, 0, -2), 15)
	pending.brain = null
	sim.invites[pending.id] = {"from": grouped.id, "expires": sim.time + 30.0, "decide_at": sim.time + 30.0}
	var list: Array = sim.party_invitable_near(me)
	check(list.has(ok_bot), "janela P lista quem dá para convidar")
	for x in [far_lv, grouped, other, away, dead, pending]:
		check(not list.has(x), "janela P esconde %s (não dá para convidar)" % x.name)
	for x in list:
		check(sim.party_invite_error(me, x) == "", "todo listado aceita convite (%s)" % x.name)
	# no grupo de outro: não é líder, não vê ninguém
	sim.party_invite(ok_bot, me)
	sim.party_accept(me)
	check(sim.party_invite_blocked(me) != "" and sim.party_invitable_near(me).is_empty(), "quem não é líder não vê ninguém para convidar")
	sim.invites.erase(pending.id)
	for x in [me, ok_bot, far_lv, grouped, other, away, dead, pending]:
		if x.party_id >= 0:
			sim.party_leave(x)
		sim.despawn(x)

## Efeito de skill (Events.skill_effect não carrega mapa): durante o tick, Sim.ticking_map diz de que mapa veio,
## e a tela ignora os de outro mapa (antes apareciam no seu, nas coordenadas do outro). Fora do tick volta a "".
func _check_effect_map(gd, sim) -> void:
	var mid := "field_forest"
	if not sim.maps.has(mid):
		sim.load_map(gd.maps[mid])
	var e: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Efeito", mid, Vector3(-60, 0, 20), 10)
	e.brain = null
	var seen: Array = []
	var grab := func(sid: String, o: Vector3, _a: Vector3, _r: float): seen.append([sim.ticking_map, o, sid])
	Events.skill_effect.connect(grab)
	var c := InputCommand.new()
	c.attack = true
	c.aim = e.position + Vector3(0, 0, 2)
	e.basic_cd = 0.0
	sim._apply_command(e, c, sim.maps[mid], 1.0 / 60.0)
	var old_away: int = sim.away_every
	sim.away_every = 1
	for i in range(40):
		sim.tick(1.0 / 60.0)
	sim.away_every = old_away
	Events.skill_effect.disconnect(grab)
	# os outros mapas também têm brigas (bots, guardas; um forte tem luta perto de (-60, 20)): só o básico do bot do teste
	var bsid: String = e.basic_skill.id if e.basic_skill else ""
	var mine: Array = seen.filter(func(x): return x[0] != "" and x[2] == bsid and (x[1] as Vector3).distance_to(e.position) < 3.0)
	check(not mine.is_empty() and mine.all(func(x): return x[0] == mid), "efeito de skill sai marcado com o mapa de quem lançou (%d efeitos: %s)" % [mine.size(), str(mine)])
	check(sim.ticking_map == "", "fora do tick nenhum mapa está rodando")
	sim.despawn(e)

## Sim na thread (WorldSim.threaded): o physics só agenda o tick com o comando do passo; o tick roda na thread e os
## Events dele só chegam no sync (na thread principal). O comando de 1 vez de um passo não se perde nem repete.
func _check_sim_thread(gd) -> void:
	var ws := WorldSim.new()
	var td: MapDef = gd.maps[GameData.town_map_id()]
	ws.load_map(td)
	ws.player = ws.spawn_player(gd.classes["paladin"], "Fio", td.id)
	ws.player.brain = null
	ws.running = true
	ws.threaded = true
	var got: Array = [0]
	var on_note := func(_t: String) -> void: got[0] += 1
	var on_recall := func(_id: int, _ph: String) -> void: got[0] += 1
	Events.notification.connect(on_note)
	Events.recall_cast.connect(on_recall)
	var t0 := ws.tick_count
	var c1 := InputCommand.new()
	c1.recall = true                                  # 1 vez: volta à cidade (ou o aviso de por que não)
	ws.set_player_command(c1)
	ws._physics_process(1.0 / 60.0)
	ws.set_player_command(InputCommand.new())           # o controle já mandou o passo seguinte, sem o recall
	ws._physics_process(1.0 / 60.0)
	check(ws.tick_count == t0, "sim na thread: o physics só agenda (nenhum tick ainda)")
	ws.start_async()
	check(ws._task >= 0 and got[0] == 0, "sim na thread: tick na thread; eventos não chegam antes do sync")
	ws.sync()
	check(ws.tick_count == t0 + 2, "sim na thread: os dois passos rodaram (%d)" % (ws.tick_count - t0))
	check(got[0] == 1, "sim na thread: o recall de 1 vez saiu uma vez só no sync (%d)" % got[0])
	check(Events.deferring_sim == null and Events.pending() == 0, "sim na thread: fila vazia depois do sync")
	Events.notification.disconnect(on_note)
	Events.recall_cast.disconnect(on_recall)
	ws.threaded = false
	ws.free()

func _check_party(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var mk := func(cls: String, nm: String, pos: Vector3, lv: int):
		var b = sim.spawn_bot(gd.classes[cls], nm, "city_aldara", pos, lv)
		return b
	var a = mk.call("bishop", "PA", Vector3(0, 0, 8), 10)
	var b = mk.call("berserker", "PB", Vector3(1.5, 0, 8), 10)
	var c = mk.call("ranger", "PC", Vector3(-1.5, 0, 8), 10)
	var stranger = mk.call("paladin", "PX", Vector3(0, 0, 9.5), 10)
	var made: Array = [a, b, c, stranger]
	check(sim.party_invite_error(a, a) != "", "não convida a si mesmo")
	check(sim.party_invite(a, b), "convite enviado")
	check(sim.party_invite_error(a, b).contains("pendente"), "convite duplicado recusado")
	check(sim.party_accept(b) and a.party_id >= 0 and a.party_id == b.party_id, "aceitar cria o grupo")
	check(sim.party_leader(b) == a and sim.party_members(a).size() == 2, "quem convidou é o líder")
	check(not sim.party_accept(b), "aceitar sem convite não faz nada")
	check(sim.party_invite_error(b, c).contains("líder"), "só o líder convida")
	check(sim.party_invite(a, c) and sim.party_accept(c) and sim.party_members(a).size() == 3, "terceiro membro")
	# limite
	while sim.party_members(a).size() < Balance.PARTY_MAX:
		var x = mk.call("druid", "PF%d" % made.size(), Vector3(made.size(), 0, 12), 10)
		made.append(x)
		sim.party_invite(a, x)
		sim.party_accept(x)
	var extra = mk.call("druid", "PExtra", Vector3(4, 0, 12), 10)
	made.append(extra)
	check(sim.party_invite_error(a, extra).contains("cheio"), "grupo cheio em %d" % Balance.PARTY_MAX)
	for x in made.slice(4):
		sim.party_leave(x)
	check(sim.party_members(a).size() == 3, "membros extras saíram")
	# XP dividida
	var mdef: MonsterDef = null
	for mid in gd.monsters:
		if not gd.monsters[mid].is_boss and gd.monsters[mid].xp > 0:
			mdef = gd.monsters[mid]
			break
	var mob = sim.spawn_monster(mdef, "city_aldara", Vector3(0, 0, 10))
	mob.level = 10
	c.position = Vector3(0, 0, 10 + Balance.PARTY_SHARE_RANGE + 5)
	var sharers: Array = sim.kill_sharers(a, mob)
	check(sharers.size() == 2 and sharers.has(b) and not sharers.has(c), "XP só pra quem está perto (%d)" % sharers.size())
	var xa: int = a.xp
	var xb: int = b.xp
	sim._on_monster_killed(mob, a)
	var each := int(mdef.xp * (1.0 + Balance.PARTY_XP_BONUS) / 2.0)
	check(a.xp - xa == each and b.xp - xb == each, "XP dividida com bônus de grupo (%d e %d, esperado %d)" % [a.xp - xa, b.xp - xb, each])
	b.level = 10 + Balance.PARTY_LEVEL_GAP + 1
	check(not sim.kill_sharers(a, mob).has(b), "diferença de nível grande não divide XP")
	b.level = 10
	c.position = Vector3(-1.5, 0, 8)
	sim.despawn(mob)
	# curas em área: grupo sim, estranho não
	var prayer: SkillDef = sim.resolve_skill(a, gd.skills["bis_prayer"])
	for t in [b, stranger]:
		t.hp = t.stats.max_hp * 0.3
	sim._apply_skill(a, prayer, m)
	check(b.hp > b.stats.max_hp * 0.3, "Prece cura o grupo")
	check(stranger.hp == stranger.stats.max_hp * 0.3, "Prece não cura quem é de fora")
	check(a.is_friend(b) and not a.is_friend(stranger), "is_friend respeita o grupo")
	# invocação herda o grupo
	var sm = sim.spawn_summon(c, mdef, c.position + Vector3(1, 0, 0), 5.0)
	check(sm.party_id == a.party_id and a.is_friend(sm), "invocação é do grupo do dono")
	sim.despawn(sm)
	# bot seguidor: anda até o líder; com o líder em outro mapa, vai pro portal
	a.brain = null
	var f = b
	f.position = a.position + Vector3(12, 0, 0)
	var cmd: InputCommand = f.brain.think(f, sim, m, 0.05)
	var to_leader := Vector2(a.position.x - f.position.x, a.position.z - f.position.z).normalized()
	check(cmd.move.length() > 0.1 and cmd.move.normalized().dot(to_leader) > 0.5, "seguidor anda até o líder")
	var other: String = gd.maps["city_aldara"].portals[0]["target_map"]
	sim._change_map(a, other, gd.maps[other].spawn_point)
	cmd = f.brain.think(f, sim, m, 0.05)
	check(cmd.move.length() > 0.1, "líder em outro mapa: seguidor vai pro portal (%s)" % other)
	sim._change_map(a, "city_aldara", Vector3(0, 0, 8))
	f.position = Vector3(1.5, 0, 8)
	# seguidor cura o grupo
	c.brain = null
	var nb = mk.call("bishop", "PHealer", Vector3(2, 0, 8), 12)
	made.append(nb)
	sim.party_invite(a, nb)
	sim.party_accept(nb)
	nb.learned["bis_heal"] = true
	nb.talents["bis_t_heal_party"] = true          # Curar com raio de 6 m
	nb.ensure_slots()
	nb.skills[5] = gd.skills["bis_heal"]
	nb.cooldowns.clear()
	nb.mp = nb.stats.max_mp
	b.hp = b.stats.max_hp * 0.3
	cmd = nb.brain.think(nb, sim, m, 0.05)
	check(cmd.skill_slot >= 0 and nb.skills[cmd.skill_slot].kind == SkillDef.Kind.HEAL, "bot do grupo cura membro ferido")
	# liderança, expulsar, sair
	check(sim.party_promote(a, c) and sim.party_leader(a) == c, "líder passa a liderança")
	check(not sim.party_kick(a, b), "ex-líder não expulsa")
	check(sim.party_kick(c, nb) and nb.party_id == -1, "líder expulsa")
	sim.party_leave(c)
	check(sim.party_leader(a) != c and sim.party_leader(a) != null, "líder saiu: outro assume")
	var pid: int = a.party_id
	sim.despawn(b)
	check(a.party_id == -1 and not sim.parties.has(pid), "grupo de 1 se desfaz (membro desconectou)")
	# convite de bot: decide sozinho; diferença de nível grande recusa; convite expira
	var far = mk.call("druid", "PFar", Vector3(5, 0, 5), 10 + Balance.PARTY_LEVEL_GAP + 3)
	made.append(far)
	check(not far.brain.wants_party(far, a, sim), "bot recusa grupo com nível muito diferente")
	check(sim.party_invite_error(a, far).contains("nível"), "UI bloqueia convite a bot de nível muito diferente")
	check(not sim.party_invite(a, far) and not sim.invites.has(far.id), "convite fora da faixa de nível nem é enviado")
	far.level = 10
	sim.party_invite(a, far)
	sim.time += 5.0
	sim._update_invites()
	check(not sim.invites.has(far.id), "convite de bot resolvido sozinho")
	if far.party_id >= 0:
		sim.party_leave(far)
	far.level = 10 + Balance.PARTY_LEVEL_GAP + 3
	var pl = sim.player                           # o jogador decide pela UI: o convite só some ao expirar
	check(sim.party_invite(a, pl), "bot convida o jogador")
	sim._update_invites()
	check(sim.invites.has(pl.id), "convite ao jogador espera a resposta")
	sim.time += Balance.PARTY_INVITE_TIME + 1.0
	sim._update_invites()
	check(not sim.invites.has(pl.id) and not sim.party_accept(pl), "convite expira")
	var left := 0
	for x in made:
		if is_instance_valid(x) and x.party_id >= 0:
			left += 1
		sim.despawn(x)
	for pid2 in sim.parties:
		for id in sim.parties[pid2]["members"]:
			check(sim.entities.has(id), "grupo %d só tem membros online" % pid2)
	check(left == 0, "nenhum grupo de teste sobrando (%d)" % left)


