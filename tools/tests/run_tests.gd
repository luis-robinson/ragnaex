	_check_first_set_drops(gd, sim)
	_check_mastery_rebuy(gd, sim)
	_check_status_and_drag(gd, sim)
	_check_buff_visuals(gd, sim)
	_check_hunts(gd, sim)
	_check_looks(gd, sim)
	_check_craft_class(gd, sim)
	_check_away_maps(gd, sim)
	_check_mount(gd, sim)
	_check_paladin_ascension(gd, sim)
	_check_mounted_combat(gd, sim)
	_check_arcane_mode(gd, sim)
