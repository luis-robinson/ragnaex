## Água (shaders/spatial_env_water.gdshader + game/world/water_fx.gd): um material por tipo com o shader novo,
## cor própria da zona respeitada, margem medida das bordas e animações em pool limitado.
func _check_water_shader(gd) -> void:
	var sh := load("res://shaders/spatial_env_water.gdshader")
	check(sh is Shader, "água: shader spatial_env_water carrega")
	var src := FileAccess.get_file_as_string("res://shaders/spatial_env_water.gdshader")
	check(src.contains("ripples[%d]" % WaterFx.MAX_RIPPLES), "água: ondas do shader (ripples[12]) batem com WaterFx.MAX_RIPPLES")
	check(WaterFx.FISH_POOL <= 4 and WaterFx.LEAF_POOL <= 10 and WaterFx.NEAR <= 60.0, "água: efeitos em pool pequeno e só perto do jogador")
	for n in ["water", "water_dark", "icewater", "soulwater", "bile", "agua_mar", "agua_funda_mar", "agua_rasa"]:
		check(WaterFx.is_water(n), "água: %s é água" % n)
	check(not WaterFx.is_water("road") and not WaterFx.is_water("espuma_mar"), "água: estrada e espuma não viram água")
	var def: MapDef = gd.maps["field_coast"]
	var w := WaterFx.new()
	w.def = def
	w._shader = sh
	w._ripples.resize(WaterFx.MAX_RIPPLES)
	var tint: Color = def.water_tints["water_dark"]
	var mg := w.material_for("water_dark", Color.GRAY)
	check(mg.shader == sh and w.material_for("water_dark", Color.GRAY) == mg, "água: um material por tipo (cacheado)")
	var sc: Color = mg.get_shader_parameter("shallow_color")
	check(absf(sc.g - tint.g) < 0.2 and sc.b < 0.6, "água: mangue mantém o verde turvo da zona")
	check(float(w.material_for("soulwater", Color(0.1, 0.3, 0.2)).get_shader_parameter("glow_amount")) > 0.0, "água: poço de almas brilha")
	check(float(w.material_for("icewater", Color(0.05, 0.1, 0.18)).get_shader_parameter("flow_speed")) < 1.0, "água: gelo quase parado")
	check(not w.natural, "água: gelo/almas/bile sem peixe nem folha")
	w.free()
	# margem: quadrado de 10 m centrado na origem; texel colado na borda ~0, centro (5 m) longe do carimbo de 8 m = valor < 255 só perto
	var segs := PackedVector2Array([Vector2(-5, -5), Vector2(5, -5), Vector2(5, -5), Vector2(5, 5), Vector2(5, 5), Vector2(-5, 5), Vector2(-5, 5), Vector2(-5, -5)])
	var size := Vector2i(40, 40)
	var by := WaterFx.bake_bytes(segs, Vector2(-10, -10), size)
	check(by[20 * 40 + 10] <= 12, "água: texel na borda tem distância ~0")
	var mid: int = by[20 * 40 + 20]
	check(mid > 100 and mid < 200, "água: centro a 5 m da borda (%d)" % mid)
	check(by[0] == 255 or by[0] > 150, "água: longe da margem fica claro")
	# mapas de zona: o GLB ganha o material novo
	for mid_ in ["field_coast", "city_aldara"]:
		var root := MapBuilder.build(gd.maps[mid_])
		var n := 0
		for mi in root.find_children("*", "MeshInstance3D", true, false):
			for i in range((mi as MeshInstance3D).mesh.get_surface_count()):
				var m := (mi as MeshInstance3D).get_surface_override_material(i)
				if m is ShaderMaterial and (m as ShaderMaterial).shader == sh:
					n += 1
		check(n > 0, "água: %s usa o shader de água (%d superfícies)" % [mid_, n])
		var wf: WaterFx = root.get_meta("water_fx") if root.has_meta("water_fx") else null
		check(wf != null, "água: %s tem WaterFx" % mid_)
		if wf:
			wf.finish_now()
		root.free()

## Acabamento das zonas do Ato II (tools/blender/zones/dress.py): o detalhe vem em lotes por célula com a cor no vértice.
## Lote sem COLOR_0 apareceria branco no jogo; lote por peça (em vez de por célula) estouraria os draw calls.
const DRESSED_MAPS := ["field_coast", "city_port", "dg_goblin", "field_steppe", "fort_trolls", "fort_fire", "fort_war", "field_kharzun"]
const DRESS_MAX_MESHES := 260
func _check_zone_dress(gd) -> void:
	for mid in DRESSED_MAPS:
		var md: MapDef = gd.maps[mid]
		var f := FileAccess.open("res://assets/models/%s.glb" % md.model, FileAccess.READ)
		if f == null:
			check(false, "%s: %s.glb existe" % [mid, md.model])
			continue
		f.seek(12)                                  # cabeçalho do GLB; depois vem o pedaço JSON (tamanho, tipo, texto)
		var n := f.get_32()
		f.get_32()
		var doc: Dictionary = JSON.parse_string(f.get_buffer(n).get_string_from_utf8())
		var mats: Array = doc.get("materials", [])
		var det := 0
		var bare := 0
		for mesh in doc.get("meshes", []):
			for prim in mesh.get("primitives", []):
				var mi: int = int(prim.get("material", -1))
				var mname: String = str(mats[mi].get("name", "")) if mi >= 0 and mi < mats.size() else ""
				if mname.begins_with("det_vcol"):
					det += 1
					if not (prim.get("attributes", {}) as Dictionary).has("COLOR_0"):
						bare += 1
		check(det > 0, "%s: tem os lotes de acabamento (det_vcol)" % mid)
		check(bare == 0, "%s: todo lote de acabamento leva a cor no vértice (%d sem COLOR_0)" % [mid, bare])
		check(det <= DRESS_MAX_MESHES, "%s: lotes de acabamento por célula, não por peça (%d, máx %d)" % [mid, det, DRESS_MAX_MESHES])

## Pedreira dos Golens (Floresta, 11-15): entrada na floresta, 2 guardiões no mapa e o Coração atrás do selo,
## golens comuns na faixa, chefes com modelo próprio, lacaios sem XP, material com fonte.
func _check_quarry(gd, sim) -> void:
	var fd: MapDef = gd.maps["field_forest"]
	check(fd.portals.any(func(p): return p["target_map"] == "dg_pedreira"), "Floresta tem a entrada da Pedreira")
	var pd: MapDef = gd.maps["dg_pedreira"]
	check(pd.parent_map == "field_forest" and pd.level_range == Vector2i(11, 15), "Pedreira é dungeon 11-15 da Floresta")
	var bosses := {}
	for mid in ["dg_pedreira", "dg_pedreira_coracao"]:
		for sp in gd.maps[mid].spawners:
			var m: MonsterDef = gd.monsters[sp["monster_id"]]
			if m.is_boss:
				bosses[m.id] = mid
			else:
				check(m.level >= 11 and m.level <= 15 and m.xp > 0, "%s: %s na faixa 11-15 com XP" % [mid, m.id])
	check(bosses.size() >= 3, "Pedreira tem 3+ chefes (%s)" % str(bosses.keys()))
	for bid in ["golem_ancient", "crystal_warden", "quarry_heart"]:
		var b: MonsterDef = gd.monsters[bid]
		check(b.model == "mob_" + bid or b.model.begins_with("mob_") and ResourceLoader.exists("res://assets/models/%s.glb" % b.model), "%s tem modelo próprio" % bid)
		for ph in b.phases:
			if ph.has("summon"):
				var add: MonsterDef = gd.monsters[ph["summon"]["id"]]
				check(add.xp == 0 and add.loot_table == "", "lacaio %s sem XP nem loot" % add.id)
	var gate: Dictionary = MapsCatalog.PORTAL_GATES.get("to_dg_pedreira_coracao", {})
	check(gate.get("bosses", []) == ["golem_ancient", "crystal_warden"], "Coração da Pedreira abre com os dois guardiões")
	var drops := false
	for mid in ["golem_moss", "golem_stone", "golem_shard"]:
		var lt: LootTable = gd.loot_tables[gd.monsters[mid].loot_table]
		drops = drops or lt.entries.any(func(en): return en["item"] == "stone_core")
	check(drops and gd.items.has("stone_core"), "golens dão Núcleo de Pedra")

## Invocações lutam sozinhas: acham alvo perto do dono, usam as skills do monstro, defendem o dono
## e as que atiram ficam longe (o Elemental de Fogo ficava parado). Sonda completa: tools/tests/pet_probe.tscn.
## Invocação permanente presa longe (atrás de muro/rio, fora da tela) não trava a skill: refazer a skill chama de novo
## perto do dono, e a que ficou a mais de SUMMON_TELEPORT m aparece ao lado dele sozinha.
## Antes: "Seu companheiro já está com você" com o lince vivo a 40 m, sem jeito de chamar de volta.
func _check_summon_lost(gd, sim) -> void:
	var m: Dictionary = sim.maps.get("city_aldara", {})
	if m.is_empty():
		m = sim.load_map(gd.maps["city_aldara"])
	var dt := 1.0 / 60.0
	var e: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Perdido", "city_aldara", Vector3(0, 0, 6), 30)
	e.brain = null
	e.build_id = "cacador"
	sim._gear_bot(e)
	sim._skill_bot(e)
	var s: SkillDef = gd.skills["ran_companion"]
	e.learned[s.id] = true
	e.skills[0] = s
	var slot := 0
	var far_pet: SimEntity = sim.spawn_summon(e, gd.monsters["companion"], e.position + Vector3(40, 0, 0), 0.0, true)
	far_pet.brain = null
	check(not sim._summons_full(e, s), "companheiro preso a 40 m não conta como 'já está com você'")
	e.mp = e.stats.max_mp
	e.cooldowns.clear()
	var ok: bool = sim.try_cast(e, slot, e.position + Vector3(0, 0, 3), m)
	for i in range(60):
		sim._update_entity(e, m, dt)
	var near := 0
	var alive := 0
	for o in m["entities"]:
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id and o.is_alive():
			alive += 1
			if o.position.distance_to(e.position) < Balance.SUMMON_LEASH:
				near += 1
	check(ok and near == 1 and alive == 1, "refazer a skill chama o companheiro perto do dono e dispensa o perdido (perto %d, vivos %d)" % [near, alive])
	# sozinho: longe demais (sem briga), aparece ao lado do dono
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id:
			sim.despawn(o)
	var stray: SimEntity = sim.spawn_summon(e, gd.monsters["companion"], e.position + Vector3(Balance.SUMMON_TELEPORT + 4.0, 0, 0), 0.0, true)
	stray.brain = null
	sim._update_entity(stray, m, dt)
	check(stray.position.distance_to(e.position) < 4.0, "companheiro a mais de SUMMON_TELEPORT m aparece ao lado do dono (%.1f m)" % stray.position.distance_to(e.position))
	var close: SimEntity = sim.spawn_summon(e, gd.monsters["companion"], e.position + Vector3(10, 0, 0), 0.0, true)
	close.brain = null
	var before := close.position
	sim._update_entity(close, m, dt)
	check(close.position.distance_to(before) < 1.0, "companheiro perto não é teletransportado")
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id:
			sim.despawn(o)
	sim.despawn(e)

func _check_summon_ai(gd, sim) -> void:
	var mid := "field_forest"
	var m: Dictionary = sim.maps.get(mid, {})
	if m.is_empty():
		m = sim.load_map(gd.maps[mid])
	var at := Vector3(-90, 0, 9)
	for o in m["entities"].duplicate():           # mapa pode já estar carregado com monstros (outro teste): limpa a área
		if o.kind == SimEntity.Kind.MONSTER and o.position.distance_to(at) < 30.0:
			sim.despawn(o)
	var owner = sim.spawn_bot(gd.classes["elementalist"], "Dono", mid, at, 20)
	owner.brain = null
	for pid in ["fire_elemental", "frost_elemental"]:
		var pet = sim.spawn_summon(owner, gd.monsters[pid], at + Vector3(1, 0, 0), 0.0)
		check(pet.skills.size() >= 1 and pet.stats.matk == pet.stats.patk, "%s: carrega as skills e usa o ataque do dono na magia" % pid)
		var dummy = sim.spawn_monster(gd.monsters["wolf"], mid, at + Vector3(8, 0, 0))
		dummy.brain = null
		dummy.stats.max_hp = 50000.0
		dummy.hp = 50000.0
		var near := 0.0
		var nn := 0
		for i in range(60):
			sim.tick(0.05)
			if pet.aggro_target == dummy.id and i >= 30:      # depois de se posicionar: distância média
				near += pet.position.distance_to(dummy.position)
				nn += 1
		near /= maxf(1.0, nn)
		check(dummy.hp < dummy.stats.max_hp, "%s ataca sozinho um monstro perto do dono" % pid)
		if gd.monsters[pid].ranged:
			check(near > 3.0, "%s atira de longe (%.1f m)" % [pid, near])
		sim.despawn(dummy)
		var wolf = sim.spawn_monster(gd.monsters["wolf"], mid, at + Vector3(-5, 0, 0))
		wolf.aggro_target = owner.id
		wolf.stats.max_hp = 50000.0               # não morre antes de a invocação virar (o outro elemental também bate)
		wolf.hp = 50000.0
		var defends := false
		for i in range(40):
			sim.tick(0.05)
			defends = defends or pet.aggro_target == wolf.id
		check(defends, "%s defende o dono de quem o ataca" % pid)
		sim.despawn(wolf)
		owner.position = at + Vector3(-30, 0, 0)       # dono se afasta: larga a briga e volta
		var d2 = sim.spawn_monster(gd.monsters["wolf"], mid, at + Vector3(8, 0, 0))
		d2.brain = null
		pet.position = at + Vector3(6, 0, 0)
		pet.aggro_target = d2.id
		pet.brain.skill_rethink = 0.0
		pet.brain.think(pet, sim, sim.maps[mid], 0.05)
		check(pet.aggro_target != d2.id, "%s: coleira no dono (larga alvo longe)" % pid)
		sim.despawn(d2)
		owner.position = at
		sim.despawn(pet)
	sim.despawn(owner)

## Seta da quest no minimapa: toda quest do catálogo tem um objetivo num mapa real, a seta acha o caminho
## (portal) de onde a quest é dada, e a quest pronta aponta para quem recebe.
## Arrastar para a barra: poção da bolsa em F1-F3 (sem duplicar, F↔F troca), skill em 1-6 (troca de lugar).
func _check_hotbar_drag(gd, sim) -> void:
	var H = load("res://game/ui/hud.gd")
	var p = sim.spawn_bot(gd.classes["paladin"], "Barra", "city_aldara", Vector3(0, 0, 4), 10)
	sim.set_potion_slot(p, 0, "potion_hp_s"); sim.set_potion_slot(p, 1, "potion_mp_s"); sim.set_potion_slot(p, 2, "")
	check(H.potion_drop_ok({"rx_drag": "bag", "item": "potion_hp_m"}), "poção da bolsa cabe em F")
	var gear := ""
	for iid in gd.items:
		if gd.items[iid].is_equipment():
			gear = iid
			break
	check(not H.potion_drop_ok({"rx_drag": "bag", "item": gear}), "equipamento não cabe em F")
	H.drop_potion(p, {"rx_drag": "bag", "item": "potion_hp_m"}, 2)
	check(p.potion_slots[2] == "potion_hp_m", "bolsa → F3")
	H.drop_potion(p, {"rx_drag": "bag", "item": "potion_hp_s"}, 2)
	check(p.potion_slots.count("potion_hp_s") == 1 and p.potion_slots[2] == "potion_hp_s" and p.potion_slots[0] == "potion_hp_m", "mesma poção não fica em dois F (troca)")
	H.drop_potion(p, {"rx_drag": "potion", "item": "potion_mp_s", "from": 1}, 0)
	check(p.potion_slots[0] == "potion_mp_s" and p.potion_slots[1] == "potion_hp_m", "F2 → F1 troca os dois")
	var known: Array = []
	for sid in p.class_def.skill_ids:
		if p.knows(sid):
			known.append(sid)
	if known.size() >= 2:
		var a: String = known[0]
		var b2: String = known[1]
		sim.set_skill_slot(p, 0, a); sim.set_skill_slot(p, 1, b2)
		check(sim.set_skill_slot(p, 1, a) and p.skills[1].id == a and p.skills[0] != null and p.skills[0].id == b2, "skill arrastada para slot ocupado troca de lugar")
	sim.despawn(p)

