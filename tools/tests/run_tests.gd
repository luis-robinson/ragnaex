	for x in [boss, boar, king, e]:
		sim.despawn(x)

## /party (bots do mapa convidam um por vez), depósito (guardar/tirar, perto do NPC, salva) e a cor do monstro de modelo emprestado.
func _check_party_seek_storage(gd, sim, save) -> void:
	var town: Vector3 = sim.maps["city_aldara"]["def"].town_center
	var me: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Procura", "city_aldara", town + Vector3(2, 0, 2), 10)
	me.brain = null
	var helpers: Array = []
	for i in range(3):
		var b: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Ajuda%d" % i, "city_aldara", town + Vector3(3 + i, 0, 3), 10)
		helpers.append(b)
	var n: int = sim.party_seek_start(me)
	check(n >= 2 and n <= Balance.PARTY_SEEK_MAX, "/party: bots do mapa se oferecem (%d)" % n)
	check(sim.party_seek_start(me) == -2, "/party tem tempo de espera")
	for i in range(30):
		sim._update_invites()
		sim.time += 0.1
		if sim.invites.has(me.id):
			sim.invites[me.id]["decide_at"] = sim.time + 100.0     # quem decide é o teste (aqui ele é um bot)
	check(sim.invites.has(me.id), "/party: chega um convite")
	var first: int = sim.invites[me.id]["from"]
	sim.party_decline(me)
	for i in range(15):
		sim._update_invites()
		sim.time += 0.1
		if sim.invites.has(me.id):
			sim.invites[me.id]["decide_at"] = sim.time + 100.0
	check(sim.invites.has(me.id) and sim.invites[me.id]["from"] != first, "/party: recusou → o próximo convida")
	sim.party_accept(me)
	check(me.party_id >= 0, "/party: aceitar entra no grupo")
	sim.party_leave(me)
	for b in helpers:
		if b.party_id >= 0:
			sim.party_leave(b)
		sim.despawn(b)
	# depósito
	var st: Dictionary = {}
	for npc in gd.maps["city_aldara"].npcs:
		if npc["role"] == "storage":
			st = npc
	check(not st.is_empty(), "Aldara tem o Guarda-volumes")
	if not st.is_empty():
		check(not sim._point_in_solid(st["pos"], sim.maps["city_aldara"]), "Guarda-volumes em chão livre")
		me.position = st["pos"] + Vector3(0, 0, 1.5)
	me.inventory = {"iron_ore": 5}
	me.storage = {}
	check(sim.storage_deposit(me, "iron_ore", 3) and int(me.inventory.get("iron_ore", 0)) == 2 and int(me.storage.get("iron_ore", 0)) == 3, "depósito guarda")
	check(not sim.storage_deposit(me, "iron_ore", 5), "não guarda mais do que tem")
	check(sim.storage_withdraw(me, "iron_ore", 3) and not me.storage.has("iron_ore") and int(me.inventory["iron_ore"]) == 5, "depósito devolve")
	me.position = town + Vector3(20, 0, 20)
	check(not sim.storage_deposit(me, "iron_ore", 1), "longe do NPC não guarda")
	me.storage = {"wolf_pelt": 4}
	save.save_player(me)
	var d: Dictionary = save.load_data()
	check(int(d.get("storage", {}).get("wolf_pelt", 0)) == 4, "save guarda o depósito")
	save.delete_slot(TEST_SLOT)
	sim.despawn(me)
	# cor: Slime Azul fica azul; o Slime (dono do modelo) não muda; olho não muda
	var green := Color("adf1b8")
	var blue := EntityView.monster_tint(gd.monsters["slime_blue"], green, "m_slime_mob_slime")
	check(blue.b > blue.g and blue.b > blue.r, "Slime Azul é azul (%s)" % blue.to_html(false))
	check(EntityView.monster_tint(gd.monsters["slime"], green, "m_slime_mob_slime").is_equal_approx(green), "Slime comum mantém a cor do modelo")
	check(EntityView.monster_tint(gd.monsters["slime_blue"], Color("504559"), "m_eye").is_equal_approx(Color("504559")), "olho não muda de cor")

## Grupo segue o líder pelo portal e reaparece ao lado dele se ficar preso; Rei surge após muitos abates com lendário garantido.
func _check_party_follow_elite(gd, sim) -> void:
	var lead: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Lider", "city_aldara", Vector3(60, 0, 10), 8)
	lead.brain = null
	var mate: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Ajudante", "city_aldara", Vector3(63, 0, 10), 8)
	var far: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Longe", "field_forest" if sim.maps.has("field_forest") else "city_aldara", Vector3(0, 0, 0), 8)
	sim.party_invite(lead, mate)
	sim.party_accept(mate)
	sim.party_invite(lead, far)
	sim.party_accept(far)
	var dg := ""
	for mid in gd.maps:
		if gd.maps[mid].parent_map == "city_aldara":
			dg = mid
	check(dg != "", "há dungeon saindo do Vale")
	if dg != "":
		sim._pending_map_changes.append({"e": lead, "map": dg, "pos": Vector3.ZERO})
		sim._process_map_changes()
		check(lead.map_id == dg and mate.map_id == dg, "bot do grupo passa pelo portal com o líder")
		check(mate.position.distance_to(lead.position) < 4.0, "e chega ao lado dele")
		if far.map_id != dg:
			for i in range(int(Balance.PARTY_CATCHUP_TIME / 0.5) + 2):
				sim._party_catchup(0.5)
			sim._process_map_changes()
			check(far.map_id == dg, "bot preso em outro mapa reaparece ao lado do líder")
	for x in [mate, far]:
		sim.party_leave(x)
	for x in [lead, mate, far]:
		sim.despawn(x)
	# jogador que aceita convite de bot passa a liderar (os bots seguem o jogador)
	var pl: SimEntity = sim.player
	if pl and pl.party_id >= 0:
		sim.party_leave(pl)
	if pl:
		var host: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Anfitriao", pl.map_id, pl.position + Vector3(2, 0, 0), pl.level)
		var other: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Outro", pl.map_id, pl.position + Vector3(3, 0, 0), pl.level)
		sim.party_invite(host, other)
		sim.party_accept(other)
		sim.invites.erase(pl.id)
		sim.party_invite(host, pl)
		sim.party_accept(pl)
		check(sim.party_leader(other) == pl, "convite de bot aceito: o jogador lidera e os bots o seguem")
		for x in [other, host, pl]:
			if x.party_id >= 0:
				sim.party_leave(x)
		sim.despawn(host)
		sim.despawn(other)
	# Rei: 40 abates de slime no mesmo mapa
	var m: Dictionary = sim.maps["city_aldara"]
	var hunter: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Cacador", "city_aldara", Vector3(10, 0, 60), 6)
	hunter.brain = null
	m["kills"].erase("slime")
	m["elites"].erase("slime")
	var king: SimEntity = null
	for i in range(Balance.ELITE_KILLS):
		var s: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(10, 0, 62))
		s.brain = null
		s.damage_by = {hunter.id: 999.0}
		sim._on_monster_killed(s, hunter)
		sim.despawn(s)
	var kid: int = int(m["elites"].get("slime", -1))
	king = sim.entities.get(kid)
	check(king != null and king.monster_def.elite_of == "slime", "%d abates de slime fazem surgir o Rei Slime" % Balance.ELITE_KILLS)
	if king:
		var base: MonsterDef = gd.monsters["slime"]
		check(is_equal_approx(king.monster_def.hp, base.hp * Balance.ELITE_HP_MULT) and king.monster_def.scale > base.scale, "Rei: 5x vida e maior")
		check(is_equal_approx(sim.legendary_chance(king), 1.0), "Rei: lendário garantido")
		var got := ""
		for t in range(5):
			got = sim.roll_legendary(hunter, king)
			if got != "":
				break
		check(got == "legend_coin", "Rei Slime solta Moeda Lendária (%s)" % got)
		sim.despawn(king)
	sim.despawn(hunter)

## Volta à cidade (G) é conjuração: em combate começa e chega; levar dano ou ser atordoado interrompe (com aviso),
## barreira que segura o golpe inteiro não interrompe; começar andando não vale; bot (comando da sim) também volta.
func _check_recall_cast(gd, sim) -> void:
	var town: String = gd.town_map_id()
	var m: Dictionary = sim.maps["city_aldara"]
	var e: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Lareira", "city_aldara", Vector3(70, 0, 10), 12)
	e.brain = null
	var mob: SimEntity = sim.spawn_monster(gd.monsters["slime"], "city_aldara", Vector3(73, 0, 10))
	mob.brain = null
	var go := InputCommand.new()
	go.recall = true
	var idle := InputCommand.new()
	var phases: Array = []
	var on_phase := func(id: int, ph: String): phases.append(ph if id == e.id else "")
	Events.recall_cast.connect(on_phase)
	check(Balance.RECALL_TIME >= 3.0 and Balance.RECALL_TIME <= 4.0, "volta: conjuração de 3-4 s (%.1f)" % Balance.RECALL_TIME)
	# em combate: começa; levar dano interrompe
	e.combat_timer = 5.0
	sim._apply_command(e, go, m, 0.05)
	check(e.recall_left > 0.0 and phases.has("start"), "volta: começa em combate")
	check(sim.recall_progress(e) >= 0.0 and sim.recall_progress(e) < 0.1, "volta: progresso começa perto de 0")
	sim._apply_command(e, idle, m, 1.0)
	check(sim.recall_progress(e) > 0.2, "volta: progresso sobe (%.2f)" % sim.recall_progress(e))
	sim._deal_damage(mob, e, 30, false, false, "physical")
	check(is_equal_approx(e.recall_left, 0.0) and phases.has("interrupted"), "volta: levar dano interrompe")
	# barreira que segura tudo: não interrompe
	sim._apply_command(e, go, m, 0.05)
	e.shield_hp = 500.0
	sim._deal_damage(mob, e, 30, false, false, "physical")
	check(e.recall_left > 0.0, "volta: dano todo na barreira não interrompe")
	e.shield_hp = 0.0
	# atordoado: interrompe
	e.set_state(SimEntity.State.STUNNED, 1.0)
	sim._apply_command(e, idle, m, 0.05)
	check(is_equal_approx(e.recall_left, 0.0), "volta: atordoado interrompe")
	e.set_state(SimEntity.State.IDLE)
	# começar correndo não vale; G de novo cancela
	var run_go := InputCommand.new()
	run_go.recall = true
	run_go.move = Vector2(1, 0)
	sim._apply_command(e, run_go, m, 0.05)
	check(is_equal_approx(e.recall_left, 0.0), "volta: não começa correndo")
	sim._apply_command(e, go, m, 0.05)
	sim._apply_command(e, go, m, 0.05)
	check(is_equal_approx(e.recall_left, 0.0) and phases.has("cancel"), "volta: G de novo cancela")
	# montado: desce e conjura
	e.mounted = true
	sim._apply_command(e, go, m, 0.05)
	check(e.recall_left > 0.0 and not e.mounted, "volta: montado desce e conjura")
	# completa em combate (bot pelo comando da sim) e chega na cidade
	e.combat_timer = 5.0
	for i in range(int(Balance.RECALL_TIME / 0.1) + 2):
		sim._apply_command(e, idle, m, 0.1)
	sim._process_map_changes()
	check(phases.has("done") and e.map_id == town and e.position.distance_to(gd.maps[town].spawn_point) < 0.5, "volta: bot conjura em combate e chega na cidade")
	Events.recall_cast.disconnect(on_phase)
	sim.despawn(mob)
	sim.despawn(e)

## F1-F3 têm recarga própria: poção de vida no F1 não trava a de mana no F2.
func _check_potion_slot_cooldowns(gd, sim) -> void:
	var e: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Frascos", "city_aldara", Vector3(66, 0, 12), 10)
	e.brain = null
	e.add_item("potion_hp_s", 3)
	e.add_item("potion_mp_s", 3)
	sim.set_potion_slot(e, 0, "potion_hp_s"); sim.set_potion_slot(e, 1, "potion_mp_s"); sim.set_potion_slot(e, 2, "")
	e.potion_cd = 0.0
	e.hp = e.stats.max_hp * 0.5
	e.mp = e.stats.max_mp * 0.2
	check(sim.use_potion(e, 0), "F1: bebe a de vida")
	check(e.potion_cds[0] > 0.0 and is_equal_approx(e.potion_cds[1], 0.0), "F1 entra em recarga, F2 não")
	check(sim.use_potion(e, 1), "F2: de mana mesmo com F1 em recarga")
	check(not sim.use_potion(e, 0), "F1 em recarga não bebe de novo")
	check(e.potion_cd == e.potion_cds[0], "potion_cd (bots) = recarga do F1")
	for i in range(int(maxf(gd.items["potion_hp_s"].consume_cooldown, gd.items["potion_mp_s"].consume_cooldown) * 20) + 4):
		sim._update_entity(e, sim.maps["city_aldara"], 0.05)
	check(e.potion_cds[0] <= 0.0 and e.potion_cds[1] <= 0.0, "recargas dos F acabam sozinhas")
	e.potion_cd = 99.0
	check(e.potion_cds.all(func(c): return c == 99.0), "escrever potion_cd trava os três")
	e.potion_cd = 0.0
	sim.despawn(e)

## Barreira (vida temporária) nas barras: texto "(+N)" e faixa depois da vida, ou no fim da barra se passar do máximo.
func _check_shield_bar(gd, sim) -> void:
	check(ShieldOverlay.hp_text(540, 800, 120) == "540 / 800 (+120)", "barra: texto com barreira")
	check(ShieldOverlay.hp_text(540, 800, 0) == "540 / 800", "barra: texto sem barreira")
	var a := ShieldOverlay.span_of(400, 200, 800)
	check(is_equal_approx(a.x, 0.5) and is_equal_approx(a.y, 0.75) and a.z == 0.0, "barra: barreira logo depois da vida")
	var b := ShieldOverlay.span_of(700, 200, 800)
	check(is_equal_approx(b.x, 0.75) and is_equal_approx(b.y, 1.0) and b.z == 1.0, "barra: passou do máximo encosta no fim")
	check(ShieldOverlay.span_of(700, 0, 800) == Vector3.ZERO, "barra: sem barreira, sem faixa")
	# a Armadura de Gelo dá barreira, e é ela que a barra lê
	var e: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Gelo", "city_aldara", Vector3(64, 0, 8), 20)
	e.brain = null
	if gd.skills.has("ele_frost_armor"):
		sim._apply_effects(e, e, gd.skills["ele_frost_armor"].effects, 1.0)
		check(e.shield_hp > 0.0, "Armadura de Gelo põe barreira (%d)" % int(e.shield_hp))
		check(ShieldOverlay.hp_text(e.hp, e.stats.max_hp, e.shield_hp).ends_with("(+%d)" % int(e.shield_hp)), "barra do jogador mostra a barreira da Armadura de Gelo")
	sim.despawn(e)

## G volta à cidade: conjuração de RECALL_TIME s (vale em combate); andar cancela. Lendário é pessoal (cada membro do grupo rola o seu).
func _check_recall_and_personal_loot(gd, sim) -> void:
	var town: String = gd.town_map_id()
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Volta", "city_aldara", Vector3(70, 0, 10), 8)
	e.brain = null
	var go := InputCommand.new()
	go.recall = true
	var idle := InputCommand.new()
	sim._update_recall(e, go, go, 0.1)
	check(e.recall_left > 0.0, "G começa a volta à cidade")
	var walk := InputCommand.new()
	walk.move = Vector2(1, 0)
	sim._update_recall(e, walk, walk, 0.1)
	check(is_equal_approx(e.recall_left, 0.0), "andar cancela a volta")
	sim._update_recall(e, go, go, 0.1)
	for i in range(int(Balance.RECALL_TIME / 0.1) + 2):
		sim._update_recall(e, idle, idle, 0.1)
	sim._process_map_changes()
	check(e.map_id == town and e.position.distance_to(gd.maps[town].spawn_point) < 0.5, "parado 3 s: chega na cidade")
	e.position = Vector3(70, 0, 10)
	e.combat_timer = 3.0
	sim._update_recall(e, go, go, 0.1)
	check(e.recall_left > 0.0, "em combate também começa a volta (o dano é que interrompe)")
	e.recall_left = 0.0
	e.combat_timer = 0.0
	sim.despawn(e)
	# lendário pessoal: chefe com dois do grupo → cada um rola o seu
	var a: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Um", "city_aldara", Vector3(80, 0, 14), 6)
	var b: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Dois", "city_aldara", Vector3(81, 0, 14), 6)
	sim.party_invite(a, b)
	sim.party_accept(b)
	var king: SimEntity = sim.spawn_monster(sim.elite_def(gd.monsters["boar"]), "city_aldara", Vector3(82, 0, 14))
	king.brain = null
	king.damage_by = {a.id: 500.0, b.id: 400.0}
	var m: Dictionary = sim.maps["city_aldara"]
	var before: int = m["loot"].size()
	sim._on_monster_killed(king, a)
	var owners := {}
	for l in m["loot"].slice(before):
		if l["item"] == "legend_coin":
			owners[l["owner"]] = int(l["count"])
	check(owners.has(a.id) and owners.has(b.id), "Rei: cada membro do grupo ganha as suas moedas lendárias (%d donos)" % owners.size())
	check(int(owners.get(a.id, 0)) == Balance.LEGENDARY_COINS_BOSS, "chefe/Rei: %d moedas" % Balance.LEGENDARY_COINS_BOSS)
	# Relicária: troca moedas por peça da classe, preço pelo tier
	var npc: Dictionary = {}
	for n in gd.maps["city_aldara"].npcs:
		if n["role"] == "relic":
			npc = n
	check(not npc.is_empty() and not sim._point_in_solid(npc["pos"], m), "Aldara tem a Relicária em chão livre")
	var buyer: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Compra", "city_aldara", npc.get("pos", Vector3.ZERO) + Vector3(0, 0, 1.5), 12)
	buyer.brain = null
	var offer: Array = sim.relic_offer(buyer)
	var t5: Array = offer.filter(func(i): return gd.items[i].level_req == 5)
	var t10: Array = offer.filter(func(i): return gd.items[i].level_req == 10)
	check(t5.size() >= 6 and t10.size() >= 6, "Relicária oferece peças da classe por nível (%d no 5, %d no 10)" % [t5.size(), t10.size()])
	check(offer.any(func(i): return gd.items[i].weapon_type == "shield"), "paladino também troca escudos nomeados")
	check(sim.relic_cost(gd.items[t5[0]]) == 1 and sim.relic_cost(gd.items[t10[0]]) == 2, "nível 5 = 1 moeda, nível 10 = 2")
	buyer.inventory = {"legend_coin": 2}
	check(sim.relic_exchange(buyer, t10[0]) and buyer.has_item(t10[0]) and not buyer.inventory.has("legend_coin"), "troca 2 moedas por peça nível 10")
	buyer.add_item("legend_coin", 5)
	var t15: Array = offer.filter(func(i): return gd.items[i].level_req == 15)
	check(sim.relic_block_reason(buyer, t15[0]).begins_with("requer nível"), "peça acima do nível: não troca")
	buyer.position += Vector3(30, 0, 0)
	check(sim.relic_block_reason(buyer, t5[0]) == "fale com a Relicária", "longe da Relicária: não troca")
	# conjunto de uma vez: só as peças de armadura que faltam (vestida, bolsa ou depósito, +N conta), moedas × peças
	buyer.position -= Vector3(30, 0, 0)
	var sid10: String = gd.set_id_for("paladin", gd.classes["paladin"].builds[0]["id"], 10)
	var sd10: SetDef = gd.sets[sid10]
	buyer.inventory = {sd10.armor[0]: 1, "legend_coin": 20}
	buyer.storage = {GameData.plus_item(gd.items[sd10.armor[1]], 3).id: 1}
	var miss: Array = sim.relic_set_missing(buyer, sid10)
	check(miss.size() == sd10.armor.size() - 2 and not (sd10.armor[0] in miss) and not (sd10.armor[1] in miss), "conjunto: faltam %d peças (bolsa e depósito +3 contam)" % miss.size())
	var got: int = sim.relic_exchange_set(buyer, sid10)
	check(got == miss.size() and int(buyer.inventory.get("legend_coin", 0)) == 20 - 2 * got and sd10.armor.all(func(pid): return sim.owns_item(buyer, pid)), "troca o que falta por 2 moedas cada (%d peças)" % got)
	check(sim.relic_set_block_reason(buyer, sid10) == "você já tem as peças do conjunto" and sim.relic_exchange_set(buyer, sid10) == 0, "conjunto completo: não troca de novo")
	check(not sd10.pieces.any(func(pid): return not (pid in sd10.armor) and buyer.has_item(pid)), "a arma do conjunto não entra na troca do conjunto")
	var sid15: String = gd.set_id_for("paladin", gd.classes["paladin"].builds[0]["id"], 15)
	check(sim.relic_set_block_reason(buyer, sid15).begins_with("requer nível"), "conjunto acima do nível: não troca")
	buyer.inventory = {"legend_coin": 3}
	check(sim.relic_exchange_set(buyer, gd.set_id_for("paladin", gd.classes["paladin"].builds[1]["id"], 10)) == 0, "conjunto sem moedas para todas: não troca nada")
	check(int(buyer.inventory.get("legend_coin", 0)) == 3, "falha na troca do conjunto não gasta moeda")
	var wear_build: String = gd.classes["paladin"].builds[2]["id"]
	buyer.build_id = ""
	buyer.tree = {}
	buyer.equipment[ItemDef.Slot.HEAD] = gd.items[gd.sets[gd.set_id_for("paladin", wear_build, 5)].armor[0]]
	check(sim.relic_default_build(buyer) == wear_build, "Relicária abre na build do conjunto que você veste")
	buyer.equipment.erase(ItemDef.Slot.HEAD)
	buyer.storage = {}
	buyer.inventory = {"legend_coin": 3, "slime_gel": 2}
	BotBrain.new()._sell_materials(buyer)
	check(int(buyer.inventory.get("legend_coin", 0)) == 3 and not buyer.inventory.has("slime_gel"), "bot vende material mas guarda a moeda")
	sim.despawn(buyer)
	sim.party_leave(b)
	for x in [king, a, b]:
		sim.despawn(x)

## Grupo: o jogador recebe saque pessoal a cada abate dividido, mesmo sem bater; item dos outros só aparece quando fica livre.
func _check_party_personal_loot(gd, sim) -> void:
	var pl: SimEntity = sim.player
	if pl == null:
		return
	if pl.party_id >= 0:
		sim.party_leave(pl)
	var keep_pos := pl.position
	var bot: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Batedor", pl.map_id, pl.position + Vector3(2, 0, 0), pl.level)
	bot.brain = null
	sim.party_invite(bot, pl)
	sim.party_accept(pl)
	var m: Dictionary = sim.maps[pl.map_id]
	var got := 0
	for i in range(20):
		var mob: SimEntity = sim.spawn_monster(gd.monsters["boar"], pl.map_id, pl.position + Vector3(3, 0, 0))
		mob.brain = null
		mob.damage_by = {bot.id: 999.0}            # só o bot bateu (o jogador é o suporte)
		var before: int = m["loot"].size()
		sim._on_monster_killed(mob, bot)
		for l in m["loot"].slice(before):
			if int(l["owner"]) == pl.id:
				got += 1
		sim.despawn(mob)
	check(got >= 10, "grupo: suporte (sem bater) recebe saque pessoal (%d itens em 20 abates)" % got)
	var other := {"owner": bot.id, "free_at": sim.time + 10.0}
	check(not sim.loot_visible_to(pl, other) and sim.loot_visible_to(pl, {"owner": pl.id, "free_at": sim.time + 10.0}), "item do bot fica escondido; o seu aparece")
	other["free_at"] = sim.time - 1.0
	check(sim.loot_visible_to(pl, other), "item do bot que ficou livre aparece")
	for l in m["loot"].duplicate():
		if int(l["owner"]) in [pl.id, bot.id]:
			m["loot"].erase(l)
	sim.party_leave(pl)
	sim.despawn(bot)
	pl.position = keep_pos

## Todo equipamento tem descrição na dica (a escrita ou a montada dos dados: peça, quem usa, o que favorece).
func _check_item_descriptions(gd) -> void:
	var empty: Array = []
	for iid in gd.items:
		var it: ItemDef = gd.items[iid]
		if it.is_equipment() and UiKit.item_summary(it).length() < 8:
			empty.append(iid)
	check(empty.is_empty(), "todo equipamento tem descrição (%d sem: %s)" % [empty.size(), str(empty.slice(0, 4))])
	check(UiKit.item_tooltip(gd.items["sword_rusty"]).contains("Favorece"), "dica do equipamento diz o que os atributos favorecem")

## Arma lendária: efeito próprio pelo papel (eco / retaliação / égide); atributos de toda build servem a ela.
func _check_legend_weapons_and_attrs(gd, sim) -> void:
	var useful := {}
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var mine := {"VIT": true}          # VIT (vida) serve a qualquer um
		for b in cls.builds:
			mine[b["attr"]] = true
			mine[b["attr2"]] = true
			var caster: bool = b["role"] in ["caster", "healer"] or b["stat"] in ["matk_pct", "heal_pct"]
			check(not (caster and (b["attr"] == "AGI" or b["attr2"] == "AGI")), "%s/%s: build mágica sem AGI" % [cid, b["id"]])
			check(not (caster and (b["attr"] == "FOR" or b["attr2"] == "FOR")) or b["role"] == "tank", "%s/%s: build mágica sem FOR" % [cid, b["id"]])
		useful[cid] = mine
		for iid in ItemsCatalog.starter_ids(cid):
			if gd.items.has(iid):
				for a in gd.items[iid].attributes:
					check(mine.has(a), "%s: conjunto inicial só dá atributo que a classe usa (%s)" % [iid, a])
	var bad: Array = []
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		for iid in sd.pieces + sd.alt_pieces:
			for a in gd.items[iid].attributes:
				if not useful[sd.class_id].has(a):
					bad.append("%s:%s" % [iid, a])
		for k in sd.bonuses:
			for a in sd.bonuses[k].get("attrs", {}):
				if not useful[sd.class_id].has(a):
					bad.append("%s bônus %s:%s" % [sid, k, a])
	check(bad.is_empty(), "conjuntos lendários só dão atributos que a classe usa (%s)" % str(bad.slice(0, 4)))
	for d in GearCatalog.SHIELDS:            # escudos nomeados: atributos de quem pode usar (pela afinidade)
		var sh: ItemDef = gd.items["shield_" + d[0]]
		for cid in ["paladin", "bishop"]:
			if GearCatalog.shield_fits(sh.id, cid):
				for a in sh.attributes:
					check(useful[cid].has(a), "%s serve ao %s: atributo %s" % [sh.id, cid, a])
	# efeitos por papel
	var role_of := {}
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			role_of["%s_%s" % [cid, b["id"]]] = b["role"]
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.is_hybrid():
			continue          # híbrido: as armas são peças alternativas (_check_hybrid_sets)
		var w: ItemDef = gd.items.get(sd.pieces.filter(func(x): return x.ends_with("_weapon"))[0]) if sd.pieces.any(func(x): return x.ends_with("_weapon")) else null
		check(w != null and not w.legend_effect.is_empty(), "%s: arma lendária tem efeito próprio" % sid)
		if w:
			var bid: String = sd.id.trim_prefix("set_%s_" % sd.class_id).rsplit("_", true, 1)[0]
			var own: Dictionary = gd.classes[sd.class_id].build_by_id(bid).get("legend", {})
			check(not own.is_empty() and w.legend_effect["kind"] == own["kind"], "%s: efeito próprio da build %s" % [sid, bid])
			check(UiKit.legend_effect_text(w.legend_effect).length() > 12, "%s: texto do efeito" % sid)
	var names := {}
	var n_builds := 0
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			n_builds += 1
			var leg: Dictionary = b.get("legend", {})
			names[leg.get("name", "")] = true
			var sk: String = leg.get("skill", "")
			check(sk == "" or gd.skills.has(sk), "%s: skill do efeito existe (%s)" % [b["id"], sk])
	check(names.size() == n_builds and not names.has(""), "cada build tem um efeito lendário com nome próprio (%d)" % names.size())
	# eco: golpe direto bate de novo (forçando a chance)
	var a: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Eco", "city_aldara", Vector3(-46, 0, -46), 20)
	a.brain = null
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(-46, 0, -44.5))
	mob.brain = null
	a.stats.legend = {"kind": "echo"}
	a.stats.echo_chance = 100.0
	a.stats.echo_pct = 50.0
	_dmg_kinds.clear()
	Events.damage_dealt.connect(_note_damage)
	sim._deal_damage(a, mob, 100, false, false, "physical")
	check(_dmg_kinds.has("echo") and _dmg_kinds.count("echo") == 1, "Eco: o golpe bate de novo uma vez (%s)" % str(_dmg_kinds))
	# retaliação: tanque devolve parte do corpo a corpo
	a.stats.echo_chance = 0.0
	a.stats.thorns_pct = 20.0
	# o golpe precisa pegar: o equipamento sorteado do bot pode dar esquiva (> 0) e a rolagem usa o sim.rng
	# compartilhado (estado depende dos checks anteriores); sem esquiva, invulnerável, aparo nem barreira
	a.stats.evasion = 0.0
	a.iframe_left = 0.0
	a.parry_left = 0.0
	a.is_blocking = false
	a.shield_hp = 0.0
	a.hp = a.stats.max_hp
	a.position = Vector3(-46, 0, -46)
	mob.position = Vector3(-46, 0, -44.5)
	_dmg_kinds.clear()
	var mhp: float = mob.hp
	sim._deal_damage(mob, a, 100, false, false, "physical")
	check(_dmg_kinds.has("thorns") and mob.hp < mhp, "Retaliação: quem bate corpo a corpo leva parte de volta (%s, %d/%d)" % [str(_dmg_kinds), int(mob.hp), int(mhp)])
	Events.damage_dealt.disconnect(_note_damage)
	# Elementalista: fogo lança Bola de Fogo no básico; gelo lança Nova ao levar golpe (uma vez a cada 20 s); raio salta
	var el: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Ele2", "city_aldara", Vector3(-46, 0, -46), 20)
	el.brain = null
	el.build_id = "gelo"                   # Brasa Viva numa build que não é a de fogo: lança à parte (na de fogo soma na assinatura)
	var mob2: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(-44.5, 0, -44.5))
	mob2.brain = null
	var basic: SkillDef = el.basic_skill
	var m: Dictionary = sim.maps["city_aldara"]
	el.stats.legend = {"kind": "cast_on_basic", "skill": "ele_fireball", "chance": 100.0}
	var before: int = m["projectiles"].size()
	sim._legend_on_hit(el, mob, basic, 50)
	check(m["projectiles"].size() > before, "Brasa Viva (fogo): o básico lança uma Bola de Fogo")
	el.leg_cast_at = 0.0
	var before_sk: int = m["projectiles"].size()
	sim._legend_on_hit(el, mob, gd.skills["ele_ice_lance"], 50)
	check(m["projectiles"].size() > before_sk, "Brasa Viva também dispara ao acertar com habilidade")
	var after_sk: int = m["projectiles"].size()
	sim._legend_on_hit(el, mob, gd.skills["ele_ice_lance"], 50)
	check(m["projectiles"].size() == after_sk, "Brasa Viva: no máximo uma por segundo")
	sim._legend_on_hit(el, mob, gd.skills["ele_fireball"], 50)
	check(m["projectiles"].size() == after_sk, "a Bola de Fogo da arma não lança outra")
	el.leg_cast_at = 0.0
	el.stats.legend = {"kind": "cast_when_hit", "skill": "ele_frost_nova", "icd": 20.0}
	el.legend_ready_at = 0.0
	var nhp: float = mob.hp
	sim._legend_weapon(mob, el, 30, "physical")
	check(mob.hp < nhp and mob.debuffs.any(func(d): return d.get("kind") in ["slow", "root"]), "Coração de Gelo: apanhou, solta a Nova de Gelo em volta")
	nhp = mob.hp
	sim._legend_weapon(mob, el, 30, "physical")
	check(is_equal_approx(mob.hp, nhp), "Coração de Gelo: não repete antes de 20 s")
	el.stats.legend = {"kind": "chain", "targets": 1, "pct": 60.0}
	var hp2: float = mob2.hp
	sim._legend_on_hit(el, mob, basic, 100)
	check(mob2.hp < hp2, "Arco Voltaico (raio): o básico salta para outro alvo")
	sim.despawn(mob2)
	sim.despawn(el)
	# égide: a cura vira barreira
	a.stats.thorns_pct = 0.0
	a.stats.ward_pct = 20.0
	a.hp = a.stats.max_hp * 0.5
	a.shield_hp = 0.0
	sim._heal(a, a, 100)
	check(a.shield_hp > 0.0 and a.buffs.any(func(x): return x.get("id") == "shield"), "Égide: cura dá barreira")
	sim.despawn(mob)
	sim.despawn(a)

func _check_elemental_debuffs(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-36, 0, -36)
	var el: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Ele", "city_aldara", at, 30)
	el.brain = null
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 1.6))
	mob.brain = null
	# Trovão atordoa
	sim._apply_effects(el, mob, gd.skills["ele_thunder"].effects, 1.0)
	check(mob.state == SimEntity.State.STUNNED, "Trovão atordoa o alvo")
	mob.set_state(SimEntity.State.IDLE)
	# fogo queima: todo dano no tempo de skill de fogo é queimadura
	for sid in gd.skills:
		var sk: SkillDef = gd.skills[sid]
		if sk.effects.has("dot") and (sk.vfx == "fire" or sk.elements.has("fire")):
			check(bool(sk.effects["dot"].get("fire", false)), "%s: dano no tempo de fogo é queimadura" % sid)
	check(gd.skills["ele_phoenix"].effects.has("dot"), "Fênix queima")
	_dmg_kinds.clear()
	Events.damage_dealt.connect(_note_damage)
	var hp0: float = mob.hp
	sim._apply_effects(el, mob, gd.skills["ele_fireball"].effects, 1.0)
	for i in range(25):
		sim._update_entity(mob, m, 0.1)
	check(mob.hp < hp0 and _dmg_kinds.has("dot_fire"), "Bola de Fogo queima com o tempo (%.0f de dano, %s)" % [hp0 - mob.hp, str(_dmg_kinds.slice(0, 3))])
	# gelo estilhaça: mais dano em alvo retardado, preso ou atordoado; fogo não ganha o bônus
	mob.debuffs.clear()
	mob.set_state(SimEntity.State.IDLE)
	var lance: SkillDef = gd.skills["ele_ice_lance"]
	check(is_equal_approx(Combat.frost_mult(lance, mob), 1.0), "gelo em alvo normal: sem bônus")
	mob.debuffs.append({"kind": "slow", "remaining": 2.0, "pct": 30.0})
	check(is_equal_approx(Combat.frost_mult(lance, mob), Balance.FROST_SHATTER_MULT), "gelo em alvo retardado: estilhaço")
	check(is_equal_approx(Combat.frost_mult(gd.skills["ele_fireball"], mob), 1.0), "fogo não estilhaça")
	check(is_equal_approx(Combat.frost_mult(gd.skills["ran_frost_arrow"], mob), Balance.FROST_SHATTER_MULT), "flecha de gelo do Ranger também estilhaça")
	# no lance de verdade: Nova de Gelo no alvo normal = mágico; de novo no alvo já retardado = estilhaço
	mob.debuffs.clear()
	mob.hp = mob.stats.max_hp * 100.0          # a 1ª Nova não pode matar o alvo (o equipamento sorteado do bot varia com o catálogo)
	_dmg_kinds.clear()
	sim._apply_skill(el, gd.skills["ele_frost_nova"], m)
	var first := _dmg_kinds.duplicate()
	_dmg_kinds.clear()
	sim._apply_skill(el, gd.skills["ele_frost_nova"], m)
	check(first.has("magical") and not first.has("shatter") and _dmg_kinds.has("shatter"), "Nova de Gelo estilhaça quem já está retardado (%s → %s, vivo=%s)" % [str(first), str(_dmg_kinds), str(mob.is_alive())])
	Events.damage_dealt.disconnect(_note_damage)
	# raio: chance de atordoar no golpe; Trovão (que já atordoa) e skills sem dano não rolam
	check(Combat.storm_can_stun(gd.skills["ele_lightning"]) and Combat.storm_can_stun(gd.skills["ele_chain"]), "Relâmpago e Corrente rolam atordoar")
	check(not Combat.storm_can_stun(gd.skills["ele_thunder"]) and not Combat.storm_can_stun(gd.skills["ele_overload"]) and not Combat.storm_can_stun(gd.skills["ele_fireball"]),
		"Trovão, Sobrecarga e Bola de Fogo não rolam o atordoar do raio")
	var stuns := 0
	for i in range(400):
		mob.set_state(SimEntity.State.IDLE)
		sim._storm_proc(el, gd.skills["ele_lightning"], mob)
		if mob.state == SimEntity.State.STUNNED:
			stuns += 1
	var rate := stuns / 4.0
	check(absf(rate - Balance.STORM_STUN_CHANCE) < 6.0, "raio atordoa em ~%.0f%% dos golpes (%.1f%%)" % [Balance.STORM_STUN_CHANCE, rate])
	sim.despawn(mob)
	sim.despawn(el)

func _check_necromancer_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["necromancer"]
	_check_lord_of_dead(gd, sim)
	_check_lord_of_dead_bots(gd, sim)
	check(Array(cls.weapon_types) == ["scythe"] and cls.builds.size() == 3 and not cls.builds.any(func(b): return b["main"] != ["scythe"]),
		"Necromancer: só foice, três focos que se misturam")
	for sid in cls.skill_ids:
		check(gd.skills[sid].requires.is_empty() or Array(gd.skills[sid].requires) == ["scythe"], "%s usável com foice" % sid)
	for mid in ["bone_hound", "lich_servant", "skeleton_king", "skeleton_minion"]:
		check(gd.monsters.has(mid) and gd.monsters[mid].xp == 0, "invocação %s existe e não dá XP" % mid)
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(-30, 0, -30)
	var n: SimEntity = sim.spawn_bot(cls, "Nec", "city_aldara", at, 30)
	n.brain = null
	n.equipment[ItemDef.Slot.WEAPON] = gd.items["scythe_bone"]
	n.recompute_stats()
	# invocações: limite por tipo (cães 2, lich 1, rei 1) e juntas
	for i in range(2):
		for sid in ["nec_bone_hound", "nec_lich", "nec_skeleton_king"]:
			sim._apply_skill(n, gd.skills[sid], m)
	var count := {}
	for o in m["entities"]:
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id and o.is_alive():
			count[o.monster_def.id] = int(count.get(o.monster_def.id, 0)) + 1
	check(count.get("bone_hound", 0) == 2 and count.get("lich_servant", 0) == 1 and count.get("skeleton_king", 0) == 1, "limite de invocação por tipo (%s)" % str(count))
	var king: SimEntity = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id and o.monster_def.id == "skeleton_king")[0]
	var dog: SimEntity = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id and o.monster_def.id == "bone_hound")[0]
	check(king.stats.patk > dog.stats.patk * 1.5, "Rei Esqueleto bate bem mais que o cão")
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == n.id:
			sim.despawn(o)
	# maldições: Condenação faz o alvo receber mais; Fraqueza faz causar menos
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 3))
	mob.brain = null
	var hp0: float = mob.hp
	sim._deal_damage(n, mob, 100, false, false, "magical")
	var plain := hp0 - mob.hp
	sim._apply_effects(n, mob, gd.skills["nec_curse_doom"].effects, 1.0)
	sim._apply_effects(n, mob, gd.skills["nec_curse_doom"].effects, 1.0)
	check(mob.debuffs.filter(func(d): return d.get("kind") == "curse").size() == 1, "a mesma maldição renova, não acumula")
	hp0 = mob.hp
	sim._deal_damage(n, mob, 100, false, false, "magical")
	check(hp0 - mob.hp > plain * 1.15, "amaldiçoado recebe mais dano (%.0f x %.0f)" % [hp0 - mob.hp, plain])
	sim._apply_effects(n, mob, gd.skills["nec_curse_weakness"].effects, 1.0)
	var nhp: float = n.hp
	sim._deal_damage(mob, n, 100, false, false, "physical")
	var weak_hit := nhp - n.hp
	check(weak_hit > 0.0 and weak_hit <= 80.0, "enfraquecido causa menos dano (%.0f de 100)" % weak_hit)
	n.hp = n.stats.max_hp
	# canalização: Açoite Mental aplica 4 pulsos durante a fase ativa
	var flay: SkillDef = gd.skills["nec_mind_flay"]
	n.position = at
	mob.position = at + Vector3(0, 0, 3)
	mob.hp = mob.stats.max_hp
	sim._start_skill(n, flay, -1, mob.position)
	var steps := 0
	while n.current_skill != null and steps < 400:
		sim._update_skill(n, m, 0.02)
		n.state_time += 0.02
		steps += 1
	check(n.channel_done == 4, "canalização aplica %d pulsos (%d)" % [4, n.channel_done])
	# formas: fantasma e demônio exigem foice e se trocam
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	check(n.form == "phantom" and n.stats.evasion > 0.0, "Forma Fantasma: esquiva e velocidade")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	check(n.form == "demon" and n.stats.lifesteal > 0.0, "Forma Demoníaca troca a fantasma")
	check(sim.resolve_skill(n, gd.skills["nec_reap"]).name == "Garra Infernal", "golpe de foice muda na forma demoníaca")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	check(n.form == "", "Forma Demoníaca desliga")
	# fantasma acaba sozinha (Balance.FORM_DURATION); demônio fica até desligar; usar de novo desfaz e zera o tempo
	var fdur: float = Balance.FORM_DURATION.get("phantom", 0.0)
	check(fdur > 0.0 and not Balance.FORM_DURATION.has("demon") and not Balance.FORM_DURATION.has("wolf"), "só a fantasma tem tempo")
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	check(n.form == "phantom" and is_equal_approx(n.form_left, fdur), "fantasma começa com %.0f s" % fdur)
	var nm: Dictionary = sim.maps[n.map_id]
	for i in range(int((fdur - 0.5) / 0.1)):
		sim._update_entity(n, nm, 0.1)
	check(n.form == "phantom", "fantasma ainda ativa antes do fim")
	for i in range(10):
		sim._update_entity(n, nm, 0.1)
	check(n.form == "" and n.form_left == 0.0 and is_equal_approx(n.stats.evasion, Stats.agi_evasion(float(n.stats.attrs["AGI"]) / Balance.ATTR_SCALE)), "fantasma acaba sozinha e devolve os atributos (sobra só a esquiva da AGI)")
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	sim._apply_effects(n, n, gd.skills["nec_phantom"].effects, 0.0)
	check(n.form == "" and n.form_left == 0.0, "usar de novo desfaz a fantasma")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	for i in range(int((fdur + 2.0) / 0.1)):
		sim._update_entity(n, nm, 0.1)
	check(n.form == "demon", "forma demoníaca não acaba sozinha")
	sim._apply_effects(n, n, gd.skills["nec_demon_form"].effects, 0.0)
	# maestria fortalece os bônus: forma (x form_mult) e buff (valores positivos), sem mexer em penalidade
	var ph: SkillDef = gd.skills["nec_phantom"]
	n.mastery.erase(ph.id)
	sim._apply_skill(n, ph, nm)
	var ev0: float = n.stats.evasion
	sim.end_form(n)
	n.mastery[ph.id] = 3
	sim._apply_skill(n, ph, nm)
	check(n.form == "phantom" and is_equal_approx(n.form_mult, 1.0 + 3 * Balance.MASTERY_BONUS_PCT), "maestria 3 na fantasma: form_mult %.2f" % n.form_mult)
	check(n.stats.evasion > ev0 + 1.0, "maestria aumenta a esquiva da fantasma (%.1f -> %.1f)" % [ev0, n.stats.evasion])
	sim.end_form(n)
	check(n.form_mult == 1.0 or n.form == "", "forma desligada")
	var ba: SkillDef = gd.skills["nec_bone_armor"]
	n.mastery[ba.id] = 5
	sim._apply_skill(n, ba, nm)
	var got := 0.0
	for b in n.buffs:
		if b.get("id") == "bone_armor":
			got = float(b.get("def_pct", 0))
	var want: float = float(ba.effects["buff"]["def_pct"]) * (1.0 + 5 * Balance.MASTERY_BONUS_PCT)
	check(is_equal_approx(got, want), "maestria 5 na Armadura de Ossos: DEF +%.1f%% (esperado %.1f)" % [got, want])
	var pen := SimEntity.scaled_bonus({"speed_pct": -10, "def_pct": 40, "duration": 6}, 1.5)
	check(pen["speed_pct"] == -10 and is_equal_approx(float(pen["def_pct"]), 60.0) and pen["duration"] == 6, "maestria não piora penalidade nem tempo")
	sim.despawn(mob)
	sim.despawn(n)

func _check_elementalist_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["elementalist"]
	check(Array(cls.weapon_types) == ["staff"] and cls.offhand_types.is_empty(), "Elementalista só usa cajado")
	check(cls.builds.size() == 3 and not cls.builds.any(func(b): return b["main"] != ["staff"]), "Elementalista: três focos, todos de cajado (dá para misturar ramos)")
	for sid in cls.skill_ids:
		var s: SkillDef = gd.skills[sid]
		check(s.requires.is_empty() or Array(s.requires) == ["staff"], "%s usável com cajado" % sid)
		if s.kind == SkillDef.Kind.MAGICAL:
			check(not s.elements.is_empty(), "%s tem elemento" % sid)
	check(Array(gd.skills["ele_firestorm"].elements) == ["fire", "storm"] and gd.skills["ele_prism"].elements.size() == 3, "combinações têm dois ou três elementos")
	check(Array(gd.skills["ele_meteor"].elements) == ["fire"] and Array(gd.skills["ele_blizzard"].elements) == ["frost"], "ramo dá o elemento")
	for el in ["fire", "frost", "storm"]:
		var mid: String = {"fire": "fire_elemental", "frost": "frost_elemental", "storm": "storm_elemental"}[el]
		check(gd.monsters.has(mid) and gd.monsters[mid].xp == 0, "elemental %s existe e não dá XP" % el)
	# bônus por elemento: combinação usa a média
	var st := Stats.new()
	st.fire_pct = 40.0
	st.storm_pct = 0.0
	check(is_equal_approx(st.element_mult(["fire"] as Array[String]), 1.4) and is_equal_approx(st.element_mult(["fire", "storm"] as Array[String]), 1.2)
		and st.element_mult([] as Array[String]) == 1.0, "bônus de elemento: puro inteiro, combinação pela média")
	var e: SimEntity = sim.spawn_bot(cls, "Ele", "city_aldara", Vector3(-30, 0, 30), 30)
	e.brain = null
	e.buffs.append({"id": "t_el", "duration": 99, "remaining": 99, "fire_pct": 500})
	e.recompute_stats()
	check(e.stats.fire_pct == Balance.ELEMENT_CAP, "bônus de elemento tem teto")
	# save antigo com varinha + orbe: voltam para a bolsa e o cajado inicial entra
	e.equipment[ItemDef.Slot.WEAPON] = gd.items["wand_apprentice"]
	e.equipment[ItemDef.Slot.OFFHAND] = gd.items[gd.items.keys().filter(func(k): return gd.items[k].weapon_type == "orb")[0]]
	SaveSystem._fix_class_weapons(e)
	check(e.equipment[ItemDef.Slot.WEAPON].weapon_type == "staff" and e.equipment.get(ItemDef.Slot.OFFHAND) == null and e.inventory.has("wand_apprentice"),
		"save antigo do Elementalista: varinha/orbe vão para a bolsa e o cajado entra")
	# invocar: um elemental por vez; o novo substitui o anterior
	var m: Dictionary = sim.maps["city_aldara"]
	for sid in ["ele_summon_fire", "ele_summon_ice", "ele_summon_storm"]:
		sim._apply_skill(e, gd.skills[sid], m)
	var mine: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id and o.is_alive())
	check(mine.size() == 1 and mine[0].monster_def.id == "storm_elemental", "um elemental por vez, o último substitui (%d)" % mine.size())
	for o in mine:
		sim.despawn(o)
	sim.despawn(e)
	# conjuntos: alguns favorecem uma combinação (2º elemento com 4 peças)
	var combos := 0
	for sid in gd.sets:
		var sd: SetDef = gd.sets[sid]
		if sd.class_id != "elementalist":
			continue
		for el in ["fire_pct", "frost_pct", "storm_pct"]:
			if sd.bonuses.get(4, {}).has(el):
				combos += 1
	check(combos >= 8, "conjuntos do Elementalista que favorecem uma combinação (%d)" % combos)


## Teia e barra de ascensão (GDD ato2-horda R6, decisão 2026-11-11): teia própria por classe (AscensionCatalog), pontos
## próprios do 35 ao 45 + missão, barra de 10 (7-0 só ascensão), save (asc_tree + loadout) e bots.
## Pergunta aberta 13 (teias pequenas): Paladino e Elementalista com 36+ pontos de conteúdo por build aos 45, e os refinos
## que saíram de ASC_REFINES_PENDING para portões da teia (Lança Pesada, Torreta Firme/Veterana, Salamandra/Golem/Silfo).
## Gêmeos 45 (decisão do autor 2026-11-13): nó Fúria Gêmea no ramo da build e o Ciclone de Titã na barra do bot.
## F5 aos 35 (usuário 2026-11-13): ASC_POWER_35_MULT vale inteiro no 35, vira 1,0 no 45 em linha reta; todo peso de ascensão passa por Balance.asc_power.
func _check_asc_power_35(gd, sim) -> void:
	var span := Balance.ASC_MAX_LEVEL - Balance.ASC_LEVEL
	for b in Balance.ASC_POWER_35_MULT:
		var m35 := float(Balance.ASC_POWER_35_MULT[b])
		check(m35 > 0.0 and is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_LEVEL), m35), "F5 35: %s vale x%.2f no 35" % [b, m35])
		check(is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_MAX_LEVEL), 1.0) and is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_MAX_LEVEL + 5), 1.0), "F5 35: %s = x1,0 no 45 (o peso do 45 não muda)" % b)
		var mono := true
		for lv in range(Balance.ASC_LEVEL, Balance.ASC_MAX_LEVEL):
			var a := Balance.asc_level_mult(b, lv)
			var c := Balance.asc_level_mult(b, lv + 1)
			mono = mono and (c >= a - 0.0001 if m35 <= 1.0 else c <= a + 0.0001)
		check(mono, "F5 35: %s anda sem voltar do 35 ao 45" % b)
		check(is_equal_approx(Balance.asc_level_mult(b, Balance.ASC_LEVEL + span / 2), lerpf(m35, 1.0, float(span / 2) / span)), "F5 35: %s em linha reta" % b)
		check(is_equal_approx(Balance.asc_power(b, Balance.ASC_LEVEL), float(Balance.ASC_BUILD_POWER.get(b, 1.0)) * m35), "F5 35: asc_power(%s) = peso do 45 x fator" % b)
	check(is_equal_approx(Balance.asc_level_mult("build_sem_entrada", Balance.ASC_LEVEL), 1.0), "F5 35: build sem entrada = x1,0")
	# os caminhos de cada ascensão usam o fator do nível do dono
	for lv in [Balance.ASC_LEVEL, 40, Balance.ASC_MAX_LEVEL]:
		check(is_equal_approx(RangerAscension.asc_power("lanceiro", lv), Balance.asc_power("lanceiro", lv)) and is_equal_approx(DruidAscension.asc_power("xama", lv), Balance.asc_power("xama", lv)), "F5 35: Ranger/Druida pelo Balance.asc_power (nv %d)" % lv)
		var a: SimEntity = sim.spawn_bot(gd.classes["assassin"], "F5_sombra", "city_aldara", Vector3(60, 0, -64), lv)
		a.brain = null
		a.build_id = "corsario"
		check(is_equal_approx(ShadowSystem.asc_power(sim, a), Balance.asc_power("corsario", lv)), "F5 35: clone/Execução pelo nível do dono (nv %d)" % lv)
		var f: SimEntity = sim.spawn_bot(gd.classes["berserker"], "F5_garra", "city_aldara", Vector3(62, 0, -64), lv)
		f.brain = null
		f.equipment[ItemDef.Slot.WEAPON] = gd.items["claw_t3"]
		f.equipment[ItemDef.Slot.OFFHAND] = gd.items["claw_t3"]
		_ascend(f)
		check(f.stats.titan_claws and is_equal_approx(f.stats.titan_hit, Balance.TITAN_CLAW_POWER * Balance.asc_level_mult(TitanSystem.CLAW_BUILD, lv)), "F5 35: Garras de Titã no nível %d = x%.2f" % [lv, f.stats.titan_hit])
		sim.despawn(a)
		sim.despawn(f)
	# ninguém em core/ lê o peso cru: tudo passa por Balance.asc_power / asc_level_mult
	for path in ["ranger_ascension", "druid_ascension", "shadow_system", "falcon_system", "titan_system"]:
		var src := FileAccess.get_file_as_string("res://core/sim/systems/%s.gd" % path)
		check(not src.contains("ASC_BUILD_POWER") and (src.contains("Balance.asc_power(") or src.contains("RangerAscension.asc_power(BUILD, e.level)") or src.contains("asc_level_mult(")), "F5 35: %s usa o fator do nível" % path)
		for line in src.split("
"):
			if line.contains("TITAN_CLAW_POWER") and not line.strip_edges().begins_with("#"):
				check(line.contains("asc_level_mult("), "F5 35: TITAN_CLAW_POWER só com o fator do nível")

func _check_twin_fury(gd, sim) -> void:
	var nd: Dictionary = gd.asc_trees["berserker"]["nodes"].get("berserker_a_x_twin_fury", {})
	check(not nd.is_empty() and int(nd["level"]) == 45 and str(nd["branch"]) == "carniceiro" and int(nd["cost"]) == 3
		and is_equal_approx(float((nd.get("stats", {}) as Dictionary).get("atk_pct", 0.0)), float(Balance.TWIN_FURY_ATK)), "Gêmeos: Fúria Gêmea (45, +%d%% de dano) no ramo da build" % Balance.TWIN_FURY_ATK)
	var order: Array = AscensionCatalog.bot_order(gd.classes["berserker"], "carniceiro", gd.skills)
	check(order.has("ber_titan_cyclone") and not AscensionCatalog.BOT_NO_SLOT.has("ber_titan_cyclone") and order.find("ber_titan_cyclone") < Balance.ASC_SLOTS, "Gêmeos: Ciclone de Titã na ordem de ascensão do bot (barra 7-0)")
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes["berserker"], "Web_twin", "city_aldara", Vector3(60, 0, -60), Balance.ASC_MAX_LEVEL)
	e.build_id = "carniceiro"
	e.quests_completed.append("hx_asc_berserker")
	sim._gear_bot(e)
	sim._skill_bot(e)
	e.brain = null
	e.recompute_stats()
	check(e.asc_tree.has("berserker_a_x_twin_fury"), "bot Gêmeos no 45 compra a Fúria Gêmea (%s)" % ",".join(PackedStringArray(e.asc_tree.keys())))
	check(e.skills.any(func(s): return s != null and s.id == "ber_titan_cyclone"), "bot Gêmeos no 45 põe o Ciclone de Titã na barra (%s; arma %s+%s)" % [",".join(PackedStringArray(e.skills.map(func(s): return s.id if s != null else "-"))), e.stats.weapon_type, e.stats.offhand_type])
	sim.despawn(e)

func _check_asc_web_fill(gd, sim) -> void:
	var budget: int = Balance.ASC_POINTS_PER_LEVEL * (Balance.ASC_MAX_LEVEL - Balance.ASC_LEVEL + 1) + Balance.ASC_QUEST_POINTS
	for cid in ["paladin", "elementalist"]:
		var nodes: Dictionary = gd.asc_trees[cid]["nodes"]
		for b in gd.classes[cid].builds:
			var cost := 0
			for nid in nodes:
				var n: Dictionary = nodes[nid]
				if n["kind"] == "start" or not (n["branch"] in ["", b["id"]]):
					continue
				cost += int(n["cost"]) * (Balance.MASTERY_MAX if n["kind"] == "mastery" else 1)
			check(cost >= budget and cost <= budget + 6, "teia de ascensão %s/%s: %d pontos de conteúdo para %d ganhos aos 45" % [cid, b["id"], cost, budget])
	var moved := {"paladin": ["Lança Pesada"], "ranger": ["Torreta Firme", "Torreta Veterana"], "elementalist": ["Salamandra", "Golem de Gelo", "Silfo"]}
	for cid in moved:
		var pend: Array = ClassTalentsCatalog.ASC_REFINES_PENDING[cid].map(func(x): return x["name"])
		for nm in moved[cid]:
			var nd: Array = gd.asc_trees[cid]["nodes"].values().filter(func(n): return n["name"] == nm)
			check(not pend.has(nm) and nd.size() == 1 and str(nd[0].get("flag", "")) != "" and int(nd[0]["level"]) in [40, 45], "refino %s saiu do PENDING e é portão da teia de ascensão" % nm)
	check(not ClassTalentsCatalog.ASC_REFINES_PENDING["paladin"].any(func(x): return x["name"] == "Corrente que Provoca"), "Paladino: refino da Corrente de Luz (skill que não existe mais) fora da lista")
	var at := Vector3(60, 0, -60)
	var mk := func(cid: String, bid: String, lv: int) -> SimEntity:
		var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], "Web_" + bid, "city_aldara", at, lv)
		e.build_id = bid
		e.quests_completed.append("hx_asc_" + cid)
		sim._gear_bot(e)
		sim._skill_bot(e)
		e.brain = null
		e.recompute_stats()
		e.heal_full()
		return e
	# bots no 45 gastam a teia inteira e compram os portões da build
	for row in [["paladin", "cruzado", [Balance.MOUNT_LANCE_FLAG]], ["paladin", "guardiao", [Balance.ARCANE_GUARD_FLAG, Balance.MOUNT_WALL_FLAG]],
			["paladin", "templario", [Balance.ARCANE_WARD_FLAG, Balance.MOUNT_BANNER_FLAG]],
			["berserker", "carniceiro", [Balance.CYCLONE_LONG_FLAG, Balance.TWIN_FURY_FLAG]], ["berserker", "executor", [Balance.SECOND_AXE_FLAG, Balance.ARENA_FINALE_FLAG]],
			["berserker", "punhos", [Balance.FURY_LIT_FLAG, Balance.GLORY_KEEP_FLAG]], ["ranger", "lanceiro", [Balance.DOUBLE_JUMP_FLAG, Balance.SHOUT_COMBO_FLAG]],
			["ranger", "atirador", Balance.TURRET_REFINE_FLAGS], ["elementalist", "fogo", [Balance.ELEM_FORM_REFINE_FLAG + "fire"]],
			["elementalist", "gelo", [Balance.ELEM_FORM_REFINE_FLAG + "frost"]], ["elementalist", "raio", [Balance.ELEM_FORM_REFINE_FLAG + "storm"]]]:
		var e: SimEntity = mk.call(row[0], row[1], Balance.ASC_MAX_LEVEL)
		for flag in row[2]:
			check(ProgressionSystem.asc_flag(e, flag), "bot %s no 45 compra o portão %s" % [row[1], flag])
		if row[0] in ["paladin", "elementalist"]:
			check(ProgressionSystem.asc_points(e) == 0, "bot %s no 45 gasta a teia de ascensão inteira (sobram %d)" % [row[1], ProgressionSystem.asc_points(e)])
		sim.despawn(e)
	# Lança Pesada: Carga Montada 30% mais longe (alcance e avanço); sem o portão, igual ao catálogo
	var charge: SkillDef = gd.skills[Balance.MOUNT_CHARGE_SKILL]
	var cru: SimEntity = mk.call("paladin", "cruzado", Balance.ASC_MAX_LEVEL)
	var far: SkillDef = sim.resolve_skill(cru, charge)
	check(is_equal_approx(far.range, charge.range * Balance.MOUNT_LANCE_MULT) and is_equal_approx(float(far.talent_effects["dash"]), float(charge.effects["dash"]) * Balance.MOUNT_LANCE_MULT),
		"Lança Pesada: Carga Montada vai %.1f m (era %.1f)" % [far.range, charge.range])
	var cru35: SimEntity = mk.call("paladin", "cruzado", Balance.ASC_LEVEL)
	check(not ProgressionSystem.asc_flag(cru35, Balance.MOUNT_LANCE_FLAG) and is_equal_approx(sim.resolve_skill(cru35, charge).range, charge.range), "sem Lança Pesada (nível 35): Carga Montada do catálogo")
	# Torreta Firme + Veterana: +4 s cada e -20% de recarga cada
	var tur: SkillDef = gd.skills["ran_turret"]
	var gun: SimEntity = mk.call("ranger", "atirador", Balance.ASC_MAX_LEVEL)
	check(RangerAscension.turret_refines(gun) == 2 and is_equal_approx(sim.resolve_skill(gun, tur).cooldown, tur.cooldown * (1.0 - 2.0 * Balance.TURRET_REFINE_CD_PCT / 100.0)),
		"Torreta Firme + Veterana: recarga %.1f s (era %.1f)" % [sim.resolve_skill(gun, tur).cooldown, tur.cooldown])
	var t0: float = sim.time
	var tt: SimEntity = RangerAscension.place_turret(sim, gun, tur, gun.position + Vector3(2, 0, 0), tur.effects)
	check(tt != null and is_equal_approx(tt.summon_expires - t0, Balance.TURRET_TIME + 2.0 * Balance.TURRET_REFINE_TIME), "Torreta Firme + Veterana: a torreta dura %.0f s" % (Balance.TURRET_TIME + 2.0 * Balance.TURRET_REFINE_TIME))
	var gun35: SimEntity = mk.call("ranger", "atirador", Balance.ASC_LEVEL)
	check(RangerAscension.turret_refines(gun35) == 0 and is_equal_approx(sim.resolve_skill(gun35, tur).cooldown, tur.cooldown), "sem refino (nível 35): torreta do catálogo")
	# Salamandra: o elemental de fogo com o portão bate e aguenta mais que o do mesmo mago sem ele; outra forma não muda
	var mage: SimEntity = mk.call("elementalist", "fogo", Balance.ASC_MAX_LEVEL)
	check(ElementalSystem.form_refined(mage, "fire"), "Salamandra: bot de fogo no 45 tem a forma de fogo refinada")
	var stats_of := func(form: String) -> Array:
		var el: SimEntity = ElementalSystem.summon(sim, mage, form)
		return [el.stats.patk, el.stats.max_hp] if el else [0.0, 0.0]
	var with: Array = stats_of.call("fire")
	var kept: Dictionary = mage.asc_tree.duplicate()
	mage.asc_tree.erase("elementalist_a_x_fire_refine")
	var without: Array = stats_of.call("fire")
	mage.asc_tree = kept
	check(float(without[0]) > 0.0 and is_equal_approx(float(with[0]), float(without[0]) * (1.0 + float(Balance.ELEM_FORM_REFINE["atk"]))), "Salamandra: +15%% de ataque no elemental de fogo (%.0f -> %.0f)" % [without[0], with[0]])
	check(is_equal_approx(float(with[1]), float(without[1]) * (1.0 + float(Balance.ELEM_FORM_REFINE["hp"]))), "Salamandra: +15%% de vida no elemental de fogo (%.0f -> %.0f)" % [without[1], with[1]])
	for o in sim.maps["city_aldara"]["entities"].duplicate():
		if o.owner_id in [mage.id, gun.id]:
			sim.despawn(o)
	for e in [cru, cru35, gun, gun35, mage]:
		sim.despawn(e)

## Refinos de ascensão que esperavam mecânica (GDD ato2-horda R6.1; eram ClassTalentsCatalog.ASC_REFINES_PENDING): agora
## são portões da teia (AscensionCatalog.NODES, `flag`) e cada um faz o que o texto diz; sem o portão, nada muda.
func _check_asc_refines(gd, sim) -> void:
	for cid in ClassTalentsCatalog.ASC_REFINES_PENDING:
		check((ClassTalentsCatalog.ASC_REFINES_PENDING[cid] as Array).is_empty(), "%s: nenhum refino de ascensão pendente" % cid)
	var gates := {"paladin": [["Asas com Bloqueio", "guardiao", 40, Balance.ARCANE_GUARD_FLAG], ["Muralha a Cavalo", "guardiao", 45, Balance.MOUNT_WALL_FLAG],
			["Asas Protetoras", "templario", 40, Balance.ARCANE_WARD_FLAG], ["Estandarte", "templario", 45, Balance.MOUNT_BANNER_FLAG]],
		"berserker": [["Giro dos Dois Machados", "carniceiro", 40, Balance.CYCLONE_LONG_FLAG], ["Segundo Machado", "executor", 40, Balance.SECOND_AXE_FLAG],
			["Fúria Acesa", "punhos", 40, Balance.FURY_LIT_FLAG], ["Golpe Final da Arena", "executor", 45, Balance.ARENA_FINALE_FLAG],
			["Glória que Não Esfria", "punhos", 45, Balance.GLORY_KEEP_FLAG]],
		"ranger": [["Salto Duplo", "lanceiro", 40, Balance.DOUBLE_JUMP_FLAG], ["Brado Combinado", "lanceiro", 45, Balance.SHOUT_COMBO_FLAG]]}
	var gate_id := {}
	for cid in gates:
		for g in gates[cid]:
			var nd: Array = gd.asc_trees[cid]["nodes"].values().filter(func(n): return n["name"] == g[0])
			var ok: bool = nd.size() == 1 and str(nd[0].get("flag", "")) == g[3] and nd[0]["branch"] == g[1] and int(nd[0]["level"]) == g[2]
			check(ok, "refino %s: portão %s da teia de ascensão (%s, nível %d)" % [g[0], g[3], g[1], g[2]])
			if ok:
				gate_id[g[3]] = nd[0]["id"]
	var at := Vector3(64, 0, -56)
	var m: Dictionary = sim.maps["city_aldara"]
	# --- Paladino: Asas com Bloqueio (Guardião 40) ---
	var gua: SimEntity = _refine_bot(gd, sim, "paladin", "guardiao", at)
	var wings: Dictionary = gd.skills[Balance.ARCANE_SKILL].effects["buff"]
	_set_gate(gua, gate_id, Balance.ARCANE_GUARD_FLAG, false)
	check(not (MountedCombat.wings_buff(gua, wings) as Dictionary).has("block"), "sem Asas com Bloqueio: as asas não dão bloqueio")
	_set_gate(gua, gate_id, Balance.ARCANE_GUARD_FLAG, true)
	var b0: float = gua.stats.block_chance
	var wb: Dictionary = (MountedCombat.wings_buff(gua, wings) as Dictionary).duplicate()
	gua.put_buff(wb)
	gua.recompute_stats()
	check(gua.stats.has_shield and is_equal_approx(gua.stats.block_chance - b0, Balance.ARCANE_GUARD_BLOCK),
		"Asas com Bloqueio: com escudo, as asas dão +%.0f%% de bloqueio (%.0f -> %.0f)" % [Balance.ARCANE_GUARD_BLOCK, b0, gua.stats.block_chance])
	check(not wings.has("block"), "Asas com Bloqueio não muda o buff do catálogo")
	gua.drop_buff(Balance.ARCANE_BUFF)
	gua.recompute_stats()
	# --- Muralha a Cavalo (Guardião 45): provoca e bloqueia montado ---
	var taunt: SkillDef = gd.skills["pal_taunt"]
	gua.mounted = true
	_set_gate(gua, gate_id, Balance.MOUNT_WALL_FLAG, false)
	check(MountedCombat.block_reason(gua, taunt) != "", "sem Muralha a Cavalo: Provocar não sai montado")
	_set_gate(gua, gate_id, Balance.MOUNT_WALL_FLAG, true)
	check(MountedCombat.block_reason(gua, taunt) == "", "Muralha a Cavalo: Provocar sai montado")
	_reset_act(gua)
	gua.mp = gua.stats.max_mp
	var blk := InputCommand.new()
	blk.block = true
	blk.aim = gua.position + gua.forward()
	sim._apply_command(gua, blk, m, 0.016)
	check(gua.mounted and gua.is_blocking, "Muralha a Cavalo: ergue o escudo sem descer do cavalo")
	gua.is_blocking = false
	_set_gate(gua, gate_id, Balance.MOUNT_WALL_FLAG, false)
	sim._apply_command(gua, blk, m, 0.016)
	check(not gua.mounted, "sem Muralha a Cavalo: bloquear desce do cavalo")
	gua.is_blocking = false
	sim.despawn(gua)
	# --- Templário: Asas Protetoras (40) e Estandarte (45) ---
	var tem: SimEntity = _refine_bot(gd, sim, "paladin", "templario", at + Vector3(0, 0, 30))
	var ally: SimEntity = _refine_bot(gd, sim, "paladin", "cruzado", tem.position + Vector3(4, 0, 0))
	var far_ally: SimEntity = _refine_bot(gd, sim, "paladin", "cruzado", tem.position + Vector3(9, 0, 0))
	tem.party_id = 9090
	ally.party_id = 9090
	far_ally.party_id = 9090
	_set_gate(tem, gate_id, Balance.ARCANE_WARD_FLAG, false)
	tem.put_buff((MountedCombat.wings_buff(tem, wings) as Dictionary).duplicate())
	tem.mp = 100.0
	MountedCombat.tick(sim, tem, 1.0)
	check(is_equal_approx(tem.mp, 100.0 - Balance.ARCANE_MP_PER_S), "sem Asas Protetoras: Modo Arcano gasta %.1f MP/s" % Balance.ARCANE_MP_PER_S)
	tem.drop_buff(Balance.ARCANE_BUFF)
	_set_gate(tem, gate_id, Balance.ARCANE_WARD_FLAG, true)
	tem.put_buff((MountedCombat.wings_buff(tem, wings) as Dictionary).duplicate())
	tem.mp = 100.0
	MountedCombat.tick(sim, tem, 1.0)
	check(is_equal_approx(tem.mp, 100.0 - Balance.ARCANE_MP_PER_S * Balance.ARCANE_WARD_MP_MULT), "Asas Protetoras: Modo Arcano gasta metade da MP (%.1f)" % (100.0 - tem.mp))
	var dr0: float = ally.stats.dr_pct
	AuraSystem.tick(sim, m, Balance.AURA_TICK)
	check(ally.buffs.any(func(b): return b.get("id") == Balance.ARCANE_WARD["id"])
		and is_equal_approx(ally.stats.dr_pct - dr0, float(Balance.ARCANE_WARD["dr_pct"])), "Asas Protetoras: aliado do grupo a 4 m com -%d%% de dano" % int(Balance.ARCANE_WARD["dr_pct"]))
	check(not far_ally.buffs.any(func(b): return b.get("id") == Balance.ARCANE_WARD["id"]), "Asas Protetoras: aliado a 9 m (fora dos 6 m) sem a proteção")
	check(BuffLooks.LOOKS.has(str(Balance.ARCANE_WARD["id"])), "Asas Protetoras: buff do grupo com visual (BuffLooks)")
	tem.drop_buff(Balance.ARCANE_BUFF)
	# Estandarte: montado, as auras de grupo alcançam x1,5 (ClassTalentSystem e AuraSystem leem MountedCombat.banner_mult)
	var R := 6.0              # far_ally a 9 m: fora de 6, dentro de 9
	_set_gate(tem, gate_id, Balance.MOUNT_BANNER_FLAG, true)
	tem.mounted = false
	check(not ClassTalentSystem._receivers(sim, tem, m, R).has(far_ally), "Estandarte a pé: aura no raio normal")
	tem.mounted = true
	check(is_equal_approx(MountedCombat.banner_mult(tem), Balance.MOUNT_BANNER_MULT) and ClassTalentSystem._receivers(sim, tem, m, R).has(far_ally),
		"Estandarte: montado, a aura de grupo alcança %.0f%% mais longe" % ((Balance.MOUNT_BANNER_MULT - 1.0) * 100.0))
	_set_gate(tem, gate_id, Balance.MOUNT_BANNER_FLAG, false)
	check(is_equal_approx(MountedCombat.banner_mult(tem), 1.0), "sem Estandarte: montado, raio normal")
	tem.mounted = false
	for e in [tem, ally, far_ally]:
		sim.despawn(e)
	# --- Berserker: Giro dos Dois Machados (Gêmeos 40) ---
	var cyc: SkillDef = gd.skills[Balance.TITAN_CYCLONE_SKILL]
	var twin: SimEntity = _refine_bot(gd, sim, "berserker", "carniceiro", at + Vector3(0, 0, 60))
	_set_gate(twin, gate_id, Balance.CYCLONE_LONG_FLAG, true)
	var long: SkillDef = sim.resolve_skill(twin, cyc)
	var t0 := int(cyc.effects["channel"]["ticks"])
	check(int(long.effects["channel"]["ticks"]) == int(round(t0 * Balance.CYCLONE_LONG_MULT)) and is_equal_approx(long.active, cyc.active * Balance.CYCLONE_LONG_MULT),
		"Giro dos Dois Machados: Ciclone com %d giros em %.1f s (eram %d em %.1f s)" % [int(long.effects["channel"]["ticks"]), long.active, t0, cyc.active])
	check(int(cyc.effects["channel"]["ticks"]) == t0, "Giro dos Dois Machados não muda o Ciclone do catálogo")
	_set_gate(twin, gate_id, Balance.CYCLONE_LONG_FLAG, false)
	check(int(sim.resolve_skill(twin, cyc).effects["channel"]["ticks"]) == t0, "sem o refino: Ciclone do catálogo")
	sim.despawn(twin)
	# --- Executor: Segundo Machado (40) e Golpe Final da Arena (45) ---
	var exe: SimEntity = _refine_bot(gd, sim, "berserker", "executor", at + Vector3(0, 0, 90))
	var mob: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", exe.position + Vector3(0, 0, 2))
	mob.brain = null
	var sk: SkillDef = gd.skills["ber_execute"] if gd.skills.has("ber_execute") else null
	check(exe.stats.titan_pair and sk != null and not TitanSystem.double_hit(exe, sk), "Segundo Machado: Executor com dois machados de 2 mãos e uma skill sem golpe duplo")
	if sk != null:
		_set_gate(exe, gate_id, Balance.SECOND_AXE_FLAG, true)
		mob.hp = mob.stats.max_hp * 0.15
		check(is_equal_approx(TitanSystem.second_axe_mult(exe, mob, sk), 1.0 + exe.stats.titan_hit), "Segundo Machado: alvo a 15%% da vida apanha também do 2º machado (x%.2f)" % (1.0 + exe.stats.titan_hit))
		check(is_equal_approx(TitanSystem.second_axe_mult(exe, mob, exe.basic_skill), 1.0), "Segundo Machado: o básico já bate com os dois (não dobra de novo)")
		mob.hp = mob.stats.max_hp * 0.5
		check(is_equal_approx(TitanSystem.second_axe_mult(exe, mob, sk), 1.0), "Segundo Machado: alvo acima de 20%% sem o 2º machado")
		mob.hp = mob.stats.max_hp * 0.15
		_set_gate(exe, gate_id, Balance.SECOND_AXE_FLAG, false)
		check(is_equal_approx(TitanSystem.second_axe_mult(exe, mob, sk), 1.0), "sem Segundo Machado: nada muda")
	var fin: SkillDef = gd.skills["ber_glad_finale"]
	_set_gate(exe, gate_id, Balance.ARENA_FINALE_FLAG, true)
	var fin2: SkillDef = sim.resolve_skill(exe, fin)
	check(is_equal_approx(fin2.power, fin.power * float(Balance.ARENA_FINALE["power"])) and is_equal_approx(float((fin2.talent_effects.get("stun", {}) as Dictionary).get("duration", 0.0)), float(Balance.ARENA_FINALE["stun"])),
		"Golpe Final da Arena: poder %.2f (era %.2f) e atordoa %.1f s" % [fin2.power, fin.power, float(Balance.ARENA_FINALE["stun"])])
	_set_gate(exe, gate_id, Balance.ARENA_FINALE_FLAG, false)
	check(is_equal_approx(sim.resolve_skill(exe, fin).power, fin.power), "sem o refino: Golpe Final do catálogo")
	sim.despawn(mob)
	sim.despawn(exe)
	# --- Punhos: Fúria Acesa (40) e Glória que Não Esfria (45) ---
	var fist: SimEntity = _refine_bot(gd, sim, "berserker", "punhos", at + Vector3(0, 0, 120))
	for flag_on in [false, true]:
		_set_gate(fist, gate_id, Balance.FURY_LIT_FLAG, flag_on)
		fist.put_buff({"id": Balance.FIST_FURY_BUFF, "remaining": 3.0, "stacks": 2})
		fist.put_buff({"id": Balance.GLORY_BUFF, "remaining": 4.0, "stacks": 2})
		TitanSystem.on_cast(fist, cyc)
		var fr: float = -1.0
		var gr: float = -1.0
		for b in fist.buffs:
			if b.get("id") == Balance.FIST_FURY_BUFF:
				fr = float(b["remaining"])
			elif b.get("id") == Balance.GLORY_BUFF:
				gr = float(b["remaining"])
		var add := Balance.FURY_LIT_TIME if flag_on else 0.0
		check(is_equal_approx(fr, 3.0 + add) and is_equal_approx(gr, 4.0 + add), "Fúria Acesa %s: o Ciclone deixa a Fúria em %.0f s e a Glória em %.0f s" % ["ligada" if flag_on else "desligada", fr, gr])
		fist.drop_buff(Balance.FIST_FURY_BUFF)
		fist.drop_buff(Balance.GLORY_BUFF)
	fist.put_buff({"id": Balance.GLADIATOR_BUFF, "toggle": true})
	for flag_on in [false, true]:
		_set_gate(fist, gate_id, Balance.GLORY_KEEP_FLAG, flag_on)
		fist.drop_buff(Balance.GLORY_BUFF)
		GladiatorSystem.gain_glory(sim, fist, 1)
		var gt: float = -1.0
		for b in fist.buffs:
			if b.get("id") == Balance.GLORY_BUFF:
				gt = float(b["remaining"])
		check(is_equal_approx(gt, Balance.GLORY_TIME + (Balance.GLORY_KEEP_TIME if flag_on else 0.0)), "Glória que Não Esfria %s: a Glória esfria em %.0f s" % ["ligada" if flag_on else "desligada", gt])
	fist.drop_buff(Balance.GLADIATOR_BUFF)
	sim.despawn(fist)
	# --- Lanceiro: Salto Duplo (40) ---
	var lan: SimEntity = _refine_bot(gd, sim, "ranger", "lanceiro", at + Vector3(30, 0, 0))
	var jump: SkillDef = gd.skills[Balance.DRAGON_JUMP_SKILL]
	var fly := func() -> void:
		lan.cooldowns[jump.id] = jump.cooldown
		RangerAscension.on_cast(lan, jump)
		lan.sky = {"from": lan.position, "to": lan.position, "power": 0.0}
		RangerAscension.land(sim, lan, jump, m)
	_set_gate(lan, gate_id, Balance.DOUBLE_JUMP_FLAG, false)
	fly.call()
	check(is_equal_approx(float(lan.cooldowns[jump.id]), jump.cooldown) and lan.jump_window == 0.0, "sem Salto Duplo: o pouso não abre janela")
	_set_gate(lan, gate_id, Balance.DOUBLE_JUMP_FLAG, true)
	lan.cooldowns.clear()
	fly.call()
	check(float(lan.cooldowns[jump.id]) == 0.0 and is_equal_approx(lan.jump_window, Balance.DOUBLE_JUMP_WINDOW), "Salto Duplo: depois do pouso, %.0f s para saltar de novo sem recarga" % Balance.DOUBLE_JUMP_WINDOW)
	fly.call()             # o 2º salto dentro da janela
	check(is_equal_approx(float(lan.cooldowns[jump.id]), jump.cooldown * Balance.DOUBLE_JUMP_CD_MULT) and lan.jump_window == 0.0, "Salto Duplo: o 2º salto leva a recarga × %.1f e não abre outra janela" % Balance.DOUBLE_JUMP_CD_MULT)
	lan.cooldowns.clear()
	fly.call()
	RangerAscension.tick_window(lan, Balance.DOUBLE_JUMP_WINDOW + 0.05)
	check(is_equal_approx(float(lan.cooldowns[jump.id]), jump.cooldown) and lan.jump_window == 0.0, "Salto Duplo: janela fechada sem uso, a recarga cheia começa (%.0f s)" % float(lan.cooldowns[jump.id]))
	# --- Brado Combinado (45) ---
	var frost: SkillDef = gd.skills["ran_shout_frost"]
	var storm: SkillDef = gd.skills["ran_shout_thunder"]
	lan.cooldowns.clear()
	_set_gate(lan, gate_id, Balance.SHOUT_COMBO_FLAG, false)
	lan.put_buff({"id": "shout_flame", "remaining": Balance.SHOUT_TIME})
	check(not RangerAscension.can_combo(lan, frost), "sem Brado Combinado: o bot não grita o 2º Brado")
	RangerAscension.shout(sim, lan, frost.effects, m)
	check(not lan.buffs.any(func(b): return b.get("id") == "shout_flame"), "sem Brado Combinado: o 2º Brado tira o 1º")
	_set_gate(lan, gate_id, Balance.SHOUT_COMBO_FLAG, true)
	lan.put_buff({"id": "shout_flame", "remaining": Balance.SHOUT_TIME})
	check(RangerAscension.can_combo(lan, frost) and not RangerAscension.can_combo(lan, gd.skills["ran_shout_flame"]), "Brado Combinado: o bot pode gritar outro elemento (não o mesmo)")
	RangerAscension.shout(sim, lan, frost.effects, m)
	lan.put_buff({"id": "shout_frost", "remaining": Balance.SHOUT_TIME})
	var flame_left := -1.0
	for b in lan.buffs:
		if b.get("id") == "shout_flame":
			flame_left = float(b["remaining"])
	check(is_equal_approx(flame_left, Balance.SHOUT_COMBO_TIME) and lan.buffs.any(func(b): return b.get("id") == "shout_frost"),
		"Brado Combinado: Chamas e Geada ativas juntas (Chamas fica %.0f s)" % flame_left)
	check(is_equal_approx(float(lan.cooldowns.get(Balance.SHOUT_COMBO_KEY, 0.0)), Balance.SHOUT_COMBO_CD), "Brado Combinado: recarga de %.0f s" % Balance.SHOUT_COMBO_CD)
	var dummy: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", lan.position + Vector3(0, 0, 2))
	dummy.brain = null
	RangerAscension.on_strike(sim, lan, dummy, 100)
	check(dummy.debuffs.any(func(d): return str(d.get("id", "")).begins_with("shout_burn")) and dummy.debuffs.any(func(d): return str(d.get("id", "")).begins_with("shout_chill")),
		"Brado Combinado: o golpe da lança queima E deixa lento")
	RangerAscension.shout(sim, lan, storm.effects, m)          # combinado em recarga: o 3º Brado tira os outros
	check(not lan.buffs.any(func(b): return b.get("id") in ["shout_flame", "shout_frost"]), "Brado Combinado em recarga: o Brado novo tira os anteriores")
	sim.despawn(dummy)
	sim.despawn(lan)

## Bot de teste no 45 (teia de ascensão gasta pelo bot_spend_asc), parado.
func _refine_bot(gd, sim, cid: String, bid: String, at: Vector3) -> SimEntity:
	var e: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], "Ref_" + bid, "city_aldara", at, Balance.ASC_MAX_LEVEL)
	e.build_id = bid
	e.quests_completed.append("hx_asc_" + cid)
	sim._gear_bot(e)
	sim._skill_bot(e)
	e.brain = null
	e.recompute_stats()
	e.heal_full()
	return e

## Liga/desliga o portão `flag` (nó da teia de ascensão) em `e`.
func _set_gate(e: SimEntity, gate_id: Dictionary, flag: String, on: bool) -> void:
	var nid: String = gate_id.get(flag, "")
	if nid == "":
		return
	if on:
		e.asc_tree[nid] = true
	else:
		e.asc_tree.erase(nid)
	e.recompute_stats()

func _check_ascension_web(gd, sim, save) -> void:
	# conteúdo: cada classe com skill de ascensão (ou nó em NODES) tem teia; as outras não
	for cid in gd.classes:
		var cls: ClassDef = gd.classes[cid]
		var asc_ids: Array = Array(cls.skill_ids).filter(func(x): return gd.skills[x].ascension)
		var has_content: bool = not asc_ids.is_empty() or AscensionCatalog.NODES.has(cid)
		check(gd.asc_trees.has(cid) == has_content, "%s: teia de ascensão só com conteúdo (%s)" % [cid, has_content])
		for nid in gd.trees[cid]["nodes"]:
			if str(nid).contains("_a_"):
				check(false, "%s: nó %s da teia comum com o prefixo da de ascensão" % [cid, nid])
		if not gd.asc_trees.has(cid):
			continue
		var tr: Dictionary = gd.asc_trees[cid]
		var nodes: Dictionary = tr["nodes"]
		for sid in asc_ids:
			check(nodes.has("%s_a_s_%s" % [cid, sid]) and nodes.has("%s_a_m_%s" % [cid, sid]), "%s: %s é nó (skill + maestria) da teia de ascensão" % [cid, sid])
			check(not gd.trees[cid]["nodes"].has("%s_s_%s" % [cid, sid]), "%s: %s fora da teia comum" % [cid, sid])
		var seen := {tr["start"]: true}
		var q: Array = [tr["start"]]
		while not q.is_empty():
			var cur: String = q.pop_back()
			for l in nodes[cur]["links"]:
				if not seen.has(l):
					seen[l] = true
					q.append(l)
		check(seen.size() == nodes.size(), "%s: teia de ascensão toda alcançável do início (%d/%d)" % [cid, seen.size(), nodes.size()])
		for nid in nodes:
			check(str(nid).begins_with(cid + "_a_"), "%s: id %s com prefixo <classe>_a_" % [cid, nid])
			check(int(nodes[nid]["level"]) >= Balance.ASC_LEVEL and int(nodes[nid]["level"]) <= Balance.ASC_MAX_LEVEL, "%s: nó %s com nível da ascensão" % [cid, nid])
			for k in nodes[nid].get("stats", {}):
				check(str(k).begins_with("attr_") or k in Stats.STAT_KEYS, "%s: stat %s do nó %s existe" % [cid, k, nid])
		for pane in tr["panes"]:
			check(pane["id"] == "" or cls.build_by_id(pane["id"]).size() > 0, "%s: ramo %s é uma build" % [cid, pane["id"]])
	for cid in AscensionCatalog.NODES:
		check(gd.classes.has(cid), "AscensionCatalog.NODES: classe %s existe" % cid)
	for key in AscensionCatalog.BOT_ORDER:
		for sid in AscensionCatalog.BOT_ORDER[key]:
			check(gd.skills.has(sid) and gd.skills[sid].ascension and gd.skills[sid].class_id == str(key).get_slice("/", 0), "BOT_ORDER %s: %s é skill de ascensão da classe" % [key, sid])
	# conteúdo pedido: Berserker 3 nós de alívio da Empunhadura de Titã; Elementalista portão Ancestral no 40
	var ber_relief: Array = gd.asc_trees["berserker"]["nodes"].values().filter(func(n): return n.get("stats", {}).has("titan_relief"))
	check(ber_relief.size() == Balance.TITAN_RELIEF_NODES and ber_relief.map(func(n): return n["name"]).has("Pulso de Titã"), "Berserker: %d nós titan_relief na teia de ascensão" % ber_relief.size())
	var anc: Dictionary = gd.asc_trees["elementalist"]["nodes"].get("elementalist_a_x_ancestral", {})
	check(not anc.is_empty() and int(anc["level"]) == 40 and anc.get("flag") == Balance.ELEM_STAGE_FLAG[2], "Elementalista: Chamado Ancestral (portão do estágio Ancestral) no 40")
	# pontos próprios e barra
	var cls: ClassDef = gd.classes["berserker"]
	var at: Vector3 = gd.maps["city_aldara"].spawn_point          # na praça: trocar a barra só na cidade
	var e: SimEntity = sim.spawn_bot(cls, "Titã", "city_aldara", at, 30)
	e.brain = null
	e.level = Balance.ASC_LEVEL
	var pts0: int = e.mastery_points
	check(ProgressionSystem.asc_points(e) == 0 and e.slot_count() == Balance.SKILL_SLOTS, "sem a missão: 0 pontos de ascensão e barra de 6")
	check(sim.tree_block_reason(e, "berserker_a_s_ber_gladiator") != "", "sem a missão a teia de ascensão não compra")
	e.quests_completed.append("hx_asc_berserker")
	e.ensure_slots()
	check(e.skills.size() == Balance.SKILL_SLOTS + Balance.ASC_SLOTS and Balance.ASC_SLOTS == 4, "ascendido: barra de 10 (1-6 e 7 8 9 0)")
	check(ProgressionSystem.asc_points_total(e) == Balance.ASC_POINTS_PER_LEVEL + Balance.ASC_QUEST_POINTS, "no 35: %d pontos por nível + %d da missão" % [Balance.ASC_POINTS_PER_LEVEL, Balance.ASC_QUEST_POINTS])
	e.level = Balance.ASC_MAX_LEVEL + 5
	check(ProgressionSystem.asc_points_total(e) == Balance.ASC_POINTS_PER_LEVEL * (Balance.ASC_MAX_LEVEL - Balance.ASC_LEVEL + 1) + Balance.ASC_QUEST_POINTS, "pontos de ascensão param no %d" % Balance.ASC_MAX_LEVEL)
	e.level = Balance.ASC_LEVEL
	var tr: Dictionary = gd.asc_trees["berserker"]
	var path: Array = ProgressionSystem._asc_path_to(e, tr, "berserker_a_s_ber_gladiator")
	check(not path.is_empty() and path.size() <= ProgressionSystem.asc_points(e), "Modo Gladiador alcançável com os pontos do 35 (%d nós)" % path.size())
	for nid in path:
		check(sim.tree_allocate(e, nid), "compra %s na teia de ascensão" % nid)
	check(e.knows("ber_gladiator") and e.slot_of("ber_gladiator") >= Balance.SKILL_SLOTS, "skill comprada vai para a 1ª vaga livre de 7-0 (%d)" % e.slot_of("ber_gladiator"))
	check(e.mastery_points == pts0, "a teia de ascensão não gasta pontos da teia comum")
	var left: int = ProgressionSystem.asc_points(e)
	check(sim.upgrade_mastery(e, "ber_gladiator") and e.mastery_of("ber_gladiator") == 1 and ProgressionSystem.asc_points(e) == left - 1, "maestria da skill de ascensão: 1 ponto de ascensão por nível")
	# vagas: 1-6 só comuns, 7-0 só ascensão; esvaziar e trocar
	var normal: String = e.class_def.starting_skills[0]
	check(not sim.set_skill_slot(e, 0, "ber_gladiator"), "skill de ascensão não entra em 1-6")
	check(not sim.set_skill_slot(e, Balance.SKILL_SLOTS, normal), "skill comum não entra em 7-0")
	check(sim.set_skill_slot(e, Balance.SKILL_SLOTS + 3, "ber_gladiator") and e.slot_of("ber_gladiator") == Balance.SKILL_SLOTS + 3, "Modo Gladiador na tecla 0")
	check(sim.set_skill_slot(e, Balance.SKILL_SLOTS + 3, "") and e.slot_of("ber_gladiator") < 0, "esvaziar a vaga 0")
	e.skills[Balance.SKILL_SLOTS] = gd.skills[normal]
	check(not sim.try_cast(e, Balance.SKILL_SLOTS, e.position, sim.maps["city_aldara"]), "a sim recusa skill comum lançada de 7-0")
	e.skills[Balance.SKILL_SLOTS] = gd.skills["ber_gladiator"]
	# alívio de Titã pela teia de ascensão
	for n in ber_relief:
		e.asc_tree[n["id"]] = true
	sim.recompute_tree_bonus(e)
	check(e.stats.titan_relief == Balance.TITAN_RELIEF_NODES, "3 nós de alívio comprados: titan_relief %d" % e.stats.titan_relief)
	for n in ber_relief:
		e.asc_tree.erase(n["id"])
	sim.recompute_tree_bonus(e)
	# save: teia de ascensão e vagas 7-0; save 4 (sem os campos) carrega sem ascensão comprada
	var keep_slot: int = save.slot
	save.slot = TEST_SLOT
	save.save_player(e)
	var d: Dictionary = save.load_data()
	check(d.get("asc_tree", []).size() == e.asc_tree.size() and d.get("loadout", []).size() == Balance.SKILL_SLOTS + Balance.ASC_SLOTS, "save guarda asc_tree e a barra de 10")
	var back: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Volta", "city_aldara", at + Vector3(0, 0, 4), 1)
	save.apply_to(back, d)
	check(back.asc_tree.size() == e.asc_tree.size() and back.knows("ber_gladiator") and back.slot_of("ber_gladiator") == e.slot_of("ber_gladiator")
		and back.mastery_of("ber_gladiator") == 1 and ProgressionSystem.asc_points(back) == ProgressionSystem.asc_points(e), "save/load: teia de ascensão, maestria, pontos e vaga 7-0")
	var old: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Antigo", "city_aldara", at + Vector3(0, 0, 8), 1)
	var d4 := d.duplicate(true)
	d4.erase("asc_tree")
	d4["save_version"] = 4
	save.apply_to(old, d4)
	check(old.asc_tree.is_empty() and not old.knows("ber_gladiator") and old.skills.size() == Balance.SKILL_SLOTS + Balance.ASC_SLOTS and old.skills.slice(Balance.SKILL_SLOTS).all(func(x): return x == null)
		and ProgressionSystem.asc_points(old) == ProgressionSystem.asc_points_total(old), "save 4: sem teia de ascensão, vagas 7-0 vazias e todos os pontos livres")
	var bad := d.duplicate(true)
	bad["asc_tree"] = ["berserker_a_nao_existe"]
	var old2: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Antigo2", "city_aldara", at + Vector3(0, 0, 12), 1)
	save.apply_to(old2, bad)
	check(old2.asc_tree.is_empty() and not old2.knows("ber_gladiator"), "nó de ascensão que sumiu: a teia de ascensão volta ao início")
	save.delete_slot(TEST_SLOT)
	save.slot = keep_slot
	for x in [back, old, old2]:
		sim.despawn(x)
	# reset da teia de ascensão: pontos voltam, skills dela saem da barra, a ascensão fica
	ProgressionSystem.asc_reset(sim, e)
	check(e.asc_tree.is_empty() and not e.knows("ber_gladiator") and e.slot_of("ber_gladiator") < 0 and ProgressionSystem.asc_points(e) == ProgressionSystem.asc_points_total(e)
		and ProgressionSystem.has_ascension(e), "reset da teia de ascensão: pontos de volta, ascensão fica")
	sim.despawn(e)
	# missão de ascensão concluída: barra cresce na hora
	var qe: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Aspirante", "city_aldara", at + Vector3(4, 0, 0), 30)
	qe.brain = null
	qe.level = Balance.ASC_LEVEL
	qe.quests_completed.append("hx_asc_paladin")
	sim._skill_bot(qe)
	check(qe.skills.size() == Balance.SKILL_SLOTS + Balance.ASC_SLOTS and qe.slot_of("pal_arcane_mode") >= Balance.SKILL_SLOTS, "bot paladino ascendido: barra de 10 e Modo Arcano em 7-0")
	sim.despawn(qe)
	# bots de cada classe com teia: compram caminho por build, sem passar dos pontos, e equipam 7-0 (Comando Elemental fora)
	for cid in gd.asc_trees:
		var c2: ClassDef = gd.classes[cid]
		for b in c2.builds:
			var bot: SimEntity = sim.spawn_bot(c2, "Asc", "city_aldara", at + Vector3(8, 0, 0), 30)
			bot.brain = null
			bot.build_id = b["id"]
			bot.level = Balance.ASC_LEVEL
			bot.quests_completed.append("hx_asc_" + cid)
			sim._skill_bot(bot)
			var order: Array = AscensionCatalog.bot_order(c2, b["id"], gd.skills)
			check(cid != "ranger" or not order.is_empty(), "bot ranger/%s tem ordem de compra na teia de ascensão (o Caçador é o Falcoeiro)" % b["id"])
			if order.is_empty():                 # build sem skill de ascensão: não compra as das outras builds
				check(bot.skills.slice(Balance.SKILL_SLOTS).all(func(x): return x == null) and ProgressionSystem.ascension_skills(bot).all(func(x): return not bot.knows(x)),
					"bot %s/%s: build sem skill de ascensão deixa 7-0 vazias" % [cid, b["id"]])
				check(ProgressionSystem.asc_points_spent(bot) <= ProgressionSystem.asc_points_total(bot), "bot %s/%s: não passa dos pontos de ascensão" % [cid, b["id"]])
				sim.despawn(bot)
				continue
			var first: String = order[0]
			check(ProgressionSystem.asc_points(bot) >= 0 and ProgressionSystem.asc_points(bot) < 2 and bot.knows(first), "bot %s/%s compra %s e gasta os pontos de ascensão (sobra %d)" % [cid, b["id"], first, ProgressionSystem.asc_points(bot)])
			var asc_on_bar: Array = bot.skills.slice(Balance.SKILL_SLOTS).filter(func(x): return x != null)
			check(not asc_on_bar.is_empty() and asc_on_bar.all(func(x): return x.ascension and not (x.id in AscensionCatalog.BOT_NO_SLOT))
				and bot.skills.slice(0, Balance.SKILL_SLOTS).all(func(x): return x == null or not x.ascension), "bot %s/%s: 7-0 só com ascensão, 1-6 com a build" % [cid, b["id"]])
			bot.level = Balance.ASC_MAX_LEVEL
			ProgressionSystem.bot_spend_asc(sim, bot)
			var an: Dictionary = gd.asc_trees[cid]["nodes"]         # compráveis da build dele (skill de outra build não conta)
			var buyable: Array = an.keys().filter(func(nid): return sim.tree_block_reason(bot, nid) == "" and (str(an[nid]["ref"]) == "" or gd.skills[an[nid]["ref"]].build in ["", b["id"]]))
			check(ProgressionSystem.asc_points_spent(bot) <= ProgressionSystem.asc_points_total(bot) and (ProgressionSystem.asc_points(bot) == 0 or buyable.is_empty()),
				"bot %s/%s no %d: gasta a teia de ascensão sem passar (sobra %d, compráveis %s)" % [cid, b["id"], Balance.ASC_MAX_LEVEL, ProgressionSystem.asc_points(bot), buyable])
			sim.despawn(bot)
		var plain: SimEntity = sim.spawn_bot(c2, "Comum", "city_aldara", at + Vector3(8, 0, 4), 30)
		plain.level = Balance.ASC_LEVEL
		sim._skill_bot(plain)
		check(plain.skills.size() == Balance.SKILL_SLOTS and plain.asc_tree.is_empty() and ProgressionSystem.ascension_skills(plain).all(func(x): return not plain.knows(x)), "bot %s sem a missão: sem teia de ascensão nem vagas 7-0" % cid)
		sim.despawn(plain)
	# Elementalista no 40: o bot compra o Chamado Ancestral
	var eb: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Ancestral", "city_aldara", at + Vector3(8, 0, 8), 30)
	eb.level = 40
	eb.quests_completed.append("hx_asc_elementalist")
	sim._skill_bot(eb)
	check(ProgressionSystem.asc_flag(eb, "elem_ancestral"), "bot Elementalista no 40 compra o Chamado Ancestral (sobra %d, %s)" % [ProgressionSystem.asc_points(eb), eb.asc_tree.keys()])
	sim.despawn(eb)
	# barra do HUD e teclas
	check(ActionBar.key_of(6) == "7" and ActionBar.key_of(9) == "0" and ActionBar.key_of(0) == "1", "teclas da barra: 1-6 e 7 8 9 0")
	for i in range(Balance.SKILL_SLOTS + Balance.ASC_SLOTS):
		check(InputMap.has_action("skill_%d" % (i + 1)), "ação de tecla skill_%d (vaga %s)" % [i + 1, ActionBar.key_of(i)])

## Ascensão do Elementalista (GDD ato2-horda F6, AC-27): elemental que evolui, troca de forma, modos, Fusão, save e bots.
func _check_elemental_evolution(gd, sim, save) -> void:
	var cls: ClassDef = gd.classes["elementalist"]
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(72, 0, -12)
	var e: SimEntity = sim.spawn_bot(cls, "Ysolde", "city_aldara", at, 35)
	e.brain = null
	e.build_id = "fogo"
	e.elem_form = ""
	check(not ProgressionSystem.has_ascension(e) and not ElementalSystem.ascended(e), "nível 35 sem a missão: sem ascensão")
	var cmd_s: SkillDef = gd.skills["ele_asc_command"]
	var fus_s: SkillDef = gd.skills["ele_asc_fusion"]
	check(cmd_s.unlock_level == Balance.ASC_LEVEL and fus_s.unlock_level == Balance.ASC_LEVEL and cmd_s.class_id == "elementalist", "skills da ascensão do Elementalista no 35")
	check(ElementalSystem.cast_block(sim, e, fus_s) != "", "Fusão sem a ascensão é recusada")
	# sem ascensão: o elemental da skill continua temporário
	sim._apply_skill(e, gd.skills["ele_summon_fire"], m)
	var plain := ElementalSystem.elemental_of(sim, e)
	var temp: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id and o.is_alive())
	check(plain == null and temp.size() == 1 and temp[0].summon_expires < INF, "sem ascensão: elemental comum (temporário, sem estágio)")
	for o in temp:
		sim.despawn(o)
	e.quests_completed.append("hx_asc_elementalist")
	check(ProgressionSystem.has_ascension(e) and ElementalSystem.ascended(e) and ElementalSystem.cast_block(sim, e, fus_s) == "", "missão hx_asc_elementalist libera a ascensão")
	var lv30: SimEntity = sim.spawn_bot(cls, "Jovem", "city_aldara", at + Vector3(0, 0, 40), 30)
	lv30.quests_completed.append("hx_asc_elementalist")
	check(not ProgressionSystem.has_ascension(lv30), "ascensão exige nível 35")
	sim.despawn(lv30)
	# invocar com a ascensão: persistente, Básico, forma do elemento da build
	sim._apply_skill(e, gd.skills["ele_summon_fire"], m)
	var el := ElementalSystem.elemental_of(sim, e)
	check(el != null and el.summon_expires == INF and el.elem_stage == 0 and el.elem_form == "fire" and el.name == "Elemental de Fogo",
		"ascensão: o elemental fica (persistente) e começa Básico")
	check(sim._summons_full(e, gd.skills["ele_summon_fire"]), "o mesmo elemental vivo: a skill não chama outro")
	var base_hp: float = el.stats.max_hp
	var mdef: MonsterDef = gd.monsters["fire_elemental"]
	var pk := 1.0 + e.stats.pet_power / 100.0
	var capped := e.stats.matk * Balance.SUMMON_MATK_SHARE * clampf(mdef.atk / Balance.SUMMON_ATK_REF, Balance.SUMMON_ATK_MIN, Balance.SUMMON_ATK_MAX) * pk
	check(is_equal_approx(el.summon_patk, capped), "Básico: ATK = o da invocação comum (x1)")
	# F6: 30 comuns nível 36 (1 cada) + 2 chefes (22 cada) = 74, ainda Básico
	var common: MonsterDef = gd.monsters["wolf"].duplicate(true)
	common.level = 36
	common.xp = int(Balance.mob_xp(36))
	var boss: MonsterDef = gd.monsters["ghoul_giant"].duplicate(true)
	boss.level = 36
	boss.xp = int(Balance.mob_xp(36) * 22.7)
	boss.loot_table = ""
	common.loot_table = ""
	var kill := func(def: MonsterDef, pos: Vector3) -> void:
		var mob: SimEntity = sim.spawn_monster(def, "city_aldara", pos)
		mob.brain = null
		sim._kill(mob, e)
		sim.despawn(mob)
	for i in range(30):
		kill.call(common, at + Vector3(3, 0, 0))
	for i in range(2):
		kill.call(boss, at + Vector3(0, 0, 4))
	check(e.elem_xp == 74 and ElementalSystem.stage_of(e) == 0, "F6: 30 comuns 36 + 2 chefes = 74 de experiência, ainda Básico (%d)" % e.elem_xp)
	var escort: MonsterDef = common.duplicate(true)
	escort.xp = 0
	kill.call(escort, at + Vector3(2, 0, 0))
	kill.call(common, at + Vector3(Balance.ELEM_XP_RADIUS + 2.0, 0, 0))
	check(e.elem_xp == 74, "escolta/lacaio (0 XP) e abate longe do mago não contam (%d)" % e.elem_xp)
	# 120: Maior (renasce no pulso, mesma % de vida, ATK x1.4 depois do limite)
	el.hp = el.stats.max_hp * 0.5
	ElementalSystem.add_xp(e, 120 - e.elem_xp)
	for i in range(int(Balance.ELEM_THINK * 60.0) + 2):
		sim.tick(1.0 / 60.0)
	el = ElementalSystem.elemental_of(sim, e)
	check(el != null and el.elem_stage == 1 and el.name == "Salamandra" and ElementalSystem.stage_of(e) == 1, "120 de experiência: Maior (Salamandra)")
	check(el != null and is_equal_approx(el.stats.max_hp, base_hp * 1.6) and absf(el.hp / el.stats.max_hp - 0.5) < 0.05, "Maior: HP x1.6 e mantém a % de vida")
	check(el != null and absf(el.summon_patk - capped * float(Balance.ELEM_STAGE_MULT[1]["atk"])) < 0.01 * capped, "ATK do estágio vem depois de SUMMON_ATK_MAX (x%.1f sobre o limitado)" % float(Balance.ELEM_STAGE_MULT[1]["atk"]))
	check(el != null and el.skills.any(func(s): return s.id == "elem_salamander_spit") and el.scale > mdef.scale, "Maior ganha a skill da forma e cresce")
	check(gd.skills["elem_salamander_spit"].radius > gd.skills["mob_firebreath"].radius * 0.7 and is_equal_approx(gd.skills["elem_ifrit_pyre"].radius, snappedf(3.5 * 1.3, 0.05)), "área das skills do estágio x ELEM_STAGE_MULT")
	# Ancestral: 400 de experiência só vale aos 40
	ElementalSystem.add_xp(e, 1000)
	check(e.elem_xp == Balance.ELEM_XP_MAX and ElementalSystem.stage_of(e) == 1, "teto 400; Ancestral travado no 35 (precisa do 40)")
	e.level = 40
	check(ElementalSystem.stage_of(e) == 1, "aos 40, com 400, sem o Chamado Ancestral (teia de ascensão): travado")
	e.asc_tree["elementalist_a_x_ancestral"] = true
	check(ElementalSystem.stage_of(e) == 2, "aos 40, com 400 e o Chamado Ancestral: Ancestral")
	e.level = 35
	check(ElementalSystem.stage_of(e) == 2, "o estágio nunca cai")
	e.elem_stage = 1
	e.elem_xp = 200
	# troca de forma: mantém estágio e % de vida; recarga 20 s
	el = ElementalSystem.elemental_of(sim, e)
	el.hp = el.stats.max_hp * 0.4
	sim.elem_command(e, "frost", "")
	var fr := ElementalSystem.elemental_of(sim, e)
	check(fr != null and fr.elem_form == "frost" and fr.elem_stage == 1 and fr.name == "Golem de Gelo" and absf(fr.hp / fr.stats.max_hp - 0.4) < 0.05,
		"troca de forma: gelo, mesmo estágio e mesma % de vida")
	check(is_equal_approx(e.elem_swap_at - sim.time, Balance.ELEM_SWAP_CD) and m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id and o.is_alive()).size() == 1,
		"troca: recarga de 20 s e um elemental só")
	sim.elem_command(e, "storm", "")
	check(ElementalSystem.elemental_of(sim, e).elem_form == "frost", "trocar de novo antes da recarga: recusado")
	check(ElementalSystem.cast_block(sim, e, gd.skills["ele_summon_storm"]) != "", "skill de outra forma na recarga: recusada")
	# modos: proteger (mais defesa, provoca quem bate no mago), apoiar (gelo = escudo no grupo), atacar (alvo do mago)
	var def0: float = fr.stats.pdef
	sim.elem_command(e, "", "protect")
	check(e.elem_mode == "protect" and fr.stats.pdef > def0 * 1.3, "modo proteger: elemental com mais defesa")
	var wolf_def: MonsterDef = gd.monsters["wolf"]
	var w: SimEntity = sim.spawn_monster(wolf_def, "city_aldara", at + Vector3(1.5, 0, 0))
	w.brain = null
	w.aggro_target = e.id
	ElementalSystem.tick(sim, m, Balance.ELEM_THINK)
	check(w.aggro_target == fr.id and w.taunt_left > 0.0, "modo proteger: provoca quem bate no mago")
	sim.elem_command(e, "", "support")
	e.shield_hp = 0.0
	fr.elem_support_at = 0.0
	ElementalSystem.tick(sim, m, Balance.ELEM_THINK)
	check(e.shield_hp > 0.0, "modo apoiar (gelo): escudo no grupo")
	var gale: Dictionary = ElementalSystem.support_effects("storm", 1)
	check(gale.get("buff", {}).get("id") == "elem_gale" and is_equal_approx(float(gale["buff"]["speed_pct"]), 8.0 * 1.4), "apoiar (raio): velocidade x estágio")
	sim.elem_command(e, "", "attack")
	w.aggro_target = -1
	e.last_target_id = w.id
	ElementalSystem.tick(sim, m, Balance.ELEM_THINK)
	check(fr.aggro_target == w.id, "modo atacar: o elemental foca o alvo do mago")
	sim.despawn(w)
	# Comando Elemental: troca o modo; Fusão: buff no mago e efeito da forma
	sim._apply_skill(e, cmd_s, m)
	check(e.elem_mode == "protect", "Comando Elemental passa para o próximo modo")
	sim.elem_command(e, "", "attack")
	var fx := {}
	ElementalSystem.fusion(sim, e, fx)
	var fb: Array = e.buffs.filter(func(b): return b.get("id") == "elem_fusion")
	check(fx.has("slow") and fb.size() == 1 and float(fb[0].get("frost_pct", 0)) > 0.0 and float(fb[0].get("matk_pct", 0)) > 0.0, "Fusão (gelo): golpe retarda e o mago ganha MATK + gelo")
	# morte: perde 10% da experiência, o estágio fica; chamar de novo só depois da recarga
	sim._kill(fr, null)
	check(e.elem_xp == 180 and ElementalSystem.stage_of(e) == 1, "elemental morto: perde 10%% (200 -> 180) sem cair de estágio (%d)" % e.elem_xp)
	check(ElementalSystem.elemental_of(sim, e) == null and not ElementalSystem.set_form(sim, e, "fire"), "logo depois da morte: chamar de novo espera a recarga")
	e.elem_swap_at = 0.0
	e.mp = e.stats.max_mp
	check(ElementalSystem.set_form(sim, e, "fire") and ElementalSystem.elemental_of(sim, e).name == "Salamandra", "chamar de novo: volta no estágio guardado")
	# save: ida e volta + save antigo (sem o campo)
	var keep_slot: int = save.slot
	save.slot = TEST_SLOT
	save.save_player(e)
	var d: Dictionary = save.load_data()
	check(int(d.get("save_version", 0)) == SaveSystem.VERSION and SaveSystem.VERSION >= 5 and d.get("elemental") is Dictionary, "save guarda o elemental (save_version 5)")
	var back: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Volta", "city_aldara", at + Vector3(0, 0, 30), 1)
	save.apply_to(back, d)
	check(back.elem_xp == 180 and back.elem_stage == 1 and back.elem_form == "fire" and back.elem_mode == "attack", "save/load: experiência, estágio, forma e modo")
	var old: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Antigo", "city_aldara", at + Vector3(0, 0, 32), 1)
	save.apply_to(old, {"level": 30, "class": "elementalist", "save_version": 4, "learned": ["ele_summon_ice"], "loadout": ["ele_fireball", "ele_summon_ice"]})
	check(old.level == 30 and old.elem_xp == 0 and old.elem_stage == 0 and old.elem_form == "frost" and old.elem_mode == "attack", "save do Ato I: experiência 0 e a forma do último elemental")
	save.delete_slot(TEST_SLOT)
	save.slot = keep_slot
	sim.despawn(back)
	sim.despawn(old)
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == e.id:
			sim.despawn(o)
	sim.despawn(e)
	# bot ascendido contra chefe: usa a ascensão (chama o elemental) e a Fusão vai para a barra
	var b: SimEntity = sim.spawn_bot(cls, "Bot35", "city_aldara", at + Vector3(0, 0, -20), 35)
	b.quests_completed.append("hx_asc_elementalist")
	b.learned["ele_asc_fusion"] = true
	b.learned["ele_asc_command"] = true
	sim._slot_bot(b)
	check(b.slot_of("ele_asc_fusion") >= Balance.SKILL_SLOTS and b.slot_of("ele_asc_command") < 0, "bot ascendido: Fusão numa vaga extra (7+), o modo vai pelo comando")
	var tr: Dictionary = gd.trees["elementalist"]
	check(not tr["nodes"].values().any(func(n): return str(n.get("ref", "")).begins_with("ele_asc_")) and gd.skills["ele_asc_fusion"].ascension and gd.skills["ele_asc_command"].ascension,
		"skills de ascensão marcadas (ascension) e fora da teia normal")
	var bm: SimEntity = sim.spawn_monster(gd.monsters["ghoul_giant"], "city_aldara", b.position + Vector3(5, 0, 0))
	bm.aggro_target = b.id
	var uses0: int = b.elem_uses
	for i in range(60 * 60):
		sim.tick(1.0 / 60.0)
		if b.elem_uses > uses0 or not bm.is_alive():
			break
	check(b.elem_uses > uses0, "bot ascendido usa a ascensão em 60 s de luta contra chefe (%d)" % (b.elem_uses - uses0))
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.SUMMON and o.owner_id == b.id:
			sim.despawn(o)
	sim.despawn(bm)
	sim.despawn(b)

## Esquiva passiva da AGI (decisão do autor, 2026-11-12): curva Balance.EVASION_AGI_*, só personagens, só golpe direto, teto EVASION_CAP.
func _check_agi_evasion(gd, sim) -> void:
	var ref := Balance.EVASION_AGI_REF
	check(Stats.agi_evasion(0.0) == 0.0 and Stats.agi_evasion(-5.0) == 0.0, "AGI 0 não dá esquiva")
	check(is_equal_approx(Stats.agi_evasion(ref), Balance.EVASION_AGI_REF_PCT), "AGI de referência (%.0f) dá %.0f%% de esquiva" % [ref, Balance.EVASION_AGI_REF_PCT])
	check(Stats.agi_evasion(ref) >= 9.0 and Stats.agi_evasion(ref) <= 11.0, "build toda em AGI no 45 fica perto de 10%% (%.1f%%)" % Stats.agi_evasion(ref))
	var low := Stats.agi_evasion(40.0)          # força com AGI de passagem (Cruzado/Executor/Fera no 45)
	check(low >= 1.0 and low <= 3.0, "AGI de passagem (40) dá 1-3%% (%.1f%%)" % low)
	check(Stats.agi_evasion(80.0) < 5.0, "AGI média (80, Carniceiro no 45) fica abaixo de 5%% (%.1f%%)" % Stats.agi_evasion(80.0))
	check(Stats.agi_evasion(100.0) > Stats.agi_evasion(50.0) and Stats.agi_evasion(50.0) > 0.0, "mais AGI, mais esquiva")
	# bot da build de AGI: a esquiva da ficha vem da AGI (o Caçador não tem outra fonte)
	var at := Vector3(34, 0, 34)
	var r: SimEntity = sim.spawn_bot(gd.classes["ranger"], "Eva", "city_aldara", at, 30)
	r.brain = null
	r.build_id = "cacador"
	sim._gear_bot(r)
	sim._skill_bot(r)
	r.buffs.clear()
	r.recompute_stats()
	var from_agi := Stats.agi_evasion(float(r.stats.attrs["AGI"]) / Balance.ATTR_SCALE)
	check(r.stats.attrs["AGI"] > 0 and from_agi > 2.0 and r.stats.evasion >= from_agi - 0.001, "Caçador nv 30 esquiva pela AGI (%d AGI -> %.1f%%, ficha %.1f%%)" % [r.stats.attrs["AGI"], from_agi, r.stats.evasion])
	# soma com a esquiva de buff/passivo e respeita o teto
	r.buffs.append({"id": "t_agi_ev", "duration": 99, "remaining": 99, "evasion": 5.0})
	r.recompute_stats()
	check(is_equal_approx(r.stats.evasion, minf(from_agi + 5.0, Balance.EVASION_CAP)), "esquiva da AGI soma com a de buff (%.1f%%)" % r.stats.evasion)
	r.buffs.append({"id": "t_agi_big", "duration": 99, "remaining": 99, "attr_AGI": 100000})
	r.recompute_stats()
	check(r.stats.evasion == Balance.EVASION_CAP, "AGI enorme para no teto (%.0f%%)" % Balance.EVASION_CAP)
	# taxa real: AGI de referência pega ~10% dos golpes diretos (1000 golpes, semente fixa)
	r.buffs.clear()
	r.recompute_stats()
	r.buffs.append({"id": "t_agi_set", "duration": 99, "remaining": 99, "attr_AGI": int(ref * Balance.ATTR_SCALE) - int(r.stats.attrs["AGI"])})
	r.recompute_stats()
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 1.5))
	var dodged := 0
	sim.rng.seed = 23
	for i in range(1000):
		var hp0: float = r.hp
		sim._deal_damage(mob, r, 1, false, false, "physical")
		if r.hp == hp0:
			dodged += 1
		r.hp = r.stats.max_hp
	check(dodged >= 70 and dodged <= 130, "AGI %d esquiva ~10%% dos golpes de monstro (%d/1000, ficha %.1f%%)" % [r.stats.attrs["AGI"], dodged, r.stats.evasion])
	# dano no tempo não é golpe direto: nunca é esquivado
	r.buffs.append({"id": "t_agi_cap", "duration": 99, "remaining": 99, "evasion": 300})
	r.recompute_stats()
	var dot_miss := 0
	for i in range(200):
		var hp1: float = r.hp
		sim._deal_damage(mob, r, 1, false, false, "dot")
		if r.hp == hp1:
			dot_miss += 1
		r.hp = r.stats.max_hp
	check(dot_miss == 0, "dano no tempo ignora a esquiva (%d de 200 não pegaram)" % dot_miss)
	# monstro não esquiva: nem com AGI no stat (não passa por Stats.compute) nem forçando o stat
	check(mob.stats.evasion == 0.0, "monstro não ganha esquiva")
	mob.stats.evasion = Balance.EVASION_CAP
	var mob_miss := 0
	for i in range(200):
		var mh: float = mob.hp
		sim._deal_damage(r, mob, 1, false, false, "physical")
		if mob.hp == mh:
			mob_miss += 1
		mob.hp = mob.stats.max_hp
	check(mob_miss == 0, "golpe de bot em monstro nunca é esquivado (%d de 200)" % mob_miss)
	sim.despawn(mob)
	sim.despawn(r)

func _check_assassin_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["assassin"]
	var lam: Dictionary = cls.build_by_id("laminas")
	var due: Dictionary = cls.build_by_id("duelista")
	var cor: Dictionary = cls.build_by_id("corsario")
	check(cls.builds.size() == 3 and lam["main"] == ["dagger"] and lam["off"] == ["dagger"] and due["main"] == ["sword"] and due["off"] == ["sword"]
		and cor["main"] == ["sword"] and cor["off"] == ["pistol"], "Assassino: Lâminas (duas adagas), Duelista (duas espadas) e Corsário (sabre + pistola)")
	for sid in ["ass_plague_blade", "ass_vanish", "ass_reflexes"]:
		check(sid in lam["skills"], "Lâminas tem %s" % sid)
	for sid in ["ass_cross_slash", "ass_guard", "ass_lunge", "ass_master"]:
		check(sid in due["skills"], "Duelista tem %s" % sid)
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(30, 0, 30)
	var a: SimEntity = sim.spawn_bot(cls, "Ass", "city_aldara", at, 30)
	a.brain = null
	a.equipment[ItemDef.Slot.WEAPON] = gd.items["dagger_golem"]
	a.equipment[ItemDef.Slot.OFFHAND] = gd.items["dagger_golem"]
	a.recompute_stats()
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 1.5))
	mob.brain = null
	# pelas costas: alvo de costas para o atacante
	mob.facing = 0.0          # olha para +Z, o assassino está em -Z (atrás)
	check(Combat.is_behind(a, mob), "atacante atrás do alvo é pelas costas")
	mob.facing = PI
	check(not Combat.is_behind(a, mob), "de frente não é pelas costas")
	var rng := RandomNumberGenerator.new()
	var front := 0.0
	var back := 0.0
	a.buffs.append({"id": "t_bs", "duration": 99, "remaining": 99, "backstab": 40})
	a.recompute_stats()
	for i in range(200):
		mob.facing = PI
		front += float(Combat.calc_damage(a, mob, 1.0, SkillDef.Kind.PHYSICAL, rng)["amount"])
		mob.facing = 0.0
		back += float(Combat.calc_damage(a, mob, 1.0, SkillDef.Kind.PHYSICAL, rng)["amount"])
	check(back > front * 1.3, "pelas costas bate bem mais forte (%.0f x %.0f)" % [back, front])
	# veneno na lâmina
	a.buffs.append({"id": "t_pb", "duration": 99, "remaining": 99, "hit_poison": 9})
	a.recompute_stats()
	check(a.stats.hit_poison == 9.0, "buff de veneno na lâmina vira stat")
	sim._deal_damage(a, mob, 10, false, false, "physical")
	sim._deal_damage(a, mob, 10, false, false, "physical")
	var pd: Array = mob.debuffs.filter(func(d): return str(d.get("id", "")).begins_with("blade_poison"))
	check(pd.size() == 1 and mob.has_debuff("dot"), "golpe físico envenena e renova (não acumula)")
	# esquiva: com 45% de esquiva, parte dos golpes não pega
	a.buffs.append({"id": "t_ev", "duration": 99, "remaining": 99, "evasion": 300})
	a.recompute_stats()
	check(a.stats.evasion == Balance.EVASION_CAP, "esquiva tem teto")
	var dodged := 0
	sim.rng.seed = 11
	for i in range(200):
		var hp0: float = a.hp
		sim._deal_damage(mob, a, 1, false, false, "physical")
		if a.hp == hp0:
			dodged += 1
		a.hp = a.stats.max_hp
	check(dodged > 60 and dodged < 120, "esquiva perto de %d%% (%d/200)" % [int(Balance.EVASION_CAP), dodged])
	# Sumir: furtividade sem forma de lobo
	a.buffs.clear()
	a.recompute_stats()
	sim._apply_effects(a, a, gd.skills["ass_vanish"].effects, 0.0)
	check(a.stealth_left > 0.0, "Sumir deixa o Assassino furtivo")
	sim.despawn(mob)
	sim.despawn(a)

## Terceiras builds do Berserker (Punhos de Fúria: duas garras, esquiva vira Fúria) e do Assassino (Corsário: sabre + pistola,
## Bravata): setor próprio na teia, 6 conjuntos com visual, efeito lendário, bot que se equipa e gasta a teia.
func _check_third_builds(gd, sim) -> void:
	var at := Vector3(-30, 0, 34)
	for row in [["berserker", "punhos", "claw", "claw", "ber_fist_flurry", "fist_counter"], ["assassin", "corsario", "sword", "pistol", "ass_pistol_shot", "spare_shot"]]:
		var cid: String = row[0]
		var bid: String = row[1]
		var cls: ClassDef = gd.classes[cid]
		var b: Dictionary = cls.build_by_id(bid)
		check(b["main"] == [row[2]] and b["off"] == [row[3]], "%s/%s: %s + %s" % [cid, bid, row[2], row[3]])
		var own: Array = b["skills"].filter(func(sid): return gd.skills[sid].build == bid)
		var mixed: Array = b["skills"].filter(func(sid): return gd.skills[sid].build != bid and gd.skills[sid].build != "")
		check(own.size() >= 6 and mixed.size() >= 2, "%s: skills próprias (%d) e de outras builds misturadas (%d)" % [bid, own.size(), mixed.size()])
		# teia: setor próprio com skills e passivos
		var nodes: Dictionary = gd.trees[cid]["nodes"]
		var in_sector := 0
		var stat_nodes := 0
		for nid in nodes:
			if nodes[nid]["branch"] == bid:
				in_sector += 1
				stat_nodes += 1 if nodes[nid]["kind"] == "stat" else 0
		check(in_sector >= 20 and stat_nodes >= 5, "%s: setor da teia com nós (%d, %d passivos)" % [bid, in_sector, stat_nodes])
		# 6 conjuntos, cada um com visual próprio, armas próprias (as duas mãos) e o efeito lendário da build
		var styles := {}
		for lv in _own_visual_levels():
			var sid: String = "set_%s_%s_%d" % [cid, bid, lv]
			check(gd.sets.has(sid) and GearCatalog.SET_VISUALS.has(sid), "%s existe com visual próprio" % sid)
			if not gd.sets.has(sid):
				continue
			var vis: Dictionary = GearCatalog.SET_VISUALS[sid]
			styles[vis["style"]] = true
			var w: ItemDef = gd.items["leg_%s_%s_%d_weapon" % [cid, bid, lv]]
			var o: ItemDef = gd.items["leg_%s_%s_%d_offhand" % [cid, bid, lv]]
			check(w.weapon_type == row[2] and o.weapon_type == row[3] and w.weapon_style == vis["style"] and o.weapon_style == vis["style"], "%s: armas próprias nas duas mãos" % sid)
			check(str(w.legend_effect.get("kind", "")) == row[5] and float(w.legend_effect.get("pct", 0)) > 0.0, "%s: arma com %s" % [sid, row[5]])
			for piece in ["head", "body", "gloves", "boots", "weapon", "offhand"]:
				check(ResourceLoader.exists("res://assets/icons/%s_%s.png" % [vis["icon"], piece]), "%s: ícone %s" % [sid, piece])
		check(styles.size() == 6, "%s: 6 visuais diferentes (%d)" % [bid, styles.size()])
		# bot da build: armas certas, skills da build na barra e pontos no setor dela
		var bot: SimEntity = sim.spawn_bot(cls, "Third", "city_aldara", at, 30)
		bot.brain = null
		bot.build_id = bid
		sim._gear_bot(bot)
		sim._skill_bot(bot)
		check(bot.stats.weapon_type == row[2] and bot.stats.offhand_type == row[3], "bot %s: empunha %s + %s (%s + %s)" % [bid, row[2], row[3], bot.stats.weapon_type, bot.stats.offhand_type])
		var slotted: Array = bot.skills.filter(func(s): return s != null).map(func(s): return s.id)
		check(slotted.size() == Balance.SKILL_SLOTS and row[4] in slotted and slotted.all(func(x): return bot.stats.meets(gd.skills[x].requires)), "bot %s: barra cheia com %s (%s)" % [bid, row[4], slotted])
		var bought := 0
		for nid in bot.tree:
			if nodes.has(nid) and nodes[nid]["branch"] == bid:
				bought += 1
		check(bought >= 15, "bot %s: gasta a teia no setor da build (%d nós)" % [bid, bought])
		sim.despawn(bot)
	var e: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Punho", "city_aldara", at, 30)
	e.brain = null
	e.equipment[ItemDef.Slot.WEAPON] = gd.items["leg_berserker_punhos_30_weapon"]
	e.recompute_stats()
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 2))
	foe.brain = null
	var a: SimEntity = sim.spawn_bot(gd.classes["assassin"], "Expor", "city_aldara", at + Vector3(2, 0, 0), 30)
	a.brain = null
	foe.debuffs.clear()
	# Expor Fraqueza (Duelista; o Corsário também usa): o alvo recebe mais dano de todos
	foe.debuffs.clear()
	foe.hp = foe.stats.max_hp
	var hp0: float = foe.hp
	sim._deal_damage(e, foe, 100, false, false, "physical")
	var plain: float = hp0 - foe.hp
	sim._apply_effects(a, foe, gd.skills["ass_expose"].effects, 1.0)
	foe.hp = foe.stats.max_hp
	sim._deal_damage(e, foe, 100, false, false, "physical")
	var exposed: float = hp0 - foe.hp
	check(exposed > plain * 1.1,"Expor Fraqueza: alvo exposto apanha mais de todos (%.0f x %.0f)" % [exposed, plain])
	check(UiKit.legend_effect_text(e.stats.legend).contains("contra-ataque"), "texto do efeito novo (Punho Vingativo)")
	for x in [e, a, foe]:
		sim.despawn(x)

## Punhos de Fúria (Berserker, duas garras): garra é arma de 1 mão das duas mãos; esquivar com duas garras dá Fúria do
## Punho (ATK e velocidade por carga, até o máximo) e contra-ataca quem está perto; Punho Vingativo (arma lendária) bate
## mais forte; Punho Final gasta as cargas (mais dano); Chakra cura vida e mana; save do Arremessador vira Punhos.
## Berserker ascendido: fazer "subir" um bot (nível da ascensão + missão hx_asc_berserker).
func _ascend(e: SimEntity) -> void:
	e.level = maxi(e.level, Balance.ASC_LEVEL)
	if not e.quests_completed.has("hx_asc_" + e.class_def.id):
		e.quests_completed.append("hx_asc_" + e.class_def.id)
	e.recompute_stats()

## Empunhadura de Titã (F7, AC-28): razão de DPS, regra de equipar, nós de alívio da teia, Garras de Titã, bots.
func _check_titan_grip(gd, sim) -> void:
	check(absf(Stats.titan_dps_ratio(0) - 1.0875) < 0.0001, "F7: 2 machados de 2 mãos sem nó = x1,0875 (%.4f)" % Stats.titan_dps_ratio(0))
	check(absf(Stats.titan_dps_ratio(3) - 1.218) < 0.0001, "F7: com 3 nós da teia = x1,218 (%.4f)" % Stats.titan_dps_ratio(3))
	check(is_equal_approx(Stats.titan_dps_ratio(5), Stats.titan_dps_ratio(3)) and Stats.titan_dps_ratio(3) < 1.25, "F7: o 4º nó não conta e nunca passa de +25%")
	check(absf(100.0 * Stats.titan_dps_ratio(0) - 108.75) < 0.01 and absf(100.0 * Stats.titan_dps_ratio(3) - 121.8) < 0.01, "F7: 100 de DPS -> 108,75 / 121,8")
	var cls: ClassDef = gd.classes["berserker"]
	var at := Vector3(-30, 0, 26)
	var b: SimEntity = sim.spawn_bot(cls, "Tita", "city_aldara", at, 30)
	b.brain = null
	b.add_item("axe_golem", 2)
	check(sim.equip(b, "axe_golem"), "Titã: machado de 2 mãos na principal")
	check(sim.equip_error(b, gd.items["axe_golem"], true) == "Requer Empunhadura de Titã" and not sim.equip(b, "axe_golem", true), "sem a ascensão, a mão secundária recusa com \"Requer Empunhadura de Titã\"")
	b.level = Balance.ASC_LEVEL
	b.recompute_stats()
	check(not ProgressionSystem.has_ascension(b) and sim.equip_error(b, gd.items["axe_golem"], true) != "", "nível sem a missão: ainda sem ascensão")
	_ascend(b)
	check(ProgressionSystem.has_ascension(b), "nível %d + hx_asc_berserker: ascendido" % Balance.ASC_LEVEL)
	var patk1: float = b.stats.patk
	var for1: int = b.stats.attrs["FOR"]
	check(sim.equip(b, "axe_golem", true) and b.stats.titan_pair and b.equipment.get(ItemDef.Slot.WEAPON) != null, "ascendido: machado de 2 mãos nas duas mãos")
	check(is_equal_approx(b.stats.patk, patk1) and b.stats.attrs["FOR"] == for1, "2ª arma de 2 mãos não soma ATK nem atributos (bate à parte)")
	check(b.stats.meets(["dual"]) and b.stats.meets(["two_handed"]) and b.stats.meets(["titan"]), "Titã vale para skills de duas armas, de 2 mãos e de Titã")
	check(absf(b.stats.titan_speed - (1.0 - Balance.TITAN_ASPD_PEN)) < 0.0001 and is_equal_approx(b.stats.basic_cooldown(1.0), 1.0 / ((1.0 + b.stats.attack_speed / 100.0) * 0.75)), "Titã: básico 25% mais lento")
	var pm := TitanSystem.power_mult(b, b.basic_skill)
	check(is_equal_approx(pm, 1.0 + Balance.TITAN_OFFHAND_MULT), "golpe duplo: básico x%.2f com dois machados iguais" % pm)
	check(absf(pm * b.stats.titan_speed - 1.0875) < 0.0001, "golpe duplo x velocidade = F7 no básico (%.4f)" % (pm * b.stats.titan_speed))
	check(is_equal_approx(TitanSystem.power_mult(b, gd.skills["ber_glad_fire"]), pm) and is_equal_approx(TitanSystem.power_mult(b, gd.skills["ber_overhead"]), 1.0), "Lâmina bate com as duas armas; skill comum não")
	# 2ª arma mais fraca: golpe duplo proporcional ao ATK dela
	b.add_item("axe_iron", 1)
	check(sim.equip(b, "axe_iron", true) and absf(b.stats.titan_hit - Balance.TITAN_OFFHAND_MULT * gd.items["axe_iron"].atk / gd.items["axe_golem"].atk) < 0.001, "2ª arma mais fraca: golpe duplo menor (%.3f)" % b.stats.titan_hit)
	# alívio da teia de ascensão (stat "titan_relief"; a teia é de outro pacote: aqui vem pelo tree_bonus)
	b.tree_bonus["titan_relief"] = float(Balance.TITAN_RELIEF_NODES + 1)
	b.recompute_stats()
	check(b.stats.titan_relief == Balance.TITAN_RELIEF_NODES + 1 and absf(b.stats.titan_speed - 0.84) < 0.0001, "3 nós de alívio: básico só 16%% mais lento, o 4º não conta (%.3f)" % b.stats.titan_speed)
	b.tree_bonus.erase("titan_relief")
	b.recompute_stats()
	var nodes: Dictionary = gd.trees["berserker"]["nodes"]
	for sid in cls.skill_ids:
		if gd.skills[sid].ascension:
			check(not nodes.has("berserker_s_" + sid) and not nodes.has("berserker_m_" + sid), "teia comum: %s fica de fora (teia de ascensão)" % sid)
	# trocar a principal por uma de 1 mão devolve o machado de 2 mãos da secundária
	b.add_item("axe_t0", 1)
	check(sim.equip(b, "axe_t0") and b.equipment.get(ItemDef.Slot.OFFHAND) == null and b.has_item("axe_iron") and not b.stats.titan_pair, "principal de 1 mão: o machado de 2 mãos sai da secundária")
	# Garras de Titã (Punhos ascendido)
	var f: SimEntity = sim.spawn_bot(cls, "Garra", "city_aldara", at + Vector3(-3, 0, 0), 30)
	f.brain = null
	f.equipment[ItemDef.Slot.WEAPON] = gd.items["claw_t3"]
	f.equipment[ItemDef.Slot.OFFHAND] = gd.items["claw_t3"]
	f.recompute_stats()
	check(not f.stats.titan_claws and is_equal_approx(TitanSystem.power_mult(f, f.basic_skill), 1.0), "garras sem ascensão: normais")
	_ascend(f)
	check(f.stats.titan_claws and is_equal_approx(TitanSystem.power_mult(f, f.basic_skill), 1.0 + Balance.TITAN_CLAW_POWER * Balance.asc_level_mult(TitanSystem.CLAW_BUILD, f.level)) and is_equal_approx(f.stats.titan_speed, 1.0 - Balance.TITAN_CLAW_ASPD_PEN), "Garras de Titã: básico +%d%% e %d%% mais lento" % [roundi(Balance.TITAN_CLAW_POWER * 100), roundi(Balance.TITAN_CLAW_ASPD_PEN * 100)])
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", f.position + Vector3(0, 0, 1.5))
	foe.brain = null
	var p0: Vector3 = foe.position
	TitanSystem.on_hit(sim, f, foe, f.basic_skill)
	check(foe.position.distance_to(f.position) > p0.distance_to(f.position) + 0.3, "Garras de Titã: o básico empurra")
	sim.despawn(foe)
	# bot ascendido de Executor/Gêmeos empunha os dois machados; sem ascensão, um só
	for bid in Balance.TITAN_BUILDS:
		var g: SimEntity = sim.spawn_bot(cls, "Gt", "city_aldara", at + Vector3(0, 0, -3), 30)
		g.brain = null
		g.build_id = bid
		sim._gear_bot(g)
		check(not g.stats.titan_pair, "bot %s sem ascensão: sem Titã" % bid)
		_ascend(g)
		sim._gear_bot(g)
		check(g.stats.titan_pair and g.stats.meets(["dual"]), "bot %s ascendido: dois machados de 2 mãos" % bid)
		sim.despawn(g)
	for e in [b, f]:
		sim.despawn(e)

## Modo Gladiador (F9b, AC-31c, AC-25): postura, Glória (teto, ganhos, gasto), Lâminas Elementais, Brado, bots.
func _check_gladiator(gd, sim) -> void:
	var cls: ClassDef = gd.classes["berserker"]
	var at := Vector3(-30, 0, 34)
	var m: Dictionary = sim.maps["city_aldara"]
	var b: SimEntity = sim.spawn_bot(cls, "Glad", "city_aldara", at, 30)
	b.brain = null
	b.build_id = "carniceiro"          # build fixa: o sorteio do bot podia dar Punhos (garras guardam a Glória ao sair)
	sim._gear_bot(b)
	_ascend(b)
	var stance: SkillDef = gd.skills["ber_gladiator"]
	check(stance.effects.has("aura") and bool(stance.effects["buff"].get("toggle", false)) and stance.ascension, "Modo Gladiador: liga/desliga, skill da ascensão")
	for sid in ["ber_glad_fire", "ber_glad_frost", "ber_glad_storm", "ber_glad_rush", "ber_arena_shout"]:
		check(Array(gd.skills[sid].requires) == ["gladiator"] and not b.stats.meets(gd.skills[sid].requires), "%s só no Modo Gladiador" % sid)
	check(Array(gd.skills["ber_glad_finale"].requires) == ["glory_full"], "Golpe Final exige Glória cheia")
	var patk0: float = b.stats.patk
	var pdef0: float = b.stats.pdef
	GladiatorSystem.gain_glory(sim, b, 2)
	check(b.buff_stacks(Balance.GLORY_BUFF) == 0, "fora da postura não há Glória")
	sim._apply_skill(b, stance, m)
	check(GladiatorSystem.stance_on(b) and b.stats.gladiator, "postura ligada")
	var want_atk := 1.0 + float(Balance.GLADIATOR_STANCE["atk_pct"]) / 100.0
	var want_def := 1.0 + float(Balance.GLADIATOR_STANCE["def_pct"]) / 100.0
	check(absf(b.stats.patk / patk0 - want_atk) < 0.01 and absf(b.stats.pdef / pdef0 - want_def) < 0.01, "postura: dano x%.2f e defesa x%.2f (%.3f / %.3f)" % [want_atk, want_def, b.stats.patk / patk0, b.stats.pdef / pdef0])
	for sid in ["ber_glad_fire", "ber_glad_frost", "ber_glad_storm"]:
		check(b.stats.meets(gd.skills[sid].requires), "%s liberada na postura" % sid)
	GladiatorSystem.on_hit(sim, b, true, false)
	check(b.buff_stacks(Balance.GLORY_BUFF) == 1, "golpe crítico: +1 Glória")
	GladiatorSystem.on_hit(sim, b, true, true)
	check(b.buff_stacks(Balance.GLORY_BUFF) == 3, "crítico que mata: +2 Glória")
	check(not b.stats.meets(["glory_full"]), "Golpe Final trancado com 3 de Glória")
	for i in 6:
		GladiatorSystem.on_hit(sim, b, true, false)
	check(b.buff_stacks(Balance.GLORY_BUFF) == Balance.GLORY_MAX and b.stats.glory == Balance.GLORY_MAX, "Glória para em %d" % Balance.GLORY_MAX)
	var bp := Balance.GLADIATOR_BLADE_POWER
	check(is_equal_approx(gd.skills["ber_glad_fire"].power, bp) and is_equal_approx(GladiatorSystem.blade_mult(b, bp), (bp + Balance.GLORY_STEP * Balance.GLORY_MAX) / bp), "Lâmina: power %.1f + %.1f por Glória (x%.3f)" % [bp, Balance.GLORY_STEP, GladiatorSystem.blade_mult(b, bp)])
	check(b.stats.meets(["glory_full"]), "Glória cheia: Golpe Final liberado")
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 2))
	foe.brain = null
	foe.stats.max_hp *= 100.0              # não morre nos golpes do teste (o abate daria Glória)
	foe.hp = foe.stats.max_hp
	b.face_towards(foe.position)
	b.skill_aim = foe.position
	var h0: float = foe.hp
	sim._apply_skill(b, gd.skills["ber_glad_finale"], m)
	check(b.buff_stacks(Balance.GLORY_BUFF) <= 1 and foe.hp < h0, "Golpe Final: gasta toda a Glória e bate (sobra %d de um crítico)" % b.buff_stacks(Balance.GLORY_BUFF))
	check(b.combo_spent == Balance.GLORY_MAX, "Golpe Final gastou %d de Glória" % b.combo_spent)
	# Lâminas Elementais aplicam o elemento
	foe.hp = foe.stats.max_hp
	foe.debuffs.clear()
	sim._apply_skill(b, gd.skills["ber_glad_fire"], m)
	check(foe.debuffs.any(func(d): return d.get("kind") == "dot" and d.get("fire", false)), "Lâmina Ígnea queima")
	foe.debuffs.clear()
	sim._apply_skill(b, gd.skills["ber_glad_frost"], m)
	check(foe.debuffs.any(func(d): return d.get("kind") == "slow") and Combat.frost_mult(gd.skills["ber_glad_frost"], foe) > 1.0, "Lâmina Gélida deixa lento e estilhaça quem está lento")
	var n1: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(3, 0, 2.5))
	var n2: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(-3, 0, 2.5))
	var far: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 14))
	for x in [n1, n2, far]:
		x.brain = null
		x.stats.max_hp *= 100.0
		x.hp = x.stats.max_hp
	foe.hp = foe.stats.max_hp
	b.face_towards(foe.position)
	sim._apply_skill(b, gd.skills["ber_glad_storm"], m)
	check(n1.hp < n1.stats.max_hp and n2.hp < n2.stats.max_hp and is_equal_approx(far.hp, far.stats.max_hp) and foe.hp < foe.stats.max_hp, "Lâmina Trovejante: o raio salta para 2 vizinhos")
	# Brado da Arena: provoca e dá Glória por provocado (até 3)
	b.drop_buff(Balance.GLORY_BUFF)
	sim._apply_skill(b, gd.skills["ber_arena_shout"], m)
	check(b.buff_stacks(Balance.GLORY_BUFF) == Balance.GLORY_SHOUT_MAX and foe.aggro_target == b.id and n1.aggro_target == b.id and far.aggro_target != b.id, "Brado da Arena: provoca a 8 m e +%d Glória (%d)" % [Balance.GLORY_SHOUT_MAX, b.buff_stacks(Balance.GLORY_BUFF)])
	# abate de verdade (pelo _deal_damage) dá Glória
	var g0 := b.buff_stacks(Balance.GLORY_BUFF)
	sim._deal_damage(b, n2, int(n2.hp) + 10, false, false, "physical")
	check(not n2.is_alive() and b.buff_stacks(Balance.GLORY_BUFF) == g0 + 1, "abate na postura: +1 Glória")
	# desligar zera a Glória
	sim._apply_skill(b, stance, m)
	check(not GladiatorSystem.stance_on(b) and b.buff_stacks(Balance.GLORY_BUFF) == 0 and not b.stats.gladiator, "sair da postura zera a Glória e tira o bônus")
	# Punhos: a Fúria vira Glória e ela fica 6 s ao sair
	var f: SimEntity = sim.spawn_bot(cls, "GladP", "city_aldara", at + Vector3(4, 0, 0), 30)
	f.brain = null
	f.equipment[ItemDef.Slot.WEAPON] = gd.items["claw_t3"]
	f.equipment[ItemDef.Slot.OFFHAND] = gd.items["claw_t3"]
	_ascend(f)
	sim._apply_skill(f, stance, m)
	FistSystem.gain_fury(sim, f, 3)
	check(f.buff_stacks(Balance.GLORY_BUFF) == 3 and f.buff_stacks(Balance.FIST_FURY_BUFF) == 0, "Punhos na postura: a Fúria do Punho vira Glória")
	sim._apply_skill(f, stance, m)
	var left := 0.0
	for x in f.buffs:
		if x.get("id") == Balance.GLORY_BUFF:
			left = float(x["remaining"])
	check(f.buff_stacks(Balance.GLORY_BUFF) == 3 and left <= Balance.GLORY_KEEP_FISTS + 0.001, "Punhos: sai da postura e guarda a Glória por %d s" % int(Balance.GLORY_KEEP_FISTS))
	for x in [foe, n1, n2, far, b, f]:
		sim.despawn(x)
	# bot ascendido: compra na teia de ascensão (AscensionCatalog.bot_order) e põe nas vagas 7-0, sem tirar skill da build;
	# liga a postura na luta (60 s)
	var bot: SimEntity = sim.spawn_bot(cls, "GladBot", "city_aldara", at + Vector3(0, 0, -6), 30)
	bot.build_id = "executor"
	_ascend(bot)
	sim._gear_bot(bot)
	sim._skill_bot(bot)
	var normal: Array = bot.skills.slice(0, Balance.SKILL_SLOTS).filter(func(x): return x != null)
	check(normal.size() == Balance.SKILL_SLOTS and normal.all(func(x): return not x.ascension), "bot ascendido: as 6 vagas comuns ficam com a build")
	check(bot.knows("ber_gladiator") and bot.slot_of("ber_gladiator") >= Balance.SKILL_SLOTS, "bot ascendido: Modo Gladiador numa vaga extra (%d)" % bot.slot_of("ber_gladiator"))
	for sid in ProgressionSystem.ascension_skills(bot):
		check(not bot.knows(sid) or bot.slot_of(sid) >= Balance.SKILL_SLOTS, "bot ascendido: %s aprendida fica em 7-0 (%d)" % [sid, bot.slot_of(sid)])
	var plain: SimEntity = sim.spawn_bot(cls, "GladBot0", "city_aldara", at + Vector3(4, 0, -6), Balance.ASC_LEVEL)
	plain.build_id = "executor"
	sim._skill_bot(plain)
	check(plain.skills.size() == Balance.SKILL_SLOTS and not plain.knows("ber_gladiator"), "bot sem a missão: sem skill de ascensão nem vaga extra")
	sim.despawn(plain)
	var boss: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", bot.position + Vector3(0, 0, 3))
	boss.stats.max_hp *= 50.0
	boss.hp = boss.stats.max_hp
	boss.brain = null
	var used := 0.0
	var t := 0.0
	while t < 60.0 and used <= 0.0:
		sim.tick(1.0 / 20.0)
		t += 1.0 / 20.0
		if GladiatorSystem.stance_on(bot):
			used = t
	check(used > 0.0, "bot ascendido liga o Modo Gladiador em até 60 s de luta (%.1f s)" % used)
	sim.despawn(boss)
	sim.despawn(bot)

func _check_fist_fury(gd, sim) -> void:
	var cls: ClassDef = gd.classes["berserker"]
	check("claw" in cls.weapon_types and "claw" in cls.offhand_types and "claw" in ItemDef.ONE_HANDED_MELEE and gd.items.has("claw_t0"), "garra: arma de 1 mão do Berserker, comum no tier 0")
	var at := Vector3(-34, 0, 30)
	var b: SimEntity = sim.spawn_bot(cls, "Monge", "city_aldara", at, 30)
	b.brain = null
	b.equipment[ItemDef.Slot.WEAPON] = gd.items["claw_t3"]
	b.equipment[ItemDef.Slot.OFFHAND] = gd.items["claw_t3"]
	b.recompute_stats()
	check(FistSystem.has_claws(b) and b.stats.meets(["dual_claw"]), "duas garras: liga a esquiva que vira fúria")
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 2))
	foe.brain = null
	var atk0 := b.stats.patk
	var hp0 := foe.hp
	FistSystem.on_dodge(sim, b, foe, "physical")
	var hit1 := hp0 - foe.hp
	check(b.buff_stacks(Balance.FIST_FURY_BUFF) == 1 and b.stats.patk > atk0, "esquivar: +1 Fúria do Punho e mais ATK (%.0f -> %.0f)" % [atk0, b.stats.patk])
	check(hit1 > 0, "esquivar: contra-ataca quem está perto (%d)" % hit1)
	for i in 10:
		FistSystem.on_dodge(sim, b, foe, "physical")
	check(b.buff_stacks(Balance.FIST_FURY_BUFF) == Balance.FIST_FURY_MAX, "Fúria do Punho para no máximo (%d)" % b.buff_stacks(Balance.FIST_FURY_BUFF))
	foe.position = at + Vector3(0, 0, Balance.FIST_COUNTER_RANGE + 3.0)
	var hp1 := foe.hp
	FistSystem.on_dodge(sim, b, foe, "physical")
	check(is_equal_approx(foe.hp, hp1), "longe: não contra-ataca")
	foe.position = at + Vector3(0, 0, 2)
	FistSystem.on_dodge(sim, b, foe, "riposte")
	check(is_equal_approx(foe.hp, hp1), "contra-ataque não gera outro")
	# arma lendária: contra-ataque mais forte (alvo novo: o golem pode ter caído)
	sim.despawn(foe)
	foe = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 2))
	foe.brain = null
	var h0 := foe.hp
	FistSystem.on_dodge(sim, b, foe, "physical")
	var plain := h0 - foe.hp
	b.equipment[ItemDef.Slot.WEAPON] = gd.items["leg_berserker_punhos_30_weapon"]
	b.equipment[ItemDef.Slot.OFFHAND] = gd.items["leg_berserker_punhos_30_offhand"]
	b.recompute_stats()
	foe.hp = foe.stats.max_hp
	FistSystem.on_dodge(sim, b, foe, "physical")
	check(str(b.stats.legend.get("kind", "")) == "fist_counter" and (h0 - foe.hp) > plain * 1.2, "Punho Vingativo: contra-ataque mais forte (%.0f x %.0f)" % [h0 - foe.hp, plain])
	# com uma garra só: nada
	var solo: SimEntity = sim.spawn_bot(cls, "Uma", "city_aldara", at + Vector3(3, 0, 0), 30)
	solo.brain = null
	solo.equipment[ItemDef.Slot.WEAPON] = gd.items["claw_t3"]
	solo.equipment.erase(ItemDef.Slot.OFFHAND)
	solo.recompute_stats()
	FistSystem.on_dodge(sim, solo, foe, "physical")
	check(solo.buff_stacks(Balance.FIST_FURY_BUFF) == 0, "uma garra só: esquiva não vira fúria")
	# Punho Final gasta tudo e bate mais
	var mult := FistSystem.spend_fury(b, 30.0)
	check(is_equal_approx(mult, 1.0 + 0.3 * Balance.FIST_FURY_MAX) and b.buff_stacks(Balance.FIST_FURY_BUFF) == 0, "Punho Final: gasta as cargas (x%.2f)" % mult)
	check(gd.skills["ber_final_fist"].effects.has("fury_spend") and gd.skills["ber_hundred_fists"].effects.get("fury_gain", 0) > 0, "Punho Final gasta e Cem Punhos ganha Fúria")
	# Chakra: cura vida e devolve mana
	b.hp = b.stats.max_hp * 0.5
	b.mp = 0.0
	sim._apply_effects(b, b, {"heal_pct": 20, "mana_pct": 15}, 1.0)
	check(b.hp > b.stats.max_hp * 0.6 and b.mp > b.stats.max_mp * 0.1, "Chakra: cura vida e devolve mana")
	# esquiva de verdade passa pelo _deal_damage: monstro erra o golpe -> Fúria
	b.drop_buff(Balance.FIST_FURY_BUFF)
	b.put_buff({"id": "counter_stance", "remaining": 99.0, "evasion": 100})
	b.recompute_stats()
	var dodged := 0
	for i in 40:                                  # esquiva tem teto (EVASION_CAP): alguns golpes passam
		b.hp = b.stats.max_hp
		var st0 := b.buff_stacks(Balance.FIST_FURY_BUFF)
		sim._deal_damage(foe, b, 50, false, false, "physical")
		if b.hp == b.stats.max_hp:
			dodged += 1
			check(b.buff_stacks(Balance.FIST_FURY_BUFF) == mini(st0 + 1, Balance.FIST_FURY_MAX), "golpe esquivado no combate: +1 Fúria")
	check(dodged >= 5, "golpes esquivados no combate (%d de 40)" % dodged)
	check(SaveSystem.migrate_item_id("leg_berserker_arremessador_20_offhand+3") == "leg_berserker_punhos_20_offhand+3", "save do Arremessador vira Punhos de Fúria")
	check(SaveSystem.migrate_item_id("leg_ranger_patrulheiro_15_weapon+2") == "leg_ranger_cacador_15_weapon+2" and SaveSystem.migrate_item_id("leg_ranger_patrulheiro_15_body") == "leg_ranger_lanceiro_15_body",
		"save antigo: arco do Patrulheiro vira o do Caçador, armadura vira a do Lanceiro (+N junto)")
	for x in [b, foe, solo]:
		sim.despawn(x)

## Corsário (Assassino, sabre + pistola): pistola só na mão secundária, Bravata (ganha com tiros/cortes, o Tiro Entre os
## Olhos gasta tudo), Dados da Sorte (um buff sorteado pelo rng da sim), gancho até o cursor, bala que ricocheteia sem
## voltar nem provocar, Bala na Agulha (tiro de graça) e save antigo do Trapaceiro.
func _check_corsair(gd, sim) -> void:
	var cls: ClassDef = gd.classes["assassin"]
	check("pistol" in ItemDef.OFFHAND_ONLY and gd.items.has("pistol_t0") and gd.items["pistol_t0"].slot == ItemDef.Slot.OFFHAND
		and gd.items["pistol_t0"].level_req <= 1 and "pistol_t0" in GearCatalog.starter_weapon_ids(gd.items), "pistola: mão secundária, comum de nível 1 na loja")
	check(not ("trapaceiro" in cls.builds.map(func(b): return b["id"])) and not gd.items.has("leg_assassin_trapaceiro_30_weapon"), "Trapaceiro saiu do jogo")
	for sid in ["ass_shadow_knives", "ass_smoke_bomb", "ass_cheap_shot"]:
		check(not gd.skills.has(sid), "skill do Trapaceiro removida: %s" % sid)
	check(gd.skills["ass_caltrops"].build == "" and gd.skills["ass_paralyze"].build == "laminas" and gd.skills["ass_expose"].build == "duelista", "Abrolhos geral, Toxina nas Lâminas, Expor no Duelista")
	var at := Vector3(-34, 0, 30)
	var m: Dictionary = sim.maps["city_aldara"]
	var a: SimEntity = sim.spawn_bot(cls, "Corsario", "city_aldara", at, 30)
	a.brain = null
	check(ItemSystem.equip_error(sim, a, gd.items["pistol_t3"]) == "", "Assassino equipa pistola")
	check(ItemSystem.equip_error(sim, sim.spawn_bot(gd.classes["ranger"], "NoPistol", "city_aldara", at + Vector3(0, 0, -6), 30), gd.items["pistol_t3"]) != "", "outra classe não usa pistola")
	a.equipment[ItemDef.Slot.WEAPON] = gd.items["leg_assassin_corsario_30_weapon"]
	a.equipment[ItemDef.Slot.OFFHAND] = gd.items["leg_assassin_corsario_30_offhand"]
	a.recompute_stats()
	check(a.stats.offhand_type == "pistol" and a.stats.meets(["pistol"]) and not a.stats.meets(["dual"]), "sabre + pistola cumpre \"pistol\", não \"dual\"")
	check(gd.items["leg_assassin_corsario_30_offhand"].weapon_style == "ass_c30", "pistola lendária com modelo próprio")
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(0, 0, 2.0))
	foe.brain = null
	foe.hp = 1e9
	a.face_towards(foe.position)
	a.skill_aim = foe.position
	# Bravata: tiros e cortes juntam até o máximo; o finalizador gasta tudo e atordoa mais (Bala na Agulha parada aqui)
	a.shot_ready_at = sim.time + 1e6
	sim._apply_skill(a, gd.skills["ass_pistol_shot"], m)
	check(a.buff_stacks(Balance.BRAVADO_BUFF) == 1, "Tiro de Pistola dá 1 Bravata (%d)" % a.buff_stacks(Balance.BRAVADO_BUFF))
	sim._apply_skill(a, gd.skills["ass_slash_shot"], m)
	check(a.buff_stacks(Balance.BRAVADO_BUFF) == 3, "Corte e Tiro dá 2 Bravata (%d)" % a.buff_stacks(Balance.BRAVADO_BUFF))
	for i in range(4):
		sim._apply_skill(a, gd.skills["ass_slash_shot"], m)
	check(a.buff_stacks(Balance.BRAVADO_BUFF) == Balance.BRAVADO_MAX, "Bravata tem teto (%d)" % a.buff_stacks(Balance.BRAVADO_BUFF))
	var eyes: SkillDef = gd.skills["ass_between_eyes"]
	sim.rng.seed = 3
	var hp0: float = foe.hp
	foe.set_state(SimEntity.State.IDLE)
	sim._apply_skill(a, eyes, m)
	var full_dmg: float = hp0 - foe.hp
	var full_stun: float = foe.state_duration if foe.state == SimEntity.State.STUNNED else 0.0
	check(a.buff_stacks(Balance.BRAVADO_BUFF) == 0 and a.combo_spent == Balance.BRAVADO_MAX, "Tiro Entre os Olhos gasta toda a Bravata")
	sim.rng.seed = 3
	hp0 = foe.hp
	foe.set_state(SimEntity.State.IDLE)
	sim._apply_skill(a, eyes, m)
	var dry_dmg: float = hp0 - foe.hp
	var dry_stun: float = foe.state_duration if foe.state == SimEntity.State.STUNNED else 0.0
	check(full_dmg > dry_dmg * 2.0 and full_stun > dry_stun + 1.0, "Bravata cheia: tiro bem mais forte (%.0f x %.0f) e atordoa mais (%.1f x %.1f s)" % [full_dmg, dry_dmg, full_stun, dry_stun])
	foe.set_state(SimEntity.State.IDLE)
	# Dados da Sorte: um resultado dos 4 por vez, sorteado pelo rng da sim (mesma semente, mesmo resultado)
	var dice: SkillDef = gd.skills["ass_dice"]
	var seen := {}
	for sd_i in range(24):
		sim.rng.seed = sd_i
		sim._apply_skill(a, dice, m)
		var got: Array = a.buffs.filter(func(b): return b.get("id") == "lucky_dice")
		check(got.size() == 1, "Dados da Sorte: um buff só")
		if got.size() == 1:
			seen[str(got[0].get("label", ""))] = true
	check(seen.size() == 4, "Dados da Sorte: os 4 resultados saem (%s)" % str(seen.keys()))
	sim.rng.seed = 7
	sim._apply_skill(a, dice, m)
	var first: String = str(a.buffs.filter(func(b): return b.get("id") == "lucky_dice")[0]["label"])
	sim.rng.seed = 7
	sim._apply_skill(a, dice, m)
	check(str(a.buffs.filter(func(b): return b.get("id") == "lucky_dice")[0]["label"]) == first, "Dados da Sorte: determinístico pela semente da sim")
	a.drop_buff("lucky_dice")
	a.recompute_stats()
	# Gancho: vai até o ponto mirado (não passa dele) e corta quem está lá
	a.position = at
	var spot := at + Vector3(6, 0, 0)
	a.face_towards(spot)
	a.skill_aim = spot
	sim._apply_skill(a, gd.skills["ass_grapple"], m)
	var moved: float = a.position.distance_to(at)
	check(moved > 4.5 and moved < 6.2, "Gancho puxa até o cursor (%.1f m de 6)" % moved)
	# Bala Ricochete: salta entre inimigos, não provoca e não volta para a mão
	a.position = at
	var foes: Array = []
	for k in range(3):
		var f: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(-3.0 - k * 2.0, 0, 3.0))
		f.brain = null
		f.hp = 1e9
		foes.append(f)
	a.face_towards(foes[0].position)
	a.skill_aim = foes[0].position
	var before: Array = foes.map(func(f): return f.hp)
	sim._apply_skill(a, gd.skills["ass_ricochet_shot"], m)
	var proj: SimProjectile = null
	for p in m["projectiles"]:
		if p.owner_id == a.id and p.skill and p.skill.id == "ass_ricochet_shot":
			proj = p
	check(proj != null and not bool(proj.bounce.get("back", true)), "Bala Ricochete é uma bala (sem volta)")
	for i in range(90):
		sim._update_projectiles(m, 1.0 / 30.0)
	var hit := 0
	for k in range(3):
		hit += 1 if foes[k].hp < before[k] else 0
	check(hit == 3 and not m["projectiles"].has(proj), "Bala Ricochete acerta os 3 e some (%d)" % hit)
	check(foes.all(func(f): return f.taunt_left <= 0.0), "Bala Ricochete não provoca")
	for f in foes:
		sim.despawn(f)
	# Bala na Agulha: golpe às vezes atira de graça (com a pistola na outra mão), com recarga
	a.position = at
	a.face_towards(foe.position)
	a.drop_buff(Balance.BRAVADO_BUFF)
	var shots := 0
	a.shot_ready_at = 0.0
	sim.rng.seed = 9
	var basic: SkillDef = gd.basic_skill_for_class(cls, "sword")
	for i in range(60):
		sim.time += Balance.LEG_SHOT_ICD + 0.01
		var hb: float = foe.hp
		LegendEffects.legend_on_hit(sim, a, foe, basic, 10)
		shots += 1 if foe.hp < hb else 0
	check(shots > 8 and shots < 40, "Bala na Agulha: o golpe às vezes dispara a pistola (%d/60)" % shots)
	check(a.buff_stacks(Balance.BRAVADO_BUFF) > 0, "tiro de graça dá Bravata")
	var burst := 0
	for i in range(20):
		var hb: float = foe.hp
		LegendEffects.legend_on_hit(sim, a, foe, basic, 10)
		burst += 1 if foe.hp < hb else 0
	check(burst <= 1, "Bala na Agulha tem recarga (%d tiros sem esperar)" % burst)
	check(UiKit.legend_effect_text(a.stats.legend).contains("Bravata"), "texto da Bala na Agulha")
	# save antigo do Trapaceiro: as peças viram as do Corsário do mesmo nível
	check(SaveSystem.migrate_item_id("leg_assassin_trapaceiro_20_offhand+3") == "leg_assassin_corsario_20_offhand+3"
		and gd.resolve_item(SaveSystem.migrate_item_id("leg_assassin_trapaceiro_20_offhand+3")), "save antigo: peça do Trapaceiro vira a do Corsário")
	var d := {"level": 30, "equipment": {str(ItemDef.Slot.WEAPON): "leg_assassin_trapaceiro_25_weapon", str(ItemDef.Slot.OFFHAND): "leg_assassin_trapaceiro_25_offhand"},
		"inventory": {"leg_assassin_trapaceiro_25_head": 1}, "learned": ["ass_shadow_knives", "ass_backstab"], "tree": ["assassin_s_ass_shadow_knives"], "save_version": SaveSystem.VERSION}
	var old: SimEntity = sim.spawn_bot(cls, "Velho", "city_aldara", at + Vector3(0, 0, -3), 30)
	old.brain = null
	SaveSystem.apply_to(old, d)
	var ow: ItemDef = old.equipment.get(ItemDef.Slot.WEAPON)
	var oo: ItemDef = old.equipment.get(ItemDef.Slot.OFFHAND)
	check(ow != null and ow.id == "leg_assassin_corsario_25_weapon" and oo != null and oo.weapon_type == "pistol" and old.inventory.has("leg_assassin_corsario_25_head")
		and not old.learned.has("ass_shadow_knives"), "save antigo do Trapaceiro carrega: sabre e pistola do Corsário, skill sumida fora")
	for x in [a, foe, old]:
		sim.despawn(x)

func _check_ranger_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["ranger"]
	check(cls.builds.size() == 3 and cls.build_by_id("cacador")["main"] == ["bow"] and cls.build_by_id("atirador")["main"] == ["rifle"], "Ranger: Caçador (arco) e Atirador (mosquete)")
	_check_ranger_spear(gd, sim, cls)
	_check_ranger_ascension(gd, sim)
	_check_ranger_ascension_bots(gd, sim)
	_check_ancestral_forms(gd, sim)
	_check_ancestral_bots(gd, sim)
	_check_ancestral_dps(gd, sim)
	_check_falconer(gd, sim)
	_check_falconer_bots(gd, sim)
	check(not cls.builds.any(func(b): return not b["off"].is_empty()), "Ranger sem build de duas armas (é do Assassino)")
	for sid in ["ran_twin_cut", "ran_hunter_dash", "ran_whirl", "ran_wild", "ran_cross_cut", "ran_maul"]:
		check(not gd.skills.has(sid), "skill de corpo a corpo removida: %s" % sid)
	check("rifle" in ItemDef.TWO_HANDED and gd.items.has("rifle_t0"), "mosquete é arma de duas mãos com itens comuns")
	var bow: SkillDef = gd.basic_skill_for_class(cls, "bow")
	var rif: SkillDef = gd.basic_skill_for_class(cls, "rifle")
	check(rif.cooldown > bow.cooldown * 1.5 and rif.power > bow.power * 1.5 and rif.range > bow.range, "mosquete: tiro mais lento, mais forte e mais longe que o arco")
	check(bow.range >= 12.0 and gd.skills["ran_power_shot"].range >= 15.0, "arqueiro atira de longe (básico %.1f m, Tiro Potente %.1f m)" % [bow.range, gd.skills["ran_power_shot"].range])
	var m: Dictionary = sim.maps["city_aldara"]
	var at := Vector3(0, 0, 6)
	# ---- armadilhas ----
	var gun: SimEntity = sim.spawn_bot(cls, "Gun", "city_aldara", at, 30)
	gun.brain = null
	gun.equipment[ItemDef.Slot.WEAPON] = gd.items["rifle_t3"]
	gun.recompute_stats()
	check(gun.stats.is_ranged_weapon, "mosquete é arma de distância")
	var trap: SkillDef = gd.skills["ran_trap"]
	var spot := at + Vector3(4, 0, 0)
	sim._apply_skill(gun, trap, m)
	gun.skill_aim = spot
	for i in range(4):
		gun.skill_aim = spot + Vector3(0, 0, i * 2.0)
		sim._apply_skill(gun, trap, m)
	var mine: Array = m["traps"].filter(func(t): return t["owner"] == gun.id)
	check(mine.size() == Balance.TRAP_MAX, "no máximo %d armadilhas por ranger (%d)" % [Balance.TRAP_MAX, mine.size()])
	var t0: Dictionary = mine[0]
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", t0["pos"])
	mob.brain = null
	mob.stats.max_hp = 100000.0          # o tiro não pode matar (a morte limpa a raiz)
	mob.hp = mob.stats.max_hp
	var hp0: float = mob.hp
	sim._update_traps(m)
	check(m["traps"].has(t0) and mob.hp == hp0, "armadilha só dispara depois de armar")
	sim.time += Balance.TRAP_ARM_TIME + 0.1
	sim.rng.seed = 7          # sem esquiva aleatória no teste
	sim._update_traps(m)
	check(not m["traps"].has(t0) and mob.hp < hp0 and mob.has_debuff("root"), "pisou: dano, prende e a armadilha some")
	sim.despawn(mob)
	sim.time += 40.0
	sim._update_traps(m)
	check(m["traps"].filter(func(t): return t["owner"] == gun.id).is_empty(), "armadilha some com o tempo")
	sim.despawn(gun)
	# ---- companheiro ----
	var hunter: SimEntity = sim.spawn_bot(cls, "Hunt", "city_aldara", at, 30)
	hunter.brain = null
	hunter.equipment[ItemDef.Slot.WEAPON] = gd.items["bow_dragon"]
	hunter.recompute_stats()
	sim._apply_skill(hunter, gd.skills["ran_companion"], m)
	var pet: SimEntity = sim.pet_of(hunter)
	check(pet != null and pet.summon_expires == INF, "companheiro é permanente")
	check(pet != null and is_equal_approx(pet.stats.max_hp, hunter.stats.max_hp * Balance.PET_HP_SHARE * (1.0 + hunter.stats.pet_power / 100.0)), "vida do companheiro vem do dono")
	hunter.skills[0] = gd.skills["ran_companion"]
	hunter.learned["ran_companion"] = true
	hunter.mp = hunter.stats.max_mp
	hunter.cooldowns.clear()
	check(not sim.try_cast(hunter, 0, at, m), "com o companheiro vivo, chamar de novo não faz nada")
	var prey: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(8, 0, 0))
	prey.brain = null
	var hp1: float = prey.hp
	hunter.skill_aim = prey.position
	sim._apply_skill(hunter, gd.skills["ran_sic"], m)
	check(prey.hp < hp1 and pet.position.distance_to(prey.position) < 2.5 and pet.aggro_target == prey.id, "Ataque da Fera: o lince salta e morde o alvo")
	sim._apply_skill(hunter, gd.skills["ran_pack"], m)
	check(pet.buffs.any(func(b): return b.get("id") == "pack") and hunter.buffs.any(func(b): return b.get("id") == "pack"), "Instinto da Matilha: você e o companheiro")
	hunter.tree_bonus = {"pet_pct": 50.0}
	hunter.recompute_stats()
	sim.despawn(pet)
	sim._apply_skill(hunter, gd.skills["ran_companion"], m)
	var pet2: SimEntity = sim.pet_of(hunter)
	check(pet2 != null and pet2.stats.max_hp > hunter.stats.max_hp * Balance.PET_HP_SHARE * 1.4, "bônus de companheiro aumenta a vida dele")
	for e in [prey, pet2, hunter]:
		sim.despawn(e)
	# ---- save com skill que não existe mais: pontos voltam ----
	var old: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "Old", "city_aldara", at, 20)
	SaveSystem.apply_to(old, {"level": 20, "mastery_points": 0, "tree": ["ranger_start", "ranger_s_ran_power_shot", "ranger_s_ran_twin_cut"],
		"learned": ["ran_power_shot", "ran_twin_cut"], "class": "ranger"})
	check(not old.tree.has("ranger_s_ran_twin_cut") and old.mastery_points == SaveSystem.points_for_level(old.level), "save antigo com skill removida: árvore refeita, %d pontos devolvidos" % old.mastery_points)
	sim.despawn(old)

## Lanceiro: lança de duas mãos (estocada longa e estreita), caça de perto: estocadas, salto, dardo, armadilha de mão,
## sangramento (dot com % do ATK) e a Marca do Predador; arma lendária Ferida Aberta. Save do Patrulheiro carrega.
func _check_ranger_spear(gd, sim, cls: ClassDef) -> void:
	check(cls.build_by_id("patrulheiro").is_empty(), "Patrulheiro saiu (virou o Lanceiro)")
	var lb: Dictionary = cls.build_by_id("lanceiro")
	check(not lb.is_empty() and lb["main"] == ["spear"] and lb["off"].is_empty() and lb["armor"] == "leather", "Lanceiro: lança de duas mãos, couro")
	check("spear" in cls.weapon_types and "spear" in ItemDef.TWO_HANDED and gd.items.has("spear_t0") and gd.items["spear_t0"].is_two_handed(), "lança: arma de duas mãos do Ranger com itens comuns")
	var shop: Array = []
	for n in gd.maps["city_aldara"].npcs:
		if n["id"] == "merchant":
			shop = n["shop"]
	check(shop.has("spear_t0"), "mercador vende a lança de nível 1")
	var own := 0
	for sid in lb.get("skills", []):
		var sk: SkillDef = gd.skills.get(sid)
		check(sk != null and sk.class_id == "ranger", "Lanceiro: skill %s existe" % sid)
		if sk and sk.build == "lanceiro":
			own += 1
			check(Array(sk.requires) == ["spear"] and ResourceLoader.exists("res://assets/icons/skill_%s.png" % sid), "%s: exige lança e tem ícone" % sid)
			check(sk.startup <= 0.3, "%s: começa rápido (%.2f s)" % [sid, sk.startup])
		if sk:
			check(sk.requires.is_empty() or sk.requires.has("spear"), "Lanceiro usa %s de lança" % sid)
	check(own >= 8, "Lanceiro tem 8 skills próprias (%d)" % own)
	check(gd.skills["ran_net"].build == "cacador" and gd.skills["ran_frost_trap"].build == "atirador", "Rede volta ao Caçador e Armadilha de Gelo ao Atirador")
	for sid in ["ran_trap", "ran_mark"]:
		check(gd.skills[sid].requires.has("spear") and gd.skills[sid].requires.has("bow") and gd.skills[sid].requires.has("rifle"), "%s: arco, mosquete ou lança" % sid)
	for sid in ["ran_caltrops", "ran_tumble", "ran_prey", "ran_gale"]:
		check(not gd.skills.has(sid), "skill do Patrulheiro removida: %s" % sid)
	# básico de lança: estocada mais longa que espada, bem mais curta que o arco, estreita, atravessa
	var sp: SkillDef = gd.basic_skill_for_class(cls, "spear")
	var bow: SkillDef = gd.basic_skill_for_class(cls, "bow")
	check(sp.target == SkillDef.Target.CONE and sp.kind == SkillDef.Kind.PHYSICAL and sp.radius >= 3.0 and sp.radius <= 3.6 and sp.radius < bow.range * 0.4,
		"lança: estocada de %.1f m (arco %.1f m)" % [sp.radius, bow.range])
	check(sp.cone_angle_deg <= 50.0 and sp.max_targets >= 3, "lança: estreita e atravessa a fila")
	check(gd.basic_skill_for_class(gd.classes["paladin"], "sword2h").radius < sp.radius, "lança alcança mais que o montante")
	var st := Stats.compute(cls, 20, {ItemDef.Slot.WEAPON: gd.items["spear_t2"]}, [])
	check(not st.is_ranged_weapon and not st.is_magic_weapon and st.weapon_type == "spear", "lança é corpo a corpo")
	var agi := Stats.compute(cls, 20, {ItemDef.Slot.WEAPON: gd.items["spear_t2"]}, [{"id": "t", "attr_AGI": 100}])
	var fo := Stats.compute(cls, 20, {ItemDef.Slot.WEAPON: gd.items["spear_t2"]}, [{"id": "t", "attr_FOR": 100}])
	check(agi.patk > st.patk and fo.patk > st.patk and agi.patk > fo.patk, "lança: AGI dá mais ATK que FOR, os dois contam (%.0f / %.0f / %.0f)" % [st.patk, agi.patk, fo.patk])
	var tr: Dictionary = gd.trees["ranger"]
	var sector := 0
	for nid in tr["nodes"]:
		if str(tr["nodes"][nid].get("branch", "")) == "lanceiro":
			sector += 1
	check(sector >= 10, "teia: setor do Lanceiro não é vazio (%d nós)" % sector)
	# 6 conjuntos com visual e ícones próprios; lança própria
	var styles := {}
	for lv in _own_visual_levels():
		var sid := "set_ranger_lanceiro_%d" % lv
		check(gd.sets.has(sid) and GearCatalog.SET_VISUALS.has(sid), "%s existe com visual" % sid)
		if not gd.sets.has(sid):
			continue
		var vis: Dictionary = GearCatalog.SET_VISUALS[sid]
		styles[vis["style"]] = true
		for iid in gd.sets[sid].pieces:
			var it: ItemDef = gd.items[iid]
			if it.slot == ItemDef.Slot.WEAPON:
				check(it.weapon_type == "spear" and it.weapon_style == vis["style"] and str(it.legend_effect.get("kind", "")) == "open_wound", "%s: lança própria com Ferida Aberta" % iid)
			if it.icon != "":
				check(ResourceLoader.exists("res://assets/icons/%s.png" % it.icon), "%s: ícone %s" % [iid, it.icon])
	check(styles.size() == 6 and styles.keys().all(func(st2): return str(st2).begins_with("ran_l")), "6 visuais próprios do Lanceiro")
	# sangramento: dot de % do ATK; renova, não acumula
	var at := Vector3(0, 0, 6)
	var m: Dictionary = sim.maps["city_aldara"]
	var e: SimEntity = sim.spawn_bot(cls, "Lance", "city_aldara", at, 30)
	e.brain = null
	e.build_id = "lanceiro"
	e.equipment[ItemDef.Slot.WEAPON] = gd.items["leg_ranger_lanceiro_30_weapon"]
	e.recompute_stats()
	check(e.basic_skill != null and e.basic_skill.id.contains("_spear"), "ranger de lança ataca com a estocada (%s)" % (e.basic_skill.id if e.basic_skill else "-"))
	var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(3, 0, 0))
	mob.brain = null
	mob.stats.max_hp = 1000000.0
	mob.hp = mob.stats.max_hp
	sim._apply_effects(e, mob, {"dot": {"atk_pct": 12, "duration": 4.0}}, 1.0)
	sim._apply_effects(e, mob, {"dot": {"atk_pct": 12, "duration": 4.0}}, 1.0)
	var bleeds: Array = mob.debuffs.filter(func(d): return d.get("kind") == "dot" and d.get("bleed", false))
	check(bleeds.size() == 1 and is_equal_approx(float(bleeds[0]["dps"]), e.stats.patk * 0.12), "sangramento: 12%% do ATK por segundo e renova (%d)" % bleeds.size())
	mob.debuffs.clear()
	# Ferida Aberta: cada golpe abre uma ferida (+dano seu), com todas ele sangra
	check(is_equal_approx(LegendEffects.legend_power(sim, e, mob), 1.0), "Ferida Aberta: alvo sem ferida apanha normal")
	var le: Dictionary = e.stats.legend
	for i in range(int(le.get("max", 5)) + 2):
		LegendEffects.legend_on_hit(sim, e, mob, e.basic_skill, 50)
	check(LegendEffects.wounds(e, mob) == int(le.get("max", 5)), "Ferida Aberta: até %d feridas" % int(le.get("max", 5)))
	var lp: float = LegendEffects.legend_power(sim, e, mob)
	check(lp > 1.2 and lp < 1.35, "Ferida Aberta: 5 feridas = x%.2f do seu dano" % lp)
	check(mob.debuffs.any(func(d): return d.get("bleed", false)), "Ferida Aberta: com todas abertas o alvo sangra")
	check(UiKit.legend_effect_text(le).contains("ferida"), "texto da Ferida Aberta")
	mob.debuffs.clear()
	# skills: estocada atravessa a fila e sangra; Marca do Predador amaldiçoa; armadilha prende; Empalar avança
	var mob2: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", at + Vector3(3.0, 0, 0.2))
	mob2.brain = null
	mob2.stats.max_hp = 1000000.0
	mob2.hp = mob2.stats.max_hp
	mob.position = at + Vector3(1.5, 0, 0)
	e.facing = PI * 0.5
	e.skill_aim = at + Vector3(4, 0, 0)
	var h1: float = mob.hp
	var h2: float = mob2.hp
	sim.rng.seed = 11
	sim._apply_skill(e, gd.skills["ran_double_thrust"], m)
	check(mob.hp < h1 and mob2.hp < h2, "Estocada Dupla atravessa a fila")
	check(mob2.debuffs.any(func(d): return d.get("bleed", false)), "Estocada Dupla sangra")
	e.skill_aim = mob.position
	sim._apply_skill(e, gd.skills["ran_predator"], m)
	check(mob.debuffs.any(func(d): return d.get("kind") == "curse" and float(d.get("taken_pct", 0)) >= 18.0), "Marca do Predador: a presa recebe mais dano")
	mob.debuffs.clear()
	sim._apply_skill(e, gd.skills["ran_snare_toss"], m)
	check(mob.has_debuff("root") and mob.debuffs.any(func(d): return d.get("bleed", false)), "Armadilha Lançada: prende e sangra na hora")
	var p0: Vector3 = e.position
	e.position = at + Vector3(0, 0, -2)
	e.facing = PI
	sim._apply_skill(e, gd.skills["ran_impale"], m)
	check(e.position.z < at.z - 3.0, "Empalar avança (%.1f m)" % (at.z - 2.0 - e.position.z))
	e.position = p0
	var a0: float = e.stats.attack_speed
	sim._apply_skill(e, gd.skills["ran_blood_instinct"], m)
	check(e.stats.attack_speed > a0 and e.stats.lifesteal > 0.0, "Instinto do Predador: velocidade de ataque e roubo de vida")
	# bot do Lanceiro: lança, conjunto e teia na build
	var bot: SimEntity = sim.spawn_bot(cls, "LanceBot", "city_aldara", at + Vector3(0, 0, 3), 20)
	bot.brain = null
	bot.build_id = "lanceiro"
	ProgressionSystem.bot_spend(sim, bot, true)
	check(bot.learned.has("ran_double_thrust") and bot.learned.has("ran_javelin") and bot.learned.has("ran_spear_leap"), "bot do Lanceiro aprende as skills da build")
	check(gd.legendary_pool(cls, 30, "lanceiro").size() >= 6, "bot do Lanceiro acha o conjunto dele")
	sim._gear_bot(bot)
	check(bot.stats.weapon_type == "spear", "bot do Lanceiro empunha lança (%s)" % bot.stats.weapon_type)
	# save do Patrulheiro: peças viram as do Lanceiro (armadura) e do Caçador (arco); teia refeita com os pontos de volta
	var old: SimEntity = sim.spawn_character(SimEntity.Kind.BOT, cls, "OldPatrol", "city_aldara", at + Vector3(0, 0, -3), 20)
	SaveSystem.apply_to(old, {"level": 20, "mastery_points": 0, "class": "ranger", "save_version": SaveSystem.VERSION,
		"tree": ["ranger_start", "ranger_s_ran_power_shot", "ranger_s_ran_caltrops"], "learned": ["ran_power_shot", "ran_caltrops"],
		"equipment": {str(int(ItemDef.Slot.WEAPON)): "leg_ranger_patrulheiro_20_weapon+2", str(int(ItemDef.Slot.BODY)): "leg_ranger_patrulheiro_20_body"},
		"inventory": {"leg_ranger_patrulheiro_15_head": 1}, "storage": {"leg_ranger_patrulheiro_10_boots": 1}})
	var w: ItemDef = old.equipment.get(ItemDef.Slot.WEAPON)
	var b: ItemDef = old.equipment.get(ItemDef.Slot.BODY)
	check(w != null and w.weapon_type == "bow" and w.plus == 2 and w.base_id == "leg_ranger_cacador_20_weapon", "save do Patrulheiro: arco +2 vira o do Caçador +2")
	check(b != null and b.id == "leg_ranger_lanceiro_20_body", "save do Patrulheiro: armadura vira a do Lanceiro")
	check(old.has_item("leg_ranger_lanceiro_15_head") and old.storage.has("leg_ranger_lanceiro_10_boots"), "save do Patrulheiro: bolsa e depósito também")
	check(not old.learned.has("ran_caltrops") and old.mastery_points == SaveSystem.points_for_level(old.level), "save do Patrulheiro: teia refeita, %d pontos de volta" % old.mastery_points)
	for x in [e, mob, mob2, bot, old]:
		sim.despawn(x)

## Druida: Xamã (cajado, invocações e bênçãos), Lobo (duas maças, forma de lobo, furtividade) e Urso (malho, forma de urso).
func _check_druid_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["druid"]
	check(cls.build_by_id("xama")["main"] == ["staff"] and cls.build_by_id("xama")["off"].is_empty(), "Xamã: cajado de duas mãos")
	check(cls.build_by_id("fera")["main"] == ["mace"] and cls.build_by_id("fera")["off"] == ["mace"], "Lobo: duas maças")
	check(cls.build_by_id("guardiao_verde")["main"] == ["mace2h"], "Urso: malho de duas mãos")
	for sid in ["dru_spirit_wolves", "dru_treant", "dru_grove", "dru_wolf_form", "dru_prowl"]:
		check(gd.skills.has(sid), "skill nova %s" % sid)
	for sid in ["dru_wolf_form", "dru_bear_form"]:
		check(gd.skills[sid].unlock_level <= 3, "%s cedo (a build é a forma)" % sid)
	for mid in ["spirit_wolf", "treant"]:
		check(gd.monsters.has(mid) and gd.monsters[mid].xp == 0, "invocação %s" % mid)
	var m: Dictionary = sim.maps["city_aldara"]
	var dt := 1.0 / 60.0
	var at := Vector3(0, 0, 6)
	# ---- urso ----
	var bear: SimEntity = sim.spawn_bot(cls, "Bear", "city_aldara", at, 30)
	bear.brain = null
	bear.equipment[ItemDef.Slot.WEAPON] = gd.items["mace2h_t3"]
	bear.equipment.erase(ItemDef.Slot.OFFHAND)
	bear.recompute_stats()
	var def0: float = bear.stats.pdef
	var hp0: float = bear.stats.max_hp
	sim._apply_effects(bear, bear, {"form": "bear"}, 1.0)
	check(bear.form == "bear" and bear.stats.pdef > def0 * 1.3 and bear.stats.max_hp > hp0 * 1.2, "forma de urso: +DEF e +HP")
	var maul: SkillDef = sim.resolve_skill(bear, gd.skills["dru_maul"])
	check(maul.name == "Patada do Urso" and maul.radius > gd.skills["dru_maul"].radius * 1.2 and maul.id == "dru_maul", "em urso, Esmagar vira Patada do Urso (mesma recarga)")
	check(gd.skills["dru_maul"].name == "Esmagar", "a skill original não muda")
	sim._apply_effects(bear, bear, {"form": "bear"}, 1.0)
	check(bear.form == "" and sim.resolve_skill(bear, gd.skills["dru_maul"]).name == "Esmagar", "lançar de novo volta à forma humana")
	sim._apply_effects(bear, bear, {"form": "bear"}, 1.0)
	bear.equipment[ItemDef.Slot.WEAPON] = gd.items["staff_oak"]
	bear.recompute_stats()
	check(bear.form == "", "trocar para arma que a forma não aceita desfaz a forma")
	# bot transformado não desfaz a forma sozinho
	bear.equipment[ItemDef.Slot.WEAPON] = gd.items["mace2h_t3"]
	bear.recompute_stats()
	bear.skills[0] = gd.skills["dru_bear_form"]
	bear.learned["dru_bear_form"] = true
	bear.form = "bear"
	bear.recompute_stats()
	bear.mp = bear.stats.max_mp
	bear.cooldowns.clear()
	check(not sim.try_cast(bear, 0, at, m) and bear.form == "bear", "bot em forma de urso não desfaz a forma")
	# ---- lobo e furtividade ----
	var wolf: SimEntity = sim.spawn_bot(cls, "Wolf", "city_aldara", at + Vector3(4, 0, 0), 30)
	wolf.brain = null
	wolf.equipment[ItemDef.Slot.WEAPON] = gd.items["mace_t3"]
	wolf.equipment[ItemDef.Slot.OFFHAND] = gd.items["mace_t3"]
	wolf.recompute_stats()
	var as0: float = wolf.stats.attack_speed
	wolf.skills[1] = gd.skills["dru_prowl"]
	wolf.learned["dru_prowl"] = true
	wolf.mp = wolf.stats.max_mp
	check(not sim.try_cast(wolf, 1, at, m) and wolf.stealth_left == 0.0, "Espreitar só na forma de lobo")
	sim._apply_effects(wolf, wolf, {"form": "wolf"}, 1.0)
	check(wolf.form == "wolf" and wolf.stats.attack_speed >= as0 + 25.0, "forma de lobo: +velocidade de ataque")
	check(sim.resolve_skill(wolf, gd.skills["dru_claw"]).startup < gd.skills["dru_claw"].startup, "em lobo, Garras vira Mordida (mais rápida)")
	var mob: SimEntity = sim.spawn_monster(gd.monsters["wolf"], "city_aldara", wolf.position + Vector3(2, 0, 0))
	mob.aggro_target = wolf.id
	sim._apply_effects(wolf, wolf, {"stealth": 8.0}, 1.0)
	check(wolf.stealth_left > 0.0 and mob.aggro_target != wolf.id, "furtivo: o monstro perde o alvo")
	check(Combat.nearest_hostile(mob, m["entities"], 20.0) != wolf, "furtivo: monstro não acha o druida")
	sim._start_skill(wolf, gd.skills["dru_claw"], -1, mob.position)
	check(wolf.stealth_left == 0.0 and wolf.ambush, "golpe quebra a furtividade e vira emboscada")
	var hp_m: float = mob.hp
	wolf.ambush = true
	var claw: SkillDef = gd.skills["dru_claw"]
	sim._apply_skill(wolf, claw, m)
	check(not wolf.ambush and mob.hp < hp_m, "emboscada é gasta no golpe")
	sim.despawn(mob)
	# ---- Xamã: invoca ----
	var sh: SimEntity = sim.spawn_bot(cls, "Shaman", "city_aldara", at + Vector3(-4, 0, 0), 30)
	sh.brain = null
	sh.equipment[ItemDef.Slot.WEAPON] = gd.items["staff_oak"]
	sh.equipment.erase(ItemDef.Slot.OFFHAND)
	sh.recompute_stats()
	sim._apply_skill(sh, gd.skills["dru_spirit_wolves"], m)
	var pets: Array = m["entities"].filter(func(o): return o.kind == SimEntity.Kind.SUMMON and o.owner_id == sh.id)
	check(pets.size() == 2, "Lobos Espirituais invoca 2 lobos (%d)" % pets.size())
	for e in pets + [sh, wolf, bear]:
		sim.despawn(e)
	# formas: modelo do bicho com a armadura de animal de cada conjunto do Lobo/Urso
	for pair in [["wolf", "fera"], ["bear", "guardiao_verde"]]:
		var fm := FormModel.create(pair[0])
		check(fm != null and fm.anim != null and fm.anim.has_animation("attack") and fm.anim.has_animation("run"), "form_%s.glb com animações" % pair[0])
		if fm == null:
			continue
		for set_id in gd.sets:
			var fsd: SetDef = gd.sets[set_id]
			if fsd.class_id == "druid" and set_id.begins_with("set_druid_%s_" % pair[1]):
				var style: String = GearCatalog.visual_of(set_id)["style"]
				check(fm.pieces_of(style).size() >= 4, "%s: armadura de animal (%d peças)" % [style, fm.pieces_of(style).size()])
		var eq := {}
		for iid in gd.legendary_pool(cls, 30, pair[1]):
			eq[gd.items[iid].slot] = gd.items[iid]
		fm.apply_equipment(eq)
		var shown: Array = fm._pieces.filter(func(mi): return mi.visible)
		check(not shown.is_empty() and shown.all(func(mi): return String(mi.name).contains("_%s30_" % ("dru_w" if pair[0] == "wolf" else "dru_b").substr(4))), "%s: só a armadura do conjunto vestido aparece (%d)" % [pair[0], shown.size()])
		fm.free()

## Bispo: Sacerdote = maça + escudo (cura e bênçãos mais longas); Iluminado = cetro de duas mãos (luz mágica + Radiância).
func _check_bishop_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["bishop"]
	var sac: Dictionary = cls.build_by_id("sacerdote")
	var ilu: Dictionary = cls.build_by_id("inquisidor")
	check(sac["main"] == ["mace"] and sac["off"] == ["shield"], "Sacerdote: maça e escudo")
	check(ilu["main"] == ["scepter"] and ilu["off"].is_empty() and ilu["armor"] == "cloth", "Iluminado: cetro de duas mãos e túnicas")
	check("scepter" in ItemDef.TWO_HANDED and gd.items["scepter_t0"].is_two_handed(), "cetro é arma de duas mãos")
	var st := Stats.compute(cls, 10, {ItemDef.Slot.WEAPON: gd.items["scepter_t0"]}, [])
	check(st.is_magic_weapon, "cetro é arma mágica")
	check(gd.basic_skill_for_class(cls, "scepter").target == SkillDef.Target.DIRECTION, "cetro: ataque básico de luz à distância")
	for sid in ["bis_hammer", "bis_condemn", "bis_wrath"]:
		check(Array(gd.skills[sid].requires) == ["scepter"], "%s exige o cetro" % sid)
	check(gd.skills["bis_hammer"].kind == SkillDef.Kind.MAGICAL, "Martelo de Luz é dano mágico")
	var se: SetDef = gd.sets["set_bishop_sacerdote_30"]
	var si: SetDef = gd.sets["set_bishop_inquisidor_30"]
	check(float(se.bonuses[3].get("buff_pct", 0)) > 0.0 and float(si.bonuses[3].get("radiance", 0)) > 0.0, "conjuntos: bênçãos longas (Sacerdote) e Radiância (Iluminado)")
	var sac_shield := false
	for pid in se.pieces:
		sac_shield = sac_shield or gd.items[pid].weapon_type == "shield"
	check(sac_shield, "conjunto do Sacerdote tem escudo")
	# bênçãos mais longas
	var m: Dictionary = sim.maps["city_aldara"]
	var b: SimEntity = sim.spawn_bot(cls, "Buff", "city_aldara", Vector3(0, 0, 6), 30)
	b.brain = null
	var ally: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Ally", "city_aldara", Vector3(2, 0, 6), 30)
	ally.brain = null
	sim.party_invite(b, ally)
	sim.party_accept(ally)
	b.tree_bonus = {"buff_pct": 50.0}
	b.recompute_stats()
	sim._apply_effects(b, ally, {"buff": {"id": "ward", "duration": 10, "def_pct": 25}}, 1.0)
	var w: Array = ally.buffs.filter(func(x): return x.get("id") == "ward")
	check(w.size() == 1 and is_equal_approx(float(w[0]["remaining"]), 15.0), "bênção dura 50%% mais no aliado (%.1f s)" % (float(w[0]["remaining"]) if w.size() > 0 else 0.0))
	# Radiância: cura o aliado mais ferido, só com dano mágico direto
	b.tree_bonus = {"radiance": 20.0}
	b.recompute_stats()
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(0, 0, 9))
	foe.brain = null
	ally.hp = ally.stats.max_hp * 0.3
	b.hp = b.stats.max_hp * 0.9
	var a0: float = ally.hp
	var b0: float = b.hp
	sim._deal_damage(b, foe, 100, false, false, "magical")
	check(ally.hp > a0 and b.hp == b0, "Radiância cura o aliado mais ferido (+%.0f), não quem está melhor" % (ally.hp - a0))
	a0 = ally.hp
	sim._deal_damage(b, foe, 100, false, false, "physical")
	sim._deal_damage(b, foe, 100, false, false, "dot")
	check(ally.hp == a0, "Radiância só com dano mágico direto")
	ally.position = Vector3(40, 0, 6)
	sim._deal_damage(b, foe, 100, false, false, "magical")
	check(ally.hp == a0, "Radiância não alcança aliado longe")
	b.tree_bonus = {"radiance": 900.0, "buff_pct": 900.0}
	b.recompute_stats()
	check(b.stats.radiance == Balance.RADIANCE_CAP and b.stats.buff_duration == Balance.BUFF_DURATION_CAP, "Radiância e duração de bênçãos têm teto")
	for e in [foe, ally, b]:
		sim.despawn(e)

## Terceiras builds: Templário (paladino de espada/maça e escudo, fogo sagrado e Penitência) e Clérigo de Batalha
## (bispo de placa, maça e escudo, golpes que curam o aliado mais ferido).
func _check_holy_third_builds(gd, sim) -> void:
	var tem: Dictionary = gd.classes["paladin"].build_by_id("templario")
	var bat: Dictionary = gd.classes["bishop"].build_by_id("batalha")
	check(not tem.is_empty() and tem["main"] == ["sword", "mace"] and tem["off"] == ["shield"] and tem["armor"] == "plate" and tem["role"] == "dps",
		"Templário: espada ou maça, escudo e placa, para dano")
	check(not bat.is_empty() and bat["main"] == ["mace"] and bat["off"] == ["shield"] and bat["armor"] == "plate", "Clérigo de Batalha: maça, escudo e placa")
	for pair in [["paladin", "templario", "pal_t"], ["bishop", "batalha", "bis_b"]]:
		var n_sets := 0
		for lv in _own_visual_levels():
			var sid := "set_%s_%s_%d" % [pair[0], pair[1], lv]
			var vis: Dictionary = GearCatalog.SET_VISUALS.get(sid, {})
			check(gd.sets.has(sid) and vis.get("style", "") == "%s%d" % [pair[2], lv], "%s: visual próprio (%s)" % [sid, vis.get("style", "")])
			n_sets += 1 if gd.sets.has(sid) else 0
			for piece in ["head", "body", "gloves", "boots", "weapon", "offhand"]:
				check(ResourceLoader.exists("res://assets/icons/%s%d_%s.png" % [pair[2], lv, piece]), "%s: ícone %s" % [sid, piece])
			var off: ItemDef = gd.items["leg_%s_%s_%d_offhand" % [pair[0], pair[1], lv]]
			check(off.weapon_type == "shield" and GearCatalog.SHIELD_AFFINITY.get(off.shield_style, "") == pair[0], "%s: escudo próprio com afinidade da classe" % sid)
		check(n_sets == 6, "%s/%s: 6 conjuntos lendários" % [pair[0], pair[1]])
		var own: Array = gd.classes[pair[0]].skill_ids.filter(func(x): return gd.skills[x].build == pair[1])
		check(own.size() >= 6, "%s/%s: setor da teia com skills próprias (%d)" % [pair[0], pair[1], own.size()])
		var web: Dictionary = gd.trees[pair[0]]
		check(web["panes"].any(func(pn): return pn["id"] == pair[1]), "%s/%s: tem setor na teia" % [pair[0], pair[1]])
		for x in own:
			check(ResourceLoader.exists("res://assets/icons/skill_%s.png" % x), "ícone da skill %s" % x)
	var m: Dictionary = sim.maps["city_aldara"]
	# Clérigo de Batalha: Martelada da Fé cura o aliado mais ferido com parte do dano
	var cle: SimEntity = sim.spawn_bot(gd.classes["bishop"], "Cle", "city_aldara", Vector3(0, 0, 6), 30)
	cle.brain = null
	var ally: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Ally", "city_aldara", Vector3(2, 0, 6), 30)
	ally.brain = null
	sim.party_invite(cle, ally)
	sim.party_accept(ally)
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(0, 0, 7.5))
	foe.brain = null
	foe.stats.max_hp = 1.0e6
	foe.hp = 1.0e6
	ally.hp = ally.stats.max_hp * 0.3
	var a0: float = ally.hp
	cle.face_towards(foe.position)
	cle.skill_aim = foe.position
	sim._apply_skill(cle, gd.skills["bis_holy_blow"], m)
	check(foe.hp < 1.0e6 and ally.hp > a0, "Martelada da Fé fere e cura o aliado mais ferido (+%.0f)" % (ally.hp - a0))
	# arma lendária Mão que Cura: golpe direto cura o aliado mais ferido
	cle.equipment[ItemDef.Slot.WEAPON] = gd.items["leg_bishop_batalha_30_weapon"]
	cle.recompute_stats()
	check(str(cle.stats.legend.get("kind", "")) == "mend", "maça lendária do Clérigo: Mão que Cura")
	a0 = ally.hp
	LegendEffects.legend_on_hit(sim, cle, foe, gd.skills["bis_holy_blow"], 400)
	check(ally.hp > a0, "Mão que Cura: o golpe cura o aliado (+%.0f)" % (ally.hp - a0))
	ally.heal_full()
	cle.hp = cle.stats.max_hp * 0.3
	var c0: float = cle.hp
	sim.mend(cle, 1000, 0.5)
	check(absf(cle.hp - c0 - 500.0 * Balance.MEND_SELF_MULT * cle.heal_factor()) < 2.0, "cura do golpe em você mesmo rende só %.0f%% (+%.0f)" % [Balance.MEND_SELF_MULT * 100.0, cle.hp - c0])
	# Templário: Penitência acumula no alvo e explode na 5ª carga, ferindo quem está em volta
	var tem_e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Tem", "city_aldara", Vector3(0, 0, 4), 30)
	tem_e.brain = null
	tem_e.equipment[ItemDef.Slot.WEAPON] = gd.items["leg_paladin_templario_30_weapon"]
	tem_e.recompute_stats()
	var le: Dictionary = tem_e.stats.legend
	check(str(le.get("kind", "")) == "penance" and int(le.get("stacks", 0)) == 5, "espada lendária do Templário: Penitência")
	var near: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(1.2, 0, 7.5))
	near.brain = null
	near.stats.max_hp = 1.0e6
	near.hp = 1.0e6
	for i in range(4):
		LegendEffects.legend_on_hit(sim, tem_e, foe, gd.skills["pal_sacred_flame"], 100)
	var st: Array = foe.debuffs.filter(func(d): return d.get("id") == "legend_penance_%d" % tem_e.id)
	check(st.size() == 1 and int(st[0]["stacks"]) == 4 and near.hp == 1.0e6, "Penitência: 4 cargas e nada explode ainda")
	LegendEffects.legend_on_hit(sim, tem_e, foe, gd.skills["pal_sacred_flame"], 100)
	st = foe.debuffs.filter(func(d): return d.get("id") == "legend_penance_%d" % tem_e.id)
	check(st.is_empty() and near.hp < 1.0e6, "Penitência: a 5ª carga explode e fere quem está perto (%.0f)" % (1.0e6 - near.hp))
	check(gd.skills["pal_brand"].effects.has("curse") and gd.skills["pal_sacred_flame"].vfx == "fire", "Marca da Penitência amaldiçoa; Chama Sagrada é fogo (queima)")
	for x in [cle, ally, foe, tem_e, near]:
		sim.despawn(x)

## Berserker: só machados; Machados Gêmeos = velocidade de ataque + roubo de vida, Executor = vida/defesa (tanque de apoio).
func _check_berserker_builds(gd, sim) -> void:
	var cls: ClassDef = gd.classes["berserker"]
	for b in cls.builds:
		for w in b["main"] + b["off"]:
			check(w in (["claw"] if b["id"] == "punhos" else ["axe", "axe2h"]), "berserker %s usa a arma dela (%s)" % [b["id"], w])
	var twin: Dictionary = cls.build_by_id("carniceiro")
	var exe: Dictionary = cls.build_by_id("executor")
	check(twin["main"] == ["axe"] and twin["off"] == ["axe"] and exe["main"] == ["axe2h"], "Gêmeos = 2 machados, Executor = machado de 2 mãos")
	# árvore: passivos da build
	var nodes: Dictionary = gd.trees["berserker"]["nodes"]
	var kinds := {}
	for nid in nodes:
		var n: Dictionary = nodes[nid]
		if n["kind"] == "stat":
			for k in n["stats"]:
				kinds["%s:%s" % [n["branch"], k]] = true
	check(kinds.has("carniceiro:aspd_pct") and kinds.has("carniceiro:lifesteal"), "árvore dos Gêmeos dá velocidade de ataque e roubo de vida")
	check(kinds.has("executor:hp_pct") and kinds.has("executor:def_pct"), "árvore do Executor dá vida e defesa")
	# conjunto
	var sg: SetDef = gd.sets["set_berserker_carniceiro_30"]
	var se: SetDef = gd.sets["set_berserker_executor_30"]
	check(float(sg.bonuses[3].get("lifesteal", 0)) > 0.0 and sg.bonuses[5].has("aspd_pct"), "conjunto dos Gêmeos: roubo de vida (3) e velocidade de ataque (5)")
	check(float(se.bonuses[3].get("hp_pct", 0)) > 0.0 and float(se.bonuses[3].get("def_pct", 0)) > 0.0, "conjunto do Executor: vida e defesa (3)")
	# mecânica
	var m: Dictionary = sim.maps["city_aldara"]
	var e: SimEntity = sim.spawn_bot(cls, "LS", "city_aldara", Vector3(0, 0, 6), 30)
	e.brain = null
	var foe: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(0, 0, 8))
	foe.brain = null
	e.tree_bonus = {"lifesteal": 10.0, "aspd_pct": 50.0}
	e.recompute_stats()
	check(is_equal_approx(e.stats.lifesteal, 10.0) and is_equal_approx(e.stats.attack_speed, 50.0), "stats somam roubo de vida e velocidade de ataque")
	e.hp = e.stats.max_hp * 0.5
	var hp0: float = e.hp
	sim._deal_damage(e, foe, 100, false, false, "physical")
	check(is_equal_approx(e.hp - hp0, 10.0), "roubo de vida cura 10%% do dano (%.1f)" % (e.hp - hp0))
	hp0 = e.hp
	sim._deal_damage(e, foe, 100, false, false, "dot")
	check(e.hp == hp0, "dano no tempo não rouba vida")
	check(is_equal_approx(e.stats.basic_cooldown(0.9), 0.6), "50%% de velocidade de ataque: recarga do básico 0,9 -> 0,6")
	e.tree_bonus = {"lifesteal": 500.0, "aspd_pct": 500.0}
	e.recompute_stats()
	check(e.stats.lifesteal == Balance.LIFESTEAL_CAP and e.stats.attack_speed == Balance.ATTACK_SPEED_CAP, "roubo de vida e velocidade de ataque têm teto")
	sim.despawn(foe)
	# machado de duas mãos: golpe básico mais largo, mais longe e em mais alvos; um machado só continua normal
	var b2: SkillDef = gd.basic_skill_for_class(cls, "axe2h")
	var b1: SkillDef = gd.basic_skill_for_class(cls, "axe")
	check(b2.radius > b1.radius * 1.3 and b2.cone_angle_deg > b1.cone_angle_deg and b2.max_targets > b1.max_targets, "machado de duas mãos: golpe básico maior (%.1f m, %d°, %d alvos)" % [b2.radius, int(b2.cone_angle_deg), b2.max_targets])
	check(b2.radius >= 3.0 and b2.cone_angle_deg >= 150.0, "machado de duas mãos: botão esquerdo pega 3 m em 150°")
	e.equipment[ItemDef.Slot.WEAPON] = gd.items["axe_old"]
	e.equipment.erase(ItemDef.Slot.OFFHAND)
	e.recompute_stats()
	check(e.basic_skill.id.begins_with(b2.id) and is_equal_approx(e.basic_skill.radius, b2.radius) and is_equal_approx(e.basic_skill.cone_angle_deg, b2.cone_angle_deg), "berserker de machado de duas mãos usa o golpe largo (%s)" % e.basic_skill.id)
	var ring: Array = []
	for i in range(5):
		var a := deg_to_rad(-60.0 + i * 30.0)
		var mob: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", e.position + Vector3(sin(a), 0, cos(a)) * 2.7)
		mob.brain = null
		ring.append(mob)
	e.face_towards(e.position + Vector3(0, 0, 1))
	var hp_before: Array = ring.map(func(o): return o.hp)
	sim._start_skill(e, b2, -1, e.position + Vector3(0, 0, 3))
	sim._apply_skill(e, b2, m)
	var hit := 0
	for i in range(ring.size()):
		if ring[i].hp < hp_before[i]:
			hit += 1
	check(hit == Balance.BIG_SWING_MAX_TARGETS, "golpe largo acerta %d alvos a 2,7 m num arco de 120° (%d)" % [Balance.BIG_SWING_MAX_TARGETS, hit])
	# todas as armas corpo a corpo de duas mãos (Cruzado, Inquisidor), e não as de uma mão nem arco/cajado
	var pal: ClassDef = gd.classes["paladin"]
	var bis: ClassDef = gd.classes["bishop"]
	for pair in [[pal, "sword2h"], [pal, "mace2h"], [bis, "mace2h"]]:
		var big: SkillDef = gd.basic_skill_for_class(pair[0], pair[1])
		check(big.cone_angle_deg == Balance.BIG_SWING_ARC_DEG and big.max_targets == Balance.BIG_SWING_MAX_TARGETS, "%s com %s: golpe largo" % [pair[0].id, pair[1]])
	check(gd.basic_skill_for_class(pal, "sword").cone_angle_deg < Balance.BIG_SWING_ARC_DEG, "espada de uma mão: golpe normal")
	check(gd.basic_skill_for_class(bis, "staff").target == SkillDef.Target.DIRECTION, "cajado continua à distância")
	check(gd.basic_skill_for_class(gd.classes["ranger"], "bow").target == SkillDef.Target.DIRECTION, "arco continua à distância")
	for mob in ring:
		sim.despawn(mob)
	sim.despawn(e)

## Encadear skills (estilo Diablo): a segunda skill, apertada logo no começo da primeira, sai no impacto da primeira,
## sem esperar a recuperação; a primeira sempre acerta. Roda todos os pares de skills em sequência de cada classe.
func _check_skill_chain(gd, sim) -> void:
	var m: Dictionary = sim.maps["city_aldara"]
	var dt := 1.0 / 60.0
	var at := Vector3(0, 0, 6)
	var pairs := 0
	var late: Array = []
	var lost: Array = []
	var saved := 0.0
	for cid in gd.classes:
		var e: SimEntity = sim.spawn_bot(gd.classes[cid], "Chain", "city_aldara", at, 30)
		e.brain = null
		var slots: Array = []
		for i in range(e.skills.size()):
			if e.skills[i] != null:
				slots.append(i)
		for k in range(slots.size() - 1):
			var sa: int = slots[k]
			var sb: int = slots[k + 1]
			sim._end_skill(e)
			e.position = at
			e.cooldowns.clear()
			e.mp = e.stats.max_mp
			e.buffered_cmd = null
			var first := InputCommand.new()
			first.aim = at + Vector3(0, 0, 4)
			first.skill_slot = sa
			sim._apply_command(e, first, m, dt)
			var a_skill: SkillDef = e.current_skill
			if a_skill == null:
				continue
			pairs += 1
			var second := InputCommand.new()
			second.aim = first.aim
			second.skill_slot = sb
			var a_hit := -1.0
			var b_start := -1.0
			var b_hit := -1.0
			var b_skill: SkillDef = null
			var t := 0.0
			for tick in range(120):
				var c := second if tick == 0 else InputCommand.new()
				if tick > 0:
					c.aim = first.aim
				sim._apply_command(e, c, m, dt)
				if b_skill == null and e.current_skill != null and e.current_skill != a_skill:
					b_skill = e.current_skill
					b_start = t
				if a_hit < 0.0 and (e.current_skill == a_skill and e.skill_applied or b_skill != null):
					a_hit = t
				sim._update_entity(e, m, dt)
				t += dt
				if a_hit < 0.0 and e.current_skill == a_skill and e.skill_applied:
					a_hit = t
				if b_skill != null and e.current_skill == b_skill and e.skill_applied:
					b_hit = t
					break
			if b_skill == null or b_hit < 0.0 or a_hit < 0.0 or a_hit > b_start:
				lost.append("%s>%s" % [a_skill.id, e.skills[sb].id])
				continue
			if b_start > a_skill.startup + 0.1:          # absoluto: não depende da constante que está sendo testada
				late.append("%s>%s %.2fs" % [a_skill.id, b_skill.id, b_start])
			saved += (a_skill.startup + a_skill.active + a_skill.recovery) - b_start
		sim.despawn(e)
	check(pairs >= 30, "pares de skills testados no encadeamento (%d)" % pairs)
	check(lost.is_empty(), "skill apertada no começo de outra nunca se perde e a primeira sempre acerta (%d: %s)" % [lost.size(), str(lost.slice(0, 4))])
	check(late.is_empty(), "a segunda skill sai logo depois do impacto da primeira (%d atrasadas: %s)" % [late.size(), str(late.slice(0, 4))])
	check(pairs > 0 and saved / pairs > 0.26, "encadear economiza tempo de animação (%.2f s por par)" % (saved / maxf(pairs, 1)))
	# segurar o ataque durante uma skill: o básico sai depois do impacto, sem esperar a recuperação
	var h: SimEntity = sim.spawn_bot(gd.classes["berserker"], "Held", "city_aldara", at, 30)
	h.brain = null
	var slot := 0
	while h.skills[slot] == null:
		slot += 1
	var c1 := InputCommand.new()
	c1.aim = at + Vector3(0, 0, 4)
	c1.skill_slot = slot
	sim._apply_command(h, c1, m, dt)
	var sk: SkillDef = h.current_skill
	var basic_at := -1.0
	var t2 := 0.0
	for tick in range(90):
		var held := InputCommand.new()
		held.aim = c1.aim
		held.attack = true
		sim._apply_command(h, held, m, dt)
		if h.current_skill == h.basic_skill:
			basic_at = t2
			break
		sim._update_entity(h, m, dt)
		t2 += dt
	check(sk != null and basic_at >= sk.startup and basic_at < sk.startup + sk.active + sk.recovery, "ataque segurado sai no impacto da skill, antes do fim da animação (%.2f s)" % basic_at)
	# básico atrás de básico não fica mais rápido
	sim._end_skill(h)
	h.basic_cd = 0.0
	var starts := 0
	for tick in range(120):
		var held2 := InputCommand.new()
		held2.aim = c1.aim
		held2.attack = true
		var before: float = h.state_time if h.current_skill == h.basic_skill else 99.0
		sim._apply_command(h, held2, m, dt)
		if h.current_skill == h.basic_skill and h.state_time < before:
			starts += 1
		sim._update_entity(h, m, dt)
	var b0: SkillDef = h.basic_skill
	var period: float = maxf(b0.cooldown, b0.startup + b0.active + minf(b0.cancel_after, Balance.CANCEL_AFTER_MAX))
	check(starts <= int(2.0 / period) + 1, "ataque básico em sequência mantém o ritmo (%d em 2 s)" % starts)
	sim.despawn(h)
	# monstro não encadeia
	var mob: SimEntity = sim.spawn_monster(gd.monsters["bone_captain"], "city_aldara", at + Vector3(20, 0, 0))
	sim._start_skill(mob, gd.skills["mob_whirl"], 0, at)
	mob.skill_applied = true
	mob.state_time = gd.skills["mob_whirl"].startup + 0.06
	var mc := InputCommand.new()
	mc.skill_slot = 1
	check(not sim._can_chain(mob, mc), "monstro não encadeia skills")
	sim.despawn(mob)

## Toda skill de classe e toda classe têm ícone; ícones de uma classe não se repetem.
func _check_icons(gd) -> void:
	for cid in gd.classes:
		check(ResourceLoader.exists("res://assets/icons/class_%s.png" % cid), "ícone da classe %s" % cid)
	var by_class := {}
	for sid in gd.skills:
		var s: SkillDef = gd.skills[sid]
		if s.class_id == "":
			continue
		var path := "res://assets/icons/skill_%s.png" % sid
		check(ResourceLoader.exists(path), "ícone da skill %s (rode tools/icons/make_icons.tscn)" % sid)
		if not ResourceLoader.exists(path):
			continue
		var h: int = hash((load(path) as Texture2D).get_image().get_data())
		var seen: Dictionary = by_class.get_or_add(s.class_id, {})
		check(not seen.has(h), "%s tem o mesmo ícone de %s" % [sid, seen.get(h, "")])
		seen[h] = sid

## Toda classe: cabeça, peito, calça, luvas, botas, capa, amuleto e dois anéis.
func _check_equipment_slots(gd, sim, save) -> void:
	var worn := [ItemDef.Slot.HEAD, ItemDef.Slot.BODY, ItemDef.Slot.LEGS, ItemDef.Slot.GLOVES, ItemDef.Slot.BOOTS, ItemDef.Slot.CAPE]
	for tier in range(Balance.COMMON_TIER_LEVELS.size()):
		var pieces: Array = GearCatalog.wearables(tier)
		check(pieces.size() == 12, "tier %d: 3 calças, 3 capas, 3 amuletos, 3 anéis" % tier)
		for it in pieces:
			check(gd.items.has(it.id), "item %s no catálogo" % it.id)
			check(it.class_restriction.is_empty(), "%s serve para todas as classes" % it.id)
	for cid in gd.classes:
		var e = sim.spawn_character(SimEntity.Kind.BOT, gd.classes[cid], "Novo", "city_aldara", Vector3(0, 0, 6), 1)
		for slot in worn:
			check(e.equipment.get(slot) != null, "%s começa com %s" % [cid, UiKit.slot_name(slot)])
		e.level = 30
		for iid in ["legs_plate_t3", "legs_cloth_t3", "cape_sabio_t3", "amulet_guerreiro_t3", "ring_cacador_t3"]:
			check(sim.equip_error(e, gd.items[iid]) == "", "%s pode usar %s" % [cid, iid])
		for iid in ["ring_guerreiro_t0", "ring_sabio_t0", "ring_cacador_t0", "ring_cacador_t0"]:
			e.add_item(iid, 1)
		var total: int = e.stats.max_hp
		check(sim.equip(e, "ring_guerreiro_t0") and e.equipment[ItemDef.Slot.RING].id == "ring_guerreiro_t0", "%s: primeiro anel" % cid)
		check(sim.equip(e, "ring_sabio_t0") and e.equipment[ItemDef.Slot.RING2].id == "ring_sabio_t0", "%s: segundo anel vai no outro dedo" % cid)
		check(e.equipment[ItemDef.Slot.RING].id == "ring_guerreiro_t0", "%s: primeiro anel continua" % cid)
		check(sim.equip(e, "ring_cacador_t0") and e.equipment[ItemDef.Slot.RING].id == "ring_cacador_t0" and e.has_item("ring_guerreiro_t0"), "%s: terceiro troca o primeiro e devolve" % cid)
		sim.unequip(e, ItemDef.Slot.RING)
		check(sim.equip(e, "ring_cacador_t0") and e.equipment[ItemDef.Slot.RING].id == "ring_cacador_t0", "%s: anel igual nos dois não duplica slot" % cid)
		check(e.stats.max_hp >= total, "%s: anéis não tiram vida" % cid)
		sim.despawn(e)
	check(save.saved_slot(ItemDef.Slot.ACCESSORY, gd.items["ring_gel"]) == ItemDef.Slot.RING, "save antigo: acessório anel vira anel")
	check(save.saved_slot(ItemDef.Slot.ACCESSORY, gd.items["amulet_silk"]) == ItemDef.Slot.AMULET, "save antigo: acessório amuleto vira amuleto")
	check(save.saved_slot(ItemDef.Slot.RING2, gd.items["ring_gel"]) == ItemDef.Slot.RING2, "save novo mantém o segundo anel")
	var bot = sim.spawn_bot(gd.classes["elementalist"], "Joias", "city_aldara", Vector3(0, 0, 6), 25)
	check(bot.equipment.get(ItemDef.Slot.RING) != null and bot.equipment.get(ItemDef.Slot.RING2) != null, "bot alto usa dois anéis")
	check(bot.equipment.get(ItemDef.Slot.LEGS) != null and bot.equipment.get(ItemDef.Slot.CAPE) != null, "bot alto usa calça e capa")
	check(bot.equipment[ItemDef.Slot.RING].attr("INT") > 0, "bot escolhe joia do atributo da build")
	sim.despawn(bot)
	for tier in range(2):
		for it in GearCatalog.wearables(tier):
			var jewel: bool = it.slot in [ItemDef.Slot.CAPE, ItemDef.Slot.AMULET, ItemDef.Slot.RING]
			check(GearCatalog.shop_ids().has(it.id) != jewel, "%s: %s" % [it.id, "feito na forja/alquimista" if jewel else "mercador vende"])

## Marcador sobre o NPC: "!" com quest nova, "?" para entregar ou conversar, nada sem pendência.
func _check_quest_marks(gd, sim) -> void:
	var p = sim.spawn_bot(gd.classes["paladin"], "Marcas", "city_aldara", Vector3(0, 0, 6), 1)
	p.quests_active.clear()
	p.quests_completed.clear()
	check(QuestSystem.npc_marker(p, "elder") == "!", "ancião mostra ! com quest nova")
	check(QuestSystem.npc_marker(p, "captain") == QuestSystem.LOCKED, "capitã com quest ainda bloqueada mostra ! cinza")
	check(QuestSystem.npc_marker(p, "merchant") == "", "NPC sem quest nenhuma não tem marcador")
	QuestSystem.accept(p, gd.quests["q01_welcome"])
	check(QuestSystem.npc_marker(p, "elder") == QuestSystem.LOCKED, "! dourado some ao aceitar (fica o cinza das próximas)")
	check(QuestSystem.npc_marker(p, "captain") == "?", "alvo da conversa mostra ?")
	QuestSystem.on_talk(p, "captain")
	check(QuestSystem.npc_marker(p, "captain") == "?", "quem recebe mostra ? com a quest pronta")
	QuestSystem.complete(p, gd.quests["q01_welcome"], sim)
	check(QuestSystem.npc_marker(p, "elder") == QuestSystem.LOCKED, "? some ao entregar")
	check(QuestSystem.npc_marker(p, "captain") == "!", "próxima quest da cadeia mostra !")
	var q: QuestDef = gd.quests["s_wolf_den"]
	check(QuestSystem.npc_marker(p, q.giver_npc) == QuestSystem.LOCKED, "nível baixo mostra ! cinza")
	p.level = q.level_req
	check(QuestSystem.npc_marker(p, q.giver_npc) == "!", "! dourado aparece ao atingir o nível")
	p.quests_completed.append(q.id)
	check(QuestSystem.npc_marker(p, q.giver_npc) == "", "sem quests restantes não há marcador")
	sim.despawn(p)

## Cristal de retorno no Posto dos Caçadores: vincular muda o G e o renascer; dentro do Posto dá para trocar skills;
## o save guarda o vínculo e save antigo volta para a cidade.
func _check_bind_crystal(gd, sim, save) -> void:
	var fid := "field_forest"
	if not sim.maps.has(fid):
		sim.load_map(gd.maps[fid])
	var fdef: MapDef = gd.maps[fid]
	for mid in MapsCatalog.CRYSTALS:
		var cp: Array = MapsCatalog.CRYSTALS[mid]
		var crystal_at := Vector3(float(cp[0]), 0, float(cp[1]))
		var found: bool = gd.maps[mid].npcs.any(func(n): return n.get("role", "") == "crystal" and n["pos"].distance_to(crystal_at) < 0.1)
		check(found, "%s tem cristal de retorno" % mid)
		check(gd.maps[mid].in_hub(crystal_at), "cristal de %s fica dentro do povoado" % mid)
	check(fdef.hub and not fdef.is_town and gd.town_map_id() == "city_aldara", "Posto é hub sem virar a cidade inicial")
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Vinculo", fid, fdef.town_center + Vector3(-3, 0, -8), 15)
	e.brain = null
	check(sim.home_of(e)["map"] == "city_aldara", "sem cristal: retorno é a cidade")
	check(not sim.bind_crystal(e, "forest_smith"), "só cristal vincula")
	check(sim.bind_crystal(e, "crystal_field_forest"), "vincula no cristal do Posto")
	check(e.bind_map == fid and sim.is_walkable(e.bind_pos, fdef, 0.5), "ponto de retorno é chão livre na frente do cristal")
	# G leva ao cristal
	e.position = Vector3(70, 0, -16)
	var go := InputCommand.new()
	go.recall = true
	var idle := InputCommand.new()
	sim._update_recall(e, go, go, 0.1)
	for i in range(int(Balance.RECALL_TIME / 0.1) + 2):
		sim._update_recall(e, idle, idle, 0.1)
	sim._process_map_changes()
	check(e.map_id == fid and e.position.distance_to(e.bind_pos) < 0.5, "G volta para o cristal do Posto")
	sim._update_recall(e, go, go, 0.1)
	check(is_equal_approx(e.recall_left, 0.0), "já no cristal: G não começa")
	# renascer no cristal
	sim._change_map(e, "city_aldara", Vector3(60, 0, 10))
	ProgressionSystem.respawn_character(sim, e)
	sim._process_map_changes()
	check(e.map_id == fid and e.position.distance_to(e.bind_pos) < 0.5, "morrer renasce no cristal vinculado")
	# troca de skills: dentro do Posto pode, fora do muro não
	var sid: String = e.learned.keys()[0] if not e.learned.is_empty() else ""
	if sid != "":
		e.position = fdef.town_center + Vector3(3, 0, 3)
		check(sim.set_skill_slot(e, 5, sid), "troca skill dentro do Posto")
		e.position = Vector3(70, 0, -16)
		check(not sim.set_skill_slot(e, 4, sid), "fora do muro não troca skill")
	# save
	sim.despawn(e)
	var me: SimEntity = sim.player
	if me:
		var keep_map := me.bind_map
		var keep_pos := me.bind_pos
		me.bind_map = fid
		me.bind_pos = Vector3(-4, 0, -3)
		save.save_player(me)
		var d: Dictionary = save.load_data()
		me.bind_map = ""
		save.apply_to(me, d)
		check(me.bind_map == fid and me.bind_pos.distance_to(Vector3(-4, 0, -3)) < 0.01, "save guarda o cristal vinculado")
		d.erase("bind")
		save.apply_to(me, d)
		check(me.bind_map == "", "save antigo volta para a cidade")
		me.bind_map = keep_map
		me.bind_pos = keep_pos
		save.delete_slot(TEST_SLOT)

## Investida élfica como evento central: levas 3x, 18 sentinelas, invasores x1,5; mago invoca espíritos que marcham
## e seguram a leva; batedor ferido troca a espada pelo arco; lince salta longe; invasor prefere quem cura.
func _check_raid_tactics(gd, sim) -> void:
	var fd: MapDef = gd.maps["field_forest"]
	var guards: Array = fd.npcs.filter(func(n): return n.has("fighter"))
	check(guards.size() >= 18, "Posto: 18 sentinelas (%d)" % guards.size())
	var base_n := 0
	for mid in fd.raid["waves"][0]["mobs"]:
		base_n += int(fd.raid["waves"][0]["mobs"][mid])
	check(base_n >= 18 and fd.raid["waves"][0]["mobs"].has("elf_raider_mage"), "investida: leva base 3x com magos (%d)" % base_n)
	check(gd.monsters["elf_lynx"].skill_ids.has("mob_lynx_leap") and gd.skills["mob_lynx_leap"].effects["dash"] >= 7.0, "lince de guerra salta longe")
	var ws := WorldSim.new()
	ws.rng.seed = 11
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(fd)
	m["spawners"].clear()
	for o in m["entities"].duplicate():
		if o.kind == SimEntity.Kind.MONSTER:
			ws.despawn(o)
	var st := RaidSystem.state(m)
	# mago: espíritos marcham com a leva e seguram o fim da leva
	var mage: SimEntity = ws.spawn_monster(RaidSystem.scaled_def(ws, gd.monsters["elf_raider_mage"], 0), fd.id, fd.raid["from"])
	mage.raid_id = 0
	st["ids"] = [mage.id]
	MobSystem.spawn_adds(ws, mage, gd.skills["mob_raise_wisps"].effects["boss_summon"])
	var wisps: Array = m["entities"].filter(func(o): return o.boss_id == mage.id)
	check(wisps.size() == 2 and wisps.all(func(w): return w.raid_id == 0 and (st["ids"] as Array).has(w.id)), "espíritos do mago marcham e contam na leva")
	check(gd.monsters["elf_wisp"].xp == 0, "espírito não dá XP")
	# batedor ferido: guarda a espada e atira
	var raider: SimEntity = ws.spawn_monster(RaidSystem.scaled_def(ws, gd.monsters["elf_raider"], 0), fd.id, fd.raid["from"])
	raider.raid_id = 0
	var archer: MonsterDef = gd.monsters["elf_raider_archer"]
	raider.hp = raider.stats.max_hp * 0.3
	raider.brain.think(raider, ws, m, 0.05)
	check(raider.stance == "bow" and raider.basic_skill == GameData.basic_skill_for_monster(archer) and MonsterBrain._style_def(raider).ranged,
		"batedor com pouca vida troca a espada pelo arco")
	# foco: entre dois alvos iguais, o bispo vem primeiro
	var tank: SimEntity = ws.spawn_bot(gd.classes["paladin"], "Tanque", fd.id, raider.position + Vector3(3, 0, 0), 16)
	var healer: SimEntity = ws.spawn_bot(gd.classes["bishop"], "Cura", fd.id, raider.position + Vector3(-3.5, 0, 0), 16)
	tank.brain = null
	healer.brain = null
	var fresh: SimEntity = ws.spawn_monster(RaidSystem.scaled_def(ws, gd.monsters["elf_raider"], 0), fd.id, raider.position + Vector3(0, 0, 1))
	fresh.raid_id = 0
	m["chars"] = [tank, healer]
	fresh.brain.think(fresh, ws, m, 0.05)
	check(fresh.aggro_target == healer.id, "invasor mira em quem cura")
	# Segurar o Portão: qualquer elfo, em qualquer lugar, conta
	var hq: QuestDef = gd.quests["el2_defense"]
	healer.quests_active[hq.id] = 0
	QuestSystem.on_kill(healer, "elf_warrior")
	QuestSystem.on_kill(healer, "elf_raider_mage")
	QuestSystem.on_kill(healer, "elf_lynx")
	check(int(healer.quests_active[hq.id]) == 2, "Segurar o Portão: guerreiro e mago contam, lince não (%d)" % int(healer.quests_active[hq.id]))

## Efeito-assinatura: toda build lança a magia dela ao acertar (sem depender da arma), com recarga; o que a assinatura
## acerta não dispara outra; arma lendária com a mesma magia soma chance; o básico da build tem a aparência do tema.
func _check_signature(gd, sim) -> void:
	for cid in gd.classes:
		for b in gd.classes[cid].builds:
			var sig: Dictionary = b.get("signature", {})
			var sk: SkillDef = gd.skills.get(str(sig.get("skill", "")))
			check(sk != null and sk.class_id == cid and sk.power > 0.0, "%s/%s: assinatura existe e é da classe (%s)" % [cid, b["id"], sig.get("skill", "")])
			if sk:
				for bad in ["dash", "summon", "form", "buff", "boss_summon", "trap"]:
					check(not sk.effects.has(bad), "%s: assinatura %s sem %s (não move nem muda o personagem)" % [b["id"], sk.id, bad])
	var m: Dictionary = sim.maps["city_aldara"]
	var el: SimEntity = sim.spawn_bot(gd.classes["elementalist"], "Sig", "city_aldara", Vector3(-60, 0, -40), 12)
	el.brain = null
	el.build_id = "fogo"
	el.equipment[ItemDef.Slot.WEAPON] = gd.items["staff_silk"] if gd.items.has("staff_silk") else el.equipment.get(ItemDef.Slot.WEAPON)
	el.recompute_stats()
	check(el.stats.legend.is_empty(), "sem arma lendária")
	check(el.basic_skill.look == "fire" and el.basic_skill.vfx == "", "básico do Fogo: aparência de fogo, sem mudar regra (vfx vazio)")
	check(LegendEffects.signature_skill(el) == "ele_fireball", "assinatura do Fogo é a Bola de Fogo")
	var dummy: SimEntity = sim.spawn_monster(gd.monsters["golem"], "city_aldara", Vector3(-58, 0, -40))
	dummy.brain = null
	var fired := 0
	for i in range(200):
		el.sig_ready_at = 0.0
		var before: int = m["projectiles"].size()
		LegendEffects.signature_on_hit(sim, el, dummy, el.basic_skill, 50)
		if m["projectiles"].size() > before:
			fired += 1
	check(fired > 5 and fired < 60, "básico dispara a Bola de Fogo às vezes, sem arma lendária (%d/200)" % fired)
	var before2: int = m["projectiles"].size()
	el.sig_ready_at = sim.time + 10.0
	for i in range(50):
		LegendEffects.signature_on_hit(sim, el, dummy, el.basic_skill, 50)
	check(m["projectiles"].size() == before2, "recarga segura a assinatura")
	el.sig_ready_at = 0.0
	for i in range(50):
		LegendEffects.signature_on_hit(sim, el, dummy, gd.skills["ele_fireball"], 50)
	check(m["projectiles"].size() == before2, "a própria Bola de Fogo não dispara a assinatura")
	sim.signature_casting = true
	for i in range(50):
		LegendEffects.signature_on_hit(sim, el, dummy, el.basic_skill, 50)
	sim.signature_casting = false
	check(m["projectiles"].size() == before2, "o que a assinatura acerta não dispara outra")
	el.stats.legend = {"kind": "cast_on_basic", "skill": "ele_fireball", "chance": 100.0}
	el.sig_ready_at = 0.0
	LegendEffects.signature_on_hit(sim, el, dummy, el.basic_skill, 50)
	check(m["projectiles"].size() == before2 + 1, "Brasa Viva soma chance na assinatura (100%% dispara)")
	var before3: int = m["projectiles"].size()
	LegendEffects.legend_on_hit(sim, el, dummy, el.basic_skill, 50)
	check(m["projectiles"].size() == before3, "Brasa Viva não lança uma segunda Bola de Fogo à parte")
	m["projectiles"].clear()
	sim.despawn(dummy)
	sim.despawn(el)

## Cidade Élfica grande e habitada: muro largo, cidadãos neutros com modelo élfico, esquadrões em ronda, 3 fortes com
## capitães (chefes com escolta) entre o muro e a borda.
## Linha dos fora-da-lei (Floresta): cada tipo com modelo próprio (GLB existe), golpe próprio e papel; o Fora-da-Lei lidera
## trombadinhas e faz ronda; todos aparecem na Floresta; as quests de "bandido" contam a linha inteira.
func _check_outlaws(gd, sim) -> void:
	var line := ["bandit_footpad", "bandit_thief", "bandit_archer", "bandit", "bandit_outlaw", "bandit_thug", "bandit_chief"]
	var models := {}
	for id in line:
		check(gd.monsters.has(id), "fora-da-lei %s existe" % id)
		if not gd.monsters.has(id):
			continue
		var md: MonsterDef = gd.monsters[id]
		check(FileAccess.file_exists("res://assets/models/%s.glb" % md.model), "%s: modelo %s exportado" % [id, md.model])
		models[md.model] = true
		for sid in md.skill_ids:
			check(gd.skills.has(sid), "%s: skill %s existe" % [id, sid])
	check(models.size() == line.size(), "cada fora-da-lei tem modelo próprio (%d de %d)" % [models.size(), line.size()])
	var fp: MonsterDef = gd.monsters["bandit_footpad"]
	var th: MonsterDef = gd.monsters["bandit_thief"]
	var po: MonsterDef = gd.monsters["bandit_archer"]
	var br: MonsterDef = gd.monsters["bandit"]
	var ol: MonsterDef = gd.monsters["bandit_outlaw"]
	check(fp.move_speed > br.move_speed and fp.level < br.level, "Trombadinha: rápido e de nível baixo")
	check(th.atk > fp.atk and th.hp < fp.hp, "Gatuno: bate forte e é frágil")
	check(po.ranged and po.skill_ids.has("mob_snare_shot"), "Clandestino: arco e laço")
	check(br.hp > po.hp and br.skill_ids.has("mob_club_slam"), "Bandido: robusto, porretada")
	check(ol.escort.get("id", "") == "bandit_footpad" and int(ol.escort.get("count", 0)) >= 2, "Fora-da-Lei lidera trombadinhas")
	check(gd.monsters["bandit_thug"].xp == 0, "Capanga continua lacaio sem XP")
	var seen := {}
	var routed := 0
	for sp in gd.maps["field_forest"].spawners:
		seen[sp["monster_id"]] = true
		if sp["monster_id"] == "bandit_outlaw" and sp.get("route", []).size() >= 2:
			routed += 1
			for pt in sp["route"]:
				var p3 := Vector3(float(pt[0]), 0, float(pt[1]))
				check(sim.is_walkable(p3, gd.maps["field_forest"], 0.5), "ronda do Fora-da-Lei passa por chão livre (%s)" % str(pt))
	for id in ["bandit_footpad", "bandit_thief", "bandit_archer", "bandit", "bandit_outlaw", "bandit_chief"]:
		check(seen.has(id), "Floresta tem %s" % id)
	check(routed >= 2, "Floresta: %d rondas de Fora-da-Lei" % routed)
	for qid in ["q10_bandits", "b1_trilhas", "b6_limpeza", "b_bandits"]:
		var q: QuestDef = gd.quests[qid]
		check(q.also_counts.has("bandit_footpad") and q.also_counts.has("bandit_outlaw"), "%s conta a linha inteira de bandidos" % qid)

## Mundo que muda com a conquista (WorldState): spawner e NPC com if/unless por quest do jogador, investida de
## vários lados (uma rota cala sozinha), leva aliada que marcha até o pátio e briga, renascimento por NPC.
## Terceiro andar: guarnição da Aurora (NPC lutador, sem XP, modelo próprio) e mortos-vivos das fortalezas
## (modelo próprio, golpe do tema); chefes completos com moedas; escudo de frente; a Luz da Aurora cura aliados.
## Terceiro andar de ponta a ponta: o Bastião tem três fronts de investida, cada um calado pela quest da fortaleza dele;
## portões de fortaleza em cadeia; na Fortaleza dos Ossos, antes de tudo só mortos e prisioneiros, com o Covil retomado a
## leva da Aurora sobe a estrada, com Vorhag morto os mortos somem e o assentamento e a guarnição aparecem.
## Bastião: fortaleza retomada enfurece os fronts que sobram (x1,5 por retomada + elites, teto RAID_WAVE_CAP);
## a fortaleza retomada manda reforço à praça; leva na muralha solta a surtida de 20 da catedral (recarga, volta e some).
## Bastião: besteiros no alto das torres atiram nos invasores (pouco dano) e não são alvo nem tomam dano nem puxam aggro;
## serviços completos (relicário, depósito, reset na Alta Sacerdotisa); chefe de fortaleza volta enquanto a quest não sai.
## Front que se limpa: cada fortaleza retomada esconde o chão pútrido/cinza/gelado do lado dela no Bastião e mostra o
## acampamento limpo da Aurora; o acampamento pútrido some (spawner calado, tendas sem colisão). O GLB tem as peças.
func _check_dawn_clean_fronts(gd) -> void:
	var def: MapDef = gd.maps["field_ruins"]
	var names: Array = []
	var fa := FileAccess.open("res://assets/models/%s.glb" % def.model, FileAccess.READ)
	if fa:
		fa.seek(12)
		var n := fa.get_32()
		fa.seek(20)
		var js: Dictionary = JSON.parse_string(fa.get_buffer(n).get_string_from_utf8())
		names = js.get("nodes", []).map(func(nd): return str(nd.get("name", "")))
	for side in ["ghoul", "bones", "frost"]:
		var q := "dw_%s_boss" % side
		var dirty := def.conquest_vis.filter(func(c): return c.get("unless", "") == q)
		var clean := def.conquest_vis.filter(func(c): return c.get("if", "") == q)
		check(not dirty.is_empty() and not clean.is_empty(), "Bastião: front %s some e limpa com %s" % [side, q])
		for c in dirty + clean:
			check(names.any(func(nm): return nm.contains(str(c["tag"]))), "Bastião: peça '%s' existe no GLB" % c["tag"])
		var props := def.obstacles.filter(func(o): return o.get("if", "") == q)
		check(props.size() >= 15 and props.all(func(o): return not o.get("solid", true)), "Bastião: acampamento limpo do %s (%d peças, sem colisão)" % [side, props.size()])
	var camp := def.spawners.filter(func(sp): return sp["monster_id"] == "rot_ghoul" and sp.get("unless", "") == "dw_ghoul_boss")
	check(not camp.is_empty(), "Bastião: o acampamento pútrido se cala com o Covil retomado")
	check(def.obstacles.filter(func(o): return o.get("unless", "") == "dw_ghoul_boss").all(func(o): return not o.get("solid", true)), "Bastião: tendas pútridas sem colisão (somem sem deixar parede invisível)")
	# visual: a raiz do mapa troca as peças na hora da conquista
	var ws := WorldSim.new()
	var old_player = Sim.player
	var root := MapBuilder.build(def)
	var tagged: Array = root.get_meta("conquest", [])
	check(tagged.size() >= 60, "Bastião: o mapa liga peças da conquista (%d)" % tagged.size())
	var visible_clean := func() -> int:
		return tagged.filter(func(t): return str(t[1].get("if", "")) == "dw_ghoul_boss" and (t[0] as Node3D).visible).size()
	check(visible_clean.call() == 0, "Bastião: antes do Covil, o front limpo não aparece")
	var fake := SimEntity.new()
	fake.quests_completed.append("dw_ghoul_boss")
	Sim.player = fake
	MapBuilder.apply_conquest(root)
	check(visible_clean.call() > 0 and tagged.filter(func(t): return str(t[1].get("unless", "")) == "dw_ghoul_boss" and (t[0] as Node3D).visible).is_empty(),
		"Bastião: Covil retomado, o oeste fica limpo e o pútrido some")
	Sim.player = old_player
	root.free()

func _check_dawn_towers(gd) -> void:
	var def: MapDef = gd.maps["field_ruins"]
	var perched := def.npcs.filter(func(n): return float(n.get("perch", 0.0)) > 0.0)
	check(perched.size() >= 8, "Bastião: besteiros nas torres (%d)" % perched.size())
	var roles := def.npcs.map(func(n): return str(n.get("role", "")))
	check(roles.has("relic") and roles.has("storage") and roles.has("smith") and roles.has("merchant") and roles.has("alchemy") and roles.has("crystal"), "Bastião: relicário, depósito, ferreiro, mercador, alquimista e cristal")
	check(Balance.SKILL_RESET_NPCS.has("high_priest"), "Bastião: a Alta Sacerdotisa reseta skills")
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var m: Dictionary = ws.load_map(def)
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		if e.kind == SimEntity.Kind.MONSTER:
			ws.despawn(e)
	var archer: SimEntity = m["entities"].filter(func(e): return e.is_perched())[0]
	ws.player = ws.spawn_player(gd.classes["paladin"], "Teste", def.id)
	ws.player.position = archer.position * 0.8           # perto, por dentro da muralha (mapa acordado)
	ws.player.brain = null
	var mob: SimEntity = ws.spawn_monster(gd.monsters["skeleton"], def.id, archer.position * 1.16)
	mob.brain = null
	var hp0 := mob.hp
	for i in int(6.0 * 20):
		ws.tick(0.05)
	check(mob.hp < hp0 and hp0 - mob.hp < mob.stats.max_hp * 0.5, "besteiro da torre acerta o invasor com pouco dano (%d)" % int(hp0 - mob.hp))
	check(archer.position.distance_to(archer.home_position) < 0.5, "besteiro da torre não sai do lugar")
	check(not mob.is_hostile_to(archer) and mob.aggro_target != archer.id, "monstro não mira nem persegue o besteiro da torre")
	var ahp := archer.hp
	ws._deal_damage(mob, archer, 9999, false, false, "physical")
	check(archer.is_alive() and archer.hp == ahp, "besteiro da torre não toma dano")
	# chefe do Covil: morto antes da retomada, volta; depois da quest, não
	var fd: MapDef = gd.maps["fort_ghoul"]
	var bsp: Dictionary = fd.spawners.filter(func(sp): return sp["monster_id"] == "ghoul_giant")[0]
	check(bsp.get("unless", "") == "dw_ghoul_boss" and float(bsp["respawn"]) <= 120.0, "Carniçal Gigante volta em até 2 min enquanto o Covil não é retomado")
	var w2 := WorldSim.new()
	w2.load_map(gd.maps[GameData.town_map_id()])
	var fm: Dictionary = w2.load_map(fd)
	w2.player = w2.spawn_player(gd.classes["paladin"], "Teste", fd.id)
	var boss := func() -> Array:
		return fm["entities"].filter(func(e): return e.kind == SimEntity.Kind.MONSTER and e.monster_def.id == "ghoul_giant" and e.is_alive())
	for i in 40:
		w2.tick(0.05)
	check(boss.call().size() == 1, "Covil: o Carniçal Gigante está no pátio")
	var b: SimEntity = boss.call()[0]
	w2._deal_damage(w2.player, b, int(b.hp + 99999), false, false, "physical")
	for i in int((float(bsp["respawn"]) + 5.0) * 20):
		w2.tick(0.05)
	check(boss.call().size() == 1, "Covil: morto sem a quest, o Carniçal Gigante renasce")
	w2.player.quests_completed.append("dw_ghoul_boss")
	for e in boss.call():
		e.aggro_target = -1
	for i in 40:
		w2.tick(0.05)
	check(boss.call().is_empty(), "Covil: retomado, o chefe não volta")

func _check_dawn_relief(gd) -> void:
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var def: MapDef = gd.maps["field_ruins"]
	var m: Dictionary = ws.load_map(def)
	m["spawners"].clear()
	for e in m["entities"].duplicate():
		if e.kind == SimEntity.Kind.MONSTER:
			ws.despawn(e)
	var bones := -1
	for i in RaidSystem.routes(def).size():
		if RaidSystem.route_def(def, i).get("side", "") == "bones":
			bones = i
	var sizes: Array = []
	for k in [0, 1, 2]:
		RaidSystem.state(m)["force_reclaimed"] = k
		RaidSystem.state(m, bones)["n"] = 1
		var ids := RaidSystem.start_raid(ws, m, bones)
		sizes.append(ids.size())
		for id in ids:
			ws.despawn(ws.entities.get(id))
		RaidSystem.state(m, bones)["ids"] = []
	check(sizes[0] == 25 and sizes[1] >= 38 and sizes[1] <= 41 and sizes[2] > Balance.RAID_WAVE_CAP + 6 and sizes[2] <= Balance.RAID_WAVE_CAP_LAST + 7,
		"fúria: leva dos Ossos 25 -> ~38 -> último front (as outras duas retomadas) passa do teto comum, com elites e líder %s" % str(sizes))
	RaidSystem.state(m)["force_reclaimed"] = 5
	var big := RaidSystem.start_raid(ws, m, bones)
	check(big.size() <= Balance.RAID_WAVE_CAP_LAST + 7, "fúria: teto da leva do último front (%d)" % big.size())
	check(big.any(func(id): return ws.entities.has(id) and ws.entities[id].monster_def.elite_of == str(RaidSystem.route_def(def, bones).get("leader", ""))),
		"fúria: o último front vem com o líder elite")
	for id in big:
		ws.despawn(ws.entities.get(id))
	RaidSystem.state(m, bones)["ids"] = []
	RaidSystem.state(m).erase("force_reclaimed")
	# reforço: só a fortaleza retomada manda gente, e ela desce até a praça
	ws.player = ws.spawn_player(gd.classes["paladin"], "Aurora", def.id)
	for i in RaidSystem.routes(def).size():
		RaidSystem.state(m, i)["timer"] = 9999.0
	var relief := func() -> Array:
		return m["entities"].filter(func(e): return e.guard and str(e.npc_data.get("id", "")).begins_with("assault_"))
	for i in int(30.0 * 20):
		ws.tick(0.05)
	check(relief.call().is_empty(), "reforço: sem fortaleza retomada, ninguém vem")
	ws.player.quests_completed.append("dw_ghoul_boss")
	var reached := false
	for i in int(150.0 * 20):
		ws.tick(0.05)
		if relief.call().any(func(e): return Vector2(e.position.x, e.position.z).length() < 26.0):
			reached = true
			break
	check(relief.call().size() >= 1 and relief.call().size() <= Balance.REINFORCE_MAX, "reforço do Covil desceu pela garganta oeste, até %d (%d)" % [Balance.REINFORCE_MAX, relief.call().size()])
	check(reached, "reforço chega à praça do Bastião")
	# surtida: leva na muralha solta 20 da catedral, recarga segura a segunda, fim da leva -> voltam e somem
	var sortie := func() -> Array:
		return m["entities"].filter(func(e): return e.guard and e.npc_data.get("sortie", false))
	var frost := -1
	for i in RaidSystem.routes(def).size():
		if RaidSystem.route_def(def, i).get("side", "") == "frost":
			frost = i
	var st := RaidSystem.state(m, frost)
	var wave := RaidSystem.start_raid(ws, m, frost)
	for id in wave:                                   # leva já na muralha
		ws.entities[id].position = RaidSystem.route_def(def, frost)["target"] + Vector3(0, 0, 40)
	ws.tick(0.05)
	var so: Array = sortie.call()
	check(so.size() == 20, "surtida: 20 soldados saem da catedral (%d)" % so.size())
	check(so.all(func(e): return (e.npc_data["march"][1] as Vector3).distance_to(RaidSystem.gate_point(def, frost)) < 0.5), "surtida vai ao portão atacado")
	check(float(m.get("sortie_cd", 0.0)) > 170.0, "surtida: recarga de 3 min")
	st["arrived"] = false
	ws.tick(0.05)
	check(sortie.call().size() == 20, "surtida: a segunda chegada dentro da recarga não solta outra")
	for id in wave:
		ws.despawn(ws.entities.get(id))
	for i in int((Balance.RAID_SORTIE_LINGER + 5.0) * 20):
		ws.tick(0.05)
	check(sortie.call().is_empty(), "surtida: leva acabou, os soldados voltam e somem")

func _check_dawn_conquest(gd) -> void:
	var bd: MapDef = gd.maps["field_ruins"]
	var routes := RaidSystem.routes(bd)
	check(routes.size() == 3, "Bastião: investida pelos três lados (%d)" % routes.size())
	var sides := routes.map(func(r): return [str(r.get("side", "")), str(r.get("unless", ""))])
	check(sides.has(["ghoul", "dw_ghoul_boss"]) and sides.has(["bones", "dw_bones_boss"]) and sides.has(["frost", "dw_frost_boss"]), "Bastião: cada front cala com a fortaleza dele %s" % str(sides))
	var garrison := bd.npcs.filter(func(n): return n.has("fighter"))
	check(garrison.size() >= 24 and garrison.all(func(n): return float(n.get("respawn", 99.0)) <= 15.0 and str(n.get("model", "")).begins_with("mob_loyal_")),
		"Bastião: guarnição da Aurora (%d) renasce em até 15 s" % garrison.size())
	var targets := {}
	for pt in bd.portals:
		targets[pt["target_map"]] = pt["id"]
	for fid in ["fort_ghoul", "fort_bones", "fort_frost", "lich_citadel"]:
		check(targets.has(fid) and MapsCatalog.PORTAL_GATES.has(targets.get(fid, "")), "Bastião: portal com portão para %s" % fid)
	check(MapsCatalog.PORTAL_GATES["to_fort_bones"]["quest"] == "dw_ghoul_boss" and MapsCatalog.PORTAL_GATES["to_lich_citadel"]["quest"] == "dw_frost_boss", "fortalezas abrem em cadeia")
	# Fortaleza dos Ossos com o mundo de um personagem
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var fd: MapDef = gd.maps["fort_bones"]
	var m: Dictionary = ws.load_map(fd)
	ws.player = ws.spawn_player(gd.classes["paladin"], "Aurora", fd.id)
	var npc_ids := func(prefix: String) -> Array:
		return m["entities"].filter(func(e): return e.kind == SimEntity.Kind.NPC and str(e.npc_data.get("id", "")).begins_with(prefix))
	var undead := func() -> int:
		return m["entities"].filter(func(e): return e.kind == SimEntity.Kind.MONSTER and e.is_alive()).size()
	for i in 60:
		ws.tick(0.05)
	check(undead.call() > 10 and npc_ids.call("fort_bones_prisoner_").size() == 3 and npc_ids.call("fort_bones_settler_").is_empty(), "Ossos: antes, mortos (%d) e prisioneiros" % undead.call())
	check(npc_ids.call("assault_").is_empty(), "Ossos: sem o Covil retomado, a Aurora não sobe")
	ws.player.quests_completed.append("dw_ghoul_boss")
	for i in int(10.0 * 20):
		ws.tick(0.05)
	var col: Array = npc_ids.call("assault_")
	check(col.size() >= 4 and col.all(func(e): return e.guard), "Ossos: com o Covil retomado, a leva da Aurora sobe a estrada (%d)" % col.size())
	ws.player.quests_completed.append("dw_bones_posts")     # a cadeia pede os postos antes do chefe
	ws.player.quests_completed.append("dw_bones_boss")
	for e in m["entities"].duplicate():
		if e.kind == SimEntity.Kind.MONSTER:
			e.aggro_target = -1
	for i in 60:
		ws.tick(0.05)
	check(undead.call() <= 2, "Ossos: retomada, os mortos somem (%d)" % undead.call())
	check(npc_ids.call("fort_bones_settler_").size() == 3 and npc_ids.call("fort_bones_prisoner_").is_empty(), "Ossos: assentamento no lugar dos prisioneiros")
	check(npc_ids.call("fort_bones_g_").size() >= 4, "Ossos: guarnição da Aurora no pátio")
	check(npc_ids.call("fort_bones_post_").size() == 4, "Ossos: postos retomados com guarda da Aurora")
	check(not WorldState.active(ws, fd.assaults[0]), "Ossos: a leva para de subir depois da retomada")

func _check_dawn_factions(gd) -> void:
	for gid in ["guard_spearman", "guard_knight", "guard_paladin", "guard_priest", "guard_crossbow"]:
		var g: MonsterDef = gd.monsters[gid]
		check(g.xp == 0 and g.model.begins_with("mob_loyal_") and FileAccess.file_exists("res://assets/models/%s.glb" % g.model), "Aurora: %s é guarnição com modelo próprio" % gid)
	var undead := ["larva", "rot_zombie", "rot_ghoul", "rot_wolf", "rot_bear", "skeleton", "skel_archer", "skel_guard", "cultist", "tower_bat", "ghost",
		"citadel_knight", "citadel_adept", "citadel_horror"]
	for id in undead:
		var md: MonsterDef = gd.monsters[id]
		check(md.xp > 0 and md.loot_table != "" and FileAccess.file_exists("res://assets/models/%s.glb" % md.model), "morto-vivo %s: XP, saque e modelo" % id)
		for sid in md.skill_ids:
			check(gd.skills.has(sid), "%s: skill %s existe" % [id, sid])
	for bid in ["ghoul_giant", "death_knight", "frost_mage", "lich_king"]:
		var b: MonsterDef = gd.monsters[bid]
		var kit := {}
		for sid in b.skill_ids:
			kit[sid] = true
		for ph in b.phases:
			for sid in ph.get("skills", []):
				kit[sid] = true
			if ph.has("summon"):
				check(gd.monsters[ph["summon"]["id"]].xp == 0, "%s: lacaio da fase sem XP" % bid)
		check(b.is_boss and kit.size() >= 4 and b.phases.size() >= 2 and b.intro != "" and b.last_words != "", "%s: chefe com repertório e falas" % bid)
		check(b.coin_min >= 2 and b.coin_chance >= 1.0, "%s: solta moedas lendárias" % bid)
	check(gd.monsters["lich_king"].level == 30 and gd.monsters["lich_king"].coin_min >= 5, "Lich-Rei: nível 30, 5+ moedas")
	var themes := [gd.skills["mob_rot_bile"].vfx, gd.skills["mob_blizzard"].vfx, gd.skills["mob_holy_light"].vfx, gd.skills["mob_bone_cleave"].vfx]
	check(themes == ["poison", "ice", "heal", "bone"], "skills do andar no tema %s" % str(themes))
	# escudo de frente: o golpe de frente perde 60%, por trás passa inteiro
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	var mid: String = GameData.town_map_id()
	var sg: SimEntity = ws.spawn_monster(gd.monsters["skel_guard"], mid, Vector3(0, 0, 30))
	sg.brain = null
	sg.facing = 0.0
	var hitter: SimEntity = ws.spawn_bot(gd.classes["berserker"], "Teste", mid, sg.position + sg.forward() * 2.0, 25)
	hitter.brain = null
	var hp0 := sg.hp
	ws._deal_damage(hitter, sg, 500, false, false, "physical")
	var front_loss := hp0 - sg.hp
	sg.hp = hp0
	hitter.position = sg.position - sg.forward() * 2.0
	ws._deal_damage(hitter, sg, 500, false, false, "physical")
	var back_loss := hp0 - sg.hp
	check(front_loss <= 210 and back_loss >= 490, "Guardião de Ossos: de frente %d, pelas costas %d" % [front_loss, back_loss])
	sg.hp = hp0
	hitter.position = sg.position + sg.forward() * 2.0
	ws._deal_damage(hitter, sg, 500, false, false, "magical")
	check(hp0 - sg.hp >= 490, "Guardião de Ossos: magia passa o escudo")
	# Luz da Aurora: cura o aliado ferido em volta da sacerdotisa
	var pr: SimEntity = ws._spawn_npc({"id": "t_priest", "name": "Sacerdotisa", "pos": Vector3(4, 0, 30), "role": "guard", "fighter": "guard_priest", "color": Color.WHITE, "dialog": []}, mid)
	hitter.position = pr.position + Vector3(2, 0, 0)
	hitter.hp = hitter.stats.max_hp * 0.4
	var before := hitter.hp
	var hl: SkillDef = gd.skills["mob_holy_light"]
	var targets := Combat.select_targets(pr, hl, pr.position, ws.maps[mid]["entities"])
	check(targets.has(hitter) and not targets.has(sg), "Luz da Aurora: pega o aventureiro, não o morto-vivo")
	for t in targets:
		ws._heal(pr, t, Combat.calc_heal(pr, hl.power, ws.rng))
	check(hitter.hp > before, "Luz da Aurora cura o aliado")

func _check_world_state(gd) -> void:
	var fd: MapDef = gd.maps["field_forest"]
	var def: MapDef = fd.duplicate()
	def.id = "ws_test"
	def.raid = {}
	def.raids = []
	def.assaults = []
	var from: Vector3 = fd.raid["from"]
	var route: Array = fd.raid["route"]
	var target: Vector3 = fd.raid["target"]
	var mid_pt: Vector3 = route[route.size() / 2]
	def.spawners = [{"monster_id": "wolf", "pos": mid_pt, "radius": 3.0, "count": 2, "respawn": 5.0, "unless": "ws_q"}]
	def.npcs = [{"id": "ws_npc", "name": "Colono", "pos": mid_pt + Vector3(4, 0, 0), "role": "villager", "color": Color.WHITE, "dialog": ["oi"], "if": "ws_q"},
		{"id": "ws_guard", "name": "Guarda", "pos": target, "role": "guard", "color": Color.WHITE, "dialog": [], "fighter": "guard_warrior", "respawn": 12.0}]
	var ws := WorldSim.new()
	ws.load_map(gd.maps[GameData.town_map_id()])
	GameData.maps[def.id] = def
	var m: Dictionary = ws.load_map(def)
	ws.player = ws.spawn_player(gd.classes["paladin"], "Mundo", def.id)
	ws.player.position = target + Vector3(0, 0, 6)
	check(WorldState.active(ws, {"unless": "ws_q"}) and not WorldState.active(ws, {"if": "ws_q"}), "conquista: if/unless antes da quest")
	for i in 60:
		ws.tick(0.05)
	var wolves := func(): return m["entities"].filter(func(e): return e.kind == SimEntity.Kind.MONSTER and e.monster_def.id == "wolf")
	var npc_here := func(): return m["entities"].any(func(e): return e.kind == SimEntity.Kind.NPC and e.npc_data.get("id", "") == "ws_npc")
	check(wolves.call().size() == 2 and not npc_here.call(), "conquista: antes da quest há monstros e o colono não está")
	ws.player.quests_completed.append("ws_q")
	for i in 60:
		ws.tick(0.05)
	check(wolves.call().is_empty() and npc_here.call(), "conquista: quest feita recolhe os monstros e traz o colono")
	# renascimento por NPC (guarnição de 10-15 s)
	var g: SimEntity = m["entities"].filter(func(e): return e.guard and e.npc_data.get("id", "") == "ws_guard")[0]
	ws._deal_damage(ws.player, g, int(g.hp + 99999), false, false, "physical")
	for i in int(11.0 * 20.0):
		ws.tick(0.05)
	check(not g.is_alive(), "guarnição: ainda caída antes do tempo dela")
	for i in int(2.0 * 20.0):
		ws.tick(0.05)
	check(g.is_alive(), "guarnição: renasce em 12 s (respawn do NPC)")
	# investida de dois lados; o lado B cala quando a quest dele está feita
	var wave := {"first": 0.5, "every": 999.0, "lifetime": 400.0, "radius": 17.0, "waves": [{"mobs": {"wolf": 1}}]}
	var ra: Dictionary = wave.duplicate(true)
	ra.merge({"side": "a", "from": from, "route": route, "target": target})
	var rb: Dictionary = wave.duplicate(true)
	rb.merge({"side": "b", "from": mid_pt, "route": [], "target": target, "unless": "ws_side_b"})
	def.raid = ra
	def.raids = [rb]
	ws.player.position = target
	for i in 30:
		ws.tick(0.05)
	var a_ids: Array = RaidSystem.state(m, 0)["ids"]
	var b_ids: Array = RaidSystem.state(m, 1)["ids"]
	check(a_ids.size() == 1 and b_ids.size() == 1, "investida: dois lados, uma leva cada (%d/%d)" % [a_ids.size(), b_ids.size()])
	if b_ids.size() == 1:
		check(ws.entities[b_ids[0]].raid_route == 1 and RaidSystem.march_point(ws, ws.entities[b_ids[0]]).distance_to(target) < 0.1, "investida: o lado B marcha pela rota dele")
	for id in a_ids + b_ids:
		ws.despawn(ws.entities.get(id))
	ws.player.quests_completed.append("ws_side_b")
	ws.tick(0.05)                                 # a leva esvaziada fecha (e o relógio volta ao `every`)
	RaidSystem.state(m, 0)["timer"] = 0.3
	RaidSystem.state(m, 1)["timer"] = 0.3
	for i in 40:
		ws.tick(0.05)
	check(RaidSystem.state(m, 1)["ids"].is_empty(), "investida: lado retomado não solta mais leva")
	var last_n := int(round(1.0 * Balance.RAID_RECLAIM_MULT * Balance.RAID_LAST_FRONT_MULT))
	check(RaidSystem.state(m, 0)["ids"].size() == last_n, "investida: o lado que sobra se enfurece e, sendo o último, joga tudo (1 lobo -> %d, x%.1f x%.1f): %d" % [last_n, Balance.RAID_RECLAIM_MULT, Balance.RAID_LAST_FRONT_MULT, RaidSystem.state(m, 0)["ids"].size()])
	check(RaidSystem.routes(fd).size() == 1, "Floresta continua com uma rota")
	for id in RaidSystem.state(m, 0)["ids"]:
		ws.despawn(ws.entities.get(id))
	def.raid = {}
	def.raids = []
	# leva aliada: nasce no começo da rota, sobe até o alvo e briga com o que estiver lá
	var back: Array = route.duplicate()
	back.reverse()
	def.assaults = [{"id": "t", "from": target, "route": back, "target": from, "radius": 6.0, "fighters": {"guard_warrior": 2}, "every": 999.0, "max": 4, "first": 0.5, "if": "ws_q"}]
	var foe: SimEntity = ws.spawn_monster(gd.monsters["wolf"], def.id, from + Vector3(2, 0, 0))
	ws.player.position = target
	var allies: Array = []
	var fought := false
	for i in int(120.0 * 20.0):
		ws.tick(0.05)
		allies = m["entities"].filter(func(e): return e.guard and str(e.npc_data.get("id", "")).begins_with("assault_"))
		if not foe.is_alive() or foe.hp < foe.stats.max_hp:
			fought = true
			break
	check(allies.size() == 2, "assalto: leva aliada de 2 nasceu (%d)" % allies.size())
	check(fought, "assalto: a leva subiu a rota e brigou no alvo")
	GameData.maps.erase(def.id)

func _check_elf_city_life(gd, sim) -> void:
	var md: MapDef = gd.maps["elf_city"]
	check(md.town_radius >= 60.0, "Cidade Élfica: muro com raio %d m (era 44)" % int(md.town_radius))
	var cits: Array = md.npcs.filter(func(n): return str(n.get("id", "")).begins_with("elf_") and n.get("role", "") == "villager")
	check(cits.size() >= 14, "Cidade Élfica: %d cidadãos" % cits.size())
	var m: Dictionary = sim.maps.get("elf_city", {})
	if m.is_empty():
		m = sim.load_map(md)
	for n in cits:
		var p: Vector3 = n["pos"]
		check(Vector2(p.x, p.z).length() < md.town_radius and sim.is_walkable(p, md, 0.4), "cidadão %s dentro do muro, em chão livre" % n["id"])
		check(str(n.get("model", "")).begins_with("mob_elf_citizen"), "cidadão %s com modelo élfico" % n["id"])
	var someone: SimEntity = null
	for e in m["entities"]:
		if e.kind == SimEntity.Kind.NPC and str(e.npc_data.get("id", "")).begins_with("elf_vendor"):
			someone = e
	var hero: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Visita", "elf_city", Vector3(0, 0, 40), 20)
	check(someone != null and not hero.is_hostile_to(someone) and not someone.is_hostile_to(hero), "cidadão élfico é neutro")
	sim.despawn(hero)
	var sergeants := md.spawners.filter(func(sp): return sp["monster_id"] == "elf_sergeant")
	check(sergeants.size() >= 4 and sergeants.all(func(sp): return sp.has("route") and (sp["route"] as Array).size() >= 4), "esquadrões em ronda dentro da cidade (%d)" % sergeants.size())
	var inside := 0
	for sp in md.spawners:
		if Vector2(sp["pos"].x, sp["pos"].z).length() < md.town_radius:
			var mon: MonsterDef = gd.monsters[sp["monster_id"]]
			inside += int(sp["count"]) + int(mon.escort.get("count", 0)) * int(sp["count"])
	check(inside >= 36, "exército dentro do muro: %d soldados" % inside)
	var forts := md.places.filter(func(pl): return pl["type"] == "fort")
	check(forts.size() >= 3, "3 fortes élficos (%d)" % forts.size())
	for cap in ["elf_captain_hunter", "elf_captain_sky", "elf_captain_sap"]:
		var ok := md.spawners.any(func(sp): return sp["monster_id"] == cap and int(sp["count"]) == 1)
		var c: MonsterDef = gd.monsters[cap]
		check(ok and c.is_boss and not c.escort.is_empty(), "%s no forte, chefe com escolta" % cap)
	check(gd.monsters["elf_captain_hunter"].move_speed >= 7.0 and gd.monsters["elf_captain_hunter"].escort.get("count", 0) >= 5, "Sylvara: a mais rápida, com 5+ bestas")

## Líder com escolta (capitão e bestas): a escolta nasce em volta dele, acompanha a ronda, entra na briga dele,
## e quem cai volta enquanto ele vive.
func _check_escort(gd, sim) -> void:
	var mid := "field_forest"
	var m: Dictionary = sim.maps.get(mid, {})
	if m.is_empty():
		m = sim.load_map(gd.maps[mid])
	var lead_def: MonsterDef = gd.monsters["elf_raider_archer"].duplicate()
	lead_def.id = "test_captain"
	lead_def.escort = {"id": "elf_lynx", "count": 4}
	var at := Vector3(-90, 0, 9)
	var leader: SimEntity = sim.spawn_monster(lead_def, mid, at)
	var sp := {}
	MobSystem.spawn_escort(sim, leader, sp)
	var esc: Array = (sp["escort"] as Array).map(func(id): return sim.entities[id])
	check(esc.size() == 4 and esc.all(func(f): return f.leader_id == leader.id and f.position.distance_to(at) < 5.0), "escolta nasce em volta do líder (%d)" % esc.size())
	check(esc.map(func(f): return f.escort_slot).duplicate().size() == 4 and esc.all(func(f): return f.monster_def.xp > 0), "escolta: monstros normais (dão XP), uma vaga cada")
	# o líder anda 20 m: a escolta vai junto (sem aventureiro do sim compartilhado por perto puxando briga)
	for o in m["entities"]:
		if (o.is_character() or o.kind == SimEntity.Kind.SUMMON) and o.position.distance_to(at) < 45.0:
			o.position = (m["def"] as MapDef).spawn_point      # invocações de bots de outros checks também puxavam briga
	for f in esc:
		f.aggro_target = -1
	leader.brain = null
	for i in range(160):
		leader.position = at + Vector3(i * 0.125, 0, 0)
		for f in esc:
			var c: InputCommand = f.brain.think(f, sim, m, 0.05)
			f.position += Vector3(c.move.x, 0, c.move.y) * f.stats.move_speed * 0.05
	var far := 0.0
	for f in esc:
		far = maxf(far, f.position.distance_to(leader.position))
	check(far < 4.5, "escolta acompanha o líder que andou 20 m (mais longe a %.1f m)" % far)
	# briga do líder vira briga da escolta
	var foe: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Alvo", mid, leader.position + Vector3(6, 0, 0), 18)
	foe.brain = null
	MobSystem.pack_call(sim, leader, foe)
	check(esc.all(func(f): return f.aggro_target == foe.id), "quem bate no líder chama a escolta toda")
	for f in esc:
		f.aggro_target = -1
	leader.aggro_target = foe.id
	var c2: InputCommand = esc[0].brain.think(esc[0], sim, m, 0.05)
	check(esc[0].aggro_target == foe.id, "escolta entra na briga do líder")
	# reposição: um cai, volta enquanto o líder vive
	sim.despawn(esc[1])
	leader.aggro_target = -1
	MobSystem.spawn_escort(sim, leader, sp)
	var alive := (sp["escort"] as Array).filter(func(id): return sim.entities.has(id) and sim.entities[id].is_alive())
	check(alive.size() == 4, "escolta reposta com o líder vivo (%d)" % alive.size())
	for id in sp["escort"]:
		if sim.entities.has(id):
			sim.despawn(sim.entities[id])
	sim.despawn(leader)
	sim.despawn(foe)

## Reset das skills no Ancião Ravi (devolve todos os pontos do nível, mantém os talentos de escolha) e Moeda Lendária
## à venda na Relicária por ouro.
func _check_reset_and_coin(gd, sim) -> void:
	var town: MapDef = gd.maps["city_aldara"]
	var at := func(nid: String) -> Vector3:
		for n in town.npcs:
			if n.get("id", "") == nid:
				return n["pos"] + Vector3(1.2, 0, 0)
		return Vector3.ZERO
	var e: SimEntity = sim.spawn_bot(gd.classes["paladin"], "Reset", "city_aldara", Vector3(40, 0, 40), 20)
	e.brain = null
	var total := ProgressionSystem.points_for_level(20)
	check(e.mastery_points < total or e.tree.size() > 1, "bot de nível 20 gastou pontos")
	var picks := 0
	for nid in ProgressionSystem.tree_of(sim, e)["nodes"]:
		if ProgressionSystem.tree_of(sim, e)["nodes"][nid]["kind"] == "pick" and int(ProgressionSystem.tree_of(sim, e)["nodes"][nid]["level"]) <= 20 and ProgressionSystem.pick_sibling(sim, e, nid) == "" and not e.tree.has(nid):
			e.tree[nid] = true
	picks = e.tree.keys().filter(func(nid): return ProgressionSystem.tree_of(sim, e)["nodes"][nid]["kind"] == "pick").size()
	check(picks == 4, "bot nível 20: um talento de classe por linha liberada (%d)" % picks)
	check(not sim.reset_tree(e), "longe do Ancião não reseta")
	e.position = at.call("elder")
	check(sim.reset_tree(e), "perto do Ancião reseta")
	check(e.mastery_points == total, "reset devolve todos os pontos do nível (%d/%d)" % [e.mastery_points, total])
	check(e.talents.is_empty() and e.mastery.is_empty(), "sem evoluções nem maestria depois do reset")
	check(e.learned.keys().all(func(sid): return sid in e.class_def.starting_skills), "só as skills iniciais ficam aprendidas")
	var kept := e.tree.keys().filter(func(nid): return ProgressionSystem.tree_of(sim, e)["nodes"][nid]["kind"] == "pick").size()
	check(kept == picks, "talentos de escolha ficam (%d/%d)" % [kept, picks])
	check(e.skills.all(func(s): return s == null or e.learned.has(s.id)), "barra só com o que ainda conhece")
	# moeda lendária
	e.gold = 1200
	var c0 := int(e.inventory.get("legend_coin", 0))
	check(not sim.buy_legend_coin(e), "longe da Relicária não compra moeda")
	e.position = at.call("relic")
	check(sim.buy_legend_coin(e) and e.gold == 1200 - Balance.LEGEND_COIN_PRICE and int(e.inventory.get("legend_coin", 0)) == c0 + 1, "compra 1 Moeda Lendária por %d de ouro" % Balance.LEGEND_COIN_PRICE)
	e.gold = Balance.LEGEND_COIN_PRICE - 1
	check(not sim.buy_legend_coin(e) and int(e.inventory.get("legend_coin", 0)) == c0 + 1, "sem ouro suficiente não compra")
	sim.despawn(e)

## Quest repetível diz que é repetível (diálogo, rastreador, janela L e aviso de conclusão usam estes textos).
func _check_repeatable_labels(gd) -> void:
	var rep: QuestDef = gd.quests["b_spiders"]
	var once: QuestDef = gd.quests["q01_welcome"]
	check(rep.repeatable and QuestSystem.repeat_tag(rep).contains("Repetível") and QuestSystem.repeat_note(rep).contains("Círculo Druídico"), "repetível: etiqueta e onde pegar de novo")
	check(QuestSystem.repeat_tag(once) == "" and QuestSystem.repeat_note(once) == "", "quest de uma vez só não diz repetível")
	var n := 0
	for qid in gd.quests:
		if gd.quests[qid].repeatable:
			n += 1
			check(QuestSystem.npc_name(gd.quests[qid].giver_npc) != gd.quests[qid].giver_npc, "%s: quem dá a repetível tem nome" % qid)
	check(n >= 10, "há repetíveis (%d)" % n)

## Modelo de monstro/prop/kit não carrega pedaço de zona: objeto marcado numa coleção escondida do Blender ia junto
## no GLB (centenas de chãos de dungeon dentro de cada elfo/grifo/casa élfica).
## Peça que brilha no GLB do monstro (brasa, runa, olho: emissão > 1) continua brilhando depois do toon e da fusão
## (EntityView.mob_glow -> emission_amount); m_white (emissão 1,0 só para clarear) não brilha. O hit flash segue nos materiais.
func _check_mob_glow(gd, sim) -> void:
	var white := StandardMaterial3D.new()
	white.resource_name = "m_white"
	white.emission_enabled = true
	white.emission = Color(0.8, 0.8, 0.8)
	white.emission_energy_multiplier = 1.0
	check(EntityView.mob_glow(white) == 0.0, "m_white (emissão 1,0) não vira brilho")
	var ember := StandardMaterial3D.new()
	ember.emission_enabled = true
	ember.emission = Color(1.0, 0.68, 0.31)
	ember.emission_energy_multiplier = 2.2
	var ec := EntityView.glow_color(ember)
	check(EntityView.mob_glow(ember) >= 1.0 and ec.r > 0.9 and ec.g < 0.5 * ec.r, "brasa: brilha e volta ao laranja do Blender (%s)" % ec.to_html(false))
	var boss: SimEntity = sim.spawn_monster(gd.monsters["boss_kragmar"], "city_aldara", Vector3(5, 0, 8))
	var v := EntityView.new()
	add_child(v)
	v.setup(boss, false)
	var lit := 0
	var flash_ok := true
	for mi in v.find_children("*", "MeshInstance3D", true, false):
		var m3 := mi as MeshInstance3D
		for si in m3.get_surface_override_material_count():
			var m := m3.get_surface_override_material(si) as ShaderMaterial
			if m and m.get_shader_parameter("emission_amount") != null and float(m.get_shader_parameter("emission_amount")) >= 1.0:
				lit += 1
				flash_ok = flash_ok and v._mats.has(m)
	check(lit >= 1, "Kragmar: peça de brasa/martelo continua emissiva depois do toon e da fusão (%d)" % lit)
	check(flash_ok, "Kragmar: superfície que brilha recebe o hit flash")
	v.free()
	sim.despawn(boss)

func _check_model_leaks() -> void:
	var dir := DirAccess.open("res://assets/models")
	var bad: Array = []
	for f in dir.get_files():
		if not f.ends_with(".glb") or f.begins_with("map_"):
			continue
		var fa := FileAccess.open("res://assets/models/" + f, FileAccess.READ)
		if fa == null:
			continue
		fa.seek(12)
		var n := fa.get_32()
		fa.seek(20)
		var js: Dictionary = JSON.parse_string(fa.get_buffer(n).get_string_from_utf8())
		var stem := f.get_basename()
		for nd in js.get("nodes", []):
			var nm := str(nd.get("name", ""))
			# pedaço de zona, ou de OUTRO monstro (o exportador do glTF pegava objetos selecionados de outras cenas do .blend)
			if nm.begins_with("Z_") or (stem.begins_with("mob_") and nm.begins_with("mob_") and not nm.begins_with(stem)):
				bad.append("%s<%s>" % [f, nm])
				break
	check(bad.is_empty(), "nenhum modelo de monstro/prop traz pedaço de zona ou de outro monstro (%s)" % str(bad))

